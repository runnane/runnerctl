need_val() { [ $# -ge 2 ] || die "$1 needs a value"; }

# --- The record of what changed (GHR-88) ----------------------------------------
# Every command that changes the host leaves ONE line in the journal, tagged
# `runnerctl`, written when it ends and saying how it ended:
#
#   restart slot-2 (--when-idle) by deploy via fleet from alice@central-1 — ok
#
# verb, targets, the few flags that change what it did, who ran it — the sudo
# caller, else the login — and, for a call that came through `fleet`, the
# operator and central node it says it came from, then `ok`, `failed (exit N)`,
# `interrupted (SIGINT)` / `interrupted (SIGTERM)` (GHR-119) or a count the
# command keeps itself. `history` reads them back.
#
# What goes in is chosen, never copied: no argv, so a token handed to
# `provision` or `deprovision` has no way in. Each part is a value the command
# already validated, and every part is still cleaned (audit_clean) so nothing
# can end the line early and forge a second record. `--origin` is a CLAIM made
# by whoever holds the ssh login — exactly as trustworthy as that login, and
# labelled that way: it is checked against a conservative shape, written into
# this line and used for nothing else. One that fails the check is dropped and
# the line says `origin invalid`.
#
# Recording never changes what the command does: no logger, a logger that
# fails or a journal that will not take the line is silence, and the exit
# status is the command's own. A command arms the record (audit_begin) once it
# is about to change something — a usage error, a refusal or a dry run before
# that point records nothing — and the EXIT trap writes it with the real
# outcome, so a `die` half way through is recorded as the failure it is. The
# commands a timer or cron runs (`health --restart-stalled`, `compose-reap
# --apply`, `--if-stalled`) arm only when they act, so a quiet hour writes
# nothing.
AUDIT_VERB="" AUDIT_PID="" AUDIT_RESULT="" AUDIT_NOTE="" AUDIT_AS="" AUDIT_SIGNAL=""
AUDIT_TARGETS=() AUDIT_FLAGS=()
AUDIT_ORIGIN="" AUDIT_ORIGIN_BAD=false
# One word of a login or an operator name, and a host name: letters, digits
# and `.`, `_`, `-` only, so the claim cannot carry a space, a quote, a
# newline or a sequence into the line it is written into.
AUDIT_RE_WORD='^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$'
AUDIT_RE_HOST='^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$'
# OPERATOR@HOST, each to its own pattern.
origin_valid() { # TEXT
  local op="${1%%@*}" h="${1#*@}"
  [[ "$1" == *@* && "$op" =~ $AUDIT_RE_WORD && "$h" =~ $AUDIT_RE_HOST ]]
}
# The --origin a host was handed: kept when it has the shape, else dropped
# and remembered as invalid. Never fatal — an older central node, or a typo
# in someone's wrapper, must not stop the command it rides on.
audit_origin_take() { # TEXT
  if origin_valid "$1"; then AUDIT_ORIGIN="$1" AUDIT_ORIGIN_BAD=false; else AUDIT_ORIGIN="" AUDIT_ORIGIN_BAD=true; fi
}
# Who is running this: the sudo caller (SUDO_USER is set by sudo itself, after
# its env_reset), else the login. A name that is not one plain word is the uid.
audit_actor() {
  local who
  if under_sudo; then who="${SUDO_USER:-}"; else who="$(id -un 2>/dev/null || true)"; fi
  if [[ "$who" =~ $AUDIT_RE_WORD ]]; then
    printf '%s\n' "$who"
  elif under_sudo; then
    printf 'uid %s\n' "${SUDO_UID:-$(id -u)}"
  else
    printf 'uid %s\n' "$(id -u)"
  fi
}
# The slots a command acts on, as record targets: each unit's short name when
# the command was given targets (COUNT > 0), `all` when it was given none.
audit_slots() { # COUNT UNIT...
  local n="$1" u
  shift
  if [ "$n" -eq 0 ]; then AUDIT_TARGETS+=(all); return 0; fi
  for u in "$@"; do AUDIT_TARGETS+=("$(short_name "$u")"); done
}
# TEXT as one line of a record, into AUDIT_CLEAN: a sequence removed whole
# (relay_safe's plain form), then every control byte left — a newline among
# them — removed too, and cut to MAX characters (200).
AUDIT_CLEAN=""
audit_clean() { # TEXT [MAX]
  local LC_ALL=C s
  relay_safe "${1-}" plain
  s="${RELAY_SAFE//[$'\001'-$'\037'$'\177']/}"
  AUDIT_CLEAN="${s:0:${2:-200}}"
}
# Arm the record for this process: VERB, then targets and flags (a word
# starting `--` is a flag; an empty word is skipped). A second call in the same
# process adds targets and flags to the first — `health` arms once per slot it
# restarts. A subshell arms a record of its own: the local `watch` runs its
# actions in one, and each is a record.
audit_begin() { # VERB [TARGET|--FLAG ...]
  local a
  if [ -z "$AUDIT_VERB" ] || [ "$AUDIT_PID" != "$BASHPID" ]; then
    AUDIT_VERB="$1" AUDIT_PID="$BASHPID" AUDIT_RESULT="" AUDIT_NOTE="" AUDIT_SIGNAL=""
    AUDIT_TARGETS=() AUDIT_FLAGS=()
    builtin trap exit_run EXIT
    audit_sig_arm
  fi
  shift
  for a in "$@"; do
    case "$a" in
      '') ;;
      --*) audit_has "$a" ${AUDIT_FLAGS[@]+"${AUDIT_FLAGS[@]}"} || AUDIT_FLAGS+=("$a") ;;
      *)   audit_has "$a" ${AUDIT_TARGETS[@]+"${AUDIT_TARGETS[@]}"} || AUDIT_TARGETS+=("$a") ;;
    esac
  done
}
# Whether WORD is among the rest — a re-arm names a flag or a slot once.
audit_has() { # WORD LIST...
  local w="$1" x
  shift
  for x in "$@"; do [ "$x" != "$w" ] || return 0; done
  return 1
}
# The line itself, for OUTCOME. Every part cleaned; the parts the script
# produces itself (the verb, the labels) are fixed text.
audit_message() { # OUTCOME
  local msg t f="" n=0
  audit_clean "$AUDIT_VERB"; msg="$AUDIT_CLEAN"
  for t in ${AUDIT_TARGETS[@]+"${AUDIT_TARGETS[@]}"}; do
    n=$((n + 1))
    if [ "$n" -gt 8 ]; then msg+=" … (+$(( ${#AUDIT_TARGETS[@]} - 8 )) more)"; break; fi
    audit_clean "$t"; msg+=" $AUDIT_CLEAN"
  done
  for t in ${AUDIT_FLAGS[@]+"${AUDIT_FLAGS[@]}"}; do
    audit_clean "$t"; f+="${f:+, }$AUDIT_CLEAN"
  done
  [ -z "$f" ] || msg+=" ($f)"
  msg+=" by $(audit_actor)"
  if [ -n "$AUDIT_ORIGIN" ]; then
    # Validated when it was taken; cleaned all the same, as every part is.
    audit_clean "$AUDIT_ORIGIN"; msg+=" via fleet from $AUDIT_CLEAN"
  elif $AUDIT_ORIGIN_BAD; then
    msg+=" via fleet, origin invalid"
  fi
  audit_clean "$1"
  printf '%s — %s\n' "$msg" "$AUDIT_CLEAN"
}
# Write the armed record, once, with RC as the outcome unless the command set
# AUDIT_RESULT itself. Never fails and never prints: the record is a side
# channel, and the command's own exit status is what the caller sees.
audit_finish() { # RC
  local rc="$1" outcome msg
  [ -n "$AUDIT_VERB" ] && [ "$AUDIT_PID" = "$BASHPID" ] || return 0
  if [ -n "$AUDIT_SIGNAL" ]; then
    outcome="interrupted ($AUDIT_SIGNAL)"
  elif [ -n "$AUDIT_RESULT" ]; then
    outcome="$AUDIT_RESULT"
  elif [ "$rc" = 0 ]; then
    outcome=ok
  else
    outcome="failed (exit $rc)"
  fi
  [ -z "$AUDIT_NOTE" ] || outcome+=" ($AUDIT_NOTE)"
  # GHR-91: a guarded command whose caller went away before it finished.
  ! $CALLER_GONE || outcome+=" (caller gone, ran to the end)"
  msg="$(audit_message "$outcome" 2>/dev/null)" || msg=""
  # Finished: a second call in this process — the EXIT trap after the
  # signal handler wrote the record (GHR-119) — writes nothing.
  AUDIT_VERB=""
  audit_sig_disarm
  [ -z "$msg" ] || audit_logger "$msg" >/dev/null 2>&1 || true
  return 0
}
# The journal write, as ONE argument after `--` — never through a shell, so
# nothing in the line is read as an option or a word. A hook, like the
# journal readers: tests/stub.config shadows it, and the real one is covered
# over a fake `logger` on PATH. Bounded, so a journald that has stopped
# answering cannot hold the command's exit.
audit_logger() { # MESSAGE
  command -v logger >/dev/null 2>&1 || return 0
  timeout 5 logger -t runnerctl -- "$1"
}

# --- Exit handlers (GHR-88) -------------------------------------------------------
# The record is written from the EXIT trap, and several commands arm an EXIT
# trap of their own for their temp files (provision, upgrade, install, every
# fan-out). A plain `trap CMD EXIT` replaces whatever was there, so the first
# command to clean up after itself would silently drop its record. Rather than
# every such site having to know about the record, `trap` is wrapped: the
# EXIT form (`trap [--] CMD EXIT`, parsed exactly — GHR-123) keeps CMD in
# EXIT_CMD and installs exit_run, which writes the record first and then runs
# CMD exactly as the builtin would have.
# Every other form — signals, `trap - WINCH` — is the builtin, untouched.
#
# EXIT_PID: a subshell inherits EXIT_CMD but not the trap (bash resets traps in
# one), so a subshell that arms a record of its own must not also run its
# parent's cleanup — the local watch's teardown, say — on its way out.
EXIT_CMD="" EXIT_PID=""
# GHR-123: the wrapper parses `trap [--] CMD SIGSPEC...` exactly, not by shape.
#   * `-p` and `-l` are the builtin's: `trap -p EXIT` prints what the builtin
#     prints (`exit_run`, which is what is armed) and stores nothing; any other
#     option (anything starting `-` but `--` and a lone `-`) dies loudly;
#   * `--` ends the options, so `trap -- CMD EXIT` is `trap CMD EXIT`;
#   * EXIT anywhere in the list is the wrapper's: CMD becomes EXIT_CMD and
#     exit_run stays armed. `trap - EXIT` and `trap '' EXIT` both mean "no
#     handler of the command's own" (the builtin's `''` is "ignore", and an
#     ignored EXIT has nothing to run) — the record is still written;
#   * the other signals of the same call go on as they would have alone.
trap_is_exit() { # SIGSPEC
  case "${1^^}" in EXIT|SIGEXIT|0) return 0 ;; esac
  return 1
}
trap() {
  case "${1-}" in
    --) shift ;;
    -p) shift; builtin trap -p "$@"; return ;;
    -l) builtin trap -l; return ;;
    -?*) die "trap: unsupported option $1" ;;
  esac
  if [ $# -eq 1 ]; then
    # A lone signal is the builtin's reset; for EXIT that is `trap - EXIT`.
    trap_is_exit "$1" || { builtin trap -- "$@"; return; }
    set -- - "$1"
  fi
  [ $# -ge 2 ] || { builtin trap -- "$@"; return; }
  local cmd="$1" s rest=() has_exit=false
  shift
  for s in "$@"; do
    if trap_is_exit "$s"; then has_exit=true; else rest+=("$s"); fi
  done
  if $has_exit; then
    EXIT_CMD="$cmd" EXIT_PID="$BASHPID"
    case "$cmd" in -) EXIT_CMD="" ;; esac
    builtin trap exit_run EXIT
  fi
  # GHR-119, GHR-131: INT, TERM, HUP and PIPE are the record's while one is
  # armed, so a command's own handler for them (`watch`, `fleet watch`, the
  # `fleet status --json --watch` stream) is kept by sig_own and chained to,
  # never replaced. Every other signal is the builtin's.
  local others=()
  for s in ${rest[@]+"${rest[@]}"}; do
    case "$s" in
      INT|SIGINT)   sig_own INT "$cmd" ;;
      TERM|SIGTERM) sig_own TERM "$cmd" ;;
      HUP|SIGHUP)   sig_own HUP "$cmd" ;;
      PIPE|SIGPIPE) sig_own PIPE "$cmd" ;;
      *)            others+=("$s") ;;
    esac
  done
  [ "${#others[@]}" -eq 0 ] || builtin trap -- "$cmd" "${others[@]}"
  return 0
}
exit_run() {
  local rc=$?
  # GHR-149: a heartbeat ticker still running holds the relays' pipe open.
  hb_stop
  # GHR-91: first, so the record knows whether the caller was still there.
  caller_guard_end
  audit_finish "$rc"
  FLEET_LOG_EXIT_RC="$rc"
  fleet_log_finish
  if [ "$EXIT_PID" = "$BASHPID" ] && [ -n "$EXIT_CMD" ] && [ "$EXIT_CMD" != - ]; then
    eval "$EXIT_CMD"
  fi
}

# --- An interrupted command's record (GHR-119) ----------------------------------
# A command ended by Ctrl-C or a SIGTERM still runs its EXIT trap, but `$?`
# there is the status of whatever finished before the signal — so without a
# handler of its own the record says `ok` for a command the operator stopped.
# While a record is armed, and only then, INT and TERM run audit_signal: it
# writes the record as `interrupted (SIGINT)` and then lets the signal do
# exactly what it would have done without it —
#
#   * no handler of the command's own: the disposition goes back to the
#     default and the same signal is raised again at THIS process ($BASHPID —
#     the local watch arms its actions' records in a subshell, where $$ would
#     be the watch). So the process still dies BY the signal: a parent sees
#     WIFSIGNALED, a shell 128+N, and a calling shell's own Ctrl-C handling is
#     what it was. A handler that recorded and then exited 130 would not be;
#   * a handler of the command's own (`watch` and `fleet watch` trap INT and
#     TERM to exit 0): that handler, run as it would have been.
#
# The EXIT trap then runs as it always did, and finds the record finished.
# Before a record is armed nothing is trapped, so a signal there is handled
# as it always was. One cost of a trapped signal is bash's, not ours: bash
# runs a trap once the foreground command it is waiting for has ended, so a
# TERM sent to runnerctl's pid alone — not its process group, as a terminal's
# Ctrl-C, systemd and `timeout` do — waits for the step in progress (a
# download, a sleep in a --when-idle wait) before the process ends.
#
# GHR-131: HUP (a terminal, or an ssh session with a tty, closed under it) and
# PIPE (its stdout's reader gone) are the record's in the same way, with one
# exception: a process where caller_guard has run (GHR-91). There HUP is
# ignored, and that ignore is the point — it is inherited by everything the
# command runs — so it is never trapped and never handed back; and PIPE
# cannot arise, because the command only ever writes to its relays. The
# record there carries the command's own outcome. PIPE is never ignored in
# the main process: a child would inherit the ignore, and a `cmd | head` in it
# would then fail its write under pipefail instead of ending quietly.
AUDIT_SIG_PID="" AUDIT_SIG_ARMED=""
# The command's own INT / TERM / HUP / PIPE handlers (`-` none), for the
# process that set them: a subshell inherits these but not the traps.
SIG_OWN_PID="" SIG_OWN_INT=- SIG_OWN_TERM=- SIG_OWN_HUP=- SIG_OWN_PIPE=-
sig_own() { # INT|TERM|HUP|PIPE CMD
  if [ "$SIG_OWN_PID" != "$BASHPID" ]; then
    SIG_OWN_PID="$BASHPID" SIG_OWN_INT=- SIG_OWN_TERM=- SIG_OWN_HUP=- SIG_OWN_PIPE=-
  fi
  case "$1" in
    INT) SIG_OWN_INT="$2" ;; TERM) SIG_OWN_TERM="$2" ;;
    HUP) SIG_OWN_HUP="$2" ;; PIPE) SIG_OWN_PIPE="$2" ;;
  esac
  # With a record armed here the trap stays audit_signal, which chains to it;
  # under a caller guard HUP stays ignored, whatever the command asks for.
  ! audit_sig_holds "$1" || return 0
  [ "$1" != HUP ] || [ -z "$CALLER_GUARD_PID" ] || return 0
  builtin trap -- "$2" "$1"
}
# This process's own handler for SIG into SIG_OWNER (`-` none).
sig_owner() { # INT|TERM|HUP|PIPE
  SIG_OWNER=-
  [ "$SIG_OWN_PID" = "$BASHPID" ] || return 0
  case "$1" in
    INT) SIG_OWNER="$SIG_OWN_INT" ;; TERM) SIG_OWNER="$SIG_OWN_TERM" ;;
    HUP) SIG_OWNER="$SIG_OWN_HUP" ;; PIPE) SIG_OWNER="$SIG_OWN_PIPE" ;;
  esac
}
# Whether SIG runs audit_signal in this process now.
audit_sig_holds() { # SIG
  [ "$AUDIT_SIG_PID" = "$BASHPID" ] && [[ " $AUDIT_SIG_ARMED " == *" $1 "* ]]
}
audit_sig_arm() {
  [ "$AUDIT_SIG_PID" != "$BASHPID" ] || return 0
  AUDIT_SIG_PID="$BASHPID" AUDIT_SIG_ARMED="INT TERM"
  builtin trap 'audit_signal INT' INT
  builtin trap 'audit_signal TERM' TERM
  # A guard here, or in the process this one was forked from, owns both.
  [ -z "$CALLER_GUARD_PID" ] || return 0
  AUDIT_SIG_ARMED+=" HUP PIPE"
  builtin trap 'audit_signal HUP' HUP
  builtin trap 'audit_signal PIPE' PIPE
}
# A caller guard taking this process over: HUP and PIPE are no longer the
# record's. HUP is the guard's to ignore; PIPE goes back to the command's own.
audit_sig_yield() {
  [ "$AUDIT_SIG_PID" = "$BASHPID" ] || return 0
  AUDIT_SIG_ARMED="INT TERM"
  sig_owner PIPE
  builtin trap -- "$SIG_OWNER" PIPE
}
# Back to what the command itself asked for, when its record is finished —
# only the signals the record took, so a guard's ignored HUP stays ignored.
audit_sig_disarm() {
  local s armed="$AUDIT_SIG_ARMED"
  [ "$AUDIT_SIG_PID" = "$BASHPID" ] || return 0
  AUDIT_SIG_PID="" AUDIT_SIG_ARMED=""
  for s in $armed; do
    sig_owner "$s"
    builtin trap -- "$SIG_OWNER" "$s"
  done
}
audit_signal() { # INT|TERM|HUP|PIPE
  local owner
  sig_owner "$1"; owner="$SIG_OWNER"
  # A command that ignores the signal goes on: nothing was interrupted.
  [ -n "$owner" ] || return 0
  AUDIT_SIGNAL="SIG$1"
  hb_stop
  audit_finish 0
  if [ "$owner" != - ]; then
    eval "$owner"
    return 0
  fi
  builtin trap - "$1"
  kill -s "$1" "$BASHPID"
}

# --- A run that loses its caller finishes what it started (GHR-91) -------------
# `drain`, `stop`/`restart` (with or without --when-idle), `apply` and `scale`
# act one slot after another, and a slot's wait can be long. Their caller can
# go away part-way: the central node's ssh is ended by its budget, by Ctrl-C
# there, by `fleet watch`'s q, or by the network; a terminal is closed. Until
# now the command then died at its next write to the dead stdout (SIGPIPE), or
# at once on SIGHUP from a closed terminal — so how many slots it got through
# was an accident of where its next `echo` fell.
#
# The choice is to FINISH WHAT WAS STARTED, not to stop at a slot boundary:
#   * what the command describes is a whole state (every slot drained, the new
#     config live everywhere), and stopping at a boundary is still a half-done
#     host, only a tidier one — with mixed configs, or capacity out with no
#     one left to bring it back;
#   * every wait is already bounded (--timeout per slot), so a run with no
#     caller still ends, and ends by itself the way it would have with one;
#   * a write is the only way to notice the caller has gone, so "stop at the
#     next boundary" would still depend on when the command happens to write;
#   * the record (GHR-88) is written at the end with the real outcome, so
#     `fleet history --host H` reads how it ended; nothing else has to be
#     left behind for the central node to find.
#
# How, from the moment the command arms its record (it is about to change
# something — a refusal before that is not affected):
#   * SIGHUP is ignored, as nohup does, and the ignore is inherited by what the
#     command runs (systemctl, sudo, the sleep between polls), so a terminal's
#     hangup reaches none of it;
#   * stdout and stderr go through a relay each (caller_relay) that passes
#     every line on while it can and, once a write fails, drops the rest. The
#     command itself only ever writes to the relay's pipe, which is read to the
#     end, so it never meets a closed reader — no SIGPIPE, and no failed `echo`
#     for `set -e` to end the script on. Ignoring SIGPIPE alone would not do:
#     the write then fails with EPIPE, and `set -e` ends the script at the
#     first such write it is watching. Measured on `drain`: the `waiting for`
#     lines fail inside wait_idle, which runs under `||` where `set -e` is off,
#     so the slots are stopped — and then the drain exits 1 with a write
#     error on stderr, having done its work. Where a failed write lands
#     decides the outcome, which is the timing dependence this removes. The relay passes lines as they come, so a fan-out
#     still shows them as they are printed (GHR-92).
#   * SIGINT and SIGTERM are untouched: an operator's Ctrl-C or a TERM is a
#     decision to stop, and is recorded and dies by the signal as GHR-119
#     made it. The relays ignore both, so they go on draining until the
#     command and everything it started have gone.
# On the way out (exit_run) the relays are closed and waited for, so nothing
# the command printed comes after its exit; a relay that could not deliver
# makes the record say `(caller gone, ran to the end)`.
#
# GHR-137 moved the other mutating commands in, each from the point it arms its
# record: `upgrade` (and --rollback), `deprovision` (after its y/N prompt,
# never before), `kill` (and --if-stalled), `reap`, `enable`/`disable`,
# `remove-limits`, `env-init`, `compose-reap --apply` and `health
# --restart-stalled`. Each is a sequence whose middle is a worse host than
# either end. GHR-153 moved the last ones in: `provision`, `install` (what
# `fleet upgrade --push` runs remotely), `migrate` (install's own guard when
# install reaches it) and `compose-reap-timer install|remove`. So every
# command that arms a record is guarded from that point.
#
# So for a command guarded here, SIGHUP and SIGPIPE are not interruptions:
# HUP is ignored and PIPE cannot arise, and the record carries the command's
# own outcome. A record armed without a guard records both as `interrupted
# (SIGHUP|SIGPIPE)` and dies by them, as GHR-119 does for INT and TERM
# (GHR-131). No command does that today; the rule stays for the next one that
# arms a record, and tests/run.sh pins it on a record armed directly.
CALLER_GUARD_PID="" CALLER_GUARD_OUT="" CALLER_GUARD_ERR=""
CALLER_GUARD_P1="" CALLER_GUARD_P2="" CALLER_GONE=false
# One stream, on stdin, to stdout: each line passed on until a write fails,
# then read and dropped to the end. Exit 3 when something could not be passed.
caller_relay() {
  # GHR-162: QUIT stated beside INT, as every async process states both (bash
  # ignores QUIT in its own process anyway; the explicit one would reach what
  # it ran). A `>(…)` keeps INT at its default on bash 5.2, not on 5.3.
  builtin trap '' INT QUIT TERM HUP PIPE
  local line nl=$'\n' gone=false
  while IFS= read -r line || { [ -n "$line" ] && nl=""; }; do
    $gone || printf '%s%s' "$line" "$nl" 2>/dev/null || gone=true
  done
  ! $gone || return 3
}
# Arm it for this process (once; a subshell arms its own — the local watch
# runs its action's command in one).
caller_guard() {
  [ "$CALLER_GUARD_PID" != "$BASHPID" ] || return 0
  CALLER_GUARD_PID="$BASHPID" CALLER_GONE=false
  builtin trap '' HUP
  # GHR-131: the record armed just before this no longer takes HUP or PIPE.
  audit_sig_yield
  # A stream that is not open at all has nothing to relay to.
  # (Its own complaint about fd 2 has nowhere to go, which is the point.)
  true 2>/dev/null >&1 || exec 1>/dev/null
  true >&2 || exec 2>/dev/null
  exec {CALLER_GUARD_OUT}>&1 {CALLER_GUARD_ERR}>&2
  exec 1> >(caller_relay 1>&"$CALLER_GUARD_OUT" 2>/dev/null); CALLER_GUARD_P1=$!
  exec 2> >(caller_relay 1>&"$CALLER_GUARD_ERR" 2>/dev/null); CALLER_GUARD_P2=$!
}
# Close the relays and wait for them to finish passing lines on; the streams
# are then the caller's again, or /dev/null when the caller has gone.
caller_guard_end() {
  local rc1=0 rc2=0
  [ -n "$CALLER_GUARD_PID" ] && [ "$CALLER_GUARD_PID" = "$BASHPID" ] || return 0
  CALLER_GUARD_PID=""
  exec 1>/dev/null 2>/dev/null
  wait "$CALLER_GUARD_P1" 2>/dev/null || rc1=$?
  wait "$CALLER_GUARD_P2" 2>/dev/null || rc2=$?
  if [ "$rc1" = 3 ] || [ "$rc2" = 3 ]; then
    CALLER_GONE=true
  else
    exec 1>&"$CALLER_GUARD_OUT" 2>&"$CALLER_GUARD_ERR"
  fi
  exec {CALLER_GUARD_OUT}>&- {CALLER_GUARD_ERR}>&-
}

# --- The central node's record (GHR-88) -----------------------------------------
# One line per fleet mutation in FLEET_LOG, appended:
#
#   2026-10-14T09:12:03Z alice fleet restart --when-idle --host build-1 — build-1=0
#
# the time (UTC), the operator, the fleet command as typed — or, for a `fleet
# watch` key, the command line that key stands for — then each host the
# command reached and that host's exit status (124 timed out, 255 unreachable,
# a budget walk names the slot: build-1/0=0). Armed at the first remote call
# that changes something, so a refusal before it writes nothing; written on
# exit, so a fan-out that dies half way still says how far it got. The file is
# created 0600 in a directory created 0700: it says who did what where. A log
# that cannot be written is silence — the fleet command's outcome is the
# hosts', not this file's.
FLEET_LOG_CMD="" FLEET_LOG_RESULTS="" FLEET_LOG_PID="" FLEET_LOG_EXIT_RC=""
FLEET_ARGV=()
fleet_log_path() {
  local base
  if [ -n "$FLEET_LOG" ]; then printf '%s\n' "$FLEET_LOG"; return 0; fi
  base="${XDG_STATE_HOME:-}"
  # The XDG spec ignores a relative XDG_STATE_HOME, and under sudo it is the
  # caller's variable naming the caller's directory: root's HOME decides.
  if under_sudo || [[ "$base" != /* ]]; then base="$HOME/.local/state"; fi
  printf '%s\n' "$base/runnerctl/fleet.log"
}
# Arm it for COMMAND-TEXT (once; a later call keeps the first text).
fleet_log_begin() { # COMMAND-TEXT
  if [ -z "$FLEET_LOG_CMD" ] || [ "$FLEET_LOG_PID" != "$BASHPID" ]; then
    FLEET_LOG_CMD="$1" FLEET_LOG_RESULTS="" FLEET_LOG_PID="$BASHPID"
    builtin trap exit_run EXIT
  fi
}
# The fleet command as typed, for fleet_log_begin: `fleet` and its words.
fleet_log_argv() {
  local t="fleet" a
  for a in ${FLEET_ARGV[@]+"${FLEET_ARGV[@]}"}; do t+=" $a"; done
  printf '%s\n' "$t"
}
fleet_log_result() { # HOST[/SLOT] RC
  [ -n "$FLEET_LOG_CMD" ] || return 0
  FLEET_LOG_RESULTS+="${FLEET_LOG_RESULTS:+ }$1=$2"
}
# GHR-161: the record of a command interrupted while a fan-out was out. A host
# dialled and not heard back from is not a host that "did not answer": its
# command may have started, and is caller-guarded to finish (GHR-137, GHR-153),
# so the line says INTERRUPTED and names those hosts, then the hosts that did
# answer as HOST=RC. Reads FLEET_DIR, which the EXIT trap has not yet removed
# (fleet_cleanup runs after the record). `.dialled` is fleet_fanout_one's mark.
fleet_log_interrupted() { # RESULTS-SO-FAR
  local i host pending="" answered="" out sig
  if [ -n "$FLEET_DIR" ] && [ -d "$FLEET_DIR" ]; then
    for i in "${!FLEET_HOSTS[@]}"; do
      host="${FLEET_HOSTS[$i]}"
      [ -e "$FLEET_DIR/$i.dialled" ] || continue
      if [ -e "$FLEET_DIR/$i.rc" ]; then
        # already in the record (the walk logs HOST/SLOT, the rest HOST)
        [[ " $1 " != *" $host="* && " $1 " != *" $host/"* ]] || continue
        answered+="${answered:+ }$host=$(fleet_rc "$i")"
      else
        pending+="${pending:+ }$host"
      fi
    done
  fi
  [ -z "$1" ] || answered="$1${answered:+ }$answered"
  # A host dialled and unanswered is what makes this an interrupted record
  # (a command that ran to its end has an answer for every host it dialled);
  # nothing dialled, or no pending host, leaves the record as it was — an
  # empty list is `no host answered` (fleet_log_write), which is then true.
  if [ -z "$pending" ]; then printf '%s\n' "$1"; return 0; fi
  # The central `fleet` command arms no signal handler, so it dies BY the
  # signal and its EXIT trap sees 128+N: that names it.
  sig="$AUDIT_SIGNAL"
  if [ -z "$sig" ]; then
    case "${FLEET_LOG_EXIT_RC:-}" in 129) sig=SIGHUP ;; 130) sig=SIGINT ;; 143) sig=SIGTERM ;; esac
  fi
  out="interrupted${sig:+ ($sig)}"
  [ -z "$pending" ] || out+="; dialled, no answer yet: $pending"
  [ -z "$answered" ] || out+="; $answered"
  printf '%s\n' "$out"
}
fleet_log_finish() {
  local cmd="$FLEET_LOG_CMD" results="$FLEET_LOG_RESULTS"
  [ -n "$FLEET_LOG_CMD" ] && [ "$FLEET_LOG_PID" = "$BASHPID" ] || return 0
  FLEET_LOG_CMD="" FLEET_LOG_RESULTS=""
  results="$(fleet_log_interrupted "$results")"
  fleet_log_write "$cmd" "$results"
}
# One line, now, with nothing armed: `fleet watch`'s background actions
# (GHR-125) each write theirs when the action ends, or when the watch does.
fleet_log_write() { # COMMAND-TEXT RESULTS
  local f line cmd
  audit_clean "$1" 1000; cmd="$AUDIT_CLEAN"
  audit_clean "${2:-no host answered}" 4000
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $(audit_actor) $cmd — $AUDIT_CLEAN"
  f="$(fleet_log_path)"
  # umask in a subshell: the directory and the file are born private, and
  # nothing about an existing one is changed.
  ( umask 077; mkdir -p -- "$(dirname -- "$f")" && printf '%s\n' "$line" >>"$f" ) 2>/dev/null || true
  return 0
}

# --- Running under sudo (GHR-89) -----------------------------------------------
# The narrow sudoers contract grants a login runnerctl itself instead of the
# primitives run_priv calls, so under it every word of the command line
# reaches a root process: the grant is exactly as narrow as what this script
# lets a caller say. These are the checks that keep it that narrow — on a host
# that says it has that grant (SUDO_CONTRACT=narrow in the default config);
# elsewhere a caller under sudo is root anyway, and only the environment is
# pinned. run_priv
# needs no change for it — under sudo the uid is already 0, so it never
# prefixes sudo again.
#
# Detection. sudo sets SUDO_UID to the uid of the user who ran it, after its
# env_reset, so a caller can neither set nor clear it — only a SETENV grant
# could, and SETENV also hands BASH_ENV to bash, which runs it before the
# first line of this file (the README says never). So the signal is "root,
# with SUDO_UID a non-zero uid". It is WIDER than the narrow grant — a root
# shell from `sudo -i` inherits SUDO_UID — and that is the safe direction: a
# false positive only refuses, while a root login (no SUDO_UID) or root
# running sudo (SUDO_UID=0) escalated nothing. SUDO_USER is not the signal:
# it is a name, and what was escalated from is a uid.
#
# RUNNERCTL_TEST_SUDO_UID is the sim's stand-in for sudo, without root. It is
# read only by a process that is NOT root, so under real sudo — always root —
# it is never consulted, and all it can do anywhere is turn the refusals on.
under_sudo() {
  if [ "$(id -u)" = 0 ]; then
    [[ "${SUDO_UID:-}" =~ ^[1-9][0-9]*$ ]]
    return
  fi
  [[ "${RUNNERCTL_TEST_SUDO_UID:-}" =~ ^[1-9][0-9]*$ ]]
}

# What a root run keeps of the caller's environment. sudo's env_reset keeps
# PATH unless sudoers sets secure_path, and some versions keep HOME: either
# lets the caller choose the systemctl, curl or tar run as root, or the
# ~/.curlrc and gh config they read. So both are pinned; the variables that
# name a program or a config file are dropped; a pager cannot run a shell
# (LESSSECURE, SYSTEMD_PAGERSECURE); and every RUNNERCTL_* variable is unset,
# which is what makes the test hooks — RUNNERCTL_TEST_*, and the stub's
# RUNNERCTL_STUB_* knobs — inert under sudo by construction, a hook added
# later included. RUNNERCTL_CONFIG has been read by then, into CONFIG_CHOSEN.
SUDO_SAFE_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
sudo_env_harden() {
  local v home
  export PATH="$SUDO_SAFE_PATH"
  home="$(getent passwd 0 2>/dev/null | cut -d: -f6 || true)"
  export HOME="${home:-/root}"
  unset TMPDIR PAGER SYSTEMD_PAGER LESSOPEN LESSCLOSE LESSKEY CURL_HOME \
        XDG_CONFIG_HOME GH_CONFIG_DIR GIT_CONFIG_GLOBAL BASH_ENV ENV
  export LESSSECURE=1 SYSTEMD_PAGERSECURE=1
  for v in $(compgen -e); do
    case "$v" in RUNNERCTL_VERSION) ;; RUNNERCTL_*) unset "$v" ;; esac
  done
}

# The first argument COMMAND may not take under sudo: sets SUDO_FLAG and
# SUDO_WHY and returns 0, or returns 1 when it may take all of them. The rule:
# a value that decides what root runs or sources, where root writes, whose
# account a runner runs as, or what root removes beyond the host's own policy
# comes from the root-owned config, never from the command line. A flag that
# only names, narrows, waits, or pins a digest the download must still match
# is taken. `--flag=value` is the same flag; a value that happens to look like
# a refused flag is refused too, which costs nothing (the command's own parser
# would reject it).
SUDO_FLAG="" SUDO_WHY=""
sudo_flag_problem() { # COMMAND ARGS...
  local cmd="${1:-status}" f val
  shift || true
  SUDO_FLAG="" SUDO_WHY=""
  if [ "$cmd" = fleet ]; then
    SUDO_FLAG=fleet
    SUDO_WHY="a fleet command dials other hosts with this host's ssh identity, which under sudo is root's — run it as the user whose key reaches the fleet"
    return 0
  fi
  while [ $# -gt 0 ]; do
    f="${1%%=*}"
    if [ "$f" != "$1" ]; then val="${1#*=}"; else val="${2:-}"; fi
    case "$cmd:$f" in
      apply:--env-file|scale:--env-file)
        SUDO_WHY="the path is written into each slot's drop-in as EnvironmentFile=, which systemd reads as root into every job's environment, and a newline in it writes any other directive there" ;;
      env-init:--env-file)
        SUDO_WHY="it creates a root-owned file, and the directories above it, wherever it points" ;;
      apply:--save|scale:--save)
        SUDO_WHY="it rewrites $CONFIG_DEFAULT, which every root run sources" ;;
      provision:--url|deprovision:--url)
        SUDO_WHY="it chooses which GitHub account this host's runners take jobs from, or which one a credential is sent to — and a job is code run on this host" ;;
      provision:--runner-user)
        SUDO_WHY="it chooses the account every runner — and so every job — runs as, and which account owns each runner's directory" ;;
      provision:--runner-root|provision:--work)
        SUDO_WHY="it chooses where root unpacks, chowns and writes" ;;
      provision:--runner-version|provision:--no-verify-checksum)
        SUDO_WHY="it chooses what root installs" ;;
      compose-reap:--standalone|compose-reap:--max-age-hours|compose-reap:--grace-minutes)
        SUDO_WHY="it widens what root removes beyond the host's COMPOSE_REAP_* policy" ;;
      install:--prefix|upgrade:--prefix)
        SUDO_WHY="it chooses the directory root writes runnerctl into" ;;
      install:--ref|upgrade:--ref)
        # A version maps to a release asset of UPGRADE_URL's repository, with
        # its digest beside it. A branch or a commit is whatever bytes that
        # name reaches — on GitHub a fork's commit is reachable through the
        # parent repository's raw URL.
        [[ "$val" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] \
          || SUDO_WHY="a branch or commit is whatever bytes that name reaches, so under sudo only a release version (vX.Y.Z) is taken" ;;
      migrate:--from)
        SUDO_WHY="migrate sources that file as bash" ;;
      migrate:--output)
        SUDO_WHY="it chooses where root writes a config, which root runs then source" ;;
    esac
    if [ -n "$SUDO_WHY" ]; then SUDO_FLAG="$f"; return 0; fi
    shift
  done
  return 1
}

# The host's sudo contract, from CONFIG_DEFAULT and nothing else — never from
# CONFIG_FILE, which --config or RUNNERCTL_CONFIG may have pointed elsewhere.
# Sourced in a subshell, only when load_config would trust the file (GHR-7's
# rule), and only the one value kept. Anything but exactly `full` reads as
# narrow: a typo on a host that meant to opt in must not open it back up (a
# loaded default config with a bad value is refused by load_config anyway).
# A file that cannot be trusted, or none, is `full`: whoever can write the
# default config is root on that host whatever this says.
sudo_contract_of_default() {
  local f="$CONFIG_DEFAULT" v=""
  if [ ! -f "$f" ] || [ -n "$(config_trust_problem "$f")" ]; then echo full; return 0; fi
  # shellcheck disable=SC1090
  v="$(set +eu; . "$f" >/dev/null 2>&1; printf '%s' "${SUDO_CONTRACT:-full}")" || true
  if [ "$v" = full ]; then echo full; else echo narrow; fi
}

# The JSON `host.sudo_contract` (GHR-113): what sudo_contract_of_default says,
# for the central node to read under FLEET_SUDO=1. `status` runs as the plain
# login, and the default config is root-owned and world-readable (0644) — it is
# sourced here the way it is under sudo, no privilege asked. Empty (null in
# the JSON) when the file exists and THIS user cannot read it: sourcing it
# would fail and read as `full`, which is a claim this host cannot back.
# No file, or one that fails the trust check, is `full`, as the guard itself
# treats it. Behind a function so a test config can pin it, like host_facts.
host_sudo_contract() {
  if [ -f "$CONFIG_DEFAULT" ] && [ ! -r "$CONFIG_DEFAULT" ]; then return 0; fi
  sudo_contract_of_default
}

# Everything a run under sudo on a host with SUDO_CONTRACT=narrow checks
# before it sources a config or acts on the host. Each refusal says what to
# do instead; none of them is reachable without sudo, nor on a `full` host —
# where the caller is root anyway, and refusing would only break the admin's
# `sudo runnerctl …`.
sudo_preflight() { # COMMAND ARGS...
  if sudo_flag_problem "$@"; then
    die "refusing $SUDO_FLAG under sudo: $SUDO_WHY. This host's SUDO_CONTRACT is narrow: run it without sudo (runnerctl asks sudo for each privileged step itself), or set the value in $CONFIG_DEFAULT where it has a setting there"
  fi
  sudo_config_check
  sudo_self_check "${1:-status}"
}

sudo_config_check() {
  local problem cfgdir
  # GHR-7's ownership check in load_config already refuses a config the
  # caller OWNS here (under sudo the invoking uid is 0, so only root's
  # passes). That is not enough: a root-owned file can carry text the caller
  # wrote — /etc/passwd holds a GECOS field any user sets with chfn, and it
  # is sourced as bash. So the path itself may not be the caller's choice.
  if [ -n "$CONFIG_CHOSEN" ]; then
    die "refusing the config $CONFIG_FILE from $CONFIG_CHOSEN under sudo: a config is sourced as bash, so one the caller picks is code run as root — and root-owned is not enough, since a root-owned file can hold text the caller wrote. This host's SUDO_CONTRACT is narrow, so under sudo only $CONFIG_DEFAULT is read; run without sudo to use another config"
  fi
  if [ -e "$CONFIG_FILE" ]; then
    cfgdir="$(dirname "$CONFIG_FILE")"
    problem="$(root_exec_problem "$cfgdir")"
    [ -z "$problem" ] || die "refusing to source $CONFIG_FILE as root under sudo: $problem, so whoever can write there can replace the config (fix: chown root:root $cfgdir; chmod 755 $cfgdir)"
  fi
}

sudo_self_check() { # COMMAND
  local problem self
  # This file, and the directory it is in, as compose-reap-timer install
  # requires of a root timer's script: a grant of runnerctl is only as narrow
  # as the file it names. This runs inside that file, so it cannot stop
  # someone who has already rewritten it — it is the tripwire that refuses to
  # serve a grant that is open to that, before anyone does.
  # `install` is exempt: it is the command that puts a root-owned copy in
  # place, and `sudo bash ./runnerctl install` from a download the admin owns
  # is how a host is bootstrapped. A piped script has no file to check.
  if [ "$1" != install ] && ! is_piped; then
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    problem="$(root_exec_problem "$self")"
    [ -n "$problem" ] || problem="$(root_exec_problem "$(dirname "$self")")"
    [ -z "$problem" ] || die "refusing to run as root under sudo: $problem — a sudoers grant of runnerctl is only as narrow as the file it names, and one its login can rewrite grants anything (fix: chown root:root $self; chmod 755 $self, in a directory only root can write)"
  fi
}

# --- Config file --------------------------------------------------------------
# The config file is plain bash and is sourced. It may set any of the defaults
# above and define profiles as functions:
#
#   profile_<name>()      sets PROFILE_DESC MEM_MAX MEM_HIGH RESTART_SEC ENV_FILE
#   env_template_<name>() prints the EnvironmentFile template for env-init
#
# A config-defined profile shadows a built-in one of the same name.
# Why FILE may not be sourced, or nothing when it may (GHR-7): a config anyone
# could edit is executed, sometimes under sudo. Shared by load_config and the
# read of the sudo contract (GHR-89), which must trust exactly what
# load_config would.
config_trust_problem() { # FILE
  local f="$1" mode owner group
  mode="$(stat -c '%a' "$f" 2>/dev/null || echo 0)"
  if [ $((8#$mode & 8#002)) -ne 0 ]; then echo "$f is world-writable — refusing to source it"; return 0; fi
  owner="$(stat -c '%u' "$f" 2>/dev/null || echo -1)"
  if [ "$owner" != "0" ] && [ "$owner" != "$(id -u)" ]; then
    echo "$f is owned by uid $owner, not root or the invoking user (uid $(id -u)) — refusing to source it (fix: chown root:root $f; chmod 644 $f)"; return 0
  fi
  group="$(stat -c '%g' "$f" 2>/dev/null || echo -1)"
  if [ $((8#$mode & 8#020)) -ne 0 ] && [ "$group" != "0" ]; then
    echo "$f is group-writable by group $group, not root — refusing to source it (fix: chown root:root $f; chmod 644 $f)"
  fi
}

load_config() {
  [ -f "$CONFIG_FILE" ] || return 0
  local problem; problem="$(config_trust_problem "$CONFIG_FILE")"
  [ -z "$problem" ] || die "$problem"
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  [[ "$SUDO_CONTRACT" =~ ^(full|narrow)$ ]] || die "SUDO_CONTRACT '$SUDO_CONTRACT' set in $CONFIG_FILE is invalid — want full or narrow"
  [[ "$DROPIN_NAME" =~ ^[A-Za-z0-9_-]+\.conf$ ]] || die "DROPIN_NAME '$DROPIN_NAME' set in $CONFIG_FILE is invalid — must match ^[A-Za-z0-9_-]+\\.conf\$"
  [[ -n "$UNIT_GLOB" && "$UNIT_GLOB" != */* ]] || die "UNIT_GLOB '$UNIT_GLOB' set in $CONFIG_FILE is invalid — must be non-empty and contain no '/'"
  [[ "$DEFAULT_PROFILE" =~ ^[A-Za-z0-9_]+$ ]] || die "DEFAULT_PROFILE '$DEFAULT_PROFILE' set in $CONFIG_FILE is invalid — must match ^[A-Za-z0-9_]+\$"
  [[ "$STALL_SEC" =~ ^[0-9]+$ ]] || die "STALL_SEC '$STALL_SEC' set in $CONFIG_FILE is invalid — want a whole number of seconds (0 disables the stalled flag)"
  [[ "$REAP_GRACE_SEC" =~ ^[0-9]+$ ]] || die "REAP_GRACE_SEC '$REAP_GRACE_SEC' set in $CONFIG_FILE is invalid — want a whole number of seconds"
  [[ "$COMPOSE_REAP_MAX_AGE_HOURS" =~ ^[0-9]+$ && "$COMPOSE_REAP_GRACE_MIN" =~ ^[0-9]+$ && "$COMPOSE_REAP_MIN_PID" =~ ^[0-9]+$ ]] || die "COMPOSE_REAP_MAX_AGE_HOURS/COMPOSE_REAP_GRACE_MIN/COMPOSE_REAP_MIN_PID set in $CONFIG_FILE are invalid — want whole numbers"
  [[ "$COMPOSE_REAP_STANDALONE" =~ ^[01]$ ]] || die "COMPOSE_REAP_STANDALONE '$COMPOSE_REAP_STANDALONE' set in $CONFIG_FILE is invalid — want 0 or 1"
  [[ "$COMPOSE_REAP_KEEP_LABEL" =~ ^[A-Za-z0-9._/-]+$ ]] || die "COMPOSE_REAP_KEEP_LABEL '$COMPOSE_REAP_KEEP_LABEL' set in $CONFIG_FILE is invalid — want a Docker label key"
  [[ "$PRESSURE_WARN_PCT" =~ ^[0-9]+$ && "$PRESSURE_CRIT_PCT" =~ ^[0-9]+$ ]] || die "PRESSURE_WARN_PCT/PRESSURE_CRIT_PCT set in $CONFIG_FILE are invalid — want whole percentages"
  [[ "$DISK_WARN_PCT" =~ ^[0-9]+$ && "$DISK_CRIT_PCT" =~ ^[0-9]+$ ]] || die "DISK_WARN_PCT/DISK_CRIT_PCT set in $CONFIG_FILE are invalid — want whole percentages"
  # GHR-79: ratios are read as hundredths (dec_hundredths), never by floating
  # point, so a third decimal or an exponent is refused rather than rounded.
  [[ "$LOAD_WARN_RATIO" =~ ^(0|[1-9][0-9]{0,3})(\.[0-9]{1,2})?$ && "$LOAD_CRIT_RATIO" =~ ^(0|[1-9][0-9]{0,3})(\.[0-9]{1,2})?$ ]] || die "LOAD_WARN_RATIO/LOAD_CRIT_RATIO set in $CONFIG_FILE are invalid — want a ratio of load to cores like 1.0 or 1.25, at most two decimals"
  [[ "$CPU_SAMPLE_MS" =~ ^(0|[1-9][0-9]{0,4})$ ]] || die "CPU_SAMPLE_MS '$CPU_SAMPLE_MS' set in $CONFIG_FILE is invalid — want a whole number of milliseconds up to 99999 (0 = no sample wait)"
  [[ "$EVENTS_SEC" =~ ^[0-9]+$ ]] || die "EVENTS_SEC '$EVENTS_SEC' set in $CONFIG_FILE is invalid — want a whole number of seconds (0 turns the journal search off)"
  # Fleet settings (GHR-39). Validated here, once, rather than per host: a
  # typo in a fleet-wide config should fail before anything is dialled, not
  # produce N identical errors after N connections have been made.
  [[ "$FLEET_PARALLEL" =~ ^[1-9][0-9]*$ ]] || die "FLEET_PARALLEL '$FLEET_PARALLEL' set in $CONFIG_FILE is invalid — want a whole number of hosts, 1 or more"
  [[ "$FLEET_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "FLEET_TIMEOUT '$FLEET_TIMEOUT' set in $CONFIG_FILE is invalid — want a whole number of seconds, 1 or more"
  [[ "$FLEET_MUTATE_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "FLEET_MUTATE_TIMEOUT '$FLEET_MUTATE_TIMEOUT' set in $CONFIG_FILE is invalid — want a whole number of seconds, 1 or more"
  # GHR-150: 10 at least, so the heartbeat it asks for (a quarter of it) is
  # 2 s or more and half of it is left for the ssh round trip.
  if ! [[ "$FLEET_MUTATE_IDLE" =~ ^(0|[1-9][0-9]{0,5})$ ]] || { [ "$FLEET_MUTATE_IDLE" != 0 ] && [ "$FLEET_MUTATE_IDLE" -lt 10 ]; }; then
    die "FLEET_MUTATE_IDLE '$FLEET_MUTATE_IDLE' set in $CONFIG_FILE is invalid — want 0 (off) or a whole number of seconds, 10 or more"
  fi
  if ! [[ "$FLEET_MUTATE_MAX" =~ ^[1-9][0-9]{0,6}$ ]] || [ "$FLEET_MUTATE_MAX" -le "$FLEET_MUTATE_IDLE" ]; then
    die "FLEET_MUTATE_MAX '$FLEET_MUTATE_MAX' set in $CONFIG_FILE is invalid — want a whole number of seconds, more than FLEET_MUTATE_IDLE ($FLEET_MUTATE_IDLE)"
  fi
  [[ "$FLEET_WATCH_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "FLEET_WATCH_TIMEOUT '$FLEET_WATCH_TIMEOUT' set in $CONFIG_FILE is invalid — want a whole number of seconds, 1 or more"
  [ -n "$FLEET_RUNNERCTL" ] || die "FLEET_RUNNERCTL set in $CONFIG_FILE is empty — want the remote command name or an absolute path"
  [[ "$FLEET_SUDO" =~ ^[01]$ ]] || die "FLEET_SUDO '$FLEET_SUDO' set in $CONFIG_FILE is invalid — want 0 or 1"
  [ -z "$FLEET_LOG" ] || [[ "$FLEET_LOG" == /?* ]] || die "FLEET_LOG '$FLEET_LOG' set in $CONFIG_FILE is invalid — want an absolute path (empty = ~/.local/state/runnerctl/fleet.log)"
  # Provisioning settings (GHR-45). Checked here so a typo fails before a
  # download, a useradd or a registration — not half way through slot 3.
  [[ "$RUNNER_ROOT" == /* ]] || die "RUNNER_ROOT '$RUNNER_ROOT' set in $CONFIG_FILE is invalid — want an absolute path"
  valid_user_name "$RUNNER_USER" || die "RUNNER_USER '$RUNNER_USER' set in $CONFIG_FILE is invalid — want a POSIX user name"
  [ -z "$RUNNER_GROUP" ] || valid_user_name "$RUNNER_GROUP" || die "RUNNER_GROUP '$RUNNER_GROUP' set in $CONFIG_FILE is invalid — want a POSIX group name"
  [ -z "$RUNNER_NAME_PREFIX" ] || valid_runner_name "$RUNNER_NAME_PREFIX" || die "RUNNER_NAME_PREFIX '$RUNNER_NAME_PREFIX' set in $CONFIG_FILE is invalid — want letters, digits, dot, dash or underscore"
  [ -z "$RUNNER_VERSION" ] || valid_runner_version "$RUNNER_VERSION" || die "RUNNER_VERSION '$RUNNER_VERSION' set in $CONFIG_FILE is invalid — want X.Y.Z"
  [[ "$RUNNER_WORK" != /* && -n "$RUNNER_WORK" ]] || die "RUNNER_WORK '$RUNNER_WORK' set in $CONFIG_FILE is invalid — want a path relative to the runner's own directory"
  [ -z "$RUNNER_URL" ] || valid_runner_url "$RUNNER_URL" || die "RUNNER_URL '$RUNNER_URL' set in $CONFIG_FILE is invalid — want https://github.com/<org>[/<repo>] or an enterprise URL"
}

# Built-in profiles. Site-specific values belong in the config file; these are
# sane, generic defaults so the tool works with no config at all.
builtin_profile() {
  case "$1" in
    ci)
      # Memory-capped so parallel jobs can't OOM a shared box; auto-restart.
      # 2 slots × 26G leaves headroom on a 60G box; bump on a bigger box.
      # MemoryHigh sits 1G under the cap on purpose: memory.high throttles
      # instead of killing, and a build crawling in a wide throttle band
      # for hours is worse for CI than a fast exit 137 (GHR-28).
      PROFILE_DESC="CI build/test pool — memory-capped, auto-restart."
      MEM_MAX="26G"; MEM_HIGH="25G"; RESTART_SEC="10"; ENV_FILE=""
      ;;
    deploy)
      # Long-lived, auto-restart, uncapped (deploys are SSH/release-bound and a
      # cap risks killing a mid-deploy step). Secrets come from a root-owned
      # on-device EnvironmentFile, never from GitHub Actions secrets.
      PROFILE_DESC="Deploy runner — on-device secrets, uncapped, auto-restart."
      MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="15"; ENV_FILE="/etc/runnerctl/deploy.env"
      ;;
    *) return 1 ;;
  esac
}

load_profile() {
  [ -n "$PROFILE" ] || PROFILE="$DEFAULT_PROFILE"
  [[ "$PROFILE" =~ ^[A-Za-z0-9_]+$ ]] || die "invalid profile name '$PROFILE'"
  if declare -F "profile_$PROFILE" >/dev/null; then
    "profile_$PROFILE"
  elif ! builtin_profile "$PROFILE"; then
    die "unknown profile '$PROFILE' (known: $(list_profiles | paste -sd" "))"
  fi
}

list_profiles() {
  { printf 'ci\ndeploy\n'; declare -F | awk '$3 ~ /^profile_/ {sub(/^profile_/, "", $3); print $3}'; } | sort -u
}

# EnvironmentFile template for env-init, in priority order: a config-defined
# env_template_<profile> function, an ENV_TEMPLATE file path set by the
# profile, else a generic placeholder header. The live file is filled in on the
# box and never committed anywhere.
render_env_template() {
  if declare -F "env_template_$PROFILE" >/dev/null; then
    "env_template_$PROFILE"
  elif [ -n "$ENV_TEMPLATE" ]; then
    [ -r "$ENV_TEMPLATE" ] || die "ENV_TEMPLATE $ENV_TEMPLATE not readable"
    cat "$ENV_TEMPLATE"
  else
    cat <<TEMPLATE
# $PROFILE runner — on-device secrets/config (scaffolded by runnerctl).
#
# Loaded by the runner's systemd unit (EnvironmentFile=) so jobs inherit these
# as environment variables.
#
# * This file is root-owned, chmod 600, and lives ONLY on this device.
# * Never commit it, and keep these values out of GitHub Actions secrets —
#   on-device is the whole point (shrinks the blast radius of the runner).
#
# Define a site-specific template in the runnerctl config file with an
# env_template_${PROFILE}() function, or point ENV_TEMPLATE at a file.

# KEY=value
TEMPLATE
  fi
}

# --- Argument handling --------------------------------------------------------
# Pull --profile out of the arg list first so the profile loads before any
# value flags, letting flags override the profile's defaults. Leaves the rest
# of the args in the REMAINING array.
extract_profile() {
  REMAINING=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --profile) need_val "$@"; PROFILE="$2"; shift 2 ;;
      *) REMAINING+=("$1"); shift ;;
    esac
  done
}

# A memory limit as systemd's MemoryMax=/MemoryHigh= accept it: a byte count
# with an optional K/M/G/T suffix, or the literal "infinity".
valid_mem() { [[ "$1" =~ ^[0-9]+[KMGT]?$ ]] || [ "$1" = infinity ]; }

parse_opts() {
  TARGETS=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --max)         need_val "$@"; valid_mem "$2" || die "--max value '$2' is invalid — want an integer with an optional K/M/G/T suffix, or 'infinity'"; MEM_MAX="$2"; shift 2 ;;
      --high)        need_val "$@"; valid_mem "$2" || die "--high value '$2' is invalid — want an integer with an optional K/M/G/T suffix, or 'infinity'"; MEM_HIGH="$2"; shift 2 ;;
      --restart-sec) need_val "$@"; [[ "$2" =~ ^[0-9]+$ ]] || die "--restart-sec value '$2' is invalid — want an integer"; RESTART_SEC="$2"; shift 2 ;;
      --env-file)    need_val "$@"; ENV_FILE="$2"; shift 2 ;;
      --restart)     do_restart=true; shift ;;
      --save)        do_save=true; shift ;;
      --when-idle)   when_idle=true; shift ;;
      --timeout)     need_val "$@"; set_timeout "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             TARGETS+=("$1"); shift ;;
    esac
  done
}

# --timeout N: whole seconds. Shared by parse_opts and cmd_ctl's own loop.
set_timeout() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "--timeout value '$1' is invalid — want an integer number of seconds"
  WAIT_TIMEOUT="$1"
}

# --- Runner discovery / inspection -------------------------------------------
# `list-unit-files` exits 1 when the glob matches nothing, and under `pipefail`
# that became discover's own status — so `have="$(discover | wc -l)"` in
# `provision` inherited it and `set -e` killed the script before its first
# echo: no output, exit 1, on precisely the bare host provision exists for
# (GHR-48). A host with no runner units is an answer, not a failure, so the
# status is swallowed here rather than at each of the sixteen call sites.
discover() {
  { systemctl list-unit-files --no-legend "$UNIT_GLOB" 2>/dev/null || true; } \
    | awk '{print $1}' | sort -V
}

# A host with no runner units is the normal state of a NEW box, not a broken
# one, so the refusal names the command that fixes it (GHR-45) instead of
# leaving the reader to find out that `install` installs this script and
# nothing here installs a runner.
require_runners() {
  [ -n "$(discover)" ] || die "no '$UNIT_GLOB' units found on this host. This box has no runners yet — 'runnerctl provision N --url https://github.com/<org>' installs and registers them; 'runnerctl provision --help' lists the options."
}

prop() { systemctl show "$1" -p "$2" --value 2>/dev/null; }

# One `systemctl show` call for every property `status` needs, instead of one
# per column: prints KEY=VALUE lines (a value can itself contain '=', e.g.
# EnvironmentFiles=/etc/x (ignore_errors=no) — callers must split on the
# FIRST '=' only). A config can shadow this to stub `status` under test.
unit_props() {
  systemctl show "$1" -p ActiveState,SubState,UnitFileState,MemoryMax,MemoryHigh,MemoryCurrent,MemoryPeak,Restart,EnvironmentFiles,ControlGroup,ActiveEnterTimestampMonotonic,InactiveEnterTimestampMonotonic,NRestarts,Result,InvocationID 2>/dev/null
}

# --- What is a runner working on? ---------------------------------------------
# The Listener writes two lines to its stdout (the journal, via the svc.sh
# unit) that bracket every job:
#   <utc>: Running job: <job display name>
#   <utc>: Job <job display name> completed with result: Succeeded|Failed|Canceled
# The last `Running job:` line with no later `completed with result:` line is
# the job the slot is on, for the whole job — stable between steps and for
# container jobs, where the /proc environ walk below sees nothing — and it is
# readable by anyone in the systemd-journal group, not only the runner user.
# The strings are from the actions/runner source (Runner.Listener's
# JobDispatcher), not yet verified against a host's journal.
#
# Prints the journal lines of UNIT's current invocation (scoped by
# INVOCATION-ID when given, so a previous run's job cannot leak in) that
# mention a job start or end, in `-o short-unix` form: the first field is the
# epoch second the line was logged. Returns 1 and prints nothing when the
# journal cannot be read — decided by journal_job_lines' `--system` access
# probe, below, not by the search. Read-only and called directly, never
# through run_priv — status must never prompt for sudo. A config can shadow
# this to stub it.
#
# The search itself carries no `--system` (GHR-148). journald's default
# SplitMode=uid files the messages of a unit running as a regular user
# (uid >= 1000) in user-<uid>.journal, and `--system` opens only the system
# journal files, so for such a runner a `--system` search saw systemd[1]'s
# own start/stop lines and never the Listener's job lines: every slot read
# `idle (no jobs yet)`, busy or not. Measured on such a host: 0 lines with
# `--system`, 3520 without. A reader with journal access (systemd-journal,
# root) sees every file without it; `-u` still scopes the search to the unit.
#
# The filtering is journalctl's own `-g` (a regex over MESSAGE), not a tail:
# a `-n` window would be eaten by every other line the Listener writes
# ("Listening for Jobs", update checks, per-job noise), so on a slot up for
# weeks the `(N jobs)` count would silently cover only the last few hundred
# lines (GHR-26). With `-g` the fetch is exactly the job lines of the
# invocation, however long it has been running.
JOURNAL_JOB_PATTERN='Running job: |completed with result: '

# The journalctl argv for UNIT [INVOCATION-ID], one argument per line, so the
# harness can assert on it without a journal (journal_job_lines itself is
# stubbed under `make sim`).
journal_job_args() { # UNIT [INVOCATION-ID]
  printf '%s\n' -u "$1" -o short-unix --no-pager -q -g "$JOURNAL_JOB_PATTERN"
  [ -n "${2:-}" ] && printf '%s\n' "_SYSTEMD_INVOCATION_ID=$2"
  return 0
}

# Two calls, because one cannot tell "no access" from "no match" (GHR-65):
# `journalctl -g` exits 1 when NOTHING MATCHES — measured, as root, on a
# readable journal — the same status it gives a user outside systemd-journal.
# So access is asked first with `-n 1`, which exits 0 on an empty journal
# too, and the search's own non-zero then means only "no job line yet":
# success with no output, which job_facts reads as a fresh slot, not a
# missing journal. The probe keeps `--system` and the search does not
# (GHR-148): without it a user outside systemd-journal gets their OWN user
# journal and exit 0 (probed on systemd 261), indistinguishable from an idle
# slot; with it journalctl says "insufficient permissions" and exits 1. A
# reader the probe admits can read the user-<uid>.journal files the search
# needs; one it refuses never reaches the search.
journal_job_lines() { # UNIT [INVOCATION-ID]
  local args=()
  mapfile -t args < <(journal_job_args "$@")
  journalctl --system -q --no-pager -n 1 >/dev/null 2>&1 || return 1
  journalctl "${args[@]}" 2>/dev/null || true
}

# Journal memo for `watch` (GHR-3). A redraw every 2 s would otherwise run
# one journalctl per slot per tick, and a job start or end is not worth
# seeing that fast: `watch` keeps a memo directory and empties it every
# JOURNAL_CACHE_TTL ticks, so the journal-derived cells lag a redraw by up to
# TTL × interval seconds while everything else is live. It is a directory,
# not an array, because the renderer runs inside "$(...)" (twice: the frame
# capture and job_info's cell) and nothing written to a shell variable there
# survives the tick. Outside `watch` JOURNAL_MEMO_DIR is empty and every call
# goes straight to the journal_job_lines hook — a plain `status` and the
# --when-idle polls are never stale. The memo wraps the hook rather than
# replacing it, so a config that shadows journal_job_lines is what gets
# memoised. Keyed by unit and invocation id, so a restart is a fresh entry.
JOURNAL_CACHE_TTL=10
JOURNAL_MEMO_DIR=""
journal_job_lines_cached() { # UNIT [INVOCATION-ID]
  [ -n "$JOURNAL_MEMO_DIR" ] || { journal_job_lines "$@"; return; }
  local f="$JOURNAL_MEMO_DIR/$1.${2:-none}" out rc=0
  if [ ! -f "$f.rc" ]; then
    out="$(journal_job_lines "$@")" || rc=$?
    printf '%s\n' "$out" >"$f"
    echo "$rc" >"$f.rc"
  fi
  cat "$f"
  rc="$(cat "$f.rc")"
  return "$rc"
}

# Parse those lines: prints "<job name>\t<epoch second>" for the running job
# (the last `Running job:` line with no later `completed with result:` line),
# nothing when the slot is idle. Pure, so it is unit-testable (`run_fn`).
journal_running_job() { # LINES
  local line name="" ts=""
  while IFS= read -r line; do
    case "$line" in
      *"completed with result: "*) name=""; ts="" ;;
      *"Running job: "*)           name="${line##*Running job: }"; ts="${line%% *}"; ts="${ts%%.*}" ;;
    esac
  done <<<"$1"
  [ -n "$name" ] || return 0
  printf '%s\t%s\n' "$name" "$ts"
}

# The idle side of the same lines: prints "<epoch second of the last
# completion>\t<completed count>" — the count of `completed with result:`
# lines, i.e. jobs finished in this invocation of the unit — nothing when no
# job has completed since the unit started. Pure, like journal_running_job;
# both read the one journal fetch job_info already makes (GHR-2).
journal_idle_info() { # LINES
  local line ts="" n=0
  while IFS= read -r line; do
    case "$line" in
      *"completed with result: "*) n=$((n + 1)); ts="${line%% *}"; ts="${ts%%.*}" ;;
    esac
  done <<<"$1"
  [ "$n" -gt 0 ] || return 0
  printf '%s\t%s\n' "$ts" "$n"
}

# GHR-8: the reason a slot's last restart happened, for the ACTIVE cell's
# "(last: ...)" suffix. systemd resets NRestarts on `systemctl start/restart`
# but the *reason* for a previous restart only exists in the journal —
# systemd[1]'s own "A process of this unit has been killed by the OOM
# killer." sentence, or its "Main process exited, code=X, status=N[/NAME]"
# line — not yet verified against a host's journal. Called only when
# NRestarts > 0 (one extra journalctl fork per slot, at most), read-only and
# direct like journal_job_lines — status must never prompt for sudo. Prints
# nothing when the journal cannot be read or carries neither line. A config
# can shadow this to stub it. `--system` stays here, unlike the job-line
# search (GHR-148): both sentences are systemd[1]'s own, which journald files
# in the system journal whatever user the unit runs as.
journal_restart_reason() { # UNIT
  local out lines line
  out="$(journalctl --system -u "$1" -o cat --no-pager -q -n 200 2>/dev/null)" || return 0
  lines="$(grep -E 'OOM killer|Main process exited' <<<"$out" || true)"
  [ -n "$lines" ] || return 0
  line="$(tail -n1 <<<"$lines")"
  journal_restart_reason_line "$line"
}

# Pure normaliser for one journal line (unit-testable via run_fn), like
# journal_running_job/journal_idle_info are for journal_job_lines' output:
#   *killed by the OOM killer*                       -> oom-kill
#   Main process exited, code=exited, status=N[/...]  -> exit-code N
#   Main process exited, code=killed, status=N/NAME   -> signal NAME
# Nothing, and success (0), for a line matching none of these.
journal_restart_reason_line() { # LINE
  case "$1" in
    *'killed by the OOM killer'*) echo "oom-kill"; return 0 ;;
  esac
  if [[ "$1" =~ code=exited,\ status=([0-9]+) ]]; then
    printf 'exit-code %s\n' "${BASH_REMATCH[1]}"; return 0
  fi
  if [[ "$1" =~ code=killed,\ status=[0-9]+/([A-Za-z0-9]+) ]]; then
    printf 'signal %s\n' "${BASH_REMATCH[1]}"; return 0
  fi
  return 0
}

# The /proc side: only the runner's user or root can read a slot's processes.
# Three hooks, so a config can stub the walk without replacing job_info.
cgroup_readable() { [ -n "${1:-}" ] && [ -r "/sys/fs/cgroup${1}/cgroup.procs" ]; }

# GHR-120: the cgroup's pids, one per line, read in ONE go. Every walk below
# reads this, never the file itself line by line: bash's `read` on a seekable
# file reads ahead and seeks back to the end of the line it took, and
# cgroup.procs is a kernel seq_file that answers each seek by walking the
# list again from the start up to that byte offset. When a process ahead of
# the walk's position exits between two lines, the same offset now lands one
# entry further on, and a live pid is skipped without a sound — measured at
# 4-8 walks in 100 with other processes coming and going in the cgroup, and
# none for a whole-file read. A skipped pid is a leaked process `reap` never
# signals, a job process `kill` leaves running, or a Worker job_facts misses.
cgroup_procs() { # CGROUP
  local procs
  procs="$(<"/sys/fs/cgroup${1}/cgroup.procs")" || return 0
  [ -z "$procs" ] || printf '%s\n' "$procs"
}

# Runner.Worker is spawned once per job, so its age is the job's runtime.
# Prints its pid; nothing when there is none or the cgroup cannot be read.
proc_worker_pid() { # CGROUP
  local pid
  cgroup_readable "$1" || return 0
  while read -r pid; do
    if [ -r "/proc/$pid/cmdline" ] && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "Runner.Worker"; then
      echo "$pid"; return 0
    fi
  done < <(cgroup_procs "$1")
}

# The job's own variables out of one environment block — FILE is a
# /proc/<pid>/environ, NUL-separated. Prints them as KEY=VALUE lines, one per
# variable; 1 and nothing when the block has no GITHUB_REPOSITORY. GHR-78: the
# run's identity sits in the block that was already being read for the
# repository and the job id, so it costs no second read and no new access.
#
# A newline INSIDE a value becomes a space before the NULs become newlines:
# the output is one line per variable, and a value could otherwise end its own
# line and start one that reads as a different variable. Split from the walk
# below so a test can hand it a fixture file — the walk itself needs a cgroup.
PROC_JOB_ENV_RE='^GITHUB_(REPOSITORY|JOB|WORKFLOW|RUN_ID|RUN_ATTEMPT|RUN_NUMBER|REF_NAME|SHA|ACTOR|EVENT_NAME|SERVER_URL)='
proc_environ_job_vars() { # FILE
  local env
  env="$(tr '\n\0' ' \n' <"$1" 2>/dev/null || true)"
  case "$env" in
    *GITHUB_REPOSITORY=*) grep -E "$PROC_JOB_ENV_RE" <<<"$env" ;;
    *)                    return 1 ;;
  esac
}

# The job's variables from the environment of the first process in the cgroup
# that carries them (GITHUB_* is injected into the STEP processes, not into
# Runner.Worker, so between steps and for container jobs there is none).
# Prints KEY=VALUE lines (proc_environ_job_vars); nothing otherwise.
#
# Every one of these values is whatever a process in the slot chose to put in
# its environment — a step can start a child with any GITHUB_* it likes — so
# the readers treat them as hostile text: job_env_facts for what is kept,
# term_safe for what is drawn.
proc_job_env() { # CGROUP
  local pid
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/environ" ] || continue
    if proc_environ_job_vars "/proc/$pid/environ"; then return 0; fi
  done < <(cgroup_procs "$1")
}

# GHR-29: the processes in the cgroup that are not the runner's own — what a
# finished job left behind (a dev server, a watcher, a node child that
# ignored SIGTERM). Prints `pid<TAB>comm` per process; nothing when the
# cgroup cannot be read. Only meaningful while the slot is idle: during a
# job every step process is "not the runner's own" too, so job_facts asks
# only then. The runner's own tree, as svc.sh installs it: runsvc.sh ->
# node RunnerService.js -> Runner.Listener, which spawns Runner.Worker per
# job and Runner.PluginHost for its own plugins. A config can extend the
# pattern (RUNNER_OWN_PATTERN) for a runner image that wraps it differently.
# Processes in a job's own docker containers live under the docker daemon,
# not here — neither the cap nor this walk sees them.
RUNNER_OWN_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.(Listener|Worker|PluginHost)'
proc_leaked() { # CGROUP
  local pid cmd comm
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    # An empty cmdline is a zombie or a kernel thread: nothing to kill.
    [ -n "$cmd" ] || continue
    [[ "$cmd" =~ $RUNNER_OWN_PATTERN ]] && continue
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"
    printf '%s\t%s\n' "$pid" "$comm"
  done < <(cgroup_procs "$1")
}

# GHR-36: the job's own process tree — everything in the cgroup that is NOT
# the Listener side of the runner. `runsvc.sh` -> node RunnerService.js ->
# Runner.Listener is what must survive a `kill`: it is the process that
# notices its Worker died, reports the job failed to GitHub and goes back to
# waiting, so the slot is idle in seconds with no restart and no
# re-registration. Everything else in the cgroup — Runner.Worker,
# Runner.PluginHost and every step process under them — is the job.
# Prints `pid<TAB>comm` per process; nothing when the cgroup cannot be read
# (then `kill` escalates to systemd, which can signal it without reading it).
# Containers a job started live under the docker daemon's cgroup, not here.
RUNNER_LISTENER_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.Listener'
proc_job_tree() { # CGROUP
  local pid cmd comm
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    # An empty cmdline is a zombie or a kernel thread: nothing to kill.
    [ -n "$cmd" ] || continue
    [[ "$cmd" =~ $RUNNER_LISTENER_PATTERN ]] && continue
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"
    printf '%s\t%s\n' "$pid" "$comm"
  done < <(cgroup_procs "$1")
}

# Is PID still around (and not a zombie)? Behind a function so a test
# config can answer for `reap`'s survivors.
pid_alive() { # PID
  local s
  s="$(awk '/^State:/{print $2}' "/proc/$1/status" 2>/dev/null)" || return 1
  [ -n "$s" ] && [ "$s" != Z ]
}

# GHR-31: what the kernel says about the slot's memory, from its cgroup.
# memory.events carries counters since the unit started — `high`: times
# memory.high throttled it, `max`: times it hit memory.max, `oom_kill`:
# processes the OOM killer took — and memory.pressure the PSI line `full
# avg10=X avg60=Y avg300=Z total=US`: the share of the last 10/60/300 s
# EVERY task in the cgroup spent stalled on memory. Prints one key=value
# line each (events_high, events_max, events_oom_kill, pressure_full_avg10,
# pressure_full_avg60, pressure_full_total); nothing for an empty cgroup or
# a file that cannot be read. Plain reads, no run_priv — both files are
# world-readable, so status never prompts. A config can shadow it.
cgroup_memory_facts() { # CGROUP
  local d="/sys/fs/cgroup${1:-}" k v
  [ -n "${1:-}" ] || return 0
  if [ -r "$d/memory.events" ]; then
    while read -r k v; do
      case "$k" in high|max|oom_kill) echo "events_$k=$v" ;; esac
    done <"$d/memory.events"
  fi
  if [ -r "$d/memory.pressure" ]; then
    awk '$1 == "full" { for (i = 2; i <= NF; i++) { split($i, a, "="); if (a[1] == "avg10" || a[1] == "avg60" || a[1] == "total") print "pressure_full_" a[1] "=" a[2] } }' "$d/memory.pressure"
  fi
}

# GHR-79: what the kernel says about the slot's CPU, from its cgroup.
# cpu.stat's `usage_usec` is the CPU time every task in the cgroup has used
# since it was created — cumulative, so a rate needs two reads (see
# render_status) — and cpu.pressure's `some` line the share of the last
# 10/60 s at least one task waited for a CPU. Prints usage_usec=N and
# pressure_some_avg10/avg60/total=V, nothing for a file that cannot be read
# (CPU accounting off: cgroup v1, or a unit without CPUAccounting on an old
# systemd) — which is `—`, never 0. Plain reads, world-readable files. A
# config can shadow it; the two parsers below take a FILE so a test can hand
# them a fixture.
cgroup_cpu_facts() { # CGROUP
  local d="/sys/fs/cgroup${1:-}" v
  [ -n "${1:-}" ] || return 0
  v="$(cpu_stat_usage "$d/cpu.stat")"
  [ -z "$v" ] || echo "usage_usec=$v"
  cpu_pressure_some "$d/cpu.pressure"
}
# usage_usec out of a cpu.stat FILE (`usage_usec 123`, `user_usec …`, …):
# the digits, nothing when the file or the field is not there.
cpu_stat_usage() { # FILE
  local k v
  [ -r "$1" ] || return 0
  while read -r k v _; do
    [ "$k" = usage_usec ] || continue
    if [[ "$v" =~ ^[0-9]+$ ]]; then printf '%s\n' "$v"; fi
    return 0
  done <"$1"
}
# The `some` line of a cpu.pressure FILE as pressure_some_avg10/avg60/total.
cpu_pressure_some() { # FILE
  [ -r "$1" ] || return 0
  awk '$1 == "some" { for (i = 2; i <= NF; i++) { split($i, a, "="); if (a[1] == "avg10" || a[1] == "avg60" || a[1] == "total") print "pressure_some_" a[1] "=" a[2] } }' "$1"
}

# GHR-79: the 1-, 5- and 15-minute load averages, "L1 L5 L15", out of a
# /proc/loadavg FILE; nothing unless all three are decimals. Split from
# host_loadavg (the hook a config shadows) so a test can hand it a fixture.
loadavg_read() { # FILE
  local l1 l5 l15
  [ -r "$1" ] || return 0
  read -r l1 l5 l15 _ <"$1" || return 0
  local re='^[0-9]+(\.[0-9]+)?$'
  [[ "$l1" =~ $re && "$l5" =~ $re && "$l15" =~ $re ]] || return 0
  printf '%s %s %s\n' "$l1" "$l5" "$l15"
}
host_loadavg() { loadavg_read /proc/loadavg; }

# Microseconds since the epoch, for a CPU sample's wall time (GHR-79): bash's
# own clock where it has one, else date. Behind a function so a test config
# can pin it, as now_epoch is.
now_us() {
  local t="${EPOCHREALTIME:-}"
  if [[ "$t" =~ ^([0-9]+)[.,]([0-9]{6})$ ]]; then
    echo "${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  else
    date +%s%6N
  fi
}
# The one wait a one-shot table makes for its CPU sample, in milliseconds.
# Not `pause`: --when-idle's polls are counted through that one.
cpu_window_wait() { # MS
  sleep "$(ms_to_secs "$1")"
}

# PID's parent, from /proc — nothing when PID is gone. Past the last `)`: the
# comm field between the parentheses may itself hold spaces and parentheses.
proc_ppid() { # PID
  local s
  s="$(cat "/proc/$1/stat" 2>/dev/null)" || return 0
  s="${s##*) }"
  read -r _ s _ <<<"$s"
  echo "$s"
}
# PID's direct children, one per line. The kernel's own list where it keeps
# one (reliable only while PID is stopped, which is how proc_tree_kill reads
# it), else every process whose parent is PID.
proc_children() { # PID
  local f="/proc/$1/task/$1/children" d kid
  if [ -r "$f" ]; then
    for kid in $(cat "$f" 2>/dev/null || true); do echo "$kid"; done
    return 0
  fi
  for d in /proc/[0-9]*; do
    kid="${d#/proc/}"
    [ "$(proc_ppid "$kid")" != "$1" ] || echo "$kid"
  done
}
# TERM for PID and everything under it (GHR-74). Signalling the group is not
# enough: `timeout` puts itself and its command in a group of their own, so a
# background job's ssh is not in the job's group. Each process is STOPPED
# before its children are listed, so it cannot start another one between the
# listing and its own TERM — which is delivered when it is continued.
proc_tree_kill() { # PID
  local kid
  kill -STOP "$1" 2>/dev/null || return 0
  for kid in $(proc_children "$1"); do proc_tree_kill "$kid"; done
  kill -TERM "$1" 2>/dev/null || true
  kill -CONT "$1" 2>/dev/null || true
}

# Epoch seconds; a config can shadow it to pin the journal-derived runtime.
now_epoch() { date +%s; }
# Epoch milliseconds, for scheduling `fleet watch`'s ticks (GHR-74): its waits
# are fractions of a second, and a deadline kept in whole seconds would put
# every tick up to a second early or late. From bash's own clock where it has
# one (5.0 on — no fork, and its decimal mark follows the locale), else from
# date. Behind a function for the same reason as now_epoch.
now_ms() {
  local t="${EPOCHREALTIME:-}"
  if [[ "$t" =~ ^([0-9]+)[.,]([0-9]{3}) ]]; then
    echo "${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  else
    date +%s%3N
  fi
}
# MILLISECONDS as the seconds `read -t` and `sleep` take: 5000 -> 5, 4412 ->
# 4.412.
ms_to_secs() { # MILLISECONDS
  if [ $(($1 % 1000)) -eq 0 ]; then echo $(($1 / 1000)); else printf '%d.%03d\n' $(($1 / 1000)) $(($1 % 1000)); fi
}

# The WORKING-ON cell. Takes the cgroup, invocation id and active-enter stamp
# (µs since boot) from the caller's already-fetched unit_props (GHR-4)
# instead of fetching them itself.
#   —              the unit has no cgroup (not running)
#   idle 2h31m (7 jobs)
#                  the journal is readable and no job is in flight: time
#                  since the last `completed with result:` line of this
#                  invocation, and how many there are — jobs finished since
#                  the unit started (GHR-2)
#   idle 41m (no jobs yet)
#                  idle, and nothing has completed since the unit started:
#                  time since the active-enter stamp instead
#   repo:job (7h2m) STALLED
#                  the job has run for STALL_SEC seconds or more (GHR-27)
#   repo:job (12m) the journal names the job; the repo comes from the /proc
#                  environ walk when that is readable (the job name alone
#                  otherwise), the runtime from the Runner.Worker age, or from
#                  the `Running job:` line's journal timestamp when the worker
#                  cannot be seen
# Without journal access the old /proc-only logic runs, and `(starting)`
# survives only there: a live Runner.Worker with no GITHUB_* process is the
# only signal of a job in /proc, and it cannot tell startup from between-steps
# (the flicker GHR-10 removes for every reader with journal access).
#   idle ?         the cgroup is readable but the journal is not: /proc shows
#                  no job, and the idle time and count are unknowable there
#   (no access)    neither the journal nor the cgroup can be read
# For the last two cmd_status prints a one-line hint under the table.
#
# GHR-16: the facts and the cell are two functions over one journal fetch.
# job_facts leaves the raw picture in the JOB_* variables — the table
# (job_cell) and `status --json` both read those, so the two cannot disagree
# on what a slot is doing:
#   JOB_STATE   none | running | idle | idle-fresh | starting | idle-unknown
#               | no-access — `running` covers both the journal's answer and
#               the /proc-only one, `idle-fresh` is "idle (no jobs yet)"
#   JOB_NAME / JOB_REPO
#               the running job and its repository (short, `my-app`), either
#               empty when unknown
#   JOB_SINCE   epoch second the running job started: the Runner.Worker's
#               start when it can be seen, else the `Running job:` line's
#               stamp; empty when neither is known
#   JOB_RUNTIME the running job's age as the cell prints it, empty when unknown
#   JOB_STALLED true when the running job's age is STALL_SEC or more, false
#               when it is known and under, empty when the age is unknown
#               or STALL_SEC is 0 (GHR-27)
#   JOB_IDLE_SINCE / JOB_DONE
#               epoch second of the last completion (or of the unit's start
#               for idle-fresh) and the completed count (0 for idle-fresh)
#   JOB_ACCESS  ok | no-journal | no-access — what could be read: `no-journal`
#               is the /proc-only picture, `no-access` neither source
#   JOB_LEAKED / JOB_LEAKED_PIDS / JOB_LEAKED_COMMS
#               while idle with a readable cgroup: how many processes a
#               finished job left in it, their pids (space-separated) and
#               their comms, each made safe to draw and joined on COMM_SEP
#               (GHR-100); JOB_LEAKED empty when the slot is busy or the
#               cgroup cannot be read (GHR-29)
#   JOB_REPO_FULL / JOB_WORKFLOW / JOB_RUN_ID / JOB_RUN_ATTEMPT / JOB_RUN_NUMBER
#   / JOB_REF / JOB_SHA / JOB_ACTOR / JOB_EVENT / JOB_URL
#               the run the job belongs to (GHR-78), from the same environment
#               block as JOB_REPO: `owner/name`, the workflow's name, the run's
#               id, attempt and number, the branch or tag, the commit, who
#               triggered it, the event, and the run's page. Each empty when
#               the block is not readable or the value does not pass
#               job_env_facts' rules — see there
JOB_STATE="" JOB_NAME="" JOB_REPO="" JOB_SINCE="" JOB_RUNTIME="" JOB_STALLED="" JOB_IDLE_SINCE="" JOB_DONE="" JOB_ACCESS=""
JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
JOB_REPO_FULL="" JOB_ENV_NAME="" JOB_WORKFLOW="" JOB_RUN_ID="" JOB_RUN_ATTEMPT="" JOB_RUN_NUMBER=""
JOB_REF="" JOB_SHA="" JOB_ACTOR="" JOB_EVENT="" JOB_URL=""

# --- Text a job supplied (GHR-78) ---------------------------------------------
# A workflow's name, a branch, an actor, the repository and the job id are
# strings somebody outside this host chose, read out of a process environment
# anything in the slot can set. Two rules keep them from being more than text:
#
#   * What is KEPT (JOB_*, SLOT, `status --json`) is validated by
#     job_env_facts: a number is digits or it is nothing, a commit is hex, the
#     URL is built only from parts that passed. Free text is kept as it came,
#     capped, and json_str escapes it on the way out.
#   * What is DRAWN — a table cell, a watch's status line — goes through
#     term_safe first, on the host that read it: a control character never
#     reaches a table, so no later hop (a `fleet` relay of this host's table)
#     has anything to neutralise.
#
# Both work on BYTES under a function-local LC_ALL=C: a range like [a-z] or a
# class like [[:cntrl:]] means what the caller's locale says it means, and a
# check that changes with LANG is not a check.

# TEXT made safe to draw, into TERM_SAFE (no subshell: a table row asks for
# several). Removed outright, not replaced — a marker would be one more thing
# a hostile value could aim at a column:
#
#   C0 controls and DEL   ESC, CR, BEL, backspace, tab… (0x01-0x1f, 0x7f)
#   C1 controls           U+0080-U+009F as UTF-8 (0xc2 0x80-0x9f): U+009B is
#                         CSI, the 8-bit spelling of ESC [
#   bidi controls         U+200E/F, U+2028-U+202E, U+2066-U+2069, U+061C: an
#                         override reorders what follows it on the line, so a
#                         branch name could make the row read as another slot's
#
# Then, if what is left is not well-formed UTF-8, every byte from 0x80 up
# becomes `?`. That is the case a raw 8-bit control (a lone 0x9b) falls in: it
# cannot be told from half a character, and a terminal not in UTF-8 mode acts
# on it. Well-formed text beyond ASCII — `ærlig`, an emoji in a workflow name
# — is kept untouched.
#
# KEEP-ESC (any second argument) leaves ESC alone and applies every other
# rule: relay_safe's last step, over a line whose only ESCs are the SGRs it
# decided to keep. One set of rules, so the two cannot drift apart.
TERM_SAFE=""
term_safe() { # TEXT [KEEP-ESC]
  local LC_ALL=C s="${1-}"
  if [ -n "${2:-}" ]; then
    s="${s//[$'\001'-$'\032'$'\034'-$'\037'$'\177']/}"
  else
    s="${s//[$'\001'-$'\037'$'\177']/}"
  fi
  s="${s//$'\xc2'[$'\x80'-$'\x9f']/}"
  s="${s//$'\xe2\x80'[$'\x8e'$'\x8f'$'\xa8'-$'\xae']/}"
  s="${s//$'\xe2\x81'[$'\xa6'-$'\xa9']/}"
  s="${s//$'\xd8\x9c'/}"
  utf8_or_ascii "$s"
  TERM_SAFE="$UTF8_TEXT"
}
# TEXT, into UTF8_TEXT: as it is when it is well-formed UTF-8, otherwise with
# every byte from 0x80 up replaced by `?`. Well-formed by shape (a lead byte
# and its continuation bytes) — an overlong form passes, which a terminal
# draws as a replacement character and a JSON reader accepts or refuses whole.
UTF8_TEXT=""
utf8_or_ascii() { # TEXT
  local LC_ALL=C s="${1-}" t
  UTF8_TEXT="$s"
  [[ "$s" == *[$'\x80'-$'\xff']* ]] || return 0
  t="${s//[$'\xf0'-$'\xf4'][$'\x80'-$'\xbf'][$'\x80'-$'\xbf'][$'\x80'-$'\xbf']/}"
  t="${t//[$'\xe0'-$'\xef'][$'\x80'-$'\xbf'][$'\x80'-$'\xbf']/}"
  t="${t//[$'\xc2'-$'\xdf'][$'\x80'-$'\xbf']/}"
  [[ "$t" != *[$'\x80'-$'\xff']* ]] || UTF8_TEXT="${s//[$'\x80'-$'\xff']/?}"
}

# --- Text another host sent (GHR-101) -----------------------------------------
# term_safe is for a value. `fleet` relays whole LINES another host drew — its
# table, what it said on stderr, the last line of an action, its journal — and
# those are painted on purpose: `fleet watch` asks every host for --color
# always, because only the host knows a cell is STALLED. So the central node
# can neither print them as they came (a host on a runnerctl older than GHR-78
# draws a job's name raw, and a login banner or a wrapper script on a host
# reaches this terminal) nor put them through term_safe, which would take the
# colours off and leave each one's `[31m` behind as text.
#
# A LINE made safe to relay, into RELAY_SAFE. One kind of sequence is kept,
# and only in the shape this script paints with:
#
#   kept     SGR: ESC [, at most 32 digits and `;`, then `m` — strip_sgr's own
#            shape, so a width measured off a relayed line is what is drawn —
#            and only when EVERY parameter is one of the attributes and
#            foreground colours a table uses (relay_sgr_ok). Not conceal (8),
#            blink, a background or a 38/48 colour: those can hide the text
#            or repaint around it, which is what keeping colours must not
#            buy. A `:` sub-parameter is not accepted at all.
#   removed  every other sequence, WHOLE, so none leaves its tail on screen: a
#            CSI to its final byte (`ESC [ 2 J`, and an SGR that failed the
#            test above), an OSC, DCS, SOS, PM or APC string to BEL or ESC \
#            (or to the next ESC, which ends one on a terminal too), any
#            other escape with its intermediate and final bytes, and the
#            8-bit C1 spellings of CSI and of the strings. A sequence with no
#            end on the line is removed to the end of the line.
#   then     term_safe's rules for everything else — the ESC of a kept SGR
#            excepted — C0, DEL, C1, bidi, malformed UTF-8 as `?`.
#
# A line that leaves an attribute on (its last kept SGR is not a reset) gets
# ESC [ 0 m appended, so it cannot paint the next row's HOST cell or the frame
# under it.
#
# PLAIN (any second argument) keeps no SGR either: the whole-sequence removal
# without the colours, for text from another host that is never painted.
#
# Cost: a line with no byte outside printable ASCII is returned as it came; one
# with no ESC and no C1 introducer is term_safe's substitutions alone. Only a
# line carrying a sequence is walked, one sequence per step, never per byte.
RELAY_SAFE=""
RELAY_SGR_RE='^\[([0-9;]{0,32})m'
RELAY_CSI_RE='^[0-?]*[ -/]*[@-~]?'
RELAY_STR_RE=$'^[^\a\e]*(\a|\e\\\\)?'
RELAY_ESC_RE='^[ -/]*[0-~]'
relay_safe() { # TEXT [PLAIN]
  local LC_ALL=C s="${1-}" out="" head c1 c n m sgr=false last=""
  if [[ "$s" != *[$'\001'-$'\037'$'\177'-$'\377']* ]]; then RELAY_SAFE="$s"; return 0; fi
  if [[ "$s" != *$'\e'* && "$s" != *$'\xc2'[$'\x90\x98\x9b\x9d\x9e\x9f']* ]]; then
    term_safe "$s"; RELAY_SAFE="$TERM_SAFE"; return 0
  fi
  while :; do
    # Up to the first ESC or C1 introducer, whichever comes first. A split,
    # not a pattern match, so no ESC can hide inside what is taken as text.
    head="${s%%$'\e'*}"
    c1="${s%%$'\xc2'[$'\x90\x98\x9b\x9d\x9e\x9f']*}"
    [ "${#c1}" -ge "${#head}" ] || head="$c1"
    [ "${#head}" -lt "${#s}" ] || break
    out+="$head" s="${s:${#head}}" n=0
    if [[ "$s" == $'\e'* ]]; then
      s="${s:1}"
      if [ -z "${2:-}" ] && [[ "$s" =~ $RELAY_SGR_RE ]]; then
        m="${BASH_REMATCH[0]}" c="${BASH_REMATCH[1]}"
        if relay_sgr_ok "$c"; then
          out+=$'\e'"$m" s="${s:${#m}}" sgr=true last="$c"
          continue
        fi
      fi
      case "$s" in
        \[*)       s="${s:1}"; [[ "$s" =~ $RELAY_CSI_RE ]]; n="${#BASH_REMATCH[0]}" ;;
        [\]PX^_]*) s="${s:1}"; [[ "$s" =~ $RELAY_STR_RE ]]; n="${#BASH_REMATCH[0]}" ;;
        *)         if [[ "$s" =~ $RELAY_ESC_RE ]]; then n="${#BASH_REMATCH[0]}"; fi ;;
      esac
    else
      c="${s:1:1}" s="${s:2}"
      if [ "$c" = $'\x9b' ]; then [[ "$s" =~ $RELAY_CSI_RE ]]; else [[ "$s" =~ $RELAY_STR_RE ]]; fi
      n="${#BASH_REMATCH[0]}"
    fi
    s="${s:n}"
  done
  term_safe "$out$s" keep-esc
  out="$TERM_SAFE"
  if $sgr && [[ ! "${last##*;}" =~ ^0*$ ]]; then out+=$'\e[0m'; fi
  RELAY_SAFE="$out"
}
# Whether every parameter of an SGR (the digits and `;` between ESC [ and m) is
# one relay_safe keeps: reset, bold, dim, italic, underline, reverse, their
# offs, and the sixteen foreground colours with the default. An empty
# parameter is 0.
relay_sgr_ok() { # PARAMS
  local p="$1;" v
  while [ -n "$p" ]; do
    v="${p%%;*}" p="${p#*;}"
    case "$v" in
      ''|0|1|2|3|4|7|22|23|24|27|3[0-7]|39|9[0-7]) ;;
      *) return 1 ;;
    esac
  done
}
# FILE rewritten in place, every line through relay_safe — where a remote's
# answer lands, before anything reads it. A last line with no newline gains
# one; nothing that reads these files can tell.
relay_file() { # FILE
  local line out=""
  [ -s "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    relay_safe "$line"
    out+="$RELAY_SAFE"$'\n'
  done <"$1"
  printf '%s' "$out" >"$1"
}
# TEXT cut to N characters for a cell, the last one `…` when something went.
clip() { # TEXT N
  if [ "${#1}" -le "$2" ]; then printf '%s\n' "$1"; else printf '%s…\n' "${1:0:$(($2 - 1))}"; fi
}

# The run a job belongs to, from proc_job_env's KEY=VALUE lines, into JOB_REPO
# (short, as it always was), JOB_ENV_NAME (GITHUB_JOB, the name the /proc-only
# reader uses) and the JOB_* run facts. The first line of a variable wins.
#
# What is kept, and what is refused (empty, so null in --json):
#
#   run id / attempt / number   0 or digits with no leading zero, 15 at most —
#                               a JSON number as written, and exact in a reader
#                               that holds numbers as doubles
#   sha                         40 or 64 lowercase hex digits (SHA-1, SHA-256)
#   event                       lowercase letters and `_`, 64 at most — what
#                               GitHub's event names are made of
#   workflow / ref / actor      free text: kept, cut to JOB_FACT_MAX bytes on
#                               a character boundary, and made well-formed
#                               (utf8_or_ascii) so the JSON stays parseable
#   url                         <server>/<owner>/<name>/actions/runs/<id>, and
#                               /attempts/<n> when the attempt passed. Only
#                               when the server is http:// or https://, a host
#                               name and an optional port and NOTHING else (no
#                               path, no user@, no space, no control byte);
#                               the repository is two `[A-Za-z0-9_.-]` names,
#                               neither `.` nor `..`; and the run id passed.
#                               A `javascript:` server is no URL at all.
#
# JOB_REPO and JOB_ENV_NAME are left exactly as they were read: the `repo` and
# `name` keys carried them before any of this existed.
JOB_FACT_MAX=200
JOB_RUN_NUM_RE='^(0|[1-9][0-9]{0,14})$'
JOB_SERVER_RE='^https?://[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(:[0-9]{1,5})?$'
JOB_REPO_RE='^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$'
job_env_facts() { # ENV-LINES
  local LC_ALL=C line k v server=""
  local -A seen=()
  JOB_REPO="" JOB_REPO_FULL="" JOB_ENV_NAME="" JOB_WORKFLOW="" JOB_RUN_ID="" JOB_RUN_ATTEMPT="" JOB_RUN_NUMBER=""
  JOB_REF="" JOB_SHA="" JOB_ACTOR="" JOB_EVENT="" JOB_URL=""
  while IFS= read -r line; do
    [[ "$line" == GITHUB_*=* ]] || continue
    k="${line%%=*}" v="${line#*=}"
    [ -z "${seen[$k]:-}" ] || continue
    seen[$k]=1
    case "$k" in
      GITHUB_REPOSITORY)  JOB_REPO_FULL="$v" JOB_REPO="${v##*/}" ;;
      GITHUB_JOB)         JOB_ENV_NAME="$v" ;;
      GITHUB_WORKFLOW)    job_fact_text "$v"; JOB_WORKFLOW="$UTF8_TEXT" ;;
      GITHUB_REF_NAME)    job_fact_text "$v"; JOB_REF="$UTF8_TEXT" ;;
      GITHUB_ACTOR)       job_fact_text "$v"; JOB_ACTOR="$UTF8_TEXT" ;;
      GITHUB_RUN_ID)      [[ ! "$v" =~ $JOB_RUN_NUM_RE ]] || JOB_RUN_ID="$v" ;;
      GITHUB_RUN_ATTEMPT) [[ ! "$v" =~ $JOB_RUN_NUM_RE ]] || JOB_RUN_ATTEMPT="$v" ;;
      GITHUB_RUN_NUMBER)  [[ ! "$v" =~ $JOB_RUN_NUM_RE ]] || JOB_RUN_NUMBER="$v" ;;
      GITHUB_SHA)         [[ ! "$v" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || JOB_SHA="$v" ;;
      GITHUB_EVENT_NAME)  [[ ! "$v" =~ ^[a-z_]{1,64}$ ]] || JOB_EVENT="$v" ;;
      GITHUB_SERVER_URL)  [[ ! "$v" =~ $JOB_SERVER_RE ]] || server="$v" ;;
    esac
  done <<<"${1-}"
  [ -n "$server" ] && [ -n "$JOB_RUN_ID" ] && [[ "$JOB_REPO_FULL" =~ $JOB_REPO_RE ]] || return 0
  case "/$JOB_REPO_FULL/" in */./*|*/../*) return 0 ;; esac
  JOB_URL="$server/$JOB_REPO_FULL/actions/runs/$JOB_RUN_ID${JOB_RUN_ATTEMPT:+/attempts/$JOB_RUN_ATTEMPT}"
}
# GHR-102: the run a job belongs to is read from a STEP process's environment,
# and there is none between two steps, during a container step or after the
# last one — so one read in three can answer nothing for a job whose run has not
# changed. `watch` (ENV_MEMO_DIR, a per-run directory like CPU_MEMO_DIR — it
# is NOT the journal memo, which is emptied every JOURNAL_CACHE_TTL ticks) keeps
# what job_env_facts KEPT, never the raw block, and hands it back while the
# same job runs. The key is the job, not the slot: the unit (the file), its
# InvocationID and JOB_SINCE, so the next job on the slot — a later start —
# inherits nothing. JOB_SINCE is derived from an age in whole seconds, so it
# can move by one between two reads of the same job: JOB_MEMO_SLACK. A read
# that found anything replaces the memo; only a read that found nothing asks
# it. Outside `watch` ENV_MEMO_DIR is empty and this does nothing, so a
# one-shot `status` is exactly what it was (it has no process that outlives it).
ENV_MEMO_DIR="" JOB_MEMO_SLACK=2
job_env_memo() { # UNIT [INVOCATION-ID]
  [ -n "$ENV_MEMO_DIR" ] && [[ "${JOB_SINCE:-}" =~ ^[0-9]+$ ]] || return 0
  local f="$ENV_MEMO_DIR/$1" inv="${2:-none}" kinv="" ksince="" d
  local -a memo=()
  if [ -n "$JOB_REPO$JOB_REPO_FULL$JOB_ENV_NAME$JOB_WORKFLOW$JOB_RUN_ID$JOB_RUN_ATTEMPT$JOB_RUN_NUMBER$JOB_REF$JOB_SHA$JOB_ACTOR$JOB_EVENT$JOB_URL" ]; then
    {
      printf '%s %s\n' "$inv" "$JOB_SINCE"
      printf '%s\n' "$JOB_REPO" "$JOB_REPO_FULL" "$JOB_ENV_NAME" "$JOB_WORKFLOW" "$JOB_RUN_ID" "$JOB_RUN_ATTEMPT" \
        "$JOB_RUN_NUMBER" "$JOB_REF" "$JOB_SHA" "$JOB_ACTOR" "$JOB_EVENT" "$JOB_URL"
    } >"$f"
    return 0
  fi
  [ -f "$f" ] || return 0
  {
    read -r kinv ksince || return 0
    mapfile -t memo
  } <"$f"
  [ "${#memo[@]}" -eq 12 ] && [ "$kinv" = "$inv" ] && [[ "$ksince" =~ ^[0-9]+$ ]] || return 0
  d=$((JOB_SINCE - ksince)); [ "$d" -ge 0 ] || d=$((-d))
  [ "$d" -le "$JOB_MEMO_SLACK" ] || return 0
  JOB_REPO="${memo[0]}" JOB_REPO_FULL="${memo[1]}" JOB_ENV_NAME="${memo[2]}" JOB_WORKFLOW="${memo[3]}" JOB_RUN_ID="${memo[4]}" JOB_RUN_ATTEMPT="${memo[5]}"
  JOB_RUN_NUMBER="${memo[6]}" JOB_REF="${memo[7]}" JOB_SHA="${memo[8]}" JOB_ACTOR="${memo[9]}" JOB_EVENT="${memo[10]}" JOB_URL="${memo[11]}"
}
# One free-text fact as it is kept, into UTF8_TEXT. Called under LC_ALL=C, so
# the cut is in bytes — and where the first byte cut away was a continuation
# byte the cut went through a character, whose head goes too.
job_fact_text() { # TEXT
  local v="$1" next
  if [ "${#v}" -gt "$JOB_FACT_MAX" ]; then
    next="${v:JOB_FACT_MAX:1}"
    v="${v:0:JOB_FACT_MAX}"
    if [[ "$next" == [$'\x80'-$'\xbf'] ]]; then
      v="${v%%+([$'\x80'-$'\xbf'])}"
      v="${v%[$'\xc0'-$'\xff']}"
    fi
  fi
  utf8_or_ascii "$v"
}
# Whether URL is a run page this script would have built itself — for a URL
# that arrived from another host's `status --json` and is about to be printed
# on this terminal (`fleet watch`'s O). The same shape job_env_facts builds.
run_url_ok() { # URL
  local LC_ALL=C
  [ "${#1}" -le 600 ] || return 1
  [[ "$1" =~ ^https?://[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(:[0-9]{1,5})?/[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}/actions/runs/[0-9]{1,15}(/attempts/[0-9]{1,15})?$ ]]
}

# GHR-100: a comm is whatever its process set it to — any 15 bytes, an escape
# sequence or a comma among them — and the comm lists exist only to be
# printed (reap's and kill's lines, the watch's P and K confirm lines, health's
# leaked line, the pane). So each comm is made safe to draw where it is
# collected, with relay_safe's whole-sequence removal (`?` when nothing is
# left), and the list is joined on COMM_SEP, a control character: no comm
# that went through relay_safe can contain one, so pid_comm_list's split
# cannot pair a pid with another process's name. The pids are not touched —
# they are what `kill` and `reap` signal.
COMM_SEP=$'\x1f' COMM_SAFE=""
comm_safe() { # COMM, into COMM_SAFE
  relay_safe "${1-}" plain
  COMM_SAFE="${RELAY_SAFE:-?}"
}
# The JOB_LEAKED_* facts from one proc_leaked walk of CGROUP, per the
# contract above. Only called on an idle slot.
job_leak_check() { # CGROUP
  local line pid comm
  JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
  cgroup_readable "$1" || return 0
  JOB_LEAKED=0
  while IFS=$'\t' read -r pid comm; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    JOB_LEAKED=$((JOB_LEAKED + 1))
    JOB_LEAKED_PIDS+="${JOB_LEAKED_PIDS:+ }$pid"
    comm_safe "$comm"
    JOB_LEAKED_COMMS+="${JOB_LEAKED_COMMS:+$COMM_SEP}$COMM_SAFE"
  done < <(proc_leaked "$1")
}
# GHR-36: the job-side processes of the cgroup, for `kill`. Same shape as
# job_leak_check — JOB_TREE is "" when the cgroup cannot be read (the caller
# then has nothing to signal itself and hands the unit to systemd) and 0 when
# it is readable and holds nothing but the Listener's own tree.
job_tree_check() { # CGROUP
  local pid comm
  JOB_TREE="" JOB_TREE_PIDS="" JOB_TREE_COMMS=""
  cgroup_readable "$1" || return 0
  JOB_TREE=0
  while IFS=$'\t' read -r pid comm; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    JOB_TREE=$((JOB_TREE + 1))
    JOB_TREE_PIDS+="${JOB_TREE_PIDS:+ }$pid"
    comm_safe "$comm"
    JOB_TREE_COMMS+="${JOB_TREE_COMMS:+$COMM_SEP}$COMM_SAFE"
  done < <(proc_job_tree "$1")
}
# JOB_STALLED from the running job's age (seconds), per the contract above.
job_stall_check() { # AGE-SECONDS
  JOB_STALLED=""
  [[ "${1:-}" =~ ^[0-9]+$ ]] && [ "$STALL_SEC" -gt 0 ] || return 0
  if [ "$1" -ge "$STALL_SEC" ]; then JOB_STALLED=true; else JOB_STALLED=false; fi
}
job_facts() { # UNIT CGROUP [INVOCATION-ID] [ACTIVE-ENTER-US]
  local u="$1" cg="$2" lines rj ii ts env worker age=""
  JOB_STATE=none JOB_NAME="" JOB_REPO="" JOB_SINCE="" JOB_RUNTIME="" JOB_STALLED="" JOB_IDLE_SINCE="" JOB_DONE="" JOB_ACCESS=ok
  JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
  job_env_facts ""
  # The cgroup this picture was read from, for a caller that then has to act
  # on the processes in it (`kill`, GHR-36).
  JOB_CGROUP="$cg"
  [ -n "$cg" ] || return 0
  if lines="$(journal_job_lines_cached "$u" "${3:-}")"; then
    rj="$(journal_running_job "$lines")"
    if [ -z "$rj" ]; then
      ii="$(journal_idle_info "$lines")"
      if [ -n "$ii" ]; then
        JOB_STATE=idle
        ts="${ii%%$'\t'*}"; JOB_DONE="${ii#*$'\t'}"
        [[ "$ts" =~ ^[0-9]+$ ]] && JOB_IDLE_SINCE="$ts"
      else
        JOB_STATE="idle-fresh" JOB_DONE=0
        JOB_IDLE_SINCE="$(age_to_epoch "$(state_age active "${4:-}" "")")"
      fi
      job_leak_check "$cg"
      return 0
    fi
    JOB_STATE=running
    JOB_NAME="${rj%%$'\t'*}"; ts="${rj#*$'\t'}"
    # The journal names the job; the environment says whose it is and which
    # run (GHR-78) — nothing where no step process is up to read it from.
    job_env_facts "$(proc_job_env "$cg")"
    worker="$(proc_worker_pid "$cg")"
    if [ -n "$worker" ]; then
      age="$(proc_age "$worker")"
      if [ -n "$age" ]; then JOB_RUNTIME="$(fmt_dur "$age")"; JOB_SINCE="$(age_to_epoch "$age")"; fi
    elif [[ "$ts" =~ ^[0-9]+$ ]]; then
      age=$(( $(now_epoch) - ts ))
      JOB_SINCE="$ts"; JOB_RUNTIME="$(fmt_dur "$age")"
    fi
    job_stall_check "$age"
    job_env_memo "$u" "${3:-}"
    return 0
  fi
  cgroup_readable "$cg" || { JOB_STATE="no-access" JOB_ACCESS="no-access"; return 0; }
  JOB_ACCESS=no-journal
  worker="$(proc_worker_pid "$cg")"
  if [ -n "$worker" ]; then
    age="$(proc_age "$worker")"
    if [ -n "$age" ]; then JOB_RUNTIME="$(fmt_dur "$age")"; JOB_SINCE="$(age_to_epoch "$age")"; fi
  fi
  env="$(proc_job_env "$cg")"
  if [ -n "$env" ]; then
    JOB_STATE=running
    job_env_facts "$env"
    JOB_NAME="$JOB_ENV_NAME"
    job_stall_check "$age"
  elif [ -n "$worker" ]; then
    JOB_STATE=starting
  else
    JOB_STATE="idle-unknown"
    job_leak_check "$cg"
  fi
}

# The WORKING-ON cell from the JOB_* facts job_facts left behind.
#
# GHR-78: a running job is `repo:job (12m)`, as it always was — and, where
# ROOM says the terminal has the columns for it, `repo:workflow / job @ref
# (12m)`: the workflow and the branch are what tell two `build` jobs of one
# repository apart. ROOM is the width the cell may take, 0 (the default, and
# what every caller but the table passes) for the short form only; the long
# form is used when it fits in ROOM and there is a workflow or a ref to add,
# so a job with neither reads exactly as before at any width. Each of the two
# is cut to JOB_CELL_PART characters: one long branch name must not be what
# decides whether the row fits.
#
# Everything a job supplied is drawn through term_safe — the repository and
# the job's name too, which reached this cell raw before. Since GHR-100 that is
# relay_safe's PLAIN form, which applies term_safe's rules after removing an
# escape sequence WHOLE: term_safe alone leaves `ESC [ 2 J`'s `[2J` behind as
# text, and a sequence's tail is not the value's text. The same for every
# line that quotes this cell (the --if-stalled and --when-idle lines, reap's
# busy line, the watch's confirm lines and notices).
JOB_CELL_PART=40
job_cell() { # [ROOM]
  local repo name wf ref rest long
  case "$JOB_STATE" in
    none)         echo "—" ;;
    running)
      relay_safe "$JOB_REPO" plain; repo="$RELAY_SAFE"
      relay_safe "$JOB_NAME" plain; name="${RELAY_SAFE:-?}"
      rest="${JOB_RUNTIME:+ ($JOB_RUNTIME)}"
      [ "$JOB_STALLED" != true ] || rest+=" STALLED"
      if [ "${1:-0}" -gt 0 ] && [ -n "$JOB_WORKFLOW$JOB_REF" ]; then
        relay_safe "$JOB_WORKFLOW" plain; wf="$(clip "$RELAY_SAFE" "$JOB_CELL_PART")"
        relay_safe "$JOB_REF" plain; ref="$(clip "$RELAY_SAFE" "$JOB_CELL_PART")"
        long="${repo:+$repo:}${wf:+$wf / }$name${ref:+ @$ref}$rest"
        if [ "${#long}" -le "$1" ]; then printf '%s\n' "$long"; return 0; fi
      fi
      printf '%s%s%s\n' "${repo:+$repo:}" "$name" "$rest" ;;
    idle)         printf 'idle %s (%s job%s)%s\n' "$(fmt_dur "$([ -z "$JOB_IDLE_SINCE" ] || echo $(( $(now_epoch) - JOB_IDLE_SINCE )))")" \
                    "$JOB_DONE" "$([ "$JOB_DONE" -eq 1 ] || echo s)" "$(leaked_suffix)" ;;
    idle-fresh)   echo "idle $(fmt_dur "$([ -z "$JOB_IDLE_SINCE" ] || echo $(( $(now_epoch) - JOB_IDLE_SINCE )))") (no jobs yet)$(leaked_suffix)" ;;
    starting)     echo "(starting)" ;;
    idle-unknown) echo "idle ?$(leaked_suffix)" ;;
    no-access)    echo "(no access)" ;;
  esac
}

# ` +N leaked` for an idle cell when a finished job left processes behind
# (GHR-29); nothing when there are none or it cannot be known.
leaked_suffix() {
  [[ "$JOB_LEAKED" =~ ^[0-9]+$ ]] && [ "$JOB_LEAKED" -gt 0 ] || return 0
  echo " +$JOB_LEAKED leaked"
}

# Facts and cell in one call, for a caller that only wants the text.
job_info() { # UNIT CGROUP [INVOCATION-ID] [ACTIVE-ENTER-US]
  job_facts "$@"
  job_cell
}

# --- Waiting for a slot to go idle (GHR-11) -----------------------------------
# Unit name -> what `status` prints as RUNNER.
short_name() { local s="${1#actions.runner.}"; echo "${s%.service}"; }

# `sleep`, behind a function so a test config can shadow it (the stub logs
# the call and does not sleep).
pause() { sleep "$1"; }

# Is UNIT safe to restart/stop right now? One unit_props fetch, then the same
# job_info cell `status` shows, left in SLOT_JOB for the caller's message.
#   —, idle …      0 (not running, or running with no job in flight)
#   (no access)    1 — cannot be proven idle; wait_idle refuses at once rather
#                  than polling a condition that cannot change
#   anything else  1 (a job, or (starting))
SLOT_JOB=""
# One unit_props fetch, then job_facts on it: the JOB_* picture of UNIT for
# a command that acts on one slot at a time (--when-idle, --if-stalled,
# reap) rather than through collect_slot.
SLOT_ACTIVE="" SLOT_SUB=""
slot_job_facts() { # UNIT
  local cg="" inv="" ae="" k v
  SLOT_ACTIVE="" SLOT_SUB=""
  while IFS='=' read -r k v; do
    case "$k" in
      ControlGroup) cg="$v" ;;
      InvocationID) inv="$v" ;;
      ActiveEnterTimestampMonotonic) ae="$v" ;;
      # GHR-36: `kill` needs to tell a running slot from one already wedged
      # in its own stop (deactivating/stop-sigterm), where the job is gone
      # from systemd's point of view but nothing has actually died.
      ActiveState) SLOT_ACTIVE="$v" ;;
      SubState) SLOT_SUB="$v" ;;
    esac
  done < <(unit_props "$1")
  job_facts "$1" "$cg" "$inv" "$ae"
}
slot_is_idle() { # UNIT
  slot_job_facts "$1"
  SLOT_JOB="$(job_cell)"
  case "$SLOT_JOB" in
    —|idle|idle\ *) return 0 ;;
    *)              return 1 ;;
  esac
}

# The job cell as prose: `my-app:test (12m)` -> `my-app:test, 12m`.
job_desc() {
  case "$1" in
    *\ \(*\)) local d="${1% (*}, ${1##* (}"; echo "${d%)}" ;;
    *)        echo "$1" ;;
  esac
}

# Poll slot_is_idle every POLL_SEC until UNIT is idle. Prints a `waiting for`
# line the first time it has to wait and every ~60 s after that. Elapsed time
# is counted as polls × POLL_SEC — the time it *would* have slept — not read
# from a clock, so a stubbed pause still reaches the timeout deterministically.
#   0  idle (possibly immediately)
#   1  still busy after TIMEOUT seconds
#   2  (no access): refused without waiting
#
# GHR-149: under --heartbeat=N the line comes at least every min(60, N) s
# (EVERY), and no pause is longer than that — a poll interval above it is cut
# down to it (STEP) — so the line is due before any pause that would leave
# more than EVERY since the last one. Without the flag, the cadence is the
# 60 s it always was.
wait_idle() { # UNIT TIMEOUT
  local u="$1" timeout="$2" waited=0 last_said=-60 short step="$POLL_SEC" every=60
  # A zero or junk interval would never advance the clock: refuse it.
  [[ "$POLL_SEC" =~ ^[1-9][0-9]*$ ]] || die "POLL_SEC must be a positive integer (config sets '$POLL_SEC')"
  if [ -n "$HEARTBEAT" ]; then
    [ "$HEARTBEAT" -ge "$every" ] || every="$HEARTBEAT"
    [ "$step" -le "$every" ] || step="$every"
  fi
  short="$(short_name "$u")"
  while ! slot_is_idle "$u"; do
    [ "$SLOT_JOB" != "(no access)" ] || return 2
    [ "$waited" -lt "$timeout" ] || return 1
    if { [ -z "$HEARTBEAT" ] && [ $((waited - last_said)) -ge 60 ]; } \
       || { [ -n "$HEARTBEAT" ] && [ $((waited + step - last_said)) -gt "$every" ]; }; then
      echo "waiting for $short ($(job_desc "$SLOT_JOB")) …"
      last_said=$waited
    fi
    pause "$step"
    waited=$((waited + step))
  done
}

# --- A heartbeat for the central node (GHR-149) ---------------------------------
# `--heartbeat=N`, a global flag read beside --origin: every phase of a command
# that can block prints a line at most N seconds apart, so the central node
# can tell a host that is working from one that has gone silent (GHR-150 cuts
# a call off on that silence instead of on a total budget). An older host
# refuses the flag the way main refuses any unknown word — `unknown command
# '--heartbeat…'`, exit 1, nothing done — which is what the central node's
# optional-word mechanism (fleet_optional_rejects) reads. Without the flag
# nothing changes: no ticker, no extra line, wait_idle's cadence is its own.
#
# Two shapes:
#   * a poll loop says so itself between polls — wait_idle (and so `drain` and
#     every --when-idle) at min(60, N), kill's wait after its SIGKILL at N —
#     pausing no longer than that, so the lines are as deterministic as the
#     polls;
#   * one call that blocks — every privileged systemctl that starts, stops or
#     reloads (a stop sits out TimeoutStopSec saying nothing) and upgrade's
#     download — runs with a TICKER beside it: a background child of this
#     process printing `heartbeat: LABEL (Ns)` every N s until hb_stop.
# A ticker never outlives its phase and never decides anything:
#   * hb_stop kills it with SIGKILL — which nothing can ignore or defer, not
#     even under an inherited signal mask — and reaps it before the call's
#     status is looked at; the status is the call's;
#   * exit_run and audit_signal stop it first, so no way out leaves it running
#     — in particular, the relays a guarded command waits for on its way out
#     (GHR-91) are not held open by it, and a record (GHR-88/119/131) is
#     written with the command's own outcome;
#   * it checks every second that the process that started it is still there,
#     for the one way out no trap sees (a SIGKILL of that process);
#   * it writes to this process's stdout — the relay's pipe under caller_guard,
#     so a reader that has gone costs it nothing, and it ignores SIGINT and
#     SIGQUIT, explicitly (GHR-162: bash 5.2 would hand it the record's trap):
#     an operator's Ctrl-C ends the command, and the command's way out ends
#     the ticker.
# Between two phases there is no ticker, so a silence that spans a boundary
# can be up to one phase's cadence plus the next one's N.
HEARTBEAT="" HB_PID="" HB_OWNER=""
# The global flag's value: whole seconds, 1..3600.
heartbeat_valid() { [[ "${1-}" =~ ^[1-9][0-9]{0,3}$ ]] && [ "$1" -le 3600 ]; }
# Until the clock reaches EPOCH; 1 at once if PARENT has gone. A hook, so the
# sim can model the wait on its stub clock (tests/stub.config).
hb_wait() { # EPOCH PARENT
  while [ "$(now_epoch)" -lt "$1" ]; do
    kill -0 "$2" 2>/dev/null || return 1
    sleep 1 >/dev/null 2>&1
  done
}
# The ticker itself (in the background): one line every HEARTBEAT seconds,
# saying how long the phase has been running.
hb_ticker() { # LABEL PARENT
  local t0 now next
  # GHR-162: a worker — hb_stop (or its dead parent) ends it, never a Ctrl-C.
  builtin trap '' INT QUIT
  t0="$(now_epoch)"; next=$((t0 + HEARTBEAT))
  while hb_wait "$next" "$2"; do
    now="$(now_epoch)"
    printf 'heartbeat: %s (%ss)\n' "$1" "$((now - t0))"
    next=$((now + HEARTBEAT))
  done
}
# Start a ticker for LABEL (under --heartbeat only), replacing any of this
# process's own.
hb_start() { # LABEL
  [ -n "$HEARTBEAT" ] || return 0
  hb_stop
  # Its stderr is /dev/null: the SIGKILL can land while it is inside a
  # "$(…)", and the orphaned child then writes into a pipe nobody reads.
  # Where SIGPIPE is ignored (an agent harness, a CI runner, some service
  # managers) that write fails with a `write error: Broken pipe` on the
  # stderr it inherited — the command's own, through its relay. The ticker
  # has nothing to say on stderr, so nothing it leaves behind can either.
  hb_ticker "$1" "$BASHPID" 2>/dev/null &
  HB_PID=$! HB_OWNER="$BASHPID"
}
# Stop this process's ticker, if it has one, and reap it.
hb_stop() {
  [ -n "$HB_PID" ] && [ "$HB_OWNER" = "$BASHPID" ] || return 0
  kill -KILL "$HB_PID" 2>/dev/null || true
  wait "$HB_PID" 2>/dev/null || true
  HB_PID=""
}
# `run_priv systemctl ARGS…`, with a ticker under --heartbeat. Its status is
# systemctl's; without the flag it is exactly that one call.
hb_systemctl() { # ARGS...
  [ -n "$HEARTBEAT" ] || { run_priv systemctl "$@"; return; }
  local rc=0
  hb_start "systemctl $*"
  run_priv systemctl "$@" || rc=$?
  hb_stop
  return "$rc"
}

# wait_idle failed for UNIT with RC: say why, what was already done (HANDLED,
# space-separated units — those stay done) and what was not touched
# (REMAINING), then exit 1. Nothing is ever force-killed.
wait_failed() { # RC UNIT VERB HANDLED REMAINING
  local rc="$1" u="$2" verb="$3" handled="$4" remaining="$5" short r busy idle=""
  short="$(short_name "$u")"
  case "$rc" in
    2) echo "runnerctl: cannot tell whether $short is idle — --when-idle needs journal read access (systemd-journal group) or root" >&2 ;;
    *) echo "runnerctl: timed out after ${WAIT_TIMEOUT}s waiting for $short ($(job_desc "$SLOT_JOB"))" >&2 ;;
  esac
  busy="$short"
  for r in $remaining; do
    if slot_is_idle "$r"; then idle+="${idle:+, }$(short_name "$r")"; else busy+=", $(short_name "$r")"; fi
  done
  echo "  already ${verb}: $(join_short "$handled")" >&2
  echo "  busy or unreadable, not ${verb}: $busy" >&2
  [ -z "$idle" ] || echo "  idle but not ${verb} (queued after the busy one): $idle" >&2
  exit 1
}

# The per-slot gate every --when-idle command calls before its systemctl:
# a no-op unless --when-idle was given, otherwise wait_idle, and on failure
# wait_failed (which exits 1). HANDLED and REMAINING are space-separated.
idle_gate() { # UNIT VERB HANDLED REMAINING
  $when_idle || return 0
  local rc=0; wait_idle "$1" "$WAIT_TIMEOUT" || rc=$?
  [ "$rc" -eq 0 ] || wait_failed "$rc" "$@"
}

# GHR-30: the per-slot gate of --if-stalled. Reads the same job_facts the
# table reads and answers whether UNIT's job is STALLED right now:
#   0  stalled — a line says what is about to be VERB-ed ("restarting")
#   1  not stalled (idle, busy but young, or not running) — a skip line
# A (no access) slot dies, as --when-idle does: the question cannot be
# answered, and acting on a guess would kill a healthy job.
stalled_gate() { # UNIT VERB-ING
  local short repo name
  short="$(short_name "$1")"
  slot_job_facts "$1"
  case "$JOB_STATE" in
    no-access) die "$short: cannot tell whether its job is stalled — --if-stalled needs journal read access (systemd-journal group) or root" ;;
    none)      echo "$short: not running — skipped"; return 1 ;;
  esac
  if [ "$JOB_STALLED" = true ]; then
    # GHR-100: the repository and the job's name are a job's text, drawn
    # through relay_safe as job_cell draws them.
    relay_safe "$JOB_REPO" plain; repo="$RELAY_SAFE"
    relay_safe "$JOB_NAME" plain; name="$RELAY_SAFE"
    echo "$short: stalled — $(job_desc "${repo:+$repo:}${name:-?}${JOB_RUNTIME:+ ($JOB_RUNTIME)}"), longer than $(fmt_dur "$STALL_SEC") — $2"
    return 0
  fi
  echo "$short: not stalled ($(job_cell)) — skipped"
  return 1
}

# Space-separated units -> "short-1, short-2" (or "none").
join_short() {
  local u out=""
  for u in $1; do out+="${out:+, }$(short_name "$u")"; done
  echo "${out:-none}"
}

# --- Numbers from another host (GHR-104) --------------------------------------
# VALUE as a whole number shell arithmetic can take, into NUM_INT — empty for
# anything else. Not just "digits": `08` is an octal error to $((…)) and ((…))
# (which ends a script under set -e), and a digit string past 18 places wraps
# silently there and makes `[ … -gt … ]` print an error into a frame. 0 is a
# number; a sign, a fraction, an exponent and an over-long string are not, and
# the last is unknown rather than truncated. Every number a remote host wrote
# is read through this before it reaches arithmetic or a numeric test.
NUM_INT=""
num_int() { # VALUE
  NUM_INT=""
  [[ ! "${1-}" =~ ^(0|[1-9][0-9]{0,17})$ ]] || NUM_INT="$1"
}

# --- Durations ----------------------------------------------------------------
# Seconds -> 12s / 41m / 3h12m / 3d 4h (a zero remainder is dropped: 6d, 2h).
# Anything that is not a non-negative integer (empty, "n/a", a negative from
# a clock that went backwards) -> —.
fmt_dur() {
  local s="${1:-}" r
  [[ "$s" =~ ^[0-9]+$ ]] || { echo "—"; return; }
  if [ "$s" -ge 86400 ]; then
    r=$(((s % 86400) / 3600))
    if [ "$r" -gt 0 ]; then echo "$((s / 86400))d ${r}h"; else echo "$((s / 86400))d"; fi
  elif [ "$s" -ge 3600 ]; then
    r=$(((s % 3600) / 60))
    if [ "$r" -gt 0 ]; then echo "$((s / 3600))h${r}m"; else echo "$((s / 3600))h"; fi
  elif [ "$s" -ge 60 ]; then
    echo "$((s / 60))m"
  else
    echo "${s}s"
  fi
}

# Microseconds since boot, from /proc/uptime — the same clock as systemd's
# *TimestampMonotonic properties, so no date/locale/TZ parsing is needed.
# Integer arithmetic only; a config can shadow this to make `status`
# deterministic under test.
now_mono() {
  local up frac
  read -r up _ </proc/uptime
  frac="${up#*.}"; [ "$frac" != "$up" ] || frac=0
  frac="${frac}000000"; frac="${frac:0:6}"   # pad/truncate to microseconds
  echo $(( ${up%%.*} * 1000000 + 10#$frac ))
}

# How long a unit has been in its ActiveState, in whole seconds: since the
# active-enter stamp while active/activating/reloading, otherwise since the
# inactive-enter stamp (StateChangeTimestamp also moves on sub-state changes,
# so it is not used). Stamps are µs since boot; 0 or empty means the state
# was never entered, and then nothing is printed. The raw figure both
# renderers derive from (GHR-16): the table formats it, the JSON turns it
# into an epoch second.
state_age() { # ACTIVE-STATE ACTIVE-ENTER-US INACTIVE-ENTER-US
  local ts
  case "$1" in
    active|activating|reloading) ts="$2" ;;
    *)                           ts="$3" ;;
  esac
  if [[ "$ts" =~ ^[0-9]+$ ]] && [ "$ts" -gt 0 ]; then
    echo $(( ($(now_mono) - ts) / 1000000 ))
  fi
}

# The SINCE cell: state_age as a duration, — when the state was never entered.
since_state() { # ACTIVE-STATE ACTIVE-ENTER-US INACTIVE-ENTER-US
  local age
  age="$(state_age "$@")"
  if [ -n "$age" ]; then fmt_dur "$age"; else echo "—"; fi
}

# Epoch second an event happened at, from how many seconds ago it was — the
# JSON side of every SINCE-like cell (GHR-16). Nothing for an empty or
# negative age (a clock that went backwards), which is where the table
# prints —.
age_to_epoch() { # AGE-SECONDS
  [[ "${1:-}" =~ ^[0-9]+$ ]] || return 0
  echo $(( $(now_epoch) - $1 ))
}

# When PID started, in µs since boot: field 22 of /proc/PID/stat, in clock
# ticks. (Not `stat -c %Y /proc/PID`: procfs stamps that directory when it is
# first looked up, not when the process forked, so it reads as "now" for a
# process nobody has inspected yet.) The comm field can contain spaces, so
# split after its closing paren. Prints nothing if PID is gone.
proc_start_mono() {
  local st tck
  st="$(cat "/proc/$1/stat" 2>/dev/null)" || return 0
  read -ra st <<<"${st##*) }"          # fields 3.., so start time is index 19
  [ "${#st[@]}" -gt 19 ] || return 0
  tck="$(getconf CLK_TCK 2>/dev/null)" || tck=100
  echo $(( st[19] * 1000000 / tck ))
}

# How many seconds PID has been alive; empty if PID cannot be read.
proc_age() {
  local start
  start="$(proc_start_mono "$1")"
  [ -n "$start" ] || return 0
  echo $(( ($(now_mono) - start) / 1000000 ))
}

hbytes() {
  local v="${1:-}"
  case "$v" in
    ''|infinity|max|18446744073709551615|'[not set]') echo "—"; return ;;
  esac
  [[ "$v" =~ ^[0-9]+$ ]] || { echo "$v"; return; }
  awk -v b="$v" 'BEGIN{ if (b<1048576) printf "%.0fM", b/1048576; else printf "%.1fG", b/1073741824 }'
}

# GHR-8: the ACTIVE cell — "<ActiveState>/<SubState>", plus a restart count
# (↻N) when NRestarts > 0 (systemd resets it on `systemctl start/restart`, so
# this is restarts since then, e.g. a crash loop the OOM killer or the start
# limiter has been resurrecting under `StartLimitIntervalSec=0`). When there
# have been restarts and the CURRENT invocation's Result is success, the
# journal may know why the LAST one happened — appended as "(last: ...)".
# RESULT itself is appended, unparenthesised, whenever it is not success:
# that is the current invocation's own reason and takes precedence over a
# journal guess. Not padded/truncated to the column width — like WORKING-ON,
# a long cell just overflows that row's alignment. Pure: the reason is looked
# up once by collect_slot (GHR-16), which is also where the JSON reads it.
status_active_cell() { # ACTIVE-STATE SUB-STATE NRESTARTS RESULT LAST-RESTART-REASON
  local cell="$1/$2" n="${3:-0}" result="${4:-success}" reason="${5:-}"
  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ]; then
    cell+=" ↻$n"
    [ -n "$reason" ] && cell+=" (last: $reason)"
  fi
  [ "$result" = success ] || cell+=" $result"
  printf '%s\n' "$cell"
}

# GHR-8: the USED cell — current memory, plus "/peak" when MemoryPeak is
# present and numeric (systemd >= 254; older systemd, or a unit whose
# MemoryAccounting is off, answers "[not set]" — fall back silently to
# current-only, same as an absent property).
status_used_cell() { # CURRENT PEAK
  local cur="$1" peak="${2:-}"
  if [[ "$peak" =~ ^[0-9]+$ ]]; then
    printf '%s/%s\n' "$(hbytes "$cur")" "$(hbytes "$peak")"
  else
    hbytes "$cur"
  fi
}

resolve() { # "unit, slot-index, or short RUNNER name" -> unit name
  local a="$1"
  mapfile -t units < <(discover)
  if [[ "$a" =~ ^[0-9]+$ ]]; then
    [ "$a" -lt "${#units[@]}" ] || die "slot index $a out of range (0..$((${#units[@]}-1)))"
    echo "${units[$a]}"
    return
  fi
  local u
  # 1. the literal unit name.
  for u in "${units[@]}"; do [ "$u" = "$a" ] && { echo "$u"; return; }; done
  # 2. actions.runner.<arg>.service
  for u in "${units[@]}"; do [ "$u" = "actions.runner.${a}.service" ] && { echo "$u"; return; }; done
  # 3. <arg>.service
  for u in "${units[@]}"; do [ "$u" = "${a}.service" ] && { echo "$u"; return; }; done
  # 4. an unambiguous prefix or substring match on the short name (what
  # `status` prints as RUNNER: the unit with "actions.runner." and ".service"
  # stripped) — either direction, so "slot-1" matches "example.slot-1" and
  # "example.slot-1.service" (typed with the suffix back on) also does.
  local short shorts=() matches=()
  for u in "${units[@]}"; do
    short="${u#actions.runner.}"; short="${short%.service}"
    shorts+=("$short")
    [[ "$short" == *"$a"* || "$a" == *"$short"* ]] && matches+=("$short")
  done
  case "${#matches[@]}" in
    1)
      for u in "${units[@]}"; do
        short="${u#actions.runner.}"; short="${short%.service}"
        [ "$short" = "${matches[0]}" ] && { echo "$u"; return; }
      done
      ;;
    0) die "no runner slot matches '$a' (have: 0..$((${#units[@]}-1)), ${shorts[*]})" ;;
    *) die "ambiguous target '$a' matches: ${matches[*]}" ;;
  esac
}

# --- Drop-in rendering --------------------------------------------------------
render_dropin() {
  echo "# Managed by runnerctl (profile: $PROFILE) — DO NOT EDIT BY HAND."
  [ -n "$PROFILE_DESC" ] && echo "# $PROFILE_DESC"
  echo "# Re-apply with: runnerctl apply --profile $PROFILE"
  echo "[Unit]"
  echo "# Don't let a crash-loop trip the start limiter and park the unit 'failed'."
  echo "StartLimitIntervalSec=0"
  echo
  echo "[Service]"
  echo "Restart=always"
  echo "RestartSec=${RESTART_SEC}"
  echo "# OOMPolicy: systemd's default (stop) takes the WHOLE unit down when the"
  echo "# kernel OOM-kills any one process of it — the job dies as 'runner lost"
  echo "# communication' and the runner restarts. With continue only the killed"
  echo "# step is gone: it exits 137, the job fails with its log, the Listener"
  echo "# stays up (GHR-28)."
  echo "OOMPolicy=continue"
  if [ -n "$ENV_FILE" ]; then
    echo "# On-device secrets/config (root-owned, chmod 600). Never in GitHub."
    echo "EnvironmentFile=${ENV_FILE}"
  fi
  if [ -n "$MEM_MAX" ]; then
    echo "# MemoryHigh: soft reclaim/throttle before the hard cap."
    echo "# MemoryMax:  hard — contains a runaway to its cgroup; the OOM killer takes"
    echo "#             the offending step, OOMPolicy above keeps the runner."
    echo "# MemorySwapMax=0: the cap bounds RAM only; without this a capped job"
    echo "#             swaps out to stay under it and thrashes instead of failing."
    [ -n "$MEM_HIGH" ] && echo "MemoryHigh=${MEM_HIGH}"
    echo "MemoryMax=${MEM_MAX}"
    echo "MemorySwapMax=0"
  fi
}

apply_to() {
  local u="$1" dir="$SYSTEMD_DIR/$1.d"
  # An explicit mode on both: slot_profile reads this file without privilege,
  # and root's umask (077 on a hardened host) would leave a new directory 0700
  # and the file 0600 (GHR-142). -m reaches only the last component.
  run_priv mkdir -p -m 755 "$dir"
  render_dropin | run_priv tee "$dir/$DROPIN_NAME" >/dev/null
  run_priv chmod 644 "$dir/$DROPIN_NAME"
}

# A profile with an EnvironmentFile hard-fails to start without it, so refuse
# to apply until it exists (run env-init first).
guard_env_file() {
  [ -n "$ENV_FILE" ] || return 0
  run_priv test -f "$ENV_FILE" || die "EnvironmentFile $ENV_FILE missing — run: runnerctl env-init --profile $PROFILE"
}

# --- Saving a profile back to the config (GHR-58) -----------------------------
# `apply --save` and `scale N --save` write the profile AS APPLIED — the profile
# function's values with the CLI flags layered on top — back into $CONFIG_FILE.
# Without it a `--high infinity` is durable in the drop-in and NOT durable as
# policy: the next `apply --profile ci` re-renders MEM_HIGH from the profile
# function and the override is silently gone. The alternative is hand-editing
# the config on every host, which is the step that gets skipped.
#
# The config is bash and is SOURCED, so this rewrites a BLOCK rather than
# parsing the language. Three outcomes, and the third is the point:
#   * the file defines profile_<name> in the canonical form  -> replace it;
#   * the file defines it nowhere                            -> append it;
#   * anything else (a one-line body, `function profile_x {`, two definitions
#     of one name, no closing `}` in column 1)               -> REFUSE, naming
#     the line, leaving the config untouched.
# Appending past a definition it could not parse would "work" — the last
# definition sourced wins — and leave a config whose profile is defined twice
# for somebody to find weeks later. A refusal is the honest outcome.
render_profile_block() { # COMMAND
  echo "profile_${PROFILE}() {"
  echo "  # Saved by \`runnerctl $1 --save\` on $(date +%F). Hand-edits are expected;"
  echo "  # the next --save rewrites this block and leaves the rest of the file."
  echo "  PROFILE_DESC=$(sq "$PROFILE_DESC")"
  echo "  MEM_MAX=$(sq "$MEM_MAX")"
  echo "  MEM_HIGH=$(sq "$MEM_HIGH")"
  echo "  RESTART_SEC=$(sq "$RESTART_SEC")"
  echo "  ENV_FILE=$(sq "$ENV_FILE")"
  # Only when the profile carries one: emitting an empty ENV_TEMPLATE in every
  # saved block would be noise, and dropping a set one would be data loss that
  # the verify below cannot see — render_dropin never reads ENV_TEMPLATE, so a
  # lost one renders an identical drop-in and env-init breaks later instead.
  [ -z "$ENV_TEMPLATE" ] || echo "  ENV_TEMPLATE=$(sq "$ENV_TEMPLATE")"
  echo "}"
}

# How --save writes FILE (GHR-135): write_as on its directory, naming the file
# and its .bak. apply and scale ask before their first drop-in, so a refusal
# leaves the host as it was; save_profile asks again when it writes.
save_write_as() { # FILE
  write_as "$(dirname "$1")" "save $1" "$1" "$1.bak"
}

# One line when a config was written as WRITE_USER (GHR-139): the file is that
# user's, and a later run as root refuses to source a config owned by neither
# root nor the invoking user (config_trust_problem), so say so at write time.
config_owner_notice() { # FILE USER
  [ -n "$2" ] || return 0
  echo "note: $1 now belongs to $2, and a run as root (sudo) will refuse to source it — run runnerctl against it without sudo as $2, or keep the config in a root-owned directory such as /etc/runnerctl/ (chown root:root $1; chmod 644 $1)."
}

save_profile() { # COMMAND
  local cmd="$1" f="$CONFIG_FILE" tmpd blk cand head_line start end existed=false
  tmpd="$(mktemp -d)"; blk="$tmpd/block"; cand="$tmpd/config"
  render_profile_block "$cmd" >"$blk"

  if [ ! -e "$f" ]; then
    {
      echo "# runnerctl config — created by \`runnerctl $cmd --save\` on $(date +%F)."
      echo "# Sourced as bash: keep it root-owned and not world-writable."
      echo "# \`runnerctl config-example\` documents every knob."
      echo
      cat "$blk"
    } >"$cand"
  else
    existed=true
    [ -f "$f" ] || { rm -rf "$tmpd"; die "--save: $f is not a regular file — refusing to write it"; }
    [ -r "$f" ] || { rm -rf "$tmpd"; die "--save: $f is not readable by $(id -un) — run as root to save into it"; }
    local hits=()
    # Any definition-ish mention, not only the rewritable form: finding one it
    # cannot rewrite must refuse rather than fall through to the append path.
    mapfile -t hits < <(grep -nE "^[[:space:]]*(function[[:space:]]+)?profile_${PROFILE}([[:space:]]|\(|\{|$)" "$f" || true)
    if [ "${#hits[@]}" -eq 0 ]; then
      { cat "$f"; echo; cat "$blk"; } >"$cand"
    elif [ "${#hits[@]}" -gt 1 ]; then
      local lines="" h
      for h in "${hits[@]}"; do lines+="${lines:+, }${h%%:*}"; done
      rm -rf "$tmpd"
      die "--save: $f defines profile_$PROFILE more than once (lines $lines) — the last one sourced wins, which is ambiguous enough that this will not guess. Delete the duplicates and re-run."
    else
      start="${hits[0]%%:*}"; head_line="${hits[0]#*:}"
      grep -qE "^profile_${PROFILE}[[:space:]]*\(\)[[:space:]]*\{[[:space:]]*$" <<<"$head_line" || {
        rm -rf "$tmpd"
        die "--save: $f line $start defines profile_$PROFILE in a form this cannot rewrite ('$head_line') — want 'profile_$PROFILE() {' alone on its line, closed by '}' in column 1. Reformat it, or edit the values by hand."
      }
      end="$(awk -v s="$start" 'NR > s && /^\}[[:space:]]*$/ { print NR; exit }' "$f")"
      [ -n "$end" ] || { rm -rf "$tmpd"; die "--save: profile_$PROFILE starts at $f line $start and has no closing '}' in column 1 — refusing to guess where it ends."; }
      # The rewrite REPLACES the block, so anything in it that is not one of
      # the profile knobs would be flattened away — a computed MEM_MAX, a
      # conditional, a variable this does not know about. A saved profile that
      # silently lost the logic that produced its values is worse than no
      # --save at all, and the verify below cannot catch it: it compares the
      # rendered drop-in, which is the same either way.
      local stray
      stray="$(awk -v s="$start" -v e="$end" '
        NR > s && NR < e && $0 !~ /^[[:space:]]*(#|$)/ &&
        $0 !~ /^[[:space:]]*(PROFILE_DESC|MEM_MAX|MEM_HIGH|RESTART_SEC|ENV_FILE|ENV_TEMPLATE)=/ { print NR ": " $0; exit }
      ' "$f")"
      if [ -n "$stray" ]; then
        rm -rf "$tmpd"
        die "--save: profile_$PROFILE ($f lines $start-$end) holds more than the profile knobs (line $stray) — rewriting the block would flatten that. Edit the values by hand, or re-run without --save."
      fi
      awk -v s="$start" -v e="$end" -v b="$blk" '
        NR == s { while ((getline l < b) > 0) print l; next }
        NR > s && NR <= e { next }
        { print }
      ' "$f" >"$cand"
    fi
  fi

  # Prove it BEFORE installing it: source the candidate, load the profile back
  # out of it, and render — the result must be byte-identical to the drop-in
  # this command just wrote. A candidate that fails is never installed, so a
  # bad save costs nothing. Rendering from the FILE rather than from the
  # variables in hand is the whole point: it is the file that has to reproduce
  # the drop-in, not this process's memory of what it applied.
  local want got rc=0
  want="$(render_dropin)"
  # A fresh bash rather than a subshell of this one: it starts from the
  # script's own defaults, so a knob the saved block failed to write shows up
  # as a difference instead of being masked by the value still in hand — and
  # it is the same two steps the NEXT invocation will take (source the script,
  # source the config), rather than an approximation of them.
  got="$(RUNNERCTL_NO_MAIN=1 bash -c '. "$1"; . "$2"; PROFILE="$3"; load_profile; render_dropin' \
         bash "${BASH_SOURCE[0]}" "$cand" "$PROFILE" 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ] || [ "$got" != "$want" ]; then
    rm -rf "$tmpd"
    die "--save: the saved profile_$PROFILE does not re-render the drop-in just applied — $f left unchanged. The drop-ins on disk are correct; nothing else was touched."
  fi

  local priv=() newroot=false
  ! needs_priv "$f" || { priv=(run_priv); newroot=true; }
  # GHR-135: cp + tee, or mkdir + tee + chown + chmod, are several calls on
  # names in the config's directory, so they are root's only in a directory
  # nobody else can write — the rule migrate's config write follows (GHR-117,
  # write_as): root's calls, every call as the one user who owns the
  # directory (no chown: the new file is theirs, 644), or a refusal before
  # the first call. $cand is in this process's own mktemp directory and is
  # opened by this shell, on stdin, so the user's tee never opens it.
  save_write_as "$f"
  [ "${#WRITE_AS[@]}" -eq 0 ] || priv=("${WRITE_AS[@]}")
  local wuser="$WRITE_USER"
  [ -z "$WRITE_USER" ] || newroot=false
  if $existed; then
    # tee onto the existing file keeps its inode, owner and mode — the ones
    # load_config already accepted when it sourced it this run.
    "${priv[@]}" cp -p "$f" "$f.bak"
    "${priv[@]}" tee "$f" <"$cand" >/dev/null
  else
    "${priv[@]}" mkdir -p -m 755 "$(dirname "$f")"
    "${priv[@]}" tee "$f" <"$cand" >/dev/null
    ! $newroot || run_priv chown root:root "$f"
    "${priv[@]}" chmod 644 "$f"
  fi
  if [ -r "$f" ] && ! cmp -s "$cand" "$f"; then
    rm -rf "$tmpd"
    die "--save: $f on disk is not the content that was verified — nothing else was touched"
  fi
  rm -rf "$tmpd"

  if $existed; then
    echo "Saved profile '$PROFILE' to $f (previous version: $f.bak)."
  else
    echo "Created $f with profile '$PROFILE'."
  fi
  echo "  verified: $f re-renders the drop-in just applied."
  config_owner_notice "$f" "$wuser"
}

# What profile (if any) manages this slot, read from the first line of its
# drop-in (`# Managed by runnerctl (profile: NAME) — DO NOT EDIT BY HAND.`,
# see render_dropin) — a plain read, no run_priv: the file is root-owned but
# world-readable like the rest of /etc/systemd/system. "—" when the drop-in
# is missing (never applied, or reverted by remove-limits) or unreadable.
# The profile named in a unit's managed drop-in header; nothing when the unit
# has no drop-in or its header names none (the table shows that as —).
slot_profile() {
  local line
  line="$(head -n1 "$SYSTEMD_DIR/$1.d/$DROPIN_NAME" 2>/dev/null)" || return 0
  [[ "$line" =~ \(profile:\ ([^\)]+)\) ]] && echo "${BASH_REMATCH[1]}"
  return 0
}

# --- Colour (GHR-27) ---------------------------------------------------------
# The table's cells are painted by meaning — ACTIVE green/yellow/red, USED
# turning red as a slot reaches its MemoryHigh, WORKING-ON dim while idle and
# bold red when STALLED — and only when someone is looking: --color auto (the
# default) paints when stdout is a terminal and NO_COLOR is unset or empty
# (no-color.org); always/never override. The C_* codes stay empty while
# colour is off, so paint() is a plain echo there and every renderer can call
# it unconditionally. --json and health never paint.
COLOR_MODE="auto"
C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW=""
color_setup() { # auto|always|never
  local on=false
  case "$1" in
    always) on=true ;;
    never)  on=false ;;
    auto)   [ -n "${NO_COLOR:-}" ] || ! stdout_is_tty || on=true ;;
    *)      die "--color value '$1' is invalid — want auto, always or never" ;;
  esac
  if $on; then
    C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m'
  else
    C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW=""
  fi
}
# TEXT wrapped in an SGR code (one or more C_* values; nothing when empty).
paint() { # SGR TEXT
  printf '%s%s%s\n' "$1" "$2" "${1:+$C_RESET}"
}
# TEXT with its SGR sequences removed, into SGR_STRIPPED: the characters that
# are actually visible, for measuring a padded cell or for reading a value out
# of a line that may or may not have been painted.
#
# Into a global rather than onto stdout because every caller is per-line inside
# a redraw loop, and a subshell per line is a cost a frame does not need. The
# bounded `*([0-9;])` is what extglob is switched on for at the top of this
# script: an unbounded `*` would run to the LAST `m` on the line and eat
# everything between two painted cells.
SGR_STRIPPED=""
strip_sgr() { # TEXT
  SGR_STRIPPED="${1//$'\e['*([0-9;])m/}"
}
# The columns a line of visible text takes on a terminal (GHR-94), into
# DISPLAY_WIDTH. ${#text} counts characters, and a wide character (CJK, most
# emoji) takes two columns while a combining mark or a variation selector
# takes none; the text that can carry them is whatever the host does not
# control (a job name, a repo name, a path). watch_table_width and
# viewport_rows both measure through this, so they cannot disagree.
#
# Pure bash, no subprocess and no `wc -L`: that needs GNU wc and a UTF-8
# locale, and the result must not depend on either. The work is done on BYTES
# under a function-local LC_ALL=C, decoding UTF-8 by its lead and continuation
# bytes, so the answer is the same whatever the caller's locale. A line of
# ASCII only is ${#text} and nothing else. A line with a byte >= 0x80 pays for
# one substitution (its characters); only one with a lead byte that can start a
# wide or zero-width character reaches the range table, and DISPLAY_WIDTH_SLOW
# counts those, so the sim can pin that an ordinary frame (the table's `—`, `·`
# and `↻` included) never does.
#
# APPROXIMATED, by a small range table rather than a full wcwidth: wide is
# Hangul Jamo (U+1100-115F), U+3000-9FFF, Yi and Hangul syllables
# (U+A000-A4CF, U+AC00-D7FF), fullwidth forms (U+FF00-FF60, U+FFE0-FFE6),
# emoji U+1F300-1F6FF and U+1F900-1F9FF, and U+20000-3FFFF; zero is U+0300-036F,
# U+200B-200F, U+20D0-20FF and U+FE00-FE0F. Everything else non-ASCII counts 1,
# so a BMP symbol that a terminal draws as emoji (U+2600 block) is still short.
# Invalid UTF-8 is not diagnosed: stray continuation bytes count for nothing.
DISPLAY_WIDTH=0 DISPLAY_WIDTH_SLOW=0
display_width() { # TEXT
  local LC_ALL=C s="$1" t c n
  c=[$'\x80'-$'\xbf']
  DISPLAY_WIDTH=${#s}
  [[ "$s" == *[$'\x80'-$'\xff']* ]] || return 0
  t="${s//$c/}"; DISPLAY_WIDTH=${#t}
  # Most non-ASCII a table carries (— · ↻ é) is neither wide nor zero-width: a
  # line with no lead byte that can start one is its character count.
  [[ "$s" == *[$'\xcc'-$'\xcd'$'\xe1'$'\xe3'-$'\xff']* || "$s" == *$'\xe2\x80'[$'\x8b'-$'\x8f']* || "$s" == *$'\xe2\x83'* ]] || return 0
  DISPLAY_WIDTH_SLOW=$((DISPLAY_WIDTH_SLOW + 1))
  # Three-byte wide characters, then four-byte ones, one extra column each.
  t="${s//@([$'\xe3'-$'\xe9']$c|$'\xea'[$'\x80'-$'\x93']|$'\xea'[$'\xb0'-$'\xbf']|[$'\xeb'-$'\xec']$c|$'\xed'[$'\x80'-$'\x9f']|$'\xe1\x84'|$'\xe1\x85'[$'\x80'-$'\x9f']|$'\xef\xbc'|$'\xef\xbd'[$'\x80'-$'\xa0']|$'\xef\xbf'[$'\xa0'-$'\xa6'])$c/}"
  n=$(((${#s} - ${#t}) / 3))
  t="${s//@($'\xf0\x9f'[$'\x8c'-$'\x9b']|$'\xf0\x9f'[$'\xa4'-$'\xa7']|$'\xf0'[$'\xa0'-$'\xbf']$c)$c/}"
  DISPLAY_WIDTH=$((DISPLAY_WIDTH + n + (${#s} - ${#t}) / 4))
  # Zero-width: two-byte combining marks, then three-byte ones.
  t="${s//@($'\xcc'$c|$'\xcd'[$'\x80'-$'\xaf'])/}"
  n=$(((${#s} - ${#t}) / 2))
  t="${s//@($'\xe2\x80'[$'\x8b'-$'\x8f']|$'\xe2\x83'[$'\x90'-$'\xbf']|$'\xef\xb8'[$'\x80'-$'\x8f'])/}"
  DISPLAY_WIDTH=$((DISPLAY_WIDTH - n - (${#s} - ${#t}) / 3))
}
# Options `status` and `watch` share: --color WHEN and --stall-after N. Sets
# VIEW_SHIFT to the argv words consumed, 0 when $1 is neither.
VIEW_SHIFT=0
set_stall_after() { # SECONDS
  [[ "$1" =~ ^[0-9]+$ ]] || die "--stall-after value '$1' is invalid — want a whole number of seconds (0 disables the stalled flag)"
  STALL_SEC="$1"
}
view_opt() { # ARGS...
  VIEW_SHIFT=0
  case "$1" in
    --color)
      need_val "$@"
      case "$2" in auto|always|never) ;; *) die "--color value '$2' is invalid — want auto, always or never" ;; esac
      COLOR_MODE="$2"; VIEW_SHIFT=2 ;;
    --stall-after)
      need_val "$@"
      set_stall_after "$2"; VIEW_SHIFT=2 ;;
  esac
}

# --- Commands -----------------------------------------------------------------
# Column widths of the status table; the last column (WORKING-ON) is unpadded.
STATUS_WIDTHS=(3 40 8 19 8 9 6 6 12 6 5 8 7)

# Print one status row, padding each cell by CHARACTERS. Bash's printf counts
# bytes for %-Ns, so the 3-byte `—` cell used for "no value" came out two
# columns short and shifted everything after it (GHR-21). ${#v} counts
# characters under a UTF-8 locale, which is the only kind where `—` renders.
# A painted cell is measured without its SGR sequences (GHR-27), so colour
# never shifts a column either.
# STATUS_DROP (GHR-33): space-separated 0-based column indices to leave out
# of every row — `watch` drops MAX, HIGH, CPU and ENVFILE (6 7 10 12) when
# the table is wider than the terminal, so WORKING-ON never has to go. Empty
# for `status`, which is what keeps its rows byte-identical. CPU (GHR-79) is
# in the set because it is the newest column and the one a narrow terminal
# can best spare: the STALLED qualifier in WORKING-ON still carries what it
# says about a stalled job.
#
# STATUS_NARROW_DROP is that set, and `status --narrow` (GHR-56) is the flag
# that asks for it — the one a `fleet watch` forwards to the remotes, which
# otherwise had no way to ask a host for anything but its full-width table.
# The flag is deliberately a boolean rather than a list of column indices:
# which columns are dispensable is a fact about the table the REMOTE draws,
# and an index list chosen by a central node on another version would drop
# the wrong columns the first time a column is added. The hysteresis both
# watches use to put the columns back is MEASURED, not assumed (GHR-157):
# STATUS_NARROW_GAVE is how many columns narrowing gave back, the width of
# the wide table minus the width of the narrow one, taken at the transition.
# The table widens again only once the narrow table plus that width fits,
# with STATUS_NARROW_MARGIN columns to spare for a terminal a few columns
# either side of the threshold. It used to be a constant 22 — the dropped
# columns at their header widths — and a slot with an EnvironmentFile made
# the real figure ~60: the narrow table then fit with 22 to spare on exactly
# the terminals the wide one overflowed, and both watches flipped the table
# on every tick. Until the first transition has measured it, the old constant
# (STATUS_NARROW_GAVE_FALLBACK) stands in.
#
# STATUS_COLS (GHR-78): the width of the terminal the table is being drawn ON,
# 0 when it is not going to one or the width is unknown. Set by the caller —
# `status` when its stdout is a terminal, `watch` per frame — never read from
# tput in here: render_status runs inside "$(...)" for `watch`, where stdout
# is a pipe, and a `status` whose output is piped or fetched over ssh by a
# `fleet` node must print the same rows whatever terminal happens to be
# around it. With 0, WORKING-ON is the short cell (job_cell).
STATUS_DROP=""
STATUS_NARROW_DROP="6 7 10 12"
STATUS_CPU_COL=10
STATUS_NARROW_MARGIN=4
STATUS_NARROW_GAVE=""
STATUS_NARROW_GAVE_FALLBACK=22
STATUS_COLS=0
status_narrow() { # [true|false]
  if "${1:-true}"; then STATUS_DROP="$STATUS_NARROW_DROP"; else STATUS_DROP=""; fi
}
# `systemctl show -p EnvironmentFiles` prints each file as
# `<path> (ignore_errors=no)` — `yes` for a `-`-prefixed optional file —
# space-separated. The ENVFILE cell and the JSON carry the paths alone
# (GHR-157): the suffix is systemd's rendering of the leading `-`, which the
# path keeps, and it made a 21-character path a 40-character cell. Pure, so
# it is unit-testable (`run_fn`).
env_file_paths() { # VALUE
  local v="$1"
  v="${v// (ignore_errors=no)/}"
  v="${v// (ignore_errors=yes)/}"
  printf '%s\n' "$v"
}
status_row() {
  local w v n c=0 out=""
  for w in "${STATUS_WIDTHS[@]}"; do
    v="$1"; shift
    if [[ " $STATUS_DROP " == *" $c "* ]]; then c=$((c + 1)); continue; fi
    c=$((c + 1))
    out+="$v"
    strip_sgr "$v"; n="$SGR_STRIPPED"
    if [ "${#n}" -lt "$w" ]; then printf -v v '%*s' $((w - ${#n})) ''; out+="$v"; fi
    out+=" "
  done
  printf '%s%s\n' "$out" "$1"
}

# The SGR code for a cell, by what it says (GHR-27). Empty = plain.
status_active_color() { # ACTIVE-STATE NRESTARTS RESULT
  case "$1" in
    active)
      if { [[ "${2:-0}" =~ ^[0-9]+$ ]] && [ "${2:-0}" -gt 0 ]; } || [ "${3:-success}" != success ]; then
        echo "$C_YELLOW"
      else
        echo "$C_GREEN"
      fi ;;
    activating|reloading) echo "$C_YELLOW" ;;
    *)                    echo "$C_RED" ;;
  esac
}
# USED against MemoryHigh: red from the throttle point, yellow from 90 % of
# it; plain when either side is not a number (no accounting, infinity).
status_used_color() { # CURRENT HIGH
  [[ "${1:-}" =~ ^[0-9]+$ && "${2:-}" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ] || return 0
  if [ "$1" -ge "$2" ]; then echo "$C_RED"; elif [ $(( $1 * 10 )) -ge $(( $2 * 9 )) ]; then echo "$C_YELLOW"; fi
}
# GHR-31: the PRESS cell — PSI full avg10 as `12.3%`, — when unknown.
status_press_cell() { # AVG10
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "—"; return; }
  awk -v p="$1" 'BEGIN { printf "%.1f%%", p }'
  echo
}
# Red from PRESSURE_CRIT_PCT, yellow from PRESSURE_WARN_PCT, plain below
# or when unknown. Percent with decimals, so awk compares.
status_press_color() { # AVG10
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
  case "$(awk -v p="$1" -v w="$PRESSURE_WARN_PCT" -v c="$PRESSURE_CRIT_PCT" 'BEGIN { if (p >= c) print "crit"; else if (p >= w) print "warn"; else print "ok" }')" in
    crit) echo "$C_RED" ;;
    warn) echo "$C_YELLOW" ;;
  esac
}
# Is AVG10 at or over PCT? For the health rule and the stalled suffix.
pressure_at_least() { # AVG10 PCT
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  [ "$(awk -v p="$1" -v t="$2" 'BEGIN { print (p >= t) ? 1 : 0 }')" = 1 ]
}
# --- CPU and load, without floating point (GHR-79) ----------------------------
# A load average and a ratio are decimals, and bash has no floating point, so
# both are read as whole HUNDREDTHS (`14.25` -> 1425) and compared as
# integers. The integer part follows num_int's rule — no sign, no exponent,
# no leading zero (`08`, which arithmetic would read as octal) — so a number
# another host sent is held to the same shape as every other one; digits past
# the second decimal are cut, not rounded. Into DEC_H, empty for anything else.
DEC_H=""
dec_hundredths() { # VALUE
  local f
  DEC_H=""
  [[ "${1-}" =~ ^(0|[1-9][0-9]{0,11})(\.([0-9]{1,9}))?$ ]] || return 0
  f="${BASH_REMATCH[3]}00"
  DEC_H=$(( BASH_REMATCH[1] * 100 + 10#${f:0:2} ))
}
# HUNDREDTHS as a one-decimal text, rounded half up: 1425 -> 14.3, 4 -> 0.0.
hundredths_text() { # HUNDREDTHS
  local t=$(( ($1 + 5) / 10 ))
  printf '%d.%d\n' $((t / 10)) $((t % 10))
}

# The load level of a host: crit, warn or nothing, for LOAD (a decimal) on
# CORES against LOAD_CRIT_RATIO / LOAD_WARN_RATIO — load >= ratio × cores,
# both sides in hundredths: load_h >= ratio_h × cores. Nothing when either is not a number
# or there are no cores. Into LOAD_LEVEL (no subshell: `fleet watch` asks for
# every host on every redraw).
LOAD_LEVEL=""
load_level() { # LOAD CORES
  local l c w r
  LOAD_LEVEL=""
  dec_hundredths "${1-}"; l="$DEC_H"
  num_int "${2-}"; c="$NUM_INT"
  [ -n "$l" ] && [ -n "$c" ] && [ "$c" -gt 0 ] || return 0
  dec_hundredths "$LOAD_CRIT_RATIO"; r="$DEC_H"
  dec_hundredths "$LOAD_WARN_RATIO"; w="$DEC_H"
  if [ "$l" -ge $((r * c)) ]; then LOAD_LEVEL=crit
  elif [ "$l" -ge $((w * c)) ]; then LOAD_LEVEL=warn
  fi
}
# The header's `load 14.2/16` fragment, painted by load_level like a disk
# cell: green, yellow or red. Nothing when the load could not be read.
load_cell() { # LOAD CORES
  local sgr l c
  dec_hundredths "${1-}"; l="$DEC_H"
  [ -n "$l" ] || return 0
  num_int "${2-}"; c="$NUM_INT"
  load_level "$1" "$2"
  case "$LOAD_LEVEL" in crit) sgr="$C_RED" ;; warn) sgr="$C_YELLOW" ;; *) sgr="$C_GREEN" ;; esac
  paint "$sgr" "load $(hundredths_text "$l")/${c:-?}"
}

# Cores in use between two cgroup CPU samples, as whole hundredths of a core,
# into CPU_RATE — empty when it cannot be known: a sample missing, a value
# that is no number num_int takes, no time between them, or a counter that
# went BACKWARDS (the unit restarted between the two reads; a rate across a
# restart is not a rate, and a negative one is not a cell anyone can read).
# One read of CGROUP's CPU facts and the instant it was taken: CPU_USAGE
# (usage_usec, empty when accounting is off), CPU_US (now_us, after the
# read), CPU_P10 / CPU_P60 / CPU_PT (cpu.pressure's `some` line).
CPU_USAGE="" CPU_US="" CPU_P10="" CPU_P60="" CPU_PT=""
cpu_sample() { # CGROUP
  local k v
  CPU_USAGE="" CPU_P10="" CPU_P60="" CPU_PT=""
  while IFS='=' read -r k v; do
    case "$k" in
      usage_usec)           CPU_USAGE="$v" ;;
      pressure_some_avg10)  CPU_P10="$v" ;;
      pressure_some_avg60)  CPU_P60="$v" ;;
      pressure_some_total)  CPU_PT="$v" ;;
    esac
  done < <(cgroup_cpu_facts "$1")
  CPU_US="$(now_us)"
}
CPU_RATE=""
cpu_rate() { # USAGE-1 US-1 USAGE-2 US-2
  local u1 t1 u2 t2
  CPU_RATE=""
  num_int "${1-}"; u1="$NUM_INT"; num_int "${2-}"; t1="$NUM_INT"
  num_int "${3-}"; u2="$NUM_INT"; num_int "${4-}"; t2="$NUM_INT"
  [ -n "$u1" ] && [ -n "$t1" ] && [ -n "$u2" ] && [ -n "$t2" ] || return 0
  [ "$t2" -gt "$t1" ] && [ "$u2" -ge "$u1" ] || return 0
  # × 100 must not wrap: past ~29 years of CPU time in one sample it is junk.
  [ $((u2 - u1)) -le 90000000000000000 ] || return 0
  CPU_RATE=$(( (u2 - u1) * 100 / (t2 - t1) ))
}
# `watch`'s CPU samples (GHR-79): one file per unit, "INVOCATION USAGE US",
# the last sample render_status took of it. A directory for the reason the
# journal memo is one — the renderer runs inside "$(...)" — and a directory
# of its own, because that one is emptied every JOURNAL_CACHE_TTL ticks.
# Empty outside `watch`, where every table takes its own window.
#
# A sample is a usable FIRST sample for UNIT only when it is that unit's, of
# the same invocation (a restart starts the counter again), and at least
# CPU_SAMPLE_MS old (a second render inside one tick — the narrow re-render —
# would otherwise divide by a few milliseconds). Into CPU_MEMO_USAGE and
# CPU_MEMO_US; 1 when there is none.
#
# GHR-115: a one-shot table called every tick by `fleet watch` gets the same
# saving from CPU_PREV — the samples the caller read out of this host's own
# previous payload and handed back (`status --cpu-prev=…`, status_cpu_prev),
# keyed by invocation ID alone: an invocation names one run of one unit, and
# the sample and its instant are this host's own, so they are this host's
# clock. A supplied sample is held to the same age rule; one that is missing
# or too young leaves the slot to the one-shot window.
CPU_MEMO_DIR=""
CPU_MEMO_USAGE="" CPU_MEMO_US=""
declare -A CPU_PREV=()
cpu_memo_get() { # UNIT INVOCATION NOW-US
  local inv usage us
  CPU_MEMO_USAGE="" CPU_MEMO_US=""
  if [ -n "${2:-}" ] && [ -n "${CPU_PREV[$2]+set}" ]; then
    read -r usage us <<<"${CPU_PREV[$2]}"
  else
    [ -n "$CPU_MEMO_DIR" ] && [ -f "$CPU_MEMO_DIR/$1" ] || return 1
    read -r inv usage us <"$CPU_MEMO_DIR/$1" || return 1
    [ "$inv" = "${2:-none}" ] || return 1
  fi
  num_int "$us"; us="$NUM_INT"
  num_int "${3-}"
  [ -n "$us" ] && [ -n "$NUM_INT" ] || return 1
  [ $((NUM_INT - us)) -ge $(( CPU_SAMPLE_MS > 0 ? CPU_SAMPLE_MS * 1000 : 1 )) ] || return 1
  CPU_MEMO_USAGE="$usage" CPU_MEMO_US="$us"
}
cpu_memo_put() { # UNIT INVOCATION USAGE US
  [ -n "$CPU_MEMO_DIR" ] || return 0
  printf '%s %s %s\n' "${2:-none}" "$3" "$4" >"$CPU_MEMO_DIR/$1"
}
# GHR-115: `status --cpu-prev=SPEC` into CPU_PREV. SPEC is what
# fleet_cpu_prev_spec builds from this host's previous payload: comma-separated
# INVOCATION:USAGE-USEC:AT-US, the slot's `invocation_id`, `cpu_usage_usec`
# and `cpu_usage_at_us`. A caller that sends anything else has a bug, so it
# dies rather than drawing rates from half of it; empty is no samples.
status_cpu_prev() { # SPEC
  local e inv usage us
  local -a ents=()
  CPU_PREV=()
  IFS=, read -r -a ents <<<"${1-}"
  for e in ${ents[@]+"${ents[@]}"}; do
    IFS=: read -r inv usage us <<<"$e"
    num_int "$usage"; usage="$NUM_INT"
    num_int "$us"; us="$NUM_INT"
    [[ "$inv" =~ ^[0-9a-f]{32}$ ]] && [ -n "$usage" ] && [ -n "$us" ] && [ "$e" = "$inv:$usage:$us" ] \
      || die "--cpu-prev '$e' is invalid — want INVOCATION:USAGE-USEC:AT-US, comma-separated"
    CPU_PREV[$inv]="$usage $us"
  done
}
# The caller's half: the --cpu-prev word for one host, built from that host's
# previous payload (a `status --json` object, one slot per line), or nothing
# when no slot of it carries all three keys — a host from before GHR-115
# sends no `invocation_id`, and a slot without CPU accounting no usage. Every
# value is a remote's, so the numbers go through num_int and the invocation is
# held to systemd's 32 hex digits; a slot that fails either is left out, and
# that slot alone takes the one-shot window.
fleet_cpu_prev_spec() { # JSON-FILE
  local line inv usage us spec=""
  [ -s "$1" ] || return 0
  while IFS= read -r line; do
    [[ "$line" == *'"idx":'* ]] || continue
    json_line_get "$line" invocation_id; inv="$JF"
    [[ "$inv" =~ ^[0-9a-f]{32}$ ]] || continue
    json_line_get "$line" cpu_usage_usec; num_int "$JF"; usage="$NUM_INT"
    json_line_get "$line" cpu_usage_at_us; num_int "$JF"; us="$NUM_INT"
    [ -n "$usage" ] && [ -n "$us" ] || continue
    spec+="${spec:+,}$inv:$usage:$us"
  done <"$1"
  [ -z "$spec" ] || printf -- '--cpu-prev=%s\n' "$spec"
}
# The CPU cell: `3.2` (cores), `—` when the rate is unknown.
cpu_cell() { # HUNDREDTHS
  if [ -n "${1:-}" ]; then hundredths_text "$1"; else echo "—"; fi
}
# GHR-79: what a STALLED job's CPU says about it, appended to its cell —
# informational only: --if-stalled, health and the problem views decide on
# JOB_STALLED alone and never read this. Below CPU_IDLE_HUNDREDTHS of a core
# it is waiting on nothing it can show (likely hung); at or above, it is
# still computing. Nothing when the rate is unknown.
CPU_IDLE_HUNDREDTHS=10
cpu_stall_note() { # HUNDREDTHS
  [ -n "${1:-}" ] || return 0
  if [ "$1" -lt "$CPU_IDLE_HUNDREDTHS" ]; then echo " (idle CPU, likely hung)"; else echo " (still computing)"; fi
}

status_job_color() { # JOB-STATE JOB-STALLED [LEAKED]
  case "$1" in
    running)              if [ "${2:-}" = true ]; then echo "$C_BOLD$C_RED"; else echo "$C_GREEN"; fi ;;
    none|idle|idle-fresh) if [[ "${3:-}" =~ ^[0-9]+$ ]] && [ "${3:-0}" -gt 0 ]; then echo "$C_YELLOW"; else echo "$C_DIM"; fi ;;
    *)                    echo "$C_YELLOW" ;;
  esac
}

# --- One collector, two renderers (GHR-16) -----------------------------------
# Everything `status` knows about one slot, gathered once into SLOT — one
# unit_props fetch, one drop-in read, at most one journal_restart_reason
# lookup and the one journal fetch job_facts makes — so the table
# (render_status) and `status --json` (render_status_json) format the same
# raw values and cannot disagree on a property. Values are systemd's own
# strings, untouched: MemoryMax stays `infinity` or `[not set]` here, the
# stamps stay µs since boot; the renderers decide what — or null — means.
#   unit idx name              the unit, its 0-based index, its short RUNNER name
#   active sub enabled         ActiveState SubState UnitFileState
#   memory_max memory_high memory_current memory_peak
#   restart                    the Restart= policy
#   env_file                   EnvironmentFiles, raw (`/etc/x (ignore_errors=no)`),
#                              empty when none
#   cgroup invocation          ControlGroup InvocationID
#   active_enter inactive_enter
#   restarts result            NRestarts Result
#   profile                    the drop-in's profile, empty when none
#   since_age                  seconds in the current ActiveState (state_age),
#                              empty when the state was never entered
#   last_restart_reason        journal_restart_reason's answer, looked up only
#                              when NRestarts > 0 and Result is success (the
#                              ACTIVE cell's condition), empty otherwise
#   mem_events_high mem_events_max mem_events_oom_kill
#   mem_pressure_full_avg10 mem_pressure_full_avg60 mem_pressure_full_total
#                              cgroup_memory_facts' answers (GHR-31), empty
#                              where the cgroup or the file is not there
#   cpu_usage cpu_us           cpu.stat's usage_usec and the now_us instant
#                              it was read at (GHR-79), empty without a cgroup
#                              or with CPU accounting off
#   cpu_pressure_some_avg10 cpu_pressure_some_avg60 cpu_pressure_some_total
#                              cpu.pressure's `some` line, empty likewise
#   job_*                    the JOB_* facts of job_facts, same names
#                              (job_leaked / job_leaked_pids / job_leaked_comms
#                              included, GHR-29; and the run's, GHR-78:
#                              job_repo_full job_workflow job_run_id
#                              job_run_attempt job_run_number job_ref job_sha
#                              job_actor job_event job_url). The run's are
#                              text a job supplied: validated by job_env_facts,
#                              and to be drawn through term_safe, never raw
declare -A SLOT=()
collect_slot() { # UNIT IDX
  local u="$1" k v n
  SLOT=([unit]="$u" [idx]="$2" [name]="$(short_name "$u")"
        [active]="" [sub]="" [enabled]="" [memory_max]="" [memory_high]=""
        [memory_current]="" [memory_peak]="" [restart]="" [env_file]=""
        [cgroup]="" [invocation]="" [active_enter]="" [inactive_enter]=""
        [restarts]="" [result]="" [profile]="" [since_age]="" [last_restart_reason]=""
        [mem_events_high]="" [mem_events_max]="" [mem_events_oom_kill]=""
        [mem_pressure_full_avg10]="" [mem_pressure_full_avg60]="" [mem_pressure_full_total]=""
        [cpu_usage]="" [cpu_us]="" [cpu_pressure_some_avg10]="" [cpu_pressure_some_avg60]="" [cpu_pressure_some_total]="")
  while IFS='=' read -r k v; do
    case "$k" in
      ActiveState)                      SLOT[active]="$v" ;;
      SubState)                         SLOT[sub]="$v" ;;
      UnitFileState)                    SLOT[enabled]="$v" ;;
      MemoryMax)                        SLOT[memory_max]="$v" ;;
      MemoryHigh)                       SLOT[memory_high]="$v" ;;
      MemoryCurrent)                    SLOT[memory_current]="$v" ;;
      MemoryPeak)                       SLOT[memory_peak]="$v" ;;
      Restart)                          SLOT[restart]="$v" ;;
      EnvironmentFiles)                 SLOT[env_file]="$(env_file_paths "$v")" ;;
      ControlGroup)                     SLOT[cgroup]="$v" ;;
      InvocationID)                     SLOT[invocation]="$v" ;;
      ActiveEnterTimestampMonotonic)    SLOT[active_enter]="$v" ;;
      InactiveEnterTimestampMonotonic)  SLOT[inactive_enter]="$v" ;;
      NRestarts)                        SLOT[restarts]="$v" ;;
      Result)                           SLOT[result]="$v" ;;
    esac
  done < <(unit_props "$u")
  SLOT[profile]="$(slot_profile "$u")"
  while IFS='=' read -r k v; do
    case "$k" in
      events_high|events_max|events_oom_kill|pressure_full_avg10|pressure_full_avg60|pressure_full_total) SLOT[mem_$k]="$v" ;;
    esac
  done < <(cgroup_memory_facts "${SLOT[cgroup]}")
  if [ -n "${SLOT[cgroup]}" ]; then
    cpu_sample "${SLOT[cgroup]}"
    SLOT[cpu_usage]="$CPU_USAGE" SLOT[cpu_us]="$CPU_US"
    SLOT[cpu_pressure_some_avg10]="$CPU_P10" SLOT[cpu_pressure_some_avg60]="$CPU_P60" SLOT[cpu_pressure_some_total]="$CPU_PT"
  fi
  SLOT[since_age]="$(state_age "${SLOT[active]}" "${SLOT[active_enter]}" "${SLOT[inactive_enter]}")"
  n="${SLOT[restarts]}"
  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && [ "${SLOT[result]:-success}" = success ]; then
    SLOT[last_restart_reason]="$(journal_restart_reason "$u")"
  fi
  job_facts "$u" "${SLOT[cgroup]}" "${SLOT[invocation]}" "${SLOT[active_enter]}"
  SLOT[job_state]="$JOB_STATE" SLOT[job_name]="$JOB_NAME" SLOT[job_repo]="$JOB_REPO"
  SLOT[job_since]="$JOB_SINCE" SLOT[job_runtime]="$JOB_RUNTIME" SLOT[job_stalled]="$JOB_STALLED"
  SLOT[job_idle_since]="$JOB_IDLE_SINCE" SLOT[job_done]="$JOB_DONE" SLOT[job_access]="$JOB_ACCESS"
  SLOT[job_leaked]="$JOB_LEAKED" SLOT[job_leaked_pids]="$JOB_LEAKED_PIDS" SLOT[job_leaked_comms]="$JOB_LEAKED_COMMS"
  SLOT[job_repo_full]="$JOB_REPO_FULL" SLOT[job_workflow]="$JOB_WORKFLOW" SLOT[job_run_id]="$JOB_RUN_ID"
  SLOT[job_run_attempt]="$JOB_RUN_ATTEMPT" SLOT[job_run_number]="$JOB_RUN_NUMBER" SLOT[job_ref]="$JOB_REF"
  SLOT[job_sha]="$JOB_SHA" SLOT[job_actor]="$JOB_ACTOR" SLOT[job_event]="$JOB_EVENT" SLOT[job_url]="$JOB_URL"
}

# GHR-90: `status --with-json` — the table, then a line that is
# STATUS_JSON_SEP, then the `status --json` object, both formatted from the
# SAME collection: one collect_slot per slot, one collect_host. It is the
# form `fleet status` and `fleet watch` ask every host for, so their summary
# line (which counts from the JSON, never from the painted table) costs no
# second call and describes the same moment as the rows beside it.
#
# The separator starts with an ASCII record separator (0x1e). Nothing in a
# table line can begin with it: every line the table draws starts with
# printable text or with an SGR sequence (ESC), and text a job or a process
# supplied is drawn through term_safe / relay_safe, which never pass a raw
# control byte. The rest of the line is only there for a human reading the
# raw answer; a reader matches the leading byte alone (fleet_with_json_split).
STATUS_WITH_JSON=false
STATUS_JSON_SEP=$'\x1e''runnerctl status --json follows'

# The status table itself, printed once to stdout. `status` calls it once;
# `watch` (GHR-3, below cmd_logs) captures it per tick and redraws it in place.
# With STATUS_WITH_JSON the JSON object follows it (above).
render_status() {
  require_runners
  local cores="" mem_total="" mem_avail="" jhead="" jbody="" jsep=""
  # In render_status_json's order: host_facts, then collect_host.
  ! $STATUS_WITH_JSON || read -r cores mem_total mem_avail < <(host_facts) || true
  # The version leads the header (GHR-32): `upgrade` fetches main, so what a
  # host actually runs is otherwise only visible through a second command.
  # Disks and journal events (GHR-64) ride on this same line rather than a
  # new one: `fleet status` and `fleet watch` read the column header as the
  # third line of a host's output, and a host's table must not move it.
  collect_host
  ! $STATUS_WITH_JSON || jhead="$(status_json_head "$cores" "$mem_total" "$mem_avail")"
  echo "runnerctl $RUNNERCTL_VERSION — Host: $(host_line)$(host_header_suffix)"
  echo
  paint "$C_BOLD" "$(status_row IDX RUNNER PROFILE ACTIVE SINCE ENABLED MAX HIGH USED PRESS CPU RESTART ENVFILE WORKING-ON)"
  local i=0 j u no_access=false stalled=false leaked=false w room=0 cpu_shown=true need=false last=0 now
  local -a cells=() units=() cgs=() invs=() s1u=() s1t=() rate=() pend=() jtxt=() jsgr=() jst=()
  [[ " $STATUS_DROP " != *" $STATUS_CPU_COL "* ]] || cpu_shown=false
  # GHR-78: what a terminal STATUS_COLS wide leaves for WORKING-ON beyond the
  # FULL table — every column, whether or not this render drops some.
  # Measured against the full table on purpose: a long cell that only fits
  # the narrow one would be exactly the width that keeps `watch` from putting
  # MAX, HIGH and ENVFILE back (narrow_wanted's margin), and a workflow name
  # is not worth three columns of limits.
  if [ "$STATUS_COLS" -gt 0 ]; then
    room="$STATUS_COLS"
    for w in "${STATUS_WIDTHS[@]}"; do room=$((room - w - 1)); done
    [ "$room" -gt 0 ] || room=0
  fi
  # GHR-79: two passes. The first collects every slot and keeps its cells,
  # with each slot's first CPU sample; the CPU cells need a second sample, so
  # the rows are printed only once that has been taken.
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$i"
    if $STATUS_WITH_JSON; then
      jbody+="$(status_json_slot "$jsep" "$i" "$u")"
      jsep=","
    fi
    # `idle ?` is the /proc-only reader's idle: it knows the slot is idle but
    # not for how long, which is the same missing journal access.
    case "${SLOT[job_state]}" in no-access|idle-unknown) no_access=true ;; esac
    [ "${SLOT[job_stalled]}" != true ] || stalled=true
    { [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; } && leaked=true
    units[i]="$u" cgs[i]="${SLOT[cgroup]}" invs[i]="${SLOT[invocation]}" rate[i]="" pend[i]=false
    if [ -n "${SLOT[cpu_usage]}" ]; then
      # Under `watch` the previous tick's sample of THIS unit and invocation
      # is the first one, and this read the second; otherwise this read is
      # the first, and the second comes after the loop.
      if cpu_memo_get "$u" "${SLOT[invocation]}" "${SLOT[cpu_us]}"; then
        cpu_rate "$CPU_MEMO_USAGE" "$CPU_MEMO_US" "${SLOT[cpu_usage]}" "${SLOT[cpu_us]}"
        rate[i]="$CPU_RATE"
      else
        pend[i]=true
      fi
      s1u[i]="${SLOT[cpu_usage]}" s1t[i]="${SLOT[cpu_us]}"
    fi
    jst[i]="${SLOT[job_stalled]}"
    jsgr[i]="$(status_job_color "${SLOT[job_state]}" "${SLOT[job_stalled]}" "${SLOT[job_leaked]}")"
    jtxt[i]="$(job_cell "$room")"
    cells+=("$i" "${SLOT[name]}" \
      "$(if [ -n "${SLOT[profile]}" ]; then echo "${SLOT[profile]}"; else paint "$C_DIM" "—"; fi)" \
      "$(paint "$(status_active_color "${SLOT[active]}" "${SLOT[restarts]:-0}" "${SLOT[result]:-success}")" \
               "$(status_active_cell "${SLOT[active]}" "${SLOT[sub]}" "${SLOT[restarts]:-0}" "${SLOT[result]:-success}" "${SLOT[last_restart_reason]}")")" \
      "$(if [ -n "${SLOT[since_age]}" ]; then fmt_dur "${SLOT[since_age]}"; else paint "$C_DIM" "—"; fi)" \
      "$(paint "$([ "${SLOT[enabled]}" = enabled ] || echo "$C_DIM")" "${SLOT[enabled]}")" \
      "$(hbytes "${SLOT[memory_max]}")" "$(hbytes "${SLOT[memory_high]}")" \
      "$(paint "$(status_used_color "${SLOT[memory_current]}" "${SLOT[memory_high]}")" \
               "$(status_used_cell "${SLOT[memory_current]}" "${SLOT[memory_peak]}")")" \
      "$(paint "$(status_press_color "${SLOT[mem_pressure_full_avg10]}")" "$(status_press_cell "${SLOT[mem_pressure_full_avg10]}")")" \
      "${SLOT[restart]}" "${SLOT[env_file]:-—}")
    i=$((i+1))
  done < <(discover)
  # GHR-79: the one-shot sample. A slot still waiting for its second sample
  # gets one only where it will be drawn — the CPU column, or the qualifier
  # of a STALLED job — and only when CPU_SAMPLE_MS allows a wait at all. The
  # window is the time the first pass took, topped up to CPU_SAMPLE_MS after
  # the LAST first sample, so one wait covers every slot and a host whose
  # collection is slow waits for nothing.
  for ((j = 0; j < i; j++)); do
    if ${pend[j]} && [ "$CPU_SAMPLE_MS" -gt 0 ] && { $cpu_shown || [ "${jst[j]}" = true ]; }; then
      need=true
      [ "${s1t[j]}" -le "$last" ] || last="${s1t[j]}"
    else
      pend[j]=false
    fi
  done
  if $need; then
    now="$(now_us)"
    if [ $((last + CPU_SAMPLE_MS * 1000)) -gt "$now" ]; then
      cpu_window_wait $(( (last + CPU_SAMPLE_MS * 1000 - now + 999) / 1000 ))
    fi
    for ((j = 0; j < i; j++)); do
      ${pend[j]} || continue
      cpu_sample "${cgs[j]}"
      cpu_rate "${s1u[j]}" "${s1t[j]}" "$CPU_USAGE" "$CPU_US"
      rate[j]="$CPU_RATE" s1u[j]="$CPU_USAGE" s1t[j]="$CPU_US"
    done
  fi
  for ((j = 0; j < i; j++)); do
    # The latest sample of each unit, for the next tick of a `watch`.
    [ -z "${s1u[j]:-}" ] || cpu_memo_put "${units[j]}" "${invs[j]}" "${s1u[j]}" "${s1t[j]}"
    w=""
    [ "${jst[j]}" != true ] || w="$(cpu_stall_note "${rate[j]}")"
    status_row "${cells[@]:j*12:10}" "$(cpu_cell "${rate[j]}")" "${cells[@]:j*12+10:2}" \
      "$(paint "${jsgr[j]}" "${jtxt[j]}$w")"
  done
  # Once under the table, not per row, so the rows stay parseable.
  if $no_access; then
    paint "$C_YELLOW" "note: WORKING-ON needs journal read access (systemd-journal group) or root"
  fi
  if $stalled; then
    paint "$C_RED" "note: STALLED = a job running longer than $(fmt_dur "$STALL_SEC") (STALL_SEC=$STALL_SEC); 'runnerctl logs <IDX>' shows what it is doing, a high PRESS means it is memory-throttled rather than hung"
  fi
  if $leaked; then
    paint "$C_YELLOW" "note: +N leaked = processes a finished job left in the slot's cgroup, counting against MemoryMax; 'runnerctl reap <IDX>' kills them"
  fi
  if $STATUS_WITH_JSON; then
    printf '%s\n%s%s\n]}\n' "$STATUS_JSON_SEP" "$jhead" "$jbody"
  fi
}

# --- Machine-readable status (GHR-16) ----------------------------------------
# A JSON string: backslash, quote and the control characters escaped (\n \r
# \t by name, the rest as \u00XX), everything else verbatim. systemd's own
# property values carry none of these in practice; escaped anyway.
json_str() { # STRING
  local s="${1-}" out="" c i n
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  if [[ "$s" == *[[:cntrl:]]* ]]; then
    n=${#s}
    for ((i = 0; i < n; i++)); do
      c="${s:i:1}"
      case "$c" in
        $'\n')      out+='\n' ;;
        $'\r')      out+='\r' ;;
        $'\t')      out+='\t' ;;
        [[:cntrl:]]) printf -v c '\\u%04x' "'$c"; out+="$c" ;;
        *)          out+="$c" ;;
      esac
    done
    s="$out"
  fi
  printf '"%s"\n' "$s"
}

# A JSON value from a raw string: null when empty, else a string.
json_strn() { if [ -n "${1:-}" ]; then json_str "$1"; else echo null; fi; }

# A JSON number from a raw string: unquoted only when it is all digits, null
# otherwise — a stamp that was never set, a count that is missing.
json_num() { if [[ "${1:-}" =~ ^[0-9]+$ ]]; then echo "$1"; else echo null; fi; }

# A JSON number from a decimal string (12.34), null otherwise (GHR-31).
json_dec() { if [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then echo "$1"; else echo null; fi; }

# A JSON boolean from "true"/"false", null for anything else (unknown).
json_bool() { case "${1:-}" in true|false) echo "$1" ;; *) echo null ;; esac; }

# A JSON byte count from a systemd memory property: null where hbytes prints
# — (unset, infinity, [not set]), the number otherwise, and any other
# string as a string so nothing is silently dropped.
json_bytes() {
  case "${1:-}" in
    ''|infinity|max|18446744073709551615|'[not set]') echo null; return ;;
  esac
  if [[ "$1" =~ ^[0-9]+$ ]]; then echo "$1"; else json_str "$1"; fi
}

# The status table header's "Host: ..." fragment: core count and free -h's
# human-rounded memory line, e.g. "16 cores, 30Gi RAM, 21Gi available".
# Behind a function (like host_facts below) so a test config can pin it —
# free -h's rounding can differ between two runs on a loaded box, which is
# what made the `status --color always` sim case's whole-output diff flake
# (GHR-34); the table's own header keeps `free -h`, whose rounding is what
# people are used to reading, rather than switching to host_facts's exact
# bytes.
host_line() {
  echo "$(nproc) cores, $(free -h | awk '/^Mem:/{print $2" RAM, "$7" available"}')"
}

# Core count and memory in bytes for the JSON `host` object — `nproc` and
# /proc/meminfo, on one line: "CORES MEM_TOTAL MEM_AVAILABLE", any of them
# empty where it cannot be read. Behind a function so a test config can pin
# it.
host_facts() {
  local cores
  cores="$(nproc 2>/dev/null || true)"
  awk -v c="$cores" '
    /^MemTotal:/     { t = $2 * 1024 }
    /^MemAvailable:/ { a = $2 * 1024 }
    END { printf "%s %s %s\n", c, (t == "" ? "" : sprintf("%.0f", t)), (a == "" ? "" : sprintf("%.0f", a)) }
  ' /proc/meminfo 2>/dev/null || echo "$cores"
}

# The host's own name for the JSON `host` object (GHR-38) — `hostname`, then
# `uname -n`, empty if neither answers. Behind a function so a test config can
# pin it, like host_facts and host_line above.
#
# It is deliberately the host's OWN idea of its name rather than something a
# caller passes in: a central node fanning `status --json` out over ssh knows
# only the alias it dialled, and where the alias and the hostname disagree —
# one box reachable under two names, or an alias pointing somewhere other than
# where its name suggests — that is worth seeing rather than papering over.
# It also makes a saved payload self-describing: a file or a monitoring record
# says which host produced it, with no out-of-band label.
host_name() {
  hostname 2>/dev/null || uname -n 2>/dev/null || true
}

# --- Host disks and journal events (GHR-64) ----------------------------------
# A runner host that fills its disk (docker layers, workspaces, caches) or
# takes a host-wide OOM kill says nothing about it in the slot rows: the
# per-slot memory_events.oom_kill (GHR-31) only sees a slot's own cgroup
# limit. These two hooks are the host's half, read once per status/health.

# Which filesystems are watched (GHR-67): the ones that hold something a build
# pool fills — Docker's data root, every slot's work folder, and DISK_PATHS —
# not every block device, which put /boot and /efi next to them. One
# "ROLE<TAB>PATH" line each, in that order. A slot's work folder is its unit's
# WorkingDirectory plus the runner's own workFolder (runner_work_folder, the
# same reading compose-reap does).
disk_watch_paths() {
  local u wd p
  printf 'docker\t%s\n' "$DISK_DOCKER_DIR"
  while read -r u; do
    [ -n "$u" ] || continue
    wd="$(prop "$u" WorkingDirectory)"
    [ -n "$wd" ] || continue
    printf 'work\t%s\n' "$(runner_work_folder "$wd")"
  done < <(discover)
  for p in $DISK_PATHS; do
    case "$p" in
      *=*) printf '%s\t%s\n' "${p%%=*}" "${p#*=}" ;;
      *)   printf '%s\t%s\n' "$p" "$p" ;;
    esac
  done
}

# For each PATH that exists, the filesystem holding it as
# "PATH<TAB>DEVICE FSTYPE SIZE USED AVAIL PCT MOUNT" — sizes in bytes, PCT
# without the %, MOUNT last so a mount point with a space in it survives
# `read`. A path that does not exist (no Docker on this host) prints nothing.
# Behind a function so a test config can pin it.
host_df() { # PATH...
  local p
  for p in "$@"; do
    [ -e "$p" ] || continue
    df -B1 --output=source,fstype,size,used,avail,pcent,target -- "$p" 2>/dev/null \
      | awk -v p="$p" 'NR == 2 { sub(/%/, "", $6); printf "%s\t%s\n", p, $0 }' || true
  done
}

# Each watched filesystem as
#   PCT<TAB>AVAIL<TAB>MOUNT<TAB>DEVICE<TAB>FSTYPE<TAB>SIZE<TAB>USED<TAB>ROLES
# once per filesystem — a /dev device once however many paths and mounts
# (bind mounts, btrfs subvolumes) reach it, anything else once per mount
# point — with the roles of every path on it, comma-joined and deduplicated,
# in the order disk_watch_paths found them. `/` stands in when no path
# resolves at all (no Docker, no slots). DISK_IGNORE applied — the one reader
# the header, --json and health share.
host_disk_rows() {
  local -a roles=() paths=() order=()
  local -A row=() role_of=() seen_role=()
  local role p line dev fs size used avail pct mnt key rk i
  while IFS=$'\t' read -r role p; do
    [ -n "$p" ] || continue
    roles+=("$role"); paths+=("$p")
  done < <(disk_watch_paths)
  if [ "${#paths[@]}" -gt 0 ]; then
    while IFS=$'\t' read -r p line; do
      [ -n "$line" ] || continue
      read -r dev fs size used avail pct mnt <<<"$line"
      [ -n "$mnt" ] || continue
      [ -z "$DISK_IGNORE" ] || ! [[ "$mnt" =~ $DISK_IGNORE ]] || continue
      case "$dev" in /dev/*) key="$dev" ;; *) key="mnt:$mnt" ;; esac
      if [ -z "${row[$key]+x}" ]; then
        row[$key]="$pct"$'\t'"$avail"$'\t'"$mnt"$'\t'"$dev"$'\t'"$fs"$'\t'"$size"$'\t'"$used"
        order+=("$key")
      fi
      for i in "${!paths[@]}"; do
        [ "${paths[$i]}" = "$p" ] || continue
        rk="$key"$'\t'"${roles[$i]}"
        [ -z "${seen_role[$rk]:-}" ] || continue
        seen_role[$rk]=1
        role_of[$key]+="${role_of[$key]:+,}${roles[$i]}"
      done
    done < <(host_df "${paths[@]}")
  fi
  if [ "${#order[@]}" -eq 0 ]; then
    while IFS=$'\t' read -r p line; do
      read -r dev fs size used avail pct mnt <<<"$line"
      [ -n "$mnt" ] || continue
      [ -z "$DISK_IGNORE" ] || ! [[ "$mnt" =~ $DISK_IGNORE ]] || continue
      key="$dev"; row[$key]="$pct"$'\t'"$avail"$'\t'"$mnt"$'\t'"$dev"$'\t'"$fs"$'\t'"$size"$'\t'"$used"
      order+=("$key"); role_of[$key]=root
    done < <(host_df /)
  fi
  for key in ${order[@]+"${order[@]}"}; do
    printf '%s\t%s\n' "${row[$key]}" "${role_of[$key]}"
  done
}

# The journal lines that are host trouble, since epoch SINCE, as
# `journalctl -o short-unix` prints them: kernel OOM kills (global and
# cgroup-limit, told apart by host_events_parse) and "No space left on
# device" from any unit. Fails when the journal cannot be read, because "no
# events" must not be what an unreadable journal looks like.
#
# Two calls, because one cannot tell those apart. `journalctl -g` exits 1
# when NOTHING MATCHES — measured, as root, on a readable journal — which is
# the same status it gives a user outside systemd-journal. So access is asked
# first with `-n 1` (--system: a plain journalctl answers an unreadable
# journal with exit 0), which exits 0 on an empty window too, and the search
# itself is then allowed to "fail". Behind a function so a test config can
# pin it.
HOST_EVENTS_PATTERN='Out of memory: Kill(ed)? process|Memory cgroup out of memory|No space left on device'
journal_host_events() { # SINCE-EPOCH
  journalctl --system -q --no-pager -n 1 >/dev/null 2>&1 || return 1
  journalctl --system -q --no-pager -o short-unix --since "@$1" -g "$HOST_EVENTS_PATTERN" 2>/dev/null || true
}

# journal_host_events, memoised under `watch` like journal_job_lines_cached:
# a redraw every 2 s is not worth a journal scan every 2 s.
journal_host_events_cached() { # SINCE-EPOCH
  [ -n "$JOURNAL_MEMO_DIR" ] || { journal_host_events "$@"; return; }
  local f="$JOURNAL_MEMO_DIR/host-events" out rc=0
  if [ ! -f "$f.rc" ]; then
    out="$(journal_host_events "$@")" || rc=$?
    printf '%s\n' "$out" >"$f"
    echo "$rc" >"$f.rc"
  fi
  cat "$f"
  return "$(cat "$f.rc")"
}

# Parse those lines into one tab-separated record:
#   OOM CGROUP-OOM DISK-FULL LAST-OOM-TS LAST-OOM-PROC LAST-DF-TS LAST-DF-SOURCE
# OOM is the kernel's host-wide kill ("Out of memory: Killed process N
# (comm)"); a "Memory cgroup out of memory" line is a cgroup limit — a slot's
# MemoryMax, which GHR-28 makes a step failure by design — and counted apart.
# LAST-DF-SOURCE is the syslog identifier of the last disk-full line. Pure,
# so it is unit-testable (`run_fn`).
host_events_parse() { # LINES
  local line oom=0 cg=0 df=0 oom_ts="" oom_proc="" df_ts="" df_src="" rest
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      *"Memory cgroup out of memory"*)
        cg=$((cg + 1)) ;;
      *"Out of memory: Kill"*" process "*)
        oom=$((oom + 1)); oom_ts="${line%% *}"; oom_ts="${oom_ts%%.*}"
        rest="${line#*process }"; oom_proc=""
        if [[ "$rest" == *"("*")"* ]]; then rest="${rest#*\(}"; oom_proc="${rest%%\)*}"; fi ;;
      *"No space left on device"*)
        df=$((df + 1)); df_ts="${line%% *}"; df_ts="${df_ts%%.*}"
        rest="${line#* }"; rest="${rest#* }"; df_src="${rest%%:*}"; df_src="${df_src%%\[*}" ;;
    esac
  done <<<"$1"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$oom" "$cg" "$df" "$oom_ts" "$oom_proc" "$df_ts" "$df_src"
}

# The host facts every surface reads, into HOST (an associative array) —
# like collect_slot fills SLOT, so the header, --json and health cannot
# disagree. HOST[disks] is host_disk_rows' output; HOST[events] is "ok",
# "off" (EVENTS_SEC=0) or "no-access", and with "ok" the parsed counts.
declare -A HOST=()
collect_host() {
  local lines rc=0
  HOST=()
  # GHR-79: the load averages ("" each when /proc/loadavg cannot be read) and
  # the core count they are measured against.
  read -r 'HOST[load1]' 'HOST[load5]' 'HOST[load15]' < <(host_loadavg) || true
  read -r 'HOST[cores]' _ < <(host_facts) || true
  HOST[disks]="$(host_disk_rows)"
  if [ "$EVENTS_SEC" -eq 0 ]; then
    HOST[events]=off; return 0
  fi
  lines="$(journal_host_events_cached "$(( $(now_epoch) - EVENTS_SEC ))")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    HOST[events]=no-access; return 0
  fi
  HOST[events]=ok
  IFS=$'\t' read -r 'HOST[oom]' 'HOST[cgroup_oom]' 'HOST[disk_full]' 'HOST[last_oom]' 'HOST[last_oom_proc]' \
    'HOST[last_disk_full]' 'HOST[last_disk_full_src]' < <(host_events_parse "$lines")
}

# How full is full: "crit", "warn" or nothing, for a percentage.
disk_level() { # PCT
  [[ "${1:-}" =~ ^[0-9]+$ ]] || return 0
  if [ "$1" -ge "$DISK_CRIT_PCT" ]; then echo crit
  elif [ "$1" -ge "$DISK_WARN_PCT" ]; then echo warn
  fi
}

# The colour a partition at PCT is painted (GHR-67): every partition gets
# one, so a healthy disk reads as checked-and-fine rather than as unpainted.
disk_color() { # PCT
  case "$(disk_level "$1")" in
    crit) echo "$C_RED" ;; warn) echo "$C_YELLOW" ;; *) echo "$C_GREEN" ;;
  esac
}

# One partition as the header names it: "/srv [docker,work] 88% (223.5G free)".
disk_cell() { # PCT AVAIL MOUNT ROLES
  printf '%s%s %s%% (%s free)\n' "$3" "${4:+ [$4]}" "$1" "$(hbytes "$2")"
}

# ARGS joined by SEP.
join_by() { # SEP ARGS...
  local sep="$1" out="" a; shift
  for a in "$@"; do out+="${out:+$sep}$a"; done
  printf '%s\n' "$out"
}

# The header's " — load 3.1/16" (GHR-79), " — Disk: / [work] 24% (354.0G
# free), /var/lib/docker [docker] 91% (45.0G free)" and, when the window holds
# any, " — last 1h: 2 OOM kills, 1 disk-full", the load and each partition
# painted green, yellow or red. Empty when there is nothing to say. Reads HOST.
host_header_suffix() {
  local out="" pct avail mnt roles cells=() load
  # GHR-79: " — load 14.2/16" first, painted by LOAD_WARN_RATIO /
  # LOAD_CRIT_RATIO; nothing when /proc/loadavg could not be read.
  load="$(load_cell "${HOST[load1]:-}" "${HOST[cores]:-}")"
  [ -z "$load" ] || out+=" — $load"
  while IFS=$'\t' read -r pct avail mnt _ _ _ _ roles; do
    [ -n "$mnt" ] || continue
    cells+=("$(paint "$(disk_color "$pct")" "$(disk_cell "$pct" "$avail" "$mnt" "$roles")")")
  done <<<"${HOST[disks]}"
  if [ "${#cells[@]}" -gt 0 ]; then
    out+=" — Disk: $(join_by ", " "${cells[@]}")"
  fi
  if [ "${HOST[events]}" = ok ]; then
    cells=()
    [ "${HOST[oom]}" -eq 0 ] || cells+=("${HOST[oom]} OOM kill$([ "${HOST[oom]}" -eq 1 ] || echo s)")
    [ "${HOST[disk_full]}" -eq 0 ] || cells+=("${HOST[disk_full]} disk-full")
    if [ "${#cells[@]}" -gt 0 ]; then
      out+=" — $(paint "$C_RED" "last $(fmt_dur "$EVENTS_SEC"): $(join_by ", " "${cells[@]}")")"
    fi
  fi
  printf '%s\n' "$out"
}

# The `health` problems the host facts carry, one per line. Reads HOST.
#
# GHR-100: the OOM-killed process's name and the disk-full line's syslog
# identifier are text a process chose. Measured with systemd 262, `journalctl
# -o short-unix` (no --all) does not hand back a control byte for either — an
# unprintable identifier falls back to the process's comm, printed with `\033`
# as text, and an unprintable message becomes `[N blob data]`. The kernel's
# OOM line was not measured (that needs an OOM kill). Neither is a promise
# about every journalctl a host runs, so both are drawn through relay_safe
# anyway; HOST and --json keep them as they were read.
#
# GHR-80: each line is `KIND<TAB>TEXT` — `disk`, `oom` or `disk-full`, then
# what `health` prints after `host: ` — so `health --json` takes the kind
# from where the problem is found rather than from its wording.
host_problems() {
  local pct avail mnt roles proc src
  while IFS=$'\t' read -r pct avail mnt _ _ _ _ roles; do
    [ -n "$mnt" ] || continue
    [ "$(disk_level "$pct")" = crit ] || continue
    printf 'disk\t%s\n' "$mnt${roles:+ [$roles]} is $pct% full ($(hbytes "$avail") free, DISK_CRIT_PCT=$DISK_CRIT_PCT)"
  done <<<"${HOST[disks]}"
  [ "${HOST[events]}" = ok ] || return 0
  relay_safe "${HOST[last_oom_proc]}" plain; proc="$RELAY_SAFE"
  relay_safe "${HOST[last_disk_full_src]}" plain; src="$RELAY_SAFE"
  if [ "${HOST[oom]}" -gt 0 ]; then
    printf 'oom\t%s\n' "the kernel OOM-killed ${HOST[oom]} process(es) host-wide in the last $(fmt_dur "$EVENTS_SEC")${proc:+ (last: $proc)} — 'journalctl -k -g \"Out of memory\"' shows them"
  fi
  if [ "${HOST[disk_full]}" -gt 0 ]; then
    printf 'disk-full\t%s\n' "${HOST[disk_full]} 'No space left on device' line(s) in the journal in the last $(fmt_dur "$EVENTS_SEC")${src:+ (last from $src)}"
  fi
}

# --json's "disks":[...] array. Reads HOST.
host_disks_json() {
  local pct avail mnt dev fs size used roles r rsep jroles sep="" out="["
  while IFS=$'\t' read -r pct avail mnt dev fs size used roles; do
    [ -n "$mnt" ] || continue
    jroles="[" rsep=""
    while IFS= read -r -d, r; do
      jroles+="$rsep$(json_str "$r")"; rsep=","
    done <<<"${roles:+$roles,}"
    jroles+="]"
    out+="$sep{\"mount\":$(json_str "$mnt"),\"device\":$(json_str "$dev"),\"fstype\":$(json_strn "$fs"),\"size\":$(json_num "$size"),\"used\":$(json_num "$used"),\"avail\":$(json_num "$avail"),\"use_pct\":$(json_num "$pct"),\"roles\":$jroles}"
    sep=","
  done <<<"${HOST[disks]}"
  printf '%s]\n' "$out"
}

# --json's "load":[1m,5m,15m] (GHR-79) as /proc/loadavg wrote them, null
# when it could not be read. Reads HOST.
host_load_json() {
  if [ -n "${HOST[load1]:-}" ]; then
    printf '[%s,%s,%s]\n' "$(json_dec "${HOST[load1]}")" "$(json_dec "${HOST[load5]:-}")" "$(json_dec "${HOST[load15]:-}")"
  else
    echo null
  fi
}

# --json's "events":{...}, null when the journal could not be read or the
# search is off. Reads HOST.
host_events_json() {
  [ "${HOST[events]}" = ok ] || { echo null; return; }
  printf '{"window":%s,"oom_kills":%s,"cgroup_oom_kills":%s,"disk_full":%s,"last_oom":%s,"last_oom_process":%s,"last_disk_full":%s,"last_disk_full_source":%s}\n' \
    "$(json_num "$EVENTS_SEC")" "$(json_num "${HOST[oom]}")" "$(json_num "${HOST[cgroup_oom]}")" \
    "$(json_num "${HOST[disk_full]}")" "$(json_num "${HOST[last_oom]}")" "$(json_strn "${HOST[last_oom_proc]}")" \
    "$(json_num "${HOST[last_disk_full]}")" "$(json_strn "${HOST[last_disk_full_src]}")"
}

# `status --json`: the same SLOT facts as raw bytes, epoch seconds and null
# — formatting is the consumer's job. The top-level object carries
# `runnerctl` (the version of the script that produced it, GHR-32) and
# `host`. One object per slot, keys stable:
#   idx unit name active sub enabled memory_max memory_high memory_current
#   memory_peak restart env_file since restarts result last_restart_reason
#   profile job idle_since jobs_completed working_on_access
# `job` is {"repo","name","since","stalled"} while a job is in flight (repo,
# name and since null when unknown; `stalled` true/false against STALL_SEC,
# null when the runtime is unknown — GHR-27), null when idle or not running.
# After those four it carries the run (GHR-78), each null when unknown:
# `workflow`, `run_id`, `run_attempt`, `run_number`, `ref`, `sha`, `actor`,
# `event` and `url`, the run's page —
# <server>/<owner>/<name>/actions/runs/<run_id>[/attempts/<run_attempt>].
# The three ids are numbers; job_env_facts says what each value has to be to
# be reported at all, and a value that fails is null, never a best guess.
# `idle_since` and
# `jobs_completed` are set while the slot is idle with a readable journal
# (`jobs_completed` 0 when nothing has finished since the unit started);
# `working_on_access` is "ok", "no-journal" (only /proc could be read) or
# "no-access" — the note under the table, per slot; `leaked_procs` is the
# count of processes a finished job left in an idle slot's cgroup, null
# while busy or when the cgroup cannot be read (GHR-29); `memory_events`
# is {"high","max","oom_kill"} from the cgroup's memory.events and
# `memory_pressure` {"full_avg10","full_avg60","full_total"} from its
# memory.pressure, each object null when nothing could be read (GHR-31).
# After `profile`, before `job` (GHR-79): `cpu_usage_usec`, cpu.stat's cumulative
# usage_usec (null with CPU accounting off — never 0), `cpu_usage_at_us` and
# `invocation_id` (GHR-115: when it was read, and the run it is of), and `cpu_pressure`
# {"some_avg10","some_avg60","some_total"} from cpu.pressure, null likewise.
# `host` carries `name` (the host's own hostname, null when it cannot be
# read — GHR-38) alongside `cores`, `mem_total`, `mem_available` and `load`
# ([1m, 5m, 15m] from /proc/loadavg, null when unreadable — GHR-79).
# `host.sudo_contract` (GHR-113), the LAST key of `host`: "narrow" or "full",
# the value sudo_contract_of_default reads, or null when this host cannot say
# (see host_sudo_contract). A host from before the key has none at all.
# Unlike the table, this never dies on a host with no runner units: it
# prints `"slots": []` and exits 0 (GHR-38).
render_status_json() {
  # No require_runners here, unlike render_status (GHR-38). A host with no
  # runner units is a well-formed `"slots": []` object and exit 0, not a die:
  # a fleet member drained to zero slots, or inventoried before its runners
  # are installed, is a legitimate state, and aborting makes it indistinguish-
  # able from an ssh failure — two very different things to be paged about.
  # The table path keeps dying, because an operator who typed `status` on the
  # wrong box should be told so.
  local cores mem_total mem_avail i=0 u sep=""
  read -r cores mem_total mem_avail < <(host_facts) || true
  collect_host
  status_json_head "$cores" "$mem_total" "$mem_avail"
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$i"
    status_json_slot "$sep" "$i" "$u"
    sep=","
    i=$((i+1))
  done < <(discover)
  printf '\n]}\n'
}

# The object's opening, up to and including `"slots":[` with no newline after
# it: host_facts' three numbers (CORES MEM-TOTAL MEM-AVAIL) and collect_host's
# globals, which the caller has already filled.
status_json_head() { # CORES MEM-TOTAL MEM-AVAIL
  printf '{"runnerctl":%s,"host":{"name":%s,"cores":%s,"mem_total":%s,"mem_available":%s,"load":%s,"disks":%s,"events":%s,"sudo_contract":%s},\n "slots":[' \
    "$(json_str "$RUNNERCTL_VERSION")" "$(json_strn "$(host_name)")" \
    "$(json_num "$1")" "$(json_num "$2")" "$(json_num "$3")" \
    "$(host_load_json)" "$(host_disks_json)" "$(host_events_json)" "$(json_strn "$(host_sudo_contract)")"
}

# One slot of the object, from SLOT as collect_slot left it (GHR-90: split out
# so `status --with-json` formats the slots its table collected): SEP — `,`
# for every slot but the first — a newline, then the slot on a line of its
# own with no newline after it. One slot per line is what every reader of the
# payload relies on (json_line_get).
status_json_slot() { # SEP IDX UNIT
  local i="$2" u="$3" job idle_since completed
    case "${SLOT[job_state]}" in
      running|starting)
        # GHR-78: the run's keys are APPENDED, after `stalled`. The slot line
        # is read back by this script (fleet_slot_classify, fleet_watch_facts
        # and the rest take the first occurrence of a key, json_line_get), so
        # the four keys they read stay first and in their order; and every
        # value below is either a string through json_str or a number
        # job_env_facts already held to digits, so nothing a job supplied can
        # close the object or start a key of its own.
        job="{\"repo\":$(json_strn "${SLOT[job_repo]}"),\"name\":$(json_strn "${SLOT[job_name]}"),\"since\":$(json_num "${SLOT[job_since]}"),\"stalled\":$(json_bool "${SLOT[job_stalled]}")"
        job+=",\"workflow\":$(json_strn "${SLOT[job_workflow]}"),\"run_id\":$(json_num "${SLOT[job_run_id]}"),\"run_attempt\":$(json_num "${SLOT[job_run_attempt]}"),\"run_number\":$(json_num "${SLOT[job_run_number]}")"
        job+=",\"ref\":$(json_strn "${SLOT[job_ref]}"),\"sha\":$(json_strn "${SLOT[job_sha]}"),\"actor\":$(json_strn "${SLOT[job_actor]}"),\"event\":$(json_strn "${SLOT[job_event]}"),\"url\":$(json_strn "${SLOT[job_url]}")}" ;;
      *) job=null ;;
    esac
    case "${SLOT[job_state]}" in
      idle|idle-fresh) idle_since="$(json_num "${SLOT[job_idle_since]}")"; completed="$(json_num "${SLOT[job_done]}")" ;;
      *)               idle_since=null; completed=null ;;
    esac
    printf '%s\n  {"idx":%s,"unit":%s,"name":%s,"active":%s,"sub":%s,"enabled":%s' \
      "$1" "$i" "$(json_str "$u")" "$(json_str "${SLOT[name]}")" \
      "$(json_strn "${SLOT[active]}")" "$(json_strn "${SLOT[sub]}")" "$(json_strn "${SLOT[enabled]}")"
    printf ',"memory_max":%s,"memory_high":%s,"memory_current":%s,"memory_peak":%s' \
      "$(json_bytes "${SLOT[memory_max]}")" "$(json_bytes "${SLOT[memory_high]}")" \
      "$(json_bytes "${SLOT[memory_current]}")" "$(json_bytes "${SLOT[memory_peak]}")"
    printf ',"restart":%s,"env_file":%s,"since":%s,"restarts":%s,"result":%s,"last_restart_reason":%s,"profile":%s' \
      "$(json_strn "${SLOT[restart]}")" "$(json_strn "${SLOT[env_file]}")" \
      "$(json_num "$(age_to_epoch "${SLOT[since_age]}")")" "$(json_num "${SLOT[restarts]}")" \
      "$(json_strn "${SLOT[result]}")" "$(json_strn "${SLOT[last_restart_reason]}")" "$(json_strn "${SLOT[profile]}")"
    # GHR-79: between `profile` and `job`, where nothing that reads the slot
    # line depends on what is next to what — and BEFORE the job object, so a
    # job's own text (a workflow called `"cpu_usage_usec":1`) is never the
    # first occurrence json_line_get finds. Cumulative and unsampled: --json
    # never waits, a poller computes its own rate from two payloads.
    printf ',"cpu_usage_usec":%s' "$(json_num "${SLOT[cpu_usage]}")"
    # GHR-115: the instant that counter was read (this host's clock, epoch
    # µs; null with the counter) and the run it belongs to, so a reader of
    # two payloads can tell a rate from a restart — `fleet watch` hands both
    # back on its next tick (status_cpu_prev) instead of the host waiting.
    printf ',"cpu_usage_at_us":%s,"invocation_id":%s' \
      "$(if [ -n "${SLOT[cpu_usage]}" ]; then json_num "${SLOT[cpu_us]}"; else echo null; fi)" \
      "$(json_strn "${SLOT[invocation]}")"
    if [ -n "${SLOT[cpu_pressure_some_avg10]}${SLOT[cpu_pressure_some_avg60]}${SLOT[cpu_pressure_some_total]}" ]; then
      printf ',"cpu_pressure":{"some_avg10":%s,"some_avg60":%s,"some_total":%s}' \
        "$(json_dec "${SLOT[cpu_pressure_some_avg10]}")" "$(json_dec "${SLOT[cpu_pressure_some_avg60]}")" "$(json_num "${SLOT[cpu_pressure_some_total]}")"
    else
      printf ',"cpu_pressure":null'
    fi
    printf ',"job":%s,"idle_since":%s,"jobs_completed":%s,"working_on_access":%s,"leaked_procs":%s' \
      "$job" "$idle_since" "$completed" "$(json_str "${SLOT[job_access]}")" "$(json_num "${SLOT[job_leaked]}")"
    if [ -n "${SLOT[mem_events_high]}${SLOT[mem_events_max]}${SLOT[mem_events_oom_kill]}" ]; then
      printf ',"memory_events":{"high":%s,"max":%s,"oom_kill":%s}' \
        "$(json_num "${SLOT[mem_events_high]}")" "$(json_num "${SLOT[mem_events_max]}")" "$(json_num "${SLOT[mem_events_oom_kill]}")"
    else
      printf ',"memory_events":null'
    fi
    if [ -n "${SLOT[mem_pressure_full_avg10]}${SLOT[mem_pressure_full_avg60]}${SLOT[mem_pressure_full_total]}" ]; then
      printf ',"memory_pressure":{"full_avg10":%s,"full_avg60":%s,"full_total":%s}}' \
        "$(json_dec "${SLOT[mem_pressure_full_avg10]}")" "$(json_dec "${SLOT[mem_pressure_full_avg60]}")" "$(json_num "${SLOT[mem_pressure_full_total]}")"
    else
      printf ',"memory_pressure":null}'
    fi
}

cmd_apply() {
  extract_profile "$@"; load_profile; parse_opts ${REMAINING[@]+"${REMAINING[@]}"}
  if $when_idle && ! $do_restart; then
    die "--when-idle only applies to the restart: use 'apply --restart --when-idle' (apply alone just writes drop-ins)"
  fi
  require_runners; guard_env_file
  ! $do_save || save_write_as "$CONFIG_FILE"
  local units=() u t short_list=""
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for t in "${TARGETS[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  audit_begin apply "--profile $PROFILE" "$($do_restart && echo --restart)" "$($when_idle && echo --when-idle)" "$($do_save && echo --save)"
  audit_slots "${#TARGETS[@]}" "${units[@]}"
  caller_guard
  for u in "${units[@]}"; do apply_to "$u"; echo "  wrote drop-in for $u"; done
  hb_systemctl daemon-reload
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for u in "${units[@]}"; do
      t="${u#actions.runner.}"; t="${t%.service}"
      short_list+="${short_list:+, }$t"
    done
    echo "Applied profile '$PROFILE' to ${#units[@]} slot(s): $short_list"
  else
    echo "Applied profile '$PROFILE': Restart=always RestartSec=$RESTART_SEC OOMPolicy=continue${MEM_MAX:+ MemoryMax=$MEM_MAX MemoryHigh=$MEM_HIGH MemorySwapMax=0}${ENV_FILE:+ EnvironmentFile=$ENV_FILE}"
  fi
  if $do_save; then save_profile apply; fi
  if $do_restart; then
    local i
    for i in "${!units[@]}"; do
      u="${units[$i]}"
      idle_gate "$u" restarted "${units[*]:0:$i}" "${units[*]:$((i+1))}"
      hb_systemctl restart "$u"
    done
    if [ "${#TARGETS[@]}" -gt 0 ]; then
      echo "Restarted ${#units[@]} slot(s) (config active now)."
    else
      echo "Restarted all runner slots (config active now)."
    fi
  else
    echo "Config takes effect on next (re)start. Run: runnerctl restart"
  fi
}

cmd_scale() {
  extract_profile "$@"
  set -- ${REMAINING[@]+"${REMAINING[@]}"}
  [ $# -ge 1 ] || die "scale needs N, e.g. 'scale 2 --max 26G'"
  local n="$1"; shift
  [[ "$n" =~ ^[0-9]+$ ]] || die "N must be an integer"
  load_profile; parse_opts "$@"
  [ "${#TARGETS[@]}" -eq 0 ] || die "unexpected argument: ${TARGETS[*]}"
  require_runners; guard_env_file
  ! $do_save || save_write_as "$CONFIG_FILE"
  mapfile -t units < <(discover)
  local total=${#units[@]}
  { [ "$n" -ge 1 ] && [ "$n" -le "$total" ]; } || die "N must be 1..$total"
  audit_begin scale "to $n of $total" "--profile $PROFILE" "$($do_restart && echo --restart)" "$($when_idle && echo --when-idle)" "$($do_save && echo --save)"
  caller_guard
  local i u
  # Write every drop-in that will be needed, THEN reload, THEN start/stop —
  # otherwise the first `enable --now` on a stopped slot races systemd's own
  # unread unit cache and starts with the previous config (GHR-5).
  for i in "${!units[@]}"; do
    [ "$i" -lt "$n" ] && apply_to "${units[$i]}"
  done
  hb_systemctl daemon-reload
  local rc failed=()
  for i in "${!units[@]}"; do
    u="${units[$i]}"
    if [ "$i" -lt "$n" ]; then
      rc=0; hb_systemctl enable --now "$u" || rc=$?
      if [ "$rc" -eq 0 ]; then echo "  [active] $u"; else echo "  [FAILED] $u"; failed+=("$u"); fi
    else
      # --when-idle: a slot leaving the pool is stopped only once its job is
      # done (the ones staying are enabled regardless — that never kills a job).
      idle_gate "$u" stopped "${units[*]:$n:$((i - n))}" "${units[*]:$((i + 1))}"
      rc=0; hb_systemctl disable --now "$u" || rc=$?
      if [ "$rc" -eq 0 ]; then echo "  [stopped] $u"; else echo "  [FAILED] $u"; failed+=("$u"); fi
    fi
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "runnerctl: scale: ${#failed[@]} of $n slot(s) failed to start/stop: ${failed[*]}" >&2
    exit 1
  fi
  echo "Scaled to $n active runner(s), profile '$PROFILE'${MEM_MAX:+ @ MemoryMax=$MEM_MAX}."
  echo "Note: stopped slots stay REGISTERED with GitHub (they show offline). To"
  echo "remove one for good (deregister, uninstall the unit, delete its directory):"
  echo "'runnerctl deprovision <slot>' — destructive and irreversible."
  if $do_save; then save_profile scale; fi
  if $do_restart; then
    for i in "${!units[@]}"; do
      [ "$i" -lt "$n" ] || break
      idle_gate "${units[$i]}" restarted "${units[*]:0:$i}" "${units[*]:$((i + 1)):$((n - i - 1))}"
      hb_systemctl restart "${units[$i]}"
    done
    echo "Restarted $n active slot(s) (config active now)."
  else
    echo "Config takes effect on next (re)start of already-running slots. Run: runnerctl restart"
  fi
}

cmd_env_init() {
  extract_profile "$@"; load_profile; parse_opts ${REMAINING[@]+"${REMAINING[@]}"}
  [ -n "$ENV_FILE" ] || die "profile '$PROFILE' defines no EnvironmentFile (nothing to init)"
  if run_priv test -f "$ENV_FILE"; then
    echo "$ENV_FILE already exists — leaving it untouched (won't clobber secrets)."
    return 0
  fi
  audit_begin env-init "$ENV_FILE" "--profile $PROFILE"
  # GHR-137: a hangup between the tee and the chmod would leave the file at
  # the default mode, and every later env-init leaves an existing file alone.
  caller_guard
  run_priv mkdir -p -m 755 "$(dirname "$ENV_FILE")"
  render_env_template | run_priv tee "$ENV_FILE" >/dev/null
  run_priv chown root:root "$ENV_FILE"
  run_priv chmod 600 "$ENV_FILE"
  echo "Scaffolded $ENV_FILE (root:root, 600)."
  echo "Edit it ON THE BOX and fill in real values. NEVER commit real secrets."
}

cmd_ctl() { # start|stop|restart [--when-idle] [--timeout N] [--if-stalled] [--stall-after N] [target ...] (default: all)
  local action="$1"; shift || true
  local targets=() units=() u t i verb if_stalled=false acted=0
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --when-idle)   when_idle=true; shift ;;
      --timeout)     need_val "$@"; set_timeout "$2"; shift 2 ;;
      --if-stalled)  if_stalled=true; shift ;;
      --stall-after) need_val "$@"; set_stall_after "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             targets+=("$1"); shift ;;
    esac
  done
  # Waiting for idle before a start is meaningless; accept the flag quietly.
  [ "$action" != start ] || when_idle=false
  if $if_stalled; then
    [ "$action" != start ] || die "--if-stalled only applies to stop and restart"
    ! $when_idle || die "--if-stalled and --when-idle are exclusive: one acts on a wedged slot, the other waits for an idle one"
    [ "$STALL_SEC" -gt 0 ] || die "--if-stalled needs a threshold: STALL_SEC is 0 (pass --stall-after N)"
  fi
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      # Resolve on its own line: a die inside "$(...)" only exits the subshell.
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  case "$action" in stop) verb=stopped ;; *) verb="${action}ed" ;; esac
  # The record (GHR-88): `drain` is recorded as itself. --if-stalled runs from
  # cron, so it arms only for a slot it actually takes, and names those.
  if ! $if_stalled; then
    audit_begin "${AUDIT_AS:-$action}" "$($when_idle && [ -z "$AUDIT_AS" ] && echo --when-idle)"
    audit_slots "${#targets[@]}" "${units[@]}"
    caller_guard
  fi
  for i in "${!units[@]}"; do
    u="${units[$i]}"
    if $if_stalled; then
      stalled_gate "$u" "${verb%ed}ing" || continue
      acted=$((acted + 1))
      audit_begin "$action" --if-stalled "$(short_name "$u")"
      caller_guard
    else
      idle_gate "$u" "$verb" "${units[*]:0:$i}" "${units[*]:$((i + 1))}"
    fi
    hb_systemctl "$action" "$u"
  done
  if $if_stalled && [ "$acted" -eq 0 ]; then
    echo "no stalled slot — nothing $verb."
  elif $if_stalled; then
    echo "$action done ($acted stalled slot(s))."
  else
    echo "$action done."
  fi
}

cmd_toggle() { # enable|disable <target> [target ...]
  local action="$1"; shift || true
  [ $# -ge 1 ] || die "$action needs a <unit|slot-index|name>"
  local units=() u t
  # Resolve every target before acting on any (GHR-134): a bad later target
  # changes nothing. Resolve on its own line: a die inside "$(...)" only exits
  # the subshell.
  for t in "$@"; do
    case "$t" in -*) die "unknown option: $t" ;; esac
    u="$(resolve "$t")"
    units+=("$u")
  done
  audit_begin "$action"
  audit_slots "${#units[@]}" "${units[@]}"
  caller_guard # GHR-137
  for u in "${units[@]}"; do
    hb_systemctl "$action" --now "$u"
  done
  echo "$action done."
}

cmd_logs() {
  require_runners
  local target="" follow=false n="" since="" grep_pat="" have_target=false u
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      -f|--follow) follow=true; shift ;;
      -n|--lines)  need_val "$@"; [[ "$2" =~ ^[0-9]+$ ]] || die "-n value '$2' is invalid — want an integer"; n="$2"; shift 2 ;;
      --since)     need_val "$@"; since="$2"; shift 2 ;;
      -g|--grep)   need_val "$@"; grep_pat="$2"; shift 2 ;;
      -*)          die "unknown option: $1" ;;
      *)           $have_target && die "unknown option: $1"; target="$1"; have_target=true; shift ;;
    esac
  done

  local jargs=()
  if [ -n "$target" ]; then
    u="$(resolve "$target")"
    jargs+=(-u "$u")
  else
    while read -r u; do [ -n "$u" ] && jargs+=(-u "$u"); done < <(discover)
  fi
  if [ -n "$n" ]; then
    jargs+=(-n "$n")
  elif $follow; then
    jargs+=(-n 50)
  else
    jargs+=(-n 100)
  fi
  $follow && jargs+=(-f)
  [ -n "$since" ] && jargs+=(--since "$since")
  [ -n "$grep_pat" ] && jargs+=(-g "$grep_pat")
  jargs+=(--no-pager)

  run_priv journalctl "${jargs[@]}"
}

# --- Live view (GHR-3) --------------------------------------------------------
# `status` prints the table once; `status --watch|-w` and `watch` redraw it
# in place every --interval seconds (default 2) until Ctrl-C. --once turns a
# watch back into a single print; the last of --watch/--once wins. --json
# (GHR-16) prints the same facts as one JSON object instead of the table; it
# is a one-shot format, so it refuses --watch rather than streaming frames.
# --color and --stall-after (GHR-27) are parsed here for both shapes.
cmd_status() { # [--json | --with-json] [--watch|-w] [--once] [--interval N] [--color WHEN] [--stall-after N] [--narrow] [--cpu-prev=SPEC]
  local watch=false json=false narrow=false with_json=false args=() cpu_prev="" has_prev=false
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then shift "$VIEW_SHIFT"; continue; fi
    case "$1" in
      --watch|-w) watch=true; shift ;;
      --once)     watch=false; shift ;;
      --json)     json=true; shift ;;
      --narrow)   narrow=true; shift ;;
      # GHR-90: the table AND the JSON from one collection (render_status).
      --with-json) with_json=true; shift ;;
      # GHR-115: CPU samples from this host's previous payload (fleet watch).
      --cpu-prev) [ $# -ge 2 ] || die "--cpu-prev needs a value"; cpu_prev="$2"; has_prev=true; shift 2 ;;
      *)          args+=("$1"); shift ;;
    esac
  done
  # --narrow is a table shape; JSON has no columns to drop, and accepting it
  # there would be a flag that silently does nothing.
  ! { $json && $narrow; } || die "--narrow cannot be combined with --json; the JSON object has no columns to drop"
  ! { $json && $with_json; } || die "--with-json cannot be combined with --json; --with-json prints the table and then the same object"
  # GHR-115: --json never samples twice, and a watch keeps its own last tick.
  ! { $json && $has_prev; } || die "--cpu-prev cannot be combined with --json; the object never waits for a second sample"
  if $watch; then
    ! $json || die "--json cannot be combined with --watch; poll 'runnerctl status --json' instead"
    ! $with_json || die "--with-json cannot be combined with --watch; it is a one-shot form for a program reading both"
    ! $has_prev || die "--cpu-prev cannot be combined with --watch; a watch takes its previous tick as the first sample"
    ! $narrow || args+=(--narrow)
    cmd_watch ${args[@]+"${args[@]}"}
  else
    [ "${#args[@]}" -eq 0 ] || die "unknown option: ${args[0]}"
    ! $narrow || status_narrow
    if $json; then
      render_status_json
    else
      color_setup "$COLOR_MODE"
      # GHR-78: only a table going to a terminal may use its width.
      if stdout_is_tty; then STATUS_COLS="$(term_cols)"; fi
      STATUS_WITH_JSON="$with_json"
      status_cpu_prev "$cpu_prev"
      render_status
    fi
  fi
}

# Is stdout a terminal? Behind a function so a test config can shadow it.
stdout_is_tty() { [ -t 1 ]; }

# Hide/show the cursor through tput where it exists; silent where it does
# not (minimal hosts, no TERM). Behind a function so a test config can
# shadow it — tput writes its escape codes to stdout.
term_cursor() { # hide|show
  command -v tput >/dev/null 2>&1 || return 0
  case "$1" in hide) tput civis ;; show) tput cnorm ;; esac 2>/dev/null || true
}

# The terminal's width in columns, 0 when unknown (no tput, no TERM). Behind
# a function so a test config can pin it.
term_cols() {
  local c=""
  if command -v tput >/dev/null 2>&1; then c="$(tput cols 2>/dev/null || true)"; fi
  if [[ "$c" =~ ^[0-9]+$ ]]; then echo "$c"; else echo 0; fi
}
# The terminal's height in rows, 0 when unknown — term_cols' twin, with the
# same tput fallback, and behind a function for the same reason (GHR-73).
term_lines() {
  local l=""
  if command -v tput >/dev/null 2>&1; then l="$(tput lines 2>/dev/null || true)"; fi
  if [[ "$l" =~ ^[0-9]+$ ]]; then echo "$l"; else echo 0; fi
}

# --- Interactive watch (GHR-33) -----------------------------------------------
# One keystroke from the terminal into KEY_CHAR (empty for Enter): 0 with a
# key, 1 when TIMEOUT seconds passed without one. `read -n1` puts the tty in
# non-canonical, no-echo mode for the duration of the read only and restores
# it after, so between two reads the terminal is normal: an action (and the
# sudo prompt run_priv may raise) runs outside any read and needs no raw-mode
# bookkeeping. Without a terminal on stdin the loop is view-only and this is
# a plain `pause`, so a closed or redirected stdin cannot spin the redraw.
# Behind a function so a test config can feed keys (RUNNERCTL_STUB_KEYS).
tty_read_char() { # TIMEOUT
  local rc=0
  KEY_CHAR=""
  if [ -t 0 ]; then
    IFS= read -rsn1 -t "$1" KEY_CHAR || rc=$?
    [ "$rc" -ne 0 ] || return 0
    [ "$rc" -le 128 ] || return 1 # timed out: the interval has elapsed
  fi
  pause "$1"
  return 1
}
# One LINE from the terminal into LINE_TEXT (GHR-86: `fleet watch`'s `:`
# prompt), with readline's editing — `read -e`, between two key reads, so the
# terminal is in its normal mode as it is for a sudo prompt. HISTORY... are the
# lines entered earlier in the session, oldest first: ↑ ↓ walk them. Shell
# history is on for the read alone and holds those lines alone (nothing is
# read from or written to a history file). A lone Escape empties the line and
# ends it, which the caller reads as "cancelled": in readline Escape is the
# Meta prefix, so it is bound for this read through an INPUTRC of its own —
# the arrows' sequences still arrive whole, readline telling the two apart by
# its key-sequence timeout. 1 on end of input (Ctrl-D) or without a terminal.
# Behind a function so a test config can feed lines, as tty_read_char is.
tty_read_line() { # PROMPT [HISTORY...]
  local prompt="$1" rc=0 h rc_file="${FW_TMP:-${TMPDIR:-/tmp}}/inputrc"
  local INPUTRC HISTFILE=""
  shift
  LINE_TEXT=""
  [ -t 0 ] || return 1
  # Readline reads INPUTRC when it first starts, so the binding goes in before
  # the first read; the user's own file is included first, ours wins.
  {
    [ ! -r "$HOME/.inputrc" ] || printf "\$include %s\\n" "$HOME/.inputrc"
    printf '"\\e": "\\C-a\\C-k\\C-m"\n'
  } >"$rc_file"
  INPUTRC="$rc_file"
  set -o history
  history -c
  for h in "$@"; do history -s -- "$h"; done
  printf '\r\033[K' >&2
  IFS= read -e -r -p "$prompt" LINE_TEXT || rc=$?
  history -c
  set +o history
  return "$rc"
}
# One key into KEY: `up` / `down` for the arrows (ESC [ A, ESC O A, …), `pgup`
# / `pgdn` / `home` / `end` for the paging keys (GHR-73: ESC [ 5 ~, ESC [ 6 ~,
# ESC [ H or 1 ~ or 7 ~, ESC [ F or 4 ~ or 8 ~), `esc` for a lone Escape,
# `enter`, otherwise the character itself. 1 on timeout.
# The rest of an arrow's sequence is already buffered when the ESC arrives,
# so a short second read tells the two apart. A numbered sequence ends in a
# `~`, which is read here too — left in the buffer it would arrive as a key
# of its own on the next read.
read_key() { # TIMEOUT
  local code
  KEY=""
  tty_read_char "$1" || return 1
  case "$KEY_CHAR" in
    $'\e')
      if tty_read_char 0.05 && [[ "$KEY_CHAR" == [\[O] ]] && tty_read_char 0.05; then
        case "$KEY_CHAR" in
          A) KEY=up ;;
          B) KEY=down ;;
          H) KEY=home ;;
          F) KEY=end ;;
          [0-9])
            code="$KEY_CHAR" KEY=other
            if tty_read_char 0.05 && [ "$KEY_CHAR" = "~" ]; then
              case "$code" in 5) KEY=pgup ;; 6) KEY=pgdn ;; 1|7) KEY=home ;; 4|8) KEY=end ;; esac
            fi ;;
          *) KEY=other ;;
        esac
      else
        KEY=esc
      fi ;;
    "") KEY=enter ;;
    *)  KEY="$KEY_CHAR" ;;
  esac
}
# A pager for `L` (logs): $PAGER, less, or cat where neither exists. Behind
# a function so a test config can replace it.
page() {
  local pager
  read -ra pager <<<"${PAGER:-less}"
  if command -v "${pager[0]}" >/dev/null 2>&1; then "${pager[@]}"; else cat; fi
}
# GHR-105: one line for both watches (fleet watch's is GHR-98's). It names `?`
# and not Enter, O or h: the list behind `?` holds every key, and 80 columns
# hold no more than this. fleet watch builds its legends from the same head.
WATCH_LEGEND_HEAD="↑↓/jk select  K kill  R restart  S stop  T start  P reap  L logs"
WATCH_LEGEND="$WATCH_LEGEND_HEAD  ? keys  q quit"
# GHR-105: the keys the local watch reads, where the table was, until a key.
# Nine lines, so with the header and the foot it fits 24 rows; none is
# wider than 80 columns.
WATCH_HELP="watch — keys
  ↑ ↓ j k   PgUp PgDn   g G Home End   move the cursor: a row, a page, the ends
  Enter   the cursor's slot in full, in place of the table. There q Esc Enter
          go back, h shows the host alone, ↑ ↓ PgUp PgDn scroll, K R S T P L O
          act on the slot
  K R S T P L   kill job, restart, stop, start, reap, logs; each asks to confirm
  O     print the run URL of the cursor's job — nothing is opened
  q ?   quit, this list; any key but ↑ ↓ PgUp PgDn g G closes it (and is spent)"
WATCH_HELP_ON=false
# GHR-99: under either list. The keys scroll it where the terminal cuts it —
# the window is VIEW_TOP, as in a pane — and every other key closes it.
HELP_FOOT="scroll: ↑ ↓ PgUp PgDn g G · any other key closes this list"

# The cursor row: reverse video over the whole line, re-applied after every
# reset a painted cell ends with, so a coloured cell does not cut it short.
# Always an SGR sequence, whatever --color says: watch needs a terminal and
# the cursor is structure, not colour. NAME is the RUNNER cell (short_name).
watch_highlight() { # TABLE NAME
  local line rev=$'\e[7m' reset=$'\e[0m'
  while IFS= read -r line; do
    if [[ "$line" =~ ^[0-9]+\ +"$2"\ + ]]; then
      printf '%s%s%s\n' "$rev" "${line//"$reset"/$reset$rev}" "$reset"
    else
      printf '%s\n' "$line"
    fi
  done <<<"$1"
}
# The widest table row (header or slot row) in TABLE, in display columns (GHR-94) with the
# SGR sequences stripped — the note lines are long by design and do not count.
# PREFIX is a regex for what comes before the IDX cell: nothing for the local
# table, the HOST cell for the fleet one (GHR-56) — whose error rows (`build-3
# unreachable — …`) are long by design too, and are not narrowed by dropping
# a column, so they must not count either.
watch_table_width() { # TABLE [PREFIX-RE]
  local line n w=0 re="^${2:-}(IDX|[0-9]+) "
  while IFS= read -r line; do
    strip_sgr "$line"; n="$SGR_STRIPPED"
    [[ "$n" != note:* ]] || continue
    [[ "$n" =~ $re ]] || continue
    display_width "$n"
    [ "$DISPLAY_WIDTH" -le "$w" ] || w="$DISPLAY_WIDTH"
  done <<<"$1"
  echo "$w"
}
# Whether a table of WIDTH should be narrow on a terminal of COLS, given
# whether it is narrow now (true/false): too wide narrows it, and it only
# widens again once the wide table would fit — the narrow width plus what
# narrowing gave back (STATUS_NARROW_GAVE, measured by narrow_gave at the
# transition; the fallback until then) — with STATUS_NARROW_MARGIN columns to
# spare. The local watch and `fleet watch` both decide through this, so the
# two cannot disagree about when a table flips. A width of 0 (unknown) never
# narrows.
narrow_wanted() { # NARROW-NOW WIDTH COLS
  [ "$3" -gt 0 ] || return 1
  if "$1"; then
    [ $(($2 + ${STATUS_NARROW_GAVE:-$STATUS_NARROW_GAVE_FALLBACK} + STATUS_NARROW_MARGIN)) -gt "$3" ]
  else
    [ "$2" -gt "$3" ]
  fi
}
# Record what narrowing gave back, from the wide table's width and the narrow
# one's. A difference of 0 or less is not a measurement — `fleet watch` can
# see one when a slow host still answers with its wide rows on the first
# narrow tick — and leaves the fallback standing for the next tick to try.
narrow_gave() { # WIDE-WIDTH NARROW-WIDTH
  [ "$1" -gt "$2" ] || return 0
  STATUS_NARROW_GAVE=$(($1 - $2))
}
# The table for one frame, into WATCH_TABLE (not stdout: STATUS_DROP has to
# outlive the call). Narrower than the terminal, or MAX/HIGH/ENVFILE are
# dropped (STATUS_DROP) and it is rendered again — once, on the transition,
# and back when the terminal is wide enough for all of them again. A width
# of 0 (unknown) never drops anything. WATCH_NARROW_FORCED (`watch
# --narrow`) pins the narrow table and skips the measuring.
WATCH_TABLE=""
WATCH_NARROW_FORCED=false
watch_table() {
  local now=false want=false w
  # GHR-78: the width is read once per frame, BEFORE the render, which draws
  # the long WORKING-ON cell by it; the narrow decision below reads the same
  # number, so the two cannot be taken on different sizes mid-resize.
  STATUS_COLS="$(term_cols)"
  WATCH_TABLE="$(render_status)"
  ! $WATCH_NARROW_FORCED || return 0
  [ -z "$STATUS_DROP" ] || now=true
  w="$(watch_table_width "$WATCH_TABLE")"
  if narrow_wanted "$now" "$w" "$STATUS_COLS"; then want=true; fi
  [ "$now" != "$want" ] || return 0
  status_narrow "$want"
  WATCH_TABLE="$(render_status)"
  # GHR-157: the wide and the narrow table of one frame, so the measurement
  # is exact here; `fleet watch` has to take it across two ticks.
  ! $want || narrow_gave "$w" "$(watch_table_width "$WATCH_TABLE")"
}

# --- Viewport (GHR-73) ----------------------------------------------------------
# A frame taller than the terminal used to scroll its own top off: the header
# and the first rows left the screen, and the cursor row could be one of them,
# so K/R/S/T acted on a slot nobody could see. Both watches now draw through
# viewport_draw, which fits the frame to term_lines:
#
#   * HEAD (the header; in `fleet watch` the summary line too) and FOOT (the
#     blank line, the legend, the status line) are fixed chrome and always
#     drawn. So are the BODY's lines down to its column header (`IDX …` /
#     `HOST IDX …`): a table without its header is a grid of unlabelled cells.
#   * What is left of the height is a WINDOW over the rest of the body's
#     lines. It moves only when it has to: the cursor line crossing an edge
#     scrolls it by as little as puts the line back in. Two lines travel with
#     the cursor where they fit — LEAD, the first line of its group (in `fleet
#     watch` the host's Disk/OOM line above a host's first slot, which the
#     cursor itself never stops on), and TAIL, the last (the notes under the
#     last row, which no cursor movement could otherwise bring into view).
#   * Hidden lines are counted on a dim marker line — `↑ 12 more` above,
#     `↓ 7 more` below — so a clipped frame never reads as the whole table.
#     The counts are FRAME LINES, host lines and notes included. The markers
#     name the paging keys; the legend does not, because it is on every frame
#     and a frame of unknown height has to stay what it was, byte for byte.
#   * Heights are in terminal ROWS, not lines: with the width known a line
#     longer than the terminal counts as the rows it wraps to — a confirm line
#     naming a command is routinely two — so the chrome is measured per frame
#     and the windowed frame is padded to exactly the terminal's height, the
#     legend and status line staying on its last rows.
#   * A fitted frame is written WITHOUT a final newline: on the last row a
#     newline scrolls the screen by one and takes the header with it.
#     viewport_close supplies it on the way out.
#
# Nothing is fitted — the frame is drawn whole and newline-terminated, exactly
# as before — when the height is unknown (0), when the chrome leaves fewer
# than VIEW_MIN_ROWS rows for the window (one line and two markers), or when
# the cursor line alone is taller than the window: a terminal that small
# cannot show a usable view, and a truncated one would hide the confirm line.
# `--iterations` (the headless test path) never comes through here at all.
VIEW_TOP=0 VIEW_PAGE=0 VIEW_STEP=1 VIEW_BOT=0 VIEW_ROWS=1 VIEW_OUT="" VIEW_FITTED=false
VIEW_MIN_ROWS=3
VIEW_END=1000000 # a TAIL past any frame: "down to the last line"
VIEW_LINE_ROWS=() VIEW_ARGS=()

# The rows LINE takes on a terminal COLS wide, into VIEW_ROWS (1 when the
# width is unknown). Leaves the line's visible text in SGR_STRIPPED.
viewport_rows() { # LINE COLS
  strip_sgr "$1"
  VIEW_ROWS=1
  [ "$2" -gt 0 ] || return 0
  display_width "$SGR_STRIPPED"
  [ "$DISPLAY_WIDTH" -le "$2" ] || VIEW_ROWS=$(((DISPLAY_WIDTH + $2 - 1) / $2))
}
# The last body line (0-based, into VIEW_BOT) a window starting at TOP reaches
# in AVAIL rows, of N lines whose scrolling part starts at FIRST. A marker row
# is paid for wherever lines stay hidden: above when TOP is past FIRST, below
# for as long as the line being added is not the last.
viewport_fill() { # TOP FIRST N AVAIL
  local used=0 next reserve
  [ "$1" -le "$2" ] || used=1
  VIEW_BOT=$(($1 - 1))
  while [ "$VIEW_BOT" -lt $(($3 - 1)) ]; do
    next=$((VIEW_BOT + 1)) reserve=1
    [ "$next" -lt $(($3 - 1)) ] || reserve=0
    [ $((used + VIEW_LINE_ROWS[next] + reserve)) -le "$4" ] || break
    used=$((used + VIEW_LINE_ROWS[next])) VIEW_BOT="$next"
  done
}
# The frame for a terminal HEIGHT rows by COLS columns, into VIEW_OUT (no
# final newline). CURSOR, LEAD and TAIL are 1-based BODY line numbers, CURSOR
# 0 when nothing is selected. VIEW_FITTED says whether the frame was fitted
# to the height; VIEW_PAGE is the window's size in lines, 0 when nothing is
# hidden; VIEW_TOP carries the window's position to the next frame.
viewport_frame() { # HEIGHT COLS HEAD BODY FOOT CURSOR LEAD TAIL
  local height="$1" cols="$2" cur=$(($6 - 1)) lead=$(($7 - 1)) tail=$(($8 - 1))
  local -a body=()
  local line i n pin=0 chrome=0 total=0 avail top bot used
  VIEW_OUT="$3"$'\n'"$4"$'\n'"$5" VIEW_PAGE=0 VIEW_FITTED=false
  # Unknown: the frame whole. The VIEW_MIN_ROWS test below would send a
  # height of 0 the same way — this is the exit that does not measure every
  # line of the frame first, on every redraw, to get there.
  [ "$height" -gt 0 ] || return 0
  while IFS= read -r line; do
    viewport_rows "$line" "$cols"
    chrome=$((chrome + VIEW_ROWS))
  done <<<"$3"$'\n'"$5"
  mapfile -t body <<<"$4"
  n="${#body[@]}"
  VIEW_LINE_ROWS=()
  for i in "${!body[@]}"; do
    viewport_rows "${body[$i]}" "$cols"
    VIEW_LINE_ROWS[i]="$VIEW_ROWS"
    total=$((total + VIEW_ROWS))
    # The column header, where it is among the body's first lines, ends the
    # pinned part: the local table has a version/host line and a blank above it.
    if [ "$pin" -eq 0 ] && [ "$i" -lt 4 ] && [[ "$SGR_STRIPPED" =~ ^(HOST\ +)?IDX\ + ]]; then pin=$((i + 1)); fi
  done
  if [ $((chrome + total)) -le "$height" ]; then
    VIEW_FITTED=true VIEW_TOP=0
    return 0
  fi
  for ((i = 0; i < pin; i++)); do chrome=$((chrome + VIEW_LINE_ROWS[i])); done
  avail=$((height - chrome))
  [ "$avail" -ge "$VIEW_MIN_ROWS" ] || return 0
  top="$VIEW_TOP"
  [ "$top" -ge "$pin" ] || top="$pin"
  [ "$top" -lt "$n" ] || top=$((n - 1))
  if [ "$cur" -ge "$pin" ] && [ "$cur" -lt "$n" ]; then
    [ "$lead" -ge "$pin" ] || lead="$pin"
    [ "$lead" -le "$cur" ] || lead="$cur"
    [ "$tail" -ge "$cur" ] || tail="$cur"
    [ "$tail" -lt "$n" ] || tail=$((n - 1))
    # Up: the cursor line becomes the top one. Down: the window moves a line
    # at a time until the cursor's TAIL is in — or the cursor line is the top
    # one, with as much of what is under it as fits.
    [ "$cur" -ge "$top" ] || top="$cur"
    viewport_fill "$top" "$pin" "$n" "$avail"
    while [ "$VIEW_BOT" -lt "$tail" ] && [ "$top" -lt "$cur" ]; do
      top=$((top + 1))
      viewport_fill "$top" "$pin" "$n" "$avail"
    done
    [ "$VIEW_BOT" -ge "$cur" ] || return 0
    bot="$VIEW_BOT"
    # LEAD comes along when starting there loses nothing the window has.
    if [ "$lead" -lt "$top" ]; then
      viewport_fill "$lead" "$pin" "$n" "$avail"
      if [ "$VIEW_BOT" -ge "$bot" ] || [ "$VIEW_BOT" -ge "$tail" ]; then top="$lead"; fi
    fi
  fi
  # Rows left over go to the lines above: a table that got shorter, or a
  # terminal that got taller, does not leave the window half empty; and a
  # lone hidden line is drawn in the row its marker would have taken.
  viewport_fill "$top" "$pin" "$n" "$avail"
  bot="$VIEW_BOT"
  while [ "$top" -gt "$pin" ]; do
    viewport_fill $((top - 1)) "$pin" "$n" "$avail"
    [ "$VIEW_BOT" -ge "$bot" ] || break
    top=$((top - 1)) bot="$VIEW_BOT"
  done
  VIEW_OUT="$3" used=0
  for ((i = 0; i < pin; i++)); do VIEW_OUT+=$'\n'"${body[$i]}"; done
  if [ "$top" -gt "$pin" ]; then
    VIEW_OUT+=$'\n'"$(paint "$C_DIM" "↑ $((top - pin)) more  PgUp/g")"
    used=1
  fi
  for ((i = top; i <= bot; i++)); do
    VIEW_OUT+=$'\n'"${body[$i]}"
    used=$((used + VIEW_LINE_ROWS[i]))
  done
  if [ "$bot" -lt $((n - 1)) ]; then
    VIEW_OUT+=$'\n'"$(paint "$C_DIM" "↓ $((n - 1 - bot)) more  PgDn/G")"
    used=$((used + 1))
  fi
  for ((i = used; i < avail; i++)); do VIEW_OUT+=$'\n'; done
  VIEW_OUT+=$'\n'"$5"
  VIEW_TOP="$top" VIEW_PAGE=$((bot - top + 1)) VIEW_FITTED=true
}
# How far PgUp/PgDn move, into VIEW_STEP: a window less one line, so the line
# the cursor leaves is still on screen after the jump; the whole LENGTH when
# nothing is hidden, which makes them top and bottom.
viewport_step() { # LENGTH
  if [ "$VIEW_PAGE" -le 0 ]; then VIEW_STEP="$1"
  elif [ "$VIEW_PAGE" -le 1 ]; then VIEW_STEP=1
  else VIEW_STEP=$((VIEW_PAGE - 1))
  fi
}
# One frame onto the terminal: home, clear, and the frame fitted to the
# height the terminal has NOW — both sizes are read per frame, the width only
# where the height is known. The arguments are kept, so a resize can redraw
# the frame in hand.
viewport_draw() { # HEAD BODY FOOT CURSOR LEAD TAIL
  local lines cols=0
  VIEW_ARGS=("$@")
  lines="$(term_lines)"
  [ "$lines" -le 0 ] || cols="$(term_cols)"
  viewport_frame "$lines" "$cols" "$@"
  if $VIEW_FITTED; then
    printf '\033[H\033[2J%s' "$VIEW_OUT"
  else
    printf '\033[H\033[2J%s\n' "$VIEW_OUT"
  fi
}
# read_key, redrawing on SIGWINCH while it waits instead of sitting out the
# interval on a frame cut for the old size. The trap is armed for the wait
# ONLY: bash runs a trap in the middle of a `read` and the read then carries
# on (measured on 5.3 — the handler is what redraws, the read still times out
# when the interval is up), but the same signal makes a `wait` return early,
# and the fan-out waits on its ssh children. Outside the wait a resize needs
# nothing anyway: the next frame reads the size again.
viewport_winch() {
  [ "${#VIEW_ARGS[@]}" -eq 0 ] || viewport_draw "${VIEW_ARGS[@]}"
}
viewport_read_key() { # TIMEOUT
  local rc=0
  trap viewport_winch WINCH
  read_key "$1" || rc=$?
  trap - WINCH
  return "$rc"
}
# The newline a fitted frame was drawn without, so the shell prompt starts on
# a line of its own. For the EXIT traps; nothing when no frame was fitted.
viewport_close() {
  ! $VIEW_FITTED || printf '\n'
  VIEW_FITTED=false
}
# The line of TABLE the cursor row is on — watch_highlight's own match — or 0.
watch_cursor_line() { # TABLE NAME
  local line n=0
  while IFS= read -r line; do
    n=$((n + 1))
    if [[ "$line" =~ ^[0-9]+\ +"$2"\ + ]]; then echo "$n"; return 0; fi
  done <<<"$1"
  echo 0
}

# The facts an action decides on, fresh: the memoised journal for UNIT is
# dropped first so a job that just ended (or started) is not acted on from
# a cell up to JOURNAL_CACHE_TTL ticks old, then collect_slot fills SLOT.
watch_slot_facts() { # UNIT
  [ -z "$JOURNAL_MEMO_DIR" ] || rm -f -- "$JOURNAL_MEMO_DIR/$1".*
  collect_slot "$1" 0
}
# The `warning:` line R and S carry when a job is in flight.
watch_job_warning() {
  [ "${SLOT[job_state]}" = running ] || return 0
  printf '\nwarning: a job is running (%s) — it will be killed and GitHub marks it failed; runnerctl %s --when-idle waits for it instead' "$(job_cell)" "$1"
}
# A key on the selected slot: either WATCH_NOTICE (a refusal or a result, no
# command runs) or WATCH_PROMPT + WATCH_ACTION (a confirm line stating the
# exact command, run on `y`). L runs at once — reading logs changes nothing.
#   WATCH_ACTION   ctl:restart|ctl:stop|ctl:start|reap|kill  (+ the unit in WATCH_UNIT)
watch_key_action() { # KEY UNIT
  local u="$2" short
  short="$(short_name "$u")"
  WATCH_NOTICE="" WATCH_PROMPT="" WATCH_ACTION="" WATCH_UNIT="$u"
  case "$1" in
    L)
      # The pager owns the screen until it quits; the next frame repaints.
      term_cursor show
      cmd_logs "$u" -n 50 | page
      term_cursor hide
      return ;;
  esac
  watch_slot_facts "$u"
  case "$1" in
    K)
      # GHR-36: the job's own processes, not `systemctl restart` — a restart
      # is a graceful stop and a stalled step is what will not answer one.
      # The prompt names whichever command this slot will actually take.
      if [ "${SLOT[active]}" = deactivating ]; then
        WATCH_ACTION="kill"
        WATCH_PROMPT="$short is stuck stopping (${SLOT[active]}/${SLOT[sub]:-?}) — SIGKILL the whole unit? runs: systemctl kill -s KILL $u  [y/n]"
      else
        case "${SLOT[job_state]}" in
          running|starting)
            job_tree_check "${SLOT[cgroup]}"
            WATCH_ACTION="kill"
            if [ -z "$JOB_TREE" ]; then
              WATCH_PROMPT="Kill the job on $short ($(job_cell))? the slot's processes cannot be read here, so runs: systemctl kill -s KILL $u  [y/n]"
            elif [ "$JOB_TREE" -eq 0 ]; then
              WATCH_ACTION=""
              WATCH_NOTICE="$short: nothing but the runner itself in the slot's cgroup — nothing to kill"
            else
              WATCH_PROMPT="Kill the job on $short ($(job_cell))? runs: kill -KILL $JOB_TREE_PIDS ($(kill_list)) — the runner stays up and reports it failed  [y/n]"
            fi ;;
          no-access) WATCH_NOTICE="$short: cannot tell whether a job is running — needs journal read access (systemd-journal group) or root" ;;
          none)      WATCH_NOTICE="$short: not running — nothing to kill" ;;
          *)         WATCH_NOTICE="$short: no job running — nothing to kill" ;;
        esac
      fi ;;
    R)
      case "${SLOT[active]}" in
        active|activating|reloading)
          WATCH_ACTION="ctl:restart"
          WATCH_PROMPT="Restart $short? runs: systemctl restart $u  [y/n]$(watch_job_warning restart)" ;;
        *) WATCH_NOTICE="$short: not active (${SLOT[active]:-unknown}) — T starts it" ;;
      esac ;;
    S)
      case "${SLOT[active]}" in
        active|activating|reloading)
          WATCH_ACTION="ctl:stop"
          WATCH_PROMPT="Stop $short? runs: systemctl stop $u  [y/n]$(watch_job_warning stop)" ;;
        *) WATCH_NOTICE="$short: already stopped (${SLOT[active]:-unknown})" ;;
      esac ;;
    T)
      case "${SLOT[active]}" in
        active|activating|reloading) WATCH_NOTICE="$short: already active — R restarts it" ;;
        *) WATCH_ACTION="ctl:start"
           WATCH_PROMPT="Start $short? runs: systemctl start $u  [y/n]" ;;
      esac ;;
    P)
      if [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; then
        WATCH_ACTION="reap"
        WATCH_PROMPT="Reap ${SLOT[job_leaked]} leaked process(es) on $short ($(reap_list))? runs: kill -TERM ${SLOT[job_leaked_pids]}, then kill -KILL what is still alive after ${REAP_GRACE_SEC}s  [y/n]"
      elif [ "${SLOT[job_state]}" = running ]; then
        WATCH_NOTICE="$short: busy ($(job_cell)) — a running job's processes are not leaks"
      else
        WATCH_NOTICE="$short: no leaked processes shown — nothing to reap"
      fi ;;
    O)
      # GHR-78: the run's page, PRINTED — the node this runs on is usually a
      # terminal with no browser, and a key that launched one would be a key
      # that runs a program on a string a job supplied. job_env_facts built
      # the URL from validated parts or not at all.
      WATCH_NOTICE="$short: $(run_url_notice "${SLOT[job_state]}" "${SLOT[job_url]}")" ;;
  esac
}
# What O says about a slot: the run's URL, or why there is none to print.
RUN_URL_UNKNOWN="a job is running, but its run URL is not known — it is read from a step's environment, which is not there between steps or for a container job, and needs access to the slot's processes"
run_url_notice() { # JOB-STATE URL
  case "$1" in
    running|starting)
      if [ -n "$2" ]; then printf '%s\n' "$2"; else printf '%s\n' "$RUN_URL_UNKNOWN"; fi ;;
    no-access) echo "cannot tell whether a job is running — needs journal read access (systemd-journal group) or root" ;;
    *)         echo "no job running — no run URL to print" ;;
  esac
}
# The confirmed action. Runs outside any `read`, so the terminal is in its
# normal mode for a sudo prompt; the cursor is shown for it and the command
# is named on the line above, and the output's last line becomes the notice
# on the next frame. A `die` inside only ends the subshell, so a refused or
# failed action is reported, never fatal to the watch.
watch_run_action() {
  local out short
  short="$(short_name "$WATCH_UNIT")"
  term_cursor show
  case "$WATCH_ACTION" in
    ctl:*)
      printf '\nrunning: systemctl %s %s\n' "${WATCH_ACTION#ctl:}" "$WATCH_UNIT"
      out="$(cmd_ctl "${WATCH_ACTION#ctl:}" "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="$short: ${out##*$'\n'}" ;;
    reap)
      printf '\nrunning: reap %s\n' "$short"
      out="$(cmd_reap "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="${out##*$'\n'}" ;;
    kill)
      printf '\nrunning: kill %s\n' "$short"
      out="$(cmd_kill "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="${out##*$'\n'}" ;;
  esac
  term_cursor hide
  WATCH_ACTION="" WATCH_PROMPT=""
}

# --- Slot detail pane (GHR-76) --------------------------------------------------
# `status --json` carries a good deal per slot that the table has no room for:
# the unit's full name, its sub-state, result and last restart reason, the
# memory peak beside the current figure and both limits, every pressure and
# event counter, the run a job belongs to (GHR-78), the processes behind a
# `+N leaked`. Enter on a slot row replaces the table with all of it for that
# one slot, and with the host's own facts under it; Esc, Enter or q goes back.
#
#   * ONE RENDERER, TWO FILLERS. pane_render draws from PN, an array of raw
#     values in which empty means "not known". The local watch fills it from
#     SLOT and HOST (pane_from_local), `fleet watch` from the `status --json`
#     payload the last tick already brought (pane_from_json, further down). So
#     the two panes cannot drift apart, and a host too old to report a field
#     simply leaves it empty: every row prints `—` for an empty value.
#   * EVERYTHING DRAWN GOES THROUGH pane_put, which runs the value through
#     relay_safe's PLAIN form (an escape sequence removed whole, GHR-108)
#     before it is painted. A workflow's name, a branch, an actor, a
#     leaked process's comm, a mount point, the stderr of an ssh that failed —
#     most of a pane is text somebody else chose, so the one function that
#     appends a row is the one place it is neutralised; a row cannot be added
#     that skips it. A run URL is additionally held to run_url_ok.
#   * The pane has NO CURSOR LINE. It is drawn through viewport_draw with
#     nothing selected, so a pane taller than the terminal is windowed like any
#     frame (`↑ N more` / `↓ N more`) and ↑ ↓ j k, PgUp/PgDn and g/G move the
#     window itself (pane_scroll) rather than a cursor. The table's own window
#     position is put back on the way out.
#   * The memory bar is ASCII — `#` in use now, `+` up to the peak, `-` free —
#     so it survives --color never and a terminal that is not in UTF-8 mode. It
#     is drawn against MemoryMax, or MemoryHigh where no max is set; with
#     neither there is nothing to draw it against, and the row says so.
#
# In the pane q does NOT quit: it goes back to the table, like Esc and Enter
# (and Q with it), and the pane's own legend says so; Ctrl-C quits from
# anywhere. h switches between the slot and its host's block alone. The action
# keys keep acting on the pane's slot, with the same confirm line. Every other
# key does nothing there — a view key pressed in the pane must not change a
# table nobody is looking at.
declare -A PN=()
PANE_OUT="" PANE_TOP_WAS=0
PANE_LABEL_W=13 PANE_BAR_CELLS=40
PANE_LEGEND_SLOT="q/Esc/Enter back  h host  jk scroll  K R S T P L O this slot  Ctrl-C quits"
PANE_LEGEND_HOST="q/Esc/Enter back  h slot  jk scroll  Ctrl-C quits"
PANE_LEGEND_DOWN="q/Esc/Enter back  jk scroll  Ctrl-C quits"
PANE_NO_SLOT_KEYS="the host block — K R S T P L O act on a slot"

# One row of the pane: LABEL, then VALUE made safe to draw and painted SGR
# (`—` for an empty one). The only way a row gets into PANE_OUT.
pane_put() { # LABEL VALUE [SGR]
  local pad
  relay_safe "${2-}" plain
  printf -v pad '%-*s' "$PANE_LABEL_W" "$1"
  PANE_OUT+="${PANE_OUT:+$'\n'}  $pad ${3-}${RELAY_SAFE:-—}${3:+$C_RESET}"
}
# A line with no label (GHR-118: a record, a note), made safe as pane_put's
# value is, and painted SGR when one is given.
pane_line() { # TEXT [SGR]
  relay_safe "${1-}" plain
  PANE_OUT+="${PANE_OUT:+$'\n'}  ${2-}${RELAY_SAFE}${2:+$C_RESET}"
}
# A heading: the pane's title, or a section's name.
pane_head() { # TEXT
  relay_safe "$1" plain
  PANE_OUT+="${PANE_OUT:+$'\n'}${C_BOLD}${RELAY_SAFE}${C_BOLD:+$C_RESET}"
}
# VALUE as a whole number arithmetic can take, into PANE_INT — empty for
# anything else. The rule is num_int's (GHR-104), kept in one place.
PANE_INT=""
pane_int() { # VALUE
  num_int "${1-}"
  PANE_INT="$NUM_INT"
}
# Seconds since EPOCH, into PANE_INT; empty when EPOCH is not one or is ahead
# of this node's clock.
pane_age() { # EPOCH
  local now
  pane_int "${1-}"
  [ -n "$PANE_INT" ] || return 0
  now="$(now_epoch)"
  if [ "$PANE_INT" -le "$now" ]; then PANE_INT=$((now - PANE_INT)); else PANE_INT=""; fi
}
# A duration for a row: fmt_dur's, or nothing (so the row prints `—` once).
pane_dur() { # SECONDS
  [[ "${1-}" =~ ^[0-9]+$ ]] || return 0
  fmt_dur "$1"
}
# The bar: `[###+++++-----] 4% of max, peak 96%, high at 85%`. Nothing when the
# current figure is unknown.
pane_bar() { # CURRENT PEAK HIGH MAX
  local cur="$1" peak="$2" high="$3" scale="$4" of=max used pk i bar="" out
  [ -n "$cur" ] || return 0
  if [ -z "$scale" ] || [ "$scale" -eq 0 ]; then scale="$high" of=high; fi
  if [ -z "$scale" ] || [ "$scale" -eq 0 ]; then
    echo "no MemoryMax or MemoryHigh set — nothing to draw it against"
    return 0
  fi
  used=$((cur * PANE_BAR_CELLS / scale))
  [ "$cur" -eq 0 ] || [ "$used" -gt 0 ] || used=1
  [ "$used" -le "$PANE_BAR_CELLS" ] || used="$PANE_BAR_CELLS"
  pk="$used"
  if [ -n "$peak" ]; then
    pk=$((peak * PANE_BAR_CELLS / scale))
    [ "$pk" -le "$PANE_BAR_CELLS" ] || pk="$PANE_BAR_CELLS"
    [ "$pk" -ge "$used" ] || pk="$used"
  fi
  for ((i = 0; i < PANE_BAR_CELLS; i++)); do
    if [ "$i" -lt "$used" ]; then bar+="#"; elif [ "$i" -lt "$pk" ]; then bar+="+"; else bar+="-"; fi
  done
  out="[$bar] $(((cur * 100 + scale / 2) / scale))% of $of"
  [ -z "$peak" ] || out+=", peak $(((peak * 100 + scale / 2) / scale))%"
  if [ "$of" = max ] && [ -n "$high" ] && [ "$high" -gt 0 ]; then
    out+=", high at $(((high * 100 + scale / 2) / scale))%"
  fi
  printf '%s\n' "$out"
}
# `a · b · c` from LABEL VALUE pairs, each empty value as `—`; nothing at all
# when every value is empty, so the row is one `—` rather than three.
pane_join() { # LABEL VALUE [LABEL VALUE]...
  local out="" any=false
  while [ $# -ge 2 ]; do
    [ -z "$2" ] || any=true
    out+="${out:+ · }$1 ${2:-—}"
    shift 2
  done
  ! $any || printf '%s\n' "$out"
}

# The pane itself, into PANE_OUT, from PN. KIND is `slot` (the slot's
# sections, then its host's) or `host` (the host block alone). What PN holds —
# each a raw value, empty when unknown; a number has been through pane_int:
#
#   host name unit profile enabled version           Identity
#   active sub since_age restarts result reason      State
#   job (running | starting | idle | empty) job_repo job_name job_age
#   job_stalled job_workflow job_run_id job_run_attempt job_run_number
#   job_ref job_sha job_actor job_event job_url idle_age jobs_done access
#   mem_cur mem_peak mem_high mem_max p10 p60 ev_high ev_max ev_oom
#   leaked leak_list
#   cores mem_total mem_avail                        Host
#   disks        one line per filesystem, PCT AVAIL MOUNT ROLES separated by
#                the unit separator (0x1f) — a tab would let `read` fold an
#                empty AVAIL into the field after it
#   events       ok | off | no-access, empty when the host does not say; with
#                ok: hev_window hev_oom hev_cgroup_oom hev_disk_full
#                hev_oom_proc hev_df_src
#   answer_label / answer / stderr
#                `fleet watch` only: why a host is not answering — its age
#                line, or its error — and the rest of what ssh said, in full
#   facts        `fleet watch` only: a line for a host that has sent no payload
pane_render() { # slot|host TITLE
  local v pct avail mnt roles line us=$'\x1f'
  local -a ev=()
  PANE_OUT=""
  pane_head "$2"
  [ -z "${PN[facts]:-}" ] || pane_put facts "${PN[facts]}" "$C_YELLOW"
  if [ "$1" = slot ]; then
    pane_head "Identity"
    pane_put host "${PN[host]:-}"
    pane_put runner "${PN[name]:-}"
    pane_put unit "${PN[unit]:-}"
    pane_put profile "${PN[profile]:-}"
    pane_put enabled "${PN[enabled]:-}"
    pane_put runnerctl "${PN[version]:-}" "${PN[version_sgr]:-}"
    pane_head "State"
    v=""
    if [ -n "${PN[active]:-}" ]; then
      v="$(status_active_color "${PN[active]}" "${PN[restarts]:-0}" "${PN[result]:-success}")"
      pane_put active "${PN[active]}/${PN[sub]:-?}" "$v"
    else
      pane_put active ""
    fi
    pane_put since "$(pane_dur "${PN[since_age]:-}")"
    pane_put restarts "${PN[restarts]:-}"
    pane_put result "${PN[result]:-}"
    pane_put "last restart" "${PN[reason]:-}"
    pane_head "Job"
    case "${PN[job]:-}" in
      running|starting)
        v="${PN[job_name]:-}"
        [ "${PN[job]}" != starting ] || v="(starting)"
        pane_put repo "${PN[job_repo]:-}"
        pane_put job "$v" "$C_GREEN"
        pane_put "running for" "$(pane_dur "${PN[job_age]:-}")"
        case "${PN[job_stalled]:-}" in
          true)  pane_put stalled "STALLED — over the stall threshold" "$C_BOLD$C_RED" ;;
          false) pane_put stalled "no" ;;
          *)     pane_put stalled "" ;;
        esac
        pane_put workflow "${PN[job_workflow]:-}"
        v="${PN[job_run_number]:+#${PN[job_run_number]}}"
        [ -z "${PN[job_run_id]:-}" ] || v+="${v:+ · }id ${PN[job_run_id]}"
        [ -z "${PN[job_run_attempt]:-}" ] || v+="${v:+ · }attempt ${PN[job_run_attempt]}"
        pane_put run "$v"
        pane_put ref "${PN[job_ref]:-}"
        pane_put commit "${PN[job_sha]:-}"
        pane_put actor "${PN[job_actor]:-}"
        pane_put event "${PN[job_event]:-}"
        # A string is printed as a link only when it is one this script would
        # have built (GHR-78) — whichever host it came from.
        v="${PN[job_url]:-}"
        if [ -n "$v" ] && ! run_url_ok "$v"; then v="not shown — what was reported is not a run page's address"; fi
        pane_put url "$v" ;;
      idle)
        pane_put job "idle" "$C_DIM"
        pane_put "idle for" "$(pane_dur "${PN[idle_age]:-}")"
        pane_put "jobs done" "${PN[jobs_done]:-}" ;;
      *)
        pane_put job "" ;;
    esac
    case "${PN[access]:-}" in
      ''|ok) ;;
      no-journal) pane_put access "no-journal — only /proc could be read; idle time and job counts need journal read access (systemd-journal group) or root" "$C_YELLOW" ;;
      no-access)  pane_put access "no-access — neither the journal nor the slot's processes could be read; needs the systemd-journal group or root" "$C_YELLOW" ;;
      *)          pane_put access "${PN[access]}" "$C_YELLOW" ;;
    esac
    pane_head "Memory"
    pane_put current "$(hbytes "${PN[mem_cur]:-}")" "$(status_used_color "${PN[mem_cur]:-}" "${PN[mem_high]:-}")"
    pane_put peak "$(hbytes "${PN[mem_peak]:-}")"
    pane_put high "$(hbytes "${PN[mem_high]:-}")"
    pane_put max "$(hbytes "${PN[mem_max]:-}")"
    pane_put bar "$(pane_bar "${PN[mem_cur]:-}" "${PN[mem_peak]:-}" "${PN[mem_high]:-}" "${PN[mem_max]:-}")"
    pane_put pressure "$(pane_join "full avg10" "${PN[p10]:+$(status_press_cell "${PN[p10]}")}" "avg60" "${PN[p60]:+$(status_press_cell "${PN[p60]}")}")" \
      "$(status_press_color "${PN[p10]:-}")"
    pane_put events "$(pane_join high "${PN[ev_high]:-}" max "${PN[ev_max]:-}" oom_kill "${PN[ev_oom]:-}")"
    pane_head "Leaks"
    v=""
    [ -z "${PN[leaked]:-}" ] || [ "${PN[leaked]}" -eq 0 ] || v="$C_YELLOW"
    pane_put leaked "${PN[leaked]:-}" "$v"
    [ -z "${PN[leak_list]:-}" ] || pane_put processes "${PN[leak_list]}"
  fi
  pane_head "Host"
  [ -z "${PN[answer]:-}" ] || pane_put "${PN[answer_label]:-error}" "${PN[answer]}" "$C_RED"
  if [ -n "${PN[stderr]:-}" ]; then
    while IFS= read -r line; do pane_put stderr "$line"; done <<<"${PN[stderr]}"
  fi
  if [ "$1" = host ]; then
    pane_put host "${PN[host]:-}"
    pane_put runnerctl "${PN[version]:-}" "${PN[version_sgr]:-}"
  fi
  pane_put cores "${PN[cores]:-}"
  v=""
  if [ -n "${PN[mem_avail]:-}${PN[mem_total]:-}" ]; then
    v="$(hbytes "${PN[mem_avail]:-}") available of $(hbytes "${PN[mem_total]:-}")"
  fi
  pane_put memory "$v"
  if [ -n "${PN[disks]:-}" ]; then
    while IFS="$us" read -r pct avail mnt roles; do
      [ -n "$mnt" ] || continue
      pane_put disk "$(disk_cell "${pct:-?}" "$avail" "$mnt" "$roles")" "$(disk_color "$pct")"
    done <<<"${PN[disks]}"
  else
    pane_put disk ""
  fi
  case "${PN[events]:-}" in
    ok)
      v="$(pane_dur "${PN[hev_window]:-}")"
      [ "${PN[hev_oom]:-0}" -eq 0 ] || ev+=("${PN[hev_oom]} OOM kill$([ "${PN[hev_oom]}" -eq 1 ] || echo s)${PN[hev_oom_proc]:+ (last: ${PN[hev_oom_proc]})}")
      [ "${PN[hev_cgroup_oom]:-0}" -eq 0 ] || ev+=("${PN[hev_cgroup_oom]} at a cgroup limit")
      [ "${PN[hev_disk_full]:-0}" -eq 0 ] || ev+=("${PN[hev_disk_full]} disk-full${PN[hev_df_src]:+ (last from ${PN[hev_df_src]})}")
      if [ "${#ev[@]}" -gt 0 ]; then
        pane_put events "last ${v:-?}: $(join_by ", " "${ev[@]}")" "$C_RED"
      else
        pane_put events "none in the last ${v:-?}" "$C_DIM"
      fi ;;
    off)       pane_put events "not searched (EVENTS_SEC=0)" ;;
    no-access) pane_put events "the journal could not be read (systemd-journal group, or root)" "$C_YELLOW" ;;
    *)         pane_put events "" ;;
  esac
}

# PN from what collect_slot and collect_host just left in SLOT and HOST: the
# local watch's filler. A systemd memory property that means "unset" is empty
# here, as it is null in --json.
pane_from_local() {
  local cores="" total="" avail="" k v us=$'\x1f' pct free mnt roles
  PN=()
  read -r cores total avail < <(host_facts) || true
  PN[host]="$(host_name)" PN[version]="$RUNNERCTL_VERSION"
  pane_int "$cores"; PN[cores]="$PANE_INT"
  pane_int "$total"; PN[mem_total]="$PANE_INT"
  pane_int "$avail"; PN[mem_avail]="$PANE_INT"
  PN[disks]=""
  while IFS=$'\t' read -r pct free mnt _ _ _ _ roles; do
    [ -n "$mnt" ] || continue
    PN[disks]+="${PN[disks]:+$'\n'}$pct$us$free$us$mnt$us$roles"
  done <<<"${HOST[disks]:-}"
  PN[events]="${HOST[events]:-}"
  if [ "${PN[events]}" = ok ]; then
    PN[hev_window]="$EVENTS_SEC"
    pane_int "${HOST[oom]:-}"; PN[hev_oom]="${PANE_INT:-0}"
    pane_int "${HOST[cgroup_oom]:-}"; PN[hev_cgroup_oom]="${PANE_INT:-0}"
    pane_int "${HOST[disk_full]:-}"; PN[hev_disk_full]="${PANE_INT:-0}"
    PN[hev_oom_proc]="${HOST[last_oom_proc]:-}" PN[hev_df_src]="${HOST[last_disk_full_src]:-}"
  fi
  PN[name]="${SLOT[name]}" PN[unit]="${SLOT[unit]}" PN[profile]="${SLOT[profile]}"
  PN[enabled]="${SLOT[enabled]}" PN[active]="${SLOT[active]}" PN[sub]="${SLOT[sub]}"
  PN[result]="${SLOT[result]}" PN[reason]="${SLOT[last_restart_reason]}"
  for k in since_age:since_age restarts:restarts mem_cur:memory_current mem_peak:memory_peak \
           mem_high:memory_high mem_max:memory_max ev_high:mem_events_high ev_max:mem_events_max \
           ev_oom:mem_events_oom_kill leaked:job_leaked jobs_done:job_done \
           job_run_id:job_run_id job_run_attempt:job_run_attempt job_run_number:job_run_number; do
    v="${SLOT[${k#*:}]:-}"
    # systemd's "no limit" is 2^64-1, which is no number to draw a bar against.
    [ "$v" != 18446744073709551615 ] || v=""
    pane_int "$v"; PN[${k%%:*}]="$PANE_INT"
  done
  PN[p10]="${SLOT[mem_pressure_full_avg10]}" PN[p60]="${SLOT[mem_pressure_full_avg60]}"
  PN[access]="${SLOT[job_access]}"
  if [ -n "${PN[leaked]}" ] && [ "${PN[leaked]}" -gt 0 ]; then
    PN[leak_list]="$(pid_comm_list "${SLOT[job_leaked_pids]}" "${SLOT[job_leaked_comms]}")"
  fi
  case "${SLOT[job_state]}" in
    running|starting)
      PN[job]="${SLOT[job_state]}"
      PN[job_repo]="${SLOT[job_repo_full]:-${SLOT[job_repo]}}" PN[job_name]="${SLOT[job_name]}"
      pane_age "${SLOT[job_since]}"; PN[job_age]="$PANE_INT"
      PN[job_stalled]="${SLOT[job_stalled]}" PN[job_workflow]="${SLOT[job_workflow]}"
      PN[job_ref]="${SLOT[job_ref]}" PN[job_sha]="${SLOT[job_sha]}" PN[job_actor]="${SLOT[job_actor]}"
      PN[job_event]="${SLOT[job_event]}" PN[job_url]="${SLOT[job_url]}" ;;
    idle|idle-fresh)
      PN[job]=idle
      pane_age "${SLOT[job_idle_since]}"; PN[idle_age]="$PANE_INT" ;;
  esac
}

# The window of a pane that has no cursor line: the keys move VIEW_TOP, which
# viewport_frame clamps to what there is and carries to the next frame. 0 when
# KEY was one of them.
#
# The first step down is two lines and the last step up is too: a window one
# line from the top would hide that single line behind a `↑ 1 more` marker,
# and viewport_frame draws the line instead of the marker — so a step of one
# from the top would change nothing on the screen.
pane_scroll() { # KEY
  case "$1" in
    down|j) if [ "$VIEW_TOP" -le 0 ]; then VIEW_TOP=2; else VIEW_TOP=$((VIEW_TOP + 1)); fi ;;
    up|k)   if [ "$VIEW_TOP" -le 2 ]; then VIEW_TOP=0; else VIEW_TOP=$((VIEW_TOP - 1)); fi ;;
    pgdn)   viewport_step 0; VIEW_TOP=$((VIEW_TOP + VIEW_STEP)) ;;
    pgup)   viewport_step 0; VIEW_TOP=$((VIEW_TOP - VIEW_STEP)); [ "$VIEW_TOP" -ge 0 ] || VIEW_TOP=0 ;;
    g|home) VIEW_TOP=0 ;;
    G|end)  VIEW_TOP="$VIEW_END" ;;
    *)      return 1 ;;
  esac
}
# Into a pane and out of it: the table's window position is kept aside, so the
# table comes back scrolled to where it was.
pane_enter() { PANE_TOP_WAS="$VIEW_TOP" VIEW_TOP=0; }
pane_leave() { VIEW_TOP="$PANE_TOP_WAS"; }

# The local watch's pane for UNIT (row IDX), into PANE_OUT. WATCH_PANE is
# `slot`, `host` or empty (the table).
WATCH_PANE=""
watch_pane_build() { # UNIT IDX
  collect_slot "$1" "$2"
  collect_host
  pane_from_local
  if [ "$WATCH_PANE" = host ]; then
    pane_render host "${PN[host]:-this host} — host details"
  else
    pane_render slot "${SLOT[name]} — slot details"
  fi
}
# A key while the pane is up. See the block above for what each does.
watch_pane_key() { # KEY
  case "$1" in
    esc|enter|q|Q) WATCH_PANE=""; pane_leave ;;
    h) VIEW_TOP=0; if [ "$WATCH_PANE" = slot ]; then WATCH_PANE=host; else WATCH_PANE=slot; fi ;;
    K|R|S|T|P|L|O)
      if [ "$WATCH_PANE" = slot ]; then
        watch_key_action "$1" "$WATCH_CURSOR"
      else
        WATCH_NOTICE="$PANE_NO_SLOT_KEYS; h goes back to the slot"
      fi ;;
    *) pane_scroll "$1" || true ;;
  esac
}
# One key against the watch state. Returns 1 on `q` (quit). The cursor is
# the unit's name in WATCH_CURSOR, so it stays on the same slot when the
# pool is scaled and the row numbers shift; UNITS is the current order.
WATCH_CURSOR="" WATCH_NOTICE="" WATCH_PROMPT="" WATCH_ACTION="" WATCH_UNIT=""
watch_handle_key() { # KEY UNITS...
  local key="$1" i n; shift
  local units=("$@")
  if [ -n "$WATCH_ACTION" ]; then
    # A confirm is up: only `y` runs it; anything else is a `n`.
    case "$key" in
      y|Y) watch_run_action ;;
      *)   WATCH_NOTICE="cancelled — nothing run"; WATCH_ACTION="" WATCH_PROMPT="" ;;
    esac
    return 0
  fi
  WATCH_NOTICE=""
  # GHR-105: any key closes the list, and is spent doing it. GHR-99: but the
  # keys of the marker on a list the terminal cuts scroll it instead.
  if $WATCH_HELP_ON; then
    pane_scroll "$key" || { WATCH_HELP_ON=false; pane_leave; }
    return 0
  fi
  # GHR-76: with the pane up every key is the pane's — `q` goes back to the
  # table rather than quitting, and no key moves a cursor nobody can see.
  if [ -n "$WATCH_PANE" ]; then watch_pane_key "$key"; return 0; fi
  n="${#units[@]}"
  for i in "${!units[@]}"; do [ "${units[$i]}" != "$WATCH_CURSOR" ] || break; done
  case "$key" in
    q|Q)      return 1 ;;
    down|j)   [ "$i" -ge $((n - 1)) ] || WATCH_CURSOR="${units[$((i + 1))]}" ;;
    up|k)     [ "$i" -le 0 ] || WATCH_CURSOR="${units[$((i - 1))]}" ;;
    # GHR-73: a page at a time, and the two ends. The slot rows are one line
    # each, so a step in lines is a step in units.
    pgdn|pgup|g|G|home|end)
      [ "$n" -gt 0 ] || return 0
      viewport_step "$n"
      case "$key" in
        pgdn)   i=$((i + VIEW_STEP)) ;;
        pgup)   i=$((i - VIEW_STEP)) ;;
        g|home) i=0 ;;
        *)      i=$((n - 1)) ;;
      esac
      [ "$i" -lt "$n" ] || i=$((n - 1))
      [ "$i" -ge 0 ] || i=0
      WATCH_CURSOR="${units[$i]}" ;;
    K|R|S|T|P|L|O) watch_key_action "$key" "$WATCH_CURSOR" ;;
    # GHR-76: the cursor's slot in full, in place of the table.
    enter) if [ -n "$WATCH_CURSOR" ]; then WATCH_PANE=slot; pane_enter; fi ;;
    '?')   WATCH_HELP_ON=true; pane_enter ;;
  esac
  return 0
}

# A native loop rather than `exec watch -n N runnerctl status`: procps
# `watch` is not on every runner host, mangles the UTF-8 `—` cells, and
# would re-run load_config and the config permission checks every tick.
# Each frame is rendered into a variable first and written with one printf
# (home + clear + frame), so the redraw is atomic and does not flicker.
# --iterations N (test-only, undocumented) stops after N redraws so the sim
# can run the loop with its no-op `pause`; that path is headless — no
# cursor, no legend, no key read — so it is exactly the view of before.
# Interactively (GHR-33) each frame ends with the key legend and a status
# line (a notice, or the pending confirm), and the wait between redraws is
# a key read with the interval as its timeout: a key redraws at once, a
# timeout is a tick. The journal memo counts ticks, not keys.
cmd_watch() { # [--interval N] [--iterations N] [--color WHEN] [--stall-after N] [--narrow]
  local interval=2 iterations="" tick=0 refreshed=-1 out header units=() status short cur tail idx i legend
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then shift "$VIEW_SHIFT"; continue; fi
    case "$1" in
      --narrow)
        WATCH_NARROW_FORCED=true; status_narrow; shift ;;
      --interval)
        need_val "$@"
        [[ "$2" =~ ^0*[1-9][0-9]*$ ]] || die "--interval value '$2' is invalid — want a whole number of seconds, at least 1"
        interval="$2"; shift 2 ;;
      --iterations)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--iterations value '$2' is invalid — want an integer"
        iterations="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  stdout_is_tty || die "watch needs a terminal (stdout is not a tty); use 'runnerctl status'"
  require_runners
  color_setup "$COLOR_MODE"
  JOURNAL_MEMO_DIR="$(mktemp -d)"
  # GHR-79: the previous tick's CPU samples; never emptied by the journal TTL.
  CPU_MEMO_DIR="$(mktemp -d)"
  # GHR-102: the last run facts read for each slot's job; same lifetime.
  ENV_MEMO_DIR="$(mktemp -d)"
  # Ctrl-C exits 0 through the EXIT trap, which restores the cursor either way.
  trap 'term_cursor show; viewport_close; rm -rf "$JOURNAL_MEMO_DIR" "$CPU_MEMO_DIR" "$ENV_MEMO_DIR"' EXIT
  trap 'exit 0' INT TERM
  term_cursor hide
  while :; do
    # A fresh journal read every JOURNAL_CACHE_TTL ticks, starting with the
    # first — once per such tick, however many key redraws it spans.
    if [ $((tick % JOURNAL_CACHE_TTL)) -eq 0 ] && [ "$tick" -ne "$refreshed" ]; then
      rm -f -- "$JOURNAL_MEMO_DIR"/*
      refreshed="$tick"
    fi
    header="$(paint "$C_BOLD" "runnerctl watch — ${HOSTNAME:-$(uname -n)} — $(date +%H:%M:%S) — every ${interval}s (Ctrl-C to quit)")"
    # GHR-76: with the pane up the table is not drawn, so it is not rendered.
    [ -n "$WATCH_PANE" ] || watch_table
    if [ -n "$iterations" ]; then
      printf '\033[H\033[2J%s\n%s\n' "$header" "$WATCH_TABLE"
      pause "$interval"
      tick=$((tick + 1))
      [ "$tick" -lt "$iterations" ] || break
      continue
    fi
    mapfile -t units < <(discover)
    if $WATCH_HELP_ON; then
      viewport_draw "$header" "$WATCH_HELP" $'\n'"$(paint "$C_DIM" "$HELP_FOOT")"$'\n' 0 0 0
      if viewport_read_key "$interval"; then
        watch_handle_key "$KEY" "${units[@]}" || break
      else
        tick=$((tick + 1))
      fi
      continue
    fi
    if [ -n "$WATCH_PANE" ]; then
      # GHR-76: the pane, rebuilt from fresh facts on every frame — a tick
      # refreshes it exactly as it refreshes the table. A slot that went away
      # while its pane was up (scaled down) has nothing to show: back to the
      # table, saying so, with the cursor dropped to the top as below.
      idx=-1
      for i in "${!units[@]}"; do
        if [ "${units[$i]}" = "$WATCH_CURSOR" ]; then idx="$i"; break; fi
      done
      if [ "$idx" -ge 0 ]; then
        watch_pane_build "$WATCH_CURSOR" "$idx"
        legend="$PANE_LEGEND_SLOT"
        [ "$WATCH_PANE" = slot ] || legend="$PANE_LEGEND_HOST"
        viewport_draw "$header" "$PANE_OUT" $'\n'"$(paint "$C_DIM" "$legend")"$'\n'"${WATCH_PROMPT:-$WATCH_NOTICE}" 0 0 0
        if viewport_read_key "$interval"; then
          watch_handle_key "$KEY" "${units[@]}" || break
        else
          tick=$((tick + 1))
        fi
        continue
      fi
      WATCH_NOTICE="$(short_name "$WATCH_CURSOR"): no longer on this host — back to the table"
      WATCH_PANE="" WATCH_ACTION="" WATCH_PROMPT=""
      pane_leave
      watch_table
    fi
    # The cursor follows its unit; a slot that went away drops it to the top.
    [[ " ${units[*]} " == *" $WATCH_CURSOR "* ]] || WATCH_CURSOR="${units[0]:-}"
    short="$(short_name "$WATCH_CURSOR")"
    out="$(watch_highlight "$WATCH_TABLE" "$short")"
    status="${WATCH_PROMPT:-$WATCH_NOTICE}"
    # GHR-73: fitted to the terminal's height where it is known. The notes
    # under the table belong to the last slot's view (TAIL), or nothing would
    # ever scroll them in.
    cur="$(watch_cursor_line "$WATCH_TABLE" "$short")"
    tail="$cur"
    if [ "${#units[@]}" -gt 0 ] && [ "$WATCH_CURSOR" = "${units[$((${#units[@]} - 1))]}" ]; then tail="$VIEW_END"; fi
    viewport_draw "$header" "$out" $'\n'"$(paint "$C_DIM" "$WATCH_LEGEND")"$'\n'"$status" "$cur" "$cur" "$tail"
    if viewport_read_key "$interval"; then
      watch_handle_key "$KEY" "${units[@]}" || break
    else
      tick=$((tick + 1))
    fi
  done
}

cmd_remove_limits() {
  parse_opts "$@"
  require_runners
  local units=() u t short_list=""
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for t in "${TARGETS[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  audit_begin remove-limits
  audit_slots "${#TARGETS[@]}" "${units[@]}"
  # GHR-137: the drop-ins removed and no daemon-reload is a host whose files
  # and running config disagree.
  caller_guard
  for u in "${units[@]}"; do
    run_priv rm -f "$SYSTEMD_DIR/$u.d/$DROPIN_NAME"
    echo "  removed drop-in for $u"
  done
  hb_systemctl daemon-reload
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for u in "${units[@]}"; do
      t="${u#actions.runner.}"; t="${t%.service}"
      short_list+="${short_list:+, }$t"
    done
    echo "Removed drop-in for ${#units[@]} slot(s): $short_list."
  else
    echo "Removed managed drop-ins. Run 'runnerctl restart' to revert running slots."
  fi
}

# GHR-29: kill what a finished job left in an idle slot's cgroup, and only
# that — the Listener keeps running, no restart, no re-registration blip.
# Reads the same job_facts the table reads, so a slot the table shows busy
# is skipped here: a running job's processes are not leaks. SIGTERM first,
# REAP_GRACE_SEC later SIGKILL for whatever pid_alive still sees. The walk
# is a plain read (root or the runner user can do it); only the kills go
# through run_priv. Exit 1 only for a refusal (unreadable cgroup, no
# journal); a busy or clean slot is a line, not a failure.
cmd_reap() { # [--dry-run] [target ...] (default: all)
  local dry_run=false targets=() units=() u t short pid survivors
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      -*)        die "unknown option: $1" ;;
      *)         targets+=("$1"); shift ;;
    esac
  done
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  if ! $dry_run; then
    audit_begin reap
    audit_slots "${#targets[@]}" "${units[@]}"
    # GHR-137: a hangup in the grace would leave the TERM's survivors without
    # their KILL, and a cut pipe would leave the slots after this one unreaped.
    caller_guard
  fi
  for u in "${units[@]}"; do
    short="$(short_name "$u")"
    slot_job_facts "$u"
    case "$JOB_STATE" in
      none) echo "$short: not running — nothing to reap"; continue ;;
      no-access) die "$short: cannot tell whether the slot is idle — reap needs journal read access (systemd-journal group) or root" ;;
      idle|idle-fresh|idle-unknown) ;;
      *) echo "$short: busy ($(job_desc "$(job_cell)")) — skipped, a running job's processes are not leaks"; continue ;;
    esac
    [ -n "$JOB_LEAKED" ] || die "$short: cannot read the slot's processes — run reap as root or the runner user"
    if [ "$JOB_LEAKED" -eq 0 ]; then echo "$short: nothing to reap"; continue; fi
    if $dry_run; then
      echo "$short: would kill $JOB_LEAKED leaked process(es): $(reap_list)"
      continue
    fi
    # shellcheck disable=SC2086  # the pids are one argument each on purpose
    run_priv kill -TERM $JOB_LEAKED_PIDS
    pause "$REAP_GRACE_SEC"
    survivors=""
    for pid in $JOB_LEAKED_PIDS; do
      ! pid_alive "$pid" || survivors+="${survivors:+ }$pid"
    done
    # shellcheck disable=SC2086
    [ -z "$survivors" ] || run_priv kill -KILL $survivors
    echo "$short: reaped $JOB_LEAKED leaked process(es): $(reap_list)${survivors:+ — SIGKILL needed for pid ${survivors// /, }}"
  done
}

# `pid/comm, pid/comm` from a PIDS + COMMS pair, for reap's and kill's lines.
# COMMS is joined on COMM_SEP (GHR-100), which no collected comm can contain:
# a comm with a comma or a space in it is one name, next to its own pid.
pid_comm_list() { # PIDS COMMS
  local out="" pids comms i
  read -ra pids <<<"$1"
  IFS="$COMM_SEP" read -ra comms <<<"$2"
  for i in "${!pids[@]}"; do out+="${out:+, }${pids[$i]}/${comms[$i]:-?}"; done
  echo "$out"
}
reap_list() { pid_comm_list "$JOB_LEAKED_PIDS" "$JOB_LEAKED_COMMS"; }
kill_list() { pid_comm_list "$JOB_TREE_PIDS" "$JOB_TREE_COMMS"; }

# GHR-36: kill the JOB, not the runner. `systemctl restart` is a graceful
# shutdown — the unit GitHub's svc.sh installs carries KillMode=process,
# KillSignal=SIGTERM, TimeoutStopSec=5min, so systemd signals only
# `runsvc.sh`, which asks the Listener, which asks the Worker to cancel the
# step. A step that is genuinely stalled never answers: the restart hangs in
# `deactivating/stop-sigterm` for five minutes and systemd then SIGKILLs the
# main process only, leaving the job's processes alive in the cgroup. That is
# the exact opposite of what "kill the stalled job" has to mean.
#
# So: SIGKILL the job's own processes (proc_job_tree — everything in the
# cgroup but the Listener side), which nothing can ignore, and leave the
# Listener up. It notices its Worker died, reports the job failed to GitHub
# and is idle in seconds — no restart, no re-registration blip, no other
# slot's work disturbed.
#
# Two escalations to `systemctl kill -s KILL <unit>`, which signals every
# process of the unit's cgroup whatever KillMode says, with Restart=always
# bringing the slot back:
#   - the cgroup cannot be read (not root, not the runner user), so there are
#     no pids to signal — systemd can do it without reading anything;
#   - the slot is already wedged in its own stop, or the Listener has not
#     reported the job gone KILL_GRACE_SEC after its Worker was killed (it is
#     hung too). This is the case a plain `restart` cannot get out of.
cmd_kill() { # [--dry-run] [--if-stalled] [--stall-after N] [target ...]
  local dry_run=false if_stalled=false targets=() units=() u t short acted=0
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --dry-run)     dry_run=true; shift ;;
      --if-stalled)  if_stalled=true; shift ;;
      --stall-after) need_val "$@"; set_stall_after "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             targets+=("$1"); shift ;;
    esac
  done
  if $if_stalled && [ "$STALL_SEC" -le 0 ]; then
    die "--if-stalled needs a threshold: STALL_SEC is 0 (pass --stall-after N)"
  fi
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      # Resolve on its own line: a die inside "$(...)" only exits the subshell.
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    # Killing every slot's job at once is never what someone means by a bare
    # `kill`; with --if-stalled the selection is the stalled set, so no target
    # is the normal form.
    $if_stalled || die "kill needs a target (a unit, slot index or name) — or --if-stalled to take every stalled slot"
    mapfile -t units < <(discover)
  fi
  if ! $dry_run && ! $if_stalled; then
    audit_begin kill
    audit_slots "${#targets[@]}" "${units[@]}"
    # GHR-137: cut off in the wait after the SIGKILL, a wedged Listener would
    # never be escalated to the unit kill.
    caller_guard
  fi
  for u in "${units[@]}"; do
    short="$(short_name "$u")"
    if $if_stalled; then
      stalled_gate "$u" killing || continue
      $dry_run || { audit_begin kill --if-stalled "$short"; caller_guard; }
    else
      slot_job_facts "$u"
      kill_gate "$short" || continue
    fi
    acted=$((acted + 1))
    kill_slot "$u" "$short" "$dry_run"
  done
  if $if_stalled && [ "$acted" -eq 0 ]; then
    echo "no stalled slot — nothing killed."
  elif $if_stalled; then
    echo "kill done ($acted stalled slot(s))."
  fi
}

# --- compose-reap: Docker Compose projects whose job is gone ------------------
# A runner host's Docker daemon is shared by every repo whose CI lands on it,
# and the only way a job leaks a compose stack is by dying before its own
# teardown runs: SIGKILL, a cancelled workflow, a runner restart, the slot's
# MemoryMax. A cleanup step inside the job cannot cover that, and an
# age-filtered `docker * prune` cannot either — a leaked stack's containers
# are still RUNNING, so its images and volumes count as in use and every prune
# skips them while reporting success. So this judges each compose project by
# whether the job that made it is still alive, not by its name or its age.
#
# Every compose project on the daemon (the `com.docker.compose.project`
# label, never a name prefix) gets a verdict from these signals, in order:
#
#   keep label  a container labelled "$COMPOSE_REAP_KEEP_LABEL=true" — the only
#               opt-out. Restart policies are deliberately NOT one: CI
#               harnesses boot production compose files that carry
#               `restart: unless-stopped`.
#   grace       last activity younger than --grace-minutes: a stack mid-`up`.
#   pid         the project name ends in `-<pid>` (a harness that names its
#               stack after its own process), pid >= COMPOSE_REAP_MIN_PID —
#               below that a `-2` / `-3` is compose numbering a copied
#               checkout, not a process. Alive while that pid exists AND
#               started no later than the project's last activity, so a
#               recycled pid does not keep a dead stack alive.
#   slot        the project's working dir is under a runner slot's work
#               folder. Alive while that slot's Runner.Worker (one per job)
#               exists and started no later than the project's last activity.
#   age         no signal applies: reaped once idle longer than --max-age-hours.
#
# Any "alive" signal wins over a "gone" one. A project that is only volumes is
# never reaped: a leaked stack's volumes go in the same pass as its
# containers, and a guess must never delete a data volume whose stack was
# merely stopped. A reaped project loses its containers (with their anonymous
# volumes), then its networks, then its named volumes — that project's only,
# by id. Never a prune: on a shared daemon a prune reaches live jobs.
#
# Dry run unless --apply, and --apply refuses on a host with no runner units,
# where the age guard would take a developer's own stacks. One line per
# project, then a summary, so a timer's journal shows the leak rate.
# Running containers with no compose label are outside its reach: counted in
# the summary (`non-compose-running=N`) so they are visible, never touched.
# A project with an object whose record does not parse (GHR-109, below) is
# `skip`ped whole and counted in `skipped=N`.
#
# The docker reads and removals go through the compose_* hooks below so a
# config can stub them without replacing the logic.

# Docker timestamp -> epoch seconds; unparseable -> 0. Containers and volumes
# give RFC 3339; networks give Go's time.String() (`2026-08-26 22:12:51.64
# +0200 CEST`), whose trailing zone name GNU date rejects alongside the
# offset, so retry on the first three fields.
compose_epoch() { # DOCKER-TIMESTAMP
  date -d "$1" +%s 2>/dev/null && return 0
  local a b c _
  read -r a b c _ <<<"$1"
  date -d "$a $b $c" +%s 2>/dev/null || echo 0
}

# GHR-109: what docker answers is read so that no label can move a field.
# A label is any bytes a job with docker access chose — `|`, a newline, a
# quote, a control byte — so a record that SPLITS on a separator lets the
# label pick the id the root timer removes (`x|<id>` did exactly that) and
# the timestamp the age guard reads. So each record is:
#
#   docker's own fields first   the id (64 hex digits, `{{.Id}}`) or a volume's
#                               `{{json .Name}}`, then the timestamps — none of
#                               which a label can reach;
#   every label last, as JSON   `{{json (index … "label")}}`, docker's own
#                               encoder: a `"`, a `\`, a newline or any C0 byte
#                               comes back escaped, so a line is always ONE
#                               record. An absent label is `null` (a container
#                               or network) or `""` (a volume).
#
# compose_record then holds the whole line to one exact shape. A label docker
# had to escape, a control byte (DEL and C1 are not escaped), an id that is not
# docker's form or a timestamp that does not parse makes the record
# unparseable: its project is skipped whole and said so, never guessed at.
# A label with `|` in it parses: `|` is no longer a separator, only text.

# ID|CREATED|STARTED|KEEP|WORKING-DIR|PROJECT, one line per compose container.
compose_containers() {
  local ids
  mapfile -t ids < <(docker ps -aq --filter "label=com.docker.compose.project" 2>/dev/null)
  [ "${#ids[@]}" -gt 0 ] || return 0
  docker inspect -f "{{.Id}}|{{.Created}}|{{.State.StartedAt}}|{{json (index .Config.Labels \"$COMPOSE_REAP_KEEP_LABEL\")}}|{{json (index .Config.Labels \"com.docker.compose.project.working_dir\")}}|{{json (index .Config.Labels \"com.docker.compose.project\")}}" "${ids[@]}" 2>/dev/null
}

# ID|CREATED|PROJECT per compose network; NAME|CREATED|PROJECT per volume.
compose_networks() {
  local ids
  mapfile -t ids < <(docker network ls -q --filter "label=com.docker.compose.project" 2>/dev/null)
  [ "${#ids[@]}" -gt 0 ] || return 0
  docker network inspect -f '{{.Id}}|{{.Created}}|{{json (index .Labels "com.docker.compose.project")}}' "${ids[@]}" 2>/dev/null
}
compose_volumes() {
  local ids
  mapfile -t ids < <(docker volume ls -q --filter "label=com.docker.compose.project" 2>/dev/null)
  [ "${#ids[@]}" -gt 0 ] || return 0
  docker volume inspect -f '{{json .Name}}|{{.CreatedAt}}|{{json (index .Labels "com.docker.compose.project")}}' "${ids[@]}" 2>/dev/null
}

# The shapes compose_record holds a line to. A timestamp is RFC 3339 or Go's
# time.String() (an older daemon's network); a label is a JSON string that
# needed no escape, or null.
COMPOSE_HEX_RE='[0-9a-f]{64}'
COMPOSE_TS_RE='[0-9A-Za-z:.+ -]+'
COMPOSE_LBL_RE='"[^"\\]*"|null'
COMPOSE_VOL_RE='"[A-Za-z0-9][A-Za-z0-9_.-]+"'
COMPOSE_CONTAINER_RE="^($COMPOSE_HEX_RE)[|]($COMPOSE_TS_RE)[|]($COMPOSE_TS_RE)[|]($COMPOSE_LBL_RE)[|]($COMPOSE_LBL_RE)[|]($COMPOSE_LBL_RE)\$"
COMPOSE_NETWORK_RE="^($COMPOSE_HEX_RE)[|]($COMPOSE_TS_RE)[|]($COMPOSE_LBL_RE)\$"
COMPOSE_VOLUME_RE="^($COMPOSE_VOL_RE)[|]($COMPOSE_TS_RE)[|]($COMPOSE_LBL_RE)\$"
# The project label: the line's last field, a JSON string with or without
# escapes. Found even when the rest of the line is wrong, so a bad record can
# still take its project with it.
COMPOSE_TAIL_RE='[|]("([^"\\]|\\.)*"|null)$'
COMPOSE_CTRL_RE=$'[\001-\037\177]|\xc2[\x80-\x9f]'

# A label token as compose_record found it, into COMPOSE_LABEL: null is empty.
compose_label() { # TOKEN
  case "$1" in
    null) COMPOSE_LABEL="" ;;
    *)    COMPOSE_LABEL="${1:1:${#1}-2}" ;;
  esac
}

# One line of compose_containers / _networks / _volumes into CR_*:
#   CR_PROJECT  the project label; docker's escaped JSON text, quotes and all,
#               when docker had to escape it (it is shown as written, and no
#               clean label can collide with it: those carry no `"`)
#   CR_ID CR_CREATED CR_STARTED CR_KEEP CR_WD   the record, when it parsed
#   CR_BAD      empty, or why it did not: label, id, format; `unreadable` when
#               not even the project could be found
compose_record() { # container|network|volume LINE
  local LC_ALL=C l="$2" re first
  CR_PROJECT="" CR_ID="" CR_CREATED="" CR_STARTED="" CR_KEEP="" CR_WD="" CR_BAD=""
  if ! [[ "$l" =~ $COMPOSE_TAIL_RE ]]; then CR_BAD=unreadable; return 0; fi
  case "${BASH_REMATCH[1]}" in
    *\\*) CR_PROJECT="${BASH_REMATCH[1]}" CR_BAD=label; return 0 ;;
  esac
  compose_label "${BASH_REMATCH[1]}"; CR_PROJECT="$COMPOSE_LABEL"
  if [[ "$l" =~ $COMPOSE_CTRL_RE ]]; then CR_BAD=label; return 0; fi
  case "$1" in
    container) re="$COMPOSE_CONTAINER_RE" ;;
    network)   re="$COMPOSE_NETWORK_RE" ;;
    *)         re="$COMPOSE_VOLUME_RE" ;;
  esac
  if ! [[ "$l" =~ $re ]]; then
    first="${l%%|*}"
    if [[ "$l" == *\\* ]]; then CR_BAD=label
    elif [ "$1" = volume ] && ! [[ "$first" =~ ^$COMPOSE_VOL_RE$ ]]; then CR_BAD=id
    elif [ "$1" != volume ] && ! [[ "$first" =~ ^$COMPOSE_HEX_RE$ ]]; then CR_BAD=id
    else CR_BAD=format
    fi
    return 0
  fi
  CR_ID="${BASH_REMATCH[1]}" CR_CREATED="${BASH_REMATCH[2]}"
  case "$1" in
    container)
      CR_STARTED="${BASH_REMATCH[3]}"
      compose_label "${BASH_REMATCH[4]}"; CR_KEEP="$COMPOSE_LABEL"
      compose_label "${BASH_REMATCH[5]}"; CR_WD="$COMPOSE_LABEL"
      ;;
    volume) CR_ID="${CR_ID:1:${#CR_ID}-2}" ;;
  esac
}

# "RUNNING COMPOSE-RUNNING": all running containers, and those with the label.
compose_running_counts() {
  local all composed
  all="$(docker ps -q 2>/dev/null | wc -l)" || all=0
  composed="$(docker ps -q --filter "label=com.docker.compose.project" 2>/dev/null | wc -l)" || composed=0
  echo "$((all)) $((composed))"
}

docker_available() { command -v docker >/dev/null 2>&1; }

# GHR-87: why the daemon will not answer this user, or nothing when it does.
# Every reader above sends docker's stderr to /dev/null, so a login outside
# the docker group used to read as an EMPTY daemon — `projects=0`, exit 0 —
# which is the one answer a dry run must never give for a host it could not
# see. So one probe asks first, and its first stderr line is what is said:
# docker's own words (`permission denied while trying to connect to the
# docker API at unix:///var/run/docker.sock`, `Cannot connect to the Docker
# daemon … Is the docker daemon running?`) are the fact; the remedy is ours.
docker_daemon_problem() {
  local err
  err="$(docker version --format '{{.Server.Version}}' 2>&1 >/dev/null)" && return 0
  err="${err%%$'\n'*}"
  echo "${err:-docker version failed with no message}"
}
# The text a host's `compose-reap` dies with when docker is not installed
# there — matched by the fleet form (fleet_no_docker), which reports such a
# host as information rather than a failure, so keep the two in step.
COMPOSE_REAP_NO_DOCKER="docker not found on PATH — compose-reap has nothing to inspect"

# ID|IMAGE-ID|CREATED|STARTED|NAME|IMAGE|KEEP, one line per container WITHOUT
# a compose label, in any state — docker's fields first, then what a job chose
# as JSON, as compose_containers does (GHR-109): the keep label is a label,
# and the image is the text the job asked for. `with` guards a container whose
# Labels is nil, so KEEP may also be empty.
compose_standalone() {
  local all composed ids
  all="$(docker ps -aq --no-trunc 2>/dev/null | sort)"
  composed="$(docker ps -aq --no-trunc --filter "label=com.docker.compose.project" 2>/dev/null | sort)"
  mapfile -t ids < <(comm -23 <(printf '%s\n' "$all") <(printf '%s\n' "$composed") | grep -v '^$' || true)
  [ "${#ids[@]}" -gt 0 ] || return 0
  docker inspect -f "{{.Id}}|{{.Image}}|{{.Created}}|{{.State.StartedAt}}|{{json .Name}}|{{json .Config.Image}}|{{with .Config.Labels}}{{json (index . \"$COMPOSE_REAP_KEEP_LABEL\")}}{{end}}" "${ids[@]}" 2>/dev/null
}
# A container's name as docker validates it, behind its `/`.
COMPOSE_STANDALONE_RE="^($COMPOSE_HEX_RE)[|](sha256:$COMPOSE_HEX_RE)[|]($COMPOSE_TS_RE)[|]($COMPOSE_TS_RE)[|]\"/([A-Za-z0-9][A-Za-z0-9_.-]*)\"[|](\"[^\"\\\\]*\")[|]($COMPOSE_LBL_RE)?\$"

# One line of compose_standalone into CR_ID CR_IMG CR_CREATED CR_STARTED
# CR_NAME CR_IMAGE CR_KEEP, or CR_BAD (label, id, format) with nothing else:
# there is no project to skip, so the container alone is.
compose_standalone_record() { # LINE
  local LC_ALL=C l="$1"
  CR_ID="" CR_IMG="" CR_CREATED="" CR_STARTED="" CR_NAME="" CR_IMAGE="" CR_KEEP="" CR_BAD=""
  if [[ "$l" =~ $COMPOSE_CTRL_RE || "$l" == *\\* ]]; then CR_BAD=label; return 0; fi
  if ! [[ "$l" =~ $COMPOSE_STANDALONE_RE ]]; then
    if [[ "${l%%|*}" =~ ^$COMPOSE_HEX_RE$ ]]; then CR_BAD=format; else CR_BAD=id; fi
    return 0
  fi
  CR_ID="${BASH_REMATCH[1]}" CR_IMG="${BASH_REMATCH[2]}" CR_CREATED="${BASH_REMATCH[3]}"
  CR_STARTED="${BASH_REMATCH[4]}" CR_NAME="${BASH_REMATCH[5]}"
  compose_label "${BASH_REMATCH[6]}"; CR_IMAGE="$COMPOSE_LABEL"
  if [ -n "${BASH_REMATCH[7]}" ]; then compose_label "${BASH_REMATCH[7]}"; CR_KEEP="$COMPOSE_LABEL"; fi
}

# True when any container, in any state, still uses IMAGE-ID.
compose_image_in_use() { # IMAGE-ID
  [ -n "$(docker ps -aq --filter "ancestor=$1" 2>/dev/null)" ]
}

compose_rm() { # container|network|volume|image ID
  case "$1" in
    container) docker rm -f -v "$2" >/dev/null 2>&1 ;;
    network)   docker network rm "$2" >/dev/null 2>&1 ;;
    volume)    docker volume rm "$2" >/dev/null 2>&1 ;;
    image)     docker rmi "$2" >/dev/null 2>&1 ;;
  esac
}

# A slot's work folder: `workFolder` from the runner's .runner file (made
# absolute against the runner directory), else the runner default `_work`.
runner_work_folder() { # RUNNER-DIR
  local wf
  wf="$(sed -n 's/.*"workFolder"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1/.runner" 2>/dev/null | head -n1 || true)"
  wf="${wf:-_work}"
  case "$wf" in /*) ;; *) wf="$1/$wf" ;; esac
  echo "${wf%/}"
}

# When PID started, as epoch seconds; nothing if it is gone or unreadable.
proc_start_epoch() { # PID
  local age
  age="$(proc_age "$1")"
  [ -n "$age" ] || return 0
  age_to_epoch "$age"
}

cmd_compose_reap() { # [--apply] [--standalone] [--project NAME] [--max-age-hours N] [--grace-minutes N]
  local apply=false only="" max_age="$COMPOSE_REAP_MAX_AGE_HOURS" grace="$COMPOSE_REAP_GRACE_MIN"
  local standalone=false
  [ "$COMPOSE_REAP_STANDALONE" != 1 ] || standalone=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply)         apply=true; shift ;;
      --dry-run)       apply=false; shift ;;
      --standalone)    standalone=true; shift ;;
      --project)       need_val "$@"; only="$2"; shift 2 ;;
      --max-age-hours) need_val "$@"; max_age="$2"; shift 2 ;;
      --grace-minutes) need_val "$@"; grace="$2"; shift 2 ;;
      *)               die "unknown option for compose-reap: $1" ;;
    esac
  done
  [[ "$max_age" =~ ^[0-9]+$ ]] || die "--max-age-hours must be a whole number of hours, got '$max_age'"
  [[ "$grace" =~ ^[0-9]+$ ]] || die "--grace-minutes must be a whole number of minutes, got '$grace'"
  docker_available || die "$COMPOSE_REAP_NO_DOCKER"
  local problem
  problem="$(docker_daemon_problem)"
  if [ -n "$problem" ]; then
    case "$problem" in
      *[Pp]"ermission denied"*)
        # The remedy on a line of its own: a fleet row reads the first line
        # and names the remedy for the ssh login itself (fleet_error_text).
        local me
        me="$(id -un 2>/dev/null || echo USER)"
        echo "runnerctl: cannot talk to the docker daemon as $me: $problem" >&2
        die "fix: add $me to the docker group ('sudo usermod -aG docker $me', effective at its next login), or run compose-reap as root" ;;
      *)
        die "cannot talk to the docker daemon: $problem" ;;
    esac
  fi

  local now u wd wf cg pid start
  now="$(now_epoch)"
  # Runner slots: work folder -> epoch start of the job running there (empty
  # when idle or unreadable — an unreadable slot can only say "gone", so run
  # as root or the runner user to give it a voice).
  local -A slot_start=()
  while read -r u; do
    [ -n "$u" ] || continue
    wd="$(prop "$u" WorkingDirectory)"
    [ -n "$wd" ] || continue
    wf="$(runner_work_folder "$wd")"
    cg="$(prop "$u" ControlGroup)"
    start=""
    pid="$(proc_worker_pid "$cg")"
    [ -z "$pid" ] || start="$(proc_start_epoch "$pid")"
    slot_start["$wf"]="$start"
  done < <(discover)
  if $apply && [ "${#slot_start[@]}" -eq 0 ]; then
    die "no '$UNIT_GLOB' units on this host — refusing compose-reap --apply (this is not a runner host, and the age guard would take its own stacks)"
  fi

  # Inventory, grouped by project. GHR-109: each line is held to its shape by
  # compose_record; one object that fails takes its whole project out of this
  # run (`unparseable`), because a stack is reaped together or not at all.
  local -A containers=() networks=() volumes=() last=() net_last=() vol_last=() workdir=() keep=()
  local -A unparseable=() n_unparseable=()
  local projects=() project id k t line kind n_skipped=0
  compose_add_project() {
    [ -n "$1" ] || return 1
    [ -z "$only" ] || [ "$1" = "$only" ] || return 1
    [ -n "${last[$1]+x}" ] || { projects+=("$1"); last[$1]=0; net_last[$1]=0; vol_last[$1]=0; }
  }
  # KIND WHY: the record in CR_* is not used, and its project is not reaped.
  compose_unparseable() {
    case " ${unparseable[$CR_PROJECT]:-} " in
      *" $1-$2 "*) ;;
      *) unparseable[$CR_PROJECT]+="$1-$2 " ;;
    esac
    n_unparseable[$CR_PROJECT]=$(( ${n_unparseable[$CR_PROJECT]:-0} + 1 ))
  }
  for kind in container network volume; do
    while IFS= read -r line || [ -n "$line" ]; do
      compose_record "$kind" "$line"
      if [ -z "$CR_PROJECT" ]; then
        # No project to put it under: said, counted, never acted on.
        [ -z "$CR_BAD" ] || { echo "skip $kind record reason=unparseable:$CR_BAD"; n_skipped=$((n_skipped + 1)); }
        continue
      fi
      project="$CR_PROJECT"
      compose_add_project "$project" || continue
      if [ -n "$CR_BAD" ]; then compose_unparseable "$kind" "$CR_BAD"; continue; fi
      t="$(compose_epoch "$CR_CREATED")"
      # An unreadable time is 0, which the age guard would read as ancient.
      if [ "$t" -le 0 ]; then compose_unparseable "$kind" created; continue; fi
      case "$kind" in
        container)
          containers[$project]+="$CR_ID "
          start="$(compose_epoch "$CR_STARTED")"
          [ "$start" -le "$t" ] || t="$start"
          [ "$t" -le "${last[$project]}" ] || last[$project]="$t"
          [ "$CR_KEEP" != "true" ] || keep[$project]=1
          [ -z "$CR_WD" ] || workdir[$project]="$CR_WD"
          ;;
        network)
          networks[$project]+="$CR_ID "
          [ "$t" -le "${net_last[$project]}" ] || net_last[$project]="$t"
          ;;
        volume)
          volumes[$project]+="$CR_ID "
          [ "$t" -le "${vol_last[$project]}" ] || vol_last[$project]="$t"
          ;;
      esac
    done < <(case "$kind" in container) compose_containers ;; network) compose_networks ;; volume) compose_volumes ;; esac)
  done

  local mode=dry-run reaped=0 kept=0 n_removed=0 n_failed=0 p seen action reason alive dead ok bad n why
  $apply && mode=apply
  for p in ${projects[@]+"${projects[@]}"}; do
    if [ -n "${unparseable[$p]+x}" ]; then
      why="${unparseable[$p]% }"
      relay_safe "$p" plain
      printf 'skip %s reason=unparseable:%s containers=%s networks=%s volumes=%s unparseable=%s\n' \
        "$RELAY_SAFE" "${why// /,}" \
        "$(wc -w <<<"${containers[$p]:-}")" "$(wc -w <<<"${networks[$p]:-}")" "$(wc -w <<<"${volumes[$p]:-}")" \
        "${n_unparseable[$p]}"
      n_skipped=$((n_skipped + 1))
      continue
    fi
    seen="${last[$p]}"
    [ "$seen" -gt 0 ] || seen="${net_last[$p]}"
    alive="" dead=""
    if [ -n "${keep[$p]+x}" ]; then action=keep reason=label
    elif [ -z "${containers[$p]:-}${networks[$p]:-}" ]; then action=keep reason=volume-only
    elif [ $((now - seen)) -lt $((grace * 60)) ]; then action=keep reason=grace
    else
      if [[ "$p" =~ -([0-9]+)$ ]] && [ "${BASH_REMATCH[1]}" -ge "$COMPOSE_REAP_MIN_PID" ]; then
        pid="${BASH_REMATCH[1]}"
        start="$(proc_start_epoch "$pid")"
        if [ -n "$start" ] && [ "$start" -le "$seen" ]; then alive+="pid:$pid "; else dead+="pid:$pid "; fi
      fi
      if [ -n "${workdir[$p]:-}" ]; then
        for wf in "${!slot_start[@]}"; do
          case "${workdir[$p]%/}/" in
            "$wf"/*)
              start="${slot_start[$wf]}"
              if [ -n "$start" ] && [ "$start" -le "$seen" ]; then alive+="slot "; else dead+="slot "; fi
              ;;
          esac
        done
      fi
      if [ -n "$alive" ]; then action=keep reason="live:${alive% }"
      elif [ -n "$dead" ]; then action=reap reason="gone:${dead% }"
      elif [ $((now - seen)) -ge $((max_age * 3600)) ]; then action=reap reason=age
      else action=keep reason=young
      fi
    fi
    [ "$seen" -gt 0 ] || seen="${vol_last[$p]}"
    # GHR-100: a project is a label any job with docker can set to any bytes;
    # drawn through relay_safe, matched and removed by its raw value and ids.
    relay_safe "$p" plain
    printf '%s %s reason=%s idle=%sm containers=%s networks=%s volumes=%s\n' \
      "$action" "$RELAY_SAFE" "$reason" "$(( (now - seen) / 60 ))" \
      "$(wc -w <<<"${containers[$p]:-}")" "$(wc -w <<<"${networks[$p]:-}")" "$(wc -w <<<"${volumes[$p]:-}")"
    if [ "$action" != reap ]; then kept=$((kept + 1)); continue; fi
    reaped=$((reaped + 1))
    $apply || continue
    # GHR-88: a timer runs this hourly, so the record is armed by the first
    # removal, not by --apply: an hour with nothing to reap writes nothing.
    audit_begin compose-reap --apply "$($standalone && echo --standalone)"
    # GHR-137: a project's containers, networks and volumes go together.
    caller_guard
    ok=0 bad=0
    for kind in container network volume; do
      case "$kind" in
        container) n="${containers[$p]:-}" ;;
        network)   n="${networks[$p]:-}" ;;
        volume)    n="${volumes[$p]:-}" ;;
      esac
      # shellcheck disable=SC2086  # the id list is space-separated by construction
      for id in $n; do
        if compose_rm "$kind" "$id"; then ok=$((ok + 1)); else bad=$((bad + 1)); fi
      done
    done
    n_removed=$((n_removed + ok)); n_failed=$((n_failed + bad))
  done

  # Containers with no compose label (opt-in). There is no project to judge and
  # no working dir to tie to a slot, so ownership is the one question left: is
  # any job running that is older than this container? If so it may be that
  # job's, and it stays. Its image goes with it, once nothing else uses it.
  local n_standalone=0 n_images=0 cid name img image
  local -A freed_images=()
  if $standalone; then
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      compose_standalone_record "$line"
      # GHR-109: no project to take with it, so the container alone is skipped.
      if [ -z "$CR_BAD" ] && [ "$(compose_epoch "$CR_CREATED")" -le 0 ]; then CR_BAD=created; fi
      if [ -n "$CR_BAD" ]; then
        echo "skip container record reason=unparseable:$CR_BAD"
        n_skipped=$((n_skipped + 1))
        continue
      fi
      cid="$CR_ID" name="$CR_NAME" img="$CR_IMG" image="$CR_IMAGE" k="$CR_KEEP"
      [ -z "$only" ] || [ "$name" = "$only" ] || continue
      n_standalone=$((n_standalone + 1))
      seen="$(compose_epoch "$CR_CREATED")"; t="$(compose_epoch "$CR_STARTED")"
      [ "$t" -le "$seen" ] || seen="$t"
      alive=""
      for start in "${slot_start[@]}"; do
        if [ -n "$start" ] && [ "$start" -le "$seen" ]; then alive=1; break; fi
      done
      if [ "$k" = "true" ]; then action=keep reason=label
      elif [ $((now - seen)) -lt $((grace * 60)) ]; then action=keep reason=grace
      elif [ -n "$alive" ]; then action=keep reason=live:job
      elif [ $((now - seen)) -ge $((max_age * 3600)) ]; then action=reap reason=age
      else action=keep reason=young
      fi
      # The name is docker-validated; the image is the text a job asked for.
      relay_safe "$image" plain
      image="$RELAY_SAFE"
      printf '%s container %s reason=%s idle=%sm image=%s\n' "$action" "$name" "$reason" "$(( (now - seen) / 60 ))" "$image"
      if [ "$action" != reap ]; then kept=$((kept + 1)); continue; fi
      reaped=$((reaped + 1))
      $apply || continue
      audit_begin compose-reap --apply --standalone
      caller_guard # GHR-137
      if compose_rm container "$cid"; then
        n_removed=$((n_removed + 1)); freed_images[$img]="$image"
      else
        n_failed=$((n_failed + 1))
      fi
    done < <(compose_standalone)
    for img in "${!freed_images[@]}"; do
      if compose_image_in_use "$img"; then
        echo "keep image ${freed_images[$img]} reason=in-use"
      elif compose_rm image "$img"; then
        n_images=$((n_images + 1)); echo "removed image ${freed_images[$img]}"
      else
        n_failed=$((n_failed + 1)); echo "failed image ${freed_images[$img]}"
      fi
    done
  fi

  local running composed
  read -r running composed <<<"$(compose_running_counts)"
  echo "compose-reap: mode=$mode projects=${#projects[@]} reap=$reaped keep=$kept removed=$n_removed failed=$n_failed slots=${#slot_start[@]} standalone=$n_standalone images-removed=$n_images non-compose-running=$(( ${running:-0} - ${composed:-0} )) skipped=$n_skipped"
  [ "$AUDIT_VERB" != compose-reap ] || AUDIT_NOTE="removed=$n_removed failed=$n_failed images-removed=$n_images"
  [ "$n_failed" -eq 0 ]
}

# compose-reap-timer: run `compose-reap --apply` hourly from a systemd timer,
# which is the only way it covers a job that died — nothing inside the job
# survives to clean up after it. The unit runs as root and executes THIS
# runnerctl, so install refuses unless that file is root-owned and writable by
# nobody else: a root timer must never run a script its user can rewrite.
# `runnerctl install` puts it at /usr/local/bin with exactly those modes.
COMPOSE_REAP_UNIT="runnerctl-compose-reap"

render_compose_reap_service() { # RUNNERCTL-PATH
  cat <<UNIT
# Managed by runnerctl compose-reap-timer — DO NOT EDIT BY HAND.
[Unit]
Description=runnerctl: remove Docker Compose projects whose CI job is gone
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=$1 compose-reap --apply
Nice=10
UNIT
}

render_compose_reap_timer() {
  cat <<UNIT
# Managed by runnerctl compose-reap-timer — DO NOT EDIT BY HAND.
[Unit]
Description=runnerctl: hourly compose-reap

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
UNIT
}

# Prints why PATH may not run as root, or nothing when it may.
root_exec_problem() { # PATH
  local owner mode
  owner="$(stat -c %u "$1" 2>/dev/null)" || { echo "cannot stat $1"; return 0; }
  mode="$(stat -c %a "$1" 2>/dev/null)"
  [ "$owner" = 0 ] || { echo "$1 is owned by uid $owner, not root"; return 0; }
  case "${mode: -2:1}${mode: -1}" in
    *[2367]*) echo "$1 is group- or world-writable (mode $mode)" ;;
  esac
}

# Why the directory chain of PATH may not hold root's file work (GHR-121), or
# nothing when it may: "<dir>\037<what is wrong>" for the first directory from
# / downwards that root_exec_problem refuses (owner not uid 0, group- or
# world-writable — a sticky /tmp is mode 1777 and refused). Components that do
# not exist yet are skipped, since `mkdir -p` as root creates them root-owned;
# a symlink component must be root's own (its target is walked separately, by
# runner_root_problem). Reads metadata only, so it needs no privilege.
dir_chain_problem() { # PATH
  local path="$1" p="" part owner problem
  local -a parts
  problem="$(root_exec_problem /)"
  [ -z "$problem" ] || { printf '/\037%s' "$problem"; return 0; }
  IFS=/ read -ra parts <<<"${path#/}"
  for part in "${parts[@]}"; do
    [ -n "$part" ] || continue
    p+="/$part"
    if [ -L "$p" ]; then
      owner="$(stat -c %u "$p" 2>/dev/null || echo '?')"
      [ "$owner" = 0 ] || { printf '%s\037%s' "$p" "$p is a symlink owned by uid $owner, not root"; return 0; }
      continue
    fi
    [ -e "$p" ] || break
    problem="$(root_exec_problem "$p")"
    [ -z "$problem" ] || { printf '%s\037%s' "$p" "$problem"; return 0; }
  done
}

# Why DIR may not be the runner root, or nothing when it may (GHR-121).
# provision and deprovision do all of a slot's file work as root inside the
# runner root (mktemp, unpack, chown -R, the two renames, rm -rf), and every
# protection in that work assumes nobody but root can write there: whoever can
# swaps a slot's directory entry between root's calls. `mkdir -p` keeps an
# existing directory as it finds it, so the check is made here, on metadata,
# before the first privileged call — DIR itself and every parent up to /.
# The same per-directory rule as the sudo checks (root_exec_problem). The root
# itself may not be a symlink; a symlinked parent is followed and its target's
# chain checked as well as the link's own directory chain.
runner_root_problem() { # DIR
  local dir="$1" r bad msg
  r="$(runner_root_chain_problem "$dir")"
  [ -n "$r" ] || return 0
  bad="${r%%$'\037'*}"; msg="${r#*$'\037'}"
  if [ "$bad" = "$dir" ] && [[ "$msg" == *"is a symlink" ]]; then
    echo "$msg — the runner root must be a real directory (fix: use the directory it points at, root-owned and mode 755)"
    return 0
  fi
  echo "the runner root $dir is not trusted: $msg — root does all of a slot's file work inside it, so whoever can write there can swap a slot under root's calls (fix: chown root:root $bad; chmod 755 $bad, or use a --runner-root under directories only root can write)"
}

# The first thing wrong with DIR's chain as "<dir>\037<what>", or nothing: the
# part of runner_root_problem that deprovision (GHR-121) also uses, to say
# which directory it will not trust root to remove a slot from.
runner_root_chain_problem() { # DIR
  local dir="$1" r canon
  if [ -L "$dir" ]; then
    printf '%s\037%s is a symlink' "$dir" "$dir"
    return 0
  fi
  r="$(dir_chain_problem "$dir")"
  if [ -z "$r" ]; then
    canon="$(readlink -m -- "$dir" 2>/dev/null || echo "$dir")"
    [ "$canon" = "$dir" ] || r="$(dir_chain_problem "$canon")"
  fi
  printf '%s' "$r"
}

# GHR-87: whether the timer is installed here, as one line: `not installed`,
# or `installed (ENABLED, ACTIVE)` with systemctl's own words for each (empty
# answers read `unknown`). Installed means the timer's unit file is in
# SYSTEMD_DIR, which is where install writes it and remove deletes it from —
# so it needs no privilege, and `fleet compose-reap-timer status` asks it as
# the plain login.
compose_reap_timer_state() {
  local en act
  if [ ! -f "$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.timer" ]; then
    echo "not installed"
    return 0
  fi
  en="$(systemctl is-enabled "$COMPOSE_REAP_UNIT.timer" 2>/dev/null)" || true
  act="$(systemctl is-active "$COMPOSE_REAP_UNIT.timer" 2>/dev/null)" || true
  en="${en%%$'\n'*}" act="${act%%$'\n'*}"
  echo "installed (${en:-unknown}, ${act:-unknown})"
}

# The timer's `list-timers` row, for a plain `compose-reap-timer status`. A
# hook like unit_props: tests/stub.config shadows it, so the read never
# reaches the real systemctl under test (GHR-146).
compose_reap_timer_listing() {
  systemctl list-timers --all --no-pager "$COMPOSE_REAP_UNIT.timer" 2>/dev/null || true
}

cmd_compose_reap_timer() { # install|status [--brief]|remove
  local sub="${1:-status}" self problem brief=false
  shift || true
  if [ "$sub" = status ] && [ "${1:-}" = --brief ]; then brief=true; shift; fi
  [ $# -eq 0 ] || die "compose-reap-timer $sub takes no arguments"
  case "$sub" in
    install)
      require_runners
      self="$(readlink -f "$0")"
      problem="$(root_exec_problem "$self")"
      [ -z "$problem" ] || die "refusing to install a root timer that runs $self: $problem. Install runnerctl system-wide first ('runnerctl install'), then run compose-reap-timer install from that copy."
      audit_begin "compose-reap-timer install"
      # GHR-153: unit files written and the timer not enabled is a worse host
      # than either end.
      caller_guard
      render_compose_reap_service "$self" | run_priv tee "$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.service" >/dev/null
      render_compose_reap_timer | run_priv tee "$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.timer" >/dev/null
      hb_systemctl daemon-reload
      echo "Installed $COMPOSE_REAP_UNIT.{service,timer}. What the first run would do:"
      # In a subshell: a daemon that does not answer yet is the dry run's
      # `die` (GHR-87), and the timer is still worth enabling for it.
      (cmd_compose_reap) || true
      hb_systemctl enable --now "$COMPOSE_REAP_UNIT.timer"
      echo "Timer enabled (hourly, compose-reap --apply). Check it with: runnerctl compose-reap-timer status"
      ;;
    status)
      # --brief (GHR-87): the state line alone, which needs no privilege —
      # what `fleet compose-reap-timer status` asks each host for.
      echo "timer: $(compose_reap_timer_state)"
      $brief && return 0
      compose_reap_timer_listing
      run_priv journalctl -u "$COMPOSE_REAP_UNIT.service" -n 40 --no-pager
      ;;
    remove)
      audit_begin "compose-reap-timer remove"
      caller_guard # GHR-153, as install
      hb_systemctl disable --now "$COMPOSE_REAP_UNIT.timer" || true
      run_priv rm -f "$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.service" "$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.timer"
      hb_systemctl daemon-reload
      echo "Removed $COMPOSE_REAP_UNIT.{service,timer}."
      ;;
    *) die "unknown compose-reap-timer command '$sub' (install status remove)" ;;
  esac
}

# May `kill` act on the slot slot_job_facts just described? A deactivating
# unit is the wedged-stop case and always may — that is the state a hung
# `restart` leaves behind, and the one only a SIGKILL gets out of.
kill_gate() { # SHORT
  [ "$SLOT_ACTIVE" != deactivating ] || return 0
  case "$JOB_STATE" in
    running|starting) return 0 ;;
    no-access) die "$1: cannot tell whether a job is running — kill needs journal read access (systemd-journal group) or root" ;;
    none) echo "$1: not running — nothing to kill"; return 1 ;;
    *) echo "$1: no job running — nothing to kill"; return 1 ;;
  esac
}

# One slot, with its facts already in the JOB_*/SLOT_ACTIVE globals.
kill_slot() { # UNIT SHORT DRY-RUN
  local u="$1" short="$2" dry="$3" waited=0 killed
  if [ "$SLOT_ACTIVE" = deactivating ]; then
    kill_unit "$u" "$short" "$dry" "stuck stopping (${SLOT_ACTIVE}/${SLOT_SUB:-?}) — a graceful stop it will not answer"
    return 0
  fi
  job_tree_check "$JOB_CGROUP"
  if [ -z "$JOB_TREE" ]; then
    kill_unit "$u" "$short" "$dry" "cannot read the slot's processes (run as root or the runner user to kill just the job)"
    return 0
  fi
  if [ "$JOB_TREE" -eq 0 ]; then
    echo "$short: nothing but the runner itself in the slot's cgroup — nothing to kill"
    return 0
  fi
  killed="$JOB_TREE process(es): $(kill_list)"
  if $dry; then
    echo "$short: would kill $killed"
    return 0
  fi
  # shellcheck disable=SC2086  # the pids are one argument each on purpose
  run_priv kill -KILL $JOB_TREE_PIDS
  # The Listener reports the job failed on its own; poll until it has, so a
  # Listener that is wedged too is escalated rather than left behind a line
  # claiming success.
  [[ "$POLL_SEC" =~ ^[1-9][0-9]*$ ]] || die "POLL_SEC must be a positive integer (config sets '$POLL_SEC')"
  # GHR-149: under --heartbeat a line at least every N s of this wait, and no
  # pause longer than N. Without it the wait says nothing until it ends.
  local step="$POLL_SEC" said=0
  [ -z "$HEARTBEAT" ] || [ "$step" -le "$HEARTBEAT" ] || step="$HEARTBEAT"
  while :; do
    if [ -n "$HEARTBEAT" ] && [ $((waited + step - said)) -gt "$HEARTBEAT" ]; then
      echo "$short: waiting for the job to end after SIGKILL (${waited}s) …"
      said=$waited
    fi
    pause "$step"
    waited=$((waited + step))
    # Under `watch` the journal read is memoised per tick; this poll has to
    # see the new lines, not the ones the frame was drawn from.
    [ -z "$JOURNAL_MEMO_DIR" ] || rm -f -- "$JOURNAL_MEMO_DIR/$u".*
    slot_job_facts "$u"
    [ "$JOB_STATE" = running ] || break
    [ "$waited" -lt "$KILL_GRACE_SEC" ] || {
      kill_unit "$u" "$short" false "job still running ${waited}s after SIGKILL — the runner is wedged too"
      return 0
    }
  done
  echo "$short: killed $killed — the runner stayed up and reports the job failed"
}

# The escalation: systemd signals the whole cgroup, KillMode notwithstanding.
kill_unit() { # UNIT SHORT DRY-RUN WHY
  local u="$1" short="$2" dry="$3" why="$4"
  if $dry; then
    echo "$short: $why — would run systemctl kill -s KILL $u"
    return 0
  fi
  echo "$short: $why — killing the whole unit"
  hb_systemctl kill -s KILL "$u"
  echo "$short: SIGKILLed the unit's cgroup — Restart=always brings the slot back"
}

# GHR-14: a yes/no for cron/uptime probes — nothing on the host can currently
# notice "slot has been inactive/dead since Tuesday" without parsing `status`.
# Reads the same collect_slot the table and --json read (GHR-16), so the
# three surfaces cannot disagree on what a slot is doing (GHR-27).
#
# A problem is:
#   - UnitFileState=enabled and not active/activating/reloading (a disabled,
#     scaled-down slot is healthy on purpose — not a problem);
#   - NRestarts >= --max-restarts (default 5), plus the journal's last-known
#     reason when journal_restart_reason has one, or the current invocation's
#     own Result when that is not success. NRestarts is systemd's count
#     since the unit's last manual start, not "in the last hour" — there is no
#     cheap way to bucket it by wall-clock time, so that is what this reports;
#   - a job running for --stall-after seconds (default STALL_SEC) or more —
#     needs the journal or a visible Runner.Worker, like the table's cell.
#     With --restart-stalled (GHR-30) that slot is restarted on the spot
#     (through run_priv — the one case health touches the host) and the
#     line ends `— restarted`; the exit code is still 1, so a probe records
#     the event once and the next run is clean;
#   - an idle slot with leaked processes (GHR-29) — needs a readable cgroup,
#     like the table's `+N leaked`;
#   - memory pressure (PSI full avg10) at PRESSURE_CRIT_PCT or more (GHR-31)
#     — the slot is being throttled at MemoryHigh, not working. A stalled
#     line also says so from PRESSURE_WARN_PCT, which is the difference
#     between a starved job and a hung one.
# No problems: exit 0, "ok: N slot(s) healthy" (suppressed by --quiet). Any
# problem: one line each on stdout (suppressed by --quiet; the exit code is
# not), exit 1. No units at all: require_runners' existing die (not
# suppressed by --quiet — only cmd_health's own output is).
#
# --json (GHR-80): the same problems as one object, the exit code unchanged —
#   {"ok":false,"slots":3,"problems":[
#     {"host":"build-1","slot":"example.slot-1","kind":"stalled","detail":"…"}
#   ]}
# one problem per line, so `fleet health --json` reads each with the one-line
# readers. `kind` is not-running, restarts, stalled, leaked or pressure for a
# slot, disk, oom or disk-full for the host (`slot` null); `detail` is the
# prose line after its `<slot>: ` / `host: `, and `host` this host's own name.
# --quiet has nothing to quieten there, so the two are refused together.
HEALTH_KIND=() HEALTH_SLOT=() HEALTH_TEXT=()
health_add() { # KIND SLOT TEXT
  HEALTH_KIND+=("$1") HEALTH_SLOT+=("$2") HEALTH_TEXT+=("$3")
}
cmd_health() { # [--quiet] [--json] [--max-restarts N] [--stall-after N] [--restart-stalled]
  local quiet=false max_restarts=5 restart_stalled=false json=false
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --quiet)
        quiet=true; shift ;;
      --json)
        json=true; shift ;;
      --max-restarts)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--max-restarts value '$2' is invalid — want an integer"
        max_restarts="$2"; shift 2 ;;
      --stall-after)
        need_val "$@"
        set_stall_after "$2"; shift 2 ;;
      --restart-stalled)
        restart_stalled=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  ! { $json && $quiet; } || die "--quiet cannot be combined with --json; the object is the whole answer, and the exit code is the same either way"
  require_runners
  local u short n=0 nrestarts reason line repo name h_ok=0 h_bad=0 kind i sep=""
  HEALTH_KIND=() HEALTH_SLOT=() HEALTH_TEXT=()
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$n"
    n=$((n + 1))
    short="${SLOT[name]}" nrestarts="${SLOT[restarts]:-0}"
    case "${SLOT[active]}" in
      active | activating | reloading) ;;
      *)
        if [ "${SLOT[enabled]}" = enabled ]; then
          health_add not-running "$short" "enabled but ${SLOT[active]}/${SLOT[sub]} since $(since_state "${SLOT[active]}" "${SLOT[active_enter]}" "${SLOT[inactive_enter]}")"
        fi
        ;;
    esac
    if [[ "$nrestarts" =~ ^[0-9]+$ ]] && [ "$nrestarts" -ge "$max_restarts" ]; then
      line="$nrestarts restarts since last start"
      reason="${SLOT[last_restart_reason]}"
      [ -n "$reason" ] || [ "${SLOT[result]:-success}" = success ] || reason="${SLOT[result]}"
      [ -n "$reason" ] && line+=" ($reason)"
      health_add restarts "$short" "$line"
    fi
    if [ "${SLOT[job_stalled]}" = true ]; then
      # GHR-100: a job's text, drawn through relay_safe on the host that read
      # it — this line is what cron mails and what `fleet health` relays.
      relay_safe "${SLOT[job_repo]}" plain; repo="$RELAY_SAFE"
      relay_safe "${SLOT[job_name]}" plain; name="$RELAY_SAFE"
      line="stalled — job ${repo:+$repo:}${name:-?} running ${SLOT[job_runtime]}, longer than $(fmt_dur "$STALL_SEC") (--stall-after $STALL_SEC)"
      ! pressure_at_least "${SLOT[mem_pressure_full_avg10]}" "$PRESSURE_WARN_PCT" || line+=" — under memory pressure $(status_press_cell "${SLOT[mem_pressure_full_avg10]}"), throttled rather than hung"
      # GHR-30: the only privileged call health ever makes, and only here.
      if $restart_stalled; then
        # GHR-88: run from cron, so armed per slot it restarts — a clean run
        # records nothing — and the outcome is the restarts', not health's
        # exit status, which is 1 whenever there was a problem to report.
        audit_begin health --restart-stalled "$short"
        caller_guard # GHR-137
        if hb_systemctl restart "$u"; then
          line+=" — restarted"; h_ok=$((h_ok + 1))
        else
          line+=" — restart FAILED"; h_bad=$((h_bad + 1))
        fi
        AUDIT_RESULT="restarted $h_ok"
        [ "$h_bad" -eq 0 ] || AUDIT_RESULT+=", $h_bad failed"
      fi
      health_add stalled "$short" "$line"
    fi
    if [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; then
      health_add leaked "$short" "${SLOT[job_leaked]} leaked process(es) left by finished jobs (${SLOT[job_leaked_comms]//"$COMM_SEP"/, }) — runnerctl reap ${SLOT[idx]}"
    fi
    if pressure_at_least "${SLOT[mem_pressure_full_avg10]}" "$PRESSURE_CRIT_PCT"; then
      health_add pressure "$short" "under full memory pressure $(status_press_cell "${SLOT[mem_pressure_full_avg10]}") (avg10, PRESSURE_CRIT_PCT=$PRESSURE_CRIT_PCT) — throttled at MemoryHigh (${SLOT[mem_events_high]:-?} times so far), see USED vs HIGH"
    fi
  done < <(discover)
  # Host-wide trouble (GHR-64): a full fixed drive, a kernel OOM kill or a
  # disk-full line in the last EVENTS_SEC. After the slot lines, so a probe
  # that greps for a slot still finds it first.
  collect_host
  while IFS=$'\t' read -r kind line; do
    [ -z "$line" ] || health_add "$kind" "" "$line"
  done < <(host_problems)
  if $json; then
    printf '{"ok":%s,"slots":%s,"problems":[' "$([ "${#HEALTH_KIND[@]}" -eq 0 ] && echo true || echo false)" "$n"
    for i in "${!HEALTH_KIND[@]}"; do
      printf '%s\n  {"host":%s,"slot":%s,"kind":%s,"detail":%s}' "$sep" "$(json_strn "$(host_name)")" \
        "$(json_strn "${HEALTH_SLOT[$i]}")" "$(json_str "${HEALTH_KIND[$i]}")" "$(json_str "${HEALTH_TEXT[$i]}")"
      sep=","
    done
    printf '\n]}\n'
    if [ "${#HEALTH_KIND[@]}" -eq 0 ]; then return 0; fi
    return 1
  fi
  if [ "${#HEALTH_KIND[@]}" -eq 0 ]; then
    $quiet || echo "ok: $n slot(s) healthy"
    return 0
  fi
  if ! $quiet; then
    for i in "${!HEALTH_KIND[@]}"; do
      printf '%s: %s\n' "${HEALTH_SLOT[$i]:-host}" "${HEALTH_TEXT[$i]}"
    done
  fi
  return 1
}

# --- history: the records read back (GHR-88) ------------------------------------
# The journal's `runnerctl` lines, newest last, one per line as
# `<UTC time, microseconds>Z <record>` — a shape `fleet history` can merge
# across hosts by sorting on the first field.
#
# A hook, like journal_job_lines: tests/stub.config shadows it, and the real
# one is covered over a fake `journalctl` on PATH. -t, never -g: `journalctl
# -g` exits 1 when nothing matches (GHR-65), while -t with nothing to show
# exits 0 and prints nothing under -q — so a non-zero exit here is journalctl
# failing, and is reported as that, never as "no records". TZ=UTC because the
# merge compares the text.
journal_history_lines() { # N
  TZ=UTC journalctl -t runnerctl -o short-iso-precise --no-pager -q -n "$1"
}
# journalctl's short-iso-precise lines on stdin → `<time>Z <message>`. A line
# of another shape (a `-- Boot …` marker, another tag) is dropped. Anyone on
# the host can write a line with this tag (logger needs no privilege), so the
# message is drawn through relay_safe like any other text this script did not
# write.
history_parse() {
  local line ts re='^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)\+00:00 [^ ]+ runnerctl(\[[0-9]+\])?: (.*)$'
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ $re ]] || continue
    # The time first: relay_safe matches regexes of its own.
    ts="${BASH_REMATCH[1]}"
    relay_safe "${BASH_REMATCH[4]}" plain
    printf '%sZ %s\n' "$ts" "$RELAY_SAFE"
  done
}
HISTORY_NONE="no runnerctl records in the journal this login can read — a record written under sudo is root's, and reading it needs the systemd-journal or adm group"
cmd_history() { # [-n N]
  local n=20 raw rc=0 out
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      -n|--lines) need_val "$@"; n="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ "$n" =~ ^[1-9][0-9]{0,4}$ ]] || die "-n value '$n' is invalid — want a whole number from 1 to 99999"
  raw="$(journal_history_lines "$n")" || rc=$?
  [ "$rc" = 0 ] || die "could not read the journal: journalctl exited $rc"
  out="$(history_parse <<<"$raw")"
  if [ -z "$out" ]; then echo "$HISTORY_NONE" >&2; return 0; fi
  printf '%s\n' "$out"
}

# --- Fleet mode (GHR-39) ------------------------------------------------------
# One central node drives several runner hosts over ssh. The transport fans
# out WHOLE commands — one `ssh <host> runnerctl status` per host — rather
# than shimming the per-host primitives underneath. Measured (GHR-37): a
# single `status` makes 21 primitive calls against the 3-slot stub, and the
# /proc walks are per PID rather than per slot, so a primitive-level shim
# would be hundreds of round-trips on a busy slot against exactly one here.
#
# Fleet mode requires runnerctl installed on each host. Piping this script
# over stdin per call was considered and rejected: `is_piped` refuses
# everything but `install` deliberately, and version skew is better solved
# once by a fleet-wide upgrade than by paying a transfer on every command.

# Every ssh call goes through here (or ssh_run_stdin below, its twin that
# feeds a file, or ssh_control) — nothing else in this script may invoke
# ssh. That is what lets tests/stub.config shadow the transport the way it
# already shadows systemctl and journalctl, and the harness fails any call
# that bypasses the stub. The exit status is the remote command's, except
# that ssh itself answers 255 and `timeout` answers 124.
#
# BatchMode=yes is load-bearing rather than tidy: under a non-interactive
# ssh a remote sudo password prompt HANGS FOREVER, and a fan-out hangs once
# per host. With it the prompt fails fast and the host becomes a row.
#
# No ControlMaster for a ONE-SHOT command. Within one fan-out there is
# exactly one ssh per host, so multiplexing buys nothing there and it costs a
# socket directory and stale-socket handling. It pays across INVOCATIONS —
# which is exactly what a polling loop is, and what `fleet watch` opens one
# for (fleet_ssh_control_open, below); FLEET_SSH_CONTROL_OPTS is empty for
# every other command. A site that wants multiplexing for all of them adds it
# through FLEET_SSH_OPTS. ssh keeps the FIRST value it is given for an option
# (`ssh -G -o ServerAliveInterval=15 -o ServerAliveInterval=99 h` prints 15),
# so FLEET_SSH_OPTS cannot change BatchMode, ConnectTimeout or the watch's own
# sockets, which come before it — and does set the keepalive, which comes
# after it on purpose. Host key policy is deliberately left to the caller's
# ssh config rather than decided here.
#
# The keepalive (GHR-91): a host that vanishes mid-call — powered off, its
# network gone — sends nothing, and without ServerAlive* ssh waits on the TCP
# connection for as long as the budget allows, which for a mutating call is
# FLEET_MUTATE_TIMEOUT plus a wait per slot. With a probe every 15 s and 4
# unanswered ones allowed, ssh gives up after about a minute and exits 255,
# so the host is reported unreachable and the fan-out moves on. A slow but
# live host answers the probes, so a long --when-idle wait is not cut short.
# Set them in FLEET_SSH_OPTS to change them.
#
# The budget (GHR-81) is FLEET_TIMEOUT unless the caller names another for
# this one call in FLEET_CALL_TIMEOUT — which every MUTATING caller does, from
# fleet_mutate_budget. A variable rather than an argument so the signature the
# stub shadows stays HOST COMMAND..., and set per call rather than once per
# command because a budget walk interleaves status reads (short) with the
# slot actions (long) and must not lend the reads the long budget.
FLEET_CALL_TIMEOUT=""
# GHR-150: set (to FLEET_MUTATE_IDLE) around one call that is cut on silence
# rather than on its budget alone — see fleet_into.
FLEET_IDLE_ARM=""
ssh_run() { # HOST COMMAND...
  local host="$1"; shift
  timeout "${FLEET_CALL_TIMEOUT:-$FLEET_TIMEOUT}" ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    ${FLEET_SSH_CONTROL_OPTS+"${FLEET_SSH_CONTROL_OPTS[@]}"} \
    ${FLEET_SSH_OPTS+"${FLEET_SSH_OPTS[@]}"} \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=4 \
    -- "$host" "$@"
}

# The same call with FILE on the remote command's stdin (GHR-83) — the THIRD
# sanctioned ssh path, and ssh_run in every other respect: the same options,
# the same control-socket options, the same budget, the same exit statuses.
# It exists for `fleet upgrade --push`, which streams this node's own script
# to each host; ssh_run's stdin is whatever the caller's is, which a fan-out
# must never hand to a remote. A function for the same reason ssh_run is one:
# tests/stub.config shadows it, and anything reaching `ssh` itself fails a case.
ssh_run_stdin() { # HOST FILE -- COMMAND...
  local host="$1" file="$2"
  shift 2
  [ "${1:-}" != -- ] || shift
  timeout "${FLEET_CALL_TIMEOUT:-$FLEET_TIMEOUT}" ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    ${FLEET_SSH_CONTROL_OPTS+"${FLEET_SSH_CONTROL_OPTS[@]}"} \
    ${FLEET_SSH_OPTS+"${FLEET_SSH_OPTS[@]}"} \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=4 \
    -- "$host" "$@" <"$file"
}

# --- Persistent ssh for a polling loop (GHR-54) -------------------------------
# A fan-out pays a TCP connect, a key exchange and an authentication PER HOST
# PER CALL. For a one-shot `fleet status` that is invisible. For a POLL it is
# the whole problem: `watch runnerctl fleet status` against six hosts at
# watch(1)'s two-second default is around 180 full logins a minute, which
# sshd throttles at MaxStartups and fail2ban reads as an attack — and the
# rows then come back `unreachable` for a reason that has nothing to do with
# the hosts.
#
# So a polling loop opens ONE connection per host and keeps it: the first
# tick pays the handshake and every later tick is another channel on the
# same socket. This is the case ssh_run's note above says multiplexing pays
# for, and until now it was the case with no implementation.
FLEET_SSH_CONTROL_DIR=""
FLEET_SSH_CONTROL_OPTS=()

# Open the session. PERSIST-SECONDS is how long a master outlives its last
# client, and it has to comfortably exceed one tick or the gap between two
# redraws drops the connection the next redraw was about to reuse.
#
# ControlPath is `%C` — ssh's hash of (local host, remote host, port, user) —
# rather than the `%r@%h:%p` every ssh_config example shows, and that is not
# a style choice. A unix socket path is capped near 104 bytes, and ssh does
# not fail loudly when a ControlPath exceeds it: it just stops multiplexing.
# %C is a fixed 40 characters whatever the host is called, so a long hostname
# cannot silently turn the poll back into a reconnect per tick — which is the
# exact failure this command exists to remove.
fleet_ssh_control_open() { # PERSIST-SECONDS
  FLEET_SSH_CONTROL_DIR="$(mktemp -d)"
  FLEET_SSH_CONTROL_OPTS=(
    -o ControlMaster=auto
    -o "ControlPath=$FLEET_SSH_CONTROL_DIR/%C"
    -o "ControlPersist=$1"
  )
}

# Close it. Explicit rather than left to ControlPersist to expire, because
# removing the socket directory on the way out would otherwise leave one
# master per host holding a connection that nothing can reach any more, for
# the rest of the persist window. Best-effort per host: a host that never
# answered has no master to close, and that is not an error worth reporting.
fleet_ssh_control_close() {
  local host
  [ -n "$FLEET_SSH_CONTROL_DIR" ] || return 0
  for host in ${FLEET_HOSTS+"${FLEET_HOSTS[@]}"}; do
    ssh_control "$host" exit
  done
  rm -rf "$FLEET_SSH_CONTROL_DIR"
  FLEET_SSH_CONTROL_DIR=""
  FLEET_SSH_CONTROL_OPTS=()
}

# The SECOND sanctioned ssh path (ssh_run_stdin, ssh_run with a file on
# stdin, is the third, and there is no fourth): control-socket
# administration (`ssh -O`), which carries no remote command and so cannot go
# through ssh_run. Like ssh_run it is a function precisely so tests/stub.config
# can shadow it — anything that reaches `ssh` itself has bypassed the
# transport, and the harness fails the case for it.
ssh_control() { # HOST OPERATION
  ssh -o BatchMode=yes \
    ${FLEET_SSH_CONTROL_OPTS+"${FLEET_SSH_CONTROL_OPTS[@]}"} \
    -O "$2" -- "$1" >/dev/null 2>&1 || true
}

# The words a call that CHANGES a host starts with (GHR-89): `sudo -n
# FLEET_RUNNERCTL` under FLEET_SUDO=1, else FLEET_RUNNERCTL alone — into
# FLEET_PRIV, rebuilt from the settings as they are at each call. -n because a
# password prompt is a hang, which BatchMode=yes already refuses on the ssh
# side. A READ never uses it: `status`, `health`, the summary's and the facts'
# `status --json`, `version` and `upgrade --check` run as the login itself,
# whatever this says, so the narrow grant is only exercised by what needs it.
# `logs` (fleet watch's L) is the one read that does: the host's `logs` reads
# the journal through run_priv, which under the narrow grant has nothing to
# call.
FLEET_PRIV=()
fleet_priv_cmd() {
  if [ "$FLEET_SUDO" = 1 ]; then
    FLEET_PRIV=(sudo -n "$FLEET_RUNNERCTL")
  else
    FLEET_PRIV=("$FLEET_RUNNERCTL")
  fi
}

# The origin every call that changes a host carries (GHR-88): `--origin=
# OPERATOR@HOST`, right after the FLEET_PRIV words and before the verb, into
# FLEET_ORIGIN (and FLEET_ORIGIN_WORD, its one word). The operator is who runs
# this — the sudo caller or the login — and HOST this node's name, so the
# host's record says who at which central node pressed the key; the host
# itself only ever sees the shared ssh login. Checked here as the host checks
# it, and not sent at all when it would not pass: an operator whose name is
# not one plain word is still recorded here, in FLEET_LOG. Reads never carry
# it — nothing is recorded for a read.
FLEET_ORIGIN=() FLEET_ORIGIN_WORD=""
fleet_origin() {
  local o
  o="$(audit_actor)@$(host_name)"
  if origin_valid "$o"; then
    FLEET_ORIGIN_WORD="--origin=$o" FLEET_ORIGIN=("--origin=$o")
  else
    FLEET_ORIGIN_WORD="" FLEET_ORIGIN=()
  fi
}
# The heartbeat every call that changes a host asks for (GHR-150):
# `--heartbeat=N`, after the origin, into FLEET_HB (and FLEET_HB_WORD, its one
# word), with N a quarter of FLEET_MUTATE_IDLE (3600 at most, the most the
# flag takes). Within one of the remote's phases a line then comes at most N s
# apart, and across two of them at most about 2N (GHR-149), so half of the
# limit is left for the ssh round trip. Empty under FLEET_MUTATE_IDLE=0. An
# older host refuses it as it refuses --origin, and is asked again without it
# — which also puts that host back on GHR-81's total budget.
FLEET_HB=() FLEET_HB_WORD=""
fleet_heartbeat() {
  local n
  FLEET_HB=() FLEET_HB_WORD=""
  [ "$FLEET_MUTATE_IDLE" != 0 ] || return 0
  n=$((FLEET_MUTATE_IDLE / 4))
  [ "$n" -le 3600 ] || n=3600
  FLEET_HB_WORD="--heartbeat=$n" FLEET_HB=("$FLEET_HB_WORD")
}
# The budget of one mutating call whose argv is WORDS, into FLEET_CALL_TIMEOUT
# and FLEET_IDLE_ARM (the caller's locals). A call carrying the heartbeat is
# cut on FLEET_MUTATE_IDLE seconds of silence (FLEET_IDLE_ARM, read by
# fleet_into) and runs on a ceiling of FLEET_MUTATE_MAX — or BUDGET, GHR-81's
# total, when that is longer, so a long --when-idle drain is never held to
# less than it was. Any other call is on BUDGET alone, as it always was.
#
# GHR-156: FLEET_HB_INLINE=true says the heartbeat rides INSIDE the one word
# of shell text the call is (`fleet upgrade --push`'s install, where the
# pushed script's own main reads it), so it is not a word to find here — and
# not one a host can refuse: the script that reads it is this node's.
FLEET_HB_INLINE=false
fleet_idle_arm() { # BUDGET WORDS...
  local b="$1" a armed=false
  shift
  FLEET_CALL_TIMEOUT="$b" FLEET_IDLE_ARM=""
  [ -n "$FLEET_HB_WORD" ] || return 0
  if [ "$FLEET_HB_INLINE" = true ]; then
    armed=true
  else
    for a in "$@"; do
      [ "$a" != "$FLEET_HB_WORD" ] || { armed=true; break; }
    done
  fi
  $armed || return 0
  FLEET_IDLE_ARM="$FLEET_MUTATE_IDLE"
  if [ -z "$b" ] || [ "$b" -lt "$FLEET_MUTATE_MAX" ]; then FLEET_CALL_TIMEOUT="$FLEET_MUTATE_MAX"; fi
}
# One call that changes HOST, outside a fan-out — a budget walk's slot, a
# `fleet watch` key: FLEET_PRIV, the origin, the heartbeat, SUBCOMMAND and
# ARGS, stdout into OUT and stderr into ERR (each relayed, GHR-101), on BUDGET
# seconds (fleet_idle_arm). A host too old for one of the optional words is
# asked again without it, as a fan-out asks it — one word per round, since a
# parser stops at the first it does not know — and remembered. The exit
# status is left in FLEET_CALL_RC.
FLEET_CALL_RC=0
fleet_in_subshell() { ( "$@" ); }
fleet_call_mutating() { # HOST OUT ERR BUDGET SUBCOMMAND [ARGS...]
  local host="$1" out="$2" err="$3" budget="$4" rc=0 stream=false w round dropped
  local FLEET_CALL_TIMEOUT FLEET_IDLE_ARM
  shift 4
  local -a words=() kept=()
  fleet_priv_cmd
  for w in ${FLEET_ORIGIN[@]+"${FLEET_ORIGIN[@]}"} ${FLEET_HB[@]+"${FLEET_HB[@]}"}; do
    fleet_optional_skip "$host" "$w" || words+=("$w")
  done
  # GHR-92: streamed (the budget walk's slot calls) when the caller said so
  # with FLEET_STREAM; `fleet watch`'s action keys never do — their terminal
  # is the watch's.
  if $FLEET_STREAM && ! fleet_args_json "$@"; then stream=true; fi
  for round in 0 1 2; do
    rc=0
    fleet_idle_arm "$budget" ${words[@]+"${words[@]}"}
    # In a subshell, as it always was: this runs in the caller's own shell.
    fleet_into "$stream" "${FLEET_STREAM_LABEL:-$host}" "$out" "$err" \
      fleet_in_subshell ssh_run "$host" "${FLEET_PRIV[@]}" ${words[@]+"${words[@]}"} "$@" || rc=$?
    [ "$rc" = 1 ] || break
    kept=() dropped=false
    for w in ${words[@]+"${words[@]}"}; do
      if ! $dropped && fleet_optional_rejects "$err" "$w"; then
        FLEET_OPTIONAL_REJECTED+="$host=${w%%=*} "
        dropped=true
      else
        kept+=("$w")
      fi
    done
    $dropped || break
    words=(${kept[@]+"${kept[@]}"})
    : "$round"
  done
  if ! $stream; then
    relay_file "$out"
    relay_file "$err"
  fi
  FLEET_CALL_RC="$rc"
}

require_fleet() {
  [ "${#FLEET_HOSTS[@]}" -gt 0 ] || die "fleet mode is not configured — set FLEET_HOSTS=(host1 host2 ...) in $CONFIG_FILE ('runnerctl config-example' shows the block). An empty fleet is a missing config, not an empty table."
}

# Where a fan-out buffers its per-host output. Buffering is not an
# optimisation: concurrent writers interleave on a shared stdout, and half a
# line from one host inside another's JSON is unparseable.
FLEET_DIR=""
fleet_cleanup() {
  fleet_fanout_reap
  [ -z "$FLEET_DIR" ] || rm -rf "$FLEET_DIR"
  FLEET_DIR=""
}
# GHR-96: the calls of a fan-out still out, ended with everything under them
# when the process that made it is interrupted. Each host's call is a
# background job, which ignores SIGINT, and the ssh under it sits in
# `timeout`'s own process group, out of reach of a terminal's Ctrl-C — so
# without this an interrupted `fleet status` left one ssh per unanswered host
# running to its budget, writing into a buffer directory already removed.
#
# FLEET_FANOUT_PIDS holds this fan-out's jobs only while it waits for them,
# and is emptied as soon as that wait returns: fleet_cleanup also runs on a
# NORMAL exit (and after every fleet_slots read), when every job has been
# reaped and its pid may belong to anything by now. FLEET_FANOUT_OWNER is the
# process that started them, and a pid is signalled only while it is still
# that process's child — fleet_watch_reap's rule.
#
# A fan-out that CHANGES hosts is reaped the same way, deliberately: what an
# interrupt does to the HOST is the host's (GHR-91, GHR-137, GHR-153) — a
# command that has begun changing things there is caller-guarded and finishes
# what it started once its connection closes — and the README says that a
# Ctrl-C on the central node ends only the local side. Until this, that
# local side went on (measured: a `fleet start` call's ssh outlived the
# interrupted runnerctl), along with its `timeout` and its GHR-150 watchdog.
# A host on a runnerctl from before the guard stops at its next line of
# output, as the README says, rather than at its budget.
FLEET_FANOUT_PIDS=() FLEET_FANOUT_OWNER=""
fleet_fanout_reap() {
  local pid
  if [ -n "$FLEET_FANOUT_OWNER" ] && [ "$FLEET_FANOUT_OWNER" = "$BASHPID" ]; then
    for pid in ${FLEET_FANOUT_PIDS[@]+"${FLEET_FANOUT_PIDS[@]}"}; do
      [ "$(proc_ppid "$pid")" = "$BASHPID" ] || continue
      proc_tree_kill "$pid"
    done
  fi
  FLEET_FANOUT_PIDS=() FLEET_FANOUT_OWNER=""
}

# Run REMOTE-ARGS on every FLEET_HOSTS entry, at most FLEET_PARALLEL at a
# time. Each host's stdout, stderr and exit status land in their own files,
# indexed by position in FLEET_HOSTS so the render order is the config order
# rather than whichever host answered first.
#
# Version skew (GHR-56). FLEET_OPTIONAL_ARGS names the flags the caller would
# like every host to take but can do without — `status --narrow`, and since
# GHR-90 `status --with-json` — blank-separated, and a host older than one
# rejects it the way every runnerctl rejects an unknown option: `runnerctl:
# unknown option: <flag>` on stderr, exit 1. Such a host is asked again
# WITHOUT that flag in the same fan-out, so it shows its full-width table
# rather than a `remote exit 1` row, and it is remembered in
# FLEET_OPTIONAL_REJECTED, per host and per flag, so a watch does not pay that
# second round trip on every tick. A parser stops at the FIRST word it does
# not know, so a host too old for two of them refuses one per call and is
# asked once more for each. Detected by the refusal itself rather than by a
# minimum version: release-please assigns a change its version AFTER it
# merges, so a number written here would be a guess, and a probe would cost a
# round trip per host before the first frame.
FLEET_OPTIONAL_ARGS=""
FLEET_OPTIONAL_REJECTED=" "
# Per-host budgets for the fan-out in flight, indexed like FLEET_HOSTS (GHR-81).
# Empty for a read-only fan-out, which leaves every host on FLEET_TIMEOUT; a
# mutating command fills it from fleet_mutate_budget before it fans out.
FLEET_BUDGETS=()
# Whether a longer-lived session already owns the EXIT trap (GHR-74). `fleet
# watch` does: its one trap tears down the terminal, its background fetches,
# both buffer directories and the ssh masters, and a fan-out made from inside
# it — S's capacity floor — must not replace that with the removal of one
# directory. Its trap removes this fan-out's FLEET_DIR as well.
FLEET_EXIT_OWNED=false
# GHR-83: the file every host of the fan-out in flight gets on stdin, empty for
# none. Set around one fan-out by fleet_push_stage and emptied straight after.
FLEET_STDIN_FILE=""
fleet_fanout() { # REMOTE-ARGS...
  local i host running=0
  local -a retry=() pids=()
  FLEET_DIR="$(mktemp -d)"
  $FLEET_EXIT_OWNED || trap fleet_cleanup EXIT
  # GHR-96: the jobs, for fleet_cleanup to end on an interrupt.
  FLEET_FANOUT_PIDS=() FLEET_FANOUT_OWNER="$BASHPID"
  for i in "${!FLEET_HOSTS[@]}"; do
    fleet_fanout_one "$i" "$@" &
    pids+=("$!")
    FLEET_FANOUT_PIDS+=("$!")
    running=$((running + 1))
    if [ "$running" -ge "$FLEET_PARALLEL" ]; then
      wait -n 2>/dev/null || true
      running=$((running - 1))
    fi
  done
  # This fan-out's own children, by pid, and never a bare `wait` (GHR-74):
  # under `fleet watch` a host's background fetch may still be out, and a
  # bare wait would sit through that one's budget as well.
  wait "${pids[@]}" 2>/dev/null || true
  # GHR-96: every one of them reaped — nothing is left to end, and a pid
  # kept past this point could be anyone's.
  FLEET_FANOUT_PIDS=()
  # GHR-88: one optional word per round, since a host can refuse one, be
  # asked again, and only then refuse the next. At most three rounds (GHR-90):
  # the two view flags a status read carries — --narrow, --with-json — or the
  # origin and the heartbeat (GHR-150) a mutating call carries, plus --json
  # on `fleet health --restart-stalled --json` (GHR-156); no call carries
  # more.
  local round a
  for round in 1 2 3; do
    fleet_optional_any "$@" || return 0
    retry=()
    for i in "${!FLEET_HOSTS[@]}"; do
      host="${FLEET_HOSTS[$i]}"
      [ "$(fleet_rc "$i")" = 1 ] || continue
      for a in "$@"; do
        fleet_optional_is "$a" || continue
        ! fleet_optional_skip "$host" "$a" || continue
        fleet_optional_rejects "$FLEET_DIR/$i.err" "$a" || continue
        FLEET_OPTIONAL_REJECTED+="$host=${a%%=*} "
        retry+=("$i")
        break
      done
    done
    [ "${#retry[@]}" -gt 0 ] || return 0
    running=0 pids=()
    for i in "${retry[@]}"; do
      fleet_fanout_one "$i" "$@" &
      pids+=("$!")
      FLEET_FANOUT_PIDS+=("$!")
      running=$((running + 1))
      if [ "$running" -ge "$FLEET_PARALLEL" ]; then
        wait -n 2>/dev/null || true
        running=$((running - 1))
      fi
    done
    wait "${pids[@]}" 2>/dev/null || true
    FLEET_FANOUT_PIDS=()
    : "$round"
  done
}
# The optional words (GHR-56, generalised for GHR-88 and GHR-90):
# FLEET_OPTIONAL_ARGS, the flags a read would like (`--narrow`,
# `--with-json`), and FLEET_ORIGIN_WORD, the `--origin=OPERATOR@HOST` every
# call that changes a host carries. A host too old for one rejects it the way
# every runnerctl rejects what it does not know — `unknown option: --narrow`
# from a command's parser, `unknown command '--origin…'` from main, where a
# global flag lands — and is asked again without it. Only these are ever
# dropped: a word a host refuses for any other reason is that host's answer.
# A word that carries a value (`--cpu-prev=…`, GHR-115) is one of them by its
# flag name, which is also what the refusal names and what is remembered.
fleet_optional_is() { # WORD
  [ -n "$1" ] && { [[ " $FLEET_OPTIONAL_ARGS " == *" ${1%%=*} "* ]] || [ "$1" = "$FLEET_ORIGIN_WORD" ] || [ "$1" = "$FLEET_HB_WORD" ]; }
}
fleet_optional_any() { # WORDS...
  local a
  for a in "$@"; do ! fleet_optional_is "$a" || return 0; done
  return 1
}
# Whether HOST is already known to refuse WORD (by its flag name), in which
# case it is not offered again — a watch pays the second round trip once.
fleet_optional_skip() { # HOST WORD
  [[ "$FLEET_OPTIONAL_REJECTED" == *" $1=${2%%=*} "* ]]
}
# Take in what a background job found its hosts refusing (its own copy of
# FLEET_OPTIONAL_REJECTED, in FILE), so this process does not ask again.
fleet_optional_learn() { # FILE
  local w
  local -a ws=()
  [ -s "$1" ] || return 0
  read -ra ws <"$1" || true
  for w in ${ws[@]+"${ws[@]}"}; do
    [[ "$FLEET_OPTIONAL_REJECTED" == *" $w "* ]] || FLEET_OPTIONAL_REJECTED+="$w "
  done
}
fleet_optional_rejects() { # ERRFILE WORD
  local name="${2%%=*}"
  grep -qF -e "unknown option: $name" -e "unknown command '$name" -- "$1" 2>/dev/null
}
# One host's call into its three files. Runs in the background, so nothing it
# sets survives; an optional word is left out of the argv of a host already
# known to reject it.
fleet_fanout_one() { # INDEX REMOTE-ARGS...
  local i="$1" host a hrc=0 t0
  shift
  # GHR-96: a background job ignores SIGINT and SIGQUIT, stated here rather
  # than left to bash. Bash 5.3 does that even for a job of a shell whose
  # own INT is trapped (measured), but bash 5.2 (measured on Debian 12, and
  # the ubuntu-24.04 CI runner) lets the job keep the trap. A mutating
  # command's job, with the central record's trap, then ran it on a terminal's
  # Ctrl-C while it waited for its call (fleet_into_idle) and exited at
  # once. The call, its `timeout` and the ssh were re-parented to init, out
  # of fleet_fanout_reap's reach, and ran on to the budget. A job that
  # ignores the signal outlives its call until the reap ends both, and a call
  # on the watchdog takes the job's dispositions (fleet_sig_ignored) on every
  # bash alike.
  # GHR-162 made that the rule for every async process the script starts — a
  # `&` job and a `>(…)` alike, which bash 5.2 leaves at INT and QUIT's
  # default (or the parent's INT trap) where 5.3 ignores both: each sets its
  # own at its top, ignored for a worker its owner ends, and only
  # fleet_idle_run takes its caller's. tests/run.sh pins them from SigIgn.
  builtin trap '' INT QUIT
  host="${FLEET_HOSTS[$i]}"
  local -a args=()
  for a in "$@"; do
    if fleet_optional_is "$a" && fleet_optional_skip "$host" "$a"; then continue; fi
    args+=("$a")
  done
  # GHR-90: a payload left by this host's earlier try in the same fan-out (one
  # it refused a flag on) is not this call's answer.
  rm -f "$FLEET_DIR/$i.json" "$FLEET_DIR/$i.jrc" "$FLEET_DIR/$i.rc"
  # GHR-161: this host is being dialled; the record of an interrupt names it
  # until its .rc says it answered.
  : >"$FLEET_DIR/$i.dialled"
  # `|| hrc=$?` rather than a bare call plus `echo $?`: under `set -e` a
  # non-zero ssh_run kills this subshell before the status can be
  # recorded, so every failure would read as the missing-file fallback
  # and a timeout would be indistinguishable from an unreachable host.
  # GHR-80: timed around the call alone, for `duration_ms` — a host asked
  # twice (the skew retry) reports the call whose answer it is.
  t0="$(now_ms)"
  # GHR-83: a fan-out that feeds every host the same file (FLEET_STDIN_FILE,
  # `fleet upgrade --push`) goes through ssh_run_stdin; every other one has
  # nothing on stdin to give.
  # GHR-92: a fan-out that asked to STREAM (FLEET_STREAM — only the ones that
  # change a host, which run one at a time) shows each line as it arrives; a
  # `--json` call never does, its payload is for a program.
  local stream=false
  if $FLEET_STREAM && ! fleet_args_json "${args[@]}"; then stream=true; fi
  # GHR-150: a call carrying the heartbeat is cut on silence, under a ceiling.
  local FLEET_CALL_TIMEOUT FLEET_IDLE_ARM
  fleet_idle_arm "${FLEET_BUDGETS[$i]:-}" ${args[@]+"${args[@]}"}
  if [ -n "$FLEET_STDIN_FILE" ]; then
    fleet_into "$stream" "$host" "$FLEET_DIR/$i.out" "$FLEET_DIR/$i.err" \
      ssh_run_stdin "$host" "$FLEET_STDIN_FILE" -- "${args[@]}" || hrc=$?
  else
    fleet_into "$stream" "$host" "$FLEET_DIR/$i.out" "$FLEET_DIR/$i.err" \
      ssh_run "$host" "${args[@]}" || hrc=$?
  fi
  echo $(($(now_ms) - t0)) >"$FLEET_DIR/$i.ms"
  # GHR-90: the JSON a `--with-json` table carries goes where the summary's
  # second call would have put it, before the table is relayed.
  if fleet_args_with_json "${args[@]}"; then
    fleet_with_json_split "$FLEET_DIR/$i.out" "$FLEET_DIR/$i.json" "$FLEET_DIR/$i.jrc" "$hrc"
  fi
  # GHR-101: the one place a fan-out's answer lands, so every reader after it
  # — the table, the reports, the error rows — has relayable text and none
  # has the raw bytes to get wrong. A `--json` payload is data for a program,
  # passed on unparsed: fleet_payload_ok decides whether it is passed at all.
  # A streamed answer was made safe line by line on its way to the screen and
  # into these files (fleet_stream_lines), so there is nothing left to relay.
  if ! $stream; then
    relay_file "$FLEET_DIR/$i.err"
    fleet_args_json "${args[@]}" || relay_file "$FLEET_DIR/$i.out"
  fi
  echo "$hrc" >"$FLEET_DIR/$i.rc"
}

# --- Streaming a mutating call's lines (GHR-92) --------------------------------
# A read-only fan-out is buffered on purpose: its hosts run side by side, and
# half a line of one inside another's JSON is unparseable. A call that CHANGES
# hosts runs one at a time and may take a long while (GHR-81), saying useful
# things throughout (`waiting for <slot> ...` once a minute), so its lines are
# shown as they are printed instead of after the whole fleet is done.
#
# FLEET_STREAM is set around exactly those fan-outs by their callers, never
# left on: a read made in between (the slot-count read, a read-back) stays
# buffered. FLEET_STREAM_LABEL replaces the host name in the prefix (the budget
# walk's `host slot N`).
FLEET_STREAM=false
FLEET_STREAM_LABEL=""

# One stream, on stdin: each line made safe (relay_safe — what reaches the
# terminal is never the host's raw bytes, a last line without its newline
# included), kept in FILE exactly as fleet_fanout_one's buffered files hold
# it, and shown as `LABEL: line`. A stdout stream shows on stdout and a stderr
# one on stderr, so a stderr line stays distinguishable (2>file) and nothing
# that reads stdout sees it. An empty line is kept in the file and not shown,
# as the buffered report has never shown one.
fleet_stream_lines() { # LABEL FILE out|err
  local label="$1" fh line
  # GHR-162: a `>(…)` tap drains to the call's EOF; a Ctrl-C is not its to take.
  builtin trap '' INT QUIT
  exec {fh}>"$2"
  while IFS= read -r line || [ -n "$line" ]; do
    relay_safe "$line"
    printf '%s\n' "$RELAY_SAFE" >&"$fh"
    [ -n "$RELAY_SAFE" ] || continue
    if [ "$3" = err ]; then
      printf '%s: %s\n' "$label" "$RELAY_SAFE" >&2
    else
      printf '%s: %s\n' "$label" "$RELAY_SAFE"
    fi
  done
  exec {fh}>&-
}

# COMMAND... run with its stdout into OUT and its stderr into
# ERR; with STREAM = true each is a fleet_stream_lines stream (a tee: the file
# is still written), else a plain redirection. Returns the command's status and
# only returns once both streams have drained, so a reader of the files never
# sees them part-written. The descriptors are closed for the command itself, so
# nothing it starts (an ssh master that outlives it) can hold a stream open.
#
# GHR-150: with FLEET_IDLE_ARM set (fleet_idle_arm) the call is cut on silence
# instead — fleet_into_idle. Either way ERR.cut, beside the stderr file, is
# left saying how a call on the watchdog ended, and nothing for any other.
fleet_into() { # STREAM LABEL OUT ERR COMMAND...
  local stream="$1" label="$2" out="$3" err="$4" rc=0 ofd efd p1="" p2=""
  shift 4
  [ "$err" = /dev/null ] || rm -f -- "$err.cut"
  if [ -n "$FLEET_IDLE_ARM" ]; then
    fleet_into_idle "$stream" "$label" "$out" "$err" "$@" || rc=$?
    return "$rc"
  fi
  if [ "$stream" = true ]; then
    exec {ofd}> >(fleet_stream_lines "$label" "$out" out); p1=$!
    exec {efd}> >(fleet_stream_lines "$label" "$err" err); p2=$!
  else
    exec {ofd}>"$out" {efd}>"$err"
  fi
  "$@" >&"$ofd" 2>&"$efd" {ofd}>&- {efd}>&- || rc=$?
  exec {ofd}>&- {efd}>&-
  [ -z "$p1" ] || wait "$p1" "$p2" 2>/dev/null || true
  return "$rc"
}


# --- Cutting a call on silence (GHR-150) -----------------------------------------
# A host that took `--heartbeat=N` prints a line at least every N s of every
# phase that can block (GHR-149), so a call that has printed nothing for
# FLEET_MUTATE_IDLE seconds has gone wrong — whatever its total so far. A call
# that keeps printing is let run, up to the ceiling `timeout` holds it to
# (fleet_idle_arm). Three parts:
#   * the TAP — each stream goes through fleet_idle_lines, which stamps the
#     instant of every line it reads into ERR.seen, then writes it on exactly
#     as fleet_into would have (streamed, or into the file as it came). A
#     `heartbeat: … (Ns)` line is a sign of life and nothing else: it is
#     stamped and dropped, so no report, no watch line and no `--json`
#     payload carries it;
#   * the WATCHDOG — fleet_idle_watch, beside the call, waits (fleet_idle_wait,
#     a hook the sim models on its clock) until the last stamp is
#     FLEET_MUTATE_IDLE old; if it still is when it wakes, it writes
#     `idle SECS` into ERR.cut and ends the call's whole process tree
#     (proc_tree_kill: `timeout` puts ssh in a group of its own);
#   * the CALL — in the background, so the watchdog has a pid to end, with
#     the caller's own SIGINT/SIGQUIT, set explicitly (bash 5.3 would ignore
#     them in a `&` job and 5.2 hand it the caller's INT trap — GHR-162 — and
#     a budget walk's ssh has always taken an operator's Ctrl-C).
# ERR.cut says `armed CEILING [max]` from the start (`max` when the ceiling is
# FLEET_MUTATE_MAX rather than a longer GHR-81 total), so a 124 without an
# `idle` is the ceiling's, and fleet_error_text words each.
#
# The remote is not signalled — as for GHR-81's timeout, only the local ssh
# ends — so the wording says it may still be running.
FLEET_HB_LINE_RE='^heartbeat: .* \([0-9]+s\)$'
# GHR-158: a call whose first stretch CANNOT print — `fleet upgrade --push`,
# whose script goes over ssh's stdin before anything runs — names here the
# line that ends it. Until that line, STAMP says `first` rather than an
# instant: the watchdog cuts nothing and the call is held to its ceiling
# (FLEET_CALL_TIMEOUT) alone; from it, silence is counted as for any call.
# Only that line arms it, so an ssh warning on stderr during the transfer
# does not start the clock early. Empty (every other call) arms it at once.
FLEET_IDLE_FIRST=""
fleet_idle_note() { # FILE TEXT
  printf '%s\n' "$2" >"$1.$BASHPID"
  mv -f -- "$1.$BASHPID" "$1"
}
fleet_into_idle() { # STREAM LABEL OUT ERR COMMAND...
  local stream="$1" label="$2" out="$3" err="$4" rc=0 ofd efd p1 p2 cpid wpid ign
  shift 4
  local FLEET_IDLE_STAMP="$err.seen"
  if [ "$FLEET_CALL_TIMEOUT" = "$FLEET_MUTATE_MAX" ]; then
    fleet_idle_note "$err.cut" "armed $FLEET_CALL_TIMEOUT max"
  else
    fleet_idle_note "$err.cut" "armed $FLEET_CALL_TIMEOUT"
  fi
  if [ -n "$FLEET_IDLE_FIRST" ]; then
    fleet_idle_note "$FLEET_IDLE_STAMP" first
  else
    fleet_idle_note "$FLEET_IDLE_STAMP" "$(now_epoch)"
  fi
  ign="$(fleet_sig_ignored)"
  exec {ofd}> >(fleet_idle_lines "$stream" "$label" "$out" out "$FLEET_IDLE_STAMP" "$FLEET_IDLE_FIRST"); p1=$!
  exec {efd}> >(fleet_idle_lines "$stream" "$label" "$err" err "$FLEET_IDLE_STAMP" "$FLEET_IDLE_FIRST"); p2=$!
  fleet_idle_run "$ign" "$@" >&"$ofd" 2>&"$efd" {ofd}>&- {efd}>&- &
  cpid=$!
  fleet_idle_watch "$cpid" "$FLEET_IDLE_ARM" "$FLEET_IDLE_STAMP" "$err.cut" </dev/null >/dev/null 2>&1 {ofd}>&- {efd}>&- &
  wpid=$!
  wait "$cpid" || rc=$?
  kill -KILL "$wpid" 2>/dev/null || true
  wait "$wpid" 2>/dev/null || true
  exec {ofd}>&- {efd}>&-
  wait "$p1" "$p2" 2>/dev/null || true
  if [ "$rc" != 0 ] && [[ "$(cat "$err.cut" 2>/dev/null || true)" == "idle "* ]]; then rc=124; fi
  rm -f -- "$FLEET_IDLE_STAMP"
  return "$rc"
}
# Which of SIGINT and SIGQUIT this process ignores: `int`, `quit`, both or
# neither, from /proc (neither where it cannot be read).
fleet_sig_ignored() {
  local k v out=""
  while read -r k v; do
    [ "$k" = SigIgn: ] || continue
    [ $((16#$v & 2)) = 0 ] || out+=" int"
    [ $((16#$v & 4)) = 0 ] || out+=" quit"
  done <"/proc/$BASHPID/status" 2>/dev/null || true
  echo "$out"
}
# COMMAND with the dispositions IGNORED names (fleet_sig_ignored) and every
# other one of SIGINT/SIGQUIT back at its default.
fleet_idle_run() { # IGNORED COMMAND...
  # GHR-162: the one job that takes its caller's INT/QUIT, set here both ways,
  # so a budget walk's ssh still takes a Ctrl-C on bash 5.2 and 5.3 alike.
  [[ "$1" == *int* ]] || builtin trap - INT
  [[ "$1" == *quit* ]] || builtin trap - QUIT
  shift
  "$@"
}
# One stream of a call on the watchdog: every line stamped into STAMP, a
# heartbeat line dropped, the rest written on as fleet_into writes it — with
# STREAM = true as fleet_stream_lines does (made safe, kept in FILE, shown as
# `LABEL: line`), else into FILE as it came, a last line without its newline
# included (relay_file makes it safe once the call is over).
#
# GHR-158: with FIRST, a line is stamped only once the call is armed — this
# tap read FIRST, or STAMP no longer says `first` (the other tap read it).
fleet_idle_lines() { # STREAM LABEL FILE out|err STAMP [FIRST]
  local stream="$1" label="$2" stamp="$5" first="${6:-}" fh line nl
  # GHR-162: a `>(…)` tap drains to the call's EOF; a Ctrl-C is not its to take.
  builtin trap '' INT QUIT
  exec {fh}>"$3"
  while :; do
    nl=true
    if ! IFS= read -r line; then
      [ -n "$line" ] || break
      nl=false
    fi
    if [ -n "$first" ] && [ "$line" != "$first" ] && [ "$(cat "$stamp" 2>/dev/null || true)" = first ]; then
      :
    else
      first=""
      fleet_idle_note "$stamp" "$(now_epoch)"
    fi
    [[ ! "$line" =~ $FLEET_HB_LINE_RE ]] || continue
    if [ "$stream" != true ]; then
      if $nl; then printf '%s\n' "$line" >&"$fh"; else printf '%s' "$line" >&"$fh"; fi
      continue
    fi
    relay_safe "$line"
    printf '%s\n' "$RELAY_SAFE" >&"$fh"
    [ -n "$RELAY_SAFE" ] || continue
    if [ "$4" = err ]; then
      printf '%s: %s\n' "$label" "$RELAY_SAFE" >&2
    else
      printf '%s: %s\n' "$label" "$RELAY_SAFE"
    fi
  done
  exec {fh}>&-
}
# The watchdog: until the last line in STAMP is IDLE seconds old, then (CPID
# still running) `idle SECS` into MARK and CPID's tree ended. Returns as soon
# as CPID is gone; fleet_into_idle ends it once the call has.
#
# GHR-158: while STAMP says `first` (FLEET_IDLE_FIRST) nothing is counted:
# it looks again a second later, until the arming line is stamped.
fleet_idle_watch() { # CPID IDLE STAMP MARK
  local last now
  # GHR-162: a worker — fleet_into_idle KILLs it, and it returns once CPID has.
  builtin trap '' INT QUIT
  while :; do
    last="$(cat "$3" 2>/dev/null || true)"
    if [ "$last" = first ]; then
      fleet_idle_wait $(($(now_epoch) + 1)) "$1" "$3" || return 0
      continue
    fi
    [[ "$last" =~ ^[0-9]+$ ]] || return 0
    fleet_idle_wait $((last + $2)) "$1" "$3" || return 0
    now="$(now_epoch)"
    last="$(cat "$3" 2>/dev/null || true)"
    [[ "$last" =~ ^[0-9]+$ ]] || return 0
    [ $((now - last)) -ge "$2" ] || continue
    kill -0 "$1" 2>/dev/null || return 0
    fleet_idle_note "$4" "idle $((now - last))"
    proc_tree_kill "$1"
    return 0
  done
}
# Until the clock reaches EPOCH; 1 at once when CPID has gone. A hook, so the
# sim can model the wait on its stub clock, in step with the remote's lines
# (STAMP names the call; tests/stub.config).
fleet_idle_wait() { # EPOCH CPID STAMP
  while [ "$(now_epoch)" -lt "$1" ]; do
    kill -0 "$2" 2>/dev/null || return 1
    sleep 1 >/dev/null 2>&1
  done
}

# fleet_fanout with its lines streamed. Only for a fan-out that changes hosts.
fleet_fanout_stream() { # REMOTE-ARGS...
  local rc=0
  FLEET_STREAM=true
  fleet_fanout "$@" || rc=$?
  FLEET_STREAM=false
  return "$rc"
}
# Whether a remote command line asks for `--json`.
fleet_args_json() { # ARGS...
  local a
  for a in "$@"; do [ "$a" != --json ] || return 0; done
  return 1
}
# Whether it asks for `--with-json` (GHR-90) — a host that refused the flag
# was asked again without it, so this is per call, not per fan-out.
fleet_args_with_json() { # ARGS...
  local a
  for a in "$@"; do [ "$a" != --with-json ] || return 0; done
  return 1
}

# GHR-90: one `status --with-json` answer in OUT, split in place. Everything
# before the first line that starts with 0x1e (STATUS_JSON_SEP) stays in OUT —
# the table, read as any table answer is — and everything after it goes to
# JSON, with JRC the status a separate `status --json` call would have left:
#
#   0  the call exited 0 and JSON is a whole object: it opens with `{` and
#      its last line is the object's closing `]}`
#   1  the call exited 0 but there is no separator, or the object after it
#      was cut short — the host answered, its table is what it is, and it
#      has no summary to give this time (as a `status --json` that exited
#      non-zero has none)
#
# A call that exited non-zero leaves neither file: its table call failed, and
# nothing reads a payload for it. The separator is matched on its first byte
# alone, so a host that appends to every line it prints (a wrapper, a login
# banner's tail) still splits where it should.
fleet_with_json_split() { # OUT JSON JRC RC
  local at
  at="$(LC_ALL=C grep -an -m1 $'^\x1e' -- "$1" 2>/dev/null || true)"
  at="${at%%:*}"
  if [ -n "$at" ]; then
    tail -n "+$((at + 1))" -- "$1" >"$2"
    head -n "$((at - 1))" -- "$1" >"$1.table"
    mv -f -- "$1.table" "$1"
  fi
  if [ "$4" != 0 ]; then
    rm -f -- "$2"
    return 0
  fi
  if [ -n "$at" ] && [ "$(head -c 1 -- "$2")" = "{" ] && [[ "$(tail -n 1 -- "$2")" == "]}"* ]]; then
    echo 0 >"$3"
  else
    : >"$2"
    echo 1 >"$3"
  fi
}

fleet_rc() { # INDEX
  cat "$FLEET_DIR/$1.rc" 2>/dev/null || echo 255
}

# Whether the host answered at all, as a JSON boolean. The distinction this
# draws is the one that matters operationally: ssh could not reach the host
# (255) or the call ran out of time (124) — nothing is known about it — versus
# the remote runnerctl running fine and exiting non-zero, which on a
# runner-less host is its own perfectly good message and not a fleet fault.
#
# `late` is `fleet watch`'s own (GHR-74), never an exit status: the host's call
# has not come back — it has not answered at all yet, or a tick came due with
# its call from an earlier one still out. Nothing is known about it either.
fleet_reachable() { # RC
  case "$1" in 124|255|late) echo false ;; *) echo true ;; esac
}

# What a timed-out MUTATING call adds to `timed out after Ns` (GHR-81).
# `timeout` kills the local ssh, not the remote runnerctl. Since GHR-91 a
# guarded command there (caller_guard) runs to the end and records how it
# ended, which `fleet history --host H` reads; one from before carries on
# until it next writes to its closed stdout. Either way the host may be
# part-way through or about to finish, and "nothing is known about it" is the
# one thing an operator must not read into the row.
FLEET_TIMEOUT_STILL_RUNNING="the command may still be running on that host; 'runnerctl fleet status --host @HOST@' shows where it got to"

# BUDGET is the seconds the call was given, for the timed-out wording; empty
# means FLEET_TIMEOUT, the read-only budget. MUTATING (any non-empty word)
# says the call was changing things on the host, which adds the sentence above.
fleet_error_text() { # RC ERRFILE [BUDGET [MUTATING [HOST]]]
  local rc="$1" err="" hint="" budget="${3:-$FLEET_TIMEOUT}" still=""
  # GHR-93: the wording names the host, so the command it points at can be
  # pasted as it stands. HOST is the host the call ran on.
  [ -z "${4:-}" ] || still=" — ${FLEET_TIMEOUT_STILL_RUNNING//@HOST@/${5:-H}}"
  [ ! -s "$2" ] || err="$(head -1 "$2")"
  # An accurate error that leaves the reader to work out the fix is half a
  # message. Name the remedy where it is read.
  #
  # The bootstrap failures below are told apart by the shell's own exit codes
  # rather than by matching English, because they are genuinely different
  # faults with different fixes, and a row saying only "remote exit 127" sends
  # someone to reinstall runnerctl on a host that already has it.
  #
  # Probed rather than assumed (GHR-50): a root-owned 0700 OR 0711 script on
  # PATH fails 126 "Permission denied" naming the FULL PATH, and only a name
  # that resolves to nothing fails 127 on the BARE NAME. So the 0700/0711
  # install this project shipped in 0.9.0-0.10.0 (GHR-47) is the 126 row,
  # never the 127 one.
  #
  # And 127 is NOT "not installed". `ssh host runnerctl` runs no login shell,
  # so it never reads ~/.profile — on Ubuntu that is what adds ~/.local/bin
  # and ~/bin, and a runnerctl installed there works perfectly when the same
  # user logs in and is invisible to the fan-out. Hence "not on the PATH for a
  # non-interactive ssh login" rather than "not installed", and hence
  # FLEET_RUNNERCTL named as the fix that does not move any files.
  #
  # First match wins, and the order matters: `sudo: runnerctl: command not
  # found` carries both signatures and is a PATH fault, not a sudo refusal.
  case "$rc:$err" in
    127:*|*"command not found"*)
      # `command not found` is safe to match as text: runnerctl never says it,
      # so this cannot swallow a remote error of its own. A bare "not found"
      # would — systemctl says "Unit ... not found" through this same pipe.
      hint=" — runnerctl is not on that host's PATH for a non-interactive ssh login (which reads no ~/.profile, so ~/.local/bin and ~/bin are not on it); set FLEET_RUNNERCTL to its absolute path, or install it system-wide with 'curl -fsSL $UPGRADE_URL | sudo bash -s -- install'" ;;
    *"unknown program"*|*"applet not found"*)
      # A multicall binary (uutils, busybox) answering to the name. Both
      # phrases are dispatcher signatures that runnerctl cannot produce, so
      # matching them as text costs nothing.
      hint=" — a multicall binary answered to that name instead of runnerctl; check what FLEET_RUNNERCTL resolves to on that host, and that the real runnerctl is readable by the ssh login" ;;
    126:*)
      hint=" — runnerctl is installed on that host but the ssh login cannot execute it; 'sudo chmod 755' the path it names, or re-run the installer" ;;
    *"ermission denied while trying to connect to the "[Dd]ocker*)
      # GHR-87: docker's own words for a user outside the docker group (the
      # socket is root:docker 0660), which compose-reap passes on. Ahead of
      # the sudo row: the fix is a group, not a sudoers line. A call that
      # went through FLEET_SUDO=1 runs as root and never gets this.
      hint=" — the ssh login is not in that host's docker group: add it there ('sudo usermod -aG docker <login>', effective at its next login); a compose-reap --apply under FLEET_SUDO=1 runs as root and needs no group" ;;
    *sudo:*|*"a password is required"*|*"may not run"*|*"no tty present"*)
      # The single most likely failure of a mutating fan-out. BatchMode=yes is
      # what makes this a failure to report at all rather than a fan-out hung
      # on a password prompt.
      #
      # GHR-89: under FLEET_SUDO=1 the only sudo in the call is the `sudo -n`
      # in front of runnerctl (a remote running as root never asks for
      # another), so a refusal here is the sudoers line not granting that
      # path — usually because it names a different one than FLEET_RUNNERCTL
      # resolves to. sudo says only "a password is required" for that.
      if [ "$FLEET_SUDO" = 1 ]; then
        hint=" — FLEET_SUDO=1 runs 'sudo -n $FLEET_RUNNERCTL …' there and sudo refused it: that host's sudoers line must grant NOPASSWD the exact absolute path sudo resolves '$FLEET_RUNNERCTL' to (set FLEET_RUNNERCTL to that path); see 'The narrow sudo contract' in the README"
      else
        hint=" — the ssh login needs passwordless sudo on that host; see the fleet section of the README for the exact sudoers line"
      fi ;;
  esac
  case "$rc" in
    0)   echo "" ;;
    late) echo "waiting for its first answer" ;;
    124)
      # GHR-150: a call on the watchdog says which limit it met — the
      # silence, or the ceiling — from ERRFILE.cut (fleet_into_idle).
      local cut=""
      [ ! -s "$2.cut" ] || cut="$(head -1 "$2.cut")"
      case "$cut" in
        "idle "*)  echo "timed out — no line from it for ${cut#idle }s (FLEET_MUTATE_IDLE)$still${err:+ — $err}" ;;
        "armed "*" max")
          cut="${cut#armed }"
          echo "timed out after ${cut% max}s, the FLEET_MUTATE_MAX ceiling$still${err:+ — $err}" ;;
        "armed "*) echo "timed out after ${cut#armed }s$still${err:+ — $err}" ;;
        *)         echo "timed out after ${budget}s$still${err:+ — $err}" ;;
      esac ;;
    255)
      # GHR-138: ssh's own keepalive giving up (GHR-91), as opposed to a
      # connect failure. For a call that changes things the connection was up
      # and the remote may have started acting, so "unreachable" (nothing is
      # known) is the wrong word. The match is on ssh's text; a connect
      # failure says "connect to host" / "Could not resolve" and keeps the row.
      if [ -n "${4:-}" ] && [[ "$err" == *"Timeout, server "*" not responding"* ]]; then
        echo "connection lost mid-call — the host may have acted; 'runnerctl fleet status --host ${5:-H}' shows where it got to and 'runnerctl fleet history --host ${5:-H}' what it recorded — $err"
      else
        echo "unreachable${err:+ — $err}"
      fi ;;
    *)   echo "remote exit $rc${err:+ — $err}$hint" ;;
  esac
}

# A host's payload is only nested verbatim when it actually looks like the
# object it claims to be. rc 0 with something else on stdout would otherwise
# produce invalid fleet JSON, and a consumer would blame the fleet tool.
#
# GHR-101: nor when it carries a raw control byte other than a newline or a
# tab. JSON has none inside a string and json_str escapes every one, so such a
# payload is not this script's JSON — and `fleet status --json` is read on a
# terminal as often as by a program, where an ESC in it would act.
fleet_payload_ok() { # INDEX
  [ -s "$FLEET_DIR/$1.out" ] && [ "$(head -c 1 "$FLEET_DIR/$1.out")" = "{" ] && ! fleet_payload_ctl "$1"
}
fleet_payload_ctl() { # INDEX
  LC_ALL=C grep -aq $'[\001-\010\013-\037\177]' "$FLEET_DIR/$1.out"
}

# `fleet status --json`: each host's own payload nested UNCHANGED inside an
# envelope. This is why fleet mode needs no JSON parser and keeps the
# script's zero-jq dependency — the remote object is already valid, so it is
# concatenated, never re-serialised, and cannot be corrupted in transit.
#
# GHR-80: keys ADDED, never moved — every existing key keeps its place, and
# each new one comes after the last existing one at its level, so a consumer
# that read the envelope before reads it the same way:
#
#   per host   `duration_ms` — how long its call took, measured here around
#              ssh_run (fleet_fanout_one, fleet_watch_fetch_one); a call that
#              timed out reports its budget, a call still out null.
#              `stale` — true when `status` is an EARLIER answer kept by
#              `--watch` for a host that is not answering now (as `fleet
#              watch` keeps its rows, dimmed); always false one-shot.
#              `last_seen` — epoch seconds of the payload in `status`, null
#              when there is none.
#   top level  `generated_at` (now_epoch, when the envelope was assembled),
#              `runnerctl` (this node's version) and `summary`
#              (fleet_summary_json: the GHR-72 line's numbers, counted by
#              the same fleet_summary_count, over exactly the payloads nested
#              above — a stale one is not counted, as a host that did not
#              answer counts towards `hosts` only).
fleet_status_json() {
  local i host rc sep="" bad=0 err ok stale now seen
  now="$(now_epoch)"
  printf '{"fleet":['
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    ok=false stale=false seen=""
    if [ "$rc" = 0 ] && fleet_payload_ok "$i"; then
      ok=true
    elif [ "$(fleet_reachable "$rc")" = false ] && [ -s "$FLEET_DIR/$i.seen" ] && fleet_payload_ok "$i"; then
      stale=true
    fi
    $ok || bad=$((bad + 1))
    if $ok || $stale; then
      seen="$(cat "$FLEET_DIR/$i.seen" 2>/dev/null || echo "$now")"
    fi
    # A host that exited 0 with something other than an object gets an error
    # of its own rather than a bare null status: exit 0, reachable, no error
    # and no payload is the one combination a consumer cannot interpret.
    if [ "$rc" = 0 ] && ! $ok && [ -s "$FLEET_DIR/$i.out" ] && fleet_payload_ctl "$i"; then
      err="exit 0 but stdout carries raw control bytes, which no runnerctl JSON does — check FLEET_RUNNERCTL and the remote login's output"
    elif [ "$rc" = 0 ] && ! $ok; then
      err="exit 0 but no JSON object on stdout — check FLEET_RUNNERCTL and the remote login's output"
    elif $stale && [ "$rc" = late ]; then
      err="no answer yet this tick — its call is still running"
    else
      err="$(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}")"
    fi
    printf '%s\n  {"host_name":%s,"reachable":%s,"exit_code":%s,"error":%s,"status":' \
      "$sep" "$(json_str "$host")" "$(fleet_reachable "$rc")" "$(json_num "$rc")" \
      "$(json_strn "$err")"
    if $ok || $stale; then cat "$FLEET_DIR/$i.out"; else printf 'null'; fi
    printf ',"duration_ms":%s,"stale":%s,"last_seen":%s}' "$(fleet_duration_ms "$i" "$rc")" "$stale" "$(json_num "$seen")"
    sep=","
  done
  fleet_summary_count out rc nested
  printf '\n],"generated_at":%s,"runnerctl":%s,"summary":%s}\n' \
    "$(json_num "$now")" "$(json_str "$RUNNERCTL_VERSION")" "$(fleet_summary_json)"
  [ "$bad" -eq 0 ]
}
# A host's `duration_ms`: what fleet_fanout_one / fleet_watch_fetch_one wrote
# to <i>.ms, its budget when the call timed out (a timed-out call took exactly
# that long, as far as anyone here can say), null while a call is still out.
fleet_duration_ms() { # INDEX RC
  case "$2" in
    124)
      num_int "${FLEET_BUDGETS[$1]:-$FLEET_TIMEOUT}"
      if [ -n "$NUM_INT" ]; then echo $((NUM_INT * 1000)); else echo null; fi ;;
    late) echo null ;;
    *)    json_num "$(cat "$FLEET_DIR/$1.ms" 2>/dev/null || true)" ;;
  esac
}

# `fleet status`: every host's already-rendered rows with a HOST column
# prefixed on. Prefixing only — the remote table is NEVER parsed by column
# position, because a cell longer than its width shifts everything after it
# on that row (`active/running ↻3 (last: oom-kill)` does). Adding on the left
# is safe whatever the row does to its right.
#
# Line position IS reliable, unlike column position: the remote `status`
# prints its version header, a blank, the column header, then one row per
# slot, and any note lines last.
#
# FLEET_REMOTE_COLOR says whether the remote was asked to paint. `fleet
# status` asks for --color never and paints locally; `fleet watch` (GHR-54)
# asks for --color always, because the only thing that knows a cell is
# STALLED or running is the host that drew it. Everywhere this renderer reads
# a remote line BY CONTENT it therefore has to read the stripped text, or a
# painted `note:` line stops looking like a note and is printed as a slot row
# on every host instead of being collected and deduped once.
FLEET_REMOTE_COLOR=false

# The host line (GHR-66): what a remote's header carries after its
# `Host: <cores, RAM>` fragment — `Disk: …` and `last 1h: …` (GHR-64) —
# printed once per host above its slots. Cut from the RAW line, so the
# remote's own colours survive under `fleet watch`: host_header_suffix joins
# its fragments with an unpainted " — " and host_line never contains one, so
# the first " — " after "Host: " is where the suffix starts. A host older
# than 0.16.0 has no suffix and gets no line.
fleet_host_info() { # RAW-HEADER-LINE
  local rest="${1#* — Host: }"
  [ "$rest" != "$1" ] || return 0
  [[ "$rest" == *" — "* ]] || return 0
  rest="${rest#* — }"
  # `fleet status` asks for --color never and paints here (GHR-67): the host
  # line is repainted from its own percentages, against THIS node's
  # thresholds. Under `fleet watch` the remote already painted it.
  if ! $FLEET_REMOTE_COLOR && [ -n "$C_RESET" ]; then
    rest="$(fleet_host_info_paint "$rest")"
  fi
  printf '%s\n' "$rest"
}
# A plain host line, painted: the "load L/N" cell by load_level (GHR-79), each
# "MOUNT [ROLES] PCT% (FREE free)" cell by disk_color and the "last …:" events
# red, as host_header_suffix does it.
fleet_host_info_paint() { # PLAIN-INFO
  local info="$1" disks="" events="" out="" cell load=""
  local -a cells=()
  # GHR-79: `load 14.2/16` leads the line from a host that reports it,
  # repainted from its two numbers against this node's ratios.
  if [[ "$info" == "load "* ]]; then
    load="${info%% — *}"
    if [[ "$info" == *" — "* ]]; then info="${info#* — }"; else info=""; fi
    if [[ "$load" =~ ^load\ ([0-9.]+)/([0-9]+)$ ]]; then
      load_level "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
      case "$LOAD_LEVEL" in crit) cell="$C_RED" ;; warn) cell="$C_YELLOW" ;; *) cell="$C_GREEN" ;; esac
      load="$(paint "$cell" "$load")"
    fi
  fi
  case "$info" in
    "Disk: "*)
      disks="${info#Disk: }"
      if [[ "$disks" == *" — "* ]]; then events="${disks#* — }"; disks="${disks%% — *}"; fi ;;
    *) events="$info" ;;
  esac
  if [ -n "$disks" ]; then
    while IFS= read -r cell; do
      [ -n "$cell" ] || continue
      if [[ "$cell" =~ \ ([0-9]+)%\ \( ]]; then cell="$(paint "$(disk_color "${BASH_REMATCH[1]}")" "$cell")"; fi
      cells+=("$cell")
    done <<<"${disks//, /$'\n'}"
    out="Disk: $(join_by ", " "${cells[@]}")"
  fi
  [ -z "$events" ] || out+="${out:+ — }$(paint "$C_RED" "$events")"
  [ -z "$load" ] || out="$load${out:+ — $out}"
  printf '%s\n' "$out"
}
# --- A host's runnerctl version, against this node's (GHR-77) -----------------
# Every host line leads with the version the host reported, and it is
# compared with THIS node's RUNNERCTL_VERSION as well as with the other
# hosts': a fleet uniformly one release behind the node driving it is level
# with itself and still skewed — and that is the skew that bites, because
# this node forwards flags the hosts may not know.
#
# The version comes off a remote's first line (or its --json payload), so it
# is another host's text: it is held to X.Y.Z here before it is drawn or
# compared, and anything else is UNKNOWN — drawn `?`, and skew. A runnerctl
# older than GHR-32 leads its header with `Host:` and has no version to read
# at all; it is unknown too, which makes the oldest hosts the loudest.
#
# The comparison is version_lt's (`sort -V`, what `upgrade` uses), never a
# string compare: 0.9.0 is behind 0.10.0.
FLEET_VER=""
fleet_ver() { # TEXT
  if [ "${#1}" -le 32 ] && valid_runner_version "$1"; then FLEET_VER="$1"; else FLEET_VER="?"; fi
}
# Which side of this node a validated VERSION is on, into FLEET_SIDE: same,
# behind, ahead or unknown.
FLEET_SIDE=""
fleet_ver_side() { # VERSION
  if [ "$1" = "?" ]; then FLEET_SIDE=unknown
  elif [ "$1" = "$RUNNERCTL_VERSION" ]; then FLEET_SIDE=same
  elif version_lt "$1" "$RUNNERCTL_VERSION"; then FLEET_SIDE=behind
  else FLEET_SIDE=ahead
  fi
}
# The version cell a host line starts with: `v0.20.0`, or `?` for unknown —
# plain when it is this node's version, yellow when it is not.
fleet_ver_cell() { # VERSION
  local t="v$1"
  [ "$1" != "?" ] || t="?"
  if [ "$1" = "$RUNNERCTL_VERSION" ]; then printf '%s\n' "$t"; else paint "$C_YELLOW" "$t"; fi
}

# A host line as it appears in the assembled frame: the HOST cell, then the
# version cell, alone or followed by ` · ` and the Disk / events fragment —
# never a slot (no IDX) and never a host that did not answer, so `fleet
# watch`'s cursor must not stop on it. The version cell and this pattern
# change together (GHR-77).
FLEET_INFO_RE='^[^ ]+ +(v[0-9]+\.[0-9]+\.[0-9]+|\?)( · |$)'

# --- Rows kept from a host that stopped answering (GHR-74) --------------------
# `fleet watch` keeps what each host last returned. A host that then cannot be
# reached, runs out of time, or whose call is still out when the next tick
# comes due, used to lose its rows to one red error row — at exactly the
# moment an operator wants to know what that box was running. Its rows now
# stay, dimmed, under a line saying how old they are and why:
#
#   build-3 no answer for 45s — last seen 14:02:10 — unreachable — ssh: …
#   build-3 0 example.slot-1 …
#
# The age is counted from the last time the host returned a table (its
# `.seen`, written with now_epoch when that answer was taken in), to the
# moment the frame is assembled; `last seen` is that same instant as a clock
# time. The rows are DISPLAY ONLY. The summary line and S's capacity floor
# both read the host's latest exit status, which says it is not answering, and
# count nothing for it.
#
# Only `fleet watch` writes a `.seen`, so a one-shot `fleet status` — which has
# no earlier answer to show — draws the bare error row it always drew. So does
# a host that answered and whose runnerctl then exited non-zero: that is the
# host's own account of itself (its runners are gone, say), not silence, and
# old rows under it would contradict it.
#
# The line as it appears in the assembled frame — the HOST cell, then `no
# answer for`. Not a slot, and its host's rows follow it, so `fleet watch`'s
# cursor must not stop on it (as for a host line).
FLEET_STALE_RE='^[^ ]+ +no answer for '
fleet_stale_line() { # INDEX RC
  local seen why
  seen="$(cat "$FLEET_DIR/$1.seen")"
  case "$2" in
    late) why="its call is still running" ;;
    *)    why="$(fleet_error_text "$2" "$FLEET_DIR/$1.err" "${FLEET_BUDGETS[$1]:-}")" ;;
  esac
  printf 'no answer for %s — last seen %s — %s\n' \
    "$(fmt_dur $(($(now_epoch) - seen)))" "$(date -d "@$seen" +%H:%M:%S)" "$why"
}

# --- How long a host took to answer (GHR-95) ----------------------------------
# `fleet watch` shows it on the host line — `answered in 3.2s` — only when it
# is worth reading: from FLEET_ANSWER_SHOW_PCT percent of the host's budget
# (FLEET_BUDGETS, else FLEET_WATCH_TIMEOUT) up, so a healthy fleet's frame
# grows no number, and yellow from FLEET_ANSWER_WARN_PCT, where the next slow
# tick is a timeout. Both fixed: nobody has asked to tune them. The number is
# the one `fleet status --json` reports as `duration_ms` — read through
# fleet_duration_ms from the same <i>.ms file, so the two cannot disagree.
FLEET_ANSWER_SHOW_PCT=25 FLEET_ANSWER_WARN_PCT=75
fleet_answer_note() { # INDEX
  local ms budget
  ms="$(fleet_duration_ms "$1" 0)"
  [[ "$ms" =~ ^[0-9]+$ ]] || return 0
  num_int "${FLEET_BUDGETS[$1]:-$FLEET_WATCH_TIMEOUT}"
  budget="${NUM_INT:-0}"
  [ "$budget" -gt 0 ] || return 0
  [ $((ms * 100)) -ge $((budget * 1000 * FLEET_ANSWER_SHOW_PCT)) ] || return 0
  local text="answered in $((ms / 1000)).$((ms % 1000 / 100))s"
  if [ $((ms * 100)) -ge $((budget * 1000 * FLEET_ANSWER_WARN_PCT)) ]; then
    paint "$C_YELLOW" "$text"
  else
    printf '%s\n' "$text"
  fi
}

fleet_status_table() {
  local i host rc hostw=4 ver="" bad=0 n=0 hdr="" stale v sudo_frag
  local -a lines notes=() skew_order=() skew_parts=() sudo_full=() sudo_unrep=() sudo_parts=()
  # GHR-77: hosts whose version is not this node's, by version, in the order
  # each version was first seen.
  local -A skew_hosts=()
  for host in "${FLEET_HOSTS[@]}"; do
    [ "${#host}" -le "$hostw" ] || hostw="${#host}"
  done
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    stale=false
    if [ "$rc" != 0 ]; then
      bad=$((bad + 1))
      if [ "$(fleet_reachable "$rc")" = false ] && [ -s "$FLEET_DIR/$i.seen" ]; then
        # GHR-74: its last table is still in $i.out — a failed call replaces
        # the exit status and the error, never the rows.
        stale=true
      else
        # The budget the call was given, where the caller named one per host
        # (`fleet watch` does): a timed-out row must quote the right number.
        printf '%-*s %s\n' "$hostw" "$host" \
          "$(paint "$C_RED" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}")")"
        continue
      fi
    fi
    mapfile -t lines <"$FLEET_DIR/$i.out"
    # A zero-status host that produced no table is still a failed row rather
    # than an unbound-variable crash two lines down: `set -u` makes
    # ${lines[0]} on an empty mapfile fatal, and the header and column-header
    # lines are only there to index if the remote actually printed a table.
    if [ "${#lines[@]}" -lt 3 ]; then
      $stale || bad=$((bad + 1))
      printf '%-*s %s\n' "$hostw" "$host" \
        "$(paint "$C_RED" "no status table returned")"
      continue
    fi
    # A version read off rows this old says nothing about skew today.
    if ! $stale; then
      strip_sgr "${lines[0]}"
      ver=""
      if [[ "$SGR_STRIPPED" == "runnerctl "* ]]; then
        ver="${SGR_STRIPPED#runnerctl }"; ver="${ver%% *}"
      fi
      fleet_ver "$ver"; ver="$FLEET_VER"
      if [ "$ver" != "$RUNNERCTL_VERSION" ]; then
        [ -n "${skew_hosts[$ver]+x}" ] || skew_order+=("$ver")
        skew_hosts[$ver]+="${skew_hosts[$ver]:+, }$host"
      fi
    fi
    # The column header is printed once, from the first host that answered —
    # and again whenever a host's differs from the one above it (GHR-56): a
    # host too old for `status --narrow` answers with the full-width table
    # among narrow ones, and its rows under a narrow header would put every
    # value after ENABLED under the wrong column name.
    strip_sgr "${lines[2]}"
    if [ "$n" -eq 0 ] || [ "$SGR_STRIPPED" != "$hdr" ]; then
      hdr="$SGR_STRIPPED"
      if $FLEET_REMOTE_COLOR; then
        # The remote drew its own column header bold and ended it with a
        # reset, so wrapping the whole line would switch bold off partway
        # along and leave the rest plain. Only the HOST cell is ours to paint.
        printf '%s %s\n' "$(paint "$C_BOLD" "$(printf '%-*s' "$hostw" "HOST")")" "${lines[2]}"
      else
        paint "$C_BOLD" "$(printf '%-*s %s' "$hostw" "HOST" "${lines[2]}")"
      fi
    fi
    n=$((n + 1))
    local l info
    # GHR-113: under FLEET_SUDO=1, a host without the opt-in. Not for kept
    # rows: what a host said half a minute ago is not its contract today.
    sudo_frag=""
    if ! $stale; then
      fleet_sudo_state "$i"
      case "$FSC_STATE" in
        full)       sudo_full+=("$host") sudo_frag="no SUDO_CONTRACT=narrow" ;;
        unreported) sudo_unrep+=("$host") sudo_frag="SUDO_CONTRACT not reported" ;;
      esac
    fi
    if $stale; then
      # Where the host line would be: the age line, and no Disk/OOM line —
      # those facts are as old as the rows and would not be dimmed by them.
      printf '%-*s %s\n' "$hostw" "$host" "$(paint "$C_RED" "$(fleet_stale_line "$i" "$rc")")"
    else
      # GHR-77: the version cell, then the Disk / events fragment. A host
      # with no fragment (older than 0.16.0, or nothing to report) still
      # gets the line when its version is not this node's.
      info="$(fleet_host_info "${lines[0]}")"
      # GHR-95: `fleet watch` only (it is the one with a state directory) —
      # how long the host took, when that is worth reading. It is ours, so it
      # is appended after the remote's (already relayed) text and never
      # relayed or parsed itself; a host with no other fragment gets it as
      # the fragment, so the line is still `HOST VERSION · …` for
      # FLEET_INFO_RE.
      local note="" tail=""
      [ -z "$FW_STATE" ] || note="$(fleet_answer_note "$i")"
      if [ -n "$info" ]; then tail=" · $info"; fi
      # GHR-113: ours too, and what makes `fleet watch`'s `!` view have a line
      # to keep for a host that is otherwise level with this node.
      if [ -n "$sudo_frag" ]; then
        sudo_frag="$(paint "$C_YELLOW" "$sudo_frag")"
        if [ -n "$tail" ]; then tail+=" — $sudo_frag"; else tail=" · $sudo_frag"; fi
      fi
      if [ -n "$note" ]; then
        if [ -n "$tail" ]; then tail+=" — $note"; else tail=" · $note"; fi
      fi
      if [ -n "$tail" ] || [ "$ver" != "$RUNNERCTL_VERSION" ]; then
        printf '%-*s %s%s\n' "$hostw" "$host" "$(fleet_ver_cell "$ver")" "$tail"
      fi
    fi
    for l in "${lines[@]:3}"; do
      strip_sgr "$l"
      case "$SGR_STRIPPED" in
        note:*) notes+=("$l") ;;
        '')     ;;
        *)
          if $stale; then
            # The whole row dim, the remote's own colours taken off first: a
            # red STALLED from half a minute ago is not a current alarm.
            paint "$C_DIM" "$(printf '%-*s %s' "$hostw" "$host" "$SGR_STRIPPED")"
          else
            printf '%-*s %s\n' "$hostw" "$host" "$l"
          fi ;;
      esac
    done
  done
  # Notes are per-fleet, not per-host: the same note from six hosts is one
  # fact about the fleet, and six copies of it buries the rows above.
  if [ "${#notes[@]}" -gt 0 ]; then
    printf '%s\n' "${notes[@]}" | sort -u
  fi
  # GHR-77: skew is any answering host not on THIS node's version — which
  # also covers two hosts that differ from each other. The note names them,
  # grouped by version and with the side they are on, and points at the
  # fleet-wide command (GHR-41), which shows what an upgrade would change.
  if [ "${#skew_order[@]}" -gt 0 ]; then
    for v in "${skew_order[@]}"; do
      host="${skew_hosts[$v]}"
      ver=runs
      [[ "$host" != *", "* ]] || ver=run
      if [ "$v" = "?" ]; then
        skew_parts+=("$host $ver no version this node can read")
      else
        fleet_ver_side "$v"
        skew_parts+=("$host $ver $v ($FLEET_SIDE)")
      fi
    done
    paint "$C_YELLOW" "note: $(join_by "; " "${skew_parts[@]}") — this node runs $RUNNERCTL_VERSION; 'runnerctl fleet upgrade --check' shows what would change"
  fi
  # GHR-113: FLEET_SUDO=1 here relies on the narrow contract's two halves; the
  # opt-in is the one this node can read. Hosts that say `full` and hosts that
  # say nothing it can read are different facts (one is a choice, the other an
  # older runnerctl or an unreadable config), so they are worded apart, and
  # both are named — only the host's name is quoted, never its payload.
  if [ "${#sudo_full[@]}" -gt 0 ]; then
    sudo_parts+=("$(join_by ", " "${sudo_full[@]}") report$([ "${#sudo_full[@]}" -gt 1 ] || echo s) SUDO_CONTRACT full")
  fi
  if [ "${#sudo_unrep[@]}" -gt 0 ]; then
    sudo_parts+=("$(join_by ", " "${sudo_unrep[@]}") do$([ "${#sudo_unrep[@]}" -gt 1 ] || echo es) not report a SUDO_CONTRACT this node can read")
  fi
  if [ "${#sudo_parts[@]}" -gt 0 ]; then
    paint "$C_YELLOW" "note: FLEET_SUDO=1 runs 'sudo -n runnerctl …' on every host, and without SUDO_CONTRACT=narrow in the host's /etc/runnerctl/config that grant is root-equivalent — $(join_by "; " "${sudo_parts[@]}"); set it there (a host that reports nothing may need 'runnerctl fleet upgrade' first; 'The narrow sudo contract' in the README)"
  fi
  [ "$bad" -eq 0 ]
}

# --- Fleet summary line (GHR-72) ----------------------------------------------
# One line of totals for the two questions a central operator asks first — is
# anything wrong, and how much capacity is left:
#
#   6/7 hosts answering · 22 slots: 14 busy, 6 idle, 1 STALLED, 1 down · 2 leaking · capacity 6 free of 21 · 3 versions
#
# Under the header in `fleet watch`, the last line of `fleet status`.
#
# The counts come from each host's `status --json`, NEVER from the table the
# line sits next to: that table is not parsed by column position (see
# fleet_status_table), and a count read off a painted cell would be exactly
# that. GHR-90: the table call is `status --with-json`, so a host answers both
# in ONE call from ONE collection — the rows and the counts describe the same
# moment, and the host walks its slots once. fleet_with_json_split leaves that
# payload in <i>.json / <i>.jrc, exactly where the second call below would.
#
# The second call stays, as the fallback for a host too old for the flag: it
# refused it, was asked again without it (fleet_fanout's skew rule), and so
# has a table and no payload. Only such a host is asked — one whose table call
# exited 0 and left no <i>.jrc — so a host that is down is waited on once per
# tick, not twice. (The other one-call form, two commands on one remote
# command line, depends on what the remote login shell makes of the line and
# still collects twice — GHR-72 rejected it.) `status --json` has been there
# since long before `fleet`, so every host that can draw the table can
# answer it.
fleet_summary_fetch() { # STATUS-ARGS...
  local i running=0
  for i in "${!FLEET_HOSTS[@]}"; do
    [ "$(fleet_rc "$i")" = 0 ] || continue
    [ ! -e "$FLEET_DIR/$i.jrc" ] || continue
    fleet_summary_fetch_one "$i" "$@" &
    running=$((running + 1))
    if [ "$running" -ge "$FLEET_PARALLEL" ]; then
      wait -n 2>/dev/null || true
      running=$((running - 1))
    fi
  done
  wait
}
# One host's payload and exit status, beside its table in FLEET_DIR. In the
# background, like fleet_fanout_one, and `|| hrc=$?` for the same reason.
fleet_summary_fetch_one() { # INDEX STATUS-ARGS...
  local i="$1" hrc=0
  shift
  # GHR-162: a worker, as fleet_fanout_one is.
  builtin trap '' INT QUIT
  ssh_run "${FLEET_HOSTS[$i]}" "$FLEET_RUNNERCTL" status --json "$@" >"$FLEET_DIR/$i.json" 2>/dev/null || hrc=$?
  echo "$hrc" >"$FLEET_DIR/$i.jrc"
}

# COUNT and its noun, the noun plural unless COUNT is 1.
fleet_plural() { # COUNT NOUN
  if [ "$1" -eq 1 ]; then echo "$1 $2"; else echo "$1 $2s"; fi
}

# The line itself, from what fleet_fanout and fleet_summary_fetch left in
# FLEET_DIR. What each number means:
#
#   hosts     answering / configured, by fleet_reachable — on the table call,
#             and on the --json call when one was made, so a host that dropped
#             out between the two is not answering. A host that did not answer
#             is in this count AND NOTHING ELSE: its slots are unknown, not
#             down (the rule fleet_slots follows).
#   slots     every slot is exactly one of: STALLED, busy or idle when its
#             unit is active (a job past the stall threshold, a job, none);
#             disabled or down when it is not (UnitFileState disabled, or
#             anything else — failed, activating, stopped by hand).
#   leaking   slots whose finished job left processes behind.
#   disk      hosts with a partition at DISK_CRIT_PCT / DISK_WARN_PCT — THIS
#             node's thresholds, as `fleet status` paints the host line —
#             each host counted once, at its worst partition.
#   events    hosts with an OOM kill or a disk-full line in their window.
#   overloaded hosts whose 1-minute load is LOAD_CRIT_RATIO × their cores or
#             more — THIS node's ratio (GHR-79). Only the red level is
#             counted: a build pool at WARN (every core busy) is a pool doing
#             its job, not one an operator has to look at.
#   capacity  idle slots, of the active ones: what can take a job right now.
#   versions  distinct runnerctl versions, THIS node's among them (GHR-77),
#             when there is more than one; a version that is not X.Y.Z, or
#             none at all, is one more (`?`).
#
# A segment whose count is zero is left out, so a healthy fleet is a short
# line — except capacity, which is printed whenever there are slots: `0 free`
# is the one zero an operator most needs to see.
#
# Slots are read one per line with json_line_get, on the footing fleet_slots
# and fleet_watch_facts read them: render_status_json writes each slot on a
# line of its own and this script owns that emitter.
#
# GHR-75: WHAT a slot or a host is, is decided in the two classifiers below
# and nowhere else. The summary counts by them and `fleet watch`'s filters
# show by them, so a slot the summary calls STALLED is a slot the problems
# view keeps — one reading of the JSON, not two that can drift apart.

# One slot line of `status --json`, classified, into SC_*:
#
#   SC_NAME     the RUNNER cell, which is what a frame row is matched on
#   SC_STATE    stalled | busy | idle (its unit is active: a job past the
#               stall threshold, a job, none), disabled | down (it is not:
#               UnitFileState disabled, or anything else — failed, stopped by
#               hand, activating between two restarts)
#   SC_LEAKING  a finished job left processes behind
#   SC_PROBLEM  true when it is what an operator is looking for: stalled,
#               down, leaking, at or over MemoryHigh (where the table paints
#               USED red), or memory pressure at PRESSURE_CRIT_PCT. A DISABLED
#               slot is not one: somebody scaled it away on purpose, which is
#               why the summary dims it rather than painting it red.
#   SC_SINCE    when its job started (epoch), SC_MEM its MemoryCurrent in
#               bytes, SC_JOB the job as `repo:name` — each empty when the
#               host does not say, which is every idle slot for the first.
#
# No subshell: `fleet watch` runs this for every slot of every host.
SC_NAME="" SC_STATE="" SC_LEAKING=false SC_PROBLEM=false SC_SINCE="" SC_MEM="" SC_JOB=""
fleet_slot_classify() { # SLOT-LINE
  local job=null high
  SC_STATE="" SC_LEAKING=false SC_PROBLEM=false SC_SINCE="" SC_MEM="" SC_JOB=""
  [[ ! "$1" =~ \"job\":(.*),\"idle_since\": ]] || job="${BASH_REMATCH[1]}"
  json_line_get "$1" name; SC_NAME="$JF"
  json_line_get "$1" active
  if [ "$JF" != active ]; then
    json_line_get "$1" enabled
    if [ "$JF" = disabled ]; then SC_STATE=disabled; else SC_STATE=down SC_PROBLEM=true; fi
  elif [ "$job" = null ]; then
    SC_STATE=idle
  else
    json_line_get "$job" stalled
    if [ "$JF" = true ]; then SC_STATE=stalled SC_PROBLEM=true; else SC_STATE=busy; fi
  fi
  if [ "$job" != null ]; then
    # GHR-104: each number below is the host's; a test on one that is no
    # number prints an error into the frame, so it is read through num_int.
    json_line_get "$job" since
    num_int "$JF"; SC_SINCE="$NUM_INT"
    json_line_get "$job" repo; SC_JOB="$JF"
    json_line_get "$job" name; SC_JOB="${SC_JOB:+$SC_JOB:}$JF"
  fi
  json_line_get "$1" leaked_procs
  num_int "$JF"
  if [ -n "$NUM_INT" ] && [ "$NUM_INT" -gt 0 ]; then SC_LEAKING=true SC_PROBLEM=true; fi
  json_line_get "$1" memory_current
  num_int "$JF"; SC_MEM="$NUM_INT"
  json_line_get "$1" memory_high; num_int "$JF"; high="$NUM_INT"
  if [ -n "$SC_MEM" ] && [ -n "$high" ] && [ "$high" -gt 0 ] && [ "$SC_MEM" -ge "$high" ]; then
    SC_PROBLEM=true
  fi
  # A percentage with decimals, which only awk compares — asked for a slot
  # that reports any pressure at all, not for the many that report 0.00.
  json_line_get "$1" full_avg10
  if [[ "$JF" =~ [1-9] ]] && pressure_at_least "$JF" "$PRESSURE_CRIT_PCT"; then SC_PROBLEM=true; fi
}

# The first line of a `status --json` payload — the one carrying the host
# object — classified, into HC_*: HC_VER its runnerctl version, held to X.Y.Z
# by fleet_ver (`?` for anything else, GHR-77); HC_DISK `crit`
# or `warn` at its WORST partition against this node's DISK_CRIT_PCT /
# DISK_WARN_PCT, empty below both; HC_EVENTS true with an OOM kill or a
# disk-full line in its window.
#
# GHR-79: HC_LOAD `crit` or `warn` for its 1-minute load against its cores
# and this node's LOAD_CRIT_RATIO / LOAD_WARN_RATIO, empty below both or
# when either is missing — or no number this node takes: both are the host's
# text, held to dec_hundredths and num_int (`016` cores is not 14, nor 16).
#
# GHR-113: HC_SUDO the host's `sudo_contract`, exactly `narrow` or `full` as
# the host wrote it, else `unreported` — a host from before the key, a null (it
# could not read its default config) and any other text alike. The text is the
# host's, so it is compared and never kept or drawn. First occurrence, which
# is safe: the key is the last of `host`, and every string before it is
# escaped by json_str, so no text of the host's can spell a bare
# `"sudo_contract":`. It must also be a JSON string, which json_line_get alone
# does not say (`narrow` bare is a keyword to it).
HC_VER="" HC_DISK="" HC_EVENTS=false HC_LOAD="" HC_SUDO=""
fleet_host_classify() { # HOST-LINE
  local line="$1" lvl n m l1=""
  HC_DISK="" HC_EVENTS=false HC_LOAD="" HC_SUDO=unreported
  json_line_get "$line" sudo_contract
  case "$JF" in
    narrow|full) [[ "$line" != *"\"sudo_contract\":\"$JF\""* ]] || HC_SUDO="$JF" ;;
  esac
  json_line_get "$line" runnerctl; fleet_ver "$JF"; HC_VER="$FLEET_VER"
  [[ ! "$line" =~ \"load\":\[([^],]*), ]] || l1="${BASH_REMATCH[1]}"
  json_line_get "$line" cores
  load_level "$l1" "$JF"; HC_LOAD="$LOAD_LEVEL"
  while [[ "$line" =~ \"use_pct\":([0-9]+) ]]; do
    m="${BASH_REMATCH[0]}"
    num_int "${BASH_REMATCH[1]}"
    lvl="$(disk_level "$NUM_INT")"
    line="${line#*"$m"}"
    case "$lvl" in crit) HC_DISK=crit ;; warn) [ -n "$HC_DISK" ] || HC_DISK=warn ;; esac
  done
  # What is left of the line is past the disks: the events object.
  json_line_get "$line" oom_kills; num_int "$JF"; n="$NUM_INT"
  json_line_get "$line" disk_full; num_int "$JF"
  if { [ -n "$n" ] && [ "$n" -gt 0 ]; } || { [ -n "$NUM_INT" ] && [ "$NUM_INT" -gt 0 ]; }; then
    HC_EVENTS=true
  fi
}

# GHR-113: what host INDEX says about its sudo contract, into FSC_STATE, for
# the table's note and host line: narrow | full | unreported, or empty when
# there is nothing to judge — FLEET_SUDO is not 1 (the contract is then not
# what this node relies on, so no host is flagged and nothing is read), or the
# host's `status --json` call (fleet_summary_fetch's, in $FLEET_DIR/<i>.json)
# did not answer: its table is all there is, and a host that cannot be asked
# is not one to call unopted. A payload that answered but whose first line is
# not the host line fleet_host_classify reads is unreported, as an older host
# whose first line is `{"host":` is.
FSC_STATE=""
fleet_sudo_state() { # INDEX
  local line=""
  FSC_STATE=""
  [ "$FLEET_SUDO" = 1 ] || return 0
  [ "$(cat "$FLEET_DIR/$1.jrc" 2>/dev/null || echo 255)" = 0 ] || return 0
  IFS= read -r line <"$FLEET_DIR/$1.json" || true
  case "$line" in
    '{"runnerctl":'*) fleet_host_classify "$line"; FSC_STATE="$HC_SUDO" ;;
    *)                FSC_STATE=unreported ;;
  esac
}

# `6 slots: 2 busy, 2 idle, 1 STALLED, 1 down` — the summary's slot segment,
# and what a collapsed host says about itself in `fleet watch` (GHR-75). The
# table's own colours: status_job_color for a job, a leak and an idle slot,
# status_active_color for a unit that is not active, the ENABLED cell's dim
# for a disabled one. A state nobody is in is left out.
fleet_states_text() { # SLOTS BUSY IDLE STALLED DOWN DISABLED
  local line
  local -a states=()
  [ "$2" -eq 0 ] || states+=("$(paint "$C_GREEN" "$2 busy")")
  [ "$3" -eq 0 ] || states+=("$(paint "$C_DIM" "$3 idle")")
  [ "$4" -eq 0 ] || states+=("$(paint "$C_BOLD$C_RED" "$4 STALLED")")
  [ "$5" -eq 0 ] || states+=("$(paint "$C_RED" "$5 down")")
  [ "$6" -eq 0 ] || states+=("$(paint "$C_DIM" "$6 disabled")")
  line="$(fleet_plural "$1" slot)"
  [ "${#states[@]}" -eq 0 ] || line+=": $(join_by ", " "${states[@]}")"
  printf '%s\n' "$line"
}

# GHR-80: the counting, once, for both renderings — the line below and the
# `summary` object of `fleet status --json`. Into the SUM array:
#   hosts answering slots busy idle stalled down disabled leaking
#   disk_crit disk_warn events overloaded versions
# PAYLOAD and RC name the files each host's `status --json` and its exit
# status are in: `json jrc` for the table's own second call (the line), `out
# rc` where the payload IS the call (`fleet status --json`, whose table call
# and payload call are one — so `rc` doubles as the payload's status). With
# NESTED (any third word) a host whose payload the envelope does not nest
# (fleet_payload_ok) answered and contributes nothing more: the summary
# counts exactly what the envelope carries.
declare -A SUM=()
fleet_summary_count() { # PAYLOAD RC [NESTED]
  local i rc jrc line hv
  local -A vers=()
  SUM=([hosts]="${#FLEET_HOSTS[@]}" [answering]=0 [slots]=0 [busy]=0 [idle]=0 [stalled]=0 [down]=0
       [disabled]=0 [leaking]=0 [disk_crit]=0 [disk_warn]=0 [events]=0 [overloaded]=0 [versions]=0)
  for i in "${!FLEET_HOSTS[@]}"; do
    rc="$(fleet_rc "$i")"
    [ "$(fleet_reachable "$rc")" = true ] || continue
    # Reached, but its runnerctl exited non-zero (a runner-less host): it
    # answered, and was not asked for a payload.
    if [ "$rc" != 0 ]; then SUM[answering]=$((SUM[answering] + 1)); continue; fi
    jrc="$(cat "$FLEET_DIR/$i.$2" 2>/dev/null || echo 255)"
    [ "$(fleet_reachable "$jrc")" = true ] || continue
    SUM[answering]=$((SUM[answering] + 1))
    [ "$jrc" = 0 ] || continue
    [ -z "${3:-}" ] || fleet_payload_ok "$i" || continue
    hv=false
    while IFS= read -r line; do
      case "$line" in
        '{"runnerctl":'*)
          fleet_host_classify "$line"
          vers[$HC_VER]=1 hv=true
          case "$HC_DISK" in crit) SUM[disk_crit]=$((SUM[disk_crit] + 1)) ;; warn) SUM[disk_warn]=$((SUM[disk_warn] + 1)) ;; esac
          [ "$HC_LOAD" != crit ] || SUM[overloaded]=$((SUM[overloaded] + 1))
          ! $HC_EVENTS || SUM[events]=$((SUM[events] + 1)) ;;
        '  {"idx":'*)
          SUM[slots]=$((SUM[slots] + 1))
          fleet_slot_classify "$line"
          case "$SC_STATE" in
            busy|idle|stalled|disabled) SUM[$SC_STATE]=$((SUM[$SC_STATE] + 1)) ;;
            *)                          SUM[down]=$((SUM[down] + 1)) ;;
          esac
          ! $SC_LEAKING || SUM[leaking]=$((SUM[leaking] + 1)) ;;
      esac
    done <"$FLEET_DIR/$i.$1"
    # GHR-77: a payload with no version line (a runnerctl older than GHR-32
    # starts it with `{"host":`) is a host whose version is unknown, as the
    # table calls it.
    $hv || vers["?"]=1
  done
  # GHR-77: this node's version is one of them whenever a host answered, so
  # a fleet level with itself but behind this node counts 2 — the segment
  # and the table's skew note ask the same question (any host not on this
  # node's version), each from its own call to the host.
  [ "${#vers[@]}" -eq 0 ] || vers[$RUNNERCTL_VERSION]=1
  SUM[versions]="${#vers[@]}"
}

fleet_summary_line() {
  local line active
  local -a seg=()
  fleet_summary_count json jrc
  line="${SUM[answering]}/${SUM[hosts]} host$([ "${SUM[hosts]}" -eq 1 ] || echo s) answering"
  if [ "${SUM[answering]}" -lt "${SUM[hosts]}" ]; then seg+=("$(paint "$C_RED" "$line")"); else seg+=("$line"); fi
  if [ "${SUM[answering]}" -gt 0 ]; then
    seg+=("$(fleet_states_text "${SUM[slots]}" "${SUM[busy]}" "${SUM[idle]}" "${SUM[stalled]}" "${SUM[down]}" "${SUM[disabled]}")")
  fi
  [ "${SUM[leaking]}" -eq 0 ] || seg+=("$(paint "$C_YELLOW" "${SUM[leaking]} leaking")")
  [ "${SUM[disk_crit]}" -eq 0 ] || seg+=("$(paint "$C_RED" "$(fleet_plural "${SUM[disk_crit]}" host) disk crit")")
  [ "${SUM[disk_warn]}" -eq 0 ] || seg+=("$(paint "$C_YELLOW" "$(fleet_plural "${SUM[disk_warn]}" host) disk warn")")
  [ "${SUM[events]}" -eq 0 ] || seg+=("$(paint "$C_RED" "$(fleet_plural "${SUM[events]}" host) OOM/disk-full")")
  [ "${SUM[overloaded]}" -eq 0 ] || seg+=("$(paint "$C_RED" "$(fleet_plural "${SUM[overloaded]}" host) overloaded")")
  if [ "${SUM[slots]}" -gt 0 ]; then
    active=$((SUM[busy] + SUM[idle] + SUM[stalled]))
    line="capacity ${SUM[idle]} free of $active"
    if [ "${SUM[idle]}" -eq 0 ]; then seg+=("$(paint "$C_YELLOW" "$line")"); else seg+=("$line"); fi
  fi
  [ "${SUM[versions]}" -le 1 ] || seg+=("$(paint "$C_YELLOW" "${SUM[versions]} versions")")
  join_by " · " "${seg[@]}"
}

# The `summary` object of `fleet status --json` (GHR-80), from the same count
# as the line: every number the line can show, each always present — a zero
# is a zero here, where the line leaves the segment out. `capacity_total` is
# the active slots (busy, idle, stalled), `capacity_free` the idle ones.
fleet_summary_json() {
  printf '{"hosts":%s,"hosts_answering":%s,"slots":%s,"busy":%s,"idle":%s,"stalled":%s,"down":%s,"disabled":%s,"leaking":%s' \
    "${SUM[hosts]}" "${SUM[answering]}" "${SUM[slots]}" "${SUM[busy]}" "${SUM[idle]}" "${SUM[stalled]}" \
    "${SUM[down]}" "${SUM[disabled]}" "${SUM[leaking]}"
  printf ',"disk_crit_hosts":%s,"disk_warn_hosts":%s,"event_hosts":%s,"overloaded_hosts":%s,"capacity_free":%s,"capacity_total":%s,"versions":%s}' \
    "${SUM[disk_crit]}" "${SUM[disk_warn]}" "${SUM[events]}" "${SUM[overloaded]}" \
    "${SUM[idle]}" "$((SUM[busy] + SUM[idle] + SUM[stalled]))" "${SUM[versions]}"
}

cmd_fleet() {
  local sub="${1:-status}"
  shift || true
  # GHR-88: the command as typed, for the central node's record.
  FLEET_ARGV=("$sub" "$@")
  case "$sub" in
    status)  cmd_fleet_status "$@" ;;
    watch)   cmd_fleet_watch "$@" ;;
    health)  cmd_fleet_health "$@" ;;
    history) cmd_fleet_history "$@" ;;
    upgrade) cmd_fleet_upgrade "$@" ;;
    apply|scale|start|stop|restart|drain|kill|reap|remove-limits|enable|disable)
             cmd_fleet_run "$sub" "$@" ;;
    # GHR-87: a dry run fans out read-only and in parallel; --apply goes
    # through cmd_fleet_run like every other command that changes a host.
    compose-reap)       cmd_fleet_compose_reap "$@" ;;
    compose-reap-timer) cmd_fleet_compose_reap_timer "$@" ;;
    # env-init is PERMANENTLY excluded, not merely unimplemented: it writes an
    # EnvironmentFile of secrets, and fanning it out means pushing secrets
    # over ssh. `logs` stays per-host because it streams (`fleet watch`'s L
    # pages one slot's last lines, which is not a stream). Saying which of the
    # two it is beats "unknown command".
    env-init)
             die "fleet env-init is not supported and will not be: it writes an EnvironmentFile of secrets, which fanning out means copying secrets over ssh. Run 'runnerctl env-init' on each host." ;;
    # provision is excluded for env-init's reason plus one of its own: it
    # takes a registration token, so fanning it out pushes a credential over
    # ssh to every host — and each host needs its own runner names, which a
    # single fleet-wide command cannot supply.
    provision)
             die "fleet provision is not supported: it takes a registration token (fanning it out copies a credential to every host) and each host needs its own runner names. Run 'runnerctl provision N' on each host." ;;
    # deprovision for the same credential reason, plus its own: it is
    # irreversible and asks y/N per run, and slot indexes and names mean
    # different runners on different hosts, so one fleet-wide target list
    # would delete different things everywhere.
    deprovision)
             die "fleet deprovision is not supported: it takes a removal token (fanning it out copies a credential to every host), it is irreversible, and a slot index or name means a different runner on each host. Run 'runnerctl deprovision <slot>' on the host." ;;
    logs)
             die "fleet logs is not supported: logs streams from one journal and only makes sense against one host. In 'runnerctl fleet watch', L on a slot pages its recent journal from its host; or ssh to the host." ;;
    *)       die "unknown fleet command '$sub' (status watch health history upgrade apply scale start stop restart drain kill reap remove-limits enable disable compose-reap compose-reap-timer)" ;;
  esac
}

# --host H, repeatable, narrows the fan-out. Validated against FLEET_HOSTS
# and dies naming an unknown one rather than dialling it: a typo that
# silently targets nothing, on a command that stops runners, is worse than
# an error.
fleet_select_hosts() { # NAME...
  local want h found
  local -a sel=()
  for want in "$@"; do
    found=false
    for h in "${FLEET_HOSTS[@]}"; do
      if [ "$h" = "$want" ]; then found=true; break; fi
    done
    $found || die "--host '$want' is not in FLEET_HOSTS (configured: ${FLEET_HOSTS[*]})"
    sel+=("$want")
  done
  FLEET_HOSTS=("${sel[@]}")
}

# stop, drain and disable take fleet capacity away and do not give it back.
# Run across every host with no thought, they are an outage — and the whole
# reason this needs its own gate is that the per-host --when-idle politeness
# does NOT compose: every host draining one-slot-at-a-time still converges on
# zero fleet capacity at roughly the same moment.
#
# So they are refused fleet-wide unless the operator was explicit: --host H
# (a bounded target) or --all-hosts (an acknowledgement). restart and kill
# are transient — the unit comes back — and apply/scale/reap/remove-limits/
# enable/start do not remove capacity, so none of them need this.
#
# Nor do `compose-reap --apply` and `compose-reap-timer install|remove`
# (GHR-87), and that is a decision, not an omission: they remove a dead job's
# compose leftovers, or add and remove the timer that does, and never touch
# a runner slot — so a fleet-wide run takes no capacity away. compose-reap
# judges a stack alive by its job, so a running job's stack is kept.
fleet_capacity_gate() { # SUBCOMMAND HOST-COUNT ALL-HOSTS
  case "$1" in stop|drain|disable) ;; *) return 0 ;; esac
  [ "$2" -eq 0 ] || return 0
  $3 && return 0
  die "'fleet $1' across every host would take the whole pool's capacity down at once — each host draining politely one slot at a time still lands them all at zero together. Name the hosts with --host H (repeatable), or pass --all-hosts if you do mean the entire fleet."
}

# --- Fleet capacity budgets (GHR-44) -----------------------------------------
# GHR-43's controls are blunt: serial hosts, --host, and an --all-hosts
# acknowledgement. These are the graded ones, and they are TWO DIFFERENT
# SHAPES because the operations have opposite dynamics:
#
#   --max-unavailable N   for restart: a slot goes out and COMES BACK, so the
#                         unavailable count rises and falls and a ceiling
#                         throttles the rate. The rolling-update shape.
#   --min-available K     for stop/drain/disable: capacity is removed and NOT
#                         returned, so the unavailable count only ever rises.
#                         A ceiling here would take out N slots and then have
#                         nothing to wait for — it would block forever or
#                         stop silently half-done. What these need is a
#                         FLOOR: stop before crossing it, and say so.
#
# Conflating the two is the error GHR-42 was originally written around; see
# that issue for the full reasoning.

# "HOST IDX ACTIVE-STATE", one line per slot across the fleet.
#
# Extracted with one sed rather than a JSON parser: render_status_json emits
# each slot as a single line and this script owns that emitter, so idx and
# active are always on it together. That is a different thing from parsing
# the status TABLE, which the fleet renderer refuses to do by column position
# because an over-wide cell shifts everything after it on the row.
#
# A host that did not answer contributes no slots: its capacity is unknown,
# and guessing either way is worse than leaving it out of the arithmetic. The
# caller is told how many hosts were skipped.
FLEET_SLOTS_SKIPPED=0
fleet_slots() {
  local i host
  FLEET_SLOTS_SKIPPED=0
  fleet_fanout "$FLEET_RUNNERCTL" status --json
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    if [ "$(fleet_rc "$i")" != 0 ]; then
      FLEET_SLOTS_SKIPPED=$((FLEET_SLOTS_SKIPPED + 1))
      continue
    fi
    sed -n "s/.*\"idx\":\([0-9]*\).*\"active\":\"\([a-z]*\)\".*/$host \1 \2/p" "$FLEET_DIR/$i.out"
  done
  fleet_cleanup
}

# Slots counted as serving work. `activating` and `reloading` are NOT
# available: a slot on its way up cannot take a job yet, and counting it
# would let a roll run ahead of itself.
fleet_count_available() { # SLOT-LINES
  printf '%s\n' "$1" | awk '$3 == "active"' | grep -c . || true
}

fleet_count_unavailable() { # SLOT-LINES
  printf '%s\n' "$1" | awk 'NF == 3 && $3 != "active"' | grep -c . || true
}

# Percentage forms resolve against the fleet's total slots and NEVER round to
# zero: a budget of 0 would deadlock the roll on its first slot, which looks
# exactly like a hung fleet.
fleet_resolve_budget() { # VALUE TOTAL
  local v="$1" total="$2" n
  case "$v" in
    *%) n=$(( total * ${v%\%} / 100 )); [ "$n" -ge 1 ] || n=1 ;;
    *)  n="$v" ;;
  esac
  echo "$n"
}

# Fan a MUTATING command out. Everything here is deliberately different from
# the read-only commands above.
# Walk the fleet's slots one at a time, holding a capacity budget.
#
# One slot per remote call, rather than one command per host: a budget is a
# statement about SLOTS, and a per-host call would take a whole host's worth
# of capacity out in one step regardless of the number.
#
# Returns 0 when every targeted slot was acted on, 2 when a floor stopped it
# early (a distinct code because "I deliberately did less than you asked" is
# neither success nor failure), 1 when a slot failed.
# Reused across the three fleet_slots re-reads in fleet_budget_walk below.
# GLOBAL, not local: the EXIT trap that cleans it up fires after the function
# that declared it has returned, and a trap referencing a `local` is then
# reading a variable out of scope — "unbound variable" under `set -u`, the
# same reason FLEET_DIR (above) is global rather than local to fleet_fanout.
FLEET_BUDGET_TMP=""
fleet_budget_cleanup() {
  [ -z "$FLEET_BUDGET_TMP" ] || rm -f "$FLEET_BUDGET_TMP" "$FLEET_BUDGET_TMP.err" "$FLEET_BUDGET_TMP.err.cut" "$FLEET_BUDGET_TMP.err.seen"
  FLEET_BUDGET_TMP=""
}

fleet_budget_walk() { # SUBCOMMAND MODE BUDGET [REMOTE-ARGS...]
  local sub="$1" mode="$2" budget="$3"; shift 3
  local slots host idx state n total waited acted=0 nbad=0 stopped_at_floor=false
  local -a left=()
  # fleet_slots must run IN-PROCESS, never as $(...): FLEET_SLOTS_SKIPPED is
  # set inside fleet_slots, and a command substitution runs the function in a
  # subshell, so the count is set there and lost the moment the subshell
  # exits (GHR-59). Route its slot lines through a tmp file instead, and
  # re-arm the EXIT trap after every call: fleet_slots runs fleet_fanout,
  # which arms its OWN EXIT trap — the same reason fleet_watch_floor re-arms
  # its trap after calling fleet_slots.
  FLEET_BUDGET_TMP="$(mktemp)"
  fleet_slots >"$FLEET_BUDGET_TMP"; trap fleet_budget_cleanup EXIT
  slots="$(cat "$FLEET_BUDGET_TMP")"
  total="$(printf '%s\n' "$slots" | grep -c . || true)"
  [ "$total" -gt 0 ] || die "no slots found on the fleet — nothing to $sub (are the hosts reachable? try 'runnerctl fleet status')"
  n="$(fleet_resolve_budget "$budget" "$total")"
  [[ "$n" =~ ^[0-9]+$ ]] || die "budget '$budget' is invalid — want a whole number or a percentage like 25%"
  if [ "$FLEET_SLOTS_SKIPPED" -gt 0 ]; then
    # Said once, up front: a budget computed from a partial fleet is a
    # different promise from one computed over all of it, and the operator
    # should know which they are getting before anything moves.
    echo "warning: $FLEET_SLOTS_SKIPPED host(s) did not answer — the budget is being held over the $total slot(s) that did"
  fi
  while IFS=' ' read -r host idx state; do
    [ -n "$host" ] || continue
    if [ "$mode" = floor ]; then
      # Would acting take the fleet below the floor? Re-read rather than
      # decrementing a local counter: another operator, or a crashing job,
      # can move the number underneath a long roll.
      local avail
      fleet_slots >"$FLEET_BUDGET_TMP"; trap fleet_budget_cleanup EXIT
      avail="$(fleet_count_available "$(cat "$FLEET_BUDGET_TMP")")"
      if [ "$((avail - 1))" -lt "$n" ]; then
        stopped_at_floor=true
        left+=("$host/$idx")
        continue
      fi
    else
      # Ceiling: wait for the fleet to come back under budget.
      waited=0
      while :; do
        local unavail
        fleet_slots >"$FLEET_BUDGET_TMP"; trap fleet_budget_cleanup EXIT
        unavail="$(fleet_count_unavailable "$(cat "$FLEET_BUDGET_TMP")")"
        [ "$unavail" -ge "$n" ] || break
        [ "$waited" -lt "$WAIT_TIMEOUT" ] || die "waited ${waited}s for the fleet to come back under --max-unavailable $n and it did not — $acted slot(s) already ${sub}ed; 'runnerctl fleet status' shows what is still out"
        pause "$POLL_SEC"
        waited=$((waited + POLL_SEC))
      done
    fi
    # One slot per call, so the budget is one slot's worth (GHR-81) — and for
    # this call only: the fleet_slots re-reads above stay on FLEET_TIMEOUT.
    local rc1=0 budget1
    budget1="$(fleet_mutate_budget "$sub" 1 "$@")"
    # stderr is kept (GHR-89) so a failed slot says why — a sudo refusal under
    # FLEET_SUDO=1 most of all — and relayed like any fan-out's (GHR-101).
    # GHR-88: with the origin, and recorded per slot on this node.
    fleet_log_begin "$(fleet_log_argv)"
    # GHR-92: streamed, as `host slot N: line`, so a slot's `waiting for …`
    # lines show while it waits instead of being thrown away with its stdout.
    FLEET_STREAM=true FLEET_STREAM_LABEL="$host slot $idx" \
      fleet_call_mutating "$host" /dev/null "$FLEET_BUDGET_TMP.err" "$budget1" "$sub" "$idx" "$@"
    rc1="$FLEET_CALL_RC"
    fleet_log_result "$host/$idx" "$rc1"
    if [ "$rc1" = 0 ]; then
      acted=$((acted + 1)); echo "$host slot $idx: $sub ok"
    elif [ "$rc1" = 124 ]; then
      # Not "(exit 124)": the slot is not known to have failed, only not known
      # to have finished, and the walk is about to move on past it.
      # GHR-150: the stderr file is read for its ERR.cut alone (which limit).
      nbad=$((nbad + 1)); echo "$host slot $idx: $sub FAILED ($(fleet_error_text 124 "$FLEET_BUDGET_TMP.err" "$budget1" mutating "$host"))"
    else
      nbad=$((nbad + 1)); echo "$host slot $idx: $sub FAILED ($(fleet_error_text "$rc1" "$FLEET_BUDGET_TMP.err" "$budget1" mutating "$host"))"
    fi
  done <<<"$slots"
  fleet_budget_cleanup
  # Not ${stopped_at_floor:+...}: the variable holds the STRING "false" when
  # the floor was never hit, which is non-empty and would expand anyway.
  if $stopped_at_floor; then
    echo "fleet $sub: $acted slot(s) done, $nbad failed, ${#left[@]} left running at the floor"
    echo "left running to hold --min-available $n: ${left[*]}"
  else
    echo "fleet $sub: $acted slot(s) done, $nbad failed"
  fi
  [ "$nbad" -eq 0 ] || return 1
  $stopped_at_floor && return 2
  return 0
}

# Seconds one MUTATING remote call may take (GHR-81): SUBCOMMAND with
# REMOTE-ARGS, against a host — or a walk's single slot — of SLOTS slots.
#
# FLEET_MUTATE_TIMEOUT covers the action itself. Under --when-idle (and
# `drain`, which is `stop --when-idle`) the remote also WAITS, by design and
# for up to its --timeout PER SLOT — idle_gate hands every slot the full
# WAIT_TIMEOUT, one slot after another — so the wait is added once per slot.
# The wait is read off the forwarded --timeout, else this node's
# WAIT_TIMEOUT: a host whose own config raises WAIT_TIMEOUT is waiting longer
# than this can know, and wants an explicit --timeout on the fleet command.
fleet_waits_for_idle() { # SUBCOMMAND [REMOTE-ARGS...]
  local a
  [ "$1" != drain ] || return 0
  for a in "${@:2}"; do [ "$a" != --when-idle ] || return 0; done
  return 1
}
fleet_mutate_budget() { # SUBCOMMAND SLOTS [REMOTE-ARGS...]
  local sub="$1" slots="$2" wait="$WAIT_TIMEOUT" prev="" a
  shift 2
  if ! fleet_waits_for_idle "$sub" "$@"; then
    echo "$FLEET_MUTATE_TIMEOUT"; return 0
  fi
  for a in "$@"; do
    case "$a" in --timeout=*) prev=--timeout; a="${a#*=}" ;; esac
    # A --timeout the remote will refuse is not this function's to report;
    # the host says so in a second, well inside any budget.
    if [ "$prev" = --timeout ] && [[ "$a" =~ ^[0-9]+$ ]]; then wait="$a"; fi
    prev="$a"
  done
  echo $((slots * wait + FLEET_MUTATE_TIMEOUT))
}

# Fill FLEET_BUDGETS for a mutating fan-out of SUBCOMMAND with REMOTE-ARGS.
#
# A command that waits for idle slots needs each host's SLOT COUNT, because
# its worst case is that many waits end to end — so those, and only those,
# pay one read-only `status --json` round first (at FLEET_PARALLEL and on
# FLEET_TIMEOUT, like any other read). Counted the way fleet_slots counts:
# render_status_json emits one line per slot. A host that does not answer
# the read is budgeted as ONE slot rather than skipped: it is still asked to
# do the work, and if it turns out to have been reachable and slow, the
# timed-out wording says the truth about it.
fleet_set_budgets() { # SUBCOMMAND [REMOTE-ARGS...]
  local i n
  local -a nslots=()
  if fleet_waits_for_idle "$@"; then
    fleet_fanout "$FLEET_RUNNERCTL" status --json
    for i in "${!FLEET_HOSTS[@]}"; do
      n=0
      [ "$(fleet_rc "$i")" != 0 ] || n="$(grep -c '"idx":' "$FLEET_DIR/$i.out" || true)"
      nslots[i]="$n"
    done
    fleet_cleanup
  fi
  FLEET_BUDGETS=()
  for i in "${!FLEET_HOSTS[@]}"; do
    n="${nslots[$i]:-1}"
    [ "$n" -ge 1 ] || n=1
    FLEET_BUDGETS[i]="$(fleet_mutate_budget "$1" "$n" "${@:2}")"
  done
}

cmd_fleet_run() { # SUBCOMMAND [--host H]... [--all-hosts] [REMOTE-ARGS...]
  local sub="$1"; shift
  local all_hosts=false rc=0 max_unavail="" min_avail="" q
  local -a hosts=() fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --host)      need_val "$@"; hosts+=("$2"); shift 2 ;;
      --all-hosts) all_hosts=true; shift ;;
      --max-unavailable) need_val "$@"; max_unavail="$2"; shift 2 ;;
      --min-available)   need_val "$@"; min_avail="$2"; shift 2 ;;
      # Everything else is the remote command's own flag and is forwarded
      # untouched. Re-implementing each command's parser here would be a
      # second copy to keep in step, and the host that runs it is the one
      # that should reject a bad flag.
      #
      # GHR-86: forwarded QUOTED. ssh hands its argv to the remote shell as
      # one string, which that shell splits and expands again — so a word is
      # %q'd here to reach the host's runnerctl as the one literal argument it
      # was here (a plain word is unchanged), as fleet_watch_run_action has
      # always quoted a slot name. `fleet watch`'s `:` prompt runs through
      # here, and its words are whatever was typed.
      *)           printf -v q %q "$1"; fwd+=("$q"); shift ;;
    esac
  done
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  # Which budget suits which command is not a preference — see the block
  # above fleet_slots. A ceiling on a command that never gives capacity back
  # cannot make progress, and a floor on a rolling restart is meaningless
  # because the roll returns what it takes. Refuse the wrong pairing rather
  # than accepting a flag that would quietly do nothing.
  # Checked BEFORE the per-command pairing below: "you asked for both" is the
  # more fundamental mistake, and reporting the pairing error first would
  # describe a flag the user is about to be told they cannot use anyway.
  [ -z "$max_unavail" ] || [ -z "$min_avail" ] || die "--max-unavailable and --min-available cannot be combined: one throttles a roll that gives capacity back, the other holds a floor under capacity being removed"
  if [ -n "$max_unavail" ]; then
    case "$sub" in
      restart|apply|scale) ;;
      *) die "--max-unavailable applies to restart, apply and scale, not '$sub': it is a ceiling on slots that are temporarily out, and '$sub' does not give the capacity back. Use --min-available K to hold a floor instead." ;;
    esac
  fi
  if [ -n "$min_avail" ]; then
    case "$sub" in
      stop|drain|disable) ;;
      *) die "--min-available applies to stop, drain and disable, not '$sub': it is a floor under capacity that is being taken away, and '$sub' returns what it takes. Use --max-unavailable N to throttle the roll instead." ;;
    esac
  fi
  fleet_origin
  fleet_heartbeat
  if [ -n "$max_unavail" ]; then
    fleet_budget_walk "$sub" ceiling "$max_unavail" ${fwd[@]+"${fwd[@]}"} || rc=$?
    fleet_log_finish
    return "$rc"
  fi
  if [ -n "$min_avail" ]; then
    fleet_budget_walk "$sub" floor "$min_avail" ${fwd[@]+"${fwd[@]}"} || rc=$?
    fleet_log_finish
    return "$rc"
  fi
  fleet_capacity_gate "$sub" "${#hosts[@]}" "$all_hosts"
  # ONE HOST AT A TIME. FLEET_PARALLEL is ignored for mutating commands on
  # purpose: with the existing per-host --when-idle (one slot at a time
  # within a host), serial hosts bound the blast radius to a single host at
  # any moment. It is slow on a large fleet, and that is the right trade for
  # something that can take CI capacity down.
  #
  # The budgets are set BEFORE going serial (GHR-81): the slot-count read a
  # waiting command needs is read-only, and has no reason to queue.
  fleet_set_budgets "$sub" ${fwd[@]+"${fwd[@]}"}
  FLEET_PARALLEL=1
  fleet_priv_cmd
  fleet_log_begin "$(fleet_log_argv)"
  # GHR-92: streamed — each line a host prints is shown, `host: line`, as it
  # arrives (they run one at a time, so there is nothing to interleave).
  # fleet_run_report then does not print them again.
  fleet_fanout_stream "${FLEET_PRIV[@]}" ${FLEET_ORIGIN[@]+"${FLEET_ORIGIN[@]}"} ${FLEET_HB[@]+"${FLEET_HB[@]}"} "$sub" ${fwd[@]+"${fwd[@]}"}
  fleet_log_results
  if fleet_args_json ${fwd[@]+"${fwd[@]}"}; then
    fleet_run_report "$sub" || rc=$?
  else
    fleet_run_report "$sub" streamed || rc=$?
  fi
  fleet_cleanup
  fleet_log_finish
  return "$rc"
}
# Every host of the fan-out just made, with its exit status, into the record.
fleet_log_results() {
  local i
  for i in "${!FLEET_HOSTS[@]}"; do fleet_log_result "${FLEET_HOSTS[$i]}" "$(fleet_rc "$i")"; done
}

# One block per host: whatever that host said, prefixed, then a count. A
# host's own output is reused rather than summarised, because these commands
# already say useful per-slot things ("2 stalled slot(s)", "nothing to reap").
#
# GHR-92: with STREAMED (any second word) the host's lines were already shown,
# as they were printed, so they are not printed a second time — a long drain's
# report would otherwise repeat every `waiting for …` line. What stays is what
# the stream cannot say: a failed host's row (its exit status, the first line
# of its stderr, the hint, and the may-still-be-running sentence for a
# timeout) and the count, which are the same words as before.
fleet_run_report() { # SUBCOMMAND [STREAMED]
  local sub="$1" i host rc line ok=0 bad=0 nodocker=0
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    # GHR-87: a host without docker has nothing for compose-reap to do — a
    # fleet where only some hosts run compose is the normal case — so it is
    # a row of information and does not count as failed.
    if [ "$rc" != 0 ] && [ "$sub" = compose-reap ] && fleet_no_docker "$FLEET_DIR/$i.err"; then
      nodocker=$((nodocker + 1))
      printf '%s: %s\n' "$host" "$FLEET_NO_DOCKER_ROW"
      continue
    fi
    if [ "$rc" = 0 ]; then ok=$((ok + 1)); else bad=$((bad + 1)); fi
    # stdout first even when the host failed: a command that got part way
    # through says so there, and losing that would hide a half-applied host.
    [ -n "${2:-}" ] || while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s: %s\n' "$host" "$line"
    done <"$FLEET_DIR/$i.out"
    [ "$rc" = 0 ] || printf '%s: %s\n' "$host" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}" mutating "$host")"
  done
  line="fleet $sub: $ok host(s) ok, $bad failed"
  [ "$nodocker" -eq 0 ] || line+=", $nodocker without docker"
  echo "$line"
  [ "$bad" -eq 0 ]
}

# `fleet upgrade`: hold every host on one runnerctl version from one place.
#
# Version skew is the fleet's quietest failure — a host only picks up a new
# script when `upgrade` runs on it, so until then the fleet behaves two ways
# and nothing says so. `fleet status` notices the drift; this fixes it.
#
# This is the first MUTATING fan-out, so it is also where the privilege
# question lands. `upgrade` writes the installed script, which on a normal
# host needs root — install_file already picks run_priv only when the
# destination is not writable. The requirement is therefore passwordless sudo
# on each host for that write, and BatchMode=yes (GHR-39) is what turns its
# absence into a fast, named failure instead of a fan-out that hangs once per
# host. No new privilege machinery is needed here; see the README.
#
# A host that fails to upgrade is a REPORTED ROW, not an abort. A partly
# upgraded fleet is the normal outcome of a flaky network, and the one thing
# you must not lose in that case is which host is still behind.
#
# That is the DEFAULT, and GHR-82 added the conservative shapes beside it,
# because "every host at FLEET_PARALLEL, report afterwards" lands a release
# that breaks on the fleet's distribution on eight hosts in the same second:
#
#   --host H           narrow it, like every other mutating fan-out.
#   --canary [H]       one host first; the rest only if it ends `upgraded` —
#                      written AND read back. Unnamed, the canary is the first
#                      host that WOULD CHANGE, which takes a --check round to
#                      know: a host that answers `Already up to date.` proves
#                      nothing about the release being rolled out.
#   --serial           one host at a time, each written and read back before
#                      the next is dialled; every host still attempted.
#   --stop-on-failure  --serial that halts at the first failed row, or at a
#                      host still behind (GHR-97), and names the hosts it
#                      did not attempt.
#
# And `upgraded` is no longer the remote's word alone. A host that says it
# wrote is asked for `version` through FLEET_RUNNERCTL — the exact path the
# fan-out executes — which is the step `install` has always ended on ("the
# proof comes from the installed file, not from this process") and `upgrade`
# never had. See fleet_upgrade_stage.
#
# The run's rows live in these arrays, indexed like FLEET_UP_HOSTS (the hosts
# this upgrade targets, in config order), rather than being read out of one
# fan-out's FLEET_DIR: a staged run is several fan-outs over different subsets
# of the hosts, and each one's directory is gone before the next starts.
#   KIND   level | changed | wrote | upgraded | bad | skipped
#          (`wrote` is a host between its write and its read-back)
#   NOW    the version the host is known to run after this, empty if unknown
#   WANT   the version a host that wrote said it wrote
FLEET_UP_HOSTS=() FLEET_UP_VERS=() FLEET_UP_STATE=() FLEET_UP_KIND=()
FLEET_UP_NOW=() FLEET_UP_WANT=()
# --ref R (and --sha256 SUM, GHR-84) as given, forwarded identically to the
# check round, the write and therefore to the version each host says it wrote.
FLEET_UP_FWD=()
# GHR-84: `fleet upgrade --rollback` — each host runs `upgrade --rollback`, and
# the version its `Rolled back A -> B` sentence names is what the read-back
# must answer. Same stages, same rows, its own words.
FLEET_UP_ROLLBACK=false
cmd_fleet_upgrade() { # [--check] [--push] [--ref REF] [--sha256 SUM] [--rollback] [--host H]... [--canary [H]] [--serial] [--stop-on-failure]
  local check=false canary=false canary_host="" serial=false stop=false
  local rc=0 k n c="" halted="" names="" ref
  local -a hosts=() all=() rest=() left=() would=()
  FLEET_UP_FWD=() FLEET_UP_ROLLBACK=false FLEET_UP_PUSH=false
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --check) check=true; shift ;;
      --push)  FLEET_UP_PUSH=true; shift ;;
      # %q'd for the remote shell, as cmd_fleet_run forwards a word (GHR-86).
      --ref)   need_val "$@"; printf -v ref %q "$2"; FLEET_UP_FWD+=(--ref "$ref"); shift 2 ;;
      # Validated here as the host would, so a typo fails once, before any
      # host is dialled, rather than once per host.
      --sha256)
        need_val "$@"
        [[ "$2" =~ ^[0-9a-f]{64}$ ]] || die "--sha256 '$2' is invalid — want 64 lowercase hex characters"
        FLEET_UP_FWD+=(--sha256 "$2"); shift 2 ;;
      --rollback) FLEET_UP_ROLLBACK=true; shift ;;
      --host)  need_val "$@"; hosts+=("$2"); shift 2 ;;
      # The host is optional, and `fleet upgrade` takes no positional
      # argument, so the next word is the canary's name exactly when it is
      # not another flag.
      --canary)
        canary=true; shift
        if [ $# -gt 0 ] && [[ "$1" != -* ]]; then canary_host="$1"; shift; fi ;;
      --serial) serial=true; shift ;;
      --stop-on-failure) serial=true; stop=true; shift ;;
      *)       die "unknown option: $1" ;;
    esac
  done
  # A flag that would quietly do nothing is refused rather than accepted, as
  # the budget flags are in cmd_fleet_run.
  if $check && { $canary || $serial; }; then
    die "--canary, --serial and --stop-on-failure stage a write, and --check writes nothing — drop --check, or drop them"
  fi
  # GHR-84: what a rollback combines with. --host, --serial and
  # --stop-on-failure stage it exactly as they stage an upgrade. The rest are
  # refused before anything is dialled:
  #   --check     a rollback has no dry run; `fleet upgrade --check` is the
  #               upgrade's, and `upgrade --check` on a host names its copy
  #   --canary    an unnamed canary is "the first host that WOULD CHANGE",
  #               found with an upgrade --check round, which says nothing about
  #               a rollback; and a rollback is the recovery from a release
  #               already misbehaving — --serial --stop-on-failure is the
  #               careful shape of it
  #   --ref, --sha256  a rollback downloads nothing
  if $FLEET_UP_ROLLBACK; then
    if $check; then
      die "--rollback and --check do not combine: a rollback has no dry run ('runnerctl upgrade --check' on a host names its rollback copy)"
    fi
    if $canary; then
      die "--rollback and --canary do not combine: a canary is chosen by what an upgrade would change — use --serial --stop-on-failure to roll back one host at a time"
    fi
    if [ "${#FLEET_UP_FWD[@]}" -gt 0 ]; then
      die "--rollback downloads nothing, so --ref and --sha256 do not apply to it"
    fi
  fi
  # GHR-83: --push sends THIS node's script, so there is nothing to pick a
  # release with (--ref) or to pin a download to (--sha256): the checksum it
  # installs against is this file's own. And a rollback sends nothing at all.
  if $FLEET_UP_PUSH; then
    if $FLEET_UP_ROLLBACK; then
      die "--push and --rollback do not combine: a rollback puts back each host's own .prev and sends nothing"
    fi
    if [ "${#FLEET_UP_FWD[@]}" -gt 0 ]; then
      die "--push sends this node's own runnerctl and downloads nothing, so --ref and --sha256 do not apply to it (upgrade this node first to push another version)"
    fi
    fleet_push_source
  fi
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  FLEET_UP_HOSTS=("${FLEET_HOSTS[@]}")
  FLEET_UP_VERS=() FLEET_UP_STATE=() FLEET_UP_KIND=() FLEET_UP_NOW=() FLEET_UP_WANT=()
  all=("${!FLEET_UP_HOSTS[@]}")
  if [ -n "$canary_host" ]; then
    for k in "${all[@]}"; do
      [ "${FLEET_UP_HOSTS[$k]}" != "$canary_host" ] || c="$k"
    done
    [ -n "$c" ] || die "--canary '$canary_host' is not among the hosts this upgrade targets (${FLEET_UP_HOSTS[*]})"
  fi
  if $check; then
    fleet_upgrade_stage true "${all[@]}"
    fleet_upgrade_report true || rc=$?
    return "$rc"
  fi
  if $canary; then
    # Which hosts would change is only known by asking, and --check is that
    # question. It costs each host one download and writes nothing.
    fleet_upgrade_stage true "${all[@]}"
    for k in "${all[@]}"; do
      [ "${FLEET_UP_KIND[$k]}" != changed ] || would+=("$k")
    done
    if [ "${#would[@]}" -eq 0 ]; then
      fleet_upgrade_report true || rc=$?
      echo "fleet upgrade --canary: no host would change, so there is nothing to try a release on — nothing was written"
      return "$rc"
    fi
    if [ -z "$c" ]; then
      c="${would[0]}"
    elif [ "${FLEET_UP_KIND[$c]}" != changed ]; then
      for k in "${would[@]}"; do names+="${names:+ }${FLEET_UP_HOSTS[$k]}"; done
      die "--canary '$canary_host' would not change (${FLEET_UP_STATE[$c]}), so it proves nothing about this release — nothing was written. Hosts that would change: $names"
    fi
    for k in "${all[@]}"; do
      [ "$k" = "$c" ] || rest+=("$k")
    done
    fleet_upgrade_stage false "$c"
    if [ "${FLEET_UP_KIND[$c]}" = upgraded ]; then
      echo "canary ${FLEET_UP_HOSTS[$c]}: upgraded ${FLEET_UP_VERS[$c]} and the fleet path answers ${FLEET_UP_NOW[$c]} — continuing with ${#rest[@]} other host(s)"
    else
      # Anything short of written-and-read-back. That includes a canary that
      # answered politely and changed nothing: it has verified nothing.
      halted="canary ${FLEET_UP_HOSTS[$c]} did not end upgraded"
      left=(${rest[@]+"${rest[@]}"})
    fi
  else
    rest=("${all[@]}")
  fi
  if [ -z "$halted" ] && [ "${#rest[@]}" -gt 0 ]; then
    if $serial; then
      # One host per stage, so each is written and read back before the next
      # is dialled. FLEET_PARALLEL is pinned as cmd_fleet_run pins it, so the
      # shape does not rest on a stage happening to hold a single host.
      FLEET_PARALLEL=1
      for n in "${!rest[@]}"; do
        k="${rest[$n]}"
        fleet_upgrade_stage false "$k"
        # `changed` after a write is a host still behind (GHR-97): as much a
        # stop as a failed row, as it is for a canary.
        if $stop && { [ "${FLEET_UP_KIND[$k]}" = bad ] || [ "${FLEET_UP_KIND[$k]}" = changed ]; }; then
          halted="stopped at ${FLEET_UP_HOSTS[$k]}"
          left=("${rest[@]:$((n + 1))}")
          break
        fi
      done
    else
      fleet_upgrade_stage false "${rest[@]}"
    fi
  fi
  # A host this run decided not to dial keeps the versions the check round
  # read off it, where there was one, and loses whatever verdict that round
  # gave it: `update available` would read as an upgrade's result.
  for k in ${left[@]+"${left[@]}"}; do
    FLEET_UP_KIND[k]=skipped
    FLEET_UP_STATE[k]="not attempted"
    [ -n "${FLEET_UP_VERS[$k]:-}" ] || FLEET_UP_VERS[k]="—"
    [ -n "${FLEET_UP_NOW[$k]:-}" ] || FLEET_UP_NOW[k]=""
  done
  fleet_upgrade_report false || rc=$?
  fleet_log_finish
  if [ -n "$halted" ]; then
    names=""
    for k in ${left[@]+"${left[@]}"}; do names+="${names:+ }${FLEET_UP_HOSTS[$k]}"; done
    echo "$halted${names:+ — not attempted: $names}"
    rc=1
  fi
  fleet_upgrade_state_line
  return "$rc"
}

# The version a host's `upgrade` output says it WROTE: the second version in
# cmd_upgrade's `Upgraded A -> B at PATH`, empty when it wrote nothing. Taken
# from the remote's own sentence rather than from --ref or from this node's
# idea of the release: a --ref that is a branch has no version in its name,
# and the remote is the one that read the number out of the file it placed.
fleet_upgrade_wrote() { # FILE
  sed -n 's/^Upgraded [^ ]* -> \([^ ]*\) at .*/\1/p' "$1" 2>/dev/null | head -1 || true
}
# The same for upgrade_rollback's `Rolled back A -> B at PATH` (GHR-84): the
# version the host says it put back, empty when it did not.
fleet_upgrade_rolled() { # FILE
  sed -n 's/^Rolled back [^ ]* -> \([^ ]*\) at .*/\1/p' "$1" 2>/dev/null | head -1 || true
}
# The version in a `version` answer (`runnerctl X`), empty for anything else.
fleet_version_answer() { # FILE
  sed -n 's/^runnerctl \([^ ]*\)$/\1/p' "$1" 2>/dev/null | head -1 || true
}

# One stage: `upgrade` on the hosts at INDEX... of FLEET_UP_HOSTS, then the
# read-back on those of them that wrote.
#
# FLEET_HOSTS is narrowed to the stage for the two fan-outs and restored, so
# fleet_fanout is used exactly as it is. FLEET_BUDGETS is rebuilt for the
# stage's own hosts — it is indexed like FLEET_HOSTS, and a budget left
# aligned to the full list would hand a narrowed host its neighbour's.
#
# The write is a mutating call (GHR-81): the remote downloads with `curl
# --max-time 30` (fetch_script), so under FLEET_TIMEOUT — the same 30 s — a
# slow download and the fan-out's own timeout raced each other. --check
# downloads too, so it gets the same budget; only a real upgrade is reported
# as possibly still running.
#
# The read-back is a READ. FLEET_BUDGETS is a global that fleet_fanout_one
# consults for every fan-out, so it is emptied first: left set, `version`
# would inherit fifteen minutes to answer one line.
fleet_upgrade_stage() { # CHECK INDEX...
  local check="$1" j k
  shift
  local -a idx=("$@") wrote=() args=(upgrade)
  if $FLEET_UP_PUSH; then fleet_push_stage "$check" "${idx[@]}"; return 0; fi
  ! $check || args+=(--check)
  ! $FLEET_UP_ROLLBACK || args+=(--rollback)
  args+=(${FLEET_UP_FWD[@]+"${FLEET_UP_FWD[@]}"})
  FLEET_HOSTS=() FLEET_BUDGETS=()
  for k in "${idx[@]}"; do
    FLEET_HOSTS+=("${FLEET_UP_HOSTS[$k]}")
    FLEET_BUDGETS+=("$(fleet_mutate_budget upgrade 1)")
  done
  # GHR-89: the write (and a rollback) changes the host; --check writes
  # nothing and runs as the login, as the read-back below does.
  FLEET_PRIV=("$FLEET_RUNNERCTL") FLEET_ORIGIN=() FLEET_ORIGIN_WORD=""
  FLEET_HB=() FLEET_HB_WORD=""
  if ! $check; then
    fleet_priv_cmd
    # GHR-88: the write carries the origin and is recorded here, per stage.
    fleet_origin
    # GHR-156: and the heartbeat, so a host that takes it is cut on silence
    # (GHR-150) rather than on the total — its download prints one (GHR-149).
    # A host still on a runnerctl from before the flag refuses it, is asked
    # again without it by the fan-out's optional-word round, and stays on the
    # total; the version it upgrades TO is not asked anything more this run
    # (the read-back is a read).
    fleet_heartbeat
    fleet_log_begin "$(fleet_log_argv)"
  fi
  # GHR-92: the write (and a rollback) streams, `host: line` as each host
  # says it; --check is a read and stays buffered. Hosts of a stage run side
  # by side unless --serial, so lines of different hosts may alternate — each
  # is whole and carries its host.
  if $check; then
    fleet_fanout "${FLEET_PRIV[@]}" ${FLEET_ORIGIN[@]+"${FLEET_ORIGIN[@]}"} "${args[@]}"
  else
    fleet_fanout_stream "${FLEET_PRIV[@]}" ${FLEET_ORIGIN[@]+"${FLEET_ORIGIN[@]}"} ${FLEET_HB[@]+"${FLEET_HB[@]}"} "${args[@]}"
  fi
  $check || fleet_log_results
  for j in "${!idx[@]}"; do
    k="${idx[$j]}"
    fleet_upgrade_classify "$check" "$j" "$k"
    [ "${FLEET_UP_KIND[$k]}" != wrote ] || wrote+=("$k")
  done
  fleet_cleanup
  FLEET_BUDGETS=()
  if [ "${#wrote[@]}" -gt 0 ]; then
    FLEET_HOSTS=()
    for k in "${wrote[@]}"; do FLEET_HOSTS+=("${FLEET_UP_HOSTS[$k]}"); done
    fleet_fanout "$FLEET_RUNNERCTL" version
    for j in "${!wrote[@]}"; do
      fleet_upgrade_verify "$j" "${wrote[$j]}"
    done
    fleet_cleanup
  fi
  FLEET_HOSTS=("${FLEET_UP_HOSTS[@]}")
}

# First capture group of "KEY: <value> (...)" in a host's upgrade output.
# Pad TEXT to WIDTH columns. Not printf '%-*s': that counts BYTES, so a
# 3-byte em dash lands two columns short and shifts the rest of the row —
# the same trap GHR-21 fixed in status_row. ${#v} counts characters, which
# is what a terminal actually renders.
fleet_pad() { # WIDTH TEXT
  local pad=""
  [ "${#2}" -ge "$1" ] || printf -v pad '%*s' $(( $1 - ${#2} )) ''
  printf '%s%s' "$2" "$pad"
}

fleet_upgrade_field_of() { # FILE KEY
  sed -n "s/^$2: \([^ ]*\).*/\1/p" "$1" 2>/dev/null | head -1
}
fleet_upgrade_field() { # INDEX KEY
  fleet_upgrade_field_of "$FLEET_DIR/$1.out" "$2"
}

# What host J of the fan-out in flight said to `upgrade`, into row K. The
# state word comes from the verdict line `upgrade` already prints rather than
# from comparing versions here: the remote is the only thing that knows
# whether it actually wrote the file, and re-deriving that locally would be a
# second implementation to keep in step.
fleet_upgrade_classify() { # CHECK J K
  local check="$1" j="$2" k="$3" rc cur avail kind state mutating=mutating
  ! $check || mutating=""
  rc="$(fleet_rc "$j")"
  FLEET_UP_NOW[k]="" FLEET_UP_WANT[k]=""
  if [ "$rc" != 0 ]; then
    FLEET_UP_KIND[k]=bad FLEET_UP_VERS[k]="—"
    FLEET_UP_STATE[k]="$(fleet_error_text "$rc" "$FLEET_DIR/$j.err" "${FLEET_BUDGETS[$j]:-}" "$mutating" "${FLEET_HOSTS[$j]}")"
    return 0
  fi
  cur="$(fleet_upgrade_field "$j" installed)"
  avail="$(fleet_upgrade_field "$j" available)"
  if $FLEET_UP_ROLLBACK; then
    # GHR-84: the version a rollback goes back to is on its `rollback:` line.
    avail="$(fleet_upgrade_field "$j" rollback)"
    FLEET_UP_WANT[k]="$(fleet_upgrade_rolled "$FLEET_DIR/$j.out")"
  else
    FLEET_UP_WANT[k]="$(fleet_upgrade_wrote "$FLEET_DIR/$j.out")"
  fi
  if $FLEET_UP_ROLLBACK && [ -n "${FLEET_UP_WANT[$k]}" ]; then
    # Its own branch: the sentence is not one of the upgrade's four, and a
    # host that answers anything else to --rollback — an older runnerctl
    # that ignored it and said `Already up to date.` — did not roll back, so
    # none of the upgrade's verdicts below may classify it. It goes on to
    # `unrecognised` instead.
    state="rolled back"; kind=wrote
  elif $FLEET_UP_ROLLBACK; then
    state="unrecognised: $(tail -1 "$FLEET_DIR/$j.out" 2>/dev/null || true)"
    kind=bad
  elif [ -n "${FLEET_UP_WANT[$k]}" ]; then
    # Its word, until the read-back has had its say.
    state="upgraded"; kind=wrote
  elif grep -q '^Update available\.' "$FLEET_DIR/$j.out"; then
    state="update available"; kind=changed
  elif grep -q '^Already up to date\.' "$FLEET_DIR/$j.out"; then
    state="up to date"; kind=level
  elif grep -q 'not downgrading' "$FLEET_DIR/$j.out"; then
    state="ahead of the source — left alone"; kind=level
  else
    # An answer this does not recognise is shown, not guessed at: a silent
    # "up to date" for a host that said something else is the one outcome
    # that would send someone to the wrong box.
    state="unrecognised: $(tail -1 "$FLEET_DIR/$j.out" 2>/dev/null || true)"
    kind=bad
  fi
  if [ -n "$cur" ] && [ -n "$avail" ] && [ "$cur" != "$avail" ]; then
    FLEET_UP_VERS[k]="$cur -> $avail"
  else
    FLEET_UP_VERS[k]="${cur:-?}"
  fi
  # What it ran when it answered. A host that wrote has this replaced by the
  # read-back, or emptied when the read-back cannot say.
  FLEET_UP_NOW[k]="$cur"
  FLEET_UP_KIND[k]="$kind" FLEET_UP_STATE[k]="$state"
}

# What host J of the read-back fan-out answered to `version`, into row K — a
# host that said it wrote FLEET_UP_WANT. Three failures, kept apart because
# they send someone to three different places:
#   it answers another version   the write landed somewhere the fan-out does
#                                not execute — a home copy shadowing the
#                                system one, a FLEET_RUNNERCTL naming another
#                                file. The host is NOT upgraded as far as the
#                                fleet is concerned.
#   it did not answer            nothing is known about what it runs now; the
#                                write was reported done. Not a mismatch, and
#                                not worded as one.
#   it answered something else   shown, as an unrecognised `upgrade` answer is.
# All three are failed rows: `upgraded` is a claim this command now checks,
# and an unchecked one is not a pass.
#
# A rollback (GHR-84) is read back the same way, against the version its
# `Rolled back` sentence named; a verified one is kind `upgraded` (it is
# counted where an upgrade is) with the state `rolled back`.
fleet_upgrade_verify() { # J K
  local j="$1" k="$2" rc got want="${FLEET_UP_WANT[$2]}" did done_word=upgraded
  did="wrote $want"
  if $FLEET_UP_ROLLBACK; then did="rolled back to $want" done_word="rolled back"; fi
  rc="$(fleet_rc "$j")"
  FLEET_UP_NOW[k]="" FLEET_UP_KIND[k]=bad
  if [ "$rc" != 0 ]; then
    FLEET_UP_STATE[k]="$did but the read-back did not answer: $(fleet_error_text "$rc" "$FLEET_DIR/$j.err")"
    return 0
  fi
  got="$(fleet_version_answer "$FLEET_DIR/$j.out")"
  if [ -z "$got" ]; then
    FLEET_UP_STATE[k]="$did but the read-back answered '$(head -1 "$FLEET_DIR/$j.out" 2>/dev/null || true)', not a version"
    return 0
  fi
  FLEET_UP_NOW[k]="$got"
  if [ "$got" = "$want" ]; then
    FLEET_UP_KIND[k]=upgraded FLEET_UP_STATE[k]="$done_word"
  else
    FLEET_UP_STATE[k]="$did but the fleet path still answers $got"
  fi
}

# One row per host, then a count. `not attempted` is only named when a staged
# run stopped short, so the count line of an unstaged run reads as it always
# has.
fleet_upgrade_report() { # CHECK
  local check="$1" k host level=0 changed=0 behind=0 bad=0 skipped=0 hostw=4 versw=7 tail=""
  for k in "${!FLEET_UP_HOSTS[@]}"; do
    host="${FLEET_UP_HOSTS[$k]}"
    case "${FLEET_UP_KIND[$k]}" in
      level)                  level=$((level + 1)) ;;
      # `changed` is "would change" in a --check and "still behind" in a
      # write (GHR-97): there it is the retire-only path of `upgrade`
      # (GHR-52), which printed `Update available.` because it could not
      # write the system copy. It is not an upgrade, so a write counts it
      # on its own and it fails the run.
      changed)
        if $check; then changed=$((changed + 1)); else behind=$((behind + 1)); fi ;;
      wrote|upgraded)         changed=$((changed + 1)) ;;
      skipped)                skipped=$((skipped + 1)) ;;
      *)                      bad=$((bad + 1)) ;;
    esac
    [ "${#host}" -le "$hostw" ] || hostw="${#host}"
    [ "${#FLEET_UP_VERS[$k]}" -le "$versw" ] || versw="${#FLEET_UP_VERS[$k]}"
  done
  for k in "${!FLEET_UP_HOSTS[@]}"; do
    printf '%s %s %s\n' "$(fleet_pad "$hostw" "${FLEET_UP_HOSTS[$k]}")" \
      "$(fleet_pad "$versw" "${FLEET_UP_VERS[$k]}")" "${FLEET_UP_STATE[$k]}"
  done
  [ "$skipped" -eq 0 ] || tail=", $skipped not attempted"
  [ "$behind" -eq 0 ] || tail=", $behind still behind$tail"
  if $check; then
    echo "${#FLEET_UP_HOSTS[@]} host(s): $level up to date, $changed would change, $bad unreachable or unclear"
  elif $FLEET_UP_ROLLBACK; then
    # No `already level` here: a host that did not roll back is a failed row.
    echo "${#FLEET_UP_HOSTS[@]} host(s): $changed rolled back, $bad unreachable or unclear$tail"
  else
    echo "${#FLEET_UP_HOSTS[@]} host(s): $level already level, $changed upgraded, $bad unreachable or unclear$tail"
  fi
  [ "$bad" -eq 0 ] && [ "$skipped" -eq 0 ] && [ "$behind" -eq 0 ]
}

# Where the fleet ended up, as the last line of a write: `N host(s) on X` when
# every host is known to be on one version, else each version with its hosts
# in the order they first appear, and `unknown` for the hosts that did not
# say. Grouped by what the hosts ANSWER rather than measured against a target
# version, because this node does not know one: the release each host
# downloaded is only ever named by that host.
fleet_upgrade_state_line() {
  local k n v found unknown="" out=""
  local -a on=() who=()
  for k in "${!FLEET_UP_HOSTS[@]}"; do
    v="${FLEET_UP_NOW[$k]:-}"
    if [ -z "$v" ]; then
      unknown+="${unknown:+ }${FLEET_UP_HOSTS[$k]}"
      continue
    fi
    found=""
    for n in "${!on[@]}"; do
      [ "${on[$n]}" != "$v" ] || found="$n"
    done
    if [ -z "$found" ]; then
      on+=("$v"); who+=("${FLEET_UP_HOSTS[$k]}")
    else
      who[found]+=" ${FLEET_UP_HOSTS[$k]}"
    fi
  done
  if [ "${#on[@]}" -eq 1 ] && [ -z "$unknown" ]; then
    echo "${#FLEET_UP_HOSTS[@]} host(s) on ${on[0]}"
    return 0
  fi
  for n in "${!on[@]}"; do
    out+="${out:+; }${on[$n]}: ${who[$n]}"
  done
  [ -z "$unknown" ] || out+="${out:+; }unknown: $unknown"
  echo "not on one version — $out"
}

# --- fleet upgrade --push (GHR-83) ----------------------------------------------
# `fleet upgrade` has each host download its own copy: every host needs
# outbound HTTPS to UPGRADE_URL, `latest` is resolved per host at a different
# moment on each, and a host with no usable runnerctl cannot be reached at
# all. --push sends THIS node's script over the ssh connection instead, so
# every host lands on the same bytes, verified by checksum, with no outbound
# access and no runnerctl needed beforehand.
#
# Not the excluded category. `env-init` and `provision` stay off the fan-out
# because they move secrets and credentials; what this moves is the script,
# which is public code, and nothing else — no config, no token.
#
# Per host, three calls, each built here as FIXED TEXT from this node's own
# values (FLEET_RUNNERCTL, checked below; the checksum; the origin word, which
# origin_valid already holds to a plain shape). Nothing a host sends back is
# ever put into a command:
#   probe     read-only, as the login: the sha256 of whatever FLEET_RUNNERCTL
#             resolves to and its RUNNERCTL_VERSION line; exit 127 when it
#             resolves to nothing — absent.
#   install   (a write, only for a host that differs or is absent) through
#             ssh_run_stdin: the bytes land in a fresh mktemp file, are checked
#             against this node's sha256 and refused on a mismatch, and only
#             then installed with `sudo -n bash FILE install` — an ordinary
#             FILE install, so cmd_install takes this very file as its source
#             (is_piped is false: BASH_SOURCE is the file) rather than the
#             piped branch, which downloads. That is also what keeps
#             cmd_migrate in the path for a pre-config host. The temp file is
#             removed on every exit, a hang-up included.
#   read-back the probe again, and `upgraded` only when the checksum the fleet
#             path now answers is this node's.
#
# FLEET_SUDO does not change it. The install needs root to write the script,
# and under the narrow contract the host's grant covers `sudo -n
# FLEET_RUNNERCTL …` alone, which a host without runnerctl cannot have; so
# --push always asks `sudo -n bash`, and a host that does not grant it is a
# named row (-n: never a prompt, never a hang).
#
# A host NEWER than this node is left alone — upgrade's `not downgrading` rule,
# and with no flag to override it: to push an older script, run it from a node
# that has it on purpose. A host whose checksum already matches is `same`, and
# nothing is sent to it.
FLEET_UP_PUSH=false
FLEET_PUSH_SRC="" FLEET_PUSH_SHA="" FLEET_PUSH_VER=""
# What a probe answered, from fleet_push_probe_read.
PUSH_SHA="" PUSH_VER=""

# This node's script as a file, its sha256 and version, into FLEET_PUSH_*.
# Piped (`curl … | bash -s -- fleet upgrade --push`) there is no file to send,
# and a download would defeat the point. FLEET_RUNNERCTL goes into the remote
# commands, so it is held to a plain path shape first.
fleet_push_source() {
  is_piped && die "--push sends this node's own runnerctl as a file, and this one is being read from a pipe — install it first ('runnerctl install'), then push from the installed copy"
  FLEET_PUSH_SRC="$(readlink -f "${BASH_SOURCE[0]}")"
  { [ -f "$FLEET_PUSH_SRC" ] && [ -r "$FLEET_PUSH_SRC" ]; } || die "--push cannot read this node's runnerctl at $FLEET_PUSH_SRC"
  FLEET_PUSH_VER="$(remote_version "$FLEET_PUSH_SRC" 2>/dev/null || true)"
  valid_runner_version "$FLEET_PUSH_VER" || die "--push: $FLEET_PUSH_SRC carries no valid RUNNERCTL_VERSION — not sending it"
  FLEET_PUSH_SHA="$(script_sha256 "$FLEET_PUSH_SRC")"
  [[ "$FLEET_PUSH_SHA" =~ ^[0-9a-f]{64}$ ]] || die "--push could not compute the sha256 of $FLEET_PUSH_SRC"
  [[ "$FLEET_RUNNERCTL" =~ ^[A-Za-z0-9_./+][A-Za-z0-9_./+-]*$ ]] \
    || die "--push builds the remote commands with FLEET_RUNNERCTL '$FLEET_RUNNERCTL' in them, and it is not a plain path (letters, digits and _ . / + -)"
}

# The probe, as the one word ssh hands the login shell. /bin/sh is named so
# the text means one thing whatever the login's own shell is.
fleet_push_probe_cmd() {
  local s
  # shellcheck disable=SC2016  # the remote shell expands these, not this one
  s='p=$(command -v '"$FLEET_RUNNERCTL"') || exit 127; sha256sum <"$p" || exit 3; grep -m1 "^RUNNERCTL_VERSION=" "$p" || true'
  printf "exec /bin/sh -c '%s'\n" "$s"
}

# The install, as one word: ORIGIN-WORD is `--origin=…` or empty, HB-WORD
# `--heartbeat=N` (GHR-156) or empty. An absolute
# FLEET_RUNNERCTL named runnerctl is installed where it points (--prefix);
# anything else lands where `install` decides, and the read-back says whether
# the fleet path then runs it.
#
# GHR-158: with HB-WORD it also says, on stdout, the moment the bytes are in
# (FLEET_PUSH_RECEIVED) — the line the central node's watchdog waits for
# before it counts silence (FLEET_IDLE_FIRST, fleet_into_idle). Shaped as a
# heartbeat line, so the tap drops it like any other.
FLEET_PUSH_RECEIVED='heartbeat: received runnerctl (0s)'
fleet_push_install_cmd() { # [ORIGIN-WORD] [HB-WORD]
  local s extra="" prefix="" got=""
  [ -z "${1:-}" ] || extra=" $1"
  [ -z "${2:-}" ] || { extra+=" $2"; got=' echo "'"$FLEET_PUSH_RECEIVED"'";'; }
  case "$FLEET_RUNNERCTL" in /*/runnerctl) prefix=" --prefix ${FLEET_RUNNERCTL%/runnerctl}" ;; esac
  # shellcheck disable=SC2016  # the remote shell expands these, not this one
  s='t=$(mktemp) || exit 3; trap "rm -f -- \"\$t\"" EXIT; trap "exit 129" HUP INT TERM; cat >"$t" || exit 3;'"$got"' s=$(sha256sum <"$t") || exit 3; s=${s%% *}; if [ "$s" != "'"$FLEET_PUSH_SHA"'" ]; then echo "runnerctl push: the bytes received have sha256 $s, not '"$FLEET_PUSH_SHA"' - refusing to install them" >&2; exit 4; fi; sudo -n bash "$t"'"$extra"' install'"$prefix"
  printf "exec /bin/sh -c '%s'\n" "$s"
}

# A probe's answer in FILE, into PUSH_SHA / PUSH_VER: the first line must be
# sha256sum's own (`<64 hex>  -`), the second is the version line or absent
# (a pre-config script has none). Strict matches only — this is a remote's
# text, so anything else is not an answer and nothing of it is kept.
fleet_push_probe_read() { # FILE
  local l1="" l2=""
  PUSH_SHA="" PUSH_VER=""
  { IFS= read -r l1 || true; IFS= read -r l2 || true; } <"$1"
  [[ "$l1" =~ ^([0-9a-f]{64})\ \ -$ ]] || return 1
  PUSH_SHA="${BASH_REMATCH[1]}"
  if [[ "$l2" =~ ^RUNNERCTL_VERSION=\"([0-9]+\.[0-9]+\.[0-9]+)\" ]]; then
    PUSH_VER="${BASH_REMATCH[1]}"
  fi
  return 0
}

# One push stage over INDEX... of FLEET_UP_HOSTS, into the same rows
# fleet_upgrade_stage fills, so --host, --canary, --serial and
# --stop-on-failure stage a push exactly as they stage an upgrade. With CHECK
# it is the probe alone: `same`, `differs`, `absent`, `newer`, and nothing
# written.
fleet_push_stage() { # CHECK INDEX...
  local check="$1" j k oword="" hword=""
  shift
  local -a idx=("$@") send=() wrote=()
  FLEET_HOSTS=() FLEET_BUDGETS=()
  for k in "${idx[@]}"; do FLEET_HOSTS+=("${FLEET_UP_HOSTS[$k]}"); done
  # The probe is a read: the login, FLEET_TIMEOUT, no origin.
  FLEET_ORIGIN=() FLEET_ORIGIN_WORD=""
  fleet_fanout "$(fleet_push_probe_cmd)"
  for j in "${!idx[@]}"; do
    k="${idx[$j]}"
    fleet_push_classify "$j" "$k"
    if ! $check && [ "${FLEET_UP_KIND[$k]}" = changed ]; then send+=("$k"); fi
  done
  fleet_cleanup
  if [ "${#send[@]}" -gt 0 ]; then
    FLEET_HOSTS=() FLEET_BUDGETS=()
    for k in "${send[@]}"; do
      FLEET_HOSTS+=("${FLEET_UP_HOSTS[$k]}")
      FLEET_BUDGETS+=("$(fleet_mutate_budget upgrade 1)")
    done
    # The origin rides INSIDE the install text, after `bash FILE`, where the
    # pushed script's own main reads it — so it is not a word fleet_fanout
    # could drop and retry, and FLEET_ORIGIN stays empty for the fan-out.
    fleet_origin
    oword="$FLEET_ORIGIN_WORD"
    FLEET_ORIGIN=() FLEET_ORIGIN_WORD=""
    # GHR-156: the heartbeat rides inside it too. There is no version skew
    # to handle: the runnerctl that reads it is the one being pushed — this
    # node's, which knows the flag, since this node is the one asking — and
    # never the host's old copy, which the install text does not run. So the
    # call is on the watchdog for every host (FLEET_HB_INLINE), and its
    # install's slow phases (each systemctl) print a line (GHR-149). Off,
    # like every other call's, under FLEET_MUTATE_IDLE=0.
    fleet_heartbeat
    hword="$FLEET_HB_WORD"
    # GHR-88: the record says this was a push, and of which bytes.
    fleet_log_begin "$(fleet_log_argv) (push sha256 $FLEET_PUSH_SHA)"
    # GHR-158: but not from its first byte. The call opens with the script
    # itself going over ssh's stdin, and nothing can print while it does —
    # so the silence is counted from the host's FLEET_PUSH_RECEIVED line,
    # and the transfer before it is held to the call's ceiling alone.
    FLEET_STDIN_FILE="$FLEET_PUSH_SRC" FLEET_HB_INLINE=true FLEET_IDLE_FIRST="$FLEET_PUSH_RECEIVED"
    fleet_fanout_stream "$(fleet_push_install_cmd "$oword" "$hword")"
    FLEET_STDIN_FILE="" FLEET_HB_INLINE=false FLEET_IDLE_FIRST=""
    FLEET_HB=() FLEET_HB_WORD=""
    fleet_log_results
    for j in "${!send[@]}"; do
      k="${send[$j]}"
      fleet_push_sent "$j" "$k"
      [ "${FLEET_UP_KIND[$k]}" != wrote ] || wrote+=("$k")
    done
    fleet_cleanup
    FLEET_BUDGETS=()
  fi
  if [ "${#wrote[@]}" -gt 0 ]; then
    FLEET_HOSTS=()
    for k in "${wrote[@]}"; do FLEET_HOSTS+=("${FLEET_UP_HOSTS[$k]}"); done
    fleet_fanout "$(fleet_push_probe_cmd)"
    for j in "${!wrote[@]}"; do
      fleet_push_verify "$j" "${wrote[$j]}"
    done
    fleet_cleanup
  fi
  FLEET_HOSTS=("${FLEET_UP_HOSTS[@]}")
}

# What host J's probe answered, into row K.
fleet_push_classify() { # J K
  local j="$1" k="$2" rc
  rc="$(fleet_rc "$j")"
  FLEET_UP_NOW[k]="" FLEET_UP_WANT[k]="$FLEET_PUSH_VER"
  if [ "$rc" = 127 ]; then
    FLEET_UP_KIND[k]=changed FLEET_UP_STATE[k]="absent" FLEET_UP_VERS[k]="none -> $FLEET_PUSH_VER"
    return 0
  fi
  if [ "$rc" != 0 ]; then
    FLEET_UP_KIND[k]=bad FLEET_UP_VERS[k]="—"
    FLEET_UP_STATE[k]="$(fleet_error_text "$rc" "$FLEET_DIR/$j.err")"
    return 0
  fi
  if ! fleet_push_probe_read "$FLEET_DIR/$j.out"; then
    FLEET_UP_KIND[k]=bad FLEET_UP_VERS[k]="—"
    FLEET_UP_STATE[k]="unrecognised: its answer to the checksum read is not a sha256sum line"
    return 0
  fi
  FLEET_UP_NOW[k]="$PUSH_VER"
  if [ "$PUSH_SHA" = "$FLEET_PUSH_SHA" ]; then
    FLEET_UP_KIND[k]=level FLEET_UP_STATE[k]="same" FLEET_UP_VERS[k]="${PUSH_VER:-?}"
  elif [ -n "$PUSH_VER" ] && version_lt "$FLEET_PUSH_VER" "$PUSH_VER"; then
    FLEET_UP_KIND[k]=level FLEET_UP_STATE[k]="newer than this node — left alone"
    FLEET_UP_VERS[k]="$PUSH_VER -> $FLEET_PUSH_VER"
  else
    FLEET_UP_KIND[k]=changed FLEET_UP_STATE[k]="differs"
    FLEET_UP_VERS[k]="${PUSH_VER:-pre-config} -> $FLEET_PUSH_VER"
  fi
}

# What host J of the install fan-out did, into row K. Exit 0 is the host's
# word only: `wrote`, until the read-back has its say.
fleet_push_sent() { # J K
  local j="$1" k="$2" rc err=""
  rc="$(fleet_rc "$j")"
  if [ "$rc" = 0 ]; then
    FLEET_UP_KIND[k]=wrote FLEET_UP_STATE[k]="pushed"
    return 0
  fi
  FLEET_UP_KIND[k]=bad
  [ ! -s "$FLEET_DIR/$j.err" ] || err="$(head -1 "$FLEET_DIR/$j.err")"
  case "$rc:$err" in
    1:*sudo:*|1:*"a password is required"*|1:*"may not run"*|1:*"no tty present"*)
      FLEET_UP_STATE[k]="remote exit 1 — $err — --push installs with 'sudo -n bash <the pushed file> install', so the ssh login needs passwordless sudo for that on this host (FLEET_SUDO=1's grant for runnerctl alone does not cover it)" ;;
    *)
      FLEET_UP_STATE[k]="$(fleet_error_text "$rc" "$FLEET_DIR/$j.err" "${FLEET_BUDGETS[$j]:-}" mutating "${FLEET_HOSTS[$j]}")" ;;
  esac
}

# What host J's read-back answered, into row K: `upgraded` only when the fleet
# path's checksum is this node's.
fleet_push_verify() { # J K
  local j="$1" k="$2" rc
  rc="$(fleet_rc "$j")"
  FLEET_UP_NOW[k]="" FLEET_UP_KIND[k]=bad
  if [ "$rc" = 127 ]; then
    FLEET_UP_STATE[k]="pushed, but $FLEET_RUNNERCTL still resolves to nothing for the ssh login"
    return 0
  fi
  if [ "$rc" != 0 ]; then
    FLEET_UP_STATE[k]="pushed but the read-back did not answer: $(fleet_error_text "$rc" "$FLEET_DIR/$j.err")"
    return 0
  fi
  if ! fleet_push_probe_read "$FLEET_DIR/$j.out"; then
    FLEET_UP_STATE[k]="pushed but the read-back's answer is not a sha256sum line"
    return 0
  fi
  FLEET_UP_NOW[k]="$PUSH_VER"
  if [ "$PUSH_SHA" = "$FLEET_PUSH_SHA" ]; then
    FLEET_UP_KIND[k]=upgraded FLEET_UP_STATE[k]="upgraded"
  else
    FLEET_UP_STATE[k]="pushed, but the fleet path's runnerctl has sha256 ${PUSH_SHA:0:12}…, not this node's ${FLEET_PUSH_SHA:0:12}…"
  fi
}

# `fleet health`: one exit code for the whole fleet, so a central node needs
# one cron entry and one push URL instead of one per runner host.
#
# Exit 0 only when every host was reached AND reported healthy. A HOST THAT
# DID NOT ANSWER IS A PROBLEM, never a silent pass — a monitor that goes
# green because a host dropped out of the fan-out is worse than no monitor,
# and that is the single assertion this command exists to make true.
# Non-empty when `fleet health` was asked to --restart-stalled (GHR-81). A
# global rather than an argument: fleet_health_report's signature is QUIET.
FLEET_HEALTH_MUTATING=""
cmd_fleet_health() { # [--host H]... [--quiet] [--json] [--max-restarts N] [--stall-after N] [--restart-stalled]
  local quiet=false json=false rc=0 i
  local -a fwd=() hosts=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      # GHR-93: as on `fleet status`; local only, never forwarded.
      --host)
        need_val "$@"; hosts+=("$2"); shift 2 ;;
      # --quiet is LOCAL only and deliberately not forwarded: the remote's
      # stdout is where the problem lines come from, so a quiet remote would
      # leave this command with an exit code and nothing to report.
      --quiet)
        quiet=true; shift ;;
      # GHR-80: forwarded as the one optional word, so a host older than
      # `health --json` refuses it, is asked again without it, and its prose
      # lines become `unclassified` problems (fleet_health_json).
      --json)
        json=true; shift ;;
      --max-restarts)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--max-restarts value '$2' is invalid — want an integer"
        fwd+=(--max-restarts "$2"); shift 2 ;;
      --stall-after)
        need_val "$@"
        # Validated here as well as on each host so a typo fails once, before
        # anything is dialled, rather than N times after N connections.
        [[ "$2" =~ ^[0-9]+$ ]] || die "--stall-after value '$2' is invalid — want a whole number of seconds"
        fwd+=(--stall-after "$2"); shift 2 ;;
      --restart-stalled)
        # GHR-81: the one health call that changes things — and the slots it
        # restarts are wedged ones, the slowest restart there is.
        FLEET_HEALTH_MUTATING=mutating
        fwd+=(--restart-stalled); shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  ! { $json && $quiet; } || die "--quiet cannot be combined with --json; the object is the whole answer, and the exit code is the same either way"
  if $json; then FLEET_OPTIONAL_ARGS=--json; fwd+=(--json); fi
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  FLEET_BUDGETS=()
  if [ -n "$FLEET_HEALTH_MUTATING" ]; then
    for i in "${!FLEET_HOSTS[@]}"; do FLEET_BUDGETS[i]="$(fleet_mutate_budget restart 1)"; done
  fi
  # GHR-89: through sudo only when it may restart something.
  FLEET_PRIV=("$FLEET_RUNNERCTL")
  if [ -n "$FLEET_HEALTH_MUTATING" ]; then
    fleet_priv_cmd
    # GHR-88: it may restart something, so it carries the origin and is
    # recorded — each host's own exit status, 1 being "had problems".
    fleet_origin
    # GHR-156: and the heartbeat, so a host that takes it is cut on silence
    # (GHR-150) — each restart prints one (GHR-149) — rather than on the
    # total; a host from before the flag refuses it, is asked again without
    # it, and stays on the total. With --json that is three optional words,
    # the most fleet_fanout's rounds take.
    fleet_heartbeat
    fleet_log_begin "$(fleet_log_argv)"
  fi
  fleet_fanout "${FLEET_PRIV[@]}" ${FLEET_ORIGIN[@]+"${FLEET_ORIGIN[@]}"} ${FLEET_HB[@]+"${FLEET_HB[@]}"} health ${fwd[@]+"${fwd[@]}"}
  [ -z "$FLEET_HEALTH_MUTATING" ] || fleet_log_results
  if $json; then
    fleet_health_json || rc=$?
  else
    fleet_health_report "$quiet" || rc=$?
  fi
  fleet_cleanup
  fleet_log_finish
  return "$rc"
}

# Reduce the fan-out to problem lines and one exit code. Each host's own
# output is reused verbatim with the host name prefixed, so the single-host
# format people already read stays intact.
fleet_health_report() { # QUIET
  local quiet="$1" i host rc line total=0 counted=true hosts_ok=0
  local -a problems=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    case "$rc" in
      0)
        hosts_ok=$((hosts_ok + 1))
        # "ok: N slot(s) healthy" — read the count when it is there, and just
        # stop counting if any host words it differently (an older remote,
        # say) rather than reporting a total that is quietly short.
        line="$(head -1 "$FLEET_DIR/$i.out" 2>/dev/null || true)"
        # GHR-104: the count is the host's, and reaches $((…)).
        num_int ""
        [[ ! "$line" =~ ^ok:\ ([0-9]+)\ slot ]] || num_int "${BASH_REMATCH[1]}"
        if [ -n "$NUM_INT" ]; then
          total=$((total + NUM_INT))
        else
          counted=false
        fi
        ;;
      1)
        # The host answered and reported problems: its lines, prefixed.
        local before="${#problems[@]}"
        while IFS= read -r line; do
          [ -n "$line" ] || continue
          problems+=("$host: $line")
        done <"$FLEET_DIR/$i.out"
        # Exit 1 with nothing on stdout is a die, not a problem list — a
        # runner-less host says so on stderr. Without this the host would
        # contribute no problem AND no ok, so a fleet of one such host would
        # exit 0 with the failure invisible: the exact hole this command
        # exists to close.
        if [ "${#problems[@]}" -eq "$before" ]; then
          problems+=("$host: $(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}" "$FLEET_HEALTH_MUTATING" "$host")")
        fi
        ;;
      *)
        problems+=("$host: $(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}" "$FLEET_HEALTH_MUTATING" "$host")")
        ;;
    esac
  done
  if [ "${#problems[@]}" -eq 0 ]; then
    if ! $quiet; then
      if $counted; then
        echo "ok: $total slot(s) healthy across $hosts_ok host(s)"
      else
        echo "ok: $hosts_ok host(s) healthy"
      fi
    fi
    return 0
  fi
  $quiet || printf '%s\n' "${problems[@]}"
  return 1
}

# `fleet health --json` (GHR-80): every host's problems in one object, the
# exit code fleet_health_report's for the same answers —
#   {"ok":false,"slots":6,"problems":[
#     {"host":"build-1","slot":"example.slot-1","kind":"stalled","detail":"…"},
#     {"host":"gw-1","slot":null,"kind":"unreachable","detail":"unreachable — …"}
#   ]}
# `host` is the name in FLEET_HOSTS, never the one the remote calls itself.
# `slots` is how many slots were checked across the fleet, null when any host
# cannot say (it did not answer, failed, or is too old and had problems).
#
# A remote's problem is DATA from another host: each field is read off its
# line with json_line_get, decoded, drawn through relay_safe and written again
# with json_str — never passed on as the bytes that came. A host too old for
# `health --json` was asked again without it (fleet_fanout), and each of its
# prose lines — already relayed where it landed — is one problem of kind
# `unclassified`, its `slot` the word before the first `: ` (null for
# `host`). A host that failed is one problem of its own: kind `unreachable`
# when it did not answer (ssh 255, a timeout), `error` when its runnerctl
# answered with nothing to read — the prose form's fleet_error_text either way.
fleet_health_field() { # LINE KEY
  json_line_get "$1" "$2"
  FHF=""
  $JF_SET || return 0
  json_unescape "$JF"
  relay_safe "$JSON_TEXT" plain
  FHF="$RELAY_SAFE"
}
FHF=""
fleet_health_json() {
  local i host rc line before slot kind detail slots=0 counted=true sep="" k got
  local -a ph=() ps=() pk=() pd=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    before="${#pk[@]}"
    case "$rc" in
      0|1)
        if fleet_optional_skip "$host" --json; then
          # Its prose says how many slots it checked only when all were fine.
          line="$(head -1 "$FLEET_DIR/$i.out" 2>/dev/null || true)"
          num_int ""
          [[ "$rc" != 0 || ! "$line" =~ ^ok:\ ([0-9]+)\ slot ]] || num_int "${BASH_REMATCH[1]}"
          if [ -n "$NUM_INT" ]; then slots=$((slots + NUM_INT)); else counted=false; fi
          while IFS= read -r line; do
            { [ "$rc" = 1 ] && [ -n "$line" ]; } || continue
            slot="" detail="$line"
            if [[ "$line" =~ ^([^\ :]+):\ (.*)$ ]]; then
              slot="${BASH_REMATCH[1]}" detail="${BASH_REMATCH[2]}"
              [ "$slot" != host ] || slot=""
            fi
            ph+=("$host") ps+=("$slot") pk+=(unclassified) pd+=("$detail")
          done <"$FLEET_DIR/$i.out"
        else
          got=false
          while IFS= read -r line; do
            case "$line" in
              '{"ok":'*)
                json_line_get "$line" slots
                num_int "$JF"
                if [ -n "$NUM_INT" ]; then slots=$((slots + NUM_INT)) got=true; fi ;;
              '  {'*)
                fleet_health_field "$line" slot; slot="$FHF"
                fleet_health_field "$line" kind; kind="$FHF"
                fleet_health_field "$line" detail; detail="$FHF"
                ph+=("$host") ps+=("$slot") pk+=("${kind:-unclassified}") pd+=("$detail") ;;
            esac
          done <"$FLEET_DIR/$i.out"
          $got || counted=false
        fi
        # Exit 1 with nothing to read is a die, as in fleet_health_report.
        if [ "$rc" = 1 ] && [ "${#pk[@]}" -eq "$before" ]; then
          ph+=("$host") ps+=("") pk+=(error)
          pd+=("$(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}" "$FLEET_HEALTH_MUTATING" "$host")")
        fi ;;
      *)
        k=error
        [ "$(fleet_reachable "$rc")" = true ] || k=unreachable
        counted=false
        ph+=("$host") ps+=("") pk+=("$k")
        pd+=("$(fleet_error_text "$rc" "$FLEET_DIR/$i.err" "${FLEET_BUDGETS[$i]:-}" "$FLEET_HEALTH_MUTATING" "$host")") ;;
    esac
  done
  $counted || slots=""
  printf '{"ok":%s,"slots":%s,"problems":[' "$([ "${#pk[@]}" -eq 0 ] && echo true || echo false)" "$(json_num "$slots")"
  for i in "${!pk[@]}"; do
    printf '%s\n  {"host":%s,"slot":%s,"kind":%s,"detail":%s}' "$sep" "$(json_str "${ph[$i]}")" \
      "$(json_strn "${ps[$i]}")" "$(json_str "${pk[$i]}")" "$(json_str "${pd[$i]}")"
    sep=","
  done
  printf '\n]}\n'
  if [ "${#pk[@]}" -eq 0 ]; then return 0; fi
  return 1
}

# `fleet history` (GHR-88): every host's `history -n N`, merged by time into
# one list, each line `<time> <host> <record>`, and the last N of it. A read:
# FLEET_TIMEOUT, FLEET_PARALLEL, no sudo. Each host's lines were relayed where
# they landed (GHR-101); a line that does not start with a record's UTC time
# is not merged. A host that did not answer is a line under the list, and the
# exit status is 1, as `fleet status` does for one.
FLEET_HISTORY_RE='^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?Z) (.*)$'
# GHR-118: the same lines and the same wording serve fleet watch's history pane.
FLEET_HISTORY_PREDATES="its runnerctl predates history — 'runnerctl fleet upgrade' brings it up to date"
# One host's `history` answer (FILE) as merge lines, `<time> <host> <record>`.
# A record is never painted: no SGR is kept either. The time is taken first —
# relay_safe matches regexes of its own.
fleet_history_lines() { # HOST FILE
  local line ts
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ $FLEET_HISTORY_RE ]] || continue
    ts="${BASH_REMATCH[1]}"
    relay_safe "${BASH_REMATCH[3]}" plain
    printf '%s %s %s\n' "$ts" "$1" "$RELAY_SAFE"
  done <"$2"
}
# Why one host's `history` call failed: a host from before the command says
# so, anything else is fleet_error_text's. BUDGET is the call's, as there.
fleet_history_failure() { # RC ERRFILE [BUDGET]
  if grep -qF "unknown command 'history'" "$2" 2>/dev/null; then
    printf '%s\n' "$FLEET_HISTORY_PREDATES"
  else
    fleet_error_text "$1" "$2" ${3:+"$3"}
  fi
}
cmd_fleet_history() { # [-n N] [--host H]...
  local n=20 rc=0 i host
  local -a hosts=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      -n|--lines) need_val "$@"; n="$2"; shift 2 ;;
      --host)     need_val "$@"; hosts+=("$2"); shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ "$n" =~ ^[1-9][0-9]{0,4}$ ]] || die "-n value '$n' is invalid — want a whole number from 1 to 99999"
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  fleet_fanout "$FLEET_RUNNERCTL" history -n "$n"
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    [ "$(fleet_rc "$i")" = 0 ] || continue
    fleet_history_lines "$host" "$FLEET_DIR/$i.out"
  done | LC_ALL=C sort -s -k1,1 | tail -n "$n"
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    [ "$(fleet_rc "$i")" != 0 ] || continue
    rc=1
    printf '%s: %s\n' "$host" "$(fleet_history_failure "$(fleet_rc "$i")" "$FLEET_DIR/$i.err")"
  done
  fleet_cleanup
  return "$rc"
}

# --- fleet compose-reap and compose-reap-timer (GHR-87) ------------------------
# The per-host Disk line says a host's docker filesystem is full; the next
# question is what holds it and whether it can go, which is compose-reap's dry
# run — so the dry run fans out like every other read: in parallel, as the
# plain login (the docker reads need the docker group, not sudo), each host's
# lines prefixed, then one total for the fleet. `--apply` changes hosts, so it
# goes through cmd_fleet_run: serial, FLEET_SUDO, --origin, the record and the
# usual per-host report — and no capacity gate (see fleet_capacity_gate).
#
# A host without docker is not a failure: a fleet where only some hosts run
# compose is the normal case, so its row says so and the exit code ignores it.
# A login that is not in the docker group is a failure, with the remedy on the
# row (fleet_error_text), because the dry run could not see that host at all.
FLEET_NO_DOCKER_ROW="no docker on this host — nothing for compose-reap to inspect (information, not a failure)"
fleet_no_docker() { # ERRFILE
  grep -qF -- "$COMPOSE_REAP_NO_DOCKER" "$1" 2>/dev/null
}

cmd_fleet_compose_reap() { # [--host H]... [--apply] [--standalone] [--project NAME] [--max-age-hours N] [--grace-minutes N]
  local apply=false rc=0 q
  local -a hosts=() fwd=() all=("$@")
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --apply)      apply=true; shift ;;
      --dry-run)    apply=false; shift ;;
      --host)       need_val "$@"; hosts+=("$2"); shift 2 ;;
      # Taken, as every mutating fan-out takes it, and asks nothing of it:
      # there is no capacity gate here to acknowledge.
      --all-hosts)  shift ;;
      --standalone) fwd+=(--standalone); shift ;;
      # Quoted for the remote shell, as cmd_fleet_run quotes what it forwards:
      # a project is a label, and a label is any text.
      --project)    need_val "$@"; printf -v q %q "$2"; fwd+=(--project "$q"); shift 2 ;;
      # Checked here as each host checks them, so a typo fails once, before
      # anything is dialled.
      --max-age-hours)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--max-age-hours must be a whole number of hours, got '$2'"
        fwd+=(--max-age-hours "$2"); shift 2 ;;
      --grace-minutes)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--grace-minutes must be a whole number of minutes, got '$2'"
        fwd+=(--grace-minutes "$2"); shift 2 ;;
      *) die "unknown option for fleet compose-reap: $1" ;;
    esac
  done
  if $apply; then
    cmd_fleet_run compose-reap ${all[@]+"${all[@]}"}
    return
  fi
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  fleet_fanout "$FLEET_RUNNERCTL" compose-reap ${fwd[@]+"${fwd[@]}"}
  fleet_compose_reap_report || rc=$?
  fleet_cleanup
  return "$rc"
}

# Each host's lines, prefixed, then the fleet total of what WOULD be reaped:
# stacks (projects) with their containers, networks and volumes, plus the
# --standalone containers, and "up to" the images those free — whether an
# image is still used by something else is only asked by --apply. Read off the
# host's own per-project lines, the counts through num_int (GHR-104).
FLEET_CR_PROJECT_RE='^reap .* containers=([0-9]+) networks=([0-9]+) volumes=([0-9]+)$'
FLEET_CR_STANDALONE_RE='^reap container [A-Za-z0-9][A-Za-z0-9_.-]* reason=[^ ]+ idle=[0-9]+m image=(.*)$'
fleet_compose_reap_report() {
  local i host rc line answered=0 nodocker=0 bad=0 stacks=0 ctr=0 net=0 vol=0 img=0 tail="" nc nn nv
  local -A imgs=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    if [ "$rc" != 0 ] && fleet_no_docker "$FLEET_DIR/$i.err"; then
      nodocker=$((nodocker + 1))
      printf '%s: %s\n' "$host" "$FLEET_NO_DOCKER_ROW"
      continue
    fi
    imgs=()
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      printf '%s: %s\n' "$host" "$line"
      [ "$rc" = 0 ] || continue
      if [[ "$line" =~ $FLEET_CR_STANDALONE_RE ]]; then
        ctr=$((ctr + 1))
        imgs["${BASH_REMATCH[1]}"]=1
      elif [[ "$line" =~ $FLEET_CR_PROJECT_RE ]]; then
        stacks=$((stacks + 1))
        # Taken out first: num_int matches a regex of its own.
        nc="${BASH_REMATCH[1]}" nn="${BASH_REMATCH[2]}" nv="${BASH_REMATCH[3]}"
        num_int "$nc"; ctr=$((ctr + ${NUM_INT:-0}))
        num_int "$nn"; net=$((net + ${NUM_INT:-0}))
        num_int "$nv"; vol=$((vol + ${NUM_INT:-0}))
      fi
    done <"$FLEET_DIR/$i.out"
    if [ "$rc" = 0 ]; then
      answered=$((answered + 1))
      img=$((img + ${#imgs[@]}))
    else
      bad=$((bad + 1))
      printf '%s: %s\n' "$host" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")"
    fi
  done
  [ "$nodocker" -eq 0 ] || tail+="; $nodocker host(s) without docker"
  [ "$bad" -eq 0 ] || tail+="; $bad host(s) failed"
  echo "fleet compose-reap (dry run, nothing removed): would reap $stacks stack(s) — $ctr container(s), $net network(s), $vol volume(s), up to $img image(s) — on $answered host(s)$tail"
  [ "$bad" -eq 0 ]
}

# `fleet compose-reap-timer status|install|remove`. status asks each host for
# `compose-reap-timer status --brief` (one line, no privilege) in parallel and
# says per host: installed, not installed, or why it could not be asked;
# install and remove change hosts, so cmd_fleet_run runs them — and each
# host's install keeps its own refusal (a root timer only runs a runnerctl
# that root owns and nobody else can write), which comes back as that host's
# row. The exit code is 0 when every host answered, installed or not.
cmd_fleet_compose_reap_timer() { # status|install|remove [--host H]...
  local sub="" h rc=0
  local -a hosts=() args=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --host) need_val "$@"; hosts+=("$2"); shift 2 ;;
      status|install|remove)
        [ -z "$sub" ] || die "fleet compose-reap-timer takes one of status, install or remove, not '$sub $1'"
        sub="$1"; shift ;;
      *) die "unknown fleet compose-reap-timer argument '$1' (status install remove, --host H)" ;;
    esac
  done
  sub="${sub:-status}"
  if [ "$sub" != status ]; then
    args=("$sub")
    for h in ${hosts[@]+"${hosts[@]}"}; do args+=(--host "$h"); done
    cmd_fleet_run compose-reap-timer "${args[@]}"
    return
  fi
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  fleet_fanout "$FLEET_RUNNERCTL" compose-reap-timer status --brief
  fleet_compose_reap_timer_report || rc=$?
  fleet_cleanup
  return "$rc"
}

fleet_compose_reap_timer_report() {
  local i host rc line inst=0 none=0 down=0 bad=0 tail=""
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    line="$(head -n 1 "$FLEET_DIR/$i.out" 2>/dev/null || true)"
    case "$rc:$line" in
      "0:timer: installed"*)
        inst=$((inst + 1)); printf '%s: %s\n' "$host" "${line#timer: }" ;;
      "0:timer: not installed")
        none=$((none + 1)); printf '%s: not installed\n' "$host" ;;
      0:*)
        bad=$((bad + 1)); printf '%s: an answer this node does not read: %s\n' "$host" "${line:-(nothing)}" ;;
      *)
        if [ "$(fleet_reachable "$rc")" = false ]; then down=$((down + 1)); else bad=$((bad + 1)); fi
        if grep -qF "compose-reap-timer status takes no arguments" "$FLEET_DIR/$i.err" 2>/dev/null; then
          printf "%s: its runnerctl predates 'compose-reap-timer status --brief' — 'runnerctl fleet upgrade' brings it up to date\n" "$host"
        else
          printf '%s: %s\n' "$host" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")"
        fi ;;
    esac
  done
  [ "$bad" -eq 0 ] || tail=", $bad failed"
  echo "fleet compose-reap-timer: $inst installed, $none not installed, $down unreachable$tail"
  [ $((down + bad)) -eq 0 ]
}

cmd_fleet_status() { # [--host H]... [--json [--watch|-w] [--interval N] [--iterations N]] [--color WHEN] [--stall-after N] [--narrow]
  local json=false narrow=false rc=0 watch=false interval=5 iterations="" timed=false
  local -a fwd=() stall=() hosts=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then
      # --stall-after is only meaningful where the STALLED marker (table) or
      # the job_stalled field (--json) is COMPUTED, which is the remote — so
      # it is forwarded on both fan-outs, or it would be an accepted flag
      # that silently does nothing (the bug this fixes). --color is NOT
      # forwarded: `fleet status` asks the remote for --color never and
      # paints locally, unlike `fleet watch`. `stall` is the same flag for
      # the summary's --json pass (GHR-72), which must not be handed --narrow.
      [ "$1" != --stall-after ] || { fwd+=(--stall-after "$2"); stall=(--stall-after "$2"); }
      shift "$VIEW_SHIFT"; continue
    fi
    case "$1" in
      # GHR-93: the same repeatable selection the mutating commands take, so
      # the read-only view can be narrowed to the host a call just timed out
      # on. Never forwarded — it picks who is dialled, not what they answer.
      --host)   need_val "$@"; hosts+=("$2"); shift 2 ;;
      --json)   json=true; shift ;;
      # GHR-56: forwarded, because the columns are dropped where the table
      # is drawn. Never switched on by measuring, unlike `fleet watch`: that
      # would cost a second fan-out, and a one-shot table is as likely to be
      # piped as read, which is why the local `status` never narrows itself
      # either. A host too old for the flag answers full-width (fleet_fanout).
      --narrow) narrow=true; fwd+=(--narrow); FLEET_OPTIONAL_ARGS+=" --narrow"; shift ;;
      # GHR-80: the stream. See fleet_status_stream.
      --watch|-w) watch=true; shift ;;
      --interval)
        need_val "$@"
        [[ "$2" =~ ^0*[1-9][0-9]{0,5}$ ]] || die "--interval value '$2' is invalid — want a whole number of seconds, at least 1"
        interval="$((10#$2))" timed=true; shift 2 ;;
      --iterations)
        need_val "$@"
        [[ "$2" =~ ^[0-9]{1,6}$ ]] || die "--iterations value '$2' is invalid — want an integer"
        iterations="$((10#$2))" timed=true; shift 2 ;;
      *)        die "unknown option: $1" ;;
    esac
  done
  ! { $json && $narrow; } || die "--narrow cannot be combined with --json; the JSON object has no columns to drop"
  if ! $json && $watch; then
    die "fleet status --watch is the JSON stream and needs --json; for the table, use 'runnerctl fleet watch'"
  fi
  if ! $watch && $timed; then
    die "--interval and --iterations belong to the stream: 'runnerctl fleet status --json --watch'"
  fi
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  if $watch; then
    fleet_status_stream "$interval" "$iterations" ${fwd[@]+"${fwd[@]}"}
    return 0
  fi
  if $json; then
    fleet_fanout "$FLEET_RUNNERCTL" status --json ${fwd[@]+"${fwd[@]}"}
    fleet_status_json || rc=$?
  else
    color_setup "$COLOR_MODE"
    # --color never on the remote: the fleet renderer paints locally, and a
    # remote SGR sequence would be measured as visible width by the prefix.
    # GHR-90: --with-json, so the summary's payload rides on the table call;
    # fleet_summary_fetch then asks only a host too old for the flag.
    FLEET_OPTIONAL_ARGS+=" --with-json"
    fleet_fanout "$FLEET_RUNNERCTL" status --color never ${fwd[@]+"${fwd[@]}"} --with-json
    fleet_summary_fetch ${stall[@]+"${stall[@]}"}
    fleet_status_table || rc=$?
    fleet_summary_line
  fi
  fleet_cleanup
  return "$rc"
}

# --- Fleet watch (GHR-54) -----------------------------------------------------
# `fleet status` in a redraw loop, over ssh connections that stay open.
#
# The loop is cmd_watch's shape — one printf of home + clear + frame, so the
# redraw is atomic and does not flicker — and the frame is the fleet table
# rather than the local one. Three things differ, and each follows from the
# table coming from somewhere else:
#
#   * The connections are HELD OPEN (fleet_ssh_control_open). This is the
#     whole reason the command exists: `watch runnerctl fleet status` dials
#     every host afresh on every tick and gets throttled for it.
#   * The remote is asked for `--color always`, where `fleet status` asks for
#     `never` and paints locally. A watch wants the per-cell colour the local
#     watch has, and the only thing that knows a cell is STALLED, throttled
#     or running is the host that drew it.
#   * Its cursor addresses a (host, slot) PAIR, and the action keys (GHR-55)
#     run the remote host's own runnerctl over the held connection — see the
#     block below.
#
# The default interval is 5 s rather than the local watch's 2 s: every tick is
# a network round trip to every host, and a tick that has not finished before
# the next one starts is not a faster view, it is a queue.

# --- Fleet watch: fetching in the background (GHR-74) -------------------------
# A tick used to be a fan-out the loop WAITED for, so the slowest host set the
# pace for all of them: one box that accepted the connection and then stalled
# made every frame FLEET_TIMEOUT late and left the keyboard dead for as long.
#
# Now each host is fetched by a background job of its own and the frame is
# assembled from whatever each host LAST returned:
#
#   * One job per host, and never two for the same host at once. A job makes
#     the tick's call — the table with the summary's JSON behind it (GHR-90;
#     a host too old for that is asked a second time, for `status --json`) —
#     on FLEET_WATCH_TIMEOUT rather than
#     FLEET_TIMEOUT, and publishes them TOGETHER: it writes into `<i>.new/`
#     and renames that to `<i>.done/`, so the loop only ever sees a whole
#     answer and a redraw can never read half of one.
#   * The loop is the only reader. fleet_watch_collect takes a `.done` into
#     the flat `<i>.out/.err/.rc/.json/.jrc` files the renderers already read
#     (FW_STATE stands in for FLEET_DIR while a frame is assembled). A good
#     answer replaces all of them and stamps `<i>.seen`; a failed one replaces
#     the exit status and the error ONLY — the rows it had stay, which is what
#     fleet_status_table draws dimmed under the age line.
#   * The wait between two frames is always the key read. While a job is out
#     it is FW_POLL long, so an answer is on screen within that of landing and
#     a key is handled at once; otherwise it is what is left of the interval.
#     Nothing on this path calls `wait`: viewport_read_key arms its WINCH trap
#     around the read, and a trapped signal makes a `wait` return early.
#   * A host still out when the next tick comes due is `late`: not asked a
#     second time (it has a call in flight), not answering as far as the
#     summary is concerned, and — if it answered before — shown as its old
#     rows with their age. Until that tick its rows are simply the newest
#     there are, exactly as old as every row is between two ticks, so a call
#     that takes its ordinary few hundred milliseconds never dims anything.
#   * `--iterations` (the headless test path) has no keys to keep alive, so it
#     waits for the round and prints once — by pid, with no trap armed.
#
# FW_PID is each host's state, indexed like FLEET_HOSTS: empty when idle, `-`
# when queued behind FLEET_PARALLEL, else the pid of its job. FW_AGAIN marks a
# host whose job was already out when an action key asked for a fresh frame:
# what that job brings back may predate the action, so it is fetched once
# more as soon as it lands.
#
# FW_NEXT is when the next tick is due, in now_ms's milliseconds.
#
# FW_JSON_ONLY is `fleet status --json --watch` (GHR-80): FW_TABLE_ARGS is
# then `status --json …`, the one call a host is asked per tick.
FW_STATE="" FW_POLL="0.2" FW_NEXT=0 FW_INTERVAL=5 FW_DIRTY=false FW_JSON_ONLY=false
FW_PID=() FW_AGAIN=() FW_TABLE_ARGS=() FW_JSON_ARGS=()

# One host's tick, in the background: nothing it sets survives, which is why a
# host found too old for a flag of FLEET_OPTIONAL_ARGS (--narrow, --with-json)
# is remembered as a file, `<i>.refuses<flag>`, one per flag. See fleet_fanout
# for that skew rule — the same one, with the retries in the same job: a
# refusal names one flag, so a host too old for both is asked once more for
# each, on its first tick, and never again in this session.
#
# GHR-115: the table call also hands the host back the CPU samples of its own
# previous payload (`--cpu-prev=…`, fleet_cpu_prev_spec), so from its second
# tick on it draws the CPU column without the one-shot wait. Read here, in the
# job, from the flat `<i>.json` — which the loop replaces only when it takes
# in THIS job's answer, so nothing moves it while the job reads it. Remembered
# by flag name (`<i>.refuses--cpu-prev`) like the others; a host that refuses
# it waits for its sample as it always did. Never on the stream
# (FW_JSON_ONLY): `status --json` takes no second sample to save.
fleet_watch_fetch_one() { # INDEX
  local i="$1" host d a hrc=0 t0 refused round cpu_prev=""
  local -a args=() table=("${FW_TABLE_ARGS[@]}")
  # GHR-162: a worker — fleet_watch_reap ends it with its ssh; on bash 5.2 it
  # would otherwise hold the watch's `exit 0` INT trap.
  builtin trap '' INT QUIT
  host="${FLEET_HOSTS[$i]}" d="$FW_STATE/$i.new"
  rm -rf "$d"
  mkdir "$d"
  $FW_JSON_ONLY || cpu_prev="$(fleet_cpu_prev_spec "$FW_STATE/$i.json")"
  [ -z "$cpu_prev" ] || table+=("$cpu_prev")
  for round in 0 1 2 3; do
    if [ "$round" -gt 0 ]; then
      # Asked again only when the call refused a flag it is allowed to drop.
      [ "$hrc" = 1 ] || break
      refused=""
      for a in "${args[@]}"; do
        if fleet_optional_is "$a" && fleet_optional_rejects "$d/err" "$a"; then refused="${a%%=*}"; break; fi
      done
      [ -n "$refused" ] || break
      : >"$FW_STATE/$i.refuses$refused"
      hrc=0
    fi
    args=()
    for a in "${table[@]}"; do
      if fleet_optional_is "$a" && [ -e "$FW_STATE/$i.refuses${a%%=*}" ]; then continue; fi
      args+=("$a")
    done
    # GHR-80: `duration_ms`, timed as fleet_fanout_one times it.
    t0="$(now_ms)"
    FLEET_CALL_TIMEOUT="${FLEET_BUDGETS[$i]:-}" ssh_run "$host" "$FLEET_RUNNERCTL" "${args[@]}" >"$d/out" 2>"$d/err" || hrc=$?
  done
  echo $(($(now_ms) - t0)) >"$d/ms"
  # GHR-90: the summary's payload, when it came with the table — split off
  # before the table is relayed, into the files the second call would fill.
  if fleet_args_with_json "${args[@]}"; then
    fleet_with_json_split "$d/out" "$d/json" "$d/jrc" "$hrc"
  fi
  # GHR-101: filtered here, in the job, before the answer is published — so
  # the flat files fleet_watch_collect moves it into, and every frame, view,
  # pane and age line drawn from them on every redraw after, only ever hold
  # relayable text, and the filtering is paid once per answer, off the loop.
  # The --json payload below is parsed, never drawn as it came (see
  # fleet_fanout_one) — and under the stream (FW_JSON_ONLY) the table call
  # IS that payload, nested unchanged or not at all (fleet_payload_ok).
  $FW_JSON_ONLY || relay_file "$d/out"
  relay_file "$d/err"
  echo "$hrc" >"$d/rc"
  # GHR-72's summary pass, to a host whose table call exited 0 and no other:
  # one that is down is dialled once per tick, not twice. The stream's one
  # call already was the payload, and so was a --with-json table's (GHR-90):
  # only a host too old for that flag gets here.
  if [ "$hrc" = 0 ] && ! $FW_JSON_ONLY && [ ! -e "$d/jrc" ]; then
    FLEET_CALL_TIMEOUT="${FLEET_BUDGETS[$i]:-}" ssh_run "$host" "$FLEET_RUNNERCTL" status --json ${FW_JSON_ARGS[@]+"${FW_JSON_ARGS[@]}"} >"$d/json" 2>/dev/null || hrc=$?
    echo "$hrc" >"$d/jrc"
  fi
  mv "$d" "$FW_STATE/$i.done"
}

# Whether any host is queued or has a job out.
fleet_watch_busy() {
  local i
  for i in "${!FW_PID[@]}"; do [ -z "${FW_PID[$i]}" ] || return 0; done
  return 1
}

# Start the queued hosts, as many as FLEET_PARALLEL leaves room for. A job's
# stdout and stderr go nowhere: every byte it has to say is in its files, and
# it may outlive the directory they are in by a moment on the way out.
fleet_watch_pump() {
  local i running=0
  for i in "${!FW_PID[@]}"; do
    [[ "${FW_PID[$i]}" != [0-9]* ]] || running=$((running + 1))
  done
  for i in "${!FW_PID[@]}"; do
    [ "${FW_PID[$i]}" = "-" ] || continue
    [ "$running" -lt "$FLEET_PARALLEL" ] || break
    fleet_watch_fetch_one "$i" >/dev/null 2>&1 &
    FW_PID[i]="$!"
    running=$((running + 1))
  done
}

# Take in what has landed since the last look; FW_DIRTY when anything did.
# A job that is gone without having published — killed from outside — is an
# answer too, or its host would read as "still running" for ever: that one
# gets a failed result made here.
fleet_watch_collect() {
  local i d rc
  for i in "${!FW_PID[@]}"; do
    [[ "${FW_PID[$i]}" == [0-9]* ]] || continue
    d="$FW_STATE/$i.done"
    if [ ! -d "$d" ]; then
      ! kill -0 "${FW_PID[$i]}" 2>/dev/null || continue
      # Gone — and it may have published between the two looks.
      if [ ! -d "$d" ]; then
        mkdir -p "$d"
        echo 255 >"$d/rc"
        echo "the call ended without an answer" >"$d/err"
      fi
    fi
    rc="$(cat "$d/rc" 2>/dev/null || echo 255)"
    if [ "$rc" = 0 ]; then
      mv -f "$d/out" "$FW_STATE/$i.out"
      rm -f "$FW_STATE/$i.json" "$FW_STATE/$i.jrc"
      [ ! -e "$d/json" ] || mv -f "$d/json" "$FW_STATE/$i.json"
      [ ! -e "$d/jrc" ] || mv -f "$d/jrc" "$FW_STATE/$i.jrc"
      # Seen: only an answer that IS a table (fleet_status_table's own test)
      # is something to show again later.
      if [ "$(wc -l <"$FW_STATE/$i.out")" -ge 3 ]; then now_epoch >"$FW_STATE/$i.seen"; fi
    fi
    [ ! -e "$d/err" ] || mv -f "$d/err" "$FW_STATE/$i.err"
    [ ! -e "$d/ms" ] || mv -f "$d/ms" "$FW_STATE/$i.ms"
    echo "$rc" >"$FW_STATE/$i.rc"
    rm -rf "$d"
    FW_PID[i]=""
    if [ -n "${FW_AGAIN[$i]:-}" ]; then FW_AGAIN[i]="" FW_PID[i]="-"; fi
    FW_DIRTY=true
  done
  fleet_watch_pump
}

# A round: every host that has no call out is asked. WHY is `tick` when the
# interval came due and `refresh` when an action key just ran — the two differ
# only in what happens to a host that is still out (see the block above).
# The next tick is counted from here, not from when the answers arrive.
fleet_watch_round() { # tick|refresh
  local i
  fleet_watch_collect
  FW_NEXT=$(($(now_ms) + FW_INTERVAL * 1000))
  for i in "${!FW_PID[@]}"; do
    if [ -z "${FW_PID[$i]}" ]; then
      FW_PID[i]="-"
    elif [ "$1" = refresh ]; then
      FW_AGAIN[i]=1
    elif [ "$(cat "$FW_STATE/$i.rc" 2>/dev/null || echo late)" = 0 ]; then
      # Late. A host whose last call FAILED keeps that failure's own words.
      echo late >"$FW_STATE/$i.rc"
    fi
  done
  # Dirty whatever landed: a frame showing an age has to count it up.
  FW_DIRTY=true
  fleet_watch_pump
}

# `--iterations`: block until the round is in. The only `wait` in the watch,
# and no trap is armed here for a signal to cut it short.
fleet_watch_settle() {
  while fleet_watch_busy; do
    wait -n 2>/dev/null || true
    fleet_watch_collect
  done
}

# End every fetch still out, with whatever it started (its `timeout`, and the
# ssh under that). Only a pid this process started and has not yet taken the
# answer of, and only while it is still this process's child — a pid that has
# been reaped can belong to anything by now.
fleet_watch_reap() {
  local i pid
  for i in "${!FW_PID[@]}"; do
    pid="${FW_PID[$i]}"
    FW_PID[i]=""
    [[ "$pid" == [0-9]* ]] || continue
    [ "$(proc_ppid "$pid")" = "$$" ] || continue
    proc_tree_kill "$pid"
  done
}

# Restores the terminal, ends the background fetches, drops the buffer
# directories and closes every ssh master. The ONE exit trap of a watch
# (FLEET_EXIT_OWNED keeps a fan-out made from inside it from taking it over).
# Ordering is deliberate: the cursor comes back first, so a slow or hanging
# close cannot leave an invisible cursor behind; the fetches end before their
# directory goes; and the masters close last, with no client left on them.
fleet_watch_cleanup() {
  term_cursor show
  viewport_close
  # GHR-125: the actions still out, before their directory goes.
  fleet_watch_act_quit
  fleet_watch_hist_stop
  fleet_watch_reap
  fleet_cleanup
  [ -z "$FW_TMP" ] || rm -rf "$FW_TMP"
  [ -z "$FW_STATE" ] || rm -rf "$FW_STATE"
  FW_STATE=""
  fleet_ssh_control_close
}

# --- Fleet status stream (GHR-80) ----------------------------------------------
# `fleet status --json --watch [--interval N]`: one envelope per tick, each on
# a line of its own (newline-delimited JSON), until a signal or the reader
# goes away. A front end reads a pipe instead of dialling every host per poll.
#
# Why the fleet allows `--json --watch` where the one-host `status` refuses it
# ("poll it instead"): polling `status --json` locally costs a fork, so a
# stream would buy nothing. Polling `fleet status --json` costs a full ssh
# login per host per poll — the throttling and fail2ban trouble `fleet watch`
# was written to remove (GHR-54). The stream is the only way a consumer gets
# the held connections, so here the trade goes the other way.
#
# It is `fleet watch`'s machinery with no terminal: the same held masters, the
# same one background fetch per host (GHR-74) — but ONE call per tick, `status
# --json`, since that payload is all an envelope needs (FW_JSON_ONLY) — and the
# same per-host state in FW_STATE. A tick's envelope is written once every host
# has answered or the interval is up, whichever is first; a host whose call is
# still out then is reported as `fleet watch` draws it: its last payload kept,
# `stale` true with its `last_seen`, when it answered before — `reachable`
# false and `status` null when it never has. Either way it counts towards
# `hosts` only.
#
# Each envelope is fleet_status_json with its newlines taken out. That is safe
# only because a nested payload passed fleet_payload_ok, which refuses any raw
# control byte but a newline or a tab, and JSON allows neither inside a
# string: every newline left is whitespace between two tokens.
#
# Ends cleanly, exit 0, on SIGINT, SIGTERM, and on a reader that closed the
# pipe — a failed write, or SIGPIPE where that can be trapped — reaping every
# fetch still out (fleet_watch_reap) and closing the masters. `--iterations N`
# is the test path, as for `fleet watch`: it waits for each round and stops
# after N envelopes.
fleet_stream_cleanup() {
  fleet_watch_reap
  fleet_cleanup
  [ -z "$FW_STATE" ] || rm -rf "$FW_STATE"
  FW_STATE=""
  fleet_ssh_control_close
}
# The stream's wait for a moment: a hook, like pause, so the sim can see it.
stream_wait() { sleep "$1"; }
fleet_status_stream() { # INTERVAL ITERATIONS [STATUS-ARGS...]
  local interval="$1" iterations="$2" tick=0 i env left
  shift 2
  fleet_ssh_control_open "$((interval + FLEET_TIMEOUT + 30))"
  FW_STATE="$(mktemp -d)"
  FLEET_EXIT_OWNED=true
  trap fleet_stream_cleanup EXIT
  trap 'exit 0' INT TERM PIPE
  FW_INTERVAL="$interval" FW_PID=() FW_AGAIN=() FW_JSON_ONLY=true
  FW_TABLE_ARGS=(status --json "$@")
  for i in "${!FLEET_HOSTS[@]}"; do
    FW_PID[i]="" FW_AGAIN[i]=""
    FLEET_BUDGETS[i]="$FLEET_WATCH_TIMEOUT"
    echo late >"$FW_STATE/$i.rc"
  done
  while :; do
    fleet_watch_round tick
    if [ -n "$iterations" ]; then
      fleet_watch_settle
    else
      while fleet_watch_busy && [ "$(now_ms)" -lt "$FW_NEXT" ]; do
        stream_wait "$FW_POLL"
        fleet_watch_collect
      done
    fi
    FLEET_DIR="$FW_STATE"
    env="$(fleet_status_json || true)"
    FLEET_DIR=""
    printf '%s\n' "${env//$'\n'/}" 2>/dev/null || exit 0
    tick=$((tick + 1))
    if [ -n "$iterations" ]; then
      [ "$tick" -lt "$iterations" ] || break
      pause "$interval"
      continue
    fi
    left=$((FW_NEXT - $(now_ms)))
    [ "$left" -le 0 ] || stream_wait "$(ms_to_secs "$left")"
  done
}

# --- Fleet watch action keys (GHR-55) -----------------------------------------
# The local watch's K/R/S/T/P/L, against the slot the cursor is on — which on a
# fleet is not the local feature with a host name bolted on, in three ways:
#
#   * THE CURSOR IS A PAIR. A unit name is unique on one host and not across a
#     fleet, so the cursor is (FW_HOST, FW_NAME), FW_NAME being the RUNNER cell.
#     The rows are read off the assembled frame by their two LEFTMOST cells
#     (HOST, then IDX and RUNNER), which is safe where parsing by column
#     position is not: an over-wide cell only shifts what is to its right.
#     It survives both ways a row can leave a frame. A host that stops
#     answering keeps its rows (GHR-74), dimmed under their age, and the
#     cursor stays on the slot it was on — those rows are selectable, because
#     a key on one decides on facts read from the host at that moment and
#     never on the row. A host with no rows to keep is one error row: the
#     cursor waits there and REMEMBERS the slot, so the frame the host
#     answers in puts it back. A slot that goes away (scaled down) drops it
#     to that host's first slot.
#   * THE FACTS ARE REMOTE. An action is decided on the host's own `status
#     --json`, fetched when the key is pressed — one round trip to that host
#     over the held connection — never on the frame, which is up to an
#     interval old. The confirm line quotes what came back, and names the
#     exact remote command. `status --json` has been there since long before
#     `fleet`, so an older host needs no new flag to answer it.
#   * S HAS A CAPACITY FLOOR. `fleet stop` is refused fleet-wide without
#     --host or --all-hosts (GHR-43), and a single-slot key is as bounded a
#     target as there is, so it does not need either. But a watch that walks
#     the cursor down every host pressing S, y, S, y reaches zero capacity
#     just as surely as an unguarded `fleet stop` — each confirm is explicit,
#     and none of them is about the fleet. So S re-reads every watched host's
#     slots (a fan-out over the held connections) and refuses a stop that
#     would leave fewer than --min-available K slots active across them,
#     default 1: the watch never stops the last running slot you can see. A
#     host that did not answer counts as NOTHING available, so an outage does
#     not make the floor easier to cross. The confirm line states what the
#     stop leaves. R and K are transient (the unit comes back) and T/P give
#     nothing away, which is GHR-43's classification unchanged; they are not
#     gated.
#
# L pages the slot's last 50 journal lines, like the local L. Not a stream: the
# remote `logs -n 50` runs to completion into a file under FLEET_TIMEOUT and
# that file is handed to the local pager, so a slow host can hold the key up
# for at most that long, and never with a pager already on the screen.
FW_HOST="" FW_NAME="" FW_POS=-1 FW_TMP="" FW_REFRESH=false
FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_HOST="" FW_ACT_NAME=""
FW_ROWS=() FW_LINES=()
FLEET_WATCH_MIN_AVAILABLE=1
declare -A FF=()

# This frame's selectable rows, in order: "HOST<TAB>NAME" for a slot row and
# "HOST<TAB>" for a host that did not answer, with the frame line each is on.
# Only a first word that IS a watched host counts, so the column header, a
# note and the skew line are never rows; nor is a host line (GHR-66), which
# starts with a watched host but would otherwise read as that host's
# did-not-answer row — and fleet_watch_place prefers that row. The age line
# over a host's kept rows (GHR-74) is skipped for the same reason: the rows
# under it are that host's rows.
fleet_watch_rows() { # FRAME
  local line n=0 h re_slot='^([^ ]+) +[0-9]+ +([^ ]+)( |$)' re_host='^([^ ]+) '
  local -A known=()
  for h in "${FLEET_HOSTS[@]}"; do known[$h]=1; done
  FW_ROWS=() FW_LINES=()
  while IFS= read -r line; do
    n=$((n + 1))
    strip_sgr "$line"
    [[ ! "$SGR_STRIPPED" =~ $FLEET_INFO_RE ]] || continue
    [[ ! "$SGR_STRIPPED" =~ $FLEET_STALE_RE ]] || continue
    if [[ "$SGR_STRIPPED" =~ $re_slot ]] && [ -n "${known[${BASH_REMATCH[1]}]:-}" ]; then
      FW_ROWS+=("${BASH_REMATCH[1]}"$'\t'"${BASH_REMATCH[2]}"); FW_LINES+=("$n")
    elif [[ "$SGR_STRIPPED" =~ $re_host ]] && [ -n "${known[${BASH_REMATCH[1]}]:-}" ]; then
      FW_ROWS+=("${BASH_REMATCH[1]}"$'\t'); FW_LINES+=("$n")
    fi
  done <<<"$1"
}

# Put the cursor on this frame's rows: its own pair if it is there; the host's
# error row if the host did not answer (FW_NAME kept, so it comes back); the
# host's first slot if the slot went away; else the first row.
fleet_watch_place() {
  local i h n first=-1 down=-1
  FW_POS=-1
  for i in "${!FW_ROWS[@]}"; do
    h="${FW_ROWS[$i]%%$'\t'*}"; n="${FW_ROWS[$i]#*$'\t'}"
    [ "$h" = "$FW_HOST" ] || continue
    if [ -n "$n" ] && [ "$n" = "$FW_NAME" ]; then FW_POS="$i"; return 0; fi
    if [ -z "$n" ]; then down="$i"; elif [ "$first" -lt 0 ]; then first="$i"; fi
  done
  if [ "$down" -ge 0 ]; then FW_POS="$down"; return 0; fi
  if [ "$first" -ge 0 ]; then FW_POS="$first"
  elif [ "${#FW_ROWS[@]}" -gt 0 ]; then FW_POS=0
  else return 0
  fi
  fleet_watch_select "$FW_POS"
}
fleet_watch_select() { # ROW-INDEX
  FW_POS="$1"
  FW_HOST="${FW_ROWS[$1]%%$'\t'*}"; FW_NAME="${FW_ROWS[$1]#*$'\t'}"
}

# watch_highlight's reverse video, on a frame line picked by NUMBER: a RUNNER
# name repeats on every host, so matching the row by its name would light up
# the same slot on all of them.
fleet_watch_highlight() { # FRAME LINE-NO
  local line n=0 rev=$'\e[7m' reset=$'\e[0m'
  while IFS= read -r line; do
    n=$((n + 1))
    if [ "$n" = "$2" ]; then
      printf '%s%s%s\n' "$rev" "${line//"$reset"/$reset$rev}" "$reset"
    else
      printf '%s\n' "$line"
    fi
  done <<<"$1"
}

# One field of a one-line JSON object, first occurrence: a string's contents,
# a number or boolean as written, nothing for null or a missing key (an older
# host that does not report it). render_status_json writes each slot on one
# line and this script owns it — the same footing fleet_slots reads it on.
#
# json_line_get leaves it in JF (JF_SET false for null or a missing key) and
# starts no subshell, for the callers that read several fields of every slot
# on every redraw (GHR-75); json_line_field prints it. (Not json_field: that
# name is the GitHub API reader's, further down, which reads stdin.)
JF="" JF_SET=false
json_line_get() { # LINE KEY
  local re="\"$2\":(\"(([^\"\\\\]|\\\\.)*)\"|[-0-9.a-z]+)"
  JF="" JF_SET=false
  [[ "$1" =~ $re ]] || return 0
  case "${BASH_REMATCH[1]}" in
    \"*) JF="${BASH_REMATCH[2]}" JF_SET=true ;;
    null) ;;
    *)   JF="${BASH_REMATCH[1]}" JF_SET=true ;;
  esac
}
json_line_field() { # LINE KEY
  json_line_get "$1" "$2"
  ! $JF_SET || printf '%s\n' "$JF"
}

# The contents of a JSON string as json_line_get hands them back — still
# escaped — turned into the text they stand for, into JSON_TEXT (GHR-76). The
# readers above never needed this: a state, a number or a URL has no escape in
# it. A workflow called `Build "x"` does, and drawn as it arrives it reads
# `Build \"x\"`.
#
# One pass, left to right, so an escaped backslash is consumed with the
# character after it and `\\n` stays a backslash and an `n`. `\uXXXX` becomes
# the character's UTF-8 bytes, a surrogate pair one character; a lone
# surrogate becomes `?` and U+0000 nothing (a shell string cannot hold it).
#
# WHAT COMES OUT IS NOT SAFE TO DRAW. `\u001b` is an Escape again here, by
# design: this is decoding, and term_safe is what makes text drawable. The
# order is the whole point — unescape, THEN term_safe. The other way round the
# control character is still spelled as six harmless characters when term_safe
# looks, and is produced after it has finished.
JSON_TEXT=""
json_unescape() { # STRING
  local s="${1-}" out="" c hex cp lo
  JSON_TEXT="$s"
  [[ "$s" == *\\* ]] || return 0
  while [[ "$s" == *\\* ]]; do
    out+="${s%%\\*}"
    s="${s#*\\}"
    c="${s:0:1}" s="${s:1}"
    case "$c" in
      n) out+=$'\n' ;;
      r) out+=$'\r' ;;
      t) out+=$'\t' ;;
      b) out+=$'\b' ;;
      f) out+=$'\f' ;;
      u)
        hex="${s:0:4}"
        if [[ ! "$hex" =~ ^[0-9a-fA-F]{4}$ ]]; then out+="?"; continue; fi
        s="${s:4}" cp=$((16#$hex))
        if [ "$cp" -ge 55296 ] && [ "$cp" -le 56319 ] && [[ "${s:0:6}" =~ ^\\u([dD][c-fC-F][0-9a-fA-F]{2})$ ]]; then
          lo=$((16#${BASH_REMATCH[1]}))
          s="${s:6}" cp=$((65536 + (cp - 55296) * 1024 + lo - 56320))
        fi
        json_utf8 "$cp"; out+="$JSON_CHAR" ;;
      *) out+="$c" ;;
    esac
  done
  JSON_TEXT="$out$s"
}
# Code point CP as UTF-8 bytes, into JSON_CHAR — spelled out rather than left
# to printf's \u, which writes whatever the caller's locale makes of it.
JSON_CHAR=""
json_utf8() { # CP
  local cp="$1" esc
  JSON_CHAR=""
  if [ "$cp" -eq 0 ]; then return 0
  elif [ "$cp" -ge 55296 ] && [ "$cp" -le 57343 ]; then JSON_CHAR="?"; return 0
  elif [ "$cp" -lt 128 ]; then printf -v esc '\\x%02x' "$cp"
  elif [ "$cp" -lt 2048 ]; then printf -v esc '\\x%02x\\x%02x' $((192 + cp / 64)) $((128 + cp % 64))
  elif [ "$cp" -lt 65536 ]; then
    printf -v esc '\\x%02x\\x%02x\\x%02x' $((224 + cp / 4096)) $((128 + cp / 64 % 64)) $((128 + cp % 64))
  else
    printf -v esc '\\x%02x\\x%02x\\x%02x\\x%02x' $((240 + cp / 262144)) $((128 + cp / 4096 % 64)) $((128 + cp / 64 % 64)) $((128 + cp % 64))
  fi
  printf -v JSON_CHAR '%b' "$esc"
}

# One string field of LINE as text, into PJ: json_line_get's, unescaped. Empty
# for null or a key that is not there — an older host that does not report it.
PJ=""
pane_json() { # LINE KEY
  PJ=""
  json_line_get "$1" "$2"
  $JF_SET || return 0
  json_unescape "$JF"
  PJ="$JSON_TEXT"
}
# The same for a field that has to be a number: into PJ, empty unless it is a
# whole number arithmetic can take (pane_int).
pane_json_int() { # LINE KEY
  json_line_get "$1" "$2"
  pane_int "$JF"
  PJ="$PANE_INT"
}

# PN from a host's `status --json` payload: `fleet watch`'s filler (GHR-76).
# HOSTLINE is the payload's first line (the one carrying the host object),
# SLOTLINE the selected slot's; either may be empty, and every field read
# tolerates a key that is not there — a host older than the field prints `—`
# for it. A string is unescaped here and made safe where it is drawn
# (pane_put); a number is held to pane_int here, because the renderer does
# arithmetic on it and this is a string another host sent.
pane_from_json() { # HOSTLINE SLOTLINE
  local hl="$1" sl="$2" job=null rest piece obj roles k us=$'\x1f'
  PN=([host]="" [name]="" [unit]="" [profile]="" [enabled]="" [version]="" [version_sgr]="" [active]="" [sub]=""
      [since_age]="" [restarts]="" [result]="" [reason]="" [job]="" [access]=""
      [mem_cur]="" [mem_peak]="" [mem_high]="" [mem_max]="" [p10]="" [p60]=""
      [ev_high]="" [ev_max]="" [ev_oom]="" [leaked]="" [leak_list]=""
      [cores]="" [mem_total]="" [mem_avail]="" [disks]="" [events]="")
  if [ -n "$hl" ]; then
    # GHR-77: as the host line draws it — X.Y.Z or `?`, yellow when it is
    # not this node's version. A payload with no version key is a host older
    # than the field, `—` like any other.
    pane_json "$hl" runnerctl; PN[version]="$PJ"
    if [ -n "$PJ" ]; then
      fleet_ver "$PJ"; PN[version]="$FLEET_VER"
      [ "$FLEET_VER" = "$RUNNERCTL_VERSION" ] || PN[version_sgr]="$C_YELLOW"
    fi
    pane_json "$hl" name; PN[host_name]="$PJ"
    pane_json_int "$hl" cores; PN[cores]="$PJ"
    pane_json_int "$hl" mem_total; PN[mem_total]="$PJ"
    pane_json_int "$hl" mem_available; PN[mem_avail]="$PJ"
    # Each disk object starts at its "mount" key; what is cut off before the
    # next one is that disk's.
    rest="$hl"
    while [[ "$rest" == *'{"mount":'* ]]; do
      rest="${rest#*'{"mount":'}"
      piece="\"mount\":${rest%%'{"mount":'*}"
      roles=""
      if [[ "$piece" =~ \"roles\":\[([^]]*)\] ]]; then
        roles="${BASH_REMATCH[1]//\"/}"
        json_unescape "$roles"; roles="$JSON_TEXT"
      fi
      pane_json_int "$piece" use_pct; k="$PJ"
      pane_json_int "$piece" avail; k+="$us$PJ"
      pane_json "$piece" mount
      # One line per disk: a mount point is one line of text or it is not one.
      PN[disks]+="${PN[disks]:+$'\n'}$k$us${PJ//$'\n'/ }$us${roles//$'\n'/ }"
    done
    if [[ "$hl" =~ \"events\":\{([^}]*)\} ]]; then
      obj="${BASH_REMATCH[1]}"
      PN[events]=ok
      pane_json_int "$obj" window; PN[hev_window]="$PJ"
      pane_json_int "$obj" oom_kills; PN[hev_oom]="${PJ:-0}"
      pane_json_int "$obj" cgroup_oom_kills; PN[hev_cgroup_oom]="${PJ:-0}"
      pane_json_int "$obj" disk_full; PN[hev_disk_full]="${PJ:-0}"
      pane_json "$obj" last_oom_process; PN[hev_oom_proc]="$PJ"
      pane_json "$obj" last_disk_full_source; PN[hev_df_src]="$PJ"
    fi
  fi
  [ -n "$sl" ] || return 0
  pane_json "$sl" name; PN[name]="$PJ"
  pane_json "$sl" unit; PN[unit]="$PJ"
  pane_json "$sl" profile; PN[profile]="$PJ"
  pane_json "$sl" enabled; PN[enabled]="$PJ"
  pane_json "$sl" active; PN[active]="$PJ"
  pane_json "$sl" sub; PN[sub]="$PJ"
  pane_json "$sl" result; PN[result]="$PJ"
  pane_json "$sl" last_restart_reason; PN[reason]="$PJ"
  pane_json "$sl" working_on_access; PN[access]="$PJ"
  pane_json_int "$sl" restarts; PN[restarts]="$PJ"
  pane_json_int "$sl" leaked_procs; PN[leaked]="$PJ"
  pane_json_int "$sl" memory_current; PN[mem_cur]="$PJ"
  pane_json_int "$sl" memory_peak; PN[mem_peak]="$PJ"
  pane_json_int "$sl" memory_high; PN[mem_high]="$PJ"
  pane_json_int "$sl" memory_max; PN[mem_max]="$PJ"
  json_line_get "$sl" since; pane_age "$JF"; PN[since_age]="$PANE_INT"
  if [[ "$sl" =~ \"memory_events\":\{([^}]*)\} ]]; then
    obj="${BASH_REMATCH[1]}"
    pane_json_int "$obj" high; PN[ev_high]="$PJ"
    pane_json_int "$obj" max; PN[ev_max]="$PJ"
    pane_json_int "$obj" oom_kill; PN[ev_oom]="$PJ"
  fi
  if [[ "$sl" =~ \"memory_pressure\":\{([^}]*)\} ]]; then
    obj="${BASH_REMATCH[1]}"
    json_line_get "$obj" full_avg10; [[ ! "$JF" =~ ^[0-9]{1,3}(\.[0-9]{1,4})?$ ]] || PN[p10]="$JF"
    json_line_get "$obj" full_avg60; [[ ! "$JF" =~ ^[0-9]{1,3}(\.[0-9]{1,4})?$ ]] || PN[p60]="$JF"
  fi
  [[ ! "$sl" =~ \"job\":(.*),\"idle_since\": ]] || job="${BASH_REMATCH[1]}"
  if [ "$job" = null ]; then
    json_line_get "$sl" idle_since
    if $JF_SET; then
      PN[job]=idle
      pane_age "$JF"; PN[idle_age]="$PANE_INT"
      pane_json_int "$sl" jobs_completed; PN[jobs_done]="$PJ"
    fi
    return 0
  fi
  PN[job]=running
  pane_json "$job" repo; PN[job_repo]="$PJ"
  pane_json "$job" name; PN[job_name]="$PJ"
  [ -n "$PJ" ] || PN[job]=starting
  json_line_get "$job" since; pane_age "$JF"; PN[job_age]="$PANE_INT"
  json_line_get "$job" stalled; PN[job_stalled]="$JF"
  pane_json "$job" workflow; PN[job_workflow]="$PJ"
  pane_json_int "$job" run_id; PN[job_run_id]="$PJ"
  pane_json_int "$job" run_attempt; PN[job_run_attempt]="$PJ"
  pane_json_int "$job" run_number; PN[job_run_number]="$PJ"
  pane_json "$job" ref; PN[job_ref]="$PJ"
  pane_json "$job" sha; PN[job_sha]="$PJ"
  pane_json "$job" actor; PN[job_actor]="$PJ"
  pane_json "$job" event; PN[job_event]="$PJ"
  pane_json "$job" url; PN[job_url]="$PJ"
}

# The selected slot's facts, fresh from its host, into FF. 1 with FW_NOTICE
# set when there is nothing to decide on: the host did not answer, or the slot
# is no longer there. A remote runs in a subshell of its own here, as it would
# in reality, so nothing it sets can reach this process.
#
# On the watch's budget (GHR-74), like every read the watch makes: the key is
# held for as long as this takes, and a row kept from a host that has stopped
# answering is exactly where it will be pressed.
fleet_watch_facts() { # HOST NAME
  local rc=0 line job
  FF=()
  (FLEET_CALL_TIMEOUT="$FLEET_WATCH_TIMEOUT" ssh_run "$1" "$FLEET_RUNNERCTL" status --json) >"$FW_TMP/facts" 2>"$FW_TMP/err" || rc=$?
  relay_file "$FW_TMP/err"
  if [ "$rc" != 0 ]; then
    FW_NOTICE="$2 on $1: could not read its current state — $(fleet_error_text "$rc" "$FW_TMP/err" "$FLEET_WATCH_TIMEOUT")"
    return 1
  fi
  # `,"name":"X","active":` is the slot's own name: a job's name is followed
  # by "since", so a job called the same as a runner cannot match here.
  line="$(grep -F -m1 ",\"name\":$(json_str "$2"),\"active\":" "$FW_TMP/facts" || true)"
  if [ -z "$line" ]; then
    FW_NOTICE="$2 on $1: no longer on that host — nothing run"
    return 1
  fi
  # GHR-101: the two words the confirm lines quote as the host sent them
  # (`stuck stopping (deactivating/stop-sigterm)`, `not active (failed)`).
  # json_line_field does not decode, so an escape is text already; a raw
  # control byte in a hostile payload is not, and goes whole here.
  relay_safe "$(json_line_field "$line" active)" plain; FF[active]="$RELAY_SAFE"
  relay_safe "$(json_line_field "$line" sub)" plain; FF[sub]="$RELAY_SAFE"
  FF[access]="$(json_line_field "$line" working_on_access)"
  FF[leaked]="$(json_line_field "$line" leaked_procs)"
  FF[job]="" FF[job_cell]=""
  job=null
  [[ ! "$line" =~ \"job\":(.*),\"idle_since\": ]] || job="${BASH_REMATCH[1]}"
  if [ "$job" != null ]; then
    local repo name since stalled
    repo="$(json_line_field "$job" repo)"; name="$(json_line_field "$job" name)"
    since="$(json_line_field "$job" since)"; stalled="$(json_line_field "$job" stalled)"
    FF[job]=yes
    if [ -z "$name" ]; then
      FF[job_cell]="(starting)"
    else
      FF[job_cell]="${repo:+$repo:}$name"
      # GHR-104: `since` is the host's number; one that is no number
      # arithmetic can take (`08`) leaves the runtime out, as a missing one does.
      pane_age "$since"
      [ -z "$PANE_INT" ] || FF[job_cell]+=" ($(fmt_dur "$PANE_INT"))"
      [ "$stalled" != true ] || FF[job_cell]+=" STALLED"
    fi
    # GHR-78: text a job supplied, about to be drawn in a confirm line here.
    # json_str on the host already escaped every control character; what it
    # passes through verbatim (a bidi override) is taken out on this side.
    # GHR-108: whole sequences removed, as the table's WORKING-ON cell does.
    relay_safe "${FF[job_cell]}" plain; FF[job_cell]="$RELAY_SAFE"
  fi
}

# GHR-78: what O prints for NAME on HOST — the run's URL, or why there is
# none — from the `status --json` payload the last tick ALREADY brought
# (FW_STATE), not from a fresh read like the action keys make. Two reasons:
# the URL wanted is the one of the job the row on screen shows, and that
# payload is the tick the row came from, where a read at the keypress can
# answer for the job that started since; and printing a line is not worth
# holding the key for a round trip to a host that may be slow — the frame of a
# host that stopped answering keeps its rows, and its last payload with them.
#
# The URL crossed a hop, so it is checked again here (run_url_ok) before it is
# printed: this node does not print a string as a link on another host's word.
fleet_watch_run_url() { # HOST NAME
  local i at="" line job=null
  for i in "${!FLEET_HOSTS[@]}"; do
    if [ "${FLEET_HOSTS[$i]}" = "$1" ]; then at="$i"; break; fi
  done
  if [ -z "$at" ] || [ ! -s "$FW_STATE/$at.json" ]; then
    echo "no facts from that host yet — its 'status --json' has not answered"
    return 0
  fi
  line="$(grep -F -m1 ",\"name\":$(json_str "$2"),\"active\":" "$FW_STATE/$at.json" || true)"
  if [ -z "$line" ]; then echo "not in that host's last answer — no run URL to print"; return 0; fi
  [[ ! "$line" =~ \"job\":(.*),\"idle_since\": ]] || job="${BASH_REMATCH[1]}"
  if [ "$job" = null ]; then
    json_line_get "$line" working_on_access
    if [ "$JF" = no-access ]; then run_url_notice no-access ""; else run_url_notice idle ""; fi
    return 0
  fi
  if [[ "$job" != *'"url":'* ]]; then
    echo "a job is running, but that host's runnerctl does not report run URLs — 'runnerctl fleet upgrade' brings it up to date"
    return 0
  fi
  json_line_get "$job" url
  if ! $JF_SET; then run_url_notice running ""; return 0; fi
  if run_url_ok "$JF"; then
    printf '%s\n' "$JF"
  else
    echo "that host reported a run URL this node will not print — it is not a run page's address"
  fi
}

# The `warning:` line R and S carry when the host says a job is in flight.
fleet_watch_job_warning() { # VERB
  [ -n "${FF[job]}" ] || return 0
  printf '\nwarning: a job is running (%s) — y kills it and GitHub marks it failed; w waits for it instead' "${FF[job_cell]}"
}

# GHR-126: the line R and S carry under their confirm line for the second
# answer: `w` runs the same verb with --when-idle, which waits for the slot's
# job (up to WAIT_TIMEOUT) instead of killing it. It runs in the background
# like any action, so the wait does not freeze the view.
fleet_watch_idle_line() { # RUNS VERB NAME
  printf '\nw instead %s %s %s --when-idle — waits for the job to finish; anything else cancels' "$1" "$2" "$3"
}

# S's capacity floor (see the block above). 0 with FW_CAPACITY describing what
# the stop leaves; 1 with FW_NOTICE when it would cross --min-available.
#
# GHR-74: the count is this fan-out's own — every watched host re-read at the
# key, on the watch's budget (FLEET_BUDGETS, set for the session) — and never
# the frame's. A host whose rows are only being KEPT on screen does not answer
# here either, so it counts as nothing available however many slots the frame
# still shows for it. The fan-out leaves the session's EXIT trap alone
# (FLEET_EXIT_OWNED) and waits for its own children only.
FW_CAPACITY=""
fleet_watch_floor() { # HOST NAME ACTIVE-STATE
  fleet_watch_floor_set "$2 on $1: not stopped" "run 'runnerctl stop $2' on $1" "$3"
}
# GHR-127: the same floor for a SET of slots taken out together — a host key
# (D, X) removes every slot of its host at once. Each ACTIVE-STATE that is
# `active` is one slot of capacity gone, and they are subtracted TOGETHER:
# checked one at a time, each slot of a host can pass the floor on its own
# while all of them taken at once cross it. 0 with FW_CAPACITY; 1 with
# FW_NOTICE (`WHAT — it would leave …; restart --min-available lower …, or
# REMEDY`) when the set would cross --min-available.
fleet_watch_floor_set() { # WHAT REMEDY ACTIVE-STATE...
  local slots total avail after s removed=0 note="" what="$1" remedy="$2"
  shift 2
  for s in "$@"; do [ "$s" != active ] || removed=$((removed + 1)); done
  fleet_slots >"$FW_TMP/slots"
  slots="$(cat "$FW_TMP/slots")"
  total="$(printf '%s\n' "$slots" | grep -c . || true)"
  avail="$(fleet_count_available "$slots")"
  after=$((avail - removed))
  [ "$after" -ge 0 ] || after=0
  [ "$FLEET_SLOTS_SKIPPED" -eq 0 ] || note=", $FLEET_SLOTS_SKIPPED host(s) not answering and not counted"
  if [ "$after" -lt "$FLEET_WATCH_MIN_AVAILABLE" ]; then
    FW_NOTICE="$what — it would leave $after of $total slot(s) active across the watched hosts$note, under --min-available $FLEET_WATCH_MIN_AVAILABLE; restart --min-available lower (0 turns the floor off), or $remedy"
    return 1
  fi
  FW_CAPACITY="leaves $after of $total slot(s) active across the watched hosts$note"
}

# A key on the selected row: FW_NOTICE (a refusal, nothing runs) or FW_PROMPT +
# FW_ACTION (a confirm line naming the exact remote command, run on `y`). L
# runs at once — reading logs changes nothing.
fleet_watch_key_action() { # KEY
  local host="$FW_HOST" name="$FW_NAME"
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_HOST="$host" FW_ACT_NAME="$name"
  if [ "$FW_POS" -lt 0 ]; then FW_NOTICE="no slot to act on"; return 0; fi
  # What the cursor is ON, not the slot it remembers: a host that is not
  # answering has no slot on the screen to act on — and neither has a folded
  # one (GHR-75), whose line stands for all of its slots at once.
  if [ "${FW_KIND[$FW_POS]:-}" = host ]; then
    FW_NOTICE="$host: folded to one line — c or Enter opens it, then pick a slot"
    return 0
  fi
  if [ -z "${FW_ROWS[$FW_POS]#*$'\t'}" ]; then
    FW_NOTICE="$host: not answering — no slot there to act on"
    return 0
  fi
  fleet_watch_slot_action "$1" "$host" "$name"
}
# The key itself, on slot NAME of HOST — the pair, not a row: the detail pane
# (GHR-76) acts on the slot it is showing, which a view may have filtered out
# of the rows since it was opened.
fleet_watch_slot_action() { # KEY HOST NAME
  local host="$2" name="$3" lbl rc=0 runs
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_HOST="$host" FW_ACT_NAME="$name" FW_ACT_SCOPE=slot
  lbl="$name on $host"
  fleet_priv_cmd
  if [ "$1" = L ]; then
    (ssh_run "$host" "${FLEET_PRIV[@]}" logs "$(printf %q "$name")" -n 50) >"$FW_TMP/logs" 2>"$FW_TMP/err" || rc=$?
    # GHR-101: a journal line is whatever a job printed, and the pager may be
    # `less -R` (or LESS=-R), which passes control bytes through: the lines
    # are relayed like a table's, SGR kept for a pager that draws it.
    relay_file "$FW_TMP/logs"
    relay_file "$FW_TMP/err"
    if [ "$rc" != 0 ]; then
      FW_NOTICE="$lbl: logs — $(fleet_error_text "$rc" "$FW_TMP/err")"
      return 0
    fi
    # The pager owns the screen until it quits; the next frame repaints.
    term_cursor show
    page <"$FW_TMP/logs"
    term_cursor hide
    return 0
  fi
  if [ "$1" = O ]; then
    FW_NOTICE="$lbl: $(fleet_watch_run_url "$host" "$name")"
    return 0
  fi
  # GHR-125: one action per host. Refused before the facts read, so a key on
  # a busy host issues nothing at all.
  ! fleet_watch_act_refuse "$host" || return 0
  fleet_watch_facts "$host" "$name" || return 0
  runs="runs on $host: ${FLEET_PRIV[*]}"
  case "$1" in
    K)
      if [ "${FF[active]}" = deactivating ]; then
        FW_ACTION="kill"
        FW_PROMPT="$lbl is stuck stopping (${FF[active]}/${FF[sub]:-?}) — SIGKILL the whole unit? $runs kill $name  [y/n]"
      elif [ -n "${FF[job]}" ]; then
        FW_ACTION="kill"
        FW_PROMPT="Kill the job on $lbl (${FF[job_cell]})? $runs kill $name — the job's processes; the runner stays up and reports it failed  [y/n]"
      elif [ "${FF[access]}" = no-access ]; then
        FW_NOTICE="$lbl: cannot tell whether a job is running — the ssh login needs journal read access (systemd-journal group) or root there"
      else
        case "${FF[active]}" in
          active|activating|reloading) FW_NOTICE="$lbl: no job running — nothing to kill" ;;
          *) FW_NOTICE="$lbl: not running — nothing to kill" ;;
        esac
      fi ;;
    R)
      case "${FF[active]}" in
        active|activating|reloading)
          FW_ACTION=restart
          FW_PROMPT="Restart $lbl? $runs restart $name  [y/n]$(fleet_watch_job_warning restart)$(fleet_watch_idle_line "$runs" restart "$name")" ;;
        *) FW_NOTICE="$lbl: not active (${FF[active]:-unknown}) — T starts it" ;;
      esac ;;
    S)
      case "${FF[active]}" in
        active|activating|reloading)
          fleet_watch_floor "$host" "$name" "${FF[active]}" || return 0
          FW_ACTION=stop
          FW_PROMPT="Stop $lbl? $runs stop $name — $FW_CAPACITY  [y/n]$(fleet_watch_job_warning stop)$(fleet_watch_idle_line "$runs" stop "$name")" ;;
        *) FW_NOTICE="$lbl: already stopped (${FF[active]:-unknown})" ;;
      esac ;;
    T)
      case "${FF[active]}" in
        active|activating|reloading) FW_NOTICE="$lbl: already active — R restarts it" ;;
        *) FW_ACTION=start
           FW_PROMPT="Start $lbl? $runs start $name  [y/n]" ;;
      esac ;;
    P)
      if [[ "${FF[leaked]}" =~ ^[0-9]+$ ]] && [ "${FF[leaked]}" -gt 0 ]; then
        FW_ACTION=reap
        FW_PROMPT="Reap ${FF[leaked]} leaked process(es) on $lbl? $runs reap $name — TERM, then KILL what is still alive after the grace  [y/n]"
      elif [ -n "${FF[job]}" ]; then
        FW_NOTICE="$lbl: busy (${FF[job_cell]}) — a running job's processes are not leaks"
      else
        FW_NOTICE="$lbl: no leaked processes shown — nothing to reap"
      fi ;;
  esac
}

# The confirmed action, over the held connection — in the background since
# GHR-125 (see the block below). The slot name was read off the host's own
# frame, and ssh hands its argv to the remote shell as one string: %q keeps a
# systemd-escaped name (`\x2d`) or anything else odd a single argument there. A
# plain name is unchanged.
#
# GHR-81: on the mutating budget, not FLEET_TIMEOUT or FLEET_WATCH_TIMEOUT: a
# restart that sits out a wedged job's TimeoutStopSec is minutes, and giving
# up sooner only made the frame say `failed` about an action that then
# completed behind it.
#
# GHR-126: WHEN-IDLE (`w` at the confirm line of R and S) is --when-idle,
# carried through as a remote argument, and the budget is the one that
# argument earns: a wait of up to WAIT_TIMEOUT for the slot plus the action's.
# S's capacity floor was passed when the confirm line was built, for either
# answer. R takes none for either: the slot comes back.
fleet_watch_run_action() { # [--when-idle]
  local budget
  budget="$(fleet_mutate_budget "$FW_ACTION" 1 "$@")"
  fleet_priv_cmd
  printf '\nrunning on %s: %s %s %s%s\n' "$FW_ACT_HOST" "${FLEET_PRIV[*]}" "$FW_ACTION" "$FW_ACT_NAME" "${1:+ $1}"
  # GHR-88: recorded on this node as the command line the key stands for.
  fleet_watch_act_start "$FW_ACT_HOST" "$FW_ACT_NAME on $FW_ACT_HOST" "$FW_ACTION" \
    "fleet $FW_ACTION${1:+ $1} --host $FW_ACT_HOST $FW_ACT_NAME (fleet watch)" "$budget" \
    "$FW_ACTION" "$(printf %q "$FW_ACT_NAME")" "$@" || true
  FW_ACTION="" FW_PROMPT=""
}

# --- Fleet watch: host keys (GHR-127) -------------------------------------------
# D W E X act on the HOST of the row the cursor is on — any of its slot rows,
# its folded line (GHR-75), its error row — and on every slot it has:
#
#   D  drain                ONE call, `drain NAME...`: each slot stopped once
#                           its job is done, one slot at a time
#   W  restart --when-idle  ONE call, `restart --when-idle NAME...`: rolling,
#                           each slot restarted once its job is done
#   E  enable               `enable NAME`, one call per slot, in turn
#   X  disable              `disable NAME`, one call per slot, in turn
#
# E and X are a call per slot because a host's `enable` / `disable` takes ONE
# target and has always ignored any after it: a list handed to a host would
# enable its first slot and say `done`. D and W name the slots too, rather than
# leaning on `drain`'s "no target is every slot": the confirm line then names
# exactly what runs, and a slot the host gains after the keypress is not
# touched by a command nobody read. The calls of E and X run in turn in ONE
# background action, which stops at the first that fails.
#
# The contract is the slot keys': the host's slots are read fresh at the
# keypress (its `status --json`), the confirm line names the exact remote
# command and the slots it touches, `y` runs it and anything else cancels —
# `w` included, which means something only at R and S. One action per host
# (GHR-125), in the background, labelled with the host, on the mutating budget
# its command earns (a drain or a rolling restart waits up to WAIT_TIMEOUT per
# slot), with FLEET_SUDO and --origin as for the slot keys.
#
# THE FLOOR. D and X take a whole host's capacity away, so the floor is checked
# for the host's active slots AS A SET (fleet_watch_floor_set): each slot of a
# host can pass it alone while all of them together cross it. W takes none, as
# R takes none — a rolling restart puts each slot back before it takes the
# next; E gives capacity back.
#
# Where the cursor is. A host line (Disk/OOM, version) stays a line the cursor
# passes over (FLEET_INFO_RE): it belongs to the host, and so does every row
# under it, from any of which the host keys act on that host. A host that is
# not answering has only its error row; a host key there is refused in words
# of its own (there are no facts to decide on), and a slot key there still
# says there is no slot.
FW_ACT_SCOPE=slot FW_ACT_SLOTS=() FW_ACT_EACH=()
HF_NAMES=() HF_ACTIVE=() HF_JOBS=()
# A slot name a host key puts on a command line and in a confirm line: a unit's
# short name, systemd's `\x2d` escapes included. Anything else is refused.
FW_HOST_SLOT_RE='^[-A-Za-z0-9_.@:\]+$'

# HOST's slots, fresh from the host, into HF_NAMES / HF_ACTIVE / HF_JOBS (the
# job a busy slot is running, made safe; empty for an idle one). 1 with
# FW_NOTICE when the host did not answer, or named a slot as no runner is named.
# On the watch's budget, as fleet_watch_facts reads one slot.
fleet_watch_host_facts() { # HOST
  local rc=0 line name job
  HF_NAMES=() HF_ACTIVE=() HF_JOBS=()
  (FLEET_CALL_TIMEOUT="$FLEET_WATCH_TIMEOUT" ssh_run "$1" "$FLEET_RUNNERCTL" status --json) >"$FW_TMP/facts" 2>"$FW_TMP/err" || rc=$?
  relay_file "$FW_TMP/err"
  if [ "$rc" != 0 ]; then
    FW_NOTICE="$1: could not read its current state — $(fleet_error_text "$rc" "$FW_TMP/err" "$FLEET_WATCH_TIMEOUT")"
    return 1
  fi
  while IFS= read -r line; do
    [[ "$line" == '  {"idx":'* ]] || continue
    fleet_slot_classify "$line"
    json_unescape "$SC_NAME"; name="$JSON_TEXT"
    if [[ ! "$name" =~ $FW_HOST_SLOT_RE ]]; then
      FW_NOTICE="$1: a slot there is not named as a runner is — nothing issued; act on its slots one at a time"
      return 1
    fi
    job=null
    [[ ! "$line" =~ \"job\":(.*),\"idle_since\": ]] || job="${BASH_REMATCH[1]}"
    json_line_get "$line" active
    relay_safe "$JF" plain
    HF_NAMES+=("$name") HF_ACTIVE+=("$RELAY_SAFE")
    if [ "$job" = null ]; then
      HF_JOBS+=("")
    else
      json_unescape "$SC_JOB"; relay_safe "${JSON_TEXT:-(starting)}" plain
      HF_JOBS+=("$RELAY_SAFE")
    fi
  done <"$FW_TMP/facts"
}

# D W E X on the cursor's host: FW_NOTICE (a refusal, nothing runs) or
# FW_PROMPT + FW_ACTION with FW_ACT_SCOPE=host and the slots in FW_ACT_SLOTS.
fleet_watch_host_key() { # D|W|E|X
  local host="$FW_HOST" verb i names="" each="" busy=""
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_HOST="$host" FW_ACT_NAME="" FW_ACT_SCOPE=host FW_ACT_SLOTS=()
  if [ "$FW_POS" -lt 0 ]; then FW_NOTICE="no host to act on"; return 0; fi
  case "$1" in D) verb=drain ;; W) verb=restart ;; E) verb=enable ;; *) verb=disable ;; esac
  # The error row of a host that is not answering (a folded line is the
  # host's own, and acts).
  if [ "${FW_KIND[$FW_POS]:-}" != host ] && [ -z "${FW_ROWS[$FW_POS]#*$'\t'}" ]; then
    FW_NOTICE="$host: not answering — $1 decides on what the host says, and it says nothing; nothing issued"
    return 0
  fi
  ! fleet_watch_act_refuse "$host" || return 0
  fleet_watch_host_facts "$host" || return 0
  if [ "${#HF_NAMES[@]}" -eq 0 ]; then
    FW_NOTICE="$host: no slots there — nothing to $verb"
    return 0
  fi
  fleet_priv_cmd
  for i in "${!HF_NAMES[@]}"; do
    names+="${names:+ }${HF_NAMES[$i]}"
    each+="${each:+; }${FLEET_PRIV[*]} $verb ${HF_NAMES[$i]}"
    [ -z "${HF_JOBS[$i]}" ] || busy+="${busy:+, }${HF_NAMES[$i]} (${HF_JOBS[$i]})"
  done
  case "$1" in
    D)
      fleet_watch_floor_set "$host: not drained" "run 'runnerctl drain' on $host" "${HF_ACTIVE[@]}" || return 0
      FW_PROMPT="Drain $host? runs on $host: ${FLEET_PRIV[*]} drain $names — each slot stopped once its job is done, one at a time; $FW_CAPACITY  [y/n]" ;;
    W)
      FW_PROMPT="Restart $host when idle? runs on $host: ${FLEET_PRIV[*]} restart --when-idle $names — each slot restarted once its job is done, one at a time  [y/n]" ;;
    E)
      FW_PROMPT="Enable $host's slots? runs on $host, one call per slot: $each  [y/n]" ;;
    X)
      fleet_watch_floor_set "$host: not disabled" "disable its slots one at a time with 'runnerctl disable' on $host" "${HF_ACTIVE[@]}" || return 0
      FW_PROMPT="Disable $host's slots? runs on $host, one call per slot: $each — $FW_CAPACITY  [y/n]"
      [ -z "$busy" ] || FW_PROMPT+=$'\n'"warning: a job is running ($busy) — disable stops its slot now and GitHub marks the job failed; D drains instead" ;;
  esac
  FW_ACTION="$verb" FW_ACT_SLOTS=("${HF_NAMES[@]}")
}

# The confirmed host key, in the background (GHR-125) with the host as its
# label. E and X hand the job their slots in FW_ACT_EACH: one call each.
fleet_watch_run_host_action() {
  local budget n="${#FW_ACT_SLOTS[@]}" verb="$FW_ACTION" host="$FW_ACT_HOST" s shown="" flag=""
  local -a q=() args=()
  for s in "${FW_ACT_SLOTS[@]}"; do q+=("$(printf %q "$s")"); done
  fleet_priv_cmd
  case "$verb" in
    drain)
      budget="$(fleet_mutate_budget drain "$n")"
      args=(drain "${q[@]}")
      shown="${FLEET_PRIV[*]} drain ${FW_ACT_SLOTS[*]}" ;;
    restart)
      flag=" --when-idle"
      budget="$(fleet_mutate_budget restart "$n" --when-idle)"
      args=(restart --when-idle "${q[@]}")
      shown="${FLEET_PRIV[*]} restart --when-idle ${FW_ACT_SLOTS[*]}" ;;
    *)
      budget="$(fleet_mutate_budget "$verb" 1)"
      args=("$verb")
      FW_ACT_EACH=("${q[@]}")
      for s in "${FW_ACT_SLOTS[@]}"; do shown+="${shown:+; }${FLEET_PRIV[*]} $verb $s"; done ;;
  esac
  printf '\nrunning on %s: %s\n' "$host" "$shown"
  # GHR-88: recorded on this node as the command line the key stands for.
  fleet_watch_act_start "$host" "$host" "$verb" \
    "fleet $verb$flag --host $host ${FW_ACT_SLOTS[*]} (fleet watch)" "$budget" "${args[@]}" || true
  FW_ACT_EACH=() FW_ACT_SLOTS=() FW_ACTION="" FW_PROMPT="" FW_ACT_SCOPE=slot
}

# --- Fleet watch: C pages the cursor's host's compose-reap dry run (GHR-87) ----
# The host line's Disk fragment says a docker filesystem is full; C answers
# what holds it: that host's `compose-reap` dry run, in the pager, as L pages a
# slot's journal. A READ — as the plain login, never FLEET_SUDO, no --origin,
# no confirm — on FLEET_TIMEOUT, the budget a one-shot `fleet compose-reap`
# gives it. On the HOST of whatever row the cursor is on, a folded line or a
# host that is not answering included: compose-reap asks the daemon, not the
# table, so the host is simply asked. A host without docker, and any failure,
# is the notice.
fleet_watch_compose_key() {
  local host="$FW_HOST" rc=0
  FW_NOTICE="" FW_PROMPT="" FW_ACTION=""
  if [ "$FW_POS" -lt 0 ] || [ -z "$host" ]; then FW_NOTICE="no host to look at"; return 0; fi
  (FLEET_CALL_TIMEOUT="$FLEET_TIMEOUT" ssh_run "$host" "$FLEET_RUNNERCTL" compose-reap) >"$FW_TMP/compose" 2>"$FW_TMP/err" || rc=$?
  relay_file "$FW_TMP/compose"
  relay_file "$FW_TMP/err"
  if [ "$rc" != 0 ]; then
    if fleet_no_docker "$FW_TMP/err"; then
      FW_NOTICE="$host: $FLEET_NO_DOCKER_ROW"
    else
      FW_NOTICE="$host: compose-reap — $(fleet_error_text "$rc" "$FW_TMP/err")"
    fi
    return 0
  fi
  term_cursor show
  { printf "compose-reap on %s — a dry run, nothing removed ('runnerctl fleet compose-reap --apply --host %s' reaps)\n\n" "$host" "$host"
    cat "$FW_TMP/compose"; } | page
  term_cursor hide
}

# --- Fleet watch: H shows the recent records (GHR-118) --------------------------
# H replaces the table with `history -n FW_HIST_LINES` of the cursor's host
# (GHR-88's records: what changed on it, by whom); H again, in the pane, shows
# the whole fleet merged by time as `fleet history` does, and once more goes
# back to the one host. q, Esc and Enter go back to the table.
#   * A READ, in the background as a tick's fetch is (GHR-74): a job of its own
#     over the host's held connection, as the plain login on FLEET_WATCH_TIMEOUT
#     — never FLEET_SUDO, no --origin, no confirm. The watch goes on around it,
#     and the pane says it is reading until the job lands. One job at a time:
#     H, q and a quit end the one out, and its directory goes with it.
#   * Drawn as the detail pane is: through pane_line (relay_safe's plain form),
#     windowed by viewport_draw, scrolled by pane_scroll. The records were
#     relayed where they landed and the merge lines are made plain again.
#   * What the pane says besides the records is each host's own words, under
#     them: a host from before `history` predates it (fleet_history_failure,
#     as `fleet history` says it), a failure is fleet_error_text's, and a
#     login outside systemd-journal/adm — whose `history` answers on stderr —
#     has that note drawn, so an empty list is never "nothing happened".
FW_HIST_LINES=50 FW_HIST_SCOPE="" FW_HIST_HOST="" FW_HIST_PID="" FW_HIST_DIR="" FW_HIST_SEQ=0
FW_HIST_LEGEND_HOST="q/Esc/Enter back  H whole fleet  jk scroll  PgUp PgDn g G  Ctrl-C quits"
FW_HIST_LEGEND_FLEET="q/Esc/Enter back  H this host  jk scroll  PgUp PgDn g G  Ctrl-C quits"

fleet_watch_hist_out() { [ -n "$FW_HIST_PID" ]; }

# One host's call into DIR/K.{out,err,rc}.
fleet_watch_hist_one() { # DIR K HOST N
  local rc=0
  # GHR-162: INT and QUIT inherited, deliberately: only ever a job of
  # fleet_watch_hist_job, which ignores both, and an ignore a parent set is
  # passed to its jobs on every bash (tests/run.sh pins the job through this).
  (FLEET_CALL_TIMEOUT="$FLEET_WATCH_TIMEOUT" ssh_run "$3" "$FLEET_RUNNERCTL" history -n "$4") >"$1/$2.out" 2>"$1/$2.err" || rc=$?
  relay_file "$1/$2.out"
  relay_file "$1/$2.err"
  echo "$rc" >"$1/$2.rc"
}

# The job: the host's call, or every host's at most FLEET_PARALLEL at a time,
# then DIR/rec (the merged records, the last N), DIR/notes (a line per host
# that has something to say) and DIR/rc LAST, so the loop never takes half.
fleet_watch_hist_job() { # DIR SCOPE HOST N
  local d="$1" n="$4" k rc line running=0
  local -a hs=() pids=()
  # GHR-162: a worker — fleet_watch_hist_stop ends it with its tree.
  builtin trap '' INT QUIT
  if [ "$2" = host ]; then hs=("$3"); else hs=("${FLEET_HOSTS[@]}"); fi
  for k in "${!hs[@]}"; do
    fleet_watch_hist_one "$d" "$k" "${hs[$k]}" "$n" &
    pids+=("$!")
    running=$((running + 1))
    if [ "$running" -ge "$FLEET_PARALLEL" ]; then
      wait -n 2>/dev/null || true
      running=$((running - 1))
    fi
  done
  wait "${pids[@]}" 2>/dev/null || true
  : >"$d/raw"
  : >"$d/notes"
  for k in "${!hs[@]}"; do
    rc="$(cat "$d/$k.rc" 2>/dev/null || echo 255)"
    if [ "$rc" = 0 ]; then
      fleet_history_lines "${hs[$k]}" "$d/$k.out" >>"$d/raw"
      while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] || printf '%s: %s\n' "${hs[$k]}" "$line" >>"$d/notes"
      done <"$d/$k.err"
    else
      printf '%s: %s\n' "${hs[$k]}" "$(fleet_history_failure "$rc" "$d/$k.err" "$FLEET_WATCH_TIMEOUT")" >>"$d/notes"
    fi
  done
  LC_ALL=C sort -s -k1,1 "$d/raw" | tail -n "$n" >"$d/rec"
  echo 0 >"$d/rc.new"
  mv -f "$d/rc.new" "$d/rc"
}

# Start the read for SCOPE (host|fleet), the one before it ended.
fleet_watch_hist_start() { # SCOPE
  fleet_watch_hist_stop
  FW_HIST_SCOPE="$1"
  FW_HIST_SEQ=$((FW_HIST_SEQ + 1))
  FW_HIST_DIR="$FW_TMP/hist.$FW_HIST_SEQ"
  mkdir "$FW_HIST_DIR"
  fleet_watch_hist_job "$FW_HIST_DIR" "$FW_HIST_SCOPE" "$FW_HIST_HOST" "$FW_HIST_LINES" </dev/null >/dev/null 2>&1 &
  FW_HIST_PID="$!"
  # The loop's first look at it is one FW_POLL on, as for a round's fetches.
  FW_ACT_LAUNCHED=true
}

# End the read in flight, with what it started, and drop its directory. Only a
# pid this process started and still has as a child (as fleet_watch_reap).
fleet_watch_hist_stop() {
  local pid="$FW_HIST_PID"
  FW_HIST_PID=""
  if [[ "$pid" == [0-9]* ]] && [ "$(proc_ppid "$pid")" = "$$" ]; then proc_tree_kill "$pid"; fi
  [ -z "$FW_HIST_DIR" ] || rm -rf "$FW_HIST_DIR"
  FW_HIST_DIR=""
}

# 0 when the read has just landed (the pane wants a draw). A job that is gone
# without having published is an answer too, as for a fetch.
fleet_watch_hist_collect() {
  fleet_watch_hist_out || return 1
  if [ ! -e "$FW_HIST_DIR/rc" ]; then
    ! kill -0 "$FW_HIST_PID" 2>/dev/null || return 1
    if [ ! -e "$FW_HIST_DIR/rc" ]; then
      : >"$FW_HIST_DIR/rec"
      echo "the call ended without an answer" >"$FW_HIST_DIR/notes"
      echo 255 >"$FW_HIST_DIR/rc"
    fi
  fi
  FW_HIST_PID=""
  return 0
}

# The pane into PANE_OUT: the title, then the records or that the read is out,
# then each host's own words.
fleet_watch_hist_build() {
  local line what="$FW_HIST_HOST" any=false
  PANE_OUT=""
  [ "$FW_HIST_SCOPE" = host ] || what="the whole fleet, merged by time"
  pane_head "history — $what — the last $FW_HIST_LINES runnerctl records"
  PANE_OUT+=$'\n'
  if fleet_watch_hist_out; then
    pane_line "reading the journal over ssh (FLEET_WATCH_TIMEOUT ${FLEET_WATCH_TIMEOUT}s) ..." "$C_DIM"
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    pane_line "$line"
    any=true
  done <"$FW_HIST_DIR/rec"
  $any || pane_line "no records came back — see below" "$C_DIM"
  if [ -s "$FW_HIST_DIR/notes" ]; then
    PANE_OUT+=$'\n'
    while IFS= read -r line || [ -n "$line" ]; do pane_line "$line" "$C_YELLOW"; done <"$FW_HIST_DIR/notes"
  fi
}

# H, on the row the cursor is on: that row's host, a folded line or a host that
# is not answering included — the journal is asked, not the table.
fleet_watch_hist_open() {
  FW_NOTICE="" FW_PROMPT="" FW_ACTION=""
  if [ "$FW_POS" -lt 0 ] || [ -z "$FW_HOST" ]; then FW_NOTICE="no host to look at"; return 0; fi
  FW_HIST_HOST="$FW_HOST" FW_MODE=history
  pane_enter
  fleet_watch_hist_start host
}
fleet_watch_hist_close() {
  fleet_watch_hist_stop
  FW_MODE="" FW_HIST_SCOPE=""
  pane_leave
}
# A key while the history pane is up: back, the other scope, the window.
fleet_watch_hist_key() { # KEY
  case "$1" in
    esc|enter|q|Q) fleet_watch_hist_close ;;
    H)
      VIEW_TOP=0
      if [ "$FW_HIST_SCOPE" = host ]; then fleet_watch_hist_start fleet; else fleet_watch_hist_start host; fi ;;
    *) pane_scroll "$1" || true ;;
  esac
}

# --- Fleet watch: U upgrades the cursor's host (GHR-128) ------------------------
# U acts on the HOST of the row the cursor is on, like the host keys, and is the
# one key that asks the host a question before it builds a confirm line:
# `upgrade --check` (as the login, a read, on the budget `fleet upgrade --check`
# gives it — it downloads), parsed with the helpers `fleet upgrade` classifies
# with. Only a host that says `Update available.` with two versions that are
# X.Y.Z gets a confirm line; the line names the exact command and `FROM -> TO`.
# A current host, one ahead of its source, one that does not answer and one
# whose answer is not understood are each said so, and nothing is issued.
#
# `y` runs plain `upgrade` — not --push (GHR-83), which is a second design — as
# a background action (GHR-125) on the mutating budget, with FLEET_SUDO and the
# origin as for every key that changes a host. The action's job then reads the
# host's version back, as `fleet upgrade` does (GHR-82), and the notice says
# `upgraded` only when the read-back is the version the host said it wrote.
FW_UP_FROM="" FW_UP_TO="" FW_ACT_FROM=() FW_ACT_TO=()

fleet_watch_upgrade_key() {
  local host="$FW_HOST"
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_HOST="$host" FW_ACT_NAME="" FW_ACT_SLOTS=()
  if [ "$FW_POS" -lt 0 ]; then FW_NOTICE="no host to act on"; return 0; fi
  if [ "${FW_KIND[$FW_POS]:-}" != host ] && [ -z "${FW_ROWS[$FW_POS]#*$'\t'}" ]; then
    FW_NOTICE="$host: not answering — U decides on what the host says, and it says nothing; nothing issued"
    return 0
  fi
  ! fleet_watch_act_refuse "$host" || return 0
  # GHR-136: the check is a background read (it downloads the release on the
  # host), holding the host's one action slot; the confirm is raised when it
  # lands (fleet_watch_upgrade_landed), not here.
  fleet_watch_act_start "$host" "$host" upgrade-check "" "$(fleet_mutate_budget upgrade 1)" upgrade --check || true
}

# What an `upgrade --check` answered, whoever ran it: 0 with UPC_FROM / UPC_TO
# when an update is available with two X.Y.Z versions; 1 with UPC_NOTICE saying
# why not. Pure: it reads the two files and sets nothing the watch draws.
UPC_FROM="" UPC_TO="" UPC_NOTICE=""
fleet_watch_upgrade_parse() { # HOST RC UP-FILE ERR-FILE BUDGET
  local host="$1" rc="$2" up="$3" err="$4" budget="$5" cur avail
  UPC_FROM="" UPC_TO="" UPC_NOTICE=""
  if [ "$rc" != 0 ]; then
    UPC_NOTICE="$host: could not check for an upgrade — $(fleet_error_text "$rc" "$err" "$budget"); nothing issued"
    return 1
  fi
  cur="$(fleet_upgrade_field_of "$up" installed)"
  avail="$(fleet_upgrade_field_of "$up" available)"
  if grep -q '^Update available\.' "$up"; then
    if ! fleet_watch_version_ok "$cur" || ! fleet_watch_version_ok "$avail"; then
      UPC_NOTICE="$host: upgrade --check named a version that is not X.Y.Z — nothing issued"
      return 1
    fi
    UPC_FROM="$cur" UPC_TO="$avail"
    return 0
  elif grep -q '^Already up to date\.' "$up"; then
    fleet_ver "$cur"
    UPC_NOTICE="$host: already current ($FLEET_VER) — nothing to upgrade, nothing issued"
  elif grep -q 'not downgrading' "$up"; then
    fleet_ver "$cur"
    UPC_NOTICE="$host: runs $FLEET_VER, ahead of the source — left alone, nothing issued"
  else
    fleet_watch_act_last "$up" plain
    UPC_NOTICE="$host: upgrade --check answered something unrecognised (${ACT_LAST:-nothing}) — nothing issued"
  fi
  return 1
}

# The cursor's U check has landed (GHR-136), for the host at index I. Its slot
# is free again by now. The confirm line rises only if the cursor is still on
# the host that asked and nothing else is up (a confirm, a pane, the filter
# text); otherwise the result is a notice and nothing is asked or issued.
fleet_watch_upgrade_landed() { # INDEX RC DIR
  local i="$1" host="${FLEET_HOSTS[$1]}"
  # GHR-151: a check the marked-rows U started is one of that set's.
  if [ -n "${FW_UPS_WAIT[$host]:-}" ]; then
    fleet_watch_upset_landed "$i" "$2" "$3"
    return 0
  fi
  if ! fleet_watch_upgrade_parse "$host" "$2" "$3/out" "$3/err" "${FW_ACT_BUDGET[$i]}"; then
    fleet_watch_act_notice "$UPC_NOTICE"
    return 0
  fi
  if [ "$FW_HOST" != "$host" ] || [ -n "$FW_PROMPT" ] || [ -n "$FW_MODE" ]; then
    fleet_watch_act_notice "$host: upgrade available ($UPC_FROM -> $UPC_TO) — the cursor moved on, so nothing is asked and nothing issued"
    return 0
  fi
  FW_UP_FROM="$UPC_FROM" FW_UP_TO="$UPC_TO"
  FW_NOTICE="" FW_ACT_HOST="$host" FW_ACT_NAME="" FW_ACT_SLOTS=()
  fleet_priv_cmd
  FW_ACTION=upgrade FW_ACT_SCOPE=upgrade
  FW_PROMPT="$host: upgrade $FW_UP_FROM -> $FW_UP_TO? runs on $host: ${FLEET_PRIV[*]} upgrade — the host downloads the release and replaces its runnerctl, then its version is read back  [y/n]"
}

# Whether TEXT is a version this watch may draw: X.Y.Z, and short.
fleet_watch_version_ok() { # TEXT
  [ "${#1}" -le 32 ] && valid_runner_version "$1"
}

# The confirmed U, in the background (GHR-125) with the host as its label. The
# versions the confirm line named ride along for the notice.
fleet_watch_run_upgrade() {
  local budget host="$FW_ACT_HOST"
  budget="$(fleet_mutate_budget upgrade 1)"
  fleet_priv_cmd
  printf '\nrunning on %s: %s upgrade\n' "$host" "${FLEET_PRIV[*]}"
  if fleet_host_index "$host"; then
    FW_ACT_FROM[FLEET_HOST_I]="$FW_UP_FROM" FW_ACT_TO[FLEET_HOST_I]="$FW_UP_TO"
  fi
  # GHR-88: recorded on this node as the command line the key stands for.
  fleet_watch_act_start "$host" "$host" upgrade "fleet upgrade --host $host (fleet watch)" "$budget" upgrade || true
  FW_ACTION="" FW_PROMPT="" FW_ACT_SCOPE=slot
}

# The notice of an upgrade that ended with rc 0, into UP_NOTICE (and UP_RC, the
# result its FLEET_LOG line records). `upgraded` is a claim this checks: the
# version the host's own `Upgraded A -> B` sentence says it wrote, against the
# one the read-back (the job's `version` call, GHR-82) answered.
UP_NOTICE="" UP_RC=0
fleet_watch_upgrade_notice() { # INDEX DIR
  local i="$1" d="$2" wrote got rb
  UP_NOTICE="" UP_RC=0
  wrote="$(fleet_upgrade_wrote "$d/out")"
  if [ -z "$wrote" ]; then
    fleet_watch_act_last "$d/out" plain
    UP_NOTICE="upgrade wrote nothing (${ACT_LAST:-no answer})"
    return 0
  fi
  if ! fleet_watch_version_ok "$wrote"; then
    UP_RC=unconfirmed
    UP_NOTICE="upgrade said it wrote a version that is not X.Y.Z, so it was not read back — not confirmed"
    return 0
  fi
  rb="$(cat "$d/rb.rc" 2>/dev/null || echo 255)"
  if [ "$rb" != 0 ]; then
    UP_RC=unconfirmed
    UP_NOTICE="upgrade wrote $wrote but the read-back did not answer: $(fleet_error_text "$rb" "$d/rb.err" "$FLEET_WATCH_TIMEOUT") — not confirmed"
    return 0
  fi
  got="$(fleet_version_answer "$d/rb.out")"
  if ! fleet_watch_version_ok "$got"; then
    fleet_watch_act_last "$d/rb.out" plain
    UP_RC=unconfirmed
    UP_NOTICE="upgrade wrote $wrote but the read-back answered '${ACT_LAST:-nothing}', not a version — not confirmed"
    return 0
  fi
  if [ "$got" = "$wrote" ]; then
    UP_NOTICE="upgraded ${FW_ACT_FROM[$i]:-?} -> $wrote, read back $got"
    [ "$wrote" = "${FW_ACT_TO[$i]:-}" ] || UP_NOTICE+=" (the confirm line named ${FW_ACT_TO[$i]:-?})"
  else
    UP_RC=unconfirmed
    UP_NOTICE="upgrade wrote $wrote but the read-back answers $got — not confirmed (the write landed where the fleet path does not run)"
  fi
}

# --- Fleet watch: an action in the background (GHR-125) -------------------------
# A confirmed action used to run in the foreground, and the frame froze until
# the remote returned — for a --when-idle restart or a drain, up to
# WAIT_TIMEOUT per slot. Now it is a job of its own over the host's held
# connection, as a tick's fetch is (GHR-74), and the watch goes on around it:
# the ticks keep coming, the cursor and the view keys keep working.
#
#   * ONE ACTION PER HOST. FW_ACT_PID is indexed like FLEET_HOSTS; an action
#     key on a host that has one out says so and issues nothing — not even its
#     facts read (fleet_watch_act_refuse). A key on another host starts that
#     host's own. A slot action, a host action and each host of a marked set
#     are all one thing here: fleet_watch_act_start takes the host, the words
#     the notices name it by, its FLEET_LOG text, its budget and the remote
#     argv, and the rest is the same for every caller.
#   * The job is fleet_call_mutating — the origin, the older-host retry, the
#     relay — on the budget it is handed (GHR-81's, for every key so far),
#     writing the remote's stdout and stderr into FW_TMP/act.<i>/ as they come
#     and its exit status into `rc` LAST, so the loop never takes half a result.
#   * While it runs the frame has a line for it between the table and the
#     legend: the latest complete line the remote has written (its progress
#     lines — `waiting for slot-1 (job-a) ... 2m`), made safe with relay_safe,
#     which is the only filter between those bytes and the terminal until the
#     call ends. At most FW_ACT_LINES of them, the last saying how many more:
#     the lines are chrome the viewport fits the window around (GHR-73), and a
#     fleet of actions must not leave the table no rows.
#   * Esc DETACHES. The line goes and the legend stops offering it; the job,
#     and the remote command, carry on — nothing is signalled — and its notice
#     still arrives. It cancels nothing, and says so.
#   * When it ends: its notice (the last line, or the error with its remedy —
#     a budget overrun in GHR-81's may-still-be-running words), its FLEET_LOG
#     line, and a fresh round so the frame shows the effect. A notice lives as
#     long as any notice does — until the next key — and one that lands while
#     a confirm line is up waits under it until that is answered.
#   * q, Ctrl-C and every other way out end the LOCAL side only: the job, and
#     the ssh under it (proc_tree_kill, as fleet_watch_reap ends a fetch). The
#     remote command is not signalled, and the watch says it was still running
#     and where to look. Its FLEET_LOG line says `HOST=detached`: the one
#     result this node never learnt.
#
# The record is FLEET_LOG's alone. The job is a subshell, so it inherits no
# EXIT trap and arms nothing, and the watch writes exactly one line per action
# — on the action's end while the watch is running (Esc or not: detaching stops
# the view, not the command), else `detached` on the way out. Neither is a
# record of an interruption: nothing interrupted the command.
FW_ACT_PID=() FW_ACT_LABEL=() FW_ACT_VERB=() FW_ACT_LOG=() FW_ACT_BUDGET=() FW_ACT_DETACHED=() FW_ACT_SHOWN=()
FW_ACT_LINES=3 FW_ACT_LAUNCHED=false FW_ACT_DRAW=false FW_ACT_NOTICE=false
FW_ACT_HELD="" FW_ACT_FOOT="" ACT_LAST="" FLEET_HOST_I=""

# HOST's position in FLEET_HOSTS, into FLEET_HOST_I; 1 when it is not watched.
fleet_host_index() { # HOST
  local i
  FLEET_HOST_I=""
  for i in "${!FLEET_HOSTS[@]}"; do
    if [ "${FLEET_HOSTS[$i]}" = "$1" ]; then FLEET_HOST_I="$i"; return 0; fi
  done
  return 1
}

# The one-per-host rule: 0, with FW_NOTICE saying why, when HOST has an
# action out — detached or not, since its command is still running there.
fleet_watch_act_refuse() { # HOST
  local i
  # GHR-144: a `:` command holds every host it targets.
  if fleet_watch_cmd_holds "$1"; then
    FW_NOTICE="$1: busy — '${FW_CMD_JOB#runnerctl }' (from :) is still running there${FW_CMD_DETACHED:+ (detached)}; one action per host at a time, nothing issued"
    return 0
  fi
  fleet_host_index "$1" || return 1
  i="$FLEET_HOST_I"
  [ -n "${FW_ACT_PID[$i]:-}" ] || return 1
  FW_NOTICE="$1: busy — ${FW_ACT_VERB[$i]} of ${FW_ACT_LABEL[$i]} is still running there${FW_ACT_DETACHED[$i]:+ (detached)}; one action per host at a time, nothing issued"
}

# Start an action on HOST. LABEL and VERB are what its lines say
# (`example.slot-1 on build-1`, `restart`), LOG-TEXT its FLEET_LOG command,
# BUDGET its seconds. 1, with FW_NOTICE, when the host is busy.
fleet_watch_act_start() { # HOST LABEL VERB LOG-TEXT BUDGET REMOTE-ARGS...
  local i d
  fleet_host_index "$1" || return 1
  ! fleet_watch_act_refuse "$1" || return 1
  i="$FLEET_HOST_I" d="$FW_TMP/act.$FLEET_HOST_I"
  rm -rf "$d"
  mkdir "$d"
  FW_ACT_LABEL[i]="$2" FW_ACT_VERB[i]="$3" FW_ACT_LOG[i]="$4" FW_ACT_BUDGET[i]="$5"
  FW_ACT_DETACHED[i]="" FW_ACT_SHOWN[i]=""
  shift 5
  # GHR-88: the origin the call carries, read here so the job inherits it —
  # and GHR-150's heartbeat.
  fleet_origin
  fleet_heartbeat
  # Nothing to say on the terminal, and nothing to read from it: every byte
  # it has is in its files.
  fleet_watch_act_job "$i" "${FW_ACT_BUDGET[$i]}" "$@" </dev/null >/dev/null 2>&1 &
  FW_ACT_PID[i]="$!"
  # The loop's first look at it is one FW_POLL on, as for a round's fetches.
  FW_ACT_LAUNCHED=true
}
fleet_watch_act_job() { # INDEX BUDGET REMOTE-ARGS...
  local i="$1" d="$FW_TMP/act.$1" s
  shift
  # GHR-162: a worker — q and Ctrl-C end it with its ssh (fleet_watch_act_quit).
  builtin trap '' INT QUIT
  if fleet_watch_act_is_read "${FW_ACT_VERB[$i]}"; then
    # GHR-136: a read (U's `upgrade --check`) runs as the login, on its budget,
    # with no sudo and no origin — as the foreground call it replaces did.
    local rrc=0
    (FLEET_CALL_TIMEOUT="$1" ssh_run "${FLEET_HOSTS[$i]}" "$FLEET_RUNNERCTL" "${@:2}") >"$d/out" 2>"$d/err" || rrc=$?
    relay_file "$d/out"
    relay_file "$d/err"
    FLEET_CALL_RC="$rrc"
  elif [ "${#FW_ACT_EACH[@]}" -eq 0 ]; then
    fleet_call_mutating "${FLEET_HOSTS[$i]}" "$d/out" "$d/err" "$@"
  else
    # GHR-127: one call per slot (E, X), in turn, each slot's name after the
    # args; the first that fails ends the action with its own answer.
    for s in "${FW_ACT_EACH[@]}"; do
      fleet_call_mutating "${FLEET_HOSTS[$i]}" "$d/out" "$d/err" "$@" "$s"
      [ "$FLEET_CALL_RC" = 0 ] || break
    done
  fi
  # GHR-128: an upgrade that says it wrote is read back, as a read, before the
  # rc lands — the loop takes the answer only once it is whole.
  if [ "${FW_ACT_VERB[$i]}" = upgrade ] && [ "$FLEET_CALL_RC" = 0 ] && fleet_watch_version_ok "$(fleet_upgrade_wrote "$d/out")"; then
    local rb=0
    (FLEET_CALL_TIMEOUT="$FLEET_WATCH_TIMEOUT" ssh_run "${FLEET_HOSTS[$i]}" "$FLEET_RUNNERCTL" version) >"$d/rb.out" 2>"$d/rb.err" || rb=$?
    relay_file "$d/rb.out"
    relay_file "$d/rb.err"
    echo "$rb" >"$d/rb.rc"
  fi
  # GHR-150: what the host was found to refuse, for the session to remember
  # (the job is a subshell): it is asked once per watch, not once per key.
  echo "$FLEET_OPTIONAL_REJECTED" >"$d/rejected"
  echo "$FLEET_CALL_RC" >"$d/rc.new"
  mv -f "$d/rc.new" "$d/rc"
}

# Whether VERB is a read the runner runs without the mutating path (GHR-136):
# no FLEET_LOG line, no refresh round, no `busy` left behind.
fleet_watch_act_is_read() { # VERB
  [ "$1" = upgrade-check ]
}

# Whether any action is out / any is still being watched (not detached).
fleet_watch_act_out() {
  local i
  [ -z "$FW_CMD_PID" ] || return 0
  for i in "${!FW_ACT_PID[@]}"; do [ -z "${FW_ACT_PID[$i]}" ] || return 0; done
  return 1
}
fleet_watch_act_attached() {
  local i
  [[ -z "$FW_CMD_PID" || -n "$FW_CMD_DETACHED" ]] || return 0
  for i in "${!FW_ACT_PID[@]}"; do
    [[ -z "${FW_ACT_PID[$i]}" || -n "${FW_ACT_DETACHED[$i]}" ]] || return 0
  done
  return 1
}

# The last non-empty COMPLETE line of FILE made safe — relay_safe, PLAIN for a
# line that is never painted — into ACT_LAST. A line the remote is still
# writing has no newline yet, and `read` hands it back false: it is not shown
# half-written.
fleet_watch_act_last() { # FILE [PLAIN]
  local line latest=""
  ACT_LAST=""
  [ -s "$1" ] || return 0
  while IFS= read -r line; do [ -z "$line" ] || latest="$line"; done <"$1"
  relay_safe "$latest" ${2:+plain}
  ACT_LAST="$RELAY_SAFE"
}

# A running action's line, into FW_ACT_SHOWN; FW_ACT_DRAW when it changed.
fleet_watch_act_progress() { # INDEX
  local i="$1" s
  fleet_watch_act_last "$FW_TMP/act.$i/out" plain
  [ -n "$ACT_LAST" ] || fleet_watch_act_last "$FW_TMP/act.$i/err" plain
  s="${FW_ACT_LABEL[$i]}: ${FW_ACT_VERB[$i]} running${ACT_LAST:+ — $ACT_LAST}"
  if [ "${FW_ACT_VERB[$i]}" = upgrade-check ]; then s="checking ${FW_ACT_LABEL[$i]} …"; fi
  [ "$s" = "${FW_ACT_SHOWN[$i]:-}" ] || FW_ACT_SHOWN[i]="$s" FW_ACT_DRAW=true
}

# A notice from an action that ended. Kept beside one that landed since the
# last key; held while a confirm line is up, which it would otherwise replace.
fleet_watch_act_notice() { # TEXT
  if [ -n "$FW_PROMPT" ]; then FW_ACT_HELD+="${FW_ACT_HELD:+ · }$1"; return 0; fi
  if $FW_ACT_NOTICE && [ -n "$FW_NOTICE" ]; then FW_NOTICE+=" · $1"; else FW_NOTICE="$1"; fi
  FW_ACT_NOTICE=true
}

# Take in every action that has ended, and each running one's latest line.
# 0 when one ended: the loop then asks for a fresh round, so the next frame
# shows what the action did. A job gone without its `rc` — killed from
# outside — is an answer too, as for a fetch (fleet_watch_collect).
fleet_watch_act_collect() {
  local i d rc n logrc ended=1
  # GHR-144: the `:` command's job, taken in the same way.
  ! fleet_watch_cmd_collect || ended=0
  for i in "${!FW_ACT_PID[@]}"; do
    [ -n "${FW_ACT_PID[$i]}" ] || continue
    d="$FW_TMP/act.$i"
    if [ ! -e "$d/rc" ]; then
      if kill -0 "${FW_ACT_PID[$i]}" 2>/dev/null; then
        [ -n "${FW_ACT_DETACHED[$i]}" ] || fleet_watch_act_progress "$i"
        continue
      fi
      if [ ! -e "$d/rc" ]; then
        echo 255 >"$d/rc"
        echo "the call ended without an answer" >"$d/err"
      fi
    fi
    rc="$(cat "$d/rc" 2>/dev/null || echo 255)"
    fleet_optional_learn "$d/rejected"
    logrc="$rc"
    if fleet_watch_act_is_read "${FW_ACT_VERB[$i]}"; then
      # GHR-136: a read. Its slot is free before the confirm is raised; it
      # writes no record and asks for no refresh round, only a redraw. A
      # detached one is followed no further, and says nothing.
      if [ -z "${FW_ACT_DETACHED[$i]}" ]; then
        FW_ACT_PID[i]="" FW_ACT_SHOWN[i]=""
        fleet_watch_upgrade_landed "$i" "$rc" "$d"
      else
        # GHR-151: a detached check of a marked set ends that set's confirm.
        fleet_watch_upset_forget "$i"
      fi
      FW_ACT_PID[i]="" FW_ACT_SHOWN[i]="" FW_ACT_DETACHED[i]=""
      rm -rf "$d"
      FW_ACT_DRAW=true
      continue
    fi
    if [ "$rc" = 0 ] && [ "${FW_ACT_VERB[$i]}" = upgrade ]; then
      fleet_watch_upgrade_notice "$i" "$d"
      n="${FW_ACT_LABEL[$i]}: $UP_NOTICE" logrc="$UP_RC"
    elif [ "$rc" = 0 ]; then
      fleet_watch_act_last "$d/out"
      n="${FW_ACT_LABEL[$i]}: ${ACT_LAST:-${FW_ACT_VERB[$i]} done}"
    else
      n="${FW_ACT_LABEL[$i]}: ${FW_ACT_VERB[$i]} failed — $(fleet_error_text "$rc" "$d/err" "${FW_ACT_BUDGET[$i]}" mutating "${FW_ACT_LABEL[$i]##* on }")"
    fi
    fleet_log_write "${FW_ACT_LOG[$i]}" "${FLEET_HOSTS[$i]}=$logrc"
    fleet_watch_act_notice "$n"
    FW_ACT_PID[i]="" FW_ACT_SHOWN[i]="" FW_ACT_DETACHED[i]="" FW_ACT_FROM[i]="" FW_ACT_TO[i]=""
    rm -rf "$d"
    ended=0
  done
  return "$ended"
}

# Esc: stop watching the cursor's host's action — or, with none there, every
# action still watched. Nothing is signalled.
fleet_watch_act_detach() {
  local i at="" where="" n=0 h
  if fleet_host_index "$FW_HOST" && [[ -n "${FW_ACT_PID[$FLEET_HOST_I]:-}" && -z "${FW_ACT_DETACHED[$FLEET_HOST_I]:-}" ]]; then
    at="$FLEET_HOST_I"
  # GHR-144: the cursor's host is one a watched `:` command holds — that one.
  elif [ -z "$FW_CMD_DETACHED" ] && fleet_watch_cmd_holds "$FW_HOST"; then
    at=cmd
  fi
  if [[ -n "$FW_CMD_PID" && -z "$FW_CMD_DETACHED" ]] && [[ -z "$at" || "$at" = cmd ]]; then
    FW_CMD_DETACHED=1 n=$((n + 1))
    for h in ${FW_CMD_HOSTS[@]+"${FW_CMD_HOSTS[@]}"}; do where+="${where:+, }$h"; done
  fi
  for i in "${!FW_ACT_PID[@]}"; do
    [ "$at" != cmd ] || break
    [[ -n "${FW_ACT_PID[$i]}" && -z "${FW_ACT_DETACHED[$i]}" ]] || continue
    [[ -z "$at" || "$i" = "$at" ]] || continue
    FW_ACT_DETACHED[i]=1
    where+="${where:+, }${FLEET_HOSTS[$i]}" n=$((n + 1))
  done
  if [ "$n" -eq 1 ]; then
    FW_NOTICE="detached — the command continues on $where; its notice comes when it ends"
  elif [ "$n" -gt 1 ]; then
    FW_NOTICE="detached — the commands continue on $where; each one's notice comes when it ends"
  fi
}

# The lines the watched actions take under the table, into FW_ACT_FOOT, each
# ending in a newline; empty with none.
fleet_watch_act_foot() {
  local i k=0 rest="" max="$FW_ACT_LINES"
  local -a on=()
  FW_ACT_FOOT=""
  # GHR-144: a watched `:` command's line comes first, and counts.
  if [[ -n "$FW_CMD_PID" && -z "$FW_CMD_DETACHED" ]]; then
    [ -n "$FW_CMD_LINE" ] || fleet_watch_cmd_progress
    FW_ACT_FOOT+="$FW_CMD_LINE"$'\n'
    max=$((max - 1))
  fi
  for i in "${!FW_ACT_PID[@]}"; do
    [[ -z "${FW_ACT_PID[$i]}" || -n "${FW_ACT_DETACHED[$i]}" ]] || on+=("$i")
  done
  for i in ${on[@]+"${on[@]}"}; do
    k=$((k + 1))
    if [ "${#on[@]}" -gt "$max" ] && [ "$k" -ge "$max" ]; then
      rest+="${rest:+, }${FLEET_HOSTS[$i]}"
      continue
    fi
    [ -n "${FW_ACT_SHOWN[$i]:-}" ] || fleet_watch_act_progress "$i"
    FW_ACT_FOOT+="${FW_ACT_SHOWN[$i]}"$'\n'
  done
  [ -z "$rest" ] || FW_ACT_FOOT+="… and $((${#on[@]} - max + 1)) more running: $rest"$'\n'
}

# On the way out (the EXIT trap): what ended meanwhile is taken in, and every
# action still out is left to its host — its job and the ssh under it ended
# here, its command not signalled — and said so, under the last frame.
fleet_watch_act_quit() {
  local i pid host
  fleet_watch_act_out || return 0
  fleet_watch_act_collect || true
  # GHR-144: a `:` command still out. Its record is cmd_fleet's own: the
  # watch writes none for it.
  pid="$FW_CMD_PID"
  if [ -n "$pid" ]; then
    FW_CMD_PID=""
    printf "%s was still running when the watch ended — the watch stopped following it and did not cancel it on the hosts; 'runnerctl fleet status' shows where it got to\n" \
      "${FW_CMD_JOB#runnerctl }"
    [ "$(proc_ppid "$pid")" != "$$" ] || proc_tree_kill "$pid"
  fi
  for i in "${!FW_ACT_PID[@]}"; do
    pid="${FW_ACT_PID[$i]}" host="${FLEET_HOSTS[$i]}"
    [ -n "$pid" ] || continue
    FW_ACT_PID[i]=""
    if fleet_watch_act_is_read "${FW_ACT_VERB[$i]}"; then
      # GHR-136: a read has no command to leave running and no record.
      [ "$(proc_ppid "$pid")" != "$$" ] || proc_tree_kill "$pid"
      continue
    fi
    printf "%s: %s was still running when the watch ended — the watch stopped following it and did not cancel it; 'runnerctl fleet status --host %s' shows where it got to\n" \
      "${FW_ACT_LABEL[$i]}" "${FW_ACT_VERB[$i]}" "$host"
    fleet_log_write "${FW_ACT_LOG[$i]}" "$host=detached"
    # Only a job that is still this process's child: a reaped pid can belong
    # to anything by now.
    [ "$(proc_ppid "$pid")" = "$$" ] || continue
    proc_tree_kill "$pid"
  done
}

# --- Fleet watch: marked rows (GHR-129) -----------------------------------------
# Space marks the cursor's slot row (on a marked one: unmarks it), * marks every
# slot row the view shows — so `!` then `*` marks exactly the problem rows — and
# u clears every mark. A mark is the row's IDENTITY, the (host, slot) pair the
# cursor already is (fleet_watch_mark_id), never its position: a sort, a filter
# or a refresh that reorders the rows moves the mark with its slot, and a row a
# view hides keeps its mark. Only a slot row is marked; a host's error row and a
# folded host are not slots.
#
# Marks are drawn in a two-column gutter in front of every line of the table
# (`* ` on a marked row), and only while there are marks: with none the frame
# is byte for byte what it was. The legend counts them.
#
# A marked slot its host stops reporting — the host ANSWERED, and the slot is not
# in its table — is dropped from the set when that frame arrives, and the notice
# says so. A host that is not answering keeps its marks as it keeps its rows:
# nothing says its slots are gone.
#
# WITH MARKS, AN ACTION KEY ACTS ON THE SET, not on the cursor's row:
#
#   K R S T P   each marked slot, decided on that slot's own facts read afresh
#               at the keypress (fleet_watch_facts, a read per slot). A slot
#               the key does not apply to (T on an active one) is skipped and
#               named under the confirm line. R and S still take w.
#   D W E X U   the HOSTS of the marked rows, each once, in config order: all
#               of each host's slots, as the host keys always take them; U after
#               each host's own `upgrade --check`.
#   L O         the cursor's row only, as without marks: neither changes a host.
#
# ONE confirm line lists every target and its exact command, cut with a count
# where the terminal is too narrow for all of it; y runs them, anything else
# cancels. They run as ONE ACTION PER HOST (GHR-125's rule), every host's
# started at once: a host's marked slots are a call each, in turn, inside its
# one action (FW_ACT_EACH, as E and X run), so each host's result is a notice
# of its own. A marked host with an action already out refuses the whole set
# before any facts are read. The marks stay until u.
#
# THE FLOOR is the set's: S (y or w), D and X take every target's active slots
# out TOGETHER (fleet_watch_floor_set), so three slots that each pass
# --min-available alone are refused when the three would cross it.
#
# fleet_watch_marked is the set as pairs, for anything else that acts on "the
# marked rows" (GHR-86's `:` prompt).
declare -A FW_MARK=()
FW_MARKS=() FW_MARKED=() MARK_ID="" SET_LINE="" SET_HOSTS=()
FW_SET_HOSTS=() FW_SET_SLOTS=() FW_SET_FROM=() FW_SET_TO=()

# The identity of row POS of the view, into MARK_ID: its (host, slot) pair.
fleet_watch_mark_id() { # POS
  MARK_ID="${FW_ROWS[$1]}"
}
fleet_watch_marks_on() { [ "${#FW_MARKS[@]}" -gt 0 ]; }

# GHR-141: the legend line for the states now on, into FW_LEGEND; $1 is the
# marked count. None on: the default legend. Any on: those states' hints in a
# fixed order, then "? keys" — the whole of it far under 80 columns (59 with a
# view on, 999 marked and an action attached).
fleet_watch_legend() {
  local hints=""
  FW_LEGEND="$FLEET_WATCH_LEGEND"
  fleet_watch_view_plain || hints+="a all  "
  ! fleet_watch_marks_on || hints+="$1 marked, u clears  "
  ! fleet_watch_act_attached || hints+="Esc detach  "
  [ -z "$hints" ] || FW_LEGEND="${hints}? keys"
}

# The marked set as "HOST<TAB>NAME" pairs, into FW_MARKED: hosts in config
# order, each host's slots in the order they were marked.
fleet_watch_marked() {
  local h id
  FW_MARKED=()
  for h in "${FLEET_HOSTS[@]}"; do
    for id in ${FW_MARKS[@]+"${FW_MARKS[@]}"}; do
      [ "${id%%$'\t'*}" != "$h" ] || FW_MARKED+=("$id")
    done
  done
}
# The hosts of the marked rows, each once, in config order, into SET_HOSTS.
fleet_watch_marked_hosts() {
  local h id
  SET_HOSTS=()
  for h in "${FLEET_HOSTS[@]}"; do
    for id in ${FW_MARKS[@]+"${FW_MARKS[@]}"}; do
      if [ "${id%%$'\t'*}" = "$h" ]; then SET_HOSTS+=("$h"); break; fi
    done
  done
}

# Mark ID (on) or unmark it (off). FW_MARKS keeps the order; FW_MARK is the
# lookup, rebuilt from it.
fleet_watch_mark_set() { # ID on|off
  local id
  local -a kept=()
  if [ "$2" = on ]; then
    [ -n "${FW_MARK[$1]:-}" ] && return 0
    FW_MARK[$1]=1 FW_MARKS+=("$1")
    return 0
  fi
  for id in ${FW_MARKS[@]+"${FW_MARKS[@]}"}; do [ "$id" = "$1" ] || kept+=("$id"); done
  fleet_watch_marks_keep ${kept[@]+"${kept[@]}"}
}
fleet_watch_marks_keep() { # ID...
  local id
  FW_MARKS=("$@") FW_MARK=()
  for id in "$@"; do FW_MARK[$id]=1; done
}

# Space, * and u. See the block above.
fleet_watch_mark_key() { # ' '|*|u
  local j n=0 was="${#FW_MARKS[@]}"
  case "$1" in
    u)
      if [ "$was" -eq 0 ]; then
        FW_NOTICE="no marks to clear"
      else
        fleet_watch_marks_keep
        FW_NOTICE="marks cleared — $was slot(s) unmarked; keys act on the cursor's row again"
      fi ;;
    '*')
      for j in "${!FW_ROWS[@]}"; do
        [ "${FW_KIND[$j]:-}" = slot ] || continue
        fleet_watch_mark_id "$j"
        [ -z "${FW_MARK[$MARK_ID]:-}" ] || continue
        fleet_watch_mark_set "$MARK_ID" on
        n=$((n + 1))
      done
      FW_NOTICE="marked $n slot(s) the view shows — ${#FW_MARKS[@]} marked in all" ;;
    *)
      if [ "$FW_POS" -lt 0 ]; then FW_NOTICE="no row to mark"; return 0; fi
      case "${FW_KIND[$FW_POS]:-}" in
        host) FW_NOTICE="$FW_HOST: folded to one line — c or Enter opens it, then mark its slots"; return 0 ;;
        down) FW_NOTICE="$FW_HOST: not answering — no slot there to mark"; return 0 ;;
      esac
      fleet_watch_mark_id "$FW_POS"
      if [ -n "${FW_MARK[$MARK_ID]:-}" ]; then
        fleet_watch_mark_set "$MARK_ID" off
      else
        fleet_watch_mark_set "$MARK_ID" on
      fi ;;
  esac
}

# A new frame: every mark whose host answered without that slot is dropped, and
# said so. FRAME is the whole frame, not the view — a slot a filter hides is
# still there. The view's rows are put back as they were.
fleet_watch_mark_prune() { # FRAME
  local id h rc gone=""
  local -a was_rows=() was_lines=() kept=()
  local -A here=()
  fleet_watch_marks_on || return 0
  was_rows=(${FW_ROWS[@]+"${FW_ROWS[@]}"}) was_lines=(${FW_LINES[@]+"${FW_LINES[@]}"})
  fleet_watch_rows "$1"
  for id in ${FW_ROWS[@]+"${FW_ROWS[@]}"}; do here[$id]=1; done
  FW_ROWS=(${was_rows[@]+"${was_rows[@]}"}) FW_LINES=(${was_lines[@]+"${was_lines[@]}"})
  for id in "${FW_MARKS[@]}"; do
    h="${id%%$'\t'*}"
    if [ -z "${here[$id]:-}" ] && fleet_host_index "$h"; then
      rc="$(cat "$FW_STATE/$FLEET_HOST_I.rc" 2>/dev/null || true)"
      if [ "$rc" = 0 ]; then
        gone+="${gone:+, }${id#*$'\t'} on $h"
        continue
      fi
    fi
    kept+=("$id")
  done
  [ -n "$gone" ] || return 0
  fleet_watch_marks_keep ${kept[@]+"${kept[@]}"}
  fleet_watch_act_notice "mark dropped: $gone — no longer on that host"
}

# The view with its gutter: `* ` in front of a marked row, two spaces in front
# of every other line. Nothing at all while nothing is marked.
fleet_watch_gutter() {
  local line n=0 j out=""
  local -A marked_line=()
  fleet_watch_marks_on || return 0
  for j in "${!FW_LINES[@]}"; do
    fleet_watch_mark_id "$j"
    [ -z "${FW_MARK[$MARK_ID]:-}" ] || marked_line[${FW_LINES[$j]}]=1
  done
  while IFS= read -r line; do
    n=$((n + 1))
    if [ -n "${marked_line[$n]:-}" ]; then out+="* $line"$'\n'; else out+="  $line"$'\n'; fi
  done <<<"$FW_VIEW"
  FW_VIEW="${out%$'\n'}"
}

# HEAD, then the ITEMs joined with `; `, then TAIL — into SET_LINE, cut to the
# terminal's width where it is known: as many items as fit, then `; … and N
# more`. The first item is always there.
fleet_watch_set_line() { # HEAD TAIL ITEM...
  local head="$1" tail="$2" cols line i item more
  shift 2
  cols="$(term_cols)"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=0
  line="$head${1-}"
  for ((i = 2; i <= $#; i++)); do
    item="${!i}" more=""
    [ "$i" -eq "$#" ] || more="; … and $(($# - i)) more"
    if [ "$cols" -gt 0 ] && [ $((${#line} + 2 + ${#item} + ${#more} + ${#tail})) -gt "$cols" ]; then
      SET_LINE="$line; … and $(($# - i + 1)) more$tail"
      return 0
    fi
    line+="; $item"
  done
  SET_LINE="$line$tail"
}

# One action per host: 1, with FW_NOTICE naming the host, when a host of the
# marked set has an action out — the set is refused whole.
fleet_watch_set_free() {
  local h
  fleet_watch_marked_hosts
  for h in ${SET_HOSTS[@]+"${SET_HOSTS[@]}"}; do
    ! fleet_watch_act_refuse "$h" || return 1
  done
}
fleet_watch_set_active() {
  case "${FF[active]}" in active|activating|reloading) return 0 ;; esac
  return 1
}
fleet_watch_set_done() {
  FW_SET_HOSTS=() FW_SET_SLOTS=() FW_SET_FROM=() FW_SET_TO=() FW_ACT_EACH=()
  FW_ACTION="" FW_PROMPT="" FW_ACT_SCOPE=slot
}

# K R S T P over the marked set: FW_NOTICE (nothing runs) or FW_PROMPT +
# FW_ACTION with FW_ACT_SCOPE=set, each host's slots in FW_SET_HOSTS /
# FW_SET_SLOTS (space-separated: a RUNNER cell is one word).
fleet_watch_set_slot_key() { # K|R|S|T|P
  local key="$1" verb pair host name lbl why k n=0 busy="" head tail=""
  local -a items=() active=() skipped=()
  local -A slot_of=()
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_SCOPE=set FW_SET_HOSTS=() FW_SET_SLOTS=()
  case "$key" in K) verb='kill' ;; R) verb=restart ;; S) verb=stop ;; T) verb=start ;; *) verb=reap ;; esac
  fleet_watch_set_free || return 0
  fleet_watch_marked
  fleet_priv_cmd
  for pair in "${FW_MARKED[@]}"; do
    host="${pair%%$'\t'*}" name="${pair#*$'\t'}" lbl="${pair#*$'\t'} on ${pair%%$'\t'*}" why=""
    if ! fleet_watch_facts "$host" "$name"; then
      skipped+=("$FW_NOTICE") FW_NOTICE=""
      continue
    fi
    case "$key" in
      K) if [ "${FF[active]}" != deactivating ] && [ -z "${FF[job]}" ]; then
           if [ "${FF[access]}" = no-access ]; then why="cannot tell whether a job is running"; else why="no job running"; fi
         fi ;;
      R) fleet_watch_set_active || why="not active (${FF[active]:-unknown})" ;;
      S) fleet_watch_set_active || why="already stopped (${FF[active]:-unknown})" ;;
      T) ! fleet_watch_set_active || why="already active" ;;
      *) if ! [[ "${FF[leaked]}" =~ ^[0-9]+$ ]] || [ "${FF[leaked]}" -eq 0 ]; then
           if [ -n "${FF[job]}" ]; then why="busy — a running job's processes are not leaks"; else why="no leaked processes shown"; fi
         fi ;;
    esac
    if [ -n "$why" ]; then skipped+=("$lbl: $why"); continue; fi
    if [ -z "${slot_of[$host]:-}" ]; then
      slot_of[$host]="${#FW_SET_HOSTS[@]}"
      FW_SET_HOSTS+=("$host") FW_SET_SLOTS+=("")
    fi
    k="${slot_of[$host]}"
    FW_SET_SLOTS[k]+="${FW_SET_SLOTS[$k]:+ }$name"
    items+=("on $host: ${FLEET_PRIV[*]} $verb $name")
    [ "$key" != S ] || active+=("${FF[active]}")
    [ -z "${FF[job]}" ] || [ "$key" = K ] || busy+="${busy:+, }$lbl (${FF[job_cell]})"
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then
    fleet_watch_set_line "nothing to $verb among the ${#FW_MARKED[@]} marked slot(s) — " "; nothing issued" "${skipped[@]}"
    FW_NOTICE="$SET_LINE"
    return 0
  fi
  if [ "$key" = S ]; then
    fleet_watch_floor_set "$n marked slot(s): not stopped" "unmark some (space) and stop fewer" "${active[@]}" || return 0
    tail=" — $FW_CAPACITY"
  fi
  case "$key" in
    K) head="Kill the job on $n marked slot(s)? runs " ;;
    R) head="Restart $n marked slot(s)? runs " ;;
    S) head="Stop $n marked slot(s)? runs " ;;
    T) head="Start $n marked slot(s)? runs " ;;
    *) head="Reap leaked processes on $n marked slot(s)? runs " ;;
  esac
  fleet_watch_set_line "$head" "$tail  [y/n]" "${items[@]}"
  FW_PROMPT="$SET_LINE"
  if [ "${#skipped[@]}" -gt 0 ]; then
    fleet_watch_set_line "skipped: " "" "${skipped[@]}"
    FW_PROMPT+=$'\n'"$SET_LINE"
  fi
  if [ "$key" = R ] || [ "$key" = S ]; then
    [ -z "$busy" ] || FW_PROMPT+=$'\n'"warning: a job is running ($busy) — y kills it and GitHub marks it failed; w waits for it instead"
    FW_PROMPT+=$'\n'"w instead runs each with --when-idle — waits for its job to finish; anything else cancels"
  fi
  FW_ACTION="$verb"
}

# The confirmed set of slot actions: one background action per host, its slots
# a call each, in turn (FW_ACT_EACH). WHEN-IDLE is w's --when-idle.
fleet_watch_run_set() { # [--when-idle]
  local k host budget s shown label verb="$FW_ACTION"
  local -a names=() q=()
  budget="$(fleet_mutate_budget "$verb" 1 "$@")"
  fleet_priv_cmd
  for k in "${!FW_SET_HOSTS[@]}"; do
    host="${FW_SET_HOSTS[$k]}"
    read -ra names <<<"${FW_SET_SLOTS[$k]}"
    q=() shown=""
    for s in "${names[@]}"; do
      q+=("$(printf %q "$s")")
      shown+="${shown:+; }${FLEET_PRIV[*]} $verb${1:+ $1} $s"
    done
    printf '\nrunning on %s: %s\n' "$host" "$shown"
    label="${names[*]}"
    FW_ACT_EACH=("${q[@]}")
    # GHR-88: recorded on this node as the command line the keys stand for.
    fleet_watch_act_start "$host" "${label// /, } on $host" "$verb" \
      "fleet $verb${1:+ $1} --host $host ${names[*]} (fleet watch)" "$budget" "$verb" "$@" || true
  done
  fleet_watch_set_done
}

# D W E X over the hosts of the marked rows. FW_ACT_SCOPE=hostset, each host's
# slots in FW_SET_SLOTS; the floor of D and X is every one of them together.
fleet_watch_set_host_key() { # D|W|E|X
  local key="$1" verb host i n names each busy="" head tail
  local -a items=() active=() skipped=()
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_SCOPE=hostset FW_SET_HOSTS=() FW_SET_SLOTS=()
  case "$key" in D) verb=drain ;; W) verb=restart ;; E) verb=enable ;; *) verb=disable ;; esac
  fleet_watch_set_free || return 0
  fleet_priv_cmd
  for host in "${SET_HOSTS[@]}"; do
    if ! fleet_watch_host_facts "$host"; then
      skipped+=("$FW_NOTICE") FW_NOTICE=""
      continue
    fi
    if [ "${#HF_NAMES[@]}" -eq 0 ]; then skipped+=("$host: no slots there"); continue; fi
    names="" each=""
    for i in "${!HF_NAMES[@]}"; do
      names+="${names:+ }${HF_NAMES[$i]}"
      each+="${each:+; }${FLEET_PRIV[*]} $verb ${HF_NAMES[$i]}"
      [ -z "${HF_JOBS[$i]}" ] || busy+="${busy:+, }${HF_NAMES[$i]} on $host (${HF_JOBS[$i]})"
    done
    active+=("${HF_ACTIVE[@]}")
    FW_SET_HOSTS+=("$host") FW_SET_SLOTS+=("$names")
    case "$key" in
      D) items+=("on $host: ${FLEET_PRIV[*]} drain $names") ;;
      W) items+=("on $host: ${FLEET_PRIV[*]} restart --when-idle $names") ;;
      *) items+=("on $host, one call per slot: $each") ;;
    esac
  done
  n="${#FW_SET_HOSTS[@]}"
  if [ "$n" -eq 0 ]; then
    fleet_watch_set_line "nothing to $verb on the hosts of the marked rows — " "; nothing issued" "${skipped[@]}"
    FW_NOTICE="$SET_LINE"
    return 0
  fi
  case "$key" in
    D) fleet_watch_floor_set "$n host(s) of the marked rows: not drained" "unmark a host's rows (space) and drain fewer" "${active[@]}" || return 0
       head="Drain $n host(s) of the marked rows? runs "
       tail=" — each slot stopped once its job is done, one at a time; $FW_CAPACITY  [y/n]" ;;
    W) head="Restart $n host(s) of the marked rows when idle? runs "
       tail=" — each slot restarted once its job is done, one at a time  [y/n]" ;;
    E) head="Enable the slots of $n host(s) of the marked rows? runs "
       tail="  [y/n]" ;;
    *) fleet_watch_floor_set "$n host(s) of the marked rows: not disabled" "unmark a host's rows (space) and disable fewer" "${active[@]}" || return 0
       head="Disable the slots of $n host(s) of the marked rows? runs "
       tail=" — $FW_CAPACITY  [y/n]" ;;
  esac
  fleet_watch_set_line "$head" "$tail" "${items[@]}"
  FW_PROMPT="$SET_LINE"
  if [ "${#skipped[@]}" -gt 0 ]; then
    fleet_watch_set_line "skipped: " "" "${skipped[@]}"
    FW_PROMPT+=$'\n'"$SET_LINE"
  fi
  if [ "$key" = X ] && [ -n "$busy" ]; then
    FW_PROMPT+=$'\n'"warning: a job is running ($busy) — disable stops its slot now and GitHub marks the job failed; D drains instead"
  fi
  FW_ACTION="$verb"
}

# The confirmed host keys over the set: each host's own action, as the host key
# runs it (fleet_watch_run_host_action), all started at once.
fleet_watch_run_set_hosts() {
  local k verb="$FW_ACTION"
  for k in "${!FW_SET_HOSTS[@]}"; do
    read -ra FW_ACT_SLOTS <<<"${FW_SET_SLOTS[$k]}"
    FW_ACTION="$verb" FW_ACT_HOST="${FW_SET_HOSTS[$k]}"
    fleet_watch_run_host_action
  done
  fleet_watch_set_done
}

# U over the hosts of the marked rows: each host's `upgrade --check` runs as
# the background read the cursor's own U uses (GHR-136, GHR-151), all started
# at once, each holding its host's one action slot, so the table, the keys and
# the other hosts' progress go on while the hosts download. When the LAST one
# lands (fleet_watch_upset_landed) one confirm line lists the hosts that have
# an upgrade with their versions and the rest are skipped and said — and only
# if the marked hosts are still the ones the checks were started for.
declare -A FW_UPS_WAIT=() FW_UPS_FROM=() FW_UPS_TO=() FW_UPS_SKIP=()
FW_UPS_HOSTS=() FW_UPS_PEND=0 FW_UPS_ABANDON=false
fleet_watch_set_upgrade_key() {
  local host
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_SCOPE=slot FW_SET_HOSTS=() FW_SET_FROM=() FW_SET_TO=()
  if [ "$FW_UPS_PEND" -gt 0 ]; then
    FW_NOTICE="the upgrade checks of the marked rows are still out; nothing issued"
    return 0
  fi
  fleet_watch_set_free || return 0
  FW_UPS_HOSTS=("${SET_HOSTS[@]}") FW_UPS_FROM=() FW_UPS_TO=() FW_UPS_SKIP=() FW_UPS_WAIT=()
  FW_UPS_ABANDON=false
  for host in "${FW_UPS_HOSTS[@]}"; do
    if fleet_watch_act_start "$host" "$host" upgrade-check "" "$(fleet_mutate_budget upgrade 1)" upgrade --check; then
      FW_UPS_WAIT[$host]=1
    else
      FW_UPS_SKIP[$host]="$host: could not start the upgrade check — nothing issued"
    fi
  done
  FW_UPS_PEND="${#FW_UPS_WAIT[@]}"
  if [ "$FW_UPS_PEND" -eq 0 ]; then fleet_watch_upset_done; fi
}

# One of the set's checks has landed: what it said is kept for the confirm.
fleet_watch_upset_landed() { # INDEX RC DIR
  local i="$1" host="${FLEET_HOSTS[$1]}"
  if fleet_watch_upgrade_parse "$host" "$2" "$3/out" "$3/err" "${FW_ACT_BUDGET[$i]}"; then
    FW_UPS_FROM[$host]="$UPC_FROM" FW_UPS_TO[$host]="$UPC_TO"
  else
    FW_UPS_SKIP[$host]="$UPC_NOTICE"
  fi
  fleet_watch_upset_one_less "$host"
}
# One of the set's checks was detached (Esc): the set is no longer followed, so
# no confirm rises for it.
fleet_watch_upset_forget() { # INDEX
  local host="${FLEET_HOSTS[$1]}"
  [ -n "${FW_UPS_WAIT[$host]:-}" ] || return 0
  FW_UPS_ABANDON=true
  fleet_watch_upset_one_less "$host"
}
fleet_watch_upset_one_less() { # HOST
  unset "FW_UPS_WAIT[$1]"
  FW_UPS_PEND=$((FW_UPS_PEND - 1))
  if [ "$FW_UPS_PEND" -le 0 ]; then FW_UPS_PEND=0; fleet_watch_upset_done; fi
}
# Every check of the set is in: raise the one confirm, or say why not.
fleet_watch_upset_done() {
  local host
  local -a items=() skipped=()
  if $FW_UPS_ABANDON; then return 0; fi
  fleet_watch_marked_hosts
  if [ "${SET_HOSTS[*]-}" != "${FW_UPS_HOSTS[*]-}" ]; then
    fleet_watch_act_notice "the marked rows changed while the upgrade checks were out — nothing is asked and nothing issued"
    return 0
  fi
  if [ -n "$FW_PROMPT" ] || [ -n "$FW_MODE" ]; then
    fleet_watch_act_notice "the upgrade checks of the marked rows landed while something else was up — nothing is asked and nothing issued"
    return 0
  fi
  FW_SET_HOSTS=() FW_SET_FROM=() FW_SET_TO=()
  fleet_priv_cmd
  for host in "${FW_UPS_HOSTS[@]}"; do
    if [ -z "${FW_UPS_FROM[$host]:-}" ]; then
      skipped+=("${FW_UPS_SKIP[$host]:-$host: no answer — nothing issued}")
      continue
    fi
    FW_SET_HOSTS+=("$host") FW_SET_FROM+=("${FW_UPS_FROM[$host]}") FW_SET_TO+=("${FW_UPS_TO[$host]}")
    items+=("on $host: ${FLEET_PRIV[*]} upgrade (${FW_UPS_FROM[$host]} -> ${FW_UPS_TO[$host]})")
  done
  if [ "${#FW_SET_HOSTS[@]}" -eq 0 ]; then
    fleet_watch_set_line "no host of the marked rows to upgrade — " "" "${skipped[@]}"
    fleet_watch_act_notice "$SET_LINE"
    return 0
  fi
  FW_NOTICE="" FW_ACT_SCOPE=upgradeset
  fleet_watch_set_line "Upgrade ${#FW_SET_HOSTS[@]} host(s) of the marked rows? runs " \
    " — each host downloads the release and replaces its runnerctl, then its version is read back  [y/n]" "${items[@]}"
  FW_PROMPT="$SET_LINE"
  if [ "${#skipped[@]}" -gt 0 ]; then
    fleet_watch_set_line "skipped: " "" "${skipped[@]}"
    FW_PROMPT+=$'\n'"$SET_LINE"
  fi
  FW_ACTION=upgrade
}
fleet_watch_run_set_upgrade() {
  local k
  for k in "${!FW_SET_HOSTS[@]}"; do
    FW_ACT_HOST="${FW_SET_HOSTS[$k]}" FW_UP_FROM="${FW_SET_FROM[$k]}" FW_UP_TO="${FW_SET_TO[$k]}"
    fleet_watch_run_upgrade
  done
  fleet_watch_set_done
}

# --- Fleet watch views (GHR-75) ------------------------------------------------
# On a healthy fleet almost every row is noise: the operator is looking for
# the two that are wrong. The view keys choose what the frame shows, and none
# of them asks a host anything — like cursor movement, they redraw what the
# last tick brought:
#
#   !  problems only      slots that are STALLED, not active, leaking, at
#                         MemoryHigh or under critical memory pressure
#                         (fleet_slot_classify's SC_PROBLEM); hosts that are
#                         not answering; hosts with a disk at warn or worse
#                         or an OOM/disk-full line
#   b / i                 busy only (a STALLED job is a busy slot) / idle only
#   /                     rows whose host, runner or repo:job contains the
#                         text typed, whatever its case; ANDed with ! b i
#   a                     all: clears ! b i, the text and the collapse
#   s                     config order → longest-running job first → most
#                         memory used first
#   c                     one line per host; on a host, c or Enter opens it
#                         and c closes it again
#   ?                     every key, in place of the table, until a key
#
# The view is a LAYER OVER THE ASSEMBLED FRAME (fleet_watch_view), not a
# second renderer. Each frame line is identified by its two leftmost cells —
# the cursor's own footing, safe where a column position is not — and whether
# it is shown is decided on that host's `status --json` facts, by the
# classifier the summary line counts with. Never on a painted cell.
#
# With nothing chosen the layer is not entered at all: the frame is the one
# fleet_status_table drew, byte for byte, and the rows are read off it as
# they always were.
#
# What a view does to the lines that are not slots:
#
#   * A host's Disk/OOM line shows with any of its slots, and under ! on its
#     own when the trouble is the host's (a full disk over healthy slots, or
#     — GHR-77 — a runnerctl version other than this node's).
#   * A host that stopped answering is a problem by definition: under ! its
#     age line and ALL its kept rows stay. Under b / i its kept rows are
#     filtered by the last state the host reported — they are dimmed and
#     under their age, which already says how far to trust them — and losing
#     a host's jobs from the busy view at the moment it hiccups would be
#     worse. A host with no rows (never answered, or its runnerctl exited
#     non-zero) is one row under ! and none under b / i: nothing is known to
#     be busy or idle there, and the summary line still counts it missing.
#   * A slot row its host sent no facts for is shown under ! (nothing says it
#     is healthy) and hidden under b / i.
#   * A sort other than config order makes the table a FLAT list — the HOST
#     cell is on every row, so it reads without the grouping — and moves the
#     host lines (Disk/OOM, age lines, error rows, collapsed hosts) under the
#     rows, in config order. Ties keep config order, and a slot without the
#     fact (no job; no memory accounting) sorts last. Where a host too old
#     for --narrow answers under a column header of its own, rows are sorted
#     within each header's block, never across two column layouts.
#   * The summary line keeps counting the WHOLE fleet: it is the one line that
#     says what a filtered frame is a part of. So the header names the view.
#   * A view that shows nothing says so (FLEET_WATCH_EMPTY) under the column
#     header, and the notes stay.
#
# FW_ROWS / FW_LINES are filled here for a view, with FW_KIND saying what each
# row is: `slot`, `down` (a host that did not answer: one error row) or `host`
# (a collapsed host). The cursor stays the (host, name) pair it always was, so
# an action key under a filter acts on the row it is on however the rows were
# reordered, and fleet_watch_place handles a row leaving the view exactly as it
# handles one leaving the frame.
FW_FILTER=all FW_SORT=config FW_COLLAPSE=false FW_SEARCH="" FW_SEARCH_WAS="" FW_MODE=""
FW_VIEW="" FW_VIEW_NAME="" FW_FACTS_OK=false
FW_KIND=()
declare -A FW_FACT=() FW_HOSTBAD=() FW_HOSTSUM=() FW_OPEN=()
FLEET_WATCH_EMPTY="nothing matches — a shows all"
# GHR-98: fleet watch's legend (GHR-105: its head is the local watch's). Names
# `?` in the frame a reader sees first, and is 80 columns exactly (the
# host-scoped keys are in the overlay, not here: no room — and so is GHR-86's
# `:`, on O's line there, and GHR-87's `C` beside it: the legend has not a
# column to spare for either — nor for GHR-118's `H`, which is in the list
# too).
# GHR-141: ONE rule for every other state. With a view on, rows marked or an
# action attached, the legend is not the head with hints appended (87 to 105
# columns: it wrapped, and a fitted frame lost a table row). The head gives way
# to the hints of the states that are on, in this order, and `? keys` closes
# it: `a all`, `N marked, u clears`, `Esc detach` (see fleet_watch_legend).
# The head's keys are in `?`, which every variant names.
FLEET_WATCH_LEGEND_HEAD="$WATCH_LEGEND_HEAD"
FLEET_WATCH_LEGEND="$FLEET_WATCH_LEGEND_HEAD  ? keys  q quit"
# Seventeen lines, so that with the header, the summary and the three lines
# under it the list fits a terminal of 24 rows; none is wider than 80 columns.
FLEET_WATCH_HELP="fleet watch — keys
  ↑ ↓ j k   PgUp PgDn   g G Home End   move the cursor: a row, a page, the ends
  !     problems only: slots STALLED, not active, leaking, at MemoryHigh or under
        critical memory pressure; hosts not answering, disk/OOM, other version
  b i a   busy only / idle only / all: clears ! b i, the text and the collapse
  /     rows whose host, runner or repo:job has the text (Enter keeps, Esc cancels)
  space * u   mark this row / all shown / none; then action keys use the marks
  s     order: config → longest job first → most memory first
  c     one line per host; on a host, c or Enter opens it and c closes it
  Enter   the cursor's slot in full, in place of the table (on the row of a
          host that is not answering: that host). There q Esc Enter go back, h
          shows the host alone, ↑ ↓ PgUp PgDn scroll, K R S T P L O act on it
  K R S T P L   kill job, restart, stop, start, reap, logs; R S: w = when idle
  D W E X U   the row's host: drain, restart when idle, enable, disable, upgrade
  O : C H   job run URL; a typed fleet command; the host's compose-reap, history
  q ?   quit, this list; Esc stops following a running action, which carries on
! b i / a s c ask no host anything, and the summary counts the whole fleet."

# Whether nothing is chosen — the frame as fleet_status_table drew it.
fleet_watch_view_plain() {
  [ "$FW_FILTER" = all ] && [ "$FW_SORT" = config ] && ! $FW_COLLAPSE && [ -z "$FW_SEARCH" ]
}

# The view in words, for the header, into FW_VIEW_NAME; empty when plain.
fleet_watch_view_name() {
  local p
  local -a parts=()
  case "$FW_FILTER" in
    problems) parts+=("problems only") ;;
    busy)     parts+=("busy only") ;;
    idle)     parts+=("idle only") ;;
  esac
  [ -z "$FW_SEARCH" ] || parts+=("matching \"$FW_SEARCH\"")
  case "$FW_SORT" in
    job) parts+=("longest job first") ;;
    mem) parts+=("most memory first") ;;
  esac
  ! $FW_COLLAPSE || parts+=("collapsed")
  FW_VIEW_NAME=""
  for p in ${parts[@]+"${parts[@]}"}; do FW_VIEW_NAME+="${FW_VIEW_NAME:+ · }$p"; done
}

# Every watched host's facts, from the payload it last returned — a host that
# has stopped answering still has the one from before. FW_FACT is keyed
# "HOST<TAB>RUNNER" and holds `state|problem|since|mem|job` (the job last: it
# is the one field that may contain the separator); FW_HOSTBAD marks a host
# with a disk or event line worth seeing; FW_HOSTSUM is its collapsed line's
# `4 slots: 3 busy, 1 idle`. Once per frame at most, and only for a view that
# needs it.
fleet_watch_load_facts() {
  local i host line n busy idle stalled down disabled hv jrc
  FW_FACT=() FW_HOSTBAD=() FW_HOSTSUM=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    [ -f "$FW_STATE/$i.json" ] || continue
    n=0 busy=0 idle=0 stalled=0 down=0 disabled=0 hv=false
    while IFS= read -r line; do
      case "$line" in
        '{"runnerctl":'*)
          hv=true
          fleet_host_classify "$line"
          # GHR-77: a host not on this node's version is one `!` keeps — this
          # node forwards flags it may not know. Its host line is there to
          # show, since a version other than this node's always draws one.
          if [ -n "$HC_DISK" ] || $HC_EVENTS || [ "$HC_VER" != "$RUNNERCTL_VERSION" ]; then
            FW_HOSTBAD[$host]=1
          fi
          # GHR-113: and under FLEET_SUDO=1 a host that does not say `narrow`
          # — the table draws its host line (fleet_status_table) for it. A
          # payload with no host line at all is kept by GHR-112's rule below.
          if [ "$FLEET_SUDO" = 1 ] && [ "$HC_SUDO" != narrow ]; then
            FW_HOSTBAD[$host]=1
          fi ;;
        '  {"idx":'*)
          fleet_slot_classify "$line"
          n=$((n + 1))
          case "$SC_STATE" in
            busy)     busy=$((busy + 1)) ;;
            idle)     idle=$((idle + 1)) ;;
            stalled)  stalled=$((stalled + 1)) ;;
            disabled) disabled=$((disabled + 1)) ;;
            *)        down=$((down + 1)) ;;
          esac
          FW_FACT["$host"$'\t'"$SC_NAME"]="$SC_STATE|$SC_PROBLEM|$SC_SINCE|$SC_MEM|$SC_JOB" ;;
      esac
    done <"$FW_STATE/$i.json"
    # GHR-112: a host that answered with a payload that has no version line (a
    # runnerctl older than GHR-32 starts it with `{"host":`) is unknown, as
    # fleet_summary_count counts it — and a host `!` keeps, for the same
    # reason as above. One that did not answer (jrc non-zero, or none) is
    # left as it was.
    jrc="$(cat "$FW_STATE/$i.jrc" 2>/dev/null || echo 255)"
    if [ "$jrc" = 0 ] && ! $hv; then FW_HOSTBAD[$host]=1; fi
    [ "$n" -eq 0 ] || FW_HOSTSUM[$host]="$(fleet_states_text "$n" "$busy" "$idle" "$stalled" "$down" "$disabled")"
  done
  FW_FACTS_OK=true
}

# FRAME as the view shows it, into FW_VIEW, with its selectable rows in
# FW_ROWS / FW_LINES / FW_KIND. See the block above.
fleet_watch_view() { # FRAME
  local line s k h nm j sc fact st prob since mem job ok hm hs col out rk want list
  local sec=0 n=0 hostw=4 shown=0 pending="" hdr1="" nl=$'\n'
  local re_slot='^([^ ]+) +[0-9]+ +([^ ]+)( |$)' re_host='^([^ ]+) '
  local -a text=() lkind=() lhost=() lname=() lsec=() vis=() keys=() order=() notes=() sorted=()
  local -A known=() stale=() info=() rows=() total=() emitted=() picked=()
  FW_VIEW="$1" FW_KIND=()
  if fleet_watch_view_plain; then
    fleet_watch_rows "$1"
    for j in "${!FW_ROWS[@]}"; do
      if [ -n "${FW_ROWS[$j]#*$'\t'}" ]; then FW_KIND[j]=slot; else FW_KIND[j]=down; fi
    done
    return 0
  fi
  $FW_FACTS_OK || fleet_watch_load_facts
  for h in "${FLEET_HOSTS[@]}"; do
    known[$h]=1
    [ "${#h}" -le "$hostw" ] || hostw="${#h}"
  done
  want="${FW_SEARCH,,}"
  # What each frame line is. A line is a host's by its first word, as in
  # fleet_watch_rows, and the tests are in that function's order.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    strip_sgr "$line"; s="$SGR_STRIPPED"
    k=other h="" nm=""
    if [[ "$s" =~ $re_host ]] && [ -n "${known[${BASH_REMATCH[1]}]:-}" ]; then
      h="${BASH_REMATCH[1]}"
      if [[ "$s" =~ $FLEET_INFO_RE ]]; then
        # The line without its HOST cell, the remote's colours kept: what a
        # collapsed host carries after its counts.
        k=info info[$h]="${line:$((hostw + 1))}"
      elif [[ "$s" =~ $FLEET_STALE_RE ]]; then
        k=stale stale[$h]="$line"
      elif [[ "$s" =~ $re_slot ]]; then
        k=slot nm="${BASH_REMATCH[2]}"
      else
        k=err
      fi
    elif [[ "$s" =~ ^HOST\ +IDX\  ]]; then
      k=hdr sec=$((sec + 1))
      [ -n "$hdr1" ] || hdr1="$line"
    fi
    text+=("$line") lkind+=("$k") lhost+=("$h") lname+=("$nm") lsec+=("$sec")
  done <<<"$1"
  # Which slot rows the filter and the text keep, and each one's sort key.
  for j in "${!lkind[@]}"; do
    [ "${lkind[$j]}" = slot ] || continue
    h="${lhost[$j]}" nm="${lname[$j]}"
    fact="${FW_FACT["$h"$'\t'"$nm"]-}"
    st="" prob="" since="" mem="" job=""
    [ -z "$fact" ] || IFS='|' read -r st prob since mem job <<<"$fact"
    ok=true
    case "$FW_FILTER" in
      busy) [[ "$st" == busy || "$st" == stalled ]] || ok=false ;;
      idle) [ "$st" = idle ] || ok=false ;;
      problems)
        if [ -n "$fact" ] && [ "$prob" != true ] && [ -z "${stale[$h]:-}" ]; then ok=false; fi ;;
    esac
    if $ok && [ -n "$want" ]; then
      s="${h,,}$nl${nm,,}$nl${job,,}"
      [[ "$s" == *"$want"* ]] || ok=false
    fi
    vis[j]="$ok"
    total[$h]=$((${total[$h]:-0} + 1))
    ! $ok || rows[$h]=$((${rows[$h]:-0} + 1))
    case "$FW_SORT" in
      job) keys[j]="${since:-99999999999}" ;;
      mem) if [ -n "$mem" ]; then keys[j]="-$mem"; else keys[j]=1; fi ;;
    esac
  done
  # The order the lines are taken in: the frame's own, or — sorted — each
  # column header, the rows under it by key, then everything else under it.
  if [ "$FW_SORT" = config ]; then
    order=("${!lkind[@]}")
  else
    for ((sc = 0; sc <= sec; sc++)); do
      list=""
      for j in "${!lkind[@]}"; do
        [ "${lsec[$j]}" = "$sc" ] || continue
        if [ "${lkind[$j]}" = hdr ]; then order+=("$j"); picked[$j]=1; continue; fi
        [ "${lkind[$j]}" = slot ] || continue
        "${vis[$j]}" || continue
        h="${lhost[$j]}"
        if $FW_COLLAPSE && [ -z "${FW_OPEN[$h]:-}" ]; then continue; fi
        list+="${keys[$j]} $j$nl"
      done
      if [ -n "$list" ]; then
        mapfile -t sorted < <(sort -n -k1,1 -k2,2 <<<"${list%"$nl"}")
        for line in "${sorted[@]}"; do order+=("${line#* }"); picked[${line#* }]=1; done
      fi
      for j in "${!lkind[@]}"; do
        [ "${lsec[$j]}" = "$sc" ] || continue
        [ -n "${picked[$j]:-}" ] || order+=("$j")
      done
    done
  fi
  FW_VIEW="" FW_ROWS=() FW_LINES=()
  for j in ${order[@]+"${order[@]}"}; do
    k="${lkind[$j]}" h="${lhost[$j]}"
    case "$k" in
      hdr)   pending="${text[$j]}"; continue ;;
      other) notes+=("${text[$j]}"); continue ;;
    esac
    hm=true
    [ -z "$want" ] || [[ "${h,,}" == *"$want"* ]] || hm=false
    # Whether this host has anything in the view beyond an error row.
    hs=false
    if [ "${rows[$h]:-0}" -gt 0 ]; then hs=true
    elif $hm && [ "$FW_FILTER" = problems ] && [ -n "${FW_HOSTBAD[$h]:-}" ]; then hs=true
    fi
    col=false
    if $FW_COLLAPSE && [ -z "${FW_OPEN[$h]:-}" ]; then col=true; fi
    ok=false out="" rk=""
    if [ "$k" = err ]; then
      if $hm && [[ "$FW_FILTER" == all || "$FW_FILTER" == problems ]]; then ok=true out="${text[$j]}" rk=down; fi
    elif $col; then
      # One line for the whole host, where its first line would have been: the
      # age line of a host that stopped answering, else its counts and what
      # its Disk/OOM line says.
      if $hs && [ -z "${emitted[$h]:-}" ]; then
        emitted[$h]=1 ok=true rk=host
        if [ -n "${stale[$h]:-}" ]; then
          out="${stale[$h]}"
        else
          s="${FW_HOSTSUM[$h]:-}"
          if [ -z "$s" ]; then
            s="${total[$h]:-0} slots"
            [ "${total[$h]:-0}" -ne 1 ] || s="1 slot"
          fi
          printf -v out '%-*s %s' "$hostw" "$h" "$s"
          [ -z "${info[$h]:-}" ] || out+=" · ${info[$h]}"
        fi
      fi
    elif [ "$k" = slot ]; then
      if "${vis[$j]}"; then ok=true out="${text[$j]}" rk=slot; fi
    elif $hs; then
      ok=true out="${text[$j]}"
    fi
    $ok || continue
    if [ -n "$pending" ]; then
      FW_VIEW+="${FW_VIEW:+$nl}$pending"
      n=$((n + 1)) pending=""
    fi
    FW_VIEW+="${FW_VIEW:+$nl}$out"
    n=$((n + 1)) shown=$((shown + 1))
    if [ -n "$rk" ]; then
      nm=""
      [ "$rk" != slot ] || nm="${lname[$j]}"
      FW_ROWS+=("$h"$'\t'"$nm") FW_LINES+=("$n") FW_KIND+=("$rk")
    fi
  done
  if [ "$shown" -eq 0 ]; then
    [ -z "$hdr1" ] || FW_VIEW="$hdr1"
    FW_VIEW+="${FW_VIEW:+$nl}${C_YELLOW}${FLEET_WATCH_EMPTY}${C_YELLOW:+$C_RESET}"
  fi
  for line in ${notes[@]+"${notes[@]}"}; do FW_VIEW+="$nl$line"; done
}

# --- Fleet watch detail pane (GHR-76) -------------------------------------------
# The local watch's pane (see pane_render), for the cursor's (host, slot) pair.
# What is particular to a fleet:
#
#   * IT READS WHAT THE TICK ALREADY BROUGHT. The pane is filled from the
#     host's last `status --json` payload in FW_STATE — the one the summary and
#     the views read — so opening it, scrolling it and leaving it ask no host
#     anything, and it refreshes when a tick's answer lands, like the table.
#     Not from a fresh read at the keypress, as the action keys make: a read
#     holds the keyboard for up to FLEET_WATCH_TIMEOUT on a host that has
#     stopped answering, which is exactly the host whose details are wanted,
#     and the pane is a view of the row that was on screen, not a decision.
#     An action key pressed IN the pane still decides on a fresh read, through
#     fleet_watch_slot_action — the same function, the same confirm line.
#   * A host that has stopped answering keeps its last payload, as it keeps its
#     rows: the pane shows those facts, with the age line the table draws over
#     the rows (`no answer for 45s — last seen …`) at the top of its Host
#     block, and the rest of what ssh said under it.
#   * A slot that is gone from its host's payload (scaled down) closes the
#     pane with a notice; the cursor then lands where fleet_watch_place puts
#     it. A host that has sent no payload yet gets a pane that says so.
#   * WHERE Enter LEADS depends on the row, and the three cannot meet:
#       a slot row          the slot's pane
#       a folded host       opens the fold (GHR-75), as before
#       a host's error row  that host's block alone, with the error in full
#     A host line (Disk/OOM) and the age line over kept rows are not rows the
#     cursor stops on, so a host's block is reached from any of its slots with
#     h, which switches the pane between the slot and its host.
#
# FW_MODE=pane, with FW_PANE saying which (`slot` or `host`) and FW_PANE_FROM
# what it was opened from (`slot` or `down`): a pane opened from an error row
# has no slot to switch back to or to act on.
FW_PANE="" FW_PANE_FROM=""

# The pane for the cursor's pair, into PANE_OUT. 1, with FW_NOTICE set, when
# the slot is no longer in its host's answer.
fleet_watch_pane_build() {
  local i at="" rc hl="" sl="" facts=false
  for i in "${!FLEET_HOSTS[@]}"; do
    if [ "${FLEET_HOSTS[$i]}" = "$FW_HOST" ]; then at="$i"; break; fi
  done
  if [ -n "$at" ] && [ -s "$FW_STATE/$at.json" ] && [ "$(cat "$FW_STATE/$at.jrc" 2>/dev/null || echo 255)" = 0 ]; then
    facts=true
    IFS= read -r hl <"$FW_STATE/$at.json" || true
    [[ "$hl" == '{"runnerctl":'* ]] || hl=""
    if [ "$FW_PANE" = slot ]; then
      sl="$(grep -F -m1 ",\"name\":$(json_str "$FW_NAME"),\"active\":" "$FW_STATE/$at.json" || true)"
      if [ -z "$sl" ]; then
        FW_NOTICE="$FW_NAME on $FW_HOST: no longer on that host — back to the table"
        return 1
      fi
    fi
  fi
  pane_from_json "$hl" "$sl"
  # The alias this node dials, and the host's own name where the two differ.
  PN[host]="$FW_HOST"
  [ -z "${PN[host_name]:-}" ] || [ "${PN[host_name]}" = "$FW_HOST" ] || PN[host]+=" (${PN[host_name]})"
  [ -n "${PN[name]}" ] || PN[name]="$FW_NAME"
  $facts || PN[facts]="none from that host yet — its 'status --json' has not answered"
  if [ -n "$at" ]; then
    rc="$(cat "$FW_STATE/$at.rc" 2>/dev/null || echo late)"
    if [ "$rc" != 0 ]; then
      if [ "$(fleet_reachable "$rc")" = false ] && [ -s "$FW_STATE/$at.seen" ]; then
        PN[answer_label]="answer"
        PN[answer]="$(FLEET_DIR="$FW_STATE" fleet_stale_line "$at" "$rc")"
      else
        PN[answer_label]="error"
        PN[answer]="$(fleet_error_text "$rc" "$FW_STATE/$at.err" "${FLEET_BUDGETS[$at]:-}")"
      fi
      # The table quotes the first line of what ssh said; here is the rest.
      [ ! -s "$FW_STATE/$at.err" ] || PN[stderr]="$(tail -n +2 "$FW_STATE/$at.err" | head -n 20)"
      # GHR-101: relayed text, whose only escapes are SGRs. The pane paints
      # its own rows, and the colours of a relayed line are not wanted in a
      # row, so they come off here, whole (pane_put would remove them whole too).
      strip_sgr "${PN[answer]}"; PN[answer]="$SGR_STRIPPED"
      strip_sgr "${PN[stderr]:-}"; PN[stderr]="$SGR_STRIPPED"
    fi
  fi
  if [ "$FW_PANE" = host ]; then
    pane_render host "$FW_HOST — host details"
  else
    pane_render slot "$FW_NAME on $FW_HOST — slot details"
  fi
}

# Enter, on the row the cursor is on. See the block above.
fleet_watch_enter() {
  [ "$FW_POS" -ge 0 ] || return 0
  case "${FW_KIND[$FW_POS]:-}" in
    host) fleet_watch_fold_key enter ;;
    slot) FW_MODE=pane FW_PANE=slot FW_PANE_FROM=slot; pane_enter ;;
    down) FW_MODE=pane FW_PANE=host FW_PANE_FROM=down; pane_enter ;;
  esac
}
fleet_watch_pane_close() {
  FW_MODE="" FW_PANE="" FW_PANE_FROM=""
  pane_leave
}
# A key while the pane is up: back to the table, the host block, the action
# keys on the pane's slot, the window. Nothing else — a view key pressed here
# must not rearrange a table nobody is looking at.
fleet_watch_pane_key() { # KEY
  case "$1" in
    esc|enter|q|Q) fleet_watch_pane_close ;;
    h)
      [ "$FW_PANE_FROM" = slot ] || return 0
      VIEW_TOP=0
      if [ "$FW_PANE" = slot ]; then FW_PANE=host; else FW_PANE=slot; fi ;;
    K|R|S|T|P|L|O)
      if [ "$FW_PANE" = slot ]; then
        fleet_watch_slot_action "$1" "$FW_HOST" "$FW_NAME"
      elif [ "$FW_PANE_FROM" = slot ]; then
        FW_NOTICE="$FW_HOST: $PANE_NO_SLOT_KEYS; h goes back to the slot"
      else
        FW_NOTICE="$FW_HOST: $PANE_NO_SLOT_KEYS, and this host is showing none"
      fi ;;
    *) pane_scroll "$1" || true ;;
  esac
}

# c: fold every host to one line; with the hosts folded, open or close the one
# the cursor is on. Enter opens a folded host; on any other row it is
# fleet_watch_enter's (GHR-76's detail pane), and the two cannot meet: a
# folded host has no slot row for the cursor to be on.
fleet_watch_fold_key() { # c|enter
  if [ "$1" = enter ]; then
    if $FW_COLLAPSE && [ "$FW_POS" -ge 0 ] && [ "${FW_KIND[$FW_POS]:-}" = host ]; then FW_OPEN[$FW_HOST]=1; fi
    return 0
  fi
  if ! $FW_COLLAPSE; then
    FW_COLLAPSE=true FW_OPEN=()
  elif [ "$FW_POS" -ge 0 ] && [ -n "$FW_HOST" ]; then
    if [ -n "${FW_OPEN[$FW_HOST]:-}" ]; then FW_OPEN[$FW_HOST]=""; else FW_OPEN[$FW_HOST]=1; fi
  fi
}

# A key while the / text is being typed. The text filters as it is typed —
# every key is a redraw of the frame in hand, like any other — so there is no
# second read loop here to starve the background fetches or a resize: the
# watch's own key read brings each character. Enter keeps the text, Esc puts
# back what was there before, Backspace takes a character and Ctrl-U all of
# them; an empty text matches everything, which is how it is cleared (as `a`
# clears it). Every other key that is one printable character is text, `q`
# and the view keys included; arrows and the paging keys are ignored.
fleet_watch_search_key() { # KEY
  case "$1" in
    enter) FW_MODE="" ;;
    esc)   FW_SEARCH="$FW_SEARCH_WAS" FW_MODE="" ;;
    $'\x7f'|$'\b') FW_SEARCH="${FW_SEARCH%?}" ;;
    $'\x15') FW_SEARCH="" ;;
    ?) if [[ "$1" == [[:print:]] ]]; then FW_SEARCH+="$1"; fi ;;
  esac
}

# PgUp/PgDn and g/G (GHR-73). A page is measured in FRAME LINES, not rows: a
# host's Disk/OOM line and the notes take window rows too, so a step counted
# in rows would jump further than a screenful and skip slots nobody saw. The
# cursor lands on the furthest row within a page of where it was, and always
# moves at least one row while there is one to move to.
fleet_watch_page() { # KEY
  local n="${#FW_ROWS[@]}" i="$FW_POS" want
  if [ "$n" -eq 0 ] || [ "$i" -lt 0 ]; then return 0; fi
  viewport_step "${FW_LINES[$((n - 1))]}"
  case "$1" in
    pgdn)
      want=$((FW_LINES[i] + VIEW_STEP))
      while [ "$i" -lt $((n - 1)) ] && [ "${FW_LINES[$((i + 1))]}" -le "$want" ]; do i=$((i + 1)); done
      [ "$i" -gt "$FW_POS" ] || [ "$i" -ge $((n - 1)) ] || i=$((i + 1)) ;;
    pgup)
      want=$((FW_LINES[i] - VIEW_STEP))
      while [ "$i" -gt 0 ] && [ "${FW_LINES[$((i - 1))]}" -ge "$want" ]; do i=$((i - 1)); done
      [ "$i" -lt "$FW_POS" ] || [ "$i" -le 0 ] || i=$((i - 1)) ;;
    g|home) i=0 ;;
    *)      i=$((n - 1)) ;;
  esac
  fleet_watch_select "$i"
}

# --- Fleet watch: the `:` command prompt (GHR-86) ------------------------------
# The keys are a fixed set; the fleet layer is not. `:` reads one line at the
# bottom of the view — a fleet subcommand and its flags, `scale 3`, `apply
# --profile ci --restart --when-idle`, `health` — and runs it through cmd_fleet,
# the command line's own code path, without leaving the view (or the held ssh
# connections, which the command reuses).
#
#   * THE LINE IS SPLIT HERE, on blanks, and never handed to a shell: no
#     quoting, no expansion, every other character is literal. The words go to
#     cmd_fleet as an argv, and what it forwards to a host is %q'd for the
#     remote shell (cmd_fleet_run), so a word reaches the host's runnerctl as
#     the one literal argument it was here.
#   * THE SCOPE is explicit, and shown before anything runs: the host under the
#     cursor; the hosts of the marked rows while any are marked (GHR-129); every
#     watched host with a `%` in front (`:%health`) — which on a watch narrowed
#     with --host names each of them, and on an unnarrowed one adds nothing, so
#     the command is exactly the one the command line would run. A --host or
#     --all-hosts typed in the line is the scope as typed. `fleet status` and
#     `fleet health` take no --host: they are run on the scope's hosts, and the
#     line says which.
#   * A READ — status, health, history, upgrade --check, reap --dry-run — runs
#     at once and its output opens in the pager, as L's does. Anything else
#     asks first: `runs: runnerctl fleet scale 3 --host build-1  [y/n]`, the
#     command fully expanded, and only `y` runs it.
#   * IT RUNS IN A SUBSHELL (fleet_watch_cmd_sub), as watch_run_action runs the
#     local watch's keys: cmd_fleet `die`s on a refusal — the capacity gate,
#     the budget flags, the excluded commands (env-init, provision,
#     deprovision, logs), an unknown one — and outside a subshell that would
#     end the watch. Here the refusal's own words are the notice.
#   * A COMMAND THAT CHANGES HOSTS RUNS IN THE BACKGROUND (GHR-144), as an
#     action key's does (GHR-125): the subshell is a job writing its lines to
#     a file and its exit status last, the ticks keep coming and the keys keep
#     working, the latest line it wrote is a progress line under the table,
#     and Esc detaches — nothing is signalled. When it ends its last line is
#     the notice, its output (more than one line) opens in the pager — once no
#     confirm line or / text is up — and the table is fetched again. A
#     detached one's notice still comes; its output is not paged, and the
#     notice says how many lines that was. The record is cmd_fleet's own, as
#     on the command line.
#   * IT HOLDS EVERY HOST IT TARGETS, not one slot for the fleet: each of
#     them is busy for any other action key (fleet_watch_act_refuse) until it
#     ends, exactly as if each had an action of its own out, and a host it
#     does not name is not. A command whose line names no host (`%` on an
#     unnarrowed watch, or a --host typed in the line) holds every watched
#     host. One `:` command is out at a time — its output is one file — so a
#     second, on hosts it does not hold, is refused in words of its own.
#   * The lines entered are kept for the session; ↑ ↓ in the prompt walk them.
#     Esc, or an empty line, cancels.
FW_CMD_HIST=() FW_CMD_ARGV=() FW_CMD_SHOWN="" FW_HOSTS_NARROWED=false
FW_CMD_ON=() FW_CMD_PID="" FW_CMD_JOB="" FW_CMD_HOSTS=() FW_CMD_DETACHED="" FW_CMD_LINE="" FW_CMD_PAGE=""

# ARGV as a command line, each word %q'd (so a word with a blank or a control
# byte in it is shown as what it is), into CMD_WORDS.
CMD_WORDS=""
fleet_watch_cmd_words() { # WORD...
  local w q
  CMD_WORDS=""
  for w in "$@"; do printf -v q %q "$w"; CMD_WORDS+="${CMD_WORDS:+ }$q"; done
}

# Whether SUBCOMMAND WORDS... only reads, and so runs without a confirm.
fleet_watch_cmd_reads() { # SUBCOMMAND [WORD...]
  local sub="$1" a check=false
  shift
  case "$sub" in
    status|history) return 0 ;;
    health)
      for a in "$@"; do [ "$a" != --restart-stalled ] || return 1; done
      return 0 ;;
    upgrade)
      for a in "$@"; do
        case "$a" in --check) check=true ;; --push|--rollback) return 1 ;; esac
      done
      $check ;;
    reap)
      for a in "$@"; do [ "$a" != --dry-run ] || return 0; done
      return 1 ;;
    # GHR-87: compose-reap is a dry run unless --apply, and the timer's
    # status a one-line read per host.
    compose-reap)
      for a in "$@"; do [ "$a" != --apply ] || return 1; done
      return 0 ;;
    compose-reap-timer)
      for a in "$@"; do
        case "$a" in install|remove) return 1 ;; esac
      done
      return 0 ;;
    *) return 1 ;;
  esac
}

# `:` — read the line, work out the scope, and run a read, refuse, or put up
# the confirm line (FW_ACTION=cmd).
fleet_watch_cmd_key() {
  local pct=false explicit=false sub w h n
  local -a words=() hosts=() argv=() on=()
  FW_NOTICE="" FW_PROMPT="" FW_ACTION="" FW_ACT_SCOPE=slot
  term_cursor show
  tty_read_line ":" ${FW_CMD_HIST[@]+"${FW_CMD_HIST[@]}"} || LINE_TEXT=""
  term_cursor hide
  IFS=$' \t' read -r -a words <<<"$LINE_TEXT" || true
  n="${#FW_CMD_HIST[@]}"
  if [ "${#words[@]}" -gt 0 ] && { [ "$n" -eq 0 ] || [ "${FW_CMD_HIST[$((n - 1))]}" != "$LINE_TEXT" ]; }; then
    FW_CMD_HIST+=("$LINE_TEXT")
  fi
  if [ "${#words[@]}" -gt 0 ] && [[ "${words[0]}" == %* ]]; then
    pct=true words[0]="${words[0]#%}"
    [ -n "${words[0]}" ] || words=("${words[@]:1}")
  fi
  if [ "${#words[@]}" -eq 0 ]; then FW_NOTICE="cancelled — nothing run"; return 0; fi
  sub="${words[0]}"
  case "$sub" in
    watch)
      FW_NOTICE=":watch — this is fleet watch already; nothing run"
      return 0 ;;
    status|health|history|upgrade|apply|scale|start|stop|restart|drain|kill|reap|remove-limits|enable|disable|compose-reap|compose-reap-timer) ;;
    *)
      # A command no host is asked to run: one fleet mode excludes for good
      # (env-init, provision, deprovision, logs) or a word it does not know.
      # cmd_fleet refuses each before anything is dialled, in its own words,
      # and those are what the notice says.
      FW_CMD_ARGV=("${words[@]}")
      fleet_watch_cmd_words "${words[@]}"
      FW_CMD_SHOWN="runnerctl fleet $CMD_WORDS"
      fleet_watch_cmd_exec refused
      return 0 ;;
  esac
  for w in "${words[@]:1}"; do
    case "$w" in
      --host|--host=*|--all-hosts) explicit=true ;;
      # The JSON stream never ends, and the view would be its until it did.
      --watch|-w)
        if [ "$sub" = status ]; then
          FW_NOTICE=":status $w is a stream that does not end — run 'runnerctl fleet status --json --watch' outside the watch; nothing run"
          return 0
        fi ;;
    esac
  done
  if $explicit; then
    :
  elif $pct; then
    ! $FW_HOSTS_NARROWED || hosts=("${FLEET_HOSTS[@]}")
  elif fleet_watch_marks_on; then
    fleet_watch_marked_hosts
    hosts=("${SET_HOSTS[@]}")
  elif [ "$FW_POS" -ge 0 ] && [ -n "$FW_HOST" ]; then
    hosts=("$FW_HOST")
  else
    FW_NOTICE="no host under the cursor — : runs on the cursor's host, the marked rows' hosts, or with % every watched host; nothing run"
    return 0
  fi
  argv=("${words[@]}")
  for h in ${hosts[@]+"${hosts[@]}"}; do argv+=(--host "$h"); done
  FW_CMD_ARGV=("${argv[@]}")
  fleet_watch_cmd_words "${argv[@]}"
  FW_CMD_SHOWN="runnerctl fleet $CMD_WORDS"
  if fleet_watch_cmd_reads "${words[@]}"; then
    fleet_watch_cmd_exec read
    return 0
  fi
  # One action per host (GHR-125): a host with one out is not handed another.
  on=(${hosts[@]+"${hosts[@]}"})
  [ "${#on[@]}" -gt 0 ] || on=("${FLEET_HOSTS[@]}")
  for h in "${on[@]}"; do
    ! fleet_watch_act_refuse "$h" || return 0
  done
  # GHR-144: one `:` command out at a time, wherever it runs.
  if [ -n "$FW_CMD_PID" ]; then
    FW_NOTICE="busy — '${FW_CMD_JOB#runnerctl }' is still running${FW_CMD_DETACHED:+ (detached)}; one : command at a time, nothing issued"
    return 0
  fi
  FW_CMD_ON=("${on[@]}")
  FW_ACTION=cmd FW_ACT_SCOPE=cmd
  FW_PROMPT="runs: $FW_CMD_SHOWN  [y/n]"
}

# The command itself — in a subshell, which is the point: a `die` in cmd_fleet
# ends this and not the watch. Everything a one-shot fleet command starts from
# that the watch changed for itself is put back: a fan-out's EXIT trap and
# budgets are its own, there is no optional --narrow, and the remote paints
# nothing the pager would show as escapes.
fleet_watch_cmd_sub() (
  FLEET_EXIT_OWNED=false FLEET_BUDGETS=() FLEET_OPTIONAL_ARGS="" FLEET_REMOTE_COLOR=false FLEET_DIR=""
  cmd_fleet "${FW_CMD_ARGV[@]}"
)

# The output in FILE, of the command SHOWN that exited RC: its last non-empty
# line made safe — or, with none, a line saying so — into CMD_NOTICE, and its
# non-empty line count into CMD_LINES. More than one line is written to
# FW_TMP/cmd under a first line naming the command, for the pager: a read asks
# no confirm, so the pager is where its scope is shown.
CMD_NOTICE="" CMD_LINES=0
fleet_watch_cmd_result() { # FILE SHOWN RC
  local line tail_line=""
  CMD_LINES=0
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    CMD_LINES=$((CMD_LINES + 1)) tail_line="$line"
  done <"$1"
  relay_safe "$tail_line" plain
  CMD_NOTICE="${RELAY_SAFE:-${2#runnerctl }: no output (exit $3)}"
  [ "$CMD_LINES" -le 1 ] || { printf 'ran: %s\n\n' "$2"; cat "$1"; } >"$FW_TMP/cmd"
}

# Run FW_CMD_ARGV at once: KIND is `read` (into the pager) or `refused` (a
# refusal: the notice alone). A command that changes hosts is not run here but
# by fleet_watch_cmd_start, in the background.
fleet_watch_cmd_exec() { # read|refused
  local out="$FW_TMP/cmd" rc=0
  FW_ACTION="" FW_PROMPT="" FW_ACT_SCOPE=slot
  term_cursor show
  fleet_watch_cmd_sub </dev/null >"$out.run" 2>&1 || rc=$?
  fleet_watch_cmd_result "$out.run" "$FW_CMD_SHOWN" "$rc"
  FW_NOTICE="$CMD_NOTICE"
  [ "$CMD_LINES" -le 1 ] || page <"$out"
  term_cursor hide
}

# GHR-144: y at a `:` command's confirm. The job is the same subshell, its
# stdout and stderr into FW_TMP/cmd.job/out and its exit status into `rc`
# LAST; it holds FW_CMD_ON — the hosts the confirm was raised for — until it
# ends.
fleet_watch_cmd_start() {
  local d="$FW_TMP/cmd.job" h
  FW_ACTION="" FW_PROMPT="" FW_ACT_SCOPE=slot
  # Nothing can have started between the confirm and its y; checked again
  # all the same, since the busy rule is the one thing this must not break.
  for h in ${FW_CMD_ON[@]+"${FW_CMD_ON[@]}"}; do
    ! fleet_watch_act_refuse "$h" || return 0
  done
  rm -rf "$d"
  mkdir "$d"
  FW_CMD_JOB="$FW_CMD_SHOWN" FW_CMD_HOSTS=(${FW_CMD_ON[@]+"${FW_CMD_ON[@]}"})
  FW_CMD_DETACHED="" FW_CMD_LINE="" FW_CMD_PAGE=""
  fleet_watch_cmd_job "$d" </dev/null >/dev/null 2>&1 &
  FW_CMD_PID="$!"
  FW_ACT_LAUNCHED=true
}
fleet_watch_cmd_job() { # DIR
  local rc=0
  # GHR-162: a worker, ended as an action's job is.
  builtin trap '' INT QUIT
  fleet_watch_cmd_sub >"$1/out" 2>&1 || rc=$?
  # GHR-150: as an action's job (fleet_watch_act_job) does.
  echo "$FLEET_OPTIONAL_REJECTED" >"$1/rejected"
  echo "$rc" >"$1/rc.new"
  mv -f "$1/rc.new" "$1/rc"
}

# Whether HOST is one the running `:` command holds.
fleet_watch_cmd_holds() { # HOST
  local h
  [ -n "$FW_CMD_PID" ] || return 1
  for h in ${FW_CMD_HOSTS[@]+"${FW_CMD_HOSTS[@]}"}; do [ "$h" != "$1" ] || return 0; done
  return 1
}

# The running command's line, into FW_CMD_LINE; FW_ACT_DRAW when it changed.
fleet_watch_cmd_progress() {
  local s
  fleet_watch_act_last "$FW_TMP/cmd.job/out" plain
  s="${FW_CMD_JOB#runnerctl }: running${ACT_LAST:+ — $ACT_LAST}"
  [ "$s" = "$FW_CMD_LINE" ] || FW_CMD_LINE="$s" FW_ACT_DRAW=true
}

# Take in the `:` command if it has ended: 0 when it did. Its notice is the
# last line; its output waits in FW_CMD_PAGE for fleet_watch_cmd_page, unless
# it was detached. A job gone without its `rc` is an answer too.
fleet_watch_cmd_collect() {
  local d="$FW_TMP/cmd.job" rc
  [ -n "$FW_CMD_PID" ] || return 1
  if [ ! -e "$d/rc" ]; then
    if kill -0 "$FW_CMD_PID" 2>/dev/null; then
      [ -n "$FW_CMD_DETACHED" ] || fleet_watch_cmd_progress
      return 1
    fi
    if [ ! -e "$d/rc" ]; then
      echo 255 >"$d/rc"
      echo "the command ended without an answer" >>"$d/out"
    fi
  fi
  rc="$(cat "$d/rc" 2>/dev/null || echo 255)"
  fleet_optional_learn "$d/rejected"
  fleet_watch_cmd_result "$d/out" "$FW_CMD_JOB" "$rc"
  if [ "$CMD_LINES" -gt 1 ] && [ -n "$FW_CMD_DETACHED" ]; then
    CMD_NOTICE+=" (detached: its $CMD_LINES lines of output were not paged)"
  elif [ "$CMD_LINES" -gt 1 ]; then
    FW_CMD_PAGE=1
  fi
  fleet_watch_act_notice "$CMD_NOTICE"
  FW_CMD_PID="" FW_CMD_HOSTS=() FW_CMD_DETACHED="" FW_CMD_LINE=""
  rm -rf "$d"
  return 0
}

# The ended command's output, into the pager — not while a confirm line or the
# / text is up, which the pager would take the keys from: it waits for them.
fleet_watch_cmd_page() {
  [ -n "$FW_CMD_PAGE" ] || return 1
  [ -z "$FW_PROMPT" ] && [ "$FW_MODE" != search ] || return 1
  FW_CMD_PAGE=""
  term_cursor show
  page <"$FW_TMP/cmd"
  term_cursor hide
}

# One key against the watch. Returns 1 on `q`. At a confirm only `y` runs it
# and anything else — `q` included — cancels, as in the local watch.
#
# GHR-75: the view keys only set what the next draw shows. None of them sets
# FW_REFRESH, so none of them costs a round trip. Any key closes the help
# (and is spent doing it — `q` there closes the help, not the watch), and
# while the / text is being typed every key belongs to it.
fleet_watch_handle_key() { # KEY
  local n="${#FW_ROWS[@]}"
  if [ "$FW_MODE" = help ]; then
    pane_scroll "$1" || { FW_MODE=""; pane_leave; }
    return 0
  fi
  if [ "$FW_MODE" = search ]; then fleet_watch_search_key "$1"; return 0; fi
  if [ -n "$FW_ACTION" ]; then
    FW_ACT_NOTICE=false
    case "$1" in
      y|Y) FW_NOTICE=""
           case "$FW_ACT_SCOPE" in
             host)    fleet_watch_run_host_action ;;
             upgrade) fleet_watch_run_upgrade ;;
             # GHR-129: the marked set — slot keys, host keys, U.
             set)        fleet_watch_run_set ;;
             hostset)    fleet_watch_run_set_hosts ;;
             upgradeset) fleet_watch_run_set_upgrade ;;
             # GHR-86: a mutating command from the `:` prompt.
             cmd)        fleet_watch_cmd_start ;;
             *)       fleet_watch_run_action ;;
           esac ;;
      # GHR-126: the graceful form, offered by R and S alone — not by a host
      # key (GHR-127), whose W is already the graceful restart.
      w)   case "$FW_ACT_SCOPE:$FW_ACTION" in
             slot:restart|slot:stop) FW_NOTICE=""; fleet_watch_run_action --when-idle ;;
             set:restart|set:stop)   FW_NOTICE=""; fleet_watch_run_set --when-idle ;;
             *)            FW_NOTICE="cancelled — nothing run"; FW_ACTION="" FW_PROMPT="" ;;
           esac ;;
      *)   FW_NOTICE="cancelled — nothing run"; FW_ACTION="" FW_PROMPT="" ;;
    esac
    # GHR-125: an action's notice that landed under the confirm line.
    if [ -n "$FW_ACT_HELD" ]; then
      FW_NOTICE="${FW_NOTICE:+$FW_NOTICE · }$FW_ACT_HELD" FW_ACT_HELD="" FW_ACT_NOTICE=true
    fi
    return 0
  fi
  FW_NOTICE="" FW_ACT_NOTICE=false
  # GHR-76: with the pane up every key is the pane's — `q` goes back to the
  # table rather than quitting, and no key moves the cursor or changes a view.
  if [ "$FW_MODE" = pane ]; then fleet_watch_pane_key "$1"; return 0; fi
  # GHR-118: likewise the history pane's.
  if [ "$FW_MODE" = history ]; then fleet_watch_hist_key "$1"; return 0; fi
  case "$1" in
    q|Q)    return 1 ;;
    down|j) [ "$FW_POS" -lt 0 ] || [ "$FW_POS" -ge $((n - 1)) ] || fleet_watch_select $((FW_POS + 1)) ;;
    up|k)   [ "$FW_POS" -le 0 ] || fleet_watch_select $((FW_POS - 1)) ;;
    pgdn|pgup|g|G|home|end) fleet_watch_page "$1" ;;
    # GHR-129: with rows marked, the action keys act on the marked set; L and
    # O stay the cursor's.
    K|R|S|T|P)
      if fleet_watch_marks_on; then fleet_watch_set_slot_key "$1"; else fleet_watch_key_action "$1"; fi ;;
    L|O) fleet_watch_key_action "$1" ;;
    # GHR-127: the host keys, on the host of whatever row the cursor is on.
    D|W|E|X)
      if fleet_watch_marks_on; then fleet_watch_set_host_key "$1"; else fleet_watch_host_key "$1"; fi ;;
    # GHR-128: upgrade the row's host, after an `upgrade --check`.
    U) if fleet_watch_marks_on; then fleet_watch_set_upgrade_key; else fleet_watch_upgrade_key; fi ;;
    # GHR-87: page the row's host's compose-reap dry run (a read, like L —
    # the cursor's host, marks or not).
    C) fleet_watch_compose_key ;;
    # GHR-118: the row's host's recent runnerctl records, in place of the table.
    H) fleet_watch_hist_open ;;
    # GHR-129: mark the row, every row the view shows, none.
    ' '|'*'|u) fleet_watch_mark_key "$1" ;;
    # GHR-125: Esc stops following an action; it never cancels one.
    esc) fleet_watch_act_detach ;;
    '!') FW_FILTER=problems ;;
    b)   FW_FILTER=busy ;;
    i)   FW_FILTER=idle ;;
    a)   FW_FILTER=all FW_SEARCH="" FW_COLLAPSE=false FW_OPEN=() ;;
    s)   case "$FW_SORT" in config) FW_SORT=job ;; job) FW_SORT=mem ;; *) FW_SORT=config ;; esac ;;
    c)     fleet_watch_fold_key c ;;
    enter) fleet_watch_enter ;;
    /)   FW_MODE=search FW_SEARCH_WAS="$FW_SEARCH" ;;
    '?') FW_MODE=help; pane_enter ;;
    # GHR-86: a fleet command, typed.
    :)   fleet_watch_cmd_key ;;
  esac
  return 0
}

cmd_fleet_watch() { # [--interval N] [--iterations N] [--host H] [--color WHEN] [--stall-after N] [--narrow] [--min-available K] [--problems] [--sort ORDER]
  local interval=5 iterations="" tick=0 header="" frame="" summary="" remote_color=never
  local narrow=false forced=false wide wide_last="" fetch=tick launched draw=false hl lead tail step left polling i
  local head legend status
  local -a hosts=() fwd=() narrow_arg=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then
      # --color is acted on at BOTH ends: the remote paints its cells and this
      # end paints the HOST column and the header. --stall-after is only
      # meaningful where the STALLED marker is DRAWN, which is the remote — so
      # it is forwarded, and without that it would be an accepted flag that
      # silently does nothing.
      [ "$1" != --stall-after ] || fwd+=(--stall-after "$2")
      shift "$VIEW_SHIFT"; continue
    fi
    case "$1" in
      --interval)
        need_val "$@"
        [[ "$2" =~ ^0*[1-9][0-9]*$ ]] || die "--interval value '$2' is invalid — want a whole number of seconds, at least 1"
        interval="$2"; shift 2 ;;
      --iterations)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--iterations value '$2' is invalid — want an integer"
        iterations="$2"; shift 2 ;;
      --host)
        need_val "$@"
        hosts+=("$2"); shift 2 ;;
      --narrow) narrow=true; forced=true; shift ;;
      # GHR-55: S's floor. A whole number of slots, not GHR-44's percentage:
      # it is checked one keypress at a time against what the watch can see.
      --min-available)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--min-available value '$2' is invalid — want a whole number of slots (0 turns the floor off)"
        FLEET_WATCH_MIN_AVAILABLE="$2"; shift 2 ;;
      # GHR-75: the view a watch STARTS in, for a wall display nobody is
      # going to press ! on. The keys change it from there as usual.
      --problems) FW_FILTER=problems; shift ;;
      --sort)
        need_val "$@"
        case "$2" in
          config|job|mem) FW_SORT="$2" ;;
          *) die "--sort value '$2' is invalid — want config (the hosts' own order), job (longest-running job first) or mem (most memory used first)" ;;
        esac
        shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  require_fleet
  # GHR-86: whether `%` (every watched host) is the fleet or a part of it.
  if [ "${#hosts[@]}" -gt 0 ]; then fleet_select_hosts "${hosts[@]}"; FW_HOSTS_NARROWED=true; fi
  stdout_is_tty || die "fleet watch needs a terminal (stdout is not a tty); use 'runnerctl fleet status'"
  # For the whole session, so a host that rejects --narrow or --with-json
  # (GHR-90) once is asked without it on every later tick instead of twice
  # per tick (fleet_watch_fetch_one). And --cpu-prev (GHR-115), the samples a
  # tick hands back to the host they came from.
  FLEET_OPTIONAL_ARGS="--narrow --with-json --cpu-prev"
  color_setup "$COLOR_MODE"
  # Whether the REMOTE paints is the same question as whether this end does:
  # under --color never a remote SGR sequence would be the one thing in the
  # frame that ignored the flag. C_RESET is set exactly when colour is on.
  if [ -n "$C_RESET" ]; then remote_color=always; FLEET_REMOTE_COLOR=true; fi
  # Comfortably more than the longest a master sits unused — the interval
  # between two ticks, and a call that runs to its budget in between — so one
  # is never expiring at the moment the next tick wants it.
  fleet_ssh_control_open "$((interval + FLEET_TIMEOUT + 30))"
  # Where the action keys buffer a remote's answer (facts, logs, output), and
  # where each host's last answer lives between ticks (GHR-74).
  FW_TMP="$(mktemp -d)"
  FW_STATE="$(mktemp -d)"
  # Ctrl-C exits 0 through the EXIT trap, which tears the session down either
  # way — the one trap of the session, armed once.
  FLEET_EXIT_OWNED=true
  trap fleet_watch_cleanup EXIT
  trap 'exit 0' INT TERM
  FW_INTERVAL="$interval" FW_DIRTY=true FW_PID=() FW_AGAIN=()
  FW_JSON_ARGS=(${fwd[@]+"${fwd[@]}"})
  for i in "${!FLEET_HOSTS[@]}"; do
    FW_PID[i]="" FW_AGAIN[i]=""
    # Every read the watch makes of this host is on the watch's budget: the
    # tick's calls and the floor's fan-out both take it from here.
    FLEET_BUDGETS[i]="$FLEET_WATCH_TIMEOUT"
    # Nobody has answered yet, which is not the same as being unreachable.
    echo late >"$FW_STATE/$i.rc"
  done
  term_cursor hide
  while :; do
    # A round per TICK, and after an action ended — not per key. Moving the
    # cursor, a confirm line or a refusal redraws the frame in hand: a round
    # trip to every host to move a highlight one row is the cost this command
    # exists to avoid.
    launched=false
    # GHR-125: an action just started is first looked at one FW_POLL on, as a
    # round's fetches are — a call that answers at once is then drawn with
    # its result, and the frame in hand is not redrawn in between.
    if $FW_ACT_LAUNCHED; then FW_ACT_LAUNCHED=false launched=true; fi
    if [ -n "$fetch" ]; then
      narrow_arg=()
      ! $narrow || narrow_arg=(--narrow)
      FW_TABLE_ARGS=(status --color "$remote_color" ${fwd[@]+"${fwd[@]}"} ${narrow_arg[@]+"${narrow_arg[@]}"} --with-json)
      fleet_watch_round "$fetch"
      fetch="" launched=true
      [ -z "$iterations" ] || fleet_watch_settle
    fi
    # Straight after a round is launched there is nothing new to take in or
    # draw: the first look is one FW_POLL later, when a host that answers
    # promptly already has — one frame per tick, not one per host.
    if ! $launched || [ -n "$iterations" ]; then
      fleet_watch_collect
      # GHR-125: an action that ended asks for a fresh round, and its notice
      # is drawn with what that round brings back — the action's effect.
      if fleet_watch_act_collect; then fetch=refresh; continue; fi
      if $FW_ACT_DRAW; then FW_ACT_DRAW=false draw=true; fi
      # GHR-144: an ended `:` command's output, once nothing holds the keys.
      if fleet_watch_cmd_page; then draw=true; fi
      # GHR-118: the history pane's read, once it has landed.
      if fleet_watch_hist_collect; then draw=true; fi
      if $FW_DIRTY; then
        FW_DIRTY=false draw=true
        # Unpainted: the view's name is added when the frame is drawn, since a
        # view key changes it without a new frame (GHR-75). The facts a view
        # reads are this frame's, and are read when a view first asks.
        header="runnerctl fleet watch — ${#FLEET_HOSTS[@]} host(s) — $(date +%H:%M:%S) — every ${interval}s (q to quit)"
        FW_FACTS_OK=false
        # A frame is rendered whatever the hosts said: a host that is not
        # answering is a row or its kept rows (fleet_status_table's own
        # contract), and the non-zero return is not a reason to stop watching
        # the ones that answered. FLEET_DIR is only lent to the renderers.
        FLEET_DIR="$FW_STATE"
        frame="$(fleet_status_table || true)"
        summary="$(fleet_summary_line)"
        FLEET_DIR=""
        # GHR-129: a marked slot its host no longer reports leaves the set.
        fleet_watch_mark_prune "$frame"
        # GHR-56: the local watch's narrowing, measured on the ASSEMBLED frame
        # — HOST column included, SGR stripped, error rows and notes not
        # counted — and acted on by asking the remotes for the narrow table on
        # the NEXT tick rather than fetching again now: a second round trip to
        # every host to redraw one frame is the cost this command exists to
        # avoid. The same hysteresis as the local watch, so a terminal near
        # the threshold does not flip the table on every tick. --narrow pins it.
        # GHR-157: what narrowing gave back is measured across the two ticks
        # — the last wide frame's width against the first narrow frame's —
        # since the two tables are never in hand together here.
        if ! $forced; then
          wide="$(watch_table_width "$frame" '[^ ]+ +')"
          if $narrow; then
            [ -n "$STATUS_NARROW_GAVE" ] || narrow_gave "${wide_last:-0}" "$wide"
          else
            wide_last="$wide"; STATUS_NARROW_GAVE=""
          fi
          if narrow_wanted "$narrow" "$wide" "$(term_cols)"; then narrow=true; else narrow=false; fi
        fi
      fi
    fi
    # GHR-75: the header names the view, so a filtered frame is never taken
    # for the fleet. With nothing chosen it is the header of before.
    if $draw || [ -n "$iterations" ]; then
      fleet_watch_view_name
      head="$(paint "$C_BOLD" "$header${FW_VIEW_NAME:+ — view: $FW_VIEW_NAME}")"
    fi
    if [ -n "$iterations" ]; then
      fleet_watch_view "$frame"
      printf '\033[H\033[2J%s\n%s\n%s\n' "$head" "$summary" "$FW_VIEW"
      pause "$interval"
      tick=$((tick + 1))
      [ "$tick" -lt "$iterations" ] || break
      fetch=tick
      continue
    fi
    # GHR-76: the pane is rebuilt from the payloads in hand on every draw, so a
    # tick's answer refreshes it as it refreshes the table. A slot that is no
    # longer in its host's answer closes it, and this draw is the table's.
    if $draw && ! $launched && [ "$FW_MODE" = pane ]; then
      if ! fleet_watch_pane_build; then
        # Whatever was being confirmed was about a slot that is not there.
        fleet_watch_pane_close
        FW_ACTION="" FW_PROMPT=""
      fi
    fi
    # GHR-125: a line per action being watched, between the body and the
    # legend — chrome, so a fitted frame's window is what gives way.
    if $draw && ! $launched; then fleet_watch_act_foot; fi
    if $draw && ! $launched && [ "$FW_MODE" = pane ]; then
      draw=false
      legend="$PANE_LEGEND_SLOT"
      if [ "$FW_PANE_FROM" = down ]; then legend="$PANE_LEGEND_DOWN"
      elif [ "$FW_PANE" = host ]; then legend="$PANE_LEGEND_HOST"
      fi
      viewport_draw "$head"$'\n'"$summary" "$PANE_OUT" \
        $'\n'"$FW_ACT_FOOT$(paint "$C_DIM" "$legend")"$'\n'"${FW_PROMPT:-$FW_NOTICE}" 0 0 0
    elif $draw && ! $launched && [ "$FW_MODE" = history ]; then
      # GHR-118: rebuilt on every draw, as the detail pane is.
      draw=false
      fleet_watch_hist_build
      legend="$FW_HIST_LEGEND_HOST"
      [ "$FW_HIST_SCOPE" = host ] || legend="$FW_HIST_LEGEND_FLEET"
      viewport_draw "$head"$'\n'"$summary" "$PANE_OUT" \
        $'\n'"$FW_ACT_FOOT$(paint "$C_DIM" "$legend")"$'\n'"${FW_PROMPT:-$FW_NOTICE}" 0 0 0
    elif $draw && ! $launched && [ "$FW_MODE" = help ]; then
      # GHR-75: the keys, where the table was, until a key. Chrome and all
      # through the viewport, so the terminal is left as any frame leaves it;
      # the fetches go on behind it and the next draw shows what they brought.
      draw=false
      viewport_draw "$head"$'\n'"$summary" "$FLEET_WATCH_HELP" \
        $'\n'"$FW_ACT_FOOT$(paint "$C_DIM" "$HELP_FOOT")"$'\n' 0 0 0
    elif $draw && ! $launched; then
      draw=false
      fleet_watch_view "$frame"
      fleet_watch_place
      # GHR-129: the marks' gutter, while there are any.
      fleet_watch_gutter
      # GHR-73: fitted to the terminal's height where it is known, with the
      # summary line as fixed chrome beside the header. The cursor's group runs
      # from the line after the previous row — the host's Disk/OOM line (or the
      # age line over kept rows), where this is that host's first slot — and,
      # on the last row, down through the notes to the end of the frame.
      hl=0 lead=0 tail=0
      if [ "$FW_POS" -ge 0 ]; then
        hl="${FW_LINES[$FW_POS]}" lead=1 tail="${FW_LINES[$FW_POS]}"
        [ "$FW_POS" -eq 0 ] || lead=$((FW_LINES[FW_POS - 1] + 1))
        [ "$FW_POS" -lt $((${#FW_ROWS[@]} - 1)) ] || tail="$VIEW_END"
      fi
      # The legend is the one of before unless a view is on, when it also
      # names the two keys that lead out of it; the status line is the text
      # being typed while / is open.
      fleet_watch_legend "${#FW_MARKS[@]}"
      legend="$FW_LEGEND" status="${FW_PROMPT:-$FW_NOTICE}"
      [ "$FW_MODE" != search ] || status="filter: /${FW_SEARCH}_ — Enter keeps it, Esc cancels, an empty one matches everything"
      viewport_draw "$head"$'\n'"$summary" "$(fleet_watch_highlight "$FW_VIEW" "$hl")" \
        $'\n'"$FW_ACT_FOOT$(paint "$C_DIM" "$legend")"$'\n'"$status" "$hl" "$lead" "$tail"
    fi
    # GHR-74: the wait is the key read, always. A step while a call is out,
    # so an answer is drawn soon after it lands; what is left of the interval
    # otherwise. The interval running out is a tick; a step running out is one
    # only when the clock says the interval has gone by as well.
    polling=false
    # GHR-125: an action out is polled for as a fetch is — its lines and its
    # end are drawn within a step of arriving.
    if fleet_watch_busy || fleet_watch_act_out || fleet_watch_hist_out; then
      polling=true step="$FW_POLL"
    else
      left=$((FW_NEXT - $(now_ms)))
      if [ "$left" -le 0 ]; then fetch=tick; continue; fi
      step="$(ms_to_secs "$left")"
    fi
    if viewport_read_key "$step"; then
      FW_REFRESH=false
      fleet_watch_handle_key "$KEY" || break
      draw=true
      ! $FW_REFRESH || fetch=refresh
    elif ! $polling || [ "$(now_ms)" -ge "$FW_NEXT" ]; then
      fetch=tick
    fi
  done
}

cmd_profiles() {
  local p
  echo "Config: $CONFIG_FILE$([ -f "$CONFIG_FILE" ] || echo ' (not present — built-ins only)')"
  echo
  printf '%-12s %-9s %-6s %-6s %-8s %-30s %s\n' PROFILE SOURCE MAX HIGH RESTART ENVFILE DESCRIPTION
  for p in $(list_profiles); do
    PROFILE="$p"; PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="10"; ENV_FILE=""  # same defaults as the top of the script
    local src="builtin"; declare -F "profile_$p" >/dev/null && src="config"
    load_profile
    printf '%-12s %-9s %-6s %-6s %-8s %-30s %s\n' \
      "$p$([ "$p" = "$DEFAULT_PROFILE" ] && echo '*')" "$src" "${MEM_MAX:--}" "${MEM_HIGH:--}" \
      "${RESTART_SEC:--}" "${ENV_FILE:--}" "$PROFILE_DESC"
  done
  echo
  echo "* = default profile"
}

# --- Provisioning: making the runner units exist (GHR-45) --------------------
# Everything above this point manages runners that are ALREADY registered, and
# `install` installs THIS SCRIPT — so on a new box every command dead-ended in
# require_runners' refusal and the first step was an undocumented manual loop.
# `provision N` closes that gap: it fetches GitHub's runner release, unpacks a
# copy per slot under $RUNNER_ROOT, registers each with the runner's own
# `config.sh` as the runner user, and writes the systemd unit `svc.sh install`
# would have written (render_runner_unit, below). The units are therefore
# exactly the ones the rest of this tool already knows how to manage through
# drop-ins, and the same file a host provisioned by svc.sh carries.
#
# GHR-110: it used to run `./svc.sh install` / `start` (and deprovision
# `./svc.sh stop` / `uninstall`) as ROOT from the runner's directory — which
# the runner user owns, and the runner user is what every job runs as. svc.sh
# also sources ./env.sh. So any job could rewrite either and have the next
# provision or deprovision on the host run it as uid 0. Nothing in a runner's
# directory is executed as root any more: root writes the unit, runs
# systemctl, unpacks, chowns and deletes; the runner's own scripts run as the
# runner user only (runner_exec refuses uid 0 outright).
#
# It is idempotent against a TARGET COUNT, like `scale`: slots that exist are
# left alone, so `provision 4` on a host with 2 adds two and `provision 2` on
# a host with 4 changes nothing. It never removes a runner: that is
# `deprovision` (GHR-46), below.

valid_user_name() { [[ "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]; }
valid_runner_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_runner_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
valid_runner_url() { [[ "$1" =~ ^https?://[^/]+/[^/]+(/[^/]+)?/?$ ]]; }

# uname -m -> the architecture in GitHub's runner asset names. Refusing here
# beats a 404 on a download URL built from a name GitHub never published.
runner_arch() {
  case "$(uname -m)" in
    x86_64|amd64)       echo x64 ;;
    aarch64|arm64)      echo arm64 ;;
    armv7l|armv7l*|armhf) echo arm ;;
    *) die "unsupported architecture '$(uname -m)' — GitHub publishes Linux runners for x86_64, aarch64 and armv7l only" ;;
  esac
}

# The URL decides which API path mints a token and what GitHub calls the
# scope. Prints "<kind> <api-path>", e.g. "org orgs/acme".
runner_scope() { # URL
  local u="${1%/}" rest
  [[ "$u" =~ ^https?://[^/]+/(.+)$ ]] || die "--url '$1' is not a GitHub URL — want https://github.com/<org>, .../<org>/<repo>, or .../enterprises/<slug>"
  rest="${BASH_REMATCH[1]}"
  case "$rest" in
    enterprises/*/*) die "--url '$1' has too many path segments for an enterprise — want .../enterprises/<slug>" ;;
    enterprises/*)   echo "enterprise enterprises/${rest#enterprises/}" ;;
    */*/*)           die "--url '$1' has too many path segments — want <org> or <org>/<repo>" ;;
    */*)             echo "repo repos/$rest" ;;
    *)               echo "org orgs/$rest" ;;
  esac
}

# Every outbound HTTP call goes through here, so a config can stub the network
# (tests/stub.config does) and so a PAT is handed to curl on STDIN through its
# own config format rather than in argv — anything in argv is readable by any
# user on the box through /proc/<pid>/cmdline. Prints the response body.
http_api() { # METHOD URL [TOKEN]
  local method="$1" url="$2" token="${3:-}" cfg=""
  command -v curl >/dev/null || die "curl is required to talk to $url"
  [ -z "$token" ] || cfg="header = \"Authorization: Bearer $token\""
  printf '%s\n' "$cfg" | curl -fsSL --max-time 30 -K - -X "$method" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$url"
}

# First string value of NAME in the JSON on stdin. The API's objects put one
# field per line, which is all this needs — and all it promises: it is for
# pulling a known scalar out of a known response, not for parsing JSON.
json_field() { # NAME
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# The published SHA-256 of one release asset, from the release JSON in FILE.
# Two sources, in this order (both probed against the live API 2026-09-14, and
# they agreed on the same digest for actions-runner-linux-x64-2.337.0):
#   assets[].digest — "sha256:<hex>", structured metadata, what GitHub
#                     publishes today and the one to trust;
#   the release body — <!-- BEGIN SHA linux-x64 --><hex><!-- END ... -->, the
#                     long-standing marker and the only one on releases that
#                     predate the digest field.
# Empty output means neither was there, which the caller refuses on rather
# than unpacking a tarball it cannot vouch for.
runner_release_sha() { # RELEASE-JSON-FILE ASSET-NAME ARCH
  local json="$1" asset="$2" arch="$3" sha
  sha="$(awk -v n="\"$asset\"" '
      index($0, "\"name\"") && index($0, n) { seen = 1; next }
      seen && index($0, "\"digest\"") {
        if (match($0, /sha256:[0-9a-f]+/)) print substr($0, RSTART + 7, RLENGTH - 7)
        exit
      }' "$json")"
  if [ -z "$sha" ]; then
    sha="$(grep -o "BEGIN SHA linux-$arch -->[0-9a-f]\{64\}" "$json" 2>/dev/null | head -1 | grep -o '[0-9a-f]\{64\}' || true)"
  fi
  printf '%s' "$sha"
}

# Download URL -> DEST. Separate from http_api because it is a large binary
# body with a much longer budget, and because a config stubs this one alone.
runner_fetch_tarball() { # URL DEST
  command -v curl >/dev/null || die "curl is required to download $1"
  curl -fsSL --max-time 600 "$1" -o "$2" || die "download failed: $1"
}

runner_sha256() { # FILE
  command -v sha256sum >/dev/null || die "sha256sum is required to verify the runner tarball (pass --no-verify-checksum to skip, at your own risk)"
  sha256sum "$1" | awk '{print $1}'
}

# Is USER uid 0? By name and by uid, so an alias of root (a second uid-0
# account) is caught too. A name that does not resolve is not root.
runner_user_is_root() { # USER
  [ "$1" = root ] && return 0
  local uid; uid="$(id -u -- "$1" 2>/dev/null || true)"
  [ "$uid" = 0 ]
}

# Run CMD... from DIR as USER — never as root (GHR-110). Everything in a
# runner's directory is writable by the runner user, which is the account
# every job runs as, so a file there run as root is a job's code run as root.
# GitHub's config.sh sources ./env.sh relative to the WORKING DIRECTORY, so
# it only works from the runner's own directory, and `runuser` has no --chdir
# of its own (probed, util-linux on the dev box) — hence the explicit cd in
# the shell it starts. Goes through run_priv like every other host mutation,
# so the harness sees it.
runner_exec() { # DIR USER CMD...
  local dir="$1" user="$2"; shift 2
  if runner_user_is_root "$user"; then
    echo "runnerctl: refusing to run '$*' in $dir as $user: everything in a runner's directory is writable by the account jobs run as, so runnerctl never runs it as root" >&2
    return 1
  fi
  # SC2016 is the point: the $1/$@ below belong to the inner bash, which gets
  # the directory and the command as its own arguments rather than having them
  # pasted into a string this shell expanded.
  # shellcheck disable=SC2016
  run_priv runuser -u "$user" -- bash -c 'cd "$1" || exit 1; shift; exec "$@"' runnerctl "$dir" "$@"
}

# --- The runner's systemd unit, written by runnerctl (GHR-110) ---------------
# What `svc.sh install` does, read as data from actions/runner v2.338.0
# (commit 197ca027b90de199464dee3bb9ff198a1db60967), files
# src/Misc/layoutbin/systemd.svc.sh.template, actions.runner.service.template
# and runsvc.sh, and src/Runner.Listener/Configuration/
# {ServiceControlManager,SystemdControlManager}.cs. A runner release that
# changes any of them is a known thing to re-check against what is here:
#
#   name     config.sh writes it into svc.sh: actions.runner.<scope>.<name>.service,
#            <scope> being the URL's path (org, org/repo, enterprises/slug)
#            with every character outside [0-9A-Za-z._-] made '-'. Past 150
#            characters it truncates and adds a RANDOM 4-digit suffix —
#            runner_unit_name refuses that length instead of guessing.
#   install  refuses if /etc/systemd/system/<name> exists; renders the template
#            (Description, User, RunnerRoot = its working directory) into it;
#            restorecon under enforcing SELinux; chmod 664; daemon-reload;
#            copies bin/runsvc.sh to ./runsvc.sh, owned by the user, mode 755;
#            systemctl enable <name>; writes <name> to ./.service, owned by
#            the user.
#   start    systemctl start <name>.   stop  systemctl stop <name>.
#   uninstall  stop, systemctl disable <name>, rm the unit file, rm
#            ./.service, daemon-reload.
#
# The unit runs ExecStart=<dir>/runsvc.sh as User=<the runner user> — systemd
# drops to that user before exec, so a runner-owned runsvc.sh is run with the
# runner's own privileges, which is what it already has. The template has no
# ExecStartPre/ExecStartPost/ExecStop/ExecReload, and ExecStart carries no
# '+' or '!' prefix (either would run it with full privileges); the drop-in
# `apply` adds has no Exec line at all. runner_unit_root_exec_problem below is
# the check the sim pins that on.
#
# Differences from svc.sh, each deliberate: the unit is 0644 root:root rather
# than 664 (nothing but root needs to write it); runsvc.sh and .service are
# written AS THE RUNNER USER rather than by root and then chowned (the result
# is the same file with the same owner, and root never writes through a path
# inside a directory the runner user controls); restorecon is not run — svc.sh
# needed it because it rendered the unit in the runner's directory and `mv`ed
# it, which keeps the source's SELinux label, while runnerctl creates the file
# in SYSTEMD_DIR, so it takes that directory's default label (not verified on
# an SELinux host).
#
# .service: the runner reads it in one place — `config.sh remove` refuses
# with "Uninstall service first" while it exists (ConfigurationStore.
# IsServiceConfigured) — so it is written, to keep that guard for an operator
# running config.sh by hand, and deprovision removes it before config.sh
# remove. Nothing in runnerctl reads it.

# A path written into a unit as WorkingDirectory= and ExecStart=: absolute,
# no '.' or '..' segment, and only characters that mean nothing to systemd —
# no whitespace, quote, '%' specifier, '\' escape, ';' or newline, any of
# which would change what the line says or start a new one.
valid_unit_path() { # PATH
  [[ "$1" =~ ^(/[A-Za-z0-9._-]+)+$ ]] || return 1
  [[ "$1/" != */./* && "$1/" != */../* ]]
}

# The unit name config.sh computes for URL and RUNNER-NAME, printed; or a
# reason on stderr and 1 when runnerctl will not write one.
runner_unit_name() { # URL RUNNER-NAME
  local path="${1%/}" scope unit
  path="${path#*://}"; path="${path#*/}"
  scope="$(LC_ALL=C; printf '%s' "${path//[^0-9A-Za-z._-]/-}")"
  unit="actions.runner.$scope.$2.service"
  if ! [[ "$unit" =~ ^actions\.runner\.[A-Za-z0-9._-]+\.service$ ]] || ! valid_runner_name "$2"; then
    echo "runnerctl: cannot name a unit for runner '$2' at '$1'" >&2; return 1
  fi
  if [ "${#unit}" -gt 150 ]; then
    echo "runnerctl: the unit name $unit is ${#unit} characters; the runner truncates names past 150 with a random suffix, which runnerctl cannot predict — pass a shorter --name-prefix" >&2
    return 1
  fi
  printf '%s\n' "$unit"
}

# The unit text `svc.sh install` would write for UNIT, DIR and USER — byte for
# byte actions.runner.service.template with its three values filled in, so a
# unit runnerctl wrote and one svc.sh wrote are the same file. Every value is
# validated HERE, not only by the caller: a newline, '%' or ']' in any of them
# would write a directive of its own into a file systemd runs as root.
render_runner_unit() { # UNIT DIR USER
  local unit="$1" dir="$2" user="$3" desc
  [[ "$unit" =~ ^actions\.runner\.([A-Za-z0-9._-]+)\.service$ ]] || { echo "runnerctl: refusing to render a unit named '$unit'" >&2; return 1; }
  desc="${BASH_REMATCH[1]}"
  valid_unit_path "$dir" || { echo "runnerctl: refusing to render a unit for the directory '$dir' — want an absolute path of letters, digits, '.', '_' and '-'" >&2; return 1; }
  valid_user_name "$user" || { echo "runnerctl: refusing to render a unit for the user '$user'" >&2; return 1; }
  ! runner_user_is_root "$user" || { echo "runnerctl: refusing to render a unit that runs a runner as root" >&2; return 1; }
  cat <<UNIT
[Unit]
Description=GitHub Actions Runner ($desc)
After=network-online.target

[Service]
ExecStart=$dir/runsvc.sh
User=$user
WorkingDirectory=$dir
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
UNIT
}

# Why the unit text on stdin would run a file in DIR as root, or nothing. The
# audit the sim pins: a runner unit must run only as a non-root User=, with no
# privileged ExecStart prefix and no other Exec line — any Exec*= runs as
# User= too, but it is one edit away from a '+' and it has no business in a
# runner's unit, so its presence alone is the problem.
runner_unit_root_exec_problem() { # DIR  (unit text on stdin)
  local dir="$1" text user
  text="$(cat)"
  user="$(sed -n 's/^User=//p' <<<"$text" | tail -n 1)"
  if [ -z "$user" ] || runner_user_is_root "$user"; then echo "the unit runs as root (User='$user')"; return 0; fi
  if grep -Eq '^Exec(StartPre|StartPost|Stop|StopPost|Reload|Condition)=' <<<"$text"; then
    echo "the unit has an Exec line other than ExecStart: $(grep -E '^Exec' <<<"$text" | grep -v '^ExecStart=' | head -n 1)"; return 0
  fi
  if grep -Eq '^ExecStart=[-@:+!]*[+!]' <<<"$text"; then echo "ExecStart= runs with full privileges ('+' or '!')"; return 0; fi
  grep -Fxq "ExecStart=$dir/runsvc.sh" <<<"$text" || echo "ExecStart= is not $dir/runsvc.sh"
}

# Write UNIT for the runner in DIR, as svc.sh install would, then enable it.
# Root writes only the root-owned unit under SYSTEMD_DIR and runs systemctl;
# the two files that go into DIR are written by the runner user.
runner_unit_install() { # UNIT DIR USER
  local unit="$1" dir="$2" user="$3" text path="$SYSTEMD_DIR/$1" problem
  if [ -e "$path" ] || [ -L "$path" ]; then
    echo "  $path already exists — not overwriting a unit runnerctl did not just write" >&2; return 1
  fi
  text="$(render_runner_unit "$unit" "$dir" "$user")" || return 1
  problem="$(runner_unit_root_exec_problem "$dir" <<<"$text")"
  [ -z "$problem" ] || { echo "runnerctl: refusing to install $unit: $problem" >&2; return 1; }
  # Created empty with its final owner and mode first, so the text never sits
  # in a file with whatever mode root's umask would have given it.
  run_priv install -m 0644 -o root -g root /dev/null "$path" || return 1
  printf '%s\n' "$text" | run_priv tee "$path" >/dev/null || return 1
  runner_exec "$dir" "$user" install -m 0755 ./bin/runsvc.sh ./runsvc.sh || return 1
  hb_systemctl daemon-reload || return 1
  hb_systemctl enable "$unit" || return 1
  # SC2016: the $1 belongs to the inner bash, which takes the unit name as an
  # argument rather than having it pasted into the string.
  # shellcheck disable=SC2016
  runner_exec "$dir" "$user" bash -c 'printf "%s\n" "$1" >.service' runnerctl "$unit" || return 1
}

# Put a freshly unpacked runner at ROOT/NAME (GHR-116). Root unpacks and
# re-owns ONLY a tree it has just created inside a staging directory of its
# own, never a directory the runner user has owned:
#
#   ROOT/.NAME.provision.XXXXXXXX   mktemp -d: random name, created
#                                   exclusively, mode 0700 root — so no other
#                                   account can reach anything under it
#   STAGE/new                       mkdir (not -p): fails rather than reuse
#                                   anything already there
#   tar -C STAGE/new, chown -R STAGE/new
#   mv -T ROOT/NAME STAGE/old       only when ROOT/NAME exists (--replace)
#   mv -T STAGE/new ROOT/NAME
#   rm -rf -- STAGE                 the old tree, if any, with it
#
# Why: a slot directory --replace reuses belongs to the runner user, the
# account every job runs as, so it may hold symlinks a job left. GNU tar
# extracts THROUGH a symlink standing where a member's parent directory goes
# when the archive has no entry for that directory (measured, tar 1.35), so
# unpacking over such a tree writes outside it as root. chown -R and rm -rf
# do not follow symlinks below their argument (-P is chown -R's default), but
# nothing here relies on that for the unpack: the tree tar and chown see was
# created a moment ago by root, under a directory only root can enter. The
# old tree is only renamed (one directory entry, in root-owned ROOT) and then
# removed with rm -rf, which unlinks a symlink rather than following it.
# Nothing in the old tree is read, copied or kept: `config.sh --replace` takes
# the runner NAME over on GitHub's side and needs none of the old .runner,
# .credentials or _work.
#
# ROOT must be root-owned and not writable by the runner user, as provision's
# own `mkdir -p` leaves it; that is what keeps ROOT/NAME itself from being
# swapped. Prints nothing; returns non-zero with STAGE removed (and an old
# tree moved aside put back) on failure.
runner_unpack_slot() { # TARBALL ROOT NAME USER GROUP
  local tarball="$1" root="$2" name="$3" user="$4" group="$5"
  local dir="$2/$3" stage old=false
  stage="$(run_priv mktemp -d "$root/.$name.provision.XXXXXXXX")" || return 1
  # Exactly the template with its X's filled in, or nothing is touched.
  { [ "${stage%.*}" = "$root/.$name.provision" ] && [[ "${stage##*.}" =~ ^[A-Za-z0-9]{8}$ ]]; } || {
    echo "  mktemp answered '$stage', not a directory under $root — not unpacking" >&2; return 1
  }
  if ! { run_priv mkdir -m 0755 "$stage/new" \
         && run_priv tar -xzf "$tarball" -C "$stage/new" \
         && run_priv chown -R "$user:$group" "$stage/new"; }; then
    run_priv rm -rf -- "$stage" || true
    return 1
  fi
  if [ -e "$dir" ] || [ -L "$dir" ]; then
    run_priv mv -T -- "$dir" "$stage/old" || { run_priv rm -rf -- "$stage" || true; return 1; }
    old=true
  fi
  if ! run_priv mv -T -- "$stage/new" "$dir"; then
    if $old && ! run_priv mv -T -- "$stage/old" "$dir"; then
      echo "  the old $dir could not be put back; it is at $stage/old" >&2; return 1
    fi
    run_priv rm -rf -- "$stage" || true
    return 1
  fi
  run_priv rm -rf -- "$stage" || echo "  warning: could not remove $stage" >&2
}

# The three questions provision asks the host about accounts and tooling,
# each its own function so a config can answer them without the test box's
# own /etc/passwd or $PATH deciding what the fixture sees.
runner_user_exists() { id -u "$1" >/dev/null 2>&1; }
runner_group_exists() { getent group "$1" >/dev/null 2>&1; }
runner_have_gh() { command -v gh >/dev/null 2>&1; }

# The account the runner runs as. config.sh REFUSES to run as root, and a job
# that can write outside its own tree can rewrite the runner, so a dedicated
# unprivileged user is the default rather than the invoking one.
ensure_runner_user() { # USER GROUP DRY-RUN
  local user="$1" group="$2" dry="$3"
  if runner_user_exists "$user"; then
    echo "  user:    $user (exists)"
    return 0
  fi
  if $dry; then
    echo "  user:    $user (would be created as a system user)"
    return 0
  fi
  if [ -n "$group" ] && ! runner_group_exists "$group"; then
    run_priv groupadd --system "$group" || die "could not create group '$group'"
  fi
  local gopt=()
  [ -z "$group" ] || gopt=(-g "$group")
  # A real shell, not nologin: job steps run through it, and an operator
  # debugging a slot needs to be able to become this user.
  run_priv useradd --system --create-home --shell /bin/bash \
    --comment "GitHub Actions runner (runnerctl)" ${gopt+"${gopt[@]}"} "$user" \
    || die "could not create user '$user'"
  echo "  user:    $user (created)"
}

# A registration token, however the operator supplied the credentials. GitHub
# registration tokens last an hour and register any number of runners, so one
# is minted per RUN, not per slot.
runner_registration_token() { # API-PATH PAT
  runner_api_token "$1" "$2" registration
}

# The shared half of the registration token (provision) and the removal token
# (deprovision, GHR-46): the same three credential sources and the same scope
# path, differing only in the endpoint — .../registration-token or
# .../remove-token. KIND is `registration` or `removal`.
runner_api_token() { # API-PATH PAT KIND
  local path="$1" pat="$2" kind="$3" endpoint body tok
  case "$kind" in
    registration) endpoint=registration-token ;;
    *)            endpoint=remove-token ;;
  esac
  if [ -n "$pat" ]; then
    body="$(http_api POST "$RUNNER_API_URL/$path/actions/runners/$endpoint" "$pat")" \
      || die "could not mint a $kind token for $path — check the token's scope (a classic PAT needs 'repo' for a repo runner, 'admin:org' for an org one) and that it has not expired"
    tok="$(printf '%s' "$body" | json_field token)"
    [ -n "$tok" ] || die "the $endpoint response for $path carried no token"
    printf '%s' "$tok"
    return 0
  fi
  # gh already holds a login on plenty of boxes; --jq keeps the token off argv.
  runner_have_gh || die "no $kind token: pass --token <token from GitHub>, or --pat/\$GITHUB_TOKEN, or log in with the gh CLI"
  tok="$(gh api --method POST "$path/actions/runners/$endpoint" --jq .token 2>/dev/null)" \
    || die "gh could not mint a $kind token for $path — 'gh auth status' to check the login, or pass --token/--pat"
  [ -n "$tok" ] || die "gh returned no token for $path"
  printf '%s' "$tok"
}

provision_usage() {
  cat <<'PROVISION'
Usage: runnerctl provision N [options]

Installs and registers runner slots until this host has N of them, then hands
over to `scale`/`apply`. Existing slots are left alone; nothing is ever
deregistered — removing a runner for good is `runnerctl deprovision`.

  --url URL              org, repo or enterprise to register against, e.g.
                         https://github.com/acme or https://github.com/acme/app
                         (default: RUNNER_URL from the config file)
  --token TOKEN          a registration token from GitHub (Settings -> Actions
                         -> Runners -> New self-hosted runner). Valid 1 hour,
                         registers any number of runners.
  --pat TOKEN            a PAT to mint the registration token with, instead of
                         pasting one. Defaults to $GITHUB_TOKEN; with neither,
                         the gh CLI's login is used if it is present.
  --labels a,b           extra labels, on top of the ones the runner sets for
                         itself (self-hosted, OS, architecture)
  --runner-group NAME    GitHub runner group to register into (org/enterprise)
  --name-prefix NAME     runner names are <prefix>-<n> (default: the host's
                         short name)
  --runner-user USER     account the runners run as (default: github-runner,
                         created as a system user when missing)
  --runner-root DIR      one directory per slot under here (default:
                         /opt/actions-runner)
  --runner-version X.Y.Z pin the runner release (default: the latest)
  --sha256 SUM           expected SHA-256 of the tarball, instead of the one
                         published with the release
  --no-verify-checksum   install even when no published checksum can be found
  --work DIR             the runner's _work directory, relative to its own
  --replace              re-register a runner name GitHub already knows; a
                         directory left for that name is deleted and unpacked
                         afresh, not reused (nothing in it is kept)
  --dry-run              print what would happen; download and change nothing

Every value above except --token/--pat has a config-file default — see
`runnerctl config-example`.
PROVISION
}

cmd_provision() {
  local n="" url="$RUNNER_URL" token="" pat="${GITHUB_TOKEN:-}" labels="$RUNNER_LABELS"
  local root="$RUNNER_ROOT" user="$RUNNER_USER" group="$RUNNER_GROUP"
  local prefix="$RUNNER_NAME_PREFIX" version="$RUNNER_VERSION" work="$RUNNER_WORK"
  local rgroup="$RUNNER_GROUP_NAME" sha_pin="" verify=true dry_run=false replace=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)            provision_usage; return 0 ;;
      --url)                need_val "$@"; url="$2"; shift 2 ;;
      --token)              need_val "$@"; token="$2"; shift 2 ;;
      --pat)                need_val "$@"; pat="$2"; shift 2 ;;
      --labels)             need_val "$@"; labels="$2"; shift 2 ;;
      --runner-group)       need_val "$@"; rgroup="$2"; shift 2 ;;
      --name-prefix)        need_val "$@"; prefix="$2"; shift 2 ;;
      --runner-user)        need_val "$@"; user="$2"; shift 2 ;;
      --runner-root)        need_val "$@"; root="${2%/}"; shift 2 ;;
      --runner-version)     need_val "$@"; version="$2"; shift 2 ;;
      --sha256)             need_val "$@"; sha_pin="$2"; shift 2 ;;
      --no-verify-checksum) verify=false; shift ;;
      --work)               need_val "$@"; work="$2"; shift 2 ;;
      --replace)            replace=true; shift ;;
      --dry-run)            dry_run=true; shift ;;
      -*)                   die "unknown option: $1 ('runnerctl provision --help' lists them)" ;;
      *)                    [ -z "$n" ] || die "unexpected argument: $1"; n="$1"; shift ;;
    esac
  done

  [ -n "$n" ] || die "provision needs N, e.g. 'provision 2 --url https://github.com/<org>'"
  [[ "$n" =~ ^[0-9]+$ ]] || die "N must be an integer"
  # An upper bound because this registers real runners with GitHub: a slipped
  # digit should not be 400 registrations that then have to be removed by hand.
  { [ "$n" -ge 1 ] && [ "$n" -le 64 ]; } || die "N must be 1..64"
  [[ "$work" != /* && -n "$work" ]] || die "--work '$work' is invalid — want a path relative to the runner's own directory"
  [ -z "$sha_pin" ] || [[ "$sha_pin" =~ ^[0-9a-f]{64}$ ]] || die "--sha256 '$sha_pin' is invalid — want 64 lowercase hex characters"
  valid_user_name "$user" || die "--runner-user '$user' is invalid — want a POSIX user name"
  ! runner_user_is_root "$user" || die "--runner-user '$user' is invalid — a runner never runs as root: config.sh refuses it, and every job would run as root"
  # It is written into each runner's unit as WorkingDirectory= and ExecStart=.
  valid_unit_path "$root" || die "--runner-root '$root' is invalid — want an absolute path of letters, digits, '.', '_' and '-' (it is written into each runner's systemd unit)"
  [ -z "$version" ] || valid_runner_version "$version" || die "--runner-version '$version' is invalid — want X.Y.Z"

  local have; have="$(discover | wc -l)"
  echo "Host has $have runner slot(s); target $n."
  if [ "$have" -ge "$n" ]; then
    echo "Nothing to provision. ('scale' enables and disables the slots that exist;"
    echo "removing one for good is 'runnerctl deprovision <slot>'.)"
    return 0
  fi
  local want=$((n - have))

  [ -n "$url" ] || die "no --url and no RUNNER_URL in $CONFIG_FILE — provision needs to know what to register against, e.g. --url https://github.com/<org>"
  valid_runner_url "$url" || die "--url '$url' is invalid — want https://github.com/<org>, .../<org>/<repo> or .../enterprises/<slug>"
  read -r scope_kind scope_path <<<"$(runner_scope "$url")"
  [ -z "$prefix" ] && prefix="$(hostname -s 2>/dev/null || hostname)"
  valid_runner_name "$prefix" || die "runner name prefix '$prefix' is invalid — want letters, digits, dot, dash or underscore (pass --name-prefix)"
  [ -n "$group" ] || group="$user"

  local arch; arch="$(runner_arch)"
  echo "  scope:   $scope_kind — $url"
  echo "  names:   $prefix-<n>, arch $arch"

  # Which indexes to create: the first `want` that are not already a unit or a
  # directory, so a re-run after a half-finished one does not collide.
  mapfile -t units < <(discover)
  local existing_units=" ${units[*]} "
  local -a slots=() ; local i=1
  while [ "${#slots[@]}" -lt "$want" ] && [ "$i" -le 200 ]; do
    local name="$prefix-$i" dir="$root/$prefix-$i"
    if [[ "$existing_units" == *".$name.service "* ]] || { [ -e "$dir" ] && ! $replace; }; then
      i=$((i + 1)); continue
    fi
    slots+=("$i"); i=$((i + 1))
  done
  [ "${#slots[@]}" -eq "$want" ] || die "could not find $want free runner name(s) under prefix '$prefix' — pass --name-prefix, or --replace to reuse an existing directory"
  echo "  new:     $want slot(s) — ${slots[*]/#/$prefix-}"
  # The unit each slot gets (GHR-110), named before anything is touched so a
  # name runnerctl will not write refuses the whole run up front.
  local -A slot_unit=()
  local s_ u_
  for s_ in "${slots[@]}"; do
    u_="$(runner_unit_name "$url" "$prefix-$s_")" || exit 1
    slot_unit[$s_]="$u_"
  done
  # GHR-121: before anything is touched, a dry run included. A root that does
  # not exist yet is fine here — its existing parents are checked, and the
  # root itself again once `mkdir -p` has made it.
  local root_problem; root_problem="$(runner_root_problem "$root")"
  [ -z "$root_problem" ] || die "$root_problem. Nothing was changed."

  # Resolve the release before touching the host, so a bad version or an
  # unreachable API fails with nothing half-created.
  local release_json="" asset sha_want=""
  RELEASE_TMP=""
  if [ -z "$version" ]; then
    release_json="$RUNNER_API_URL/repos/actions/runner/releases/latest"
  else
    release_json="$RUNNER_API_URL/repos/actions/runner/releases/tags/v$version"
  fi
  if $dry_run && [ -n "$version" ] && ! $verify; then
    : # nothing to ask the API for
  else
    RELEASE_TMP="$(mktemp)"
    trap 'rm -f "$RELEASE_TMP"' EXIT
    http_api GET "$release_json" "$pat" >"$RELEASE_TMP" \
      || die "could not read the runner release metadata from $release_json${version:+ (is v$version a real actions/runner release?)} — pass --runner-version and --sha256 to work offline"
    [ -n "$version" ] || version="$(json_field tag_name <"$RELEASE_TMP")"
    version="${version#v}"
    valid_runner_version "$version" || die "the release metadata carried no usable version (got '$version') — pass --runner-version X.Y.Z"
  fi
  asset="actions-runner-linux-$arch-$version.tar.gz"
  local tarball_url="$RUNNER_DOWNLOAD_URL/v$version/$asset"
  echo "  release: $version ($asset)"

  if [ -n "$sha_pin" ]; then
    sha_want="$sha_pin"
  elif [ -n "$RELEASE_TMP" ]; then
    sha_want="$(runner_release_sha "$RELEASE_TMP" "$asset" "$arch")"
  fi
  if [ -z "$sha_want" ]; then
    $verify && die "no published SHA-256 found for $asset — pass --sha256 <hex>, or --no-verify-checksum to install without verifying"
    echo "  sha256:  NOT VERIFIED (--no-verify-checksum)"
  else
    echo "  sha256:  ${sha_want:0:12}… (from the release metadata)"
  fi

  if $dry_run; then
    echo
    echo "(dry run — nothing downloaded, nothing changed)"
    echo "would download: $tarball_url"
    echo "would create:   $user (if missing), $root/$prefix-<n> for n in ${slots[*]}"
    local s
    for s in "${slots[@]}"; do
      if [ -e "$root/$prefix-$s" ] || [ -L "$root/$prefix-$s" ]; then
        echo "would replace:  $root/$prefix-$s (unpacked fresh beside it; the old directory is deleted, nothing in it is kept)"
      fi
      echo "would register: $prefix-$s via ACTIONS_RUNNER_INPUT_TOKEN=*** config.sh --unattended --url $url --name $prefix-$s${labels:+ --labels $labels}${rgroup:+ --runnergroup $rgroup}"
      echo "would install:  $SYSTEMD_DIR/${slot_unit[$s]}   (runs $root/$prefix-$s/runsvc.sh as $user), then enable and start it"
    done
    return 0
  fi
  audit_begin provision "${slots[@]/#/$prefix-}" "$($replace && echo --replace)" # GHR-88: names only — never a token
  # GHR-153: a slot unpacked and registered with GitHub but with no unit, or
  # a unit not started, is a worse host than either end — and the per-slot
  # loop is long. Nothing after this asks the operator anything.
  caller_guard

  # Only now, with everything resolved, is a credential needed — a dry run and
  # every refusal above get there without one.
  [ -n "$token" ] || token="$(runner_registration_token "$scope_path" "$pat")"

  ensure_runner_user "$user" "$group" false
  run_priv mkdir -p "$root"
  # What mkdir -p made (or kept) is the directory the file work runs in.
  root_problem="$(runner_root_problem "$root")"
  [ -z "$root_problem" ] || die "$root_problem. No runner was unpacked."

  echo "Downloading $asset…"
  # Its own name, not cmd_install's DOWNLOAD_TMP: that one is a file and this
  # one a directory, and the two traps would disagree about how to clean up.
  PROVISION_TMP="$(mktemp -d)"
  trap 'rm -rf "$PROVISION_TMP"; rm -f "$RELEASE_TMP"' EXIT
  local tarball="$PROVISION_TMP/$asset"
  runner_fetch_tarball "$tarball_url" "$tarball"
  if [ -n "$sha_want" ]; then
    local sha_got; sha_got="$(runner_sha256 "$tarball")"
    [ "$sha_got" = "$sha_want" ] || die "checksum mismatch for $asset — expected $sha_want, got $sha_got. NOT installing."
    echo "  checksum ok"
  fi

  local s name dir made=() failed=()
  for s in "${slots[@]}"; do
    name="$prefix-$s"; dir="$root/$name"
    if [ -e "$dir" ] || [ -L "$dir" ]; then
      echo "[$name] replacing $dir — unpacked fresh beside it; the old directory is deleted, nothing in it is kept"
    else
      echo "[$name] unpacking into $dir"
    fi
    runner_unpack_slot "$tarball" "$root" "$name" "$user" "$group" || { failed+=("$name"); echo "  [FAILED] unpack"; continue; }
    echo "[$name] registering with GitHub"
    # GHR-122: no --token here — the token goes over stdin (runner_exec_with_token)
    # so it is in no process's argv.
    local cfg_args=(./config.sh --unattended --url "$url" --name "$name" --work "$work")
    [ -z "$labels" ] || cfg_args+=(--labels "$labels")
    [ -z "$rgroup" ] || cfg_args+=(--runnergroup "$rgroup")
    $replace && cfg_args+=(--replace)
    if ! runner_exec_with_token "$token" "$dir" "$user" "${cfg_args[@]}"; then
      failed+=("$name"); echo "  [FAILED] config.sh — the directory is left in place for inspection"; continue
    fi
    echo "[$name] installing the service ${slot_unit[$s]}"
    if ! runner_unit_install "${slot_unit[$s]}" "$dir" "$user"; then
      failed+=("$name"); echo "  [FAILED] installing ${slot_unit[$s]}"; continue
    fi
    if ! hb_systemctl start "${slot_unit[$s]}"; then
      failed+=("$name"); echo "  [FAILED] systemctl start ${slot_unit[$s]}"; continue
    fi
    made+=("$name")
    echo "  [ok] $name"
  done

  hb_systemctl daemon-reload
  echo
  if [ "${#made[@]}" -gt 0 ]; then
    echo "Provisioned ${#made[@]} runner(s): ${made[*]}"
    echo "Next:"
    echo "  runnerctl status                     # the new slots should be running"
    echo "  runnerctl scale $n --max 26G --high 25G   # apply a profile and set the pool size"
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "runnerctl: provision: ${#failed[@]} slot(s) failed: ${failed[*]}" >&2
    echo "runnerctl: their directories are left under $root for inspection; re-run provision once fixed." >&2
    exit 1
  fi
}

# --- Deprovisioning: removing a runner for good (GHR-46) ---------------------
# The inverse of `provision`, and the step `scale` deliberately stops short
# of: `scale` disables a slot, which leaves it registered with GitHub (offline)
# and on disk. `deprovision <target>...` runs the runner's teardown in the
# order the runner insists on — what `svc.sh stop` + `svc.sh uninstall` do,
# done by runnerctl as root (GHR-110: stop, disable, remove the unit file),
# then the runner's .service marker removed and `config.sh remove` run with a
# REMOVAL token as the runner user (config.sh refuses to remove a runner
# whose service is still installed: "Uninstall service first") — and deletes
# the runner's directory.
#
# Destructive and irreversible, so: only explicit targets (a bare
# `deprovision` is a refusal, never "all"); a y/N confirm unless --yes, and a
# refusal when there is no terminal to ask; a slot with a job in flight is
# refused unless --when-idle waits for it; --dry-run prints the commands.
#
# A runner GitHub has already forgotten (removed in the UI, or expired) makes
# `config.sh remove` FAIL — the DELETE 404s and the runner's own code rethrows
# without touching its local files — so that failure is a warning here, never
# a stop: the local unit and directory are what this command owns, and a host
# left with a dead runner on it because GitHub already agreed it was gone
# would be the worst of both. --local-only skips GitHub altogether, for a
# host with no credential at hand.

# Is DIR a runner's own tree? The check between a unit's WorkingDirectory and
# `rm -rf`: a unit that points anywhere else is refused, not trusted.
runner_dir_is_runner() { # DIR
  [ -f "$1/config.sh" ] && [ -f "$1/svc.sh" ]
}

# Can someone answer a y/N on stdin? Its own function so a config can answer
# it — the sim's stdin is never a terminal.
stdin_is_tty() { [ -t 0 ]; }

# runner_exec, with TOKEN handed to the runner as ACTIONS_RUNNER_INPUT_TOKEN
# rather than `--token` in argv. The runner reads any ACTIONS_RUNNER_INPUT_<arg>
# as that argument and masks it as a secret (CommandSettings.cs, read
# 2026-09-24). sudo resets the environment, so the value cannot simply be
# exported: the inner shell reads it from STDIN, which reaches neither argv
# nor any log — /proc/<pid>/environ is readable only by the runner user and
# root.
runner_exec_with_token() { # TOKEN DIR USER CMD...
  local token="$1" dir="$2" user="$3"; shift 3
  # Never as root, for runner_exec's reason (GHR-110).
  if runner_user_is_root "$user"; then
    echo "runnerctl: refusing to run '$*' in $dir as $user: everything in a runner's directory is writable by the account jobs run as, so runnerctl never runs it as root" >&2
    return 1
  fi
  # SC2016 for runner_exec's reason: the $1/$@ belong to the inner bash.
  # shellcheck disable=SC2016
  run_priv runuser -u "$user" -- bash -c 'IFS= read -r ACTIONS_RUNNER_INPUT_TOKEN || exit 1; export ACTIONS_RUNNER_INPUT_TOKEN; cd "$1" || exit 1; shift; exec "$@"' runnerctl "$dir" "$@" <<<"$token"
}

deprovision_usage() {
  cat <<'DEPROVISION'
Usage: runnerctl deprovision <unit|slot-index|name>... [options]

Removes runner slots for good: stops, disables and removes each one's systemd
unit, deregisters it from GitHub (config.sh remove, run as the runner's user,
with a removal token) and deletes its directory. Irreversible. There is no
"all": every slot to remove is named.

  --token TOKEN   a removal token from GitHub (a runner's "Remove" dialog
                  under Settings -> Actions -> Runners). Valid 1 hour.
  --pat TOKEN     a PAT to mint the removal token with, instead of pasting
                  one. Defaults to $GITHUB_TOKEN; with neither, the gh CLI's
                  login is used if it is present.
  --url URL       org, repo or enterprise the runners are registered to, for
                  minting (default: RUNNER_URL from the config file). Not
                  needed with --token or --local-only.
  --local-only    do not talk to GitHub: remove the service and directory
                  only. The runner stays listed (offline) until removed there.
  --when-idle     wait for each slot's job to finish instead of refusing a
                  busy slot; --timeout N (seconds) bounds the wait
  --yes, -y       do not ask for confirmation (required without a terminal)
  --dry-run       print the exact commands; mint nothing, change nothing

A runner GitHub has already forgotten is still cleaned up locally: a failing
config.sh remove is a warning, not a stop.
DEPROVISION
}

cmd_deprovision() {
  local url="$RUNNER_URL" token="" pat="${GITHUB_TOKEN:-}" cred_flag=""
  local dry_run=false yes=false local_only=false
  local targets=() t u
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      -h|--help)    deprovision_usage; return 0 ;;
      --url)        need_val "$@"; url="$2"; shift 2 ;;
      --token)      need_val "$@"; token="$2"; cred_flag=--token; shift 2 ;;
      --pat)        need_val "$@"; pat="$2"; cred_flag=--pat; shift 2 ;;
      --local-only) local_only=true; shift ;;
      --when-idle)  when_idle=true; shift ;;
      --timeout)    need_val "$@"; set_timeout "$2"; shift 2 ;;
      -y|--yes)     yes=true; shift ;;
      --dry-run)    dry_run=true; shift ;;
      -*)           die "unknown option: $1 ('runnerctl deprovision --help' lists them)" ;;
      *)            targets+=("$1"); shift ;;
    esac
  done

  [ "${#targets[@]}" -gt 0 ] || die "deprovision needs an explicit target — a unit, slot index or runner name, e.g. 'deprovision 2'. It never means 'all'; 'runnerctl status' lists the slots."
  if $local_only && [ -n "$cred_flag" ]; then
    die "--local-only does not talk to GitHub, so $cred_flag has nothing to do — drop one of them"
  fi
  require_runners

  # Resolve every target, and read where each runner lives, before anything is
  # touched: a typo in the third target must not leave the first two removed.
  local units=() seen=" "
  for t in "${targets[@]}"; do
    # Resolve on its own line: a die inside "$(...)" only exits the subshell.
    u="$(resolve "$t")"
    [[ "$seen" == *" $u "* ]] && continue
    seen+="$u "
    units+=("$u")
  done
  local dirs=() users=() unsafe=() dir user short i problem
  for u in "${units[@]}"; do
    short="$(short_name "$u")"
    # The unit (svc.sh's or provision's) has WorkingDirectory=<the runner's
    # dir> and User=<its user>.
    dir="$(prop "$u" WorkingDirectory)"; dir="${dir%/}"
    user="$(prop "$u" User)"; [ -n "$user" ] || user="$RUNNER_USER"
    [[ "$dir" == /?* ]] || die "$short: its unit names no runner directory (WorkingDirectory='$dir') — was it installed by svc.sh? Nothing was changed."
    runner_dir_is_runner "$dir" || die "$short: $dir has no config.sh and svc.sh — refusing to delete a directory that is not a runner's. Nothing was changed."
    # GHR-110: the unit file is removed by name under SYSTEMD_DIR, so the name
    # must be a plain unit name; and the runner's own scripts run as its user,
    # which must not be root — `--local-only` runs none of them.
    [[ "$u" =~ ^[A-Za-z0-9@._:-]+\.service$ ]] || die "$short: '$u' is not a unit name runnerctl will remove a file for. Nothing was changed."
    if ! $local_only && { ! valid_user_name "$user" || runner_user_is_root "$user"; }; then
      die "$short: its unit runs the runner as '$user' — runnerctl never runs a runner's own scripts (config.sh remove) as root. Pass --local-only and remove it under Settings -> Actions -> Runners. Nothing was changed."
    fi
    # GHR-121: root's rm -rf of DIR is only as safe as the directory it sits
    # in. A classic svc.sh runner lives under its user's home, so an untrusted
    # parent is normal and is not refused: the removal then runs as the unit's
    # user, so whoever can swap the path can only make it hit what they could
    # delete anyway. Decided here, once, before the first privileged call (a
    # dry run included); only a unit with no non-root user to remove it as is
    # refused. The unit file and drop-in under SYSTEMD_DIR stay root's.
    problem="$(runner_root_chain_problem "$(dirname "$dir")")"
    if [ -z "$problem" ]; then
      unsafe+=("")
    elif valid_user_name "$user" && ! runner_user_is_root "$user"; then
      unsafe+=("${problem%%$'\037'*}")
    else
      die "$short: $dir sits under ${problem%%$'\037'*}, which root does not own or others can write, and its unit gives no non-root user to remove it as (User='$user'). Remove it by hand. Nothing was changed."
    fi
    dirs+=("$dir"); users+=("$user")
  done

  # Minting needs to know the scope; a pasted --token and --local-only do not.
  local scope_kind="" scope_path=""
  if ! $local_only && [ -z "$token" ]; then
    [ -n "$url" ] || die "no --url and no RUNNER_URL in $CONFIG_FILE — minting a removal token needs the org, repo or enterprise the runners are registered to (or pass --token <removal token>, or --local-only)"
    valid_runner_url "$url" || die "--url '$url' is invalid — want https://github.com/<org>, .../<org>/<repo> or .../enterprises/<slug>"
    read -r scope_kind scope_path <<<"$(runner_scope "$url")"
    [ -n "$scope_path" ] || exit 1   # runner_scope already said why
  fi

  # A busy slot is refused outright unless --when-idle, which waits per slot
  # below instead. Checked for EVERY target before any is touched.
  if ! $when_idle; then
    local busy=""
    for u in "${units[@]}"; do
      slot_is_idle "$u" && continue
      if [ "$SLOT_JOB" = "(no access)" ]; then
        busy+="${busy:+, }$(short_name "$u") (cannot tell — needs journal read access or root)"
      else
        busy+="${busy:+, }$(short_name "$u") ($(job_desc "$SLOT_JOB"))"
      fi
    done
    [ -z "$busy" ] || die "refusing: a job is in flight on $busy — deprovisioning would kill it and GitHub would mark it failed. Pass --when-idle to wait for each slot to finish. Nothing was changed."
  fi

  if $local_only; then
    echo "Deprovision ${#units[@]} runner slot(s) — removed from this host only (--local-only):"
  else
    echo "Deprovision ${#units[@]} runner slot(s) — deregistered from GitHub and removed from this host:"
  fi
  for i in "${!units[@]}"; do
    echo "  $(short_name "${units[$i]}")  (${dirs[$i]}, runs as ${users[$i]})"
  done

  if $dry_run; then
    echo
    echo "(dry run — no token minted, nothing changed)"
    [ -z "$scope_path" ] || echo "would mint:  a removal token — POST $RUNNER_API_URL/$scope_path/actions/runners/remove-token ($scope_kind)"
    for i in "${!units[@]}"; do
      u="${units[$i]}"; dir="${dirs[$i]}"
      ! $when_idle || echo "would wait:  until $(short_name "$u") is idle (--when-idle, up to ${WAIT_TIMEOUT}s)"
      echo "would run:   systemctl stop $u"
      echo "would run:   systemctl disable $u"
      echo "would run:   rm -f -- $SYSTEMD_DIR/$u"
      $local_only || echo "would run:   cd $dir && rm -f .service   (as ${users[$i]})"
      $local_only || echo "would run:   cd $dir && ACTIONS_RUNNER_INPUT_TOKEN=*** ./config.sh remove   (as ${users[$i]})"
      if [ -n "${unsafe[$i]}" ]; then
        echo "would run:   runuser -u ${users[$i]} -- rm -rf -- $dir   (parent not root-owned)"
      else
        echo "would run:   rm -rf -- $dir"
      fi
      echo "would run:   rm -f $SYSTEMD_DIR/$u.d/$DROPIN_NAME"
    done
    echo "would run:   systemctl daemon-reload"
    return 0
  fi

  if ! $yes; then
    stdin_is_tty || die "refusing to deprovision without confirmation: stdin is not a terminal. Pass --yes to confirm, or --dry-run to see the commands."
    local ans=""
    printf 'This cannot be undone. Deprovision %s? [y/N] ' "$(join_short "${units[*]}")" >&2
    IFS= read -r ans || true
    case "$ans" in
      y|Y|yes|Yes|YES) ;;
      *) die "not confirmed — nothing was changed." ;;
    esac
  fi
  audit_begin deprovision "$(join_short "${units[*]}")" "$($local_only && echo --local-only)" "$($when_idle && echo --when-idle)" # GHR-88: names only — never a token
  # GHR-137: after the prompt, never before it — a relay passes whole lines,
  # so a prompt with no newline would not show until something followed it.
  # From here a slot cut off part-way would be stopped and still registered,
  # or deregistered with its directory still there.
  caller_guard

  # Only now, confirmed and with every target validated, is a credential used.
  if ! $local_only && [ -z "$token" ]; then
    token="$(runner_api_token "$scope_path" "$pat" removal)"
  fi

  local made=() failed=() unconfirmed=()
  for i in "${!units[@]}"; do
    u="${units[$i]}"; dir="${dirs[$i]}"; user="${users[$i]}"; short="$(short_name "$u")"
    idle_gate "$u" deprovisioned "${units[*]:0:$i}" "${units[*]:$((i + 1))}"
    echo "[$short] stopping and removing the service"
    # svc.sh stop + uninstall, done here (GHR-110): its unit file is removed
    # by name whoever wrote it, so a unit svc.sh installed goes the same way.
    if ! hb_systemctl stop "$u"; then
      failed+=("$short"); echo "  [FAILED] systemctl stop — left in place"; continue
    fi
    if ! hb_systemctl disable "$u"; then
      failed+=("$short"); echo "  [FAILED] systemctl disable — left in place"; continue
    fi
    if ! run_priv rm -f -- "$SYSTEMD_DIR/$u"; then
      failed+=("$short"); echo "  [FAILED] rm -f $SYSTEMD_DIR/$u — left in place"; continue
    fi
    if ! $local_only; then
      # config.sh remove refuses while .service exists ("Uninstall service
      # first"). Removed as the runner user: it is the runner's file.
      if ! runner_exec "$dir" "$user" rm -f .service; then
        failed+=("$short"); echo "  [FAILED] removing $dir/.service — left in place"; continue
      fi
      echo "[$short] deregistering from GitHub"
      if ! runner_exec_with_token "$token" "$dir" "$user" ./config.sh remove; then
        unconfirmed+=("$short")
        echo "runnerctl: warning: $short: config.sh remove failed — GitHub may already have forgotten this runner. Cleaning up locally anyway." >&2
      fi
    fi
    if [ -n "${unsafe[$i]}" ]; then
      echo "[$short] removing $dir as $user, not root: ${unsafe[$i]} is not root-owned or others can write it"
      if ! run_priv runuser -u "$user" -- rm -rf -- "$dir"; then
        failed+=("$short"); echo "  [FAILED] rm -rf $dir as $user — files $user cannot remove are left in place"; continue
      fi
    else
      echo "[$short] removing $dir"
      if ! run_priv rm -rf -- "$dir"; then
        failed+=("$short"); echo "  [FAILED] rm -rf $dir"; continue
      fi
    fi
    # runnerctl's own drop-in outlives the unit just removed.
    run_priv rm -f "$SYSTEMD_DIR/$u.d/$DROPIN_NAME" || true
    if [ -d "$SYSTEMD_DIR/$u.d" ]; then run_priv rmdir --ignore-fail-on-non-empty "$SYSTEMD_DIR/$u.d" || true; fi
    made+=("$short")
    echo "  [ok] $short"
  done

  hb_systemctl daemon-reload
  echo
  [ "${#made[@]}" -eq 0 ] || echo "Deprovisioned ${#made[@]} runner slot(s): ${made[*]}"
  if [ "${#unconfirmed[@]}" -gt 0 ]; then
    echo "GitHub did not confirm removing: ${unconfirmed[*]}. If still listed under Settings -> Actions -> Runners, remove them there."
  fi
  if $local_only && [ "${#made[@]}" -gt 0 ]; then
    echo "--local-only: still registered with GitHub (offline). Remove them under Settings -> Actions -> Runners."
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "runnerctl: deprovision: ${#failed[@]} slot(s) failed: ${failed[*]}" >&2
    exit 1
  fi
}

cmd_config_example() {
  cat <<'EXAMPLE'
# runnerctl config — sourced as bash. Install as /etc/runnerctl/config
# (root-owned, not world-writable) or point RUNNERCTL_CONFIG / --config at it.
#
# Everything here is optional. Site-specific values (memory caps sized for
# your boxes, env-file paths, secret templates) belong here, never in the
# runnerctl script itself.

# Name of the managed drop-in under /etc/systemd/system/<unit>.d/
#DROPIN_NAME="10-runnerctl.conf"

# Profile used when --profile is omitted.
#DEFAULT_PROFILE="ci"

# Where `runnerctl upgrade` fetches the new script from (a fork, a mirror).
#UPGRADE_URL="https://github.com/runnane/runnerctl/releases/latest/download/runnerctl"

# --when-idle / drain: seconds between idle polls, and the default --timeout.
#POLL_SEC="5"
#WAIT_TIMEOUT="1800"

# A job running this many seconds or more is STALLED in status/watch, a
# problem for `health`, "stalled":true in `status --json`, and what
# `restart --if-stalled` / `health --restart-stalled` act on. Default 1 h:
# no job on a build pool legitimately runs that long. Raise it for a pool
# with longer jobs; 0 turns the flag off; --stall-after N overrides per run.
#STALL_SEC="3600"

# `reap`: seconds a leaked process gets after SIGTERM before SIGKILL.
#REAP_GRACE_SEC="5"

# `kill`: seconds the Listener gets to notice its Worker was killed and
# report the job failed, before the whole unit's cgroup is SIGKILLed
# instead. Counted in POLL_SEC steps.
#KILL_GRACE_SEC="10"

# `compose-reap`: a Docker Compose project whose job is gone (its `-<pid>`
# name suffix or its runner slot says so) is reaped at once; one with no
# owner signal once idle MAX_AGE_HOURS. Younger than GRACE_MIN minutes is
# always kept; a `-<n>` suffix below MIN_PID is compose numbering, not a pid;
# a container labelled KEEP_LABEL=true keeps its whole project.
#COMPOSE_REAP_MAX_AGE_HOURS="3"
#COMPOSE_REAP_GRACE_MIN="10"
#COMPOSE_REAP_MIN_PID="300"
#COMPOSE_REAP_KEEP_LABEL="runnerctl.keep"
#
# 1 = also judge containers with no compose label — a `docker run -d` a dead
# job left running — and remove each reaped one's image once nothing uses it.
# An unlabelled container cannot name its owner, so it is kept while ANY slot
# runs a job older than it, and otherwise reaped after MAX_AGE_HOURS.
#COMPOSE_REAP_STANDALONE="0"

# PRESS column (memory pressure, PSI full avg10 in percent): yellow from
# WARN, red and a `health` problem from CRIT.
#PRESSURE_WARN_PCT="10"
#PRESSURE_CRIT_PCT="50"

# The host's 1-minute load average against its cores on the status header,
# as a ratio of load to cores (at most two decimals): green below WARN,
# yellow from WARN, red from CRIT. `fleet`'s summary counts the hosts at CRIT.
#LOAD_WARN_RATIO="1.0"
#LOAD_CRIT_RATIO="2.0"
#
# The CPU column is cores in use over a sample: `watch` uses its previous
# tick; a one-shot `status` table samples while it collects and waits up to
# this many milliseconds more. 0 = never wait (a one-shot table draws `—`).
#CPU_SAMPLE_MS="250"

# Disk usage of the filesystems that hold Docker's data root, every slot's
# work folder and DISK_PATHS, once per filesystem, labelled with what is on
# it, in percent: green below WARN, yellow from WARN, red and a `health`
# problem from CRIT. /boot and the like only appear if one of those paths
# lives there. DISK_IGNORE is an ERE over mount points to leave out.
#DISK_WARN_PCT="85"
#DISK_CRIT_PCT="95"
#DISK_IGNORE=""
#
# Docker's data root — set it when daemon.json moves "data-root".
#DISK_DOCKER_DIR="/var/lib/docker"
#
# More directories to watch, space-separated, PATH or LABEL=PATH.
#DISK_PATHS="cache=/srv/build-cache"

# Seconds of journal status/health search for host-wide kernel OOM kills and
# "No space left on device" lines. Either one in the window is a `health`
# problem (a slot's own cgroup OOM is not — that fails the step by design).
# 0 turns the search off.
#EVENTS_SEC="3600"

# Processes matching this ERE are the runner's own and never counted as
# leaked or reaped. Extend it for an image that wraps the runner differently.
#RUNNER_OWN_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.(Listener|Worker|PluginHost)'

# Processes matching this ERE are the Listener side of the runner and are
# never killed by `kill` — everything else in the slot's cgroup is the job.
# Narrower than RUNNER_OWN_PATTERN on purpose: Runner.Worker IS the job.
#RUNNER_LISTENER_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.Listener'

# --- Provisioning -----------------------------------------------------------
# `runnerctl provision N` installs and registers runner slots on a host that
# has none (or tops an existing host up to N). Only RUNNER_URL is really site
# data; the rest have defaults that work unchanged on most boxes.

# The org, repo or enterprise the runners register against. Setting it here
# means `provision N` needs no --url on this host.
#RUNNER_URL="https://github.com/your-org"

# One directory per slot is created under this root, as <prefix>-<n>.
#RUNNER_ROOT="/opt/actions-runner"

# The unprivileged account the runners run as, created as a system user when
# it does not exist. config.sh refuses to run as root, so this is never root.
#RUNNER_USER="github-runner"
#RUNNER_GROUP=""          # empty = a group named after RUNNER_USER

# Runner names are <prefix>-<n>; empty = the host's short name.
#RUNNER_NAME_PREFIX=""

# Extra labels (comma-separated) on top of the ones the runner sets itself.
#RUNNER_LABELS="ci,linux"

# The runner's _work directory, relative to the runner's own directory.
#RUNNER_WORK="_work"

# Runner group to register into. Empty = the account's default group, which
# is the only valid choice for a repo-scoped runner.
#RUNNER_GROUP_NAME=""

# Empty = install the latest release. Pin it on a host that must not move.
#RUNNER_VERSION=""

# Where the release metadata and the tarball come from — change both for a
# mirror or for GitHub Enterprise Server (e.g. https://ghes.example.com/api/v3).
#RUNNER_API_URL="https://api.github.com"
#RUNNER_DOWNLOAD_URL="https://github.com/actions/runner/releases/download"

# --- Fleet mode -------------------------------------------------------------
# `runnerctl fleet status` runs this tool from one central node against
# several runner hosts over ssh. Uncomment FLEET_HOSTS on the central node
# only; the runner hosts themselves need no fleet config, just runnerctl
# installed and an ssh login. Read-only status never asks for sudo, so an
# unprivileged login is enough.
#
# ssh aliases (from ~/.ssh/config) or user@host. This is site data — keep it
# here, never in the runnerctl script.
#FLEET_HOSTS=(build-1 build-2 build-3)

# Extra ssh options, appended after the built-in ones and after the ones
# `fleet watch` sets for its own session. ssh keeps the FIRST value it is
# given for an option, so these cannot change BatchMode, ConnectTimeout or the
# watch's own connection. They can change the dead-peer keepalive, which comes
# after them: by default ServerAliveInterval=15 and ServerAliveCountMax=4, so
# a host that stops answering mid-call is reported unreachable after about a
# minute instead of holding its place in the fan-out for the whole budget.
# `fleet watch` already holds one connection per host open for as long as it
# runs, so this is only needed to reuse connections ACROSS separate commands.
# Note %C rather than %r@%h:%p: a unix socket path is capped near 104 bytes
# and ssh stops multiplexing SILENTLY when a ControlPath exceeds it, while %C
# is a fixed-length hash whatever the host is called.
#FLEET_SSH_OPTS=(-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%C -o ControlPersist=60)

# Most hosts contacted at once, and the per-host seconds budget of a read-only
# call (status, health). The timeout is what stops one wedged host holding up
# the whole fan-out.
#FLEET_PARALLEL="8"
#FLEET_TIMEOUT="30"

# The per-host seconds budget of a read made by `fleet watch`: each tick's
# calls, and the reads an action key makes before it decides. A host that
# does not answer inside it keeps its last rows on screen, marked with how
# long ago they were seen, and is asked again; it never holds up the other
# hosts or the keyboard. A one-shot `fleet status` stays on FLEET_TIMEOUT.
#FLEET_WATCH_TIMEOUT="10"

# The per-host seconds budget of a call that CHANGES things (restart, stop,
# apply, upgrade, a watch action key, ...). Those are slow by design — a slot
# whose job ignores SIGTERM sits out its unit's TimeoutStopSec, one slot after
# another — so raise this on hosts with many slots. A --when-idle or drain
# wait is added on top automatically: --timeout (else WAIT_TIMEOUT above) per
# slot on the host.
#FLEET_MUTATE_TIMEOUT="900"

# A host whose runnerctl takes --heartbeat is not held to that total: such a
# call is cut once the host has printed no line for FLEET_MUTATE_IDLE seconds
# (it is asked for one at least every FLEET_MUTATE_IDLE/4 s; 0 = off, every
# host on FLEET_MUTATE_TIMEOUT), and a call that keeps printing is cut at
# FLEET_MUTATE_MAX seconds, or at the total above where that is longer. An
# older host is on FLEET_MUTATE_TIMEOUT as before. IDLE: 0 or 10 and up;
# MAX: more than IDLE.
#FLEET_MUTATE_IDLE="120"
#FLEET_MUTATE_MAX="7200"

# The remote command, for hosts where runnerctl is not on the ssh user's PATH.
#FLEET_RUNNERCTL="runnerctl"

# 1 = every call that changes a host runs `sudo -n FLEET_RUNNERCTL <verb> …`
# there, for hosts whose sudoers grants the ssh login runnerctl itself (one
# line, the narrow contract in the README) instead of the systemctl/tee/rm/
# kill/cp/mv it calls — a grant of those is root for that login. Reads never
# use sudo. The sudoers line must name the exact absolute path sudo resolves
# FLEET_RUNNERCTL to, so set FLEET_RUNNERCTL to that path.
#FLEET_SUDO="0"

# This node's record of every fleet command that changed a host (and every
# fleet watch action key): one line each — UTC time, operator, the command,
# each host's exit code. Created 0600 in a 0700 directory. Empty = the
# invoking user's ${XDG_STATE_HOME:-~/.local/state}/runnerctl/fleet.log;
# otherwise an absolute path. Each host keeps its own record in its journal
# (`runnerctl history`; `runnerctl fleet history` merges them).
#FLEET_LOG=""

# --- sudo contract (on each runner host) ------------------------------------
# narrow = this host's sudoers grants a login runnerctl itself (the narrow
# contract in the README). Under sudo runnerctl then refuses whatever would
# widen that grant back to root: any config but this file, a script or config
# directory others can write, `fleet`, and the flags that choose what root
# runs, sources, installs, writes or removes. Required with that sudoers
# line, which without it is root for the login through --config alone. Read
# from this file only — a --config or RUNNERCTL_CONFIG cannot set it.
# full (default) = nothing is refused; whoever runs sudo here is root anyway.
#SUDO_CONTRACT="full"

# A profile is a function that sets these variables. Defining profile_ci or
# profile_deploy replaces the built-in of the same name.
#
# `apply --save` / `scale --save` rewrite one of these blocks in place, with the
# values they just applied — so a one-off `--high infinity` becomes the profile
# instead of being re-rendered away by the next apply. A block is rewritable
# when it opens with `profile_<name>() {` alone on its line, closes with `}` in
# column 1, and holds nothing but these knobs; --save refuses anything else
# rather than flattening it, and keeps the previous file as <config>.bak.
profile_ci() {
  PROFILE_DESC="CI build/test pool — memory-capped, auto-restart."
  MEM_MAX="26G"        # hard cap per slot (MemoryMax)
  MEM_HIGH="25G"       # soft throttle point (MemoryHigh) — keep it close to
                       # the cap: memory.high throttles rather than kills, and
                       # a build crawling there for hours looks STALLED
  RESTART_SEC="10"
  ENV_FILE=""          # no EnvironmentFile for CI slots
}

profile_deploy() {
  PROFILE_DESC="Prod deploy runner — on-device secrets, uncapped, auto-restart."
  MEM_MAX=""; MEM_HIGH=""
  RESTART_SEC="15"
  ENV_FILE="/etc/runnerctl/deploy.env"
  # Optional: a file to copy as the env-init template instead of the
  # env_template_deploy function below.
  #ENV_TEMPLATE="/etc/runnerctl/deploy.env.example"
}

# Placeholder template written by `runnerctl env-init --profile deploy`.
# PLACEHOLDERS ONLY — the live file is filled in on the box and never committed.
env_template_deploy() {
  cat <<'TEMPLATE'
# deploy runner — on-device secrets/config. Root-owned, chmod 600, never committed.

# --- Registry / release publish ------------------------------------------
GHCR_USERNAME=
GHCR_TOKEN=
NPM_TOKEN=

# --- Target hosts (SSH aliases or docker contexts) ------------------------
APP_SSH_HOST=
APP_DIR=/opt/myapp

# --- Optional: notifications ----------------------------------------------
DEPLOY_SLACK_WEBHOOK_URL=
TEMPLATE
}
EXAMPLE
}

# --- Migration from a pre-config runnerctl ------------------------------------
# The predecessor of this script carried the site values inline: DROPIN_NAME
# and UNIT_GLOB as top-level assignments, PROFILE="<default>", a load_profile()
# whose case block set PROFILE_DESC/MEM_MAX/MEM_HIGH/RESTART_SEC/ENV_FILE per
# profile, and one render_env_template() heredoc. It has no RUNNERCTL_VERSION,
# which is how it is recognised. `migrate` lifts those values into a config
# file, reconciles them against the drop-ins actually on the host (live wins,
# every difference is reported), then proves the config renders each live
# drop-in back byte-for-byte (comments aside).

# --from is sourced, so refuse anything that is not recognisably a runnerctl
# script before it gets that far (a README passed by mistake would run).
looks_like_runnerctl() {
  head -1 "$1" | grep -qE '^#!.*bash' && grep -q '^load_profile()' "$1" && grep -q '^render_dropin()' "$1"
}
is_legacy_script() { ! grep -q '^RUNNERCTL_VERSION=' "$1"; }

# Source the old script minus its trailing `main "$@"` in a subshell — its
# functions shadow ours only there — and dump what it defines, one record per
# line, fields separated by \037 (a tab would collapse empty fields in read).
legacy_dump() {
  local stripped; stripped="$(mktemp)"
  grep -vxE 'main "\$@"' "$1" >"$stripped"
  (
    set +e
    # shellcheck disable=SC1090  # the path is only known at runtime, same as the config
    . "$stripped" >/dev/null 2>&1 || exit 0
    set +eu  # the old script turned -e back on; from here every failure is a partial dump, not an exit
    declare -F load_profile >/dev/null || exit 0
    printf 'DEFAULT_PROFILE\037%s\n' "${PROFILE:-}"
    printf 'DROPIN_NAME\037%s\n' "${DROPIN_NAME:-}"
    printf 'UNIT_GLOB\037%s\n' "${UNIT_GLOB:-}"
    # bash reprints the function normalised, so the case labels are always
    # `        name)` on their own line whatever the source formatting was.
    local p
    for p in $(declare -f load_profile | grep -E '^[[:space:]]+[A-Za-z0-9_]+\)$' | tr -d ' )'); do
      PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC=""; ENV_FILE=""
      PROFILE="$p"; load_profile
      printf 'PROFILE\037%s\037%s\037%s\037%s\037%s\037%s\n' \
        "$p" "$PROFILE_DESC" "$MEM_MAX" "$MEM_HIGH" "$RESTART_SEC" "$ENV_FILE"
    done
    if declare -F render_env_template >/dev/null; then
      echo "TEMPLATE_BEGIN"; render_env_template; echo "TEMPLATE_END"
    fi
  )
  rm -f "$stripped"
}

sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; } # single-quote a value for a sourced file

# True when writing PATH (creating missing parents) needs root: the nearest
# existing ancestor decides, so a not-yet-created directory under one the
# caller owns does not escalate to sudo.
needs_priv() {
  local p="$1"
  while [ ! -e "$p" ]; do p="$(dirname "$p")"; done
  [ ! -w "$p" ]
}
strip_ini() { grep -vE '^[[:space:]]*(#|$)' "$@" || true; } # drop comments and blank lines

# Parse one live drop-in into LIVE_* for the caller.
read_dropin() {
  local f="$1" line
  LIVE_PROFILE=""; LIVE_MAX=""; LIVE_HIGH=""; LIVE_RS=""; LIVE_ENV=""
  while IFS= read -r line; do
    case "$line" in
      '#'*'(profile: '*')'*) LIVE_PROFILE="${line#*\(profile: }"; LIVE_PROFILE="${LIVE_PROFILE%%)*}" ;;
      MemoryMax=*)        LIVE_MAX="${line#*=}" ;;
      MemoryHigh=*)       LIVE_HIGH="${line#*=}" ;;
      RestartSec=*)       LIVE_RS="${line#*=}" ;;
      EnvironmentFile=*)  LIVE_ENV="${line#*=}" ;;
    esac
  done <"$f"
}

cmd_migrate() {
  local from="" out="" dry_run=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)    [ $# -ge 2 ] || die "--from needs a path"; from="$2"; shift 2 ;;
      --output)  [ $# -ge 2 ] || die "--output needs a path"; out="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  if [ -z "$from" ]; then
    from="$(command -v runnerctl || true)"
    [ -n "$from" ] || die "no installed runnerctl found — pass --from PATH"
  fi
  [ -f "$from" ] || die "$from: no such file"
  looks_like_runnerctl "$from" || die "$from does not look like a runnerctl script (no bash shebang / load_profile / render_dropin) — refusing to source it"
  # GHR-89: --from is refused under the narrow contract, but `install` reaches
  # here with a pre-config copy it found — in $SUDO_USER's home, where it is
  # not on secure_path. Under sudo that copy is the caller's file, and
  # sourcing it is running it as root; on a `full` host the caller is root
  # anyway, so only a `narrow` one refuses.
  if $SUDO_NARROW; then
    local problem; problem="$(root_exec_problem "$from")"
    [ -z "$problem" ] || die "refusing to source $from as root under sudo: $problem — run the same command without sudo (runnerctl asks sudo for each privileged step itself), or 'runnerctl install --no-migrate' and migrate it later"
  fi
  is_legacy_script "$from" \
    || die "$from is not a pre-config runnerctl (it carries $(grep -m1 '^RUNNERCTL_VERSION=' "$from")) — nothing to migrate"
  [ -n "$out" ] || out="$CONFIG_FILE"
  # GHR-88: it writes a config. Reached from `install` too, whose record this
  # already is.
  # GHR-153: guarded from there — a config written and never checked against
  # the live drop-ins is a worse host than either end. Under `install` this is
  # install's guard already (one per process).
  if ! $dry_run; then
    [ -n "$AUDIT_VERB" ] || audit_begin migrate "$out"
    caller_guard
  fi

  # 1. What the old script says.
  declare -A DESC MAX HIGH RS ENV
  local profiles=() l_default="" l_dropin="" l_glob="" template="" in_tpl=false line
  local k v1 v2 v3 v4 v5 v6
  while IFS= read -r line; do
    if $in_tpl; then
      [ "$line" = "TEMPLATE_END" ] && { in_tpl=false; continue; }
      template+="$line"$'\n'; continue
    fi
    IFS=$'\037' read -r k v1 v2 v3 v4 v5 v6 <<<"$line"
    case "$k" in
      DEFAULT_PROFILE) l_default="$v1" ;;
      DROPIN_NAME)     l_dropin="$v1" ;;
      UNIT_GLOB)       l_glob="$v1" ;;
      PROFILE) profiles+=("$v1"); DESC[$v1]="$v2"; MAX[$v1]="$v3"; HIGH[$v1]="$v4"; RS[$v1]="$v5"; ENV[$v1]="$v6" ;;
      TEMPLATE_BEGIN)  in_tpl=true ;;
    esac
  done < <(legacy_dump "$from")
  [ "${#profiles[@]}" -gt 0 ] || die "could not extract any profile from $from (no load_profile() case block?)"
  [ -n "$l_dropin" ] || die "could not extract DROPIN_NAME from $from"
  echo "Read $from: profiles ${profiles[*]}; drop-in $l_dropin; default profile ${l_default:-?}"

  # 2. What the host is actually running. Live values win; every difference
  #    is reported. Units are remembered for the render check at the end.
  local units=() live_units=() u f d p key n_live=0
  declare -A LIVE_FILE LIVE_PROF RECONCILED
  mapfile -t units < <(discover)
  if [ "${#units[@]}" -eq 0 ]; then
    echo "No '$UNIT_GLOB' units on this host — config comes from the script alone; live check skipped."
  fi
  for u in "${units[@]}"; do
    d="$SYSTEMD_DIR/$u.d"; f="$d/$l_dropin"
    if [ ! -e "$f" ]; then echo "  $u: no managed drop-in ($f) — unmanaged slot, skipped"; continue; fi
    if [ ! -r "$f" ]; then echo "  $u: $f not readable — run as root to reconcile it; skipped"; continue; fi
    read_dropin "$f"
    if [ -z "$LIVE_PROFILE" ]; then echo "  $u: $f names no profile in its header — skipped"; continue; fi
    p="$LIVE_PROFILE"
    if [ -z "${DESC[$p]+x}" ]; then
      echo "  $u: drop-in profile '$p' is not in the script — adding it from the live values"
      profiles+=("$p"); DESC[$p]="(recovered from $f)"; MAX[$p]="$LIVE_MAX"; HIGH[$p]="$LIVE_HIGH"; RS[$p]="$LIVE_RS"; ENV[$p]="$LIVE_ENV"
    fi
    for key in MAX HIGH RS ENV; do
      local want live
      case "$key" in
        MAX)  want="${MAX[$p]}";  live="$LIVE_MAX" ;;
        HIGH) want="${HIGH[$p]}"; live="$LIVE_HIGH" ;;
        RS)   want="${RS[$p]}";   live="$LIVE_RS" ;;
        ENV)  want="${ENV[$p]}";  live="$LIVE_ENV" ;;
      esac
      [ "$want" = "$live" ] && continue
      if [ -n "${RECONCILED[$p.$key]+x}" ]; then
        echo "  $u: profile '$p' $key is '$live' here but '$want' on ${RECONCILED[$p.$key]} — cannot be one profile; re-apply after migrating"
        continue
      fi
      echo "  $u: profile '$p' $key: script says '${want:-<empty>}', live drop-in says '${live:-<empty>}' — taking the live value"
      case "$key" in MAX) MAX[$p]="$live" ;; HIGH) HIGH[$p]="$live" ;; RS) RS[$p]="$live" ;; ENV) ENV[$p]="$live" ;; esac
      RECONCILED[$p.$key]="$u"
    done
    # Anything else in the .d/ that sets the same keys would fight the managed
    # drop-in — later-sorted wins in systemd, silently.
    local other
    for other in "$d"/*.conf; do
      [ -e "$other" ] || continue
      [ "$other" != "$f" ] || continue
      if grep -qE '^(MemoryMax|MemoryHigh|RestartSec|EnvironmentFile|Restart)=' "$other" 2>/dev/null; then
        echo "  $u: WARNING: $(basename "$other") also sets memory/restart keys — it will override $l_dropin if it sorts later"
      fi
    done
    live_units+=("$u"); LIVE_FILE[$u]="$f"; LIVE_PROF[$u]="$p"; n_live=$((n_live+1))
  done

  # 3. Render the config.
  local tpl_delim="RUNNERCTL_ENV_TEMPLATE"
  case "$template" in *"$tpl_delim"*) die "env template contains the heredoc delimiter '$tpl_delim'" ;; esac
  local cfg
  cfg="$(
    echo "# runnerctl config — generated by \`runnerctl migrate\` from $from on $(date +%F)."
    echo "# Sourced as bash: keep it root-owned and not world-writable. Hand-edits are"
    echo "# expected; \`runnerctl config-example\` documents every knob."
    echo "# Values were lifted from the inline profiles of the pre-config runnerctl and"
    echo "# reconciled against the drop-ins live on this host at migration time."
    echo
    echo "# The old script managed this drop-in name; keeping it means the new script"
    echo "# keeps managing the same file instead of adding a second one beside it."
    echo "DROPIN_NAME=$(sq "$l_dropin")"
    [ -z "$l_default" ] || [ "$l_default" = "$BUILTIN_DEFAULT_PROFILE" ] || echo "DEFAULT_PROFILE=$(sq "$l_default")"
    [ -z "$l_glob" ] || [ "$l_glob" = "$BUILTIN_UNIT_GLOB" ] || echo "UNIT_GLOB=$(sq "$l_glob")"
    for p in "${profiles[@]}"; do
      echo
      echo "profile_$p() {"
      echo "  PROFILE_DESC=$(sq "${DESC[$p]}")"
      echo "  MEM_MAX=$(sq "${MAX[$p]}")"
      echo "  MEM_HIGH=$(sq "${HIGH[$p]}")"
      echo "  RESTART_SEC=$(sq "${RS[$p]}")"
      echo "  ENV_FILE=$(sq "${ENV[$p]}")"
      echo "}"
    done
    if [ -n "$template" ]; then
      for p in "${profiles[@]}"; do
        [ -n "${ENV[$p]}" ] || continue
        echo
        echo "# env-init template for '$p' (placeholders only; the live file stays on the box)."
        echo "env_template_$p() {"
        echo "  cat <<'$tpl_delim'"
        printf '%s' "$template"
        echo "$tpl_delim"
        echo "}"
      done
    fi
  )"

  # 4. Write it (or show it).
  local written
  if $dry_run; then
    written="$(mktemp)"; printf '%s\n' "$cfg" >"$written"
    echo; printf '%s\n' "$cfg"; echo
    echo "(dry run — nothing written; would go to $out)"
  else
    if [ -e "$out" ]; then
      echo "$out already exists — not overwriting it; writing $out.migrated instead"
      out="$out.migrated"
    fi
    local priv=() newroot=false
    ! needs_priv "$out" || { priv=(run_priv); newroot=true; }
    # GHR-117: mkdir, tee, chown and chmod are four calls on one name, so they
    # are root's only in a directory nobody else can write (write_as).
    write_as "$(dirname "$out")" "write $out" "$out"
    [ "${#WRITE_AS[@]}" -eq 0 ] || priv=("${WRITE_AS[@]}")
    local wuser="$WRITE_USER"
    [ -z "$WRITE_USER" ] || newroot=false
    "${priv[@]}" mkdir -p -m 755 "$(dirname "$out")"
    printf '%s\n' "$cfg" | "${priv[@]}" tee "$out" >/dev/null
    ! $newroot || run_priv chown root:root "$out"
    "${priv[@]}" chmod 644 "$out"
    written="$out"
    echo "Wrote $out"
    config_owner_notice "$out" "$wuser"
    case "$out" in *.migrated) echo; diff -u "${out%.migrated}" "$out" || true ;; esac
  fi

  # 5. Prove it: the generated config must render every live drop-in back.
  if [ "$n_live" -eq 0 ]; then
    echo "No live drop-ins to check against."
  else
    local bad=0 a b
    a="$(mktemp)"; b="$(mktemp)"
    for u in "${live_units[@]}"; do
      # Keys this renderer writes that the pre-config script never did
      # (OOMPolicy, MemorySwapMax — GHR-28) are dropped from the generated
      # side: a legacy drop-in cannot carry them, and the check is about
      # the profile VALUES having migrated. The next `apply` writes them.
      (
        # shellcheck disable=SC1090  # the file we just wrote
        . "$written"
        PROFILE="${LIVE_PROF[$u]}"; PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="10"; ENV_FILE=""
        load_profile; render_dropin
      ) | strip_ini | grep -vE '^(OOMPolicy|MemorySwapMax)=' >"$a" || true
      strip_ini "${LIVE_FILE[$u]}" >"$b"
      if ! cmp -s "$a" "$b"; then
        bad=$((bad+1))
        echo "  $u: generated config does NOT reproduce ${LIVE_FILE[$u]}:"
        diff "$b" "$a" | sed 's/^/    /' || true
      fi
    done
    rm -f "$a" "$b"
    [ "$bad" -eq 0 ] || { $dry_run && rm -f "$written"; die "$bad unit(s) differ — fix the profile in $out (or re-apply after migrating) and re-check"; }
    echo "verified: $n_live unit(s) render identically from the generated config"
    echo "(the next 'runnerctl apply' also adds OOMPolicy=continue and MemorySwapMax=0 to each drop-in)"
  fi
  $dry_run && rm -f "$written"
  $dry_run || echo "Next: runnerctl --config $out profiles   # then install the new runnerctl and run: runnerctl status"
}

# --- Install / self-upgrade ---------------------------------------------------
# Both fetch the script from UPGRADE_URL (optionally a specific branch/tag),
# verify it parses and carries a version, and put it in place by staged copy +
# rename, so a running copy keeps its old inode and is unaffected mid-execution.
# `upgrade` replaces the file it is running from; `install` also works when
# the script is being read from a pipe (curl … | bash -s -- install), finds or
# creates the install location, and migrates a pre-config install first.
remote_version() { grep -m1 '^RUNNERCTL_VERSION=' "$1" | cut -d'"' -f2; }

# True when bash is reading this script from stdin rather than a file. Inside
# a function BASH_SOURCE[0] is then "main" (bash 5.2) or "bash" (5.3), and $0
# is "bash" in both; a real file gives its path in both.
is_piped() {
  case "${BASH_SOURCE[0]:-}" in ''|main|bash) return 0 ;; esac
  [ "$0" = "bash" ] || [ "$0" = "-bash" ] || [ "$0" = "sh" ]
}

# a < b in version order
version_lt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ]; }

# UPGRADE_URL with REF applied (empty REF: as is). Two UPGRADE_URL shapes:
#   github.com/<owner>/<repo>/releases/...  a version-shaped REF (vX.Y.Z or
#     X.Y.Z, normalised to a leading v) maps to that release's asset; any
#     other REF (a branch or a commit) maps to the raw URL at that ref, so
#     people tracking `main` still can.
#   raw.githubusercontent.com/<owner>/<repo>/<ref>/...  REF replaces the ref
#     segment (today's behaviour, unchanged).
# Anything else with a REF dies naming both accepted shapes.
resolve_url() {
  local ref="$1" url="$UPGRADE_URL"
  [ -n "$ref" ] || { echo "$url"; return; }
  if [[ "$url" =~ ^https://github\.com/([^/]+)/([^/]+)/releases/ ]]; then
    local owner="${BASH_REMATCH[1]}" repo="${BASH_REMATCH[2]}"
    if [[ "$ref" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      local ver="$ref"; [[ "$ver" == v* ]] || ver="v$ver"
      url="https://github.com/${owner}/${repo}/releases/download/${ver}/runnerctl"
    else
      url="https://raw.githubusercontent.com/${owner}/${repo}/${ref}/runnerctl"
    fi
  elif [[ "$url" =~ ^(https://raw\.githubusercontent\.com/[^/]+/[^/]+/)[^/]+(/.*)$ ]]; then
    url="${BASH_REMATCH[1]}${ref}${BASH_REMATCH[2]}"
  else
    die "--ref only works with a github.com/<owner>/<repo>/releases/... or raw.githubusercontent.com UPGRADE_URL (have: $url)"
  fi
  echo "$url"
}

# --- Verifying the download (GHR-84) -------------------------------------------
# `bash -n` and a RUNNERCTL_VERSION line catch a truncated file or an HTML
# error page; they do not establish that the bytes are the release. So each
# release also publishes `runnerctl.sha256` — one `sha256sum` line, written by
# the release job from the same tagged bytes it attaches — and a download from
# a release asset is checked against it before anything is written.
#
# What this protects against, and what it does not: the digest comes from the
# same origin as the script, so it catches corruption and a tampered mirror or
# proxy, not a compromised release (whoever can replace the asset can replace
# its digest). `--sha256 SUM` pins a digest obtained some other way.
#
# The digest URL for a script URL, empty when that source publishes none. The
# RULE: a GitHub release asset — `https://github.com/<owner>/<repo>/releases/
# latest/download/runnerctl` (the default UPGRADE_URL) or `…/releases/download/
# <tag>/runnerctl` (what `--ref vX.Y.Z` maps to) — has its digest beside it,
# the final `/runnerctl` replaced by `/runnerctl.sha256`. So does a `file://`
# URL ending in `/runnerctl`: a local mirror can carry the sibling file, and a
# missing one there is that source's 404. Anything else — a branch `--ref`
# (raw.githubusercontent.com), a mirror on another host — has none.
script_digest_url() { # URL
  if [[ "$1" =~ ^https://github\.com/[^/]+/[^/]+/releases/(latest/download|download/[^/]+)/runnerctl$ ]] \
     || [[ "$1" =~ ^file:///.*/runnerctl$ ]]; then
    printf '%s\n' "${1%/runnerctl}/runnerctl.sha256"
  fi
}

# Fetch the digest at URL into SCRIPT_DIGEST. Three outcomes, kept apart on
# purpose, and only ONE of them installs unverified:
#   0  a well-formed sha256sum line naming runnerctl: SCRIPT_DIGEST holds it
#   2  the source answered that there is none — HTTP 404 (every release before
#      the job published one), or a `file://` path that does not exist
#   3  anything else — a timeout, a 5xx, a refused connection, a body that is
#      not one sha256sum line. SCRIPT_DIGEST_ERR says which.
# 3 REFUSES rather than falling back to unverified: if every failure meant
# "no digest", anyone able to block or garble the one request for the digest
# would turn verification off for the download beside it.
SCRIPT_DIGEST="" SCRIPT_DIGEST_ERR=""
fetch_digest() { # URL FILE
  local url="$1" f="$2" code="" rc=0 line=""
  SCRIPT_DIGEST="" SCRIPT_DIGEST_ERR=""
  # No -f: a 404 has to come back as a status to tell apart from the rest.
  hb_start "download digest" # GHR-149
  code="$(curl -sSL --max-time 30 -w '%{http_code}' -o "$f" "$url" 2>/dev/null)" || rc=$?
  hb_stop
  if [ "$rc" -eq 0 ] && [ "$code" = 404 ]; then return 2; fi
  if [ "$rc" -eq 37 ] && [[ "$url" == file://* ]]; then return 2; fi
  if [ "$rc" -ne 0 ]; then
    SCRIPT_DIGEST_ERR="could not fetch $url (curl exit $rc)"; return 3
  fi
  if [ "$code" != 200 ] && [[ "$url" != file://* ]]; then
    SCRIPT_DIGEST_ERR="$url answered HTTP ${code:-?}"; return 3
  fi
  IFS= read -r line <"$f" || true
  if [[ "$line" =~ ^([0-9a-fA-F]{64})\ [\ *]runnerctl$ ]]; then
    SCRIPT_DIGEST="${BASH_REMATCH[1],,}"; return 0
  fi
  # The body is the remote's text, so it is not echoed back.
  SCRIPT_DIGEST_ERR="$url is not a sha256sum line for runnerctl"
  return 3
}

script_sha256() { # FILE
  command -v sha256sum >/dev/null || die "sha256sum is required to verify the download — not installing"
  sha256sum "$1" | awk '{print $1}'
}

# Download URL to DEST and refuse anything that does not parse, has no
# version, or does not match its digest — before the caller writes anything.
# PIN is a --sha256 the caller was handed: it replaces the published digest,
# which is then not fetched at all. One line says which way it went:
# `verified: …` or `not verified: <reason>`.
fetch_script() { # URL DEST [PIN]
  local url="$1" dest="$2" pin="${3:-}" durl="" want="" from="" got dtmp rc=0
  command -v curl >/dev/null || die "curl is required to download from $url"
  # GHR-149: up to 30 s of silence; a ticker beside it under --heartbeat.
  hb_start "download runnerctl"
  curl -fsSL --max-time 30 "$url" -o "$dest" || rc=$?
  hb_stop
  [ "$rc" -eq 0 ] || die "download failed: $url"
  bash -n "$dest" || die "downloaded script does not parse — not installing"
  [ -n "$(remote_version "$dest")" ] || die "downloaded file carries no RUNNERCTL_VERSION — not installing"
  if [ -n "$pin" ]; then
    want="$pin" from="--sha256"
  else
    durl="$(script_digest_url "$url")"
    if [ -z "$durl" ]; then
      echo "not verified: $url is not a release asset, so no digest is published for it (pass --sha256 SUM to pin one)"
      return 0
    fi
    dtmp="$(mktemp)"
    fetch_digest "$durl" "$dtmp" || rc=$?
    rm -f "$dtmp"
    if [ "$rc" -eq 2 ]; then
      echo "not verified: no digest is published beside this release ($durl was not found) — pass --sha256 SUM to pin one"
      return 0
    fi
    [ "$rc" -eq 0 ] || die "$SCRIPT_DIGEST_ERR — refusing to install unverified bytes when the digest could not be read (pass --sha256 SUM to pin one)"
    want="$SCRIPT_DIGEST" from="$durl"
  fi
  got="$(script_sha256 "$dest")"
  [ "$got" = "$want" ] || die "downloaded runnerctl does not match its digest — not installing (sha256 $got, want $want from $from)"
  echo "verified: sha256 ${want:0:12}… matches $from"
}

# Put SRC at DEST atomically, readable and executable by everyone: a runnerctl
# only root can run is the same as no runnerctl at all. An existing DEST keeps
# its owner and any extra bits it carries, widened to a+rx; a new one is
# root:root 755 when it took sudo to write, 755 otherwise.
#
# The mode is always an explicit octal, never `chmod +x` (GHR-47). A symbolic
# mode with no "who" is masked by the umask, so `chmod +x` is a+x *minus the
# umask* — and the bytes being staged are a mktemp download, mode 0600, which
# `cp` carries over. Under root's umask that landed 0700 (umask 077) or 0711
# (umask 022), and 0711 is broken too: running a #! script needs read as well
# as execute, so the invoking user got "Permission denied" either way while
# the install's own `"$target" version` proof passed as root.
#
# REF (default DEST) is the file whose owner and mode the result takes. It is
# not DEST only for `upgrade`'s rollback copy (GHR-84): `$target.prev` takes
# the owner and mode of the $target it is a copy of, not of whatever older
# `.prev` it replaces — and it is staged and renamed exactly like the script,
# so a failed copy never leaves a half-written `.prev` in place of a good one.
install_file() { # SRC DEST [REF]
  local src="$1" dest="$2" ref="${3:-$2}" dir staged mode=755
  dir="$(dirname "$dest")"; staged="$dir/.$(basename "$dest").new.$$"
  local priv=() newroot=false
  { [ -w "$dir" ] && { [ ! -e "$dest" ] || [ -w "$dest" ]; }; } || priv=(run_priv)
  # A new file is made root's only where it took sudo to write, as before.
  [ "${#priv[@]}" -eq 0 ] || newroot=true
  # GHR-117: four calls on names in DIR follow, and only a DIR nobody but root
  # can write makes them safe as root. write_as decides before the first one:
  # root's own calls (run_priv, which for a root process runs the call
  # itself), the calls as the one user who owns DIR, or a refusal.
  write_as "$dir" "install $dest" "$dest" "$ref"
  [ "${#WRITE_AS[@]}" -eq 0 ] || priv=("${WRITE_AS[@]}")
  local user="$WRITE_USER"
  # GHR-111: DIR can be one its owner writes (a script run in place from a
  # home), so every name here is theirs to plant. --remove-destination unlinks
  # STAGED and creates it exclusively, so a symlink planted at the predictable
  # `.new.<pid>` name is replaced instead of written through; -T below replaces
  # a DEST that is a symlink to a directory instead of moving STAGED into it.
  if [ -n "$user" ] && [ "$src" = "${DOWNLOAD_TMP:-}" ]; then
    # The download is root's mktemp, 0600: the user cannot open it, so it is
    # handed over on stdin, already open. Nothing else is opened by root.
    "${priv[@]}" rm -f -- "$staged"
    "${priv[@]}" tee -- "$staged" <"$src" >/dev/null
  else
    "${priv[@]}" cp --remove-destination "$src" "$staged"
  fi
  if [ -e "$ref" ]; then
    # As the user, REF is theirs already (write_as checked): nothing to chown.
    [ -n "$user" ] || "${priv[@]}" chown -h --reference="$ref" "$staged"
    # Keep what the admin set — setuid bits, a wider group — but never less
    # than a+rx, so a host already installed at 0700 heals on the next run
    # instead of staying unrunnable.
    mode="$(stat -c '%a' "$ref" 2>/dev/null || echo 755)"
    [[ "$mode" =~ ^[0-7]+$ ]] || mode=755
    mode="$(printf '%04o' "$(( 8#$mode | 8#0555 ))")"
  else
    ! $newroot || [ -n "$user" ] || run_priv chown root:root "$staged"
  fi
  "${priv[@]}" chmod "$mode" "$staged"
  "${priv[@]}" mv -fT "$staged" "$dest"
}

# --- Writes into a directory a user controls (GHR-117) -------------------------
# install_file, the renames that retire a copy, the directories install and
# upgrade create and migrate's config write are each calls on NAMES in one
# directory, several of them in a row. As root those names are safe only if
# nobody else can write the directory: whoever can swaps a name for a symlink
# between two calls, and the later call acts on whatever it points at. GHR-111's
# single-call protections (mv -T, cp --remove-destination, chown -h) cannot
# reach across calls. So before the first privileged call the directory's chain
# is read — metadata only, GHR-121's rule (dir_chain_problem) — and the write
# goes one of three ways:
#   - the chain is root's alone: root's own calls, as always;
#   - one non-root user controls the chain and owns every existing name the
#     write touches (a copy in ~/.local/bin under sudo): every call is made AS
#     THAT USER through runuser, with no chown, so a swapped name can only
#     redirect a write they could make anyway — GHR-121's deprovision rule;
#   - anything else (group- or world-writable, two owners, a name someone else
#     owns): refused, naming the directory and the remedy.
# A write this process can make without any privilege (not root, the directory
# and the names writable) is its own, and is not checked.

# "ok UID" when one non-root uid controls PATH's chain — every directory from /
# down is root's alone (root_exec_problem says nothing) or that uid's and not
# group- or world-writable, and the deepest existing one is that uid's — else
# "no WHY". A symlink component must be root's, as in dir_chain_problem.
dir_chain_owner() { # PATH
  local path="$1" p="" part owner mode problem uid="" deepest=/
  local -a parts
  problem="$(root_exec_problem /)"
  [ -z "$problem" ] || { echo "no $problem"; return 0; }
  IFS=/ read -ra parts <<<"${path#/}"
  for part in "${parts[@]}"; do
    [ -n "$part" ] || continue
    p+="/$part"
    if [ -L "$p" ]; then
      owner="$(stat -c %u "$p" 2>/dev/null || echo '?')"
      [ "$owner" = 0 ] || { echo "no $p is a symlink owned by uid $owner, not root"; return 0; }
      continue
    fi
    [ -e "$p" ] || break
    deepest="$p"
    problem="$(root_exec_problem "$p")"
    [ -n "$problem" ] || continue
    owner="$(stat -c %u "$p" 2>/dev/null || echo '?')"
    mode="$(stat -c %a "$p" 2>/dev/null || echo '?')"
    [[ "$owner" =~ ^[1-9][0-9]*$ ]] || { echo "no $problem"; return 0; }
    case "${mode: -2:1}${mode: -1}" in
      *[2367]*) echo "no $p is group- or world-writable (mode $mode)"; return 0 ;;
    esac
    [ -z "$uid" ] || [ "$uid" = "$owner" ] || { echo "no $p is owned by uid $owner, and a directory above it by uid $uid"; return 0; }
    uid="$owner"
  done
  [ -n "$uid" ] || { echo "no no single user owns $path"; return 0; }
  owner="$(stat -c %u "$deepest" 2>/dev/null || echo '?')"
  [ "$owner" = "$uid" ] || { echo "no $deepest is owned by uid $owner, inside a directory uid $uid owns"; return 0; }
  echo "ok $uid"
}

# Sets WRITE_AS — the prefix for every call of a write of NAME... in DIR — and
# WRITE_USER: () when this process writes them itself, (run_priv) when DIR's
# chain is root's alone, (run_priv runuser -u USER --) with WRITE_USER=USER when
# one user controls it. Dies otherwise, before any privileged call. WHAT is the
# write, for the refusal ("install /path/runnerctl").
WRITE_AS=()
WRITE_USER=""
write_as() { # DIR WHAT [NAME...]
  local dir="$1" what="$2" e n need=false r canon a b owner user uid why
  shift 2
  WRITE_AS=(); WRITE_USER=""
  # A directory yet to be made is judged by the nearest one that exists, as
  # needs_priv does.
  e="$dir"
  while [ ! -e "$e" ] && [ ! -L "$e" ] && [ "$e" != / ]; do e="$(dirname "$e")"; done
  if as_root || [ ! -w "$e" ]; then need=true; fi
  for n in "$@"; do
    if [ -e "$n" ] && [ ! -w "$n" ]; then need=true; fi
  done
  $need || return 0
  canon="$(readlink -m -- "$dir" 2>/dev/null || printf '%s' "$dir")"
  r="$(dir_chain_problem "$dir")"
  [ -n "$r" ] || [ "$canon" = "$dir" ] || r="$(dir_chain_problem "$canon")"
  if [ -z "$r" ]; then WRITE_AS=(run_priv); return 0; fi
  a="$(dir_chain_owner "$canon")"
  if [ "$canon" != "$dir" ] && [[ "$a" == ok* ]]; then
    b="$(dir_chain_owner "$dir")"
    case "$b" in
      "$a") ;;
      ok*) a="no $dir and $canon, which it resolves to, are not one user's" ;;
      *) a="$b" ;;
    esac
  fi
  why="${a#no }"
  if [[ "$a" == ok* ]]; then
    uid="${a#ok }"
    for n in "$@"; do
      [ -e "$n" ] || [ -L "$n" ] || continue
      owner="$(stat -c %u "$n" 2>/dev/null || echo '?')"
      [ "$owner" = "$uid" ] && continue
      why="$n is owned by uid $owner, not by uid $uid who owns $dir"; uid=""; break
    done
    if [ -n "$uid" ]; then
      user="$(getent passwd "$uid" 2>/dev/null | cut -d: -f1 || true)"
      if [[ "$user" =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]]; then
        WRITE_USER="$user"; WRITE_AS=(run_priv runuser -u "$user" --)
        return 0
      fi
      why="$dir is owned by uid $uid, which has no user name to write as"
    fi
  fi
  # The remedy follows WHAT (GHR-139): a config write belongs in a root-only
  # config directory, not in the binary's.
  local fix="Move the copy to a directory only root can write, such as /usr/local/bin"
  case "$what" in
    save\ *|write\ *) fix="Keep the config in a directory only root can write, such as /etc/runnerctl/" ;;
  esac
  die "refusing to $what as root: $why — whoever can write $dir could swap a name in it between root's calls (GHR-117). $fix, or run this as the user who owns $dir, without sudo"
}

# Rename a copy out of the way: OLD to NEW, in OLD's directory. -T (GHR-111): a
# NEW that is a symlink to a directory is replaced, never entered — otherwise
# `mv` would move OLD into whatever directory that is.
retire_copy() { # OLD NEW
  write_as "$(dirname "$1")" "retire $1" "$1" "$2"
  "${WRITE_AS[@]}" mv -fT "$1" "$2"
}

# Create DIR (and its missing parents) at an explicit 755 (GHR-47: under
# root's umask 077 it would be 0700, and nobody else could reach the binary or
# the config). An existing directory is left exactly as the admin has it.
make_dir() { # DIR WHAT
  [ ! -d "$1" ] || return 0
  write_as "$1" "$2"
  "${WRITE_AS[@]}" mkdir -p -m 755 "$1"
}

# --- Where an upgrade should land (GHR-52) ------------------------------------
# `upgrade` used to rewrite $self and nothing else, which heals the VERSION and
# never the PLACEMENT. A runnerctl in ~/.local/bin then gets upgraded forever
# inside a directory no non-interactive ssh can see: `fleet` reports `remote
# exit 127` for a host whose owner can type `runnerctl` all day and see it
# work. Three hosts of four were in exactly that state (GHR-51), and nothing
# in the tool was ever going to say so.
#
# So upgrade picks a target the way install does. The privilege rule is the
# conservative half: it does whatever part of the heal costs no password, and
# NAMES the rest. Never a prompt — `fleet upgrade` fans this out, and a sudo
# prompt would hang the fan-out once per host, which is precisely the failure
# BatchMode=yes exists to prevent on the ssh side.

# The invoking user's home — $SUDO_USER's when set, which is the same rule
# find_home_runnerctl uses, so install and upgrade always agree on whose home
# is in question.
invoking_home() {
  if [ -n "${SUDO_USER:-}" ]; then
    getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true
  else
    printf '%s\n' "${HOME:-}"
  fi
}

# Is PATH inside that home? A resolved PREFIX test, never a glob: a home of
# /home/jon must not swallow /home/jonathan/bin/runnerctl, and the trailing
# slash is what stops it.
under_home() { # PATH
  local rp hp
  hp="$(invoking_home)"
  [ -n "$hp" ] || return 1
  rp="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
  hp="$(readlink -f "$hp" 2>/dev/null || printf '%s' "$hp")"
  [ -n "$hp" ] || return 1
  [ "${rp#"$hp"/}" != "$rp" ]
}

# Can a file be placed at PATH without asking a human for anything? Writable
# already, or root, or sudo is configured passwordless. `sudo -n` is the whole
# point: it fails fast instead of prompting.
priv_is_free() { # DEST
  # Exactly the two conditions install_file itself checks, because a DEST whose
  # file is writable inside a directory that is NOT still cannot be replaced:
  # install_file stages `$dir/.runnerctl.new.$$` first. Testing the file alone
  # said "free", then the staging copy hit sudo anyway.
  #
  # needs_priv walks up to the nearest existing ancestor, so a prefix that does
  # not exist yet is judged by the directory that will come to hold it.
  if ! needs_priv "$(dirname "$1")" && { [ ! -e "$1" ] || [ -w "$1" ]; }; then
    return 0
  fi
  [ "$(id -u)" -ne 0 ] || return 0
  sudo -n true 2>/dev/null
}

# --- Rolling back (GHR-84) ------------------------------------------------------
# `upgrade` keeps the script it replaces as `<target>.prev`; `upgrade
# --rollback` renames that back over the running copy. A rename, not a copy:
# atomic, same owner and mode as the .prev was given (the script's own, at the
# time it was kept), and nothing downloaded — a host whose new release
# misbehaves needs no working network path, and no working download code, to
# get back.
#
# The rollback CONSUMES .prev: a second `--rollback` finds none and refuses.
# Keeping the rolled-back-from file as the new .prev would make `--rollback`
# a toggle whose direction depends on history nobody can see from the
# command line, and `.prev` would then sometimes hold a NEWER script than the
# one installed. Going forward again is `upgrade` (or `upgrade --ref vX.Y.Z`).
#
# The version printed comes from the .prev file, so it is validated as a
# version before it is printed: `fleet upgrade --rollback` relays this output
# to the central node and reads the version out of the sentence.

# The `rollback:` line `upgrade --check` prints.
upgrade_rollback_line() { # TARGET
  local prev="$1.prev" v
  if [ ! -e "$prev" ] && [ ! -L "$prev" ]; then
    echo "rollback: none (no $prev)"
    return 0
  fi
  v="$(remote_version "$prev" 2>/dev/null || true)"
  if [ -f "$prev" ] && [ ! -L "$prev" ] && valid_runner_version "$v"; then
    echo "rollback: $v ($prev)"
  else
    echo "rollback: unusable ($prev is not a runnerctl with a valid version)"
  fi
}

upgrade_rollback() { # TARGET
  local target="$1" prev="$1.prev" prev_ver dir
  if [ ! -e "$prev" ] && [ ! -L "$prev" ]; then
    die "no rollback copy at $prev — nothing to roll back to (an upgrade keeps the version it replaced there; a fresh install, or a rollback already made, leaves none)"
  fi
  prev_ver="$(remote_version "$prev" 2>/dev/null || true)"
  if [ ! -f "$prev" ] || [ -L "$prev" ] || ! valid_runner_version "$prev_ver" \
     || ! looks_like_runnerctl "$prev" || ! bash -n "$prev" 2>/dev/null; then
    die "$prev is not a runnerctl with a valid version — not rolling back to it"
  fi
  # GHR-89: under the narrow contract the file put back is the one every later
  # sudo run executes, so it is held to the rule this run's own file was.
  if $SUDO_NARROW; then
    local problem; problem="$(root_exec_problem "$prev")"
    [ -z "$problem" ] || die "refusing to roll back to $prev under sudo: $problem — the script a sudoers grant names must be writable by root alone"
  fi
  dir="$(dirname "$target")"
  # GHR-117: the same directory rule as install_file — the rename is root's
  # only in a directory nobody else can write, the owner's in theirs.
  write_as "$dir" "roll back $target" "$target" "$prev"
  echo "installed: $RUNNERCTL_VERSION ($target)"
  echo "rollback: $prev_ver ($prev)"
  "${WRITE_AS[@]}" mv -fT "$prev" "$target"   # -T: GHR-111, a symlinked $target is replaced, never entered
  echo "Rolled back $RUNNERCTL_VERSION -> $prev_ver at $target"
  # The proof comes from the installed file, as install's does.
  echo
  "$target" version
}

cmd_upgrade() {
  local check=false ref="" prefix="" relocate=true rollback=false sha_pin=""
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --check)       check=true; shift ;;
      --ref)         need_val "$@"; ref="$2"; shift 2 ;;
      # GHR-84: provision's flag and provision's validation, for this script.
      --sha256)      need_val "$@"; sha_pin="$2"; shift 2 ;;
      --rollback)    rollback=true; shift ;;
      # Where a home copy is moved TO. Mirrors install's flag, and is what
      # makes any of this testable without writing to a real /usr/local/bin.
      --prefix)      need_val "$@"; prefix="${2%/}"; shift 2 ;;
      # For a deliberately personal copy: upgrade exactly where it stands.
      --no-relocate) relocate=false; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -z "$sha_pin" ] || [[ "$sha_pin" =~ ^[0-9a-f]{64}$ ]] || die "--sha256 '$sha_pin' is invalid — want 64 lowercase hex characters"
  local self url new_ver sys sys_ver=""
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  if $rollback; then
    # Every other flag is about a download or a placement, and a rollback
    # makes neither: refused rather than silently ignored.
    if $check || [ -n "$ref$sha_pin$prefix" ] || ! $relocate; then
      die "--rollback takes no other option — it downloads nothing and moves nothing, it puts $self.prev back ('runnerctl upgrade --check' names the rollback copy)"
    fi
    audit_begin upgrade --rollback
    caller_guard # GHR-137, as below
    upgrade_rollback "$self"
    return 0
  fi
  [ -n "$prefix" ] || prefix="/usr/local/bin"
  sys="$prefix/runnerctl"
  url="$(resolve_url "$ref")"
  DOWNLOAD_TMP="$(mktemp)"; trap 'rm -f "$DOWNLOAD_TMP"' EXIT
  fetch_script "$url" "$DOWNLOAD_TMP" "$sha_pin"
  new_ver="$(remote_version "$DOWNLOAD_TMP")"
  if ! $check; then
    audit_begin upgrade "${new_ver:+to $new_ver}" "${ref:+--ref $ref}"
    # GHR-137: cut off between keeping .prev and placing the new file, or
    # between placing it and retiring a home copy, the host is left with
    # neither placement. The relays are this process's own children, already
    # running from memory, so replacing the script on disk does not touch
    # them; the download's cleanup is EXIT_CMD, run after they are closed.
    caller_guard
  fi

  # --- placement -------------------------------------------------------------
  # target  = the file to write, empty when this call must not write one
  # cur_*   = what the fleet runs TODAY, which is not $self once $self is a
  #           shadowed home copy — and it is cur_ver the version gates compare
  # retire  = the home copy to rename out of the way, empty to leave it
  local homecopy=false
  if $relocate && [ "$self" != "$sys" ] && under_home "$self"; then homecopy=true; fi
  if $homecopy && [ -e "$sys" ] && looks_like_runnerctl "$sys"; then
    sys_ver="$(remote_version "$sys")"
  fi
  local target="$self" cur_ver="$RUNNERCTL_VERSION" cur_path="$self" retire="" note=""
  if $homecopy; then
    if priv_is_free "$sys"; then
      target="$sys"; retire="$self.retired"
      if [ -n "$sys_ver" ]; then
        cur_ver="$sys_ver"; cur_path="$sys"
        note="note: $sys (runnerctl $sys_ver) is shadowed by this copy — you type one and 'fleet' runs the other"
      else
        note="note: this copy is not on the PATH a non-interactive ssh gets, so 'fleet' cannot run it"
      fi
    elif [ -n "$sys_ver" ] && ! version_lt "$sys_ver" "$RUNNERCTL_VERSION"; then
      # $sys cannot be written without a password, but it already holds a
      # runnerctl at least as new as this one — so retiring the shadow on its
      # own is a strict improvement and costs no privilege at all. Never
      # retire a shadow over an OLDER $sys: that would quietly downgrade what
      # the user gets when they type `runnerctl`.
      target=""; cur_ver="$sys_ver"; cur_path="$sys"; retire="$self.retired"
      # Absolute here too. This one happens to resolve today because $sys is
      # under /usr/local/bin, which IS on secure_path — but that is luck of
      # the default prefix, not construction, and a --prefix elsewhere would
      # break it silently.
      note="note: $sys (runnerctl $sys_ver) is shadowed by this copy — retiring this one; run 'sudo $sys upgrade' to move it on"
    else
      # ABSOLUTE path, not the bare name (GHR-53). sudo resets PATH to
      # secure_path, which does not include ~/.local/bin — the very fact this
      # sentence is complaining about one clause earlier. `sudo runnerctl
      # install` therefore died with "command not found" on the first real
      # host to read this note.
      note="note: this copy is not on the PATH a non-interactive ssh gets, so 'fleet' cannot run it. To move it: sudo $self install"
    fi
  fi

  echo "installed: $cur_ver ($cur_path)"
  echo "available: $new_ver ($url)"
  [ -z "$note" ] || echo "$note"
  # GHR-84: whether `--rollback` has anything to go back to. Additive, and
  # never the last line, so fleet_upgrade_classify reads past it.
  ! $check || upgrade_rollback_line "$self"

  # These four sentences are a PARSED CONTRACT, not prose: fleet_upgrade_report
  # greps ^Upgraded, ^Already up to date\. (with the period), ^Update
  # available\. and `not downgrading`, and counts anything it cannot classify
  # as a failed host. Every line this function added above is additive and on
  # its own line for exactly that reason. Do not reword them. (A fifth,
  # `Rolled back A -> B at PATH`, is upgrade_rollback's — GHR-84.)
  # "same" is about the VERSION, so it compares against the file that holds
  # cur_ver today ($cur_path) — never against $target, which does not exist yet
  # when this call is relocating. Getting that backwards reports
  # "Upgraded 0.10.3 -> 0.10.3" for a host whose only real problem was where
  # the file lived.
  local same=false
  if [ "$new_ver" = "$cur_ver" ] && cmp -s "$DOWNLOAD_TMP" "$cur_path" 2>/dev/null; then
    same=true
  fi
  if $same && [ -z "$retire" ]; then
    echo "Already up to date."; return 0
  fi
  if [ -z "$ref" ] && version_lt "$new_ver" "$cur_ver"; then
    echo "Remote is older than installed — not downgrading (pass --ref to force a specific version)."
    return 0
  fi
  if $check; then
    if [ -n "$retire" ]; then
      if [ -n "$target" ] && [ "$target" != "$self" ] && [ -z "$sys_ver" ]; then
        echo "would relocate: $self -> $target"
      fi
      echo "would retire: $retire"
    fi
    if $same; then echo "Already up to date."; else echo "Update available. Run: runnerctl upgrade"; fi
    return 0
  fi
  # GHR-117: every directory this upgrade writes in is judged before the first
  # write, so a refusal leaves everything as it was. Each write asks again.
  # $target's OWN directory, never $prefix: with --no-relocate (or any
  # in-place upgrade) $target is $self and $prefix is merely the default
  # that was not used, so creating it would conjure an empty /usr/local/bin
  # on a host that had deliberately opted out.
  local tdir=""
  [ -z "$target" ] || { tdir="$(dirname "$target")"; write_as "$tdir" "upgrade $target" "$target" "$target.prev"; }
  [ -z "$retire" ] || write_as "$(dirname "$self")" "retire $self" "$self" "$retire"
  # Gated on what $target actually holds, NOT on $same: a relocation must place
  # the file even when the version is unchanged, because the version was never
  # the problem — a same-version copy in ~/.local/bin is exactly the host the
  # fan-out cannot reach.
  if [ -n "$target" ] && ! cmp -s "$DOWNLOAD_TMP" "$target" 2>/dev/null; then
    # Same explicit mode as install, and for the same reason (GHR-47): under
    # root's umask 077 a freshly created prefix is 0700 and nobody but root
    # can traverse it to reach the binary.
    make_dir "$tdir" "create $tdir"
    # GHR-84: keep what is being replaced as $target.prev, BEFORE the swap and
    # through the same privilege path, owner and explicit-octal mode as the
    # script itself. Exactly one is kept — the version immediately before —
    # so an existing .prev is replaced, by staged rename. A relocation onto a
    # fresh $target replaces nothing and keeps nothing; neither does a
    # pre-config script, which has no version to roll back to.
    if [ -f "$target" ] && [ -n "$(remote_version "$target" 2>/dev/null || true)" ]; then
      install_file "$target" "$target.prev" "$target"
      echo "kept: $(remote_version "$target") as $target.prev ('runnerctl upgrade --rollback' puts it back)"
    fi
    install_file "$DOWNLOAD_TMP" "$target"
  fi
  if [ -n "$retire" ]; then
    # Renaming the script that is currently running is safe: the rename keeps
    # the inode, and bash is reading it through an open descriptor.
    # -T (GHR-111): $retire is a name in a directory the invoking user owns. A
    # symlink to a directory planted there would make plain `mv -f` move $self
    # INTO that directory — as root under sudo. -T replaces the name instead,
    # and under sudo the rename is that user's own (GHR-117, retire_copy).
    retire_copy "$self" "$retire"
    if [ -n "$target" ] && [ "$target" != "$self" ] && [ -z "$sys_ver" ]; then
      echo "relocated: $self -> $target"
    fi
    echo "retired: $retire"
  fi
  if $same; then
    echo "Already up to date."
  elif [ -z "$target" ]; then
    # Retire-only: the shadow is gone, but $sys still needs a privileged write
    # and this call never made one. Claiming an upgrade here would be a plain
    # false report of work that did not happen.
    # Absolute, same reason as the notes above (GHR-53). Only the "^Update
    # available." prefix is parsed by fleet_upgrade_report, so naming the path
    # here costs nothing and stops the sentence depending on secure_path
    # happening to contain $sys.
    echo "Update available. Run: sudo $sys upgrade"
  else
    echo "Upgraded $cur_ver -> $new_ver at $target"
  fi
}

# Under sudo PATH is secure_path, so a runnerctl the invoking user runs from
# ~/.local/bin or ~/bin is invisible to command -v — the usual shape of a
# pre-config install. Look in those two directories of $SUDO_USER's home (of
# $HOME without sudo) and set HOME_COPY / HOME_HOW for the caller, empty when
# there is none. Their real PATH is not scanned: that needs a walk of
# /proc/<pid>/environ, and the two conventional directories cover the real case.
find_home_runnerctl() {
  local home d
  HOME_COPY=""; HOME_HOW=""
  if [ -n "${SUDO_USER:-}" ]; then
    home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
    HOME_HOW="in $SUDO_USER's home via \$SUDO_USER, not on PATH"
  else
    home="${HOME:-}"
    HOME_HOW="in \$HOME, not on PATH"
  fi
  [ -n "$home" ] || return 0
  for d in "$home/.local/bin" "$home/bin"; do
    [ -f "$d/runnerctl" ] || continue
    if looks_like_runnerctl "$d/runnerctl"; then HOME_COPY="$d/runnerctl"; return 0; fi
    echo "note: $d/runnerctl ($HOME_HOW) is not a runnerctl script — ignoring it"
  done
}

cmd_install() {
  local prefix="" ref="" migrate=true dry_run=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix)     [ $# -ge 2 ] || die "--prefix needs a directory"; prefix="${2%/}"; shift 2 ;;
      --ref)        [ $# -ge 2 ] || die "--ref needs a value"; ref="$2"; shift 2 ;;
      --no-migrate) migrate=false; shift ;;
      --dry-run)    dry_run=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  # Source of the new bytes: this very file when it is a real, versioned one
  # (a checkout, a downloaded copy), else a download — always when piped.
  local src new_ver
  if ! is_piped && [ -z "$ref" ] && [ -n "$(remote_version "${BASH_SOURCE[0]}")" ]; then
    src="$(readlink -f "${BASH_SOURCE[0]}")"
    echo "source: $src (this file)"
  else
    local url; url="$(resolve_url "$ref")"
    DOWNLOAD_TMP="$(mktemp)"; trap 'rm -f "$DOWNLOAD_TMP"' EXIT
    fetch_script "$url" "$DOWNLOAD_TMP"
    src="$DOWNLOAD_TMP"
    echo "source: $url"
  fi
  new_ver="$(remote_version "$src")"
  # GHR-153: what `fleet upgrade --push` runs remotely. Cut off between the
  # migrate and the placement, or between placing the new file and retiring a
  # home copy, the host is left half-moved. The download (and its heartbeat
  # ticker) is over by here; the relays are this process's own children, so
  # the pushed file or the pipe it was read from going away does not touch
  # them, and nothing after this asks the operator anything.
  if ! $dry_run; then
    audit_begin install "$new_ver" "${ref:+--ref $ref}" "$($migrate || echo --no-migrate)"
    caller_guard
  fi

  # Target: where runnerctl already is, else /usr/local/bin. A copy in the
  # invoking user's home that PATH does not reach never moves the target —
  # root-invoked tooling does not live in a home directory — but it is found.
  local existing target
  existing="$(command -v runnerctl 2>/dev/null || true)"
  HOME_COPY=""; HOME_HOW=""
  [ -n "$existing" ] || find_home_runnerctl
  if [ -z "$prefix" ]; then
    if [ -n "$existing" ]; then prefix="$(dirname "$(readlink -f "$existing")")"; else prefix="/usr/local/bin"; fi
  fi
  target="$prefix/runnerctl"
  echo "target: $target"
  if needs_priv "$target"; then
    [ "$(id -u)" -eq 0 ] || command -v sudo >/dev/null || die "$prefix is not writable and there is no sudo — run as root"
  fi
  if [ -n "$HOME_COPY" ] && [ -e "$target" ] && [ "$(readlink -f "$HOME_COPY")" = "$(readlink -f "$target")" ]; then
    HOME_COPY=""   # --prefix pointed at it: it is simply the target
  fi

  # What is there already decides the path: nothing, a pre-config install, or
  # a versioned one. When the target is missing, a home copy stands in for it
  # — migrated or version-checked the same way — except that the new file
  # lands at $target and the old one is renamed out of the way afterwards, so
  # the user does not keep running it from a PATH entry ahead of $prefix.
  local fresh=false old="" where="" retired=""
  if [ -e "$target" ]; then
    looks_like_runnerctl "$target" || die "$target exists but is not a runnerctl script — refusing to overwrite it"
    old="$target"; where="at $target"
    [ -z "$HOME_COPY" ] || echo "note: another runnerctl at $HOME_COPY ($HOME_HOW) is left alone — remove it if it shadows $target"
  elif [ -n "$HOME_COPY" ]; then
    old="$HOME_COPY"; where="at $HOME_COPY ($HOME_HOW)"
    if is_legacy_script "$old"; then retired="$old.legacy"; else retired="$old.retired"; fi
  fi
  # GHR-117: every directory this install writes in — the prefix, the config's
  # (migrate writes there first), and the retired copy's — is judged before
  # the first write, a dry run included, so a refusal leaves everything as it
  # was. Each write asks again.
  local confdir; confdir="$(dirname "$CONFIG_FILE")"
  write_as "$prefix" "install $target" "$target" "$target.legacy"
  write_as "$confdir" "write $CONFIG_FILE" "$CONFIG_FILE"
  [ -z "$retired" ] || write_as "$(dirname "$old")" "retire $old" "$old" "$retired"
  if [ -n "$old" ]; then
    if is_legacy_script "$old"; then
      echo "existing: pre-config runnerctl (no RUNNERCTL_VERSION) $where"
      if ! $migrate; then
        echo "--no-migrate: its inline values will NOT be carried into $CONFIG_FILE."
        echo "A copy is kept at $old.legacy so 'runnerctl migrate --from $old.legacy' can do it later."
      elif $dry_run; then
        echo "would run: runnerctl migrate --from $old   (writes $CONFIG_FILE, verified against the live drop-ins)"
      else
        echo "--- migrate ---"
        cmd_migrate --from "$old"   # dies on any failure, leaving $old untouched
        echo "--- migrate done ---"
      fi
    else
      local cur; cur="$(remote_version "$old")"
      echo "existing: runnerctl $cur $where"
      if [ -z "$retired" ] && cmp -s "$src" "$target"; then
        echo "Already up to date ($cur at $target)."
        "$target" version; return 0
      fi
      if [ -z "$ref" ] && version_lt "$new_ver" "$cur"; then
        echo "Installed $cur is newer than $new_ver — not downgrading (pass --ref to force a version)."
        return 0
      fi
      if [ -z "$retired" ]; then echo "upgrade: $cur -> $new_ver"; else echo "move: $cur at $old -> $new_ver at $target"; fi
    fi
  else
    fresh=true
    echo "existing: none — fresh install of $new_ver"
  fi

  if $dry_run; then
    echo "(dry run — would install runnerctl $new_ver at $target; nothing changed)"
    [ -z "$retired" ] || echo "(dry run — would then retire $old as $retired)"
    return 0
  fi
  if [ "$old" = "$target" ] && is_legacy_script "$target" && ! $migrate; then
    install_file "$target" "$target.legacy"
  fi
  # Both directories are created with an explicit mode for the same reason the
  # file is (GHR-47): under root's umask 077 a freshly created /usr/local/bin
  # or /etc/runnerctl is 0700, and a non-root user cannot then traverse it to
  # reach the binary or read the config. An existing directory is left exactly
  # as the admin has it (make_dir).
  make_dir "$prefix" "create $prefix"
  install_file "$src" "$target"
  make_dir "$confdir" "create $confdir"
  echo "Installed runnerctl $new_ver at $target"
  if [ -n "$retired" ]; then
    # After the new file is in place, never before: a failure here leaves both
    # copies rather than none.
    # -T (GHR-111): see the same rename in cmd_upgrade — $retired is a name the
    # invoking user can have planted as a symlink to a directory; under sudo
    # the rename is that user's own (GHR-117, retire_copy).
    retire_copy "$old" "$retired"
    echo "Retired $old as $retired — $target is the one to run now."
  fi
  if $fresh; then
    echo
    echo "Next:"
    echo "  runnerctl status"
    echo "  runnerctl config-example | sudo tee $CONFIG_FILE   # then edit for this host"
    echo "  runnerctl profiles"
  fi
  # The proof comes from the installed file, not from this process.
  echo
  "$target" version
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

main() {
  if [ $# -gt 0 ]; then
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
  fi
  local cfg_flag=false
  if [ "${1:-}" = "--config" ]; then
    need_val "$@"
    CONFIG_FILE="$2"; shift 2; cfg_flag=true
    CONFIG_CHOSEN=""; [ "$CONFIG_FILE" = "$CONFIG_DEFAULT" ] || CONFIG_CHOSEN=--config
  fi
  # GHR-88: `--origin OPERATOR@HOST`, which `fleet` puts in front of every
  # verb that changes a host. Taken off before anything reads the command line
  # — sudo's preflight included — and kept as a string: it is checked against
  # origin_valid once the environment is settled, written into the record, and
  # reaches no path, config, command or decision. Under the narrow sudo
  # contract it is therefore taken as given (README, the per-flag table).
  #
  # GHR-149: `--heartbeat N` beside it, in either order — the cadence every
  # phase that can block keeps (A heartbeat for the central node, above).
  # Refused at once when it is not whole seconds 1..3600, before anything is
  # done; set once the config is loaded, so a config cannot override it.
  local origin_arg="" have_origin=false hb_arg="" have_hb=false
  while :; do
    case "${1:-}" in
      --origin=*)    set -- --origin "${1#--origin=}" "${@:2}" ;;
      --heartbeat=*) set -- --heartbeat "${1#--heartbeat=}" "${@:2}" ;;
      --origin)
        ! $have_origin || break
        need_val "$@"
        origin_arg="$2" have_origin=true; shift 2 ;;
      --heartbeat)
        ! $have_hb || break
        need_val "$@"
        heartbeat_valid "$2" || die "--heartbeat needs whole seconds, 1 to 3600 (got '$2')"
        hb_arg="$2" have_hb=true; shift 2 ;;
      *) break ;;
    esac
  done
  # GHR-89: before the config is looked at — even whether it exists, which
  # under sudo would answer for a path the caller cannot see.
  # The environment is pinned under every sudo (harmless where the caller is
  # root anyway); the refusals only where the host opted in, a decision read
  # from the default config alone.
  if under_sudo; then
    sudo_env_harden
    [ "$(sudo_contract_of_default)" = full ] || SUDO_NARROW=true
    ! $SUDO_NARROW || sudo_preflight "$@"
  fi
  ! $cfg_flag || [ -f "$CONFIG_FILE" ] || die "config file $CONFIG_FILE not found"
  load_config
  ! $have_origin || audit_origin_take "$origin_arg"
  if $have_hb; then HEARTBEAT="$hb_arg"; else HEARTBEAT=""; fi
  local cmd="${1:-status}"; shift || true
  if is_piped; then
    case "$cmd" in
      install|version|--version) ;;
      *) die "running from a pipe — only 'install' works that way. Install first: curl -fsSL $UPGRADE_URL | sudo bash -s -- install" ;;
    esac
  fi
  case "$cmd" in
    install)            cmd_install "$@" ;;
    provision)          cmd_provision "$@" ;;
    deprovision)        cmd_deprovision "$@" ;;
    status)             cmd_status "$@" ;;
    watch)              cmd_status --watch "$@" ;;
    apply)              cmd_apply "$@" ;;
    scale)              cmd_scale "$@" ;;
    env-init)           cmd_env_init "$@" ;;
    start|stop|restart) cmd_ctl "$cmd" "$@" ;;
    drain)              AUDIT_AS=drain cmd_ctl stop --when-idle "$@" ;;
    enable|disable)     cmd_toggle "$cmd" "$@" ;;
    logs)               cmd_logs "$@" ;;
    remove-limits)      cmd_remove_limits "$@" ;;
    reap)               cmd_reap "$@" ;;
    kill)               cmd_kill "$@" ;;
    compose-reap)       cmd_compose_reap "$@" ;;
    compose-reap-timer) cmd_compose_reap_timer "$@" ;;
    health)             cmd_health "$@" ;;
    history)            cmd_history "$@" ;;
    fleet)              cmd_fleet "$@" ;;
    profiles)           cmd_profiles "$@" ;;
    config-example)     cmd_config_example ;;
    migrate)            cmd_migrate "$@" ;;
    upgrade)            cmd_upgrade "$@" ;;
    version|--version)  echo "runnerctl $RUNNERCTL_VERSION" ;;
    -h|--help|help)     usage ;;
    *) die "unknown command '$cmd' (status watch health history fleet provision deprovision apply scale env-init start stop restart drain enable disable logs remove-limits reap kill compose-reap compose-reap-timer profiles config-example migrate install upgrade version)" ;;
  esac
}

# RUNNERCTL_NO_MAIN=1 lets tests/run.sh source the script and call a helper
# (fmt_dur, ...) directly without running a command. Not a user-facing knob.
# Under sudo it can only make a run do nothing at all, which is no lever
# (GHR-89); every other RUNNERCTL_* hook is unset by sudo_env_harden.
if [ "${RUNNERCTL_NO_MAIN:-}" != 1 ]; then main "$@"; fi

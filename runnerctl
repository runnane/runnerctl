#!/usr/bin/env bash
# runnerctl — manage self-hosted GitHub Actions runner slots on this host.
#
# Runners are systemd services (actions.runner.<scope>.<name>.service), as
# GitHub's svc.sh installs them — or as `provision` writes the same unit
# itself (GHR-110). This tool applies a role PROFILE (memory caps, restart
# policy, on-device secrets) via systemd drop-in overrides — so the generated
# unit files are never hand-edited and the config survives a runner reinstall —
# plus reports status and scales the active pool.
#
# Built-in profiles (--profile, default: ci):
#   ci      CI build/test pool. Memory-capped + auto-restart. A step that
#           outgrows the cap is OOM-killed on its own (OOMPolicy=continue):
#           the job fails with a readable log, the runner stays up.
#   deploy  Dedicated deploy runner. Long-lived, auto-restart, secrets from a
#           root-owned on-device EnvironmentFile — NOT memory-capped.
#
# Site-specific settings (profile values, env templates, drop-in name) live in
# an optional config file, never in this script:
#   /etc/runnerctl/config            (or $RUNNERCTL_CONFIG, or --config PATH)
# See `runnerctl config-example` for a starting point.
#
# Nothing box-specific is hardcoded: runner units are discovered from systemd,
# so this runs on any runner host. Privileged operations re-exec via sudo.
#
# Usage:
#   runnerctl [--config PATH] [--origin OPERATOR@HOST] [--heartbeat N] <command> [args]
#
#   runnerctl provision N [--url URL] [--token TOK | --pat TOK] [--labels a,b] \
#                         [--name-prefix P] [--runner-user U] [--runner-root DIR] \
#                         [--runner-version X.Y.Z] [--sha256 SUM] [--replace] \
#                         [--dry-run]     ('provision --help' for all of them)
#   runnerctl deprovision <unit|slot-index|name>... [--token TOK | --pat TOK] \
#                         [--url URL] [--local-only] [--when-idle] [--timeout N] \
#                         [--yes] [--dry-run]
#   runnerctl status [--json | --with-json] [--watch|-w] [--interval N] [--once] \
#                    [--color auto|always|never] [--stall-after N] [--narrow]
#   runnerctl watch  [--interval N] [--color auto|always|never] [--stall-after N] \
#                    [--narrow]
#   runnerctl apply  [--profile NAME] [--max 26G] [--high 25G] \
#                    [--restart-sec N] [--env-file PATH] [--save] [--restart] \
#                    [--when-idle] [--timeout N] [<unit|slot-index|name> ...]
#   runnerctl scale N [--profile NAME] [--max 26G] [--high 25G] [--save] \
#                     [--restart] [--when-idle] [--timeout N]
#   runnerctl env-init [--profile NAME] [--env-file PATH]
#   runnerctl start|stop|restart [--when-idle] [--timeout N] \
#                                [--if-stalled] [--stall-after N] \
#                                [<unit|slot-index|name> ...]
#   runnerctl drain [--timeout N] [<unit|slot-index|name> ...]
#   runnerctl enable|disable <unit|slot-index|name> [<unit|slot-index|name> ...]
#   runnerctl logs [<unit|slot-index|name>] [-f|--follow] [-n N] \
#                  [--since WHEN] [-g PATTERN]
#   runnerctl remove-limits [<unit|slot-index|name> ...]
#   runnerctl reap [--dry-run] [<unit|slot-index|name> ...]
#   runnerctl kill [--dry-run] [--if-stalled] [--stall-after N] \
#                  [<unit|slot-index|name> ...]
#   runnerctl compose-reap [--apply] [--standalone] [--project NAME] \
#                          [--max-age-hours N] [--grace-minutes N]
#   runnerctl compose-reap-timer install|status [--brief]|remove
#   runnerctl health [--quiet|--json] [--max-restarts N] [--stall-after N] [--restart-stalled]
#   runnerctl history [-n N]
#   runnerctl fleet history [-n N] [--host H]...
#   runnerctl fleet status [--host H]... [--json] [--color auto|always|never] \
#                          [--stall-after N] [--narrow]
#   runnerctl fleet status --json --watch [--interval N] [--stall-after N]
#   runnerctl fleet watch  [--interval N] [--host H]... \
#                          [--color auto|always|never] [--stall-after N] [--narrow] \
#                          [--min-available K] [--problems] [--sort config|job|mem]
#   runnerctl fleet health [--host H]... [--quiet|--json] [--max-restarts N] \
#                          [--stall-after N] [--restart-stalled]
#   runnerctl fleet upgrade [--check] [--ref <branch|tag>] [--sha256 SUM] \
#                           [--host H]... [--canary [H]] [--serial] [--stop-on-failure]
#   runnerctl fleet upgrade --push [--check] [--host H]... [--canary [H]] [--serial] \
#                           [--stop-on-failure]
#   runnerctl fleet upgrade --rollback [--host H]... [--serial] [--stop-on-failure]
#   runnerctl fleet <apply|scale|start|stop|restart|drain|kill|reap| \
#                    remove-limits|enable|disable> [--host H]... \
#                   [--all-hosts] [--max-unavailable N|N%] [--min-available K] \
#                   [<the command's own flags and targets>]
#   runnerctl fleet compose-reap [--host H]... [--apply] [--standalone] \
#                                [--project NAME] [--max-age-hours N] [--grace-minutes N]
#   runnerctl fleet compose-reap-timer status|install|remove [--host H]...
#   runnerctl profiles
#   runnerctl config-example
#   runnerctl migrate [--from PATH] [--output PATH] [--dry-run]
#   runnerctl install [--prefix DIR] [--ref <branch|tag>] [--no-migrate] [--dry-run]
#   runnerctl upgrade [--check] [--ref <branch|tag>] [--sha256 SUM] [--prefix DIR] \
#                     [--no-relocate]
#   runnerctl upgrade --rollback
#   runnerctl version
#
# Install or upgrade any host (a pre-config install is migrated first):
#   curl -fsSL https://github.com/runnane/runnerctl/releases/latest/download/runnerctl | sudo bash -s -- install
#
# `upgrade` heals WHERE runnerctl is, not only which version it is (GHR-52).
# `ssh host runnerctl` runs no login shell and so reads no ~/.profile, which on
# Ubuntu is what adds ~/.local/bin and ~/bin — so a runnerctl under a home
# directory works perfectly when its owner types it and is invisible to
# `fleet`, which reports `remote exit 127` forever. When upgrade finds itself
# running from such a copy it moves to --prefix (default /usr/local/bin) and
# retires the old one as .retired; where a system copy already exists, the home
# copy was shadowing it — you type one version and the fan-out runs another —
# and is retired instead. Either way it only acts when the privilege is already
# free (writable, root, or passwordless sudo): it never prompts, because
# `fleet upgrade` fans this out and a password prompt would hang it once per
# host. --no-relocate keeps a deliberately personal copy where it is.
#
# A download from a release asset is checked against the `runnerctl.sha256`
# published beside it and refused on a mismatch, or when the digest cannot be
# read; a release with no digest, or a source that is not a release asset (a
# branch --ref, a mirror), installs with a `not verified:` line, and --sha256
# SUM pins one by hand (GHR-84). The digest shares the script's origin, so it
# guards against corruption and a tampered mirror, not a compromised release.
# Each upgrade keeps the script it replaces as <path>.prev, and `upgrade
# --rollback` renames it back — no download — consuming it; `fleet upgrade
# --rollback` does that on every host and reads each one's version back.
#
# --when-idle (restart, stop, apply --restart, scale) waits for each targeted
# slot to finish its job before acting on it, one slot at a time so the pool
# keeps capacity; --timeout N (seconds, default 1800) gives up non-zero with
# the still-busy slots listed and never force-kills. `drain` = `stop
# --when-idle`. Best-effort: between the idle check and the systemctl call
# the Listener can still pick up a new job (the window is a few hundred ms)
# and the runner has no "stop accepting jobs" switch of its own — for a
# guaranteed drain, change the runner's labels or disable it in GitHub first.
#
# `watch` (= `status --watch`) redraws the status table in place every N
# seconds (default 2) until q or Ctrl-C, for keeping an eye on a drain, a
# profile roll or a slot approaching its memory cap; it needs a terminal, and
# the journal-derived WORKING-ON cells refresh every 10th redraw. It is
# interactive (GHR-33): ↑/↓ (or j/k) move the cursor over the slot rows and
# a key acts on the selected slot, each after a y/n confirm line that names
# the exact command — K kills the running job (`kill`: SIGKILL for the job's
# own processes, the Listener stays up and reports it failed — for a STALLED
# row), R restarts the service (warned when a job is
# in flight), S/T stop/start it, P reaps its `+N leaked` processes, L opens
# `logs <slot> -n 50` in $PAGER, O prints the URL of the job's run on the
# status line (GHR-78; printed, never opened). Enter (GHR-76) replaces the
# table with the selected slot in full — unit, sub-state, result and last
# restart reason, the job's run, memory current / peak / high / max with a bar,
# pressure and event counters, the leaked processes by pid and name, and the
# host's cores, memory, disks and journal events; there q, Esc or Enter go back
# (q does not quit in the pane — Ctrl-C does), h shows the host's block alone,
# the action keys act on that slot, and ↑/↓ PgUp/PgDn scroll. Privileged keys go through
# sudo like the commands do. Too narrow a terminal drops MAX, HIGH and ENVFILE
# from the table, never WORKING-ON; --narrow (GHR-56, on `status` too) asks
# for that narrow table outright. A terminal with columns to spare beyond the
# full table shows a running job as `repo:workflow / job @ref` instead of
# `repo:job` (GHR-78) — on a terminal only: piped, or fetched by `fleet`, the
# cell is the short one at any width. Too short a terminal (GHR-73) shows a window of the
# rows that follows the cursor, the header, legend and status line staying
# put and `↑ N more` / `↓ N more` counting the hidden lines; PgUp/PgDn move
# the cursor a page, g/G (Home/End) to the first and last slot, and a resize
# redraws at once. `fleet watch` does the same.
#
# The table is coloured by meaning when stdout is a terminal (--color auto;
# NO_COLOR in the environment turns it off, --color always/never override):
# ACTIVE green/yellow/red, USED yellow then red as a slot reaches its HIGH
# cap, WORKING-ON dim while idle and bold red when STALLED. A job that has
# run for STALL_SEC seconds or more (config, default 3600 = 1 h — a job
# past an hour on a build pool is wedged, not slow; --stall-after N
# overrides, 0 disables) is STALLED: marked in the WORKING-ON cell,
# `"stalled":true` in --json, and a problem for `health`. The flag has an
# actions (GHR-30): `restart --if-stalled` (or `stop --if-stalled`) acts on
# exactly the slots whose job is STALLED and skips every other one with a
# line, and `health --restart-stalled` does the same from cron, appending
# `— restarted` to the problem line (exit stays 1, so a probe still records
# the event once). --if-stalled and --when-idle are exclusive: one waits for
# an idle slot, the other acts on a wedged one.
#
# But a restart is a GRACEFUL stop, and a stalled step is exactly what will
# not answer one: GitHub's unit has KillMode=process, KillSignal=SIGTERM,
# TimeoutStopSec=5min, so `restart` on a wedged job hangs five minutes in
# `deactivating/stop-sigterm` and then kills only the main process. `kill`
# (GHR-36) is the tool for that row: `runnerctl kill [--dry-run]
# [--if-stalled] [--stall-after N] [target ...]` SIGKILLs the job's own
# processes — everything in the slot's cgroup that is not the Listener — so
# the runner stays up, reports the job failed and takes work again in
# seconds. A slot already wedged in its own stop, one whose cgroup cannot be
# read, and one whose Listener has not reported the job gone KILL_GRACE_SEC
# (10) after its Worker died are escalated to `systemctl kill -s KILL
# <unit>`, which signals the whole cgroup whatever KillMode says, with
# Restart=always bringing the slot back. A bare `kill` needs a target.
#
# PRESS is the slot's memory pressure (GHR-31): the cgroup's PSI `full avg10`
# — the share of the last 10 s every task in it spent stalled on memory —
# yellow from PRESSURE_WARN_PCT (10), red from PRESSURE_CRIT_PCT (50), and a
# `health` problem at the red line. It is what tells a job throttled at
# MemoryHigh from one that is hung: a STALLED job with a high PRESS is
# starved, not stuck. --json carries it with the cgroup's memory.events
# counters (high / max / oom_kill since the unit started).
#
# `status --json` prints the same facts as one JSON object — raw bytes, epoch
# seconds, null where the table shows — — for monitoring and inventory
# tooling; the keys are listed in the README. It is one-shot: poll it rather
# than --watch it. A slot's `job` names the run as well as the job (GHR-78):
# workflow, run_id, run_attempt, run_number, ref, sha, actor, event and the
# run page's `url`, each null when it could not be read or is not what such a
# value has to be — they come from a job's environment, so a number is digits
# or null, and the WORKING-ON cell draws none of it with a control character
# left in.
# `status --with-json` (GHR-90) is a machine form for `fleet`: the table, a
# separator line starting with the byte 0x1e, then the `status --json` object,
# all from one collection, so a reader gets both views of the same moment for
# the cost of one. It refuses --json and --watch.
# `status --cpu-prev=SPEC` (GHR-115) is another, for `fleet watch`: the CPU
# samples the host's previous payload carried (`invocation_id`,
# `cpu_usage_usec`, `cpu_usage_at_us`, as INVOCATION:USAGE:AT,…) are taken as
# each slot's first sample, so the table draws its CPU column without the
# one-shot CPU_SAMPLE_MS wait, as `watch` does from its previous tick.
# An idle slot whose cgroup still holds processes that are not the runner's
# own — a dev server or watcher a finished job left behind — shows `+N
# leaked` in WORKING-ON, `leaked_procs` in --json and a `health` problem;
# they count against MemoryMax until the slot restarts. `reap [--dry-run]
# [target ...]` kills exactly those (SIGTERM, REAP_GRACE_SEC, SIGKILL for
# what is left) without touching the Listener; a busy slot is skipped, since
# a running job's processes cannot be told from leaks. Needs to see the
# cgroup: root or the runner user (GHR-29).
# `compose-reap` is the same idea one level out, for the Docker daemon a
# host's slots share: a job that dies before its teardown leaves its compose
# stack RUNNING, so its images and volumes count as in use and no prune ever
# frees them. It judges every compose project by whether the job that made it
# is alive — the `-<pid>` suffix a harness names its stack after, or the
# runner slot owning its working dir — and falls back to an age guard only
# when neither applies. Dry run unless --apply; --apply refuses on a host with
# no runner units. `compose-reap-timer install` runs it hourly from a root
# systemd timer, and refuses unless this runnerctl is root-owned and writable
# by nobody else. Containers without a compose label are only counted unless
# --standalone (or COMPOSE_REAP_STANDALONE=1): then each is kept while any slot
# runs a job older than it and reaped past --max-age-hours otherwise, and its
# image is removed once no container uses it.
# `health` is a yes/no for cron or an uptime monitor's push endpoint: exit 0
# ("ok: N slot(s) healthy") when every enabled slot is running, no slot has
# restarted --max-restarts times (default 5) or more and no job is STALLED,
# else one line per problem and exit 1; --quiet drops the output and keeps
# the exit code, for
# `runnerctl health --quiet || alert`. NRestarts is systemd's count since the
# unit's last manual start, not a rolling "in the last hour" window — there is
# no cheap way to bucket it by wall-clock time, so that is what gets reported.
# A disabled, scaled-down slot is not a problem.
#
# `fleet` (GHR-39) runs this same tool from one central node against several
# runner hosts over ssh: `fleet status` fans `status` out to every host in
# FLEET_HOSTS (config file — site data, never in this script), at most
# FLEET_PARALLEL at a time, and prints one table with a HOST column, or one
# JSON object with each host's payload nested unchanged under --json. It
# needs runnerctl installed on each host and nothing else: read-only status
# never asks for sudo, so a plain unprivileged ssh login is enough.
# A host that does not answer is a ROW, never a fatal — the other hosts still
# report, and the exit code is non-zero so a monitor still notices. Three
# outcomes are kept apart on purpose: unreachable, timed out, and the remote
# runnerctl exiting non-zero (on a runner-less host that is its own message,
# not a fleet fault). When the hosts are not all on one version, a note says
# so under the table. A summary line (GHR-72) totals it: hosts answering,
# slots by state, leaks, disk and event hosts, free capacity, versions — the
# last line of `fleet status`, under the header in `fleet watch`, counted
# from the `status --json` object each host sends after its table in the same
# answer (`status --with-json`, GHR-90); a host too old for that flag is asked
# a second time, for `status --json` alone.
# `fleet watch` (GHR-54) is that same table in a redraw loop, and the reason
# it is a command of its own rather than `watch runnerctl fleet status` is the
# ssh cost. A fan-out pays a TCP connect, a key exchange and an auth PER HOST
# PER CALL, so polling six hosts every two seconds is around 180 full logins a
# minute — sshd throttles it at MaxStartups, fail2ban reads it as an attack,
# and rows start coming back `unreachable` for reasons that have nothing to do
# with the hosts. `fleet watch` opens ONE connection per host and holds it for
# the session, so the first tick pays the handshake and every later tick rides
# it. Two smaller differences from `fleet status`: it asks the remotes to
# PAINT (the host that drew a cell is the only thing that knows it is STALLED
# or throttled), and its default interval is 5 s, because every tick is a
# round trip to every host. Its cursor is a (host, slot) pair, and the local
# watch's keys act on it over the held connection (GHR-55): K kill job, R
# restart, S stop, T start, P reap, each decided on facts read from that host
# at the keypress and confirmed with a line naming the exact remote command,
# (R and S also take w there, GHR-126: the same command with --when-idle,
# which waits for the slot's job instead of killing it),
# and L pages that slot's last 50 journal lines. O prints the run URL of the
# cursor's job, from the payload the last tick brought (GHR-78). Enter opens
# the local watch's slot pane for the cursor's pair (GHR-76), read from that
# same payload — no round trip, refreshed by the tick, `—` for anything an
# older host does not report; on the row of a host that is not answering it
# opens that host's block with the error in full, and h in a slot's pane shows
# its host. S keeps a floor: it refuses
# a stop that would leave fewer than --min-available K (default 1) slots
# active across the watched hosts, so a cursor walked down the fleet pressing
# S cannot take it to zero. `q` quits.
# Each host is fetched in the background (GHR-74), so one that stalls holds up
# neither the others' rows nor the keys. A host that stops answering keeps its
# last rows, dimmed, under `no answer for 45s — last seen 14:02:10 — <why>`;
# rows kept that way count for nothing in the summary or in S's floor. The
# watch's reads have FLEET_WATCH_TIMEOUT seconds per host (default 10), not
# FLEET_TIMEOUT.
# View keys (GHR-75) choose what the frame shows and ask no host anything:
# `!` problems only (slots STALLED, not active, leaking, at MemoryHigh or
# under critical memory pressure; hosts not answering or with a disk/OOM line
# at warn or worse), `b` / `i` busy / idle only, `/` rows whose host, runner
# or repo:job contains the text typed, `a` all again; `s` cycles config order
# → longest job first → most memory first (a flat list, host lines under it);
# `c` folds every host to one line (`build-1 4 slots: 3 busy, 1 idle · Disk:
# …`) and, on a host, c or Enter opens it; `?` lists every key. The header
# names the view, the summary line goes on counting the whole fleet, and a
# view that shows nothing says `nothing matches — a shows all`. --problems and
# --sort config|job|mem start a watch in a view, for a wall display.
# A frame wider than the terminal makes the next tick ask the hosts for
# `status --narrow` (GHR-56), with the local watch's hysteresis; a host too
# old for the flag is asked again without it and shows its full-width rows.
# `fleet health` reduces the same fan-out to ONE exit code, so a central node
# needs one cron entry and one push URL rather than one per host: exit 0 only
# when every host was reached and reported healthy, else one line per problem
# prefixed with its host. A host that did not answer is a problem — a monitor
# that goes green because a host dropped out of the fan-out is worse than no
# monitor. --quiet keeps the exit code and drops the output, as it does for
# one host; it is NOT forwarded, since the remote's stdout is where the
# problem lines come from. --restart-stalled is forwarded and acts on each
# host, which needs passwordless sudo there — without it BatchMode makes it
# fail fast and say so rather than hang.
# `fleet upgrade [--check] [--ref R]` holds every host on one version, which
# is what the skew note under `fleet status` is asking for. --check reports
# each host's installed and available version and whether it would change,
# without writing anything. A host that fails is a reported row, never an
# abort: a partly upgraded fleet is the normal outcome of a flaky network,
# and which host is still behind is the thing you must not lose. Writing the
# script needs root on a normal host, so this is the first fan-out that
# needs passwordless sudo there. A host that says it wrote is then asked for
# `version` through FLEET_RUNNERCTL, and is `upgraded` only if that answers
# the version it said it wrote: `wrote X but the fleet path still answers Y`
# is a write that landed where the fan-out does not execute, and a failed
# row. The last line names where the fleet ended up. --host H narrows it;
# --canary [H] upgrades one host first — unnamed, the first that would
# actually change — and continues only if it ends `upgraded`; --serial goes
# one host at a time; --stop-on-failure also halts at the first failed row
# or still-behind host and names the hosts it did not attempt. A write counts
# a host that only said `Update available.` (GHR-52's retire-only path) as
# `still behind`, not upgraded, and exits non-zero (GHR-97).
# `fleet upgrade --push` (GHR-83) sends THIS node's own runnerctl over ssh
# instead: each host checks the bytes against this node's sha256, installs
# them with `sudo -n bash <file> install`, and is `upgraded` only when its
# checksum read back matches — so hosts need no outbound access, all land on
# identical bytes, and a host with no runnerctl gets one. A host newer than
# this node is left alone. `--push --check` writes nothing and reports each
# host as same, differs, absent or newer.
# The MUTATING commands fan out too (GHR-43), and differ from the read-only
# ones in three ways. They go ONE HOST AT A TIME (FLEET_PARALLEL is ignored),
# so with the per-host --when-idle the blast radius is a single host at any
# moment. `--host H` (repeatable, validated against FLEET_HOSTS) narrows the
# target. And `stop`, `drain` and `disable` are REFUSED fleet-wide unless
# given --host or --all-hosts: they take capacity away and do not give it
# back, and per-host politeness does not compose — every host draining one
# slot at a time still lands the fleet at zero together. Note --when-idle
# stays best-effort per host, and a fleet does not make it a fleet-wide
# guarantee. `env-init` is excluded permanently (it would copy secrets over
# ssh); `logs` stays per-host because it streams from one journal, while
# `watch` has a fleet form of its own, described above — whose L pages one
# slot's recent journal from its host.
# Two graded capacity budgets (GHR-44), and they are two flags rather than
# one because the operations have OPPOSITE dynamics. `--max-unavailable N`
# (restart/apply/scale) is a CEILING: a restarted slot comes back, so the
# unavailable count rises and falls and the ceiling throttles the rate — the
# walk re-reads fleet state between slots and waits. `--min-available K`
# (stop/drain/disable) is a FLOOR: that capacity is not returned, so the
# count only rises and a ceiling would have nothing to wait for; the walk
# stops before crossing the floor, names what it left running and exits 2 —
# neither success nor failure, but deliberately less than was asked. N may be
# a percentage, never rounded down to a deadlocking 0. Each flag is refused
# on the commands it cannot help rather than quietly ignored. Both walk one
# SLOT per call, since a per-host call would take a whole host out in a step.
# The sudo contract (GHR-89): by default each host's runnerctl asks sudo for
# the systemctl, tee, rm, kill, cp and mv it needs, and a sudoers grant of
# those with no arguments is root for the ssh login. FLEET_SUDO=1 instead
# runs every call that changes a host as `sudo -n FLEET_RUNNERCTL <verb> …`,
# so one sudoers line naming runnerctl is enough; reads never use sudo. A
# host with that line sets SUDO_CONTRACT=narrow in /etc/runnerctl/config,
# and then under sudo runnerctl refuses what would widen the grant back to
# root: a config other than /etc/runnerctl/config, a script or directory
# others can write, `fleet`, and each flag that picks what root runs, sources
# or installs, where it writes, or what it removes beyond the host's policy
# (`apply --env-file`, `--save`, `upgrade --prefix`, a non-release `--ref`,
# ...). Without the opt-in nothing is refused. Under any sudo it pins PATH
# and HOME and drops the caller's pager and RUNNERCTL_* variables.
#
# `provision N` (GHR-45) is what makes the units exist in the first place. On
# a box with no runners every other command used to dead-end in "no
# 'actions.runner.*.service' units found" — `install` installs THIS SCRIPT,
# and nothing installed a runner. provision fetches GitHub's runner release
# (verifying the SHA-256 published with it), unpacks one copy per slot under
# RUNNER_ROOT, registers each with the runner's own `config.sh` (as the runner
# user) and writes the unit `svc.sh install` would write, from a template held
# here (GHR-110: root never runs a script out of a runner's directory, which
# the account jobs run as can rewrite). It is
# idempotent against a target count like `scale`: `provision 4` on a host
# with 2 adds two, `provision 2` on a host with 4 changes nothing, and it
# never deregisters anything. The registration token comes from --token (the
# one GitHub's "New self-hosted runner" page shows), from --pat/$GITHUB_TOKEN,
# or from the gh CLI's existing login; one token registers every slot in the
# run. The token reaches config.sh through its environment
# (ACTIONS_RUNNER_INPUT_TOKEN, handed over on stdin — GHR-122), never argv, so
# `ps` shows it to nobody; runnerctl itself never prints or stores it.
#
# `deprovision <target>...` (GHR-46) is the inverse, for a slot that should
# stop existing rather than merely stop: the unit stopped, disabled and
# removed (what svc.sh stop + uninstall did, without running it), `config.sh
# remove` with a removal token (minted like the registration one, from
# --token, --pat/$GITHUB_TOKEN or gh), then the runner's directory is
# deleted. Irreversible, so it takes explicit targets only, asks y/N unless
# --yes (and refuses without a terminal), refuses a slot with a job in
# flight unless --when-idle, and --dry-run prints the commands. A runner
# GitHub already forgot still gets cleaned up locally. The removal token
# reaches config.sh through its environment, never argv.
#
# Every command that changes the host (GHR-88) leaves one journal line tagged
# `runnerctl` when it ends — verb, targets, the flags that matter, who ran it
# (the sudo caller, else the login) and how it ended — and `history [-n N]`
# prints them back. Never the command line itself, so never a token. A call
# from `fleet` carries `--origin OPERATOR@HOST`, which the line repeats as `via
# fleet from …`: a claim made by whoever holds the fleet's ssh login, written
# down and trusted for nothing. The central node keeps its own record in
# FLEET_LOG, one line per fleet command or `fleet watch` action key with each
# host's exit code, and `fleet history` merges every host's journal lines by
# time. A record that cannot be written changes nothing about the command.
#
# `--heartbeat N` (1..3600 s, GHR-149) makes every phase of a command that can
# block — a systemctl start/stop/restart/reload, a --when-idle or drain wait,
# kill's wait, upgrade's download — print a line at least every N seconds
# (`heartbeat: … (Ns)`, or the wait's own `waiting for …` line), so a caller
# reading the output can tell a working host from a silent one. Without it
# the output is what it always was.
#
# Recommended baselines:
#   New host:     runnerctl provision 2 --url https://github.com/<org>
#   CI host:      runnerctl scale 2 --max 26G --high 25G
#   Live view:    runnerctl watch --interval 5
#   Fleet view:   runnerctl fleet watch --interval 5   # from the central node
#   Deploy box:   runnerctl env-init --profile deploy   # then fill secrets
#                 runnerctl apply --profile deploy --restart
#   Host update:  runnerctl drain            # stop every slot once it is idle
#   Profile roll: runnerctl apply --restart --when-idle
#   Old install:  runnerctl migrate   # lifts the inline values into the config
set -euo pipefail
# status_row pads on visible width by stripping SGR sequences with a bounded
# `*([0-9;])` (GHR-27); extglob is what makes that pattern legal.
shopt -s extglob


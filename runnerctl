#!/usr/bin/env bash
# runnerctl — manage self-hosted GitHub Actions runner slots on this host.
#
# Runners are systemd services (actions.runner.<scope>.<name>.service) installed
# by GitHub's svc.sh. This tool applies a role PROFILE (memory caps, restart
# policy, on-device secrets) via systemd drop-in overrides — so the generated
# unit files are never hand-edited and the config survives a runner reinstall —
# plus reports status and scales the active pool.
#
# Built-in profiles (--profile, default: ci):
#   ci      CI build/test pool. Memory-capped + auto-restart. A step that
#           outgrows the cap is OOM-killed on its own (OOMPolicy=continue):
#           the job fails with a readable log, the runner stays up.
#   deploy  Dedicated deploy runner. Long-lived, auto-restart, secrets from a
#           root-owned on-device EnvironmentFile — NOT memory-capped.
#
# Site-specific settings (profile values, env templates, drop-in name) live in
# an optional config file, never in this script:
#   /etc/runnerctl/config            (or $RUNNERCTL_CONFIG, or --config PATH)
# See `runnerctl config-example` for a starting point.
#
# Nothing box-specific is hardcoded: runner units are discovered from systemd,
# so this runs on any runner host. Privileged operations re-exec via sudo.
#
# Usage:
#   runnerctl [--config PATH] <command> [args]
#
#   runnerctl provision N [--url URL] [--token TOK | --pat TOK] [--labels a,b] \
#                         [--name-prefix P] [--runner-user U] [--runner-root DIR] \
#                         [--runner-version X.Y.Z] [--sha256 SUM] [--replace] \
#                         [--dry-run]     ('provision --help' for all of them)
#   runnerctl status [--json] [--watch|-w] [--interval N] [--once] \
#                    [--color auto|always|never] [--stall-after N]
#   runnerctl watch  [--interval N] [--color auto|always|never] [--stall-after N]
#   runnerctl apply  [--profile NAME] [--max 26G] [--high 25G] \
#                    [--restart-sec N] [--env-file PATH] [--restart] \
#                    [--when-idle] [--timeout N] [<unit|slot-index|name> ...]
#   runnerctl scale N [--profile NAME] [--max 26G] [--high 25G] \
#                     [--restart] [--when-idle] [--timeout N]
#   runnerctl env-init [--profile NAME] [--env-file PATH]
#   runnerctl start|stop|restart [--when-idle] [--timeout N] \
#                                [--if-stalled] [--stall-after N] \
#                                [<unit|slot-index|name> ...]
#   runnerctl drain [--timeout N] [<unit|slot-index|name> ...]
#   runnerctl enable|disable <unit|slot-index|name>
#   runnerctl logs [<unit|slot-index|name>] [-f|--follow] [-n N] \
#                  [--since WHEN] [-g PATTERN]
#   runnerctl remove-limits [<unit|slot-index|name> ...]
#   runnerctl reap [--dry-run] [<unit|slot-index|name> ...]
#   runnerctl kill [--dry-run] [--if-stalled] [--stall-after N] \
#                  [<unit|slot-index|name> ...]
#   runnerctl health [--quiet] [--max-restarts N] [--stall-after N] [--restart-stalled]
#   runnerctl fleet status [--json] [--color auto|always|never]
#   runnerctl fleet health [--quiet] [--max-restarts N] [--stall-after N] \
#                          [--restart-stalled]
#   runnerctl fleet upgrade [--check] [--ref <branch|tag>]
#   runnerctl fleet <apply|scale|start|stop|restart|drain|kill|reap| \
#                    remove-limits|enable|disable> [--host H]... \
#                   [--all-hosts] [--max-unavailable N|N%] [--min-available K] \
#                   [<the command's own flags and targets>]
#   runnerctl profiles
#   runnerctl config-example
#   runnerctl migrate [--from PATH] [--output PATH] [--dry-run]
#   runnerctl install [--prefix DIR] [--ref <branch|tag>] [--no-migrate] [--dry-run]
#   runnerctl upgrade [--check] [--ref <branch|tag>] [--prefix DIR] [--no-relocate]
#   runnerctl version
#
# Install or upgrade any host (a pre-config install is migrated first):
#   curl -fsSL https://github.com/runnane/runnerctl/releases/latest/download/runnerctl | sudo bash -s -- install
#
# `upgrade` heals WHERE runnerctl is, not only which version it is (GHR-52).
# `ssh host runnerctl` runs no login shell and so reads no ~/.profile, which on
# Ubuntu is what adds ~/.local/bin and ~/bin — so a runnerctl under a home
# directory works perfectly when its owner types it and is invisible to
# `fleet`, which reports `remote exit 127` forever. When upgrade finds itself
# running from such a copy it moves to --prefix (default /usr/local/bin) and
# retires the old one as .retired; where a system copy already exists, the home
# copy was shadowing it — you type one version and the fan-out runs another —
# and is retired instead. Either way it only acts when the privilege is already
# free (writable, root, or passwordless sudo): it never prompts, because
# `fleet upgrade` fans this out and a password prompt would hang it once per
# host. --no-relocate keeps a deliberately personal copy where it is.
#
# --when-idle (restart, stop, apply --restart, scale) waits for each targeted
# slot to finish its job before acting on it, one slot at a time so the pool
# keeps capacity; --timeout N (seconds, default 1800) gives up non-zero with
# the still-busy slots listed and never force-kills. `drain` = `stop
# --when-idle`. Best-effort: between the idle check and the systemctl call
# the Listener can still pick up a new job (the window is a few hundred ms)
# and the runner has no "stop accepting jobs" switch of its own — for a
# guaranteed drain, change the runner's labels or disable it in GitHub first.
#
# `watch` (= `status --watch`) redraws the status table in place every N
# seconds (default 2) until q or Ctrl-C, for keeping an eye on a drain, a
# profile roll or a slot approaching its memory cap; it needs a terminal, and
# the journal-derived WORKING-ON cells refresh every 10th redraw. It is
# interactive (GHR-33): ↑/↓ (or j/k) move the cursor over the slot rows and
# a key acts on the selected slot, each after a y/n confirm line that names
# the exact command — K kills the running job (`kill`: SIGKILL for the job's
# own processes, the Listener stays up and reports it failed — for a STALLED
# row), R restarts the service (warned when a job is
# in flight), S/T stop/start it, P reaps its `+N leaked` processes, L opens
# `logs <slot> -n 50` in $PAGER. Privileged keys go through sudo like the
# commands do. Too narrow a terminal drops MAX, HIGH and ENVFILE from the
# table, never WORKING-ON.
#
# The table is coloured by meaning when stdout is a terminal (--color auto;
# NO_COLOR in the environment turns it off, --color always/never override):
# ACTIVE green/yellow/red, USED yellow then red as a slot reaches its HIGH
# cap, WORKING-ON dim while idle and bold red when STALLED. A job that has
# run for STALL_SEC seconds or more (config, default 3600 = 1 h — a job
# past an hour on a build pool is wedged, not slow; --stall-after N
# overrides, 0 disables) is STALLED: marked in the WORKING-ON cell,
# `"stalled":true` in --json, and a problem for `health`. The flag has an
# actions (GHR-30): `restart --if-stalled` (or `stop --if-stalled`) acts on
# exactly the slots whose job is STALLED and skips every other one with a
# line, and `health --restart-stalled` does the same from cron, appending
# `— restarted` to the problem line (exit stays 1, so a probe still records
# the event once). --if-stalled and --when-idle are exclusive: one waits for
# an idle slot, the other acts on a wedged one.
#
# But a restart is a GRACEFUL stop, and a stalled step is exactly what will
# not answer one: GitHub's unit has KillMode=process, KillSignal=SIGTERM,
# TimeoutStopSec=5min, so `restart` on a wedged job hangs five minutes in
# `deactivating/stop-sigterm` and then kills only the main process. `kill`
# (GHR-36) is the tool for that row: `runnerctl kill [--dry-run]
# [--if-stalled] [--stall-after N] [target ...]` SIGKILLs the job's own
# processes — everything in the slot's cgroup that is not the Listener — so
# the runner stays up, reports the job failed and takes work again in
# seconds. A slot already wedged in its own stop, one whose cgroup cannot be
# read, and one whose Listener has not reported the job gone KILL_GRACE_SEC
# (10) after its Worker died are escalated to `systemctl kill -s KILL
# <unit>`, which signals the whole cgroup whatever KillMode says, with
# Restart=always bringing the slot back. A bare `kill` needs a target.
#
# PRESS is the slot's memory pressure (GHR-31): the cgroup's PSI `full avg10`
# — the share of the last 10 s every task in it spent stalled on memory —
# yellow from PRESSURE_WARN_PCT (10), red from PRESSURE_CRIT_PCT (50), and a
# `health` problem at the red line. It is what tells a job throttled at
# MemoryHigh from one that is hung: a STALLED job with a high PRESS is
# starved, not stuck. --json carries it with the cgroup's memory.events
# counters (high / max / oom_kill since the unit started).
#
# `status --json` prints the same facts as one JSON object — raw bytes, epoch
# seconds, null where the table shows — — for monitoring and inventory
# tooling; the keys are listed in the README. It is one-shot: poll it rather
# than --watch it.
# An idle slot whose cgroup still holds processes that are not the runner's
# own — a dev server or watcher a finished job left behind — shows `+N
# leaked` in WORKING-ON, `leaked_procs` in --json and a `health` problem;
# they count against MemoryMax until the slot restarts. `reap [--dry-run]
# [target ...]` kills exactly those (SIGTERM, REAP_GRACE_SEC, SIGKILL for
# what is left) without touching the Listener; a busy slot is skipped, since
# a running job's processes cannot be told from leaks. Needs to see the
# cgroup: root or the runner user (GHR-29).
# `health` is a yes/no for cron or an uptime monitor's push endpoint: exit 0
# ("ok: N slot(s) healthy") when every enabled slot is running, no slot has
# restarted --max-restarts times (default 5) or more and no job is STALLED,
# else one line per problem and exit 1; --quiet drops the output and keeps
# the exit code, for
# `runnerctl health --quiet || alert`. NRestarts is systemd's count since the
# unit's last manual start, not a rolling "in the last hour" window — there is
# no cheap way to bucket it by wall-clock time, so that is what gets reported.
# A disabled, scaled-down slot is not a problem.
#
# `fleet` (GHR-39) runs this same tool from one central node against several
# runner hosts over ssh: `fleet status` fans `status` out to every host in
# FLEET_HOSTS (config file — site data, never in this script), at most
# FLEET_PARALLEL at a time, and prints one table with a HOST column, or one
# JSON object with each host's payload nested unchanged under --json. It
# needs runnerctl installed on each host and nothing else: read-only status
# never asks for sudo, so a plain unprivileged ssh login is enough.
# A host that does not answer is a ROW, never a fatal — the other hosts still
# report, and the exit code is non-zero so a monitor still notices. Three
# outcomes are kept apart on purpose: unreachable, timed out, and the remote
# runnerctl exiting non-zero (on a runner-less host that is its own message,
# not a fleet fault). When the hosts are not all on one version, a note says
# so under the table.
# `fleet health` reduces the same fan-out to ONE exit code, so a central node
# needs one cron entry and one push URL rather than one per host: exit 0 only
# when every host was reached and reported healthy, else one line per problem
# prefixed with its host. A host that did not answer is a problem — a monitor
# that goes green because a host dropped out of the fan-out is worse than no
# monitor. --quiet keeps the exit code and drops the output, as it does for
# one host; it is NOT forwarded, since the remote's stdout is where the
# problem lines come from. --restart-stalled is forwarded and acts on each
# host, which needs passwordless sudo there — without it BatchMode makes it
# fail fast and say so rather than hang.
# `fleet upgrade [--check] [--ref R]` holds every host on one version, which
# is what the skew note under `fleet status` is asking for. --check reports
# each host's installed and available version and whether it would change,
# without writing anything. A host that fails is a reported row, never an
# abort: a partly upgraded fleet is the normal outcome of a flaky network,
# and which host is still behind is the thing you must not lose. Writing the
# script needs root on a normal host, so this is the first fan-out that
# needs passwordless sudo there.
# The MUTATING commands fan out too (GHR-43), and differ from the read-only
# ones in three ways. They go ONE HOST AT A TIME (FLEET_PARALLEL is ignored),
# so with the per-host --when-idle the blast radius is a single host at any
# moment. `--host H` (repeatable, validated against FLEET_HOSTS) narrows the
# target. And `stop`, `drain` and `disable` are REFUSED fleet-wide unless
# given --host or --all-hosts: they take capacity away and do not give it
# back, and per-host politeness does not compose — every host draining one
# slot at a time still lands the fleet at zero together. Note --when-idle
# stays best-effort per host, and a fleet does not make it a fleet-wide
# guarantee. `env-init` is excluded permanently (it would copy secrets over
# ssh); `watch` and `logs` stay per-host.
# Two graded capacity budgets (GHR-44), and they are two flags rather than
# one because the operations have OPPOSITE dynamics. `--max-unavailable N`
# (restart/apply/scale) is a CEILING: a restarted slot comes back, so the
# unavailable count rises and falls and the ceiling throttles the rate — the
# walk re-reads fleet state between slots and waits. `--min-available K`
# (stop/drain/disable) is a FLOOR: that capacity is not returned, so the
# count only rises and a ceiling would have nothing to wait for; the walk
# stops before crossing the floor, names what it left running and exits 2 —
# neither success nor failure, but deliberately less than was asked. N may be
# a percentage, never rounded down to a deadlocking 0. Each flag is refused
# on the commands it cannot help rather than quietly ignored. Both walk one
# SLOT per call, since a per-host call would take a whole host out in a step.
#
# `provision N` (GHR-45) is what makes the units exist in the first place. On
# a box with no runners every other command used to dead-end in "no
# 'actions.runner.*.service' units found" — `install` installs THIS SCRIPT,
# and nothing installed a runner. provision fetches GitHub's runner release
# (verifying the SHA-256 published with it), unpacks one copy per slot under
# RUNNER_ROOT, registers each with the runner's own `config.sh` and lets the
# runner's own `svc.sh` write the unit — so the result is exactly the units
# the rest of this tool manages, never a unit file written by hand. It is
# idempotent against a target count like `scale`: `provision 4` on a host
# with 2 adds two, `provision 2` on a host with 4 changes nothing, and it
# never deregisters anything. The registration token comes from --token (the
# one GitHub's "New self-hosted runner" page shows), from --pat/$GITHUB_TOKEN,
# or from the gh CLI's existing login; one token registers every slot in the
# run. Note that `config.sh` takes the token as a command-line argument — as
# it does in GitHub's own documented install — so it is briefly visible in
# `ps` to other users on the box; runnerctl itself never prints or stores it.
#
# Recommended baselines:
#   New host:     runnerctl provision 2 --url https://github.com/<org>
#   CI host:      runnerctl scale 2 --max 26G --high 25G
#   Live view:    runnerctl watch --interval 5
#   Deploy box:   runnerctl env-init --profile deploy   # then fill secrets
#                 runnerctl apply --profile deploy --restart
#   Host update:  runnerctl drain            # stop every slot once it is idle
#   Profile roll: runnerctl apply --restart --when-idle
#   Old install:  runnerctl migrate   # lifts the inline values into the config
set -euo pipefail
# status_row pads on visible width by stripping SGR sequences with a bounded
# `*([0-9;])` (GHR-27); extglob is what makes that pattern legal.
shopt -s extglob

RUNNERCTL_VERSION="0.10.3" # x-release-please-version

# --- Defaults (all overridable from the config file) -------------------------
# The BUILTIN_* copies stay untouched by the config so `migrate` can tell a
# migrated value from a default one.
BUILTIN_DROPIN_NAME="10-runnerctl.conf"
BUILTIN_UNIT_GLOB='actions.runner.*.service'
BUILTIN_DEFAULT_PROFILE="ci"
DROPIN_NAME="$BUILTIN_DROPIN_NAME"
UNIT_GLOB="$BUILTIN_UNIT_GLOB"
DEFAULT_PROFILE="$BUILTIN_DEFAULT_PROFILE"
UPGRADE_URL="https://github.com/runnane/runnerctl/releases/latest/download/runnerctl"
CONFIG_FILE="${RUNNERCTL_CONFIG:-/etc/runnerctl/config}"
# Where unit drop-ins live. A test config points this at a fixture tree.
SYSTEMD_DIR="/etc/systemd/system"
# --when-idle: seconds between idle polls, and the default --timeout. The
# wait's clock advances by POLL_SEC per poll (not by wall time), so a config
# that shadows `pause` to a no-op still reaches the timeout.
POLL_SEC="5"
WAIT_TIMEOUT="1800"
# A running job older than this many seconds is STALLED in status/watch,
# `stalled` in --json, a problem for `health` and what `--if-stalled` acts
# on (GHR-27, GHR-30). 1 h: no job on a build pool legitimately runs that
# long, so past it the runner is wedged, not slow. Raise it in the config
# for a pool with longer jobs; 0 turns the flag off.
STALL_SEC="3600"
# `reap`: seconds between SIGTERM and SIGKILL for a leaked process (GHR-29).
REAP_GRACE_SEC="5"
# `kill`: seconds to give the Listener to notice its Worker died and report
# the job failed, before the whole unit's cgroup is SIGKILLed instead
# (GHR-36). Counted in POLL_SEC steps, so a value below POLL_SEC is one poll.
KILL_GRACE_SEC="10"
# PRESS (memory pressure, PSI full avg10 in percent): yellow from WARN, red
# and a `health` problem from CRIT (GHR-31).
PRESSURE_WARN_PCT="10"
PRESSURE_CRIT_PCT="50"
# Fleet mode (GHR-39): one central node driving several runner hosts over ssh.
# FLEET_HOSTS is the inventory — ssh aliases or user@host — and lives in the
# config file, never here: it is site data, and this repo is public. Empty
# means fleet mode is not configured, which every `fleet` command says
# outright rather than printing an empty table.
FLEET_HOSTS=()
# Extra ssh options, appended AFTER the built-in ones so a site can override
# any of them (e.g. adding ControlMaster/ControlPersist for a polling loop).
FLEET_SSH_OPTS=()
# Most hosts contacted at once, and the per-host seconds budget.
FLEET_PARALLEL="8"
FLEET_TIMEOUT="30"
# The remote command. Fleet mode requires runnerctl installed on each host
# (see the fleet section of the README for why); point this at an absolute
# path where it is not on the ssh user's PATH.
FLEET_RUNNERCTL="runnerctl"

# Provisioning (GHR-45): where `provision` puts a runner and who it runs as.
# RUNNER_URL is the only one that is genuinely site data (the org or repo the
# runners register against) — it stays empty here and is set per host in the
# config file or passed as --url, because this repo is public.
RUNNER_URL=""
# One directory per slot is created under this root: $RUNNER_ROOT/<prefix>-<n>.
RUNNER_ROOT="/opt/actions-runner"
# The unprivileged account the runner runs as. `config.sh` refuses to run as
# root, and a job that can write outside its own work dir is a job that can
# rewrite the runner — so provision creates this as a system user when it is
# missing rather than defaulting to the invoking one.
RUNNER_USER="github-runner"
RUNNER_GROUP=""   # empty = same name as RUNNER_USER
# Runner names are <prefix>-<n>, and the prefix defaults to the host's short
# name so one org's runner list stays readable across boxes. The unit GitHub
# installs is then actions.runner.<scope>.<prefix>-<n>.service.
RUNNER_NAME_PREFIX=""
# Extra labels, comma-separated, appended to the ones the runner sets for
# itself (self-hosted, the OS and the architecture). Empty = no extra labels.
RUNNER_LABELS=""
# The runner's _work directory, relative to the runner's own directory.
RUNNER_WORK="_work"
# Runner group to register into (GitHub org/enterprise runner groups). Empty
# = the account's default group, which is what a repo-scoped runner must use.
RUNNER_GROUP_NAME=""
# Empty = ask the releases API for the latest. Pin a version here (or with
# --runner-version) on a host that must not move.
RUNNER_VERSION=""
# Where the runner tarball and the release metadata come from. Overridable
# for a mirror or GitHub Enterprise Server.
RUNNER_API_URL="https://api.github.com"
RUNNER_DOWNLOAD_URL="https://github.com/actions/runner/releases/download"

# Profile-provided config (populated by load_profile; flags override).
PROFILE=""
PROFILE_DESC=""
MEM_MAX=""
MEM_HIGH=""
RESTART_SEC="10"
ENV_FILE=""
ENV_TEMPLATE=""
do_restart=false
when_idle=false
REMAINING=()
TARGETS=()

run_priv() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
die() { echo "runnerctl: $*" >&2; exit 1; }
# Call as `need_val "$@"` right after matching a value flag in $1: dies with
# "$1 needs a value" if no $2 is there to take it, instead of letting a bare
# "$2" expansion under `set -u` crash with a raw bash diagnostic.
need_val() { [ $# -ge 2 ] || die "$1 needs a value"; }

# --- Config file --------------------------------------------------------------
# The config file is plain bash and is sourced. It may set any of the defaults
# above and define profiles as functions:
#
#   profile_<name>()      sets PROFILE_DESC MEM_MAX MEM_HIGH RESTART_SEC ENV_FILE
#   env_template_<name>() prints the EnvironmentFile template for env-init
#
# A config-defined profile shadows a built-in one of the same name.
load_config() {
  [ -f "$CONFIG_FILE" ] || return 0
  # Refuse a config anyone could edit — it is executed, sometimes under sudo.
  local mode; mode="$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || echo 0)"
  [ $((8#$mode & 8#002)) -eq 0 ] || die "$CONFIG_FILE is world-writable — refusing to source it"
  local owner; owner="$(stat -c '%u' "$CONFIG_FILE" 2>/dev/null || echo -1)"
  [ "$owner" = "0" ] || [ "$owner" = "$(id -u)" ] || die "$CONFIG_FILE is owned by uid $owner, not root or the invoking user (uid $(id -u)) — refusing to source it (fix: chown root:root $CONFIG_FILE; chmod 644 $CONFIG_FILE)"
  local group; group="$(stat -c '%g' "$CONFIG_FILE" 2>/dev/null || echo -1)"
  [ $((8#$mode & 8#020)) -eq 0 ] || [ "$group" = "0" ] || die "$CONFIG_FILE is group-writable by group $group, not root — refusing to source it (fix: chown root:root $CONFIG_FILE; chmod 644 $CONFIG_FILE)"
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  [[ "$DROPIN_NAME" =~ ^[A-Za-z0-9_-]+\.conf$ ]] || die "DROPIN_NAME '$DROPIN_NAME' set in $CONFIG_FILE is invalid — must match ^[A-Za-z0-9_-]+\\.conf\$"
  [[ -n "$UNIT_GLOB" && "$UNIT_GLOB" != */* ]] || die "UNIT_GLOB '$UNIT_GLOB' set in $CONFIG_FILE is invalid — must be non-empty and contain no '/'"
  [[ "$DEFAULT_PROFILE" =~ ^[A-Za-z0-9_]+$ ]] || die "DEFAULT_PROFILE '$DEFAULT_PROFILE' set in $CONFIG_FILE is invalid — must match ^[A-Za-z0-9_]+\$"
  [[ "$STALL_SEC" =~ ^[0-9]+$ ]] || die "STALL_SEC '$STALL_SEC' set in $CONFIG_FILE is invalid — want a whole number of seconds (0 disables the stalled flag)"
  [[ "$REAP_GRACE_SEC" =~ ^[0-9]+$ ]] || die "REAP_GRACE_SEC '$REAP_GRACE_SEC' set in $CONFIG_FILE is invalid — want a whole number of seconds"
  [[ "$PRESSURE_WARN_PCT" =~ ^[0-9]+$ && "$PRESSURE_CRIT_PCT" =~ ^[0-9]+$ ]] || die "PRESSURE_WARN_PCT/PRESSURE_CRIT_PCT set in $CONFIG_FILE are invalid — want whole percentages"
  # Fleet settings (GHR-39). Validated here, once, rather than per host: a
  # typo in a fleet-wide config should fail before anything is dialled, not
  # produce N identical errors after N connections have been made.
  [[ "$FLEET_PARALLEL" =~ ^[1-9][0-9]*$ ]] || die "FLEET_PARALLEL '$FLEET_PARALLEL' set in $CONFIG_FILE is invalid — want a whole number of hosts, 1 or more"
  [[ "$FLEET_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "FLEET_TIMEOUT '$FLEET_TIMEOUT' set in $CONFIG_FILE is invalid — want a whole number of seconds, 1 or more"
  [ -n "$FLEET_RUNNERCTL" ] || die "FLEET_RUNNERCTL set in $CONFIG_FILE is empty — want the remote command name or an absolute path"
  # Provisioning settings (GHR-45). Checked here so a typo fails before a
  # download, a useradd or a registration — not half way through slot 3.
  [[ "$RUNNER_ROOT" == /* ]] || die "RUNNER_ROOT '$RUNNER_ROOT' set in $CONFIG_FILE is invalid — want an absolute path"
  valid_user_name "$RUNNER_USER" || die "RUNNER_USER '$RUNNER_USER' set in $CONFIG_FILE is invalid — want a POSIX user name"
  [ -z "$RUNNER_GROUP" ] || valid_user_name "$RUNNER_GROUP" || die "RUNNER_GROUP '$RUNNER_GROUP' set in $CONFIG_FILE is invalid — want a POSIX group name"
  [ -z "$RUNNER_NAME_PREFIX" ] || valid_runner_name "$RUNNER_NAME_PREFIX" || die "RUNNER_NAME_PREFIX '$RUNNER_NAME_PREFIX' set in $CONFIG_FILE is invalid — want letters, digits, dot, dash or underscore"
  [ -z "$RUNNER_VERSION" ] || valid_runner_version "$RUNNER_VERSION" || die "RUNNER_VERSION '$RUNNER_VERSION' set in $CONFIG_FILE is invalid — want X.Y.Z"
  [[ "$RUNNER_WORK" != /* && -n "$RUNNER_WORK" ]] || die "RUNNER_WORK '$RUNNER_WORK' set in $CONFIG_FILE is invalid — want a path relative to the runner's own directory"
  [ -z "$RUNNER_URL" ] || valid_runner_url "$RUNNER_URL" || die "RUNNER_URL '$RUNNER_URL' set in $CONFIG_FILE is invalid — want https://github.com/<org>[/<repo>] or an enterprise URL"
}

# Built-in profiles. Site-specific values belong in the config file; these are
# sane, generic defaults so the tool works with no config at all.
builtin_profile() {
  case "$1" in
    ci)
      # Memory-capped so parallel jobs can't OOM a shared box; auto-restart.
      # 2 slots × 26G leaves headroom on a 60G box; bump on a bigger box.
      # MemoryHigh sits 1G under the cap on purpose: memory.high throttles
      # instead of killing, and a build crawling in a wide throttle band
      # for hours is worse for CI than a fast exit 137 (GHR-28).
      PROFILE_DESC="CI build/test pool — memory-capped, auto-restart."
      MEM_MAX="26G"; MEM_HIGH="25G"; RESTART_SEC="10"; ENV_FILE=""
      ;;
    deploy)
      # Long-lived, auto-restart, uncapped (deploys are SSH/release-bound and a
      # cap risks killing a mid-deploy step). Secrets come from a root-owned
      # on-device EnvironmentFile, never from GitHub Actions secrets.
      PROFILE_DESC="Deploy runner — on-device secrets, uncapped, auto-restart."
      MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="15"; ENV_FILE="/etc/runnerctl/deploy.env"
      ;;
    *) return 1 ;;
  esac
}

load_profile() {
  [ -n "$PROFILE" ] || PROFILE="$DEFAULT_PROFILE"
  [[ "$PROFILE" =~ ^[A-Za-z0-9_]+$ ]] || die "invalid profile name '$PROFILE'"
  if declare -F "profile_$PROFILE" >/dev/null; then
    "profile_$PROFILE"
  elif ! builtin_profile "$PROFILE"; then
    die "unknown profile '$PROFILE' (known: $(list_profiles | paste -sd" "))"
  fi
}

list_profiles() {
  { printf 'ci\ndeploy\n'; declare -F | awk '$3 ~ /^profile_/ {sub(/^profile_/, "", $3); print $3}'; } | sort -u
}

# EnvironmentFile template for env-init, in priority order: a config-defined
# env_template_<profile> function, an ENV_TEMPLATE file path set by the
# profile, else a generic placeholder header. The live file is filled in on the
# box and never committed anywhere.
render_env_template() {
  if declare -F "env_template_$PROFILE" >/dev/null; then
    "env_template_$PROFILE"
  elif [ -n "$ENV_TEMPLATE" ]; then
    [ -r "$ENV_TEMPLATE" ] || die "ENV_TEMPLATE $ENV_TEMPLATE not readable"
    cat "$ENV_TEMPLATE"
  else
    cat <<TEMPLATE
# $PROFILE runner — on-device secrets/config (scaffolded by runnerctl).
#
# Loaded by the runner's systemd unit (EnvironmentFile=) so jobs inherit these
# as environment variables.
#
# * This file is root-owned, chmod 600, and lives ONLY on this device.
# * Never commit it, and keep these values out of GitHub Actions secrets —
#   on-device is the whole point (shrinks the blast radius of the runner).
#
# Define a site-specific template in the runnerctl config file with an
# env_template_${PROFILE}() function, or point ENV_TEMPLATE at a file.

# KEY=value
TEMPLATE
  fi
}

# --- Argument handling --------------------------------------------------------
# Pull --profile out of the arg list first so the profile loads before any
# value flags, letting flags override the profile's defaults. Leaves the rest
# of the args in the REMAINING array.
extract_profile() {
  REMAINING=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --profile) need_val "$@"; PROFILE="$2"; shift 2 ;;
      *) REMAINING+=("$1"); shift ;;
    esac
  done
}

# A memory limit as systemd's MemoryMax=/MemoryHigh= accept it: a byte count
# with an optional K/M/G/T suffix, or the literal "infinity".
valid_mem() { [[ "$1" =~ ^[0-9]+[KMGT]?$ ]] || [ "$1" = infinity ]; }

parse_opts() {
  TARGETS=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --max)         need_val "$@"; valid_mem "$2" || die "--max value '$2' is invalid — want an integer with an optional K/M/G/T suffix, or 'infinity'"; MEM_MAX="$2"; shift 2 ;;
      --high)        need_val "$@"; valid_mem "$2" || die "--high value '$2' is invalid — want an integer with an optional K/M/G/T suffix, or 'infinity'"; MEM_HIGH="$2"; shift 2 ;;
      --restart-sec) need_val "$@"; [[ "$2" =~ ^[0-9]+$ ]] || die "--restart-sec value '$2' is invalid — want an integer"; RESTART_SEC="$2"; shift 2 ;;
      --env-file)    need_val "$@"; ENV_FILE="$2"; shift 2 ;;
      --restart)     do_restart=true; shift ;;
      --when-idle)   when_idle=true; shift ;;
      --timeout)     need_val "$@"; set_timeout "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             TARGETS+=("$1"); shift ;;
    esac
  done
}

# --timeout N: whole seconds. Shared by parse_opts and cmd_ctl's own loop.
set_timeout() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "--timeout value '$1' is invalid — want an integer number of seconds"
  WAIT_TIMEOUT="$1"
}

# --- Runner discovery / inspection -------------------------------------------
# `list-unit-files` exits 1 when the glob matches nothing, and under `pipefail`
# that became discover's own status — so `have="$(discover | wc -l)"` in
# `provision` inherited it and `set -e` killed the script before its first
# echo: no output, exit 1, on precisely the bare host provision exists for
# (GHR-48). A host with no runner units is an answer, not a failure, so the
# status is swallowed here rather than at each of the sixteen call sites.
discover() {
  { systemctl list-unit-files --no-legend "$UNIT_GLOB" 2>/dev/null || true; } \
    | awk '{print $1}' | sort -V
}

# A host with no runner units is the normal state of a NEW box, not a broken
# one, so the refusal names the command that fixes it (GHR-45) instead of
# leaving the reader to find out that `install` installs this script and
# nothing here installs a runner.
require_runners() {
  [ -n "$(discover)" ] || die "no '$UNIT_GLOB' units found on this host. This box has no runners yet — 'runnerctl provision N --url https://github.com/<org>' installs and registers them; 'runnerctl provision --help' lists the options."
}

prop() { systemctl show "$1" -p "$2" --value 2>/dev/null; }

# One `systemctl show` call for every property `status` needs, instead of one
# per column: prints KEY=VALUE lines (a value can itself contain '=', e.g.
# EnvironmentFiles=/etc/x (ignore_errors=no) — callers must split on the
# FIRST '=' only). A config can shadow this to stub `status` under test.
unit_props() {
  systemctl show "$1" -p ActiveState,SubState,UnitFileState,MemoryMax,MemoryHigh,MemoryCurrent,MemoryPeak,Restart,EnvironmentFiles,ControlGroup,ActiveEnterTimestampMonotonic,InactiveEnterTimestampMonotonic,NRestarts,Result,InvocationID 2>/dev/null
}

# --- What is a runner working on? ---------------------------------------------
# The Listener writes two lines to its stdout (the journal, via the svc.sh
# unit) that bracket every job:
#   <utc>: Running job: <job display name>
#   <utc>: Job <job display name> completed with result: Succeeded|Failed|Canceled
# The last `Running job:` line with no later `completed with result:` line is
# the job the slot is on, for the whole job — stable between steps and for
# container jobs, where the /proc environ walk below sees nothing — and it is
# readable by anyone in the systemd-journal group, not only the runner user.
# The strings are from the actions/runner source (Runner.Listener's
# JobDispatcher), not yet verified against a host's journal.
#
# Prints the journal lines of UNIT's current invocation (scoped by
# INVOCATION-ID when given, so a previous run's job cannot leak in) that
# mention a job start or end, in `-o short-unix` form: the first field is the
# epoch second the line was logged. Returns 1 and prints nothing when the
# journal cannot be read. `--system` is load-bearing for that: without it a
# user outside systemd-journal gets an EMPTY journal and exit 0 (probed on
# systemd 261), indistinguishable from an idle slot; with it journalctl says
# "insufficient permissions" and exits 1. Read-only and called directly, never
# through run_priv — status must never prompt for sudo. A config can shadow
# this to stub it.
#
# The filtering is journalctl's own `-g` (a regex over MESSAGE), not a tail:
# a `-n` window would be eaten by every other line the Listener writes
# ("Listening for Jobs", update checks, per-job noise), so on a slot up for
# weeks the `(N jobs)` count would silently cover only the last few hundred
# lines (GHR-26). With `-g` the fetch is exactly the job lines of the
# invocation, however long it has been running.
JOURNAL_JOB_PATTERN='Running job: |completed with result: '

# The journalctl argv for UNIT [INVOCATION-ID], one argument per line, so the
# harness can assert on it without a journal (journal_job_lines itself is
# stubbed under `make sim`).
journal_job_args() { # UNIT [INVOCATION-ID]
  printf '%s\n' --system -u "$1" -o short-unix --no-pager -q -g "$JOURNAL_JOB_PATTERN"
  [ -n "${2:-}" ] && printf '%s\n' "_SYSTEMD_INVOCATION_ID=$2"
  return 0
}

journal_job_lines() { # UNIT [INVOCATION-ID]
  local args=()
  mapfile -t args < <(journal_job_args "$@")
  journalctl "${args[@]}" 2>/dev/null || return 1
}

# Journal memo for `watch` (GHR-3). A redraw every 2 s would otherwise run
# one journalctl per slot per tick, and a job start or end is not worth
# seeing that fast: `watch` keeps a memo directory and empties it every
# JOURNAL_CACHE_TTL ticks, so the journal-derived cells lag a redraw by up to
# TTL × interval seconds while everything else is live. It is a directory,
# not an array, because the renderer runs inside "$(...)" (twice: the frame
# capture and job_info's cell) and nothing written to a shell variable there
# survives the tick. Outside `watch` JOURNAL_MEMO_DIR is empty and every call
# goes straight to the journal_job_lines hook — a plain `status` and the
# --when-idle polls are never stale. The memo wraps the hook rather than
# replacing it, so a config that shadows journal_job_lines is what gets
# memoised. Keyed by unit and invocation id, so a restart is a fresh entry.
JOURNAL_CACHE_TTL=10
JOURNAL_MEMO_DIR=""
journal_job_lines_cached() { # UNIT [INVOCATION-ID]
  [ -n "$JOURNAL_MEMO_DIR" ] || { journal_job_lines "$@"; return; }
  local f="$JOURNAL_MEMO_DIR/$1.${2:-none}" out rc=0
  if [ ! -f "$f.rc" ]; then
    out="$(journal_job_lines "$@")" || rc=$?
    printf '%s\n' "$out" >"$f"
    echo "$rc" >"$f.rc"
  fi
  cat "$f"
  rc="$(cat "$f.rc")"
  return "$rc"
}

# Parse those lines: prints "<job name>\t<epoch second>" for the running job
# (the last `Running job:` line with no later `completed with result:` line),
# nothing when the slot is idle. Pure, so it is unit-testable (`run_fn`).
journal_running_job() { # LINES
  local line name="" ts=""
  while IFS= read -r line; do
    case "$line" in
      *"completed with result: "*) name=""; ts="" ;;
      *"Running job: "*)           name="${line##*Running job: }"; ts="${line%% *}"; ts="${ts%%.*}" ;;
    esac
  done <<<"$1"
  [ -n "$name" ] || return 0
  printf '%s\t%s\n' "$name" "$ts"
}

# The idle side of the same lines: prints "<epoch second of the last
# completion>\t<completed count>" — the count of `completed with result:`
# lines, i.e. jobs finished in this invocation of the unit — nothing when no
# job has completed since the unit started. Pure, like journal_running_job;
# both read the one journal fetch job_info already makes (GHR-2).
journal_idle_info() { # LINES
  local line ts="" n=0
  while IFS= read -r line; do
    case "$line" in
      *"completed with result: "*) n=$((n + 1)); ts="${line%% *}"; ts="${ts%%.*}" ;;
    esac
  done <<<"$1"
  [ "$n" -gt 0 ] || return 0
  printf '%s\t%s\n' "$ts" "$n"
}

# GHR-8: the reason a slot's last restart happened, for the ACTIVE cell's
# "(last: ...)" suffix. systemd resets NRestarts on `systemctl start/restart`
# but the *reason* for a previous restart only exists in the journal —
# systemd[1]'s own "A process of this unit has been killed by the OOM
# killer." sentence, or its "Main process exited, code=X, status=N[/NAME]"
# line — not yet verified against a host's journal. Called only when
# NRestarts > 0 (one extra journalctl fork per slot, at most), read-only and
# direct like journal_job_lines — status must never prompt for sudo. Prints
# nothing when the journal cannot be read or carries neither line. A config
# can shadow this to stub it.
journal_restart_reason() { # UNIT
  local out lines line
  out="$(journalctl --system -u "$1" -o cat --no-pager -q -n 200 2>/dev/null)" || return 0
  lines="$(grep -E 'OOM killer|Main process exited' <<<"$out" || true)"
  [ -n "$lines" ] || return 0
  line="$(tail -n1 <<<"$lines")"
  journal_restart_reason_line "$line"
}

# Pure normaliser for one journal line (unit-testable via run_fn), like
# journal_running_job/journal_idle_info are for journal_job_lines' output:
#   *killed by the OOM killer*                       -> oom-kill
#   Main process exited, code=exited, status=N[/...]  -> exit-code N
#   Main process exited, code=killed, status=N/NAME   -> signal NAME
# Nothing, and success (0), for a line matching none of these.
journal_restart_reason_line() { # LINE
  case "$1" in
    *'killed by the OOM killer'*) echo "oom-kill"; return 0 ;;
  esac
  if [[ "$1" =~ code=exited,\ status=([0-9]+) ]]; then
    printf 'exit-code %s\n' "${BASH_REMATCH[1]}"; return 0
  fi
  if [[ "$1" =~ code=killed,\ status=[0-9]+/([A-Za-z0-9]+) ]]; then
    printf 'signal %s\n' "${BASH_REMATCH[1]}"; return 0
  fi
  return 0
}

# The /proc side: only the runner's user or root can read a slot's processes.
# Three hooks, so a config can stub the walk without replacing job_info.
cgroup_readable() { [ -n "${1:-}" ] && [ -r "/sys/fs/cgroup${1}/cgroup.procs" ]; }

# Runner.Worker is spawned once per job, so its age is the job's runtime.
# Prints its pid; nothing when there is none or the cgroup cannot be read.
proc_worker_pid() { # CGROUP
  local pid
  cgroup_readable "$1" || return 0
  while read -r pid; do
    if [ -r "/proc/$pid/cmdline" ] && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "Runner.Worker"; then
      echo "$pid"; return 0
    fi
  done <"/sys/fs/cgroup${1}/cgroup.procs"
}

# GITHUB_REPOSITORY / GITHUB_JOB from the environment of the first process in
# the cgroup that carries them (GITHUB_* is injected into the STEP processes,
# not into Runner.Worker, so between steps and for container jobs there is
# none). Prints the two KEY=VALUE lines; nothing otherwise.
proc_job_env() { # CGROUP
  local pid env
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/environ" ] || continue
    env="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null || true)"
    case "$env" in
      *GITHUB_REPOSITORY=*) grep -E '^GITHUB_(REPOSITORY|JOB)=' <<<"$env"; return 0 ;;
    esac
  done <"/sys/fs/cgroup${1}/cgroup.procs"
}

# GHR-29: the processes in the cgroup that are not the runner's own — what a
# finished job left behind (a dev server, a watcher, a node child that
# ignored SIGTERM). Prints `pid<TAB>comm` per process; nothing when the
# cgroup cannot be read. Only meaningful while the slot is idle: during a
# job every step process is "not the runner's own" too, so job_facts asks
# only then. The runner's own tree, as svc.sh installs it: runsvc.sh ->
# node RunnerService.js -> Runner.Listener, which spawns Runner.Worker per
# job and Runner.PluginHost for its own plugins. A config can extend the
# pattern (RUNNER_OWN_PATTERN) for a runner image that wraps it differently.
# Processes in a job's own docker containers live under the docker daemon,
# not here — neither the cap nor this walk sees them.
RUNNER_OWN_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.(Listener|Worker|PluginHost)'
proc_leaked() { # CGROUP
  local pid cmd comm
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    # An empty cmdline is a zombie or a kernel thread: nothing to kill.
    [ -n "$cmd" ] || continue
    [[ "$cmd" =~ $RUNNER_OWN_PATTERN ]] && continue
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"
    printf '%s\t%s\n' "$pid" "$comm"
  done <"/sys/fs/cgroup${1}/cgroup.procs"
}

# GHR-36: the job's own process tree — everything in the cgroup that is NOT
# the Listener side of the runner. `runsvc.sh` -> node RunnerService.js ->
# Runner.Listener is what must survive a `kill`: it is the process that
# notices its Worker died, reports the job failed to GitHub and goes back to
# waiting, so the slot is idle in seconds with no restart and no
# re-registration. Everything else in the cgroup — Runner.Worker,
# Runner.PluginHost and every step process under them — is the job.
# Prints `pid<TAB>comm` per process; nothing when the cgroup cannot be read
# (then `kill` escalates to systemd, which can signal it without reading it).
# Containers a job started live under the docker daemon's cgroup, not here.
RUNNER_LISTENER_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.Listener'
proc_job_tree() { # CGROUP
  local pid cmd comm
  cgroup_readable "$1" || return 0
  while read -r pid; do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    # An empty cmdline is a zombie or a kernel thread: nothing to kill.
    [ -n "$cmd" ] || continue
    [[ "$cmd" =~ $RUNNER_LISTENER_PATTERN ]] && continue
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"
    printf '%s\t%s\n' "$pid" "$comm"
  done <"/sys/fs/cgroup${1}/cgroup.procs"
}

# Is PID still around (and not a zombie)? Behind a function so a test
# config can answer for `reap`'s survivors.
pid_alive() { # PID
  local s
  s="$(awk '/^State:/{print $2}' "/proc/$1/status" 2>/dev/null)" || return 1
  [ -n "$s" ] && [ "$s" != Z ]
}

# GHR-31: what the kernel says about the slot's memory, from its cgroup.
# memory.events carries counters since the unit started — `high`: times
# memory.high throttled it, `max`: times it hit memory.max, `oom_kill`:
# processes the OOM killer took — and memory.pressure the PSI line `full
# avg10=X avg60=Y avg300=Z total=US`: the share of the last 10/60/300 s
# EVERY task in the cgroup spent stalled on memory. Prints one key=value
# line each (events_high, events_max, events_oom_kill, pressure_full_avg10,
# pressure_full_avg60, pressure_full_total); nothing for an empty cgroup or
# a file that cannot be read. Plain reads, no run_priv — both files are
# world-readable, so status never prompts. A config can shadow it.
cgroup_memory_facts() { # CGROUP
  local d="/sys/fs/cgroup${1:-}" k v
  [ -n "${1:-}" ] || return 0
  if [ -r "$d/memory.events" ]; then
    while read -r k v; do
      case "$k" in high|max|oom_kill) echo "events_$k=$v" ;; esac
    done <"$d/memory.events"
  fi
  if [ -r "$d/memory.pressure" ]; then
    awk '$1 == "full" { for (i = 2; i <= NF; i++) { split($i, a, "="); if (a[1] == "avg10" || a[1] == "avg60" || a[1] == "total") print "pressure_full_" a[1] "=" a[2] } }' "$d/memory.pressure"
  fi
}

# Epoch seconds; a config can shadow it to pin the journal-derived runtime.
now_epoch() { date +%s; }

# The WORKING-ON cell. Takes the cgroup, invocation id and active-enter stamp
# (µs since boot) from the caller's already-fetched unit_props (GHR-4)
# instead of fetching them itself.
#   —              the unit has no cgroup (not running)
#   idle 2h31m (7 jobs)
#                  the journal is readable and no job is in flight: time
#                  since the last `completed with result:` line of this
#                  invocation, and how many there are — jobs finished since
#                  the unit started (GHR-2)
#   idle 41m (no jobs yet)
#                  idle, and nothing has completed since the unit started:
#                  time since the active-enter stamp instead
#   repo:job (7h2m) STALLED
#                  the job has run for STALL_SEC seconds or more (GHR-27)
#   repo:job (12m) the journal names the job; the repo comes from the /proc
#                  environ walk when that is readable (the job name alone
#                  otherwise), the runtime from the Runner.Worker age, or from
#                  the `Running job:` line's journal timestamp when the worker
#                  cannot be seen
# Without journal access the old /proc-only logic runs, and `(starting)`
# survives only there: a live Runner.Worker with no GITHUB_* process is the
# only signal of a job in /proc, and it cannot tell startup from between-steps
# (the flicker GHR-10 removes for every reader with journal access).
#   idle ?         the cgroup is readable but the journal is not: /proc shows
#                  no job, and the idle time and count are unknowable there
#   (no access)    neither the journal nor the cgroup can be read
# For the last two cmd_status prints a one-line hint under the table.
#
# GHR-16: the facts and the cell are two functions over one journal fetch.
# job_facts leaves the raw picture in the JOB_* variables — the table
# (job_cell) and `status --json` both read those, so the two cannot disagree
# on what a slot is doing:
#   JOB_STATE   none | running | idle | idle-fresh | starting | idle-unknown
#               | no-access — `running` covers both the journal's answer and
#               the /proc-only one, `idle-fresh` is "idle (no jobs yet)"
#   JOB_NAME / JOB_REPO
#               the running job and its repository (short, `my-app`), either
#               empty when unknown
#   JOB_SINCE   epoch second the running job started: the Runner.Worker's
#               start when it can be seen, else the `Running job:` line's
#               stamp; empty when neither is known
#   JOB_RUNTIME the running job's age as the cell prints it, empty when unknown
#   JOB_STALLED true when the running job's age is STALL_SEC or more, false
#               when it is known and under, empty when the age is unknown
#               or STALL_SEC is 0 (GHR-27)
#   JOB_IDLE_SINCE / JOB_DONE
#               epoch second of the last completion (or of the unit's start
#               for idle-fresh) and the completed count (0 for idle-fresh)
#   JOB_ACCESS  ok | no-journal | no-access — what could be read: `no-journal`
#               is the /proc-only picture, `no-access` neither source
#   JOB_LEAKED / JOB_LEAKED_PIDS / JOB_LEAKED_COMMS
#               while idle with a readable cgroup: how many processes a
#               finished job left in it, their pids (space-separated) and
#               their comms (comma-separated); JOB_LEAKED empty when the
#               slot is busy or the cgroup cannot be read (GHR-29)
JOB_STATE="" JOB_NAME="" JOB_REPO="" JOB_SINCE="" JOB_RUNTIME="" JOB_STALLED="" JOB_IDLE_SINCE="" JOB_DONE="" JOB_ACCESS=""
JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
# The JOB_LEAKED_* facts from one proc_leaked walk of CGROUP, per the
# contract above. Only called on an idle slot.
job_leak_check() { # CGROUP
  local line pid comm
  JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
  cgroup_readable "$1" || return 0
  JOB_LEAKED=0
  while IFS=$'\t' read -r pid comm; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    JOB_LEAKED=$((JOB_LEAKED + 1))
    JOB_LEAKED_PIDS+="${JOB_LEAKED_PIDS:+ }$pid"
    JOB_LEAKED_COMMS+="${JOB_LEAKED_COMMS:+, }${comm:-?}"
  done < <(proc_leaked "$1")
}
# GHR-36: the job-side processes of the cgroup, for `kill`. Same shape as
# job_leak_check — JOB_TREE is "" when the cgroup cannot be read (the caller
# then has nothing to signal itself and hands the unit to systemd) and 0 when
# it is readable and holds nothing but the Listener's own tree.
job_tree_check() { # CGROUP
  local pid comm
  JOB_TREE="" JOB_TREE_PIDS="" JOB_TREE_COMMS=""
  cgroup_readable "$1" || return 0
  JOB_TREE=0
  while IFS=$'\t' read -r pid comm; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    JOB_TREE=$((JOB_TREE + 1))
    JOB_TREE_PIDS+="${JOB_TREE_PIDS:+ }$pid"
    JOB_TREE_COMMS+="${JOB_TREE_COMMS:+, }${comm:-?}"
  done < <(proc_job_tree "$1")
}
# JOB_STALLED from the running job's age (seconds), per the contract above.
job_stall_check() { # AGE-SECONDS
  JOB_STALLED=""
  [[ "${1:-}" =~ ^[0-9]+$ ]] && [ "$STALL_SEC" -gt 0 ] || return 0
  if [ "$1" -ge "$STALL_SEC" ]; then JOB_STALLED=true; else JOB_STALLED=false; fi
}
job_facts() { # UNIT CGROUP [INVOCATION-ID] [ACTIVE-ENTER-US]
  local u="$1" cg="$2" lines rj ii ts env worker age=""
  JOB_STATE=none JOB_NAME="" JOB_REPO="" JOB_SINCE="" JOB_RUNTIME="" JOB_STALLED="" JOB_IDLE_SINCE="" JOB_DONE="" JOB_ACCESS=ok
  JOB_LEAKED="" JOB_LEAKED_PIDS="" JOB_LEAKED_COMMS=""
  # The cgroup this picture was read from, for a caller that then has to act
  # on the processes in it (`kill`, GHR-36).
  JOB_CGROUP="$cg"
  [ -n "$cg" ] || return 0
  if lines="$(journal_job_lines_cached "$u" "${3:-}")"; then
    rj="$(journal_running_job "$lines")"
    if [ -z "$rj" ]; then
      ii="$(journal_idle_info "$lines")"
      if [ -n "$ii" ]; then
        JOB_STATE=idle
        ts="${ii%%$'\t'*}"; JOB_DONE="${ii#*$'\t'}"
        [[ "$ts" =~ ^[0-9]+$ ]] && JOB_IDLE_SINCE="$ts"
      else
        JOB_STATE="idle-fresh" JOB_DONE=0
        JOB_IDLE_SINCE="$(age_to_epoch "$(state_age active "${4:-}" "")")"
      fi
      job_leak_check "$cg"
      return 0
    fi
    JOB_STATE=running
    JOB_NAME="${rj%%$'\t'*}"; ts="${rj#*$'\t'}"
    JOB_REPO="$(proc_job_env "$cg" | grep -m1 '^GITHUB_REPOSITORY=' | cut -d= -f2- || true)"
    JOB_REPO="${JOB_REPO##*/}"
    worker="$(proc_worker_pid "$cg")"
    if [ -n "$worker" ]; then
      age="$(proc_age "$worker")"
      if [ -n "$age" ]; then JOB_RUNTIME="$(fmt_dur "$age")"; JOB_SINCE="$(age_to_epoch "$age")"; fi
    elif [[ "$ts" =~ ^[0-9]+$ ]]; then
      age=$(( $(now_epoch) - ts ))
      JOB_SINCE="$ts"; JOB_RUNTIME="$(fmt_dur "$age")"
    fi
    job_stall_check "$age"
    return 0
  fi
  cgroup_readable "$cg" || { JOB_STATE="no-access" JOB_ACCESS="no-access"; return 0; }
  JOB_ACCESS=no-journal
  worker="$(proc_worker_pid "$cg")"
  if [ -n "$worker" ]; then
    age="$(proc_age "$worker")"
    if [ -n "$age" ]; then JOB_RUNTIME="$(fmt_dur "$age")"; JOB_SINCE="$(age_to_epoch "$age")"; fi
  fi
  env="$(proc_job_env "$cg")"
  if [ -n "$env" ]; then
    JOB_STATE=running
    JOB_REPO="$(grep -m1 '^GITHUB_REPOSITORY=' <<<"$env" | cut -d= -f2- || true)"
    JOB_REPO="${JOB_REPO##*/}"
    JOB_NAME="$(grep -m1 '^GITHUB_JOB=' <<<"$env" | cut -d= -f2- || true)"
    job_stall_check "$age"
  elif [ -n "$worker" ]; then
    JOB_STATE=starting
  else
    JOB_STATE="idle-unknown"
    job_leak_check "$cg"
  fi
}

# The WORKING-ON cell from the JOB_* facts job_facts left behind.
job_cell() {
  case "$JOB_STATE" in
    none)         echo "—" ;;
    running)      printf '%s%s%s%s\n' "${JOB_REPO:+$JOB_REPO:}" "${JOB_NAME:-?}" "${JOB_RUNTIME:+ ($JOB_RUNTIME)}" \
                    "$([ "$JOB_STALLED" != true ] || echo " STALLED")" ;;
    idle)         printf 'idle %s (%s job%s)%s\n' "$(fmt_dur "$([ -z "$JOB_IDLE_SINCE" ] || echo $(( $(now_epoch) - JOB_IDLE_SINCE )))")" \
                    "$JOB_DONE" "$([ "$JOB_DONE" -eq 1 ] || echo s)" "$(leaked_suffix)" ;;
    idle-fresh)   echo "idle $(fmt_dur "$([ -z "$JOB_IDLE_SINCE" ] || echo $(( $(now_epoch) - JOB_IDLE_SINCE )))") (no jobs yet)$(leaked_suffix)" ;;
    starting)     echo "(starting)" ;;
    idle-unknown) echo "idle ?$(leaked_suffix)" ;;
    no-access)    echo "(no access)" ;;
  esac
}

# ` +N leaked` for an idle cell when a finished job left processes behind
# (GHR-29); nothing when there are none or it cannot be known.
leaked_suffix() {
  [[ "$JOB_LEAKED" =~ ^[0-9]+$ ]] && [ "$JOB_LEAKED" -gt 0 ] || return 0
  echo " +$JOB_LEAKED leaked"
}

# Facts and cell in one call, for a caller that only wants the text.
job_info() { # UNIT CGROUP [INVOCATION-ID] [ACTIVE-ENTER-US]
  job_facts "$@"
  job_cell
}

# --- Waiting for a slot to go idle (GHR-11) -----------------------------------
# Unit name -> what `status` prints as RUNNER.
short_name() { local s="${1#actions.runner.}"; echo "${s%.service}"; }

# `sleep`, behind a function so a test config can shadow it (the stub logs
# the call and does not sleep).
pause() { sleep "$1"; }

# Is UNIT safe to restart/stop right now? One unit_props fetch, then the same
# job_info cell `status` shows, left in SLOT_JOB for the caller's message.
#   —, idle …      0 (not running, or running with no job in flight)
#   (no access)    1 — cannot be proven idle; wait_idle refuses at once rather
#                  than polling a condition that cannot change
#   anything else  1 (a job, or (starting))
SLOT_JOB=""
# One unit_props fetch, then job_facts on it: the JOB_* picture of UNIT for
# a command that acts on one slot at a time (--when-idle, --if-stalled,
# reap) rather than through collect_slot.
SLOT_ACTIVE="" SLOT_SUB=""
slot_job_facts() { # UNIT
  local cg="" inv="" ae="" k v
  SLOT_ACTIVE="" SLOT_SUB=""
  while IFS='=' read -r k v; do
    case "$k" in
      ControlGroup) cg="$v" ;;
      InvocationID) inv="$v" ;;
      ActiveEnterTimestampMonotonic) ae="$v" ;;
      # GHR-36: `kill` needs to tell a running slot from one already wedged
      # in its own stop (deactivating/stop-sigterm), where the job is gone
      # from systemd's point of view but nothing has actually died.
      ActiveState) SLOT_ACTIVE="$v" ;;
      SubState) SLOT_SUB="$v" ;;
    esac
  done < <(unit_props "$1")
  job_facts "$1" "$cg" "$inv" "$ae"
}
slot_is_idle() { # UNIT
  slot_job_facts "$1"
  SLOT_JOB="$(job_cell)"
  case "$SLOT_JOB" in
    —|idle|idle\ *) return 0 ;;
    *)              return 1 ;;
  esac
}

# The job cell as prose: `my-app:test (12m)` -> `my-app:test, 12m`.
job_desc() {
  case "$1" in
    *\ \(*\)) local d="${1% (*}, ${1##* (}"; echo "${d%)}" ;;
    *)        echo "$1" ;;
  esac
}

# Poll slot_is_idle every POLL_SEC until UNIT is idle. Prints a `waiting for`
# line the first time it has to wait and every ~60 s after that. Elapsed time
# is counted as polls × POLL_SEC — the time it *would* have slept — not read
# from a clock, so a stubbed pause still reaches the timeout deterministically.
#   0  idle (possibly immediately)
#   1  still busy after TIMEOUT seconds
#   2  (no access): refused without waiting
wait_idle() { # UNIT TIMEOUT
  local u="$1" timeout="$2" waited=0 last_said=-60 short
  # A zero or junk interval would never advance the clock: refuse it.
  [[ "$POLL_SEC" =~ ^[1-9][0-9]*$ ]] || die "POLL_SEC must be a positive integer (config sets '$POLL_SEC')"
  short="$(short_name "$u")"
  while ! slot_is_idle "$u"; do
    [ "$SLOT_JOB" != "(no access)" ] || return 2
    [ "$waited" -lt "$timeout" ] || return 1
    if [ $((waited - last_said)) -ge 60 ]; then
      echo "waiting for $short ($(job_desc "$SLOT_JOB")) …"
      last_said=$waited
    fi
    pause "$POLL_SEC"
    waited=$((waited + POLL_SEC))
  done
}

# wait_idle failed for UNIT with RC: say why, what was already done (HANDLED,
# space-separated units — those stay done) and what was not touched
# (REMAINING), then exit 1. Nothing is ever force-killed.
wait_failed() { # RC UNIT VERB HANDLED REMAINING
  local rc="$1" u="$2" verb="$3" handled="$4" remaining="$5" short r busy idle=""
  short="$(short_name "$u")"
  case "$rc" in
    2) echo "runnerctl: cannot tell whether $short is idle — --when-idle needs journal read access (systemd-journal group) or root" >&2 ;;
    *) echo "runnerctl: timed out after ${WAIT_TIMEOUT}s waiting for $short ($(job_desc "$SLOT_JOB"))" >&2 ;;
  esac
  busy="$short"
  for r in $remaining; do
    if slot_is_idle "$r"; then idle+="${idle:+, }$(short_name "$r")"; else busy+=", $(short_name "$r")"; fi
  done
  echo "  already ${verb}: $(join_short "$handled")" >&2
  echo "  busy or unreadable, not ${verb}: $busy" >&2
  [ -z "$idle" ] || echo "  idle but not ${verb} (queued after the busy one): $idle" >&2
  exit 1
}

# The per-slot gate every --when-idle command calls before its systemctl:
# a no-op unless --when-idle was given, otherwise wait_idle, and on failure
# wait_failed (which exits 1). HANDLED and REMAINING are space-separated.
idle_gate() { # UNIT VERB HANDLED REMAINING
  $when_idle || return 0
  local rc=0; wait_idle "$1" "$WAIT_TIMEOUT" || rc=$?
  [ "$rc" -eq 0 ] || wait_failed "$rc" "$@"
}

# GHR-30: the per-slot gate of --if-stalled. Reads the same job_facts the
# table reads and answers whether UNIT's job is STALLED right now:
#   0  stalled — a line says what is about to be VERB-ed ("restarting")
#   1  not stalled (idle, busy but young, or not running) — a skip line
# A (no access) slot dies, as --when-idle does: the question cannot be
# answered, and acting on a guess would kill a healthy job.
stalled_gate() { # UNIT VERB-ING
  local short
  short="$(short_name "$1")"
  slot_job_facts "$1"
  case "$JOB_STATE" in
    no-access) die "$short: cannot tell whether its job is stalled — --if-stalled needs journal read access (systemd-journal group) or root" ;;
    none)      echo "$short: not running — skipped"; return 1 ;;
  esac
  if [ "$JOB_STALLED" = true ]; then
    echo "$short: stalled — $(job_desc "${JOB_REPO:+$JOB_REPO:}${JOB_NAME:-?}${JOB_RUNTIME:+ ($JOB_RUNTIME)}"), longer than $(fmt_dur "$STALL_SEC") — $2"
    return 0
  fi
  echo "$short: not stalled ($(job_cell)) — skipped"
  return 1
}

# Space-separated units -> "short-1, short-2" (or "none").
join_short() {
  local u out=""
  for u in $1; do out+="${out:+, }$(short_name "$u")"; done
  echo "${out:-none}"
}

# --- Durations ----------------------------------------------------------------
# Seconds -> 12s / 41m / 3h12m / 3d 4h (a zero remainder is dropped: 6d, 2h).
# Anything that is not a non-negative integer (empty, "n/a", a negative from
# a clock that went backwards) -> —.
fmt_dur() {
  local s="${1:-}" r
  [[ "$s" =~ ^[0-9]+$ ]] || { echo "—"; return; }
  if [ "$s" -ge 86400 ]; then
    r=$(((s % 86400) / 3600))
    if [ "$r" -gt 0 ]; then echo "$((s / 86400))d ${r}h"; else echo "$((s / 86400))d"; fi
  elif [ "$s" -ge 3600 ]; then
    r=$(((s % 3600) / 60))
    if [ "$r" -gt 0 ]; then echo "$((s / 3600))h${r}m"; else echo "$((s / 3600))h"; fi
  elif [ "$s" -ge 60 ]; then
    echo "$((s / 60))m"
  else
    echo "${s}s"
  fi
}

# Microseconds since boot, from /proc/uptime — the same clock as systemd's
# *TimestampMonotonic properties, so no date/locale/TZ parsing is needed.
# Integer arithmetic only; a config can shadow this to make `status`
# deterministic under test.
now_mono() {
  local up frac
  read -r up _ </proc/uptime
  frac="${up#*.}"; [ "$frac" != "$up" ] || frac=0
  frac="${frac}000000"; frac="${frac:0:6}"   # pad/truncate to microseconds
  echo $(( ${up%%.*} * 1000000 + 10#$frac ))
}

# How long a unit has been in its ActiveState, in whole seconds: since the
# active-enter stamp while active/activating/reloading, otherwise since the
# inactive-enter stamp (StateChangeTimestamp also moves on sub-state changes,
# so it is not used). Stamps are µs since boot; 0 or empty means the state
# was never entered, and then nothing is printed. The raw figure both
# renderers derive from (GHR-16): the table formats it, the JSON turns it
# into an epoch second.
state_age() { # ACTIVE-STATE ACTIVE-ENTER-US INACTIVE-ENTER-US
  local ts
  case "$1" in
    active|activating|reloading) ts="$2" ;;
    *)                           ts="$3" ;;
  esac
  if [[ "$ts" =~ ^[0-9]+$ ]] && [ "$ts" -gt 0 ]; then
    echo $(( ($(now_mono) - ts) / 1000000 ))
  fi
}

# The SINCE cell: state_age as a duration, — when the state was never entered.
since_state() { # ACTIVE-STATE ACTIVE-ENTER-US INACTIVE-ENTER-US
  local age
  age="$(state_age "$@")"
  if [ -n "$age" ]; then fmt_dur "$age"; else echo "—"; fi
}

# Epoch second an event happened at, from how many seconds ago it was — the
# JSON side of every SINCE-like cell (GHR-16). Nothing for an empty or
# negative age (a clock that went backwards), which is where the table
# prints —.
age_to_epoch() { # AGE-SECONDS
  [[ "${1:-}" =~ ^[0-9]+$ ]] || return 0
  echo $(( $(now_epoch) - $1 ))
}

# When PID started, in µs since boot: field 22 of /proc/PID/stat, in clock
# ticks. (Not `stat -c %Y /proc/PID`: procfs stamps that directory when it is
# first looked up, not when the process forked, so it reads as "now" for a
# process nobody has inspected yet.) The comm field can contain spaces, so
# split after its closing paren. Prints nothing if PID is gone.
proc_start_mono() {
  local st tck
  st="$(cat "/proc/$1/stat" 2>/dev/null)" || return 0
  read -ra st <<<"${st##*) }"          # fields 3.., so start time is index 19
  [ "${#st[@]}" -gt 19 ] || return 0
  tck="$(getconf CLK_TCK 2>/dev/null)" || tck=100
  echo $(( st[19] * 1000000 / tck ))
}

# How many seconds PID has been alive; empty if PID cannot be read.
proc_age() {
  local start
  start="$(proc_start_mono "$1")"
  [ -n "$start" ] || return 0
  echo $(( ($(now_mono) - start) / 1000000 ))
}

hbytes() {
  local v="${1:-}"
  case "$v" in
    ''|infinity|max|18446744073709551615|'[not set]') echo "—"; return ;;
  esac
  [[ "$v" =~ ^[0-9]+$ ]] || { echo "$v"; return; }
  awk -v b="$v" 'BEGIN{ if (b<1048576) printf "%.0fM", b/1048576; else printf "%.1fG", b/1073741824 }'
}

# GHR-8: the ACTIVE cell — "<ActiveState>/<SubState>", plus a restart count
# (↻N) when NRestarts > 0 (systemd resets it on `systemctl start/restart`, so
# this is restarts since then, e.g. a crash loop the OOM killer or the start
# limiter has been resurrecting under `StartLimitIntervalSec=0`). When there
# have been restarts and the CURRENT invocation's Result is success, the
# journal may know why the LAST one happened — appended as "(last: ...)".
# RESULT itself is appended, unparenthesised, whenever it is not success:
# that is the current invocation's own reason and takes precedence over a
# journal guess. Not padded/truncated to the column width — like WORKING-ON,
# a long cell just overflows that row's alignment. Pure: the reason is looked
# up once by collect_slot (GHR-16), which is also where the JSON reads it.
status_active_cell() { # ACTIVE-STATE SUB-STATE NRESTARTS RESULT LAST-RESTART-REASON
  local cell="$1/$2" n="${3:-0}" result="${4:-success}" reason="${5:-}"
  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ]; then
    cell+=" ↻$n"
    [ -n "$reason" ] && cell+=" (last: $reason)"
  fi
  [ "$result" = success ] || cell+=" $result"
  printf '%s\n' "$cell"
}

# GHR-8: the USED cell — current memory, plus "/peak" when MemoryPeak is
# present and numeric (systemd >= 254; older systemd, or a unit whose
# MemoryAccounting is off, answers "[not set]" — fall back silently to
# current-only, same as an absent property).
status_used_cell() { # CURRENT PEAK
  local cur="$1" peak="${2:-}"
  if [[ "$peak" =~ ^[0-9]+$ ]]; then
    printf '%s/%s\n' "$(hbytes "$cur")" "$(hbytes "$peak")"
  else
    hbytes "$cur"
  fi
}

resolve() { # "unit, slot-index, or short RUNNER name" -> unit name
  local a="$1"
  mapfile -t units < <(discover)
  if [[ "$a" =~ ^[0-9]+$ ]]; then
    [ "$a" -lt "${#units[@]}" ] || die "slot index $a out of range (0..$((${#units[@]}-1)))"
    echo "${units[$a]}"
    return
  fi
  local u
  # 1. the literal unit name.
  for u in "${units[@]}"; do [ "$u" = "$a" ] && { echo "$u"; return; }; done
  # 2. actions.runner.<arg>.service
  for u in "${units[@]}"; do [ "$u" = "actions.runner.${a}.service" ] && { echo "$u"; return; }; done
  # 3. <arg>.service
  for u in "${units[@]}"; do [ "$u" = "${a}.service" ] && { echo "$u"; return; }; done
  # 4. an unambiguous prefix or substring match on the short name (what
  # `status` prints as RUNNER: the unit with "actions.runner." and ".service"
  # stripped) — either direction, so "slot-1" matches "example.slot-1" and
  # "example.slot-1.service" (typed with the suffix back on) also does.
  local short shorts=() matches=()
  for u in "${units[@]}"; do
    short="${u#actions.runner.}"; short="${short%.service}"
    shorts+=("$short")
    [[ "$short" == *"$a"* || "$a" == *"$short"* ]] && matches+=("$short")
  done
  case "${#matches[@]}" in
    1)
      for u in "${units[@]}"; do
        short="${u#actions.runner.}"; short="${short%.service}"
        [ "$short" = "${matches[0]}" ] && { echo "$u"; return; }
      done
      ;;
    0) die "no runner slot matches '$a' (have: 0..$((${#units[@]}-1)), ${shorts[*]})" ;;
    *) die "ambiguous target '$a' matches: ${matches[*]}" ;;
  esac
}

# --- Drop-in rendering --------------------------------------------------------
render_dropin() {
  echo "# Managed by runnerctl (profile: $PROFILE) — DO NOT EDIT BY HAND."
  [ -n "$PROFILE_DESC" ] && echo "# $PROFILE_DESC"
  echo "# Re-apply with: runnerctl apply --profile $PROFILE"
  echo "[Unit]"
  echo "# Don't let a crash-loop trip the start limiter and park the unit 'failed'."
  echo "StartLimitIntervalSec=0"
  echo
  echo "[Service]"
  echo "Restart=always"
  echo "RestartSec=${RESTART_SEC}"
  echo "# OOMPolicy: systemd's default (stop) takes the WHOLE unit down when the"
  echo "# kernel OOM-kills any one process of it — the job dies as 'runner lost"
  echo "# communication' and the runner restarts. With continue only the killed"
  echo "# step is gone: it exits 137, the job fails with its log, the Listener"
  echo "# stays up (GHR-28)."
  echo "OOMPolicy=continue"
  if [ -n "$ENV_FILE" ]; then
    echo "# On-device secrets/config (root-owned, chmod 600). Never in GitHub."
    echo "EnvironmentFile=${ENV_FILE}"
  fi
  if [ -n "$MEM_MAX" ]; then
    echo "# MemoryHigh: soft reclaim/throttle before the hard cap."
    echo "# MemoryMax:  hard — contains a runaway to its cgroup; the OOM killer takes"
    echo "#             the offending step, OOMPolicy above keeps the runner."
    echo "# MemorySwapMax=0: the cap bounds RAM only; without this a capped job"
    echo "#             swaps out to stay under it and thrashes instead of failing."
    [ -n "$MEM_HIGH" ] && echo "MemoryHigh=${MEM_HIGH}"
    echo "MemoryMax=${MEM_MAX}"
    echo "MemorySwapMax=0"
  fi
}

apply_to() {
  local u="$1" dir="$SYSTEMD_DIR/$1.d"
  run_priv mkdir -p "$dir"
  render_dropin | run_priv tee "$dir/$DROPIN_NAME" >/dev/null
}

# A profile with an EnvironmentFile hard-fails to start without it, so refuse
# to apply until it exists (run env-init first).
guard_env_file() {
  [ -n "$ENV_FILE" ] || return 0
  run_priv test -f "$ENV_FILE" || die "EnvironmentFile $ENV_FILE missing — run: runnerctl env-init --profile $PROFILE"
}

# What profile (if any) manages this slot, read from the first line of its
# drop-in (`# Managed by runnerctl (profile: NAME) — DO NOT EDIT BY HAND.`,
# see render_dropin) — a plain read, no run_priv: the file is root-owned but
# world-readable like the rest of /etc/systemd/system. "—" when the drop-in
# is missing (never applied, or reverted by remove-limits) or unreadable.
# The profile named in a unit's managed drop-in header; nothing when the unit
# has no drop-in or its header names none (the table shows that as —).
slot_profile() {
  local line
  line="$(head -n1 "$SYSTEMD_DIR/$1.d/$DROPIN_NAME" 2>/dev/null)" || return 0
  [[ "$line" =~ \(profile:\ ([^\)]+)\) ]] && echo "${BASH_REMATCH[1]}"
  return 0
}

# --- Colour (GHR-27) ---------------------------------------------------------
# The table's cells are painted by meaning — ACTIVE green/yellow/red, USED
# turning red as a slot reaches its MemoryHigh, WORKING-ON dim while idle and
# bold red when STALLED — and only when someone is looking: --color auto (the
# default) paints when stdout is a terminal and NO_COLOR is unset or empty
# (no-color.org); always/never override. The C_* codes stay empty while
# colour is off, so paint() is a plain echo there and every renderer can call
# it unconditionally. --json and health never paint.
COLOR_MODE="auto"
C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW=""
color_setup() { # auto|always|never
  local on=false
  case "$1" in
    always) on=true ;;
    never)  on=false ;;
    auto)   [ -n "${NO_COLOR:-}" ] || ! stdout_is_tty || on=true ;;
    *)      die "--color value '$1' is invalid — want auto, always or never" ;;
  esac
  if $on; then
    C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m'
  else
    C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW=""
  fi
}
# TEXT wrapped in an SGR code (one or more C_* values; nothing when empty).
paint() { # SGR TEXT
  printf '%s%s%s\n' "$1" "$2" "${1:+$C_RESET}"
}
# Options `status` and `watch` share: --color WHEN and --stall-after N. Sets
# VIEW_SHIFT to the argv words consumed, 0 when $1 is neither.
VIEW_SHIFT=0
set_stall_after() { # SECONDS
  [[ "$1" =~ ^[0-9]+$ ]] || die "--stall-after value '$1' is invalid — want a whole number of seconds (0 disables the stalled flag)"
  STALL_SEC="$1"
}
view_opt() { # ARGS...
  VIEW_SHIFT=0
  case "$1" in
    --color)
      need_val "$@"
      case "$2" in auto|always|never) ;; *) die "--color value '$2' is invalid — want auto, always or never" ;; esac
      COLOR_MODE="$2"; VIEW_SHIFT=2 ;;
    --stall-after)
      need_val "$@"
      set_stall_after "$2"; VIEW_SHIFT=2 ;;
  esac
}

# --- Commands -----------------------------------------------------------------
# Column widths of the status table; the last column (WORKING-ON) is unpadded.
STATUS_WIDTHS=(3 40 8 19 8 9 6 6 12 6 8 7)

# Print one status row, padding each cell by CHARACTERS. Bash's printf counts
# bytes for %-Ns, so the 3-byte `—` cell used for "no value" came out two
# columns short and shifted everything after it (GHR-21). ${#v} counts
# characters under a UTF-8 locale, which is the only kind where `—` renders.
# A painted cell is measured without its SGR sequences (GHR-27), so colour
# never shifts a column either.
# STATUS_DROP (GHR-33): space-separated 0-based column indices to leave out
# of every row — `watch` drops MAX, HIGH and ENVFILE (6 7 11) when the table
# is wider than the terminal, so WORKING-ON never has to go. Empty for
# `status`, which is what keeps its rows byte-identical.
STATUS_DROP=""
status_row() {
  local w v n c=0 out=""
  for w in "${STATUS_WIDTHS[@]}"; do
    v="$1"; shift
    if [[ " $STATUS_DROP " == *" $c "* ]]; then c=$((c + 1)); continue; fi
    c=$((c + 1))
    out+="$v"
    n="${v//$'\e['*([0-9;])m/}"
    if [ "${#n}" -lt "$w" ]; then printf -v v '%*s' $((w - ${#n})) ''; out+="$v"; fi
    out+=" "
  done
  printf '%s%s\n' "$out" "$1"
}

# The SGR code for a cell, by what it says (GHR-27). Empty = plain.
status_active_color() { # ACTIVE-STATE NRESTARTS RESULT
  case "$1" in
    active)
      if { [[ "${2:-0}" =~ ^[0-9]+$ ]] && [ "${2:-0}" -gt 0 ]; } || [ "${3:-success}" != success ]; then
        echo "$C_YELLOW"
      else
        echo "$C_GREEN"
      fi ;;
    activating|reloading) echo "$C_YELLOW" ;;
    *)                    echo "$C_RED" ;;
  esac
}
# USED against MemoryHigh: red from the throttle point, yellow from 90 % of
# it; plain when either side is not a number (no accounting, infinity).
status_used_color() { # CURRENT HIGH
  [[ "${1:-}" =~ ^[0-9]+$ && "${2:-}" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ] || return 0
  if [ "$1" -ge "$2" ]; then echo "$C_RED"; elif [ $(( $1 * 10 )) -ge $(( $2 * 9 )) ]; then echo "$C_YELLOW"; fi
}
# GHR-31: the PRESS cell — PSI full avg10 as `12.3%`, — when unknown.
status_press_cell() { # AVG10
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "—"; return; }
  awk -v p="$1" 'BEGIN { printf "%.1f%%", p }'
  echo
}
# Red from PRESSURE_CRIT_PCT, yellow from PRESSURE_WARN_PCT, plain below
# or when unknown. Percent with decimals, so awk compares.
status_press_color() { # AVG10
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
  case "$(awk -v p="$1" -v w="$PRESSURE_WARN_PCT" -v c="$PRESSURE_CRIT_PCT" 'BEGIN { if (p >= c) print "crit"; else if (p >= w) print "warn"; else print "ok" }')" in
    crit) echo "$C_RED" ;;
    warn) echo "$C_YELLOW" ;;
  esac
}
# Is AVG10 at or over PCT? For the health rule and the stalled suffix.
pressure_at_least() { # AVG10 PCT
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  [ "$(awk -v p="$1" -v t="$2" 'BEGIN { print (p >= t) ? 1 : 0 }')" = 1 ]
}
status_job_color() { # JOB-STATE JOB-STALLED [LEAKED]
  case "$1" in
    running)              if [ "${2:-}" = true ]; then echo "$C_BOLD$C_RED"; else echo "$C_GREEN"; fi ;;
    none|idle|idle-fresh) if [[ "${3:-}" =~ ^[0-9]+$ ]] && [ "${3:-0}" -gt 0 ]; then echo "$C_YELLOW"; else echo "$C_DIM"; fi ;;
    *)                    echo "$C_YELLOW" ;;
  esac
}

# --- One collector, two renderers (GHR-16) -----------------------------------
# Everything `status` knows about one slot, gathered once into SLOT — one
# unit_props fetch, one drop-in read, at most one journal_restart_reason
# lookup and the one journal fetch job_facts makes — so the table
# (render_status) and `status --json` (render_status_json) format the same
# raw values and cannot disagree on a property. Values are systemd's own
# strings, untouched: MemoryMax stays `infinity` or `[not set]` here, the
# stamps stay µs since boot; the renderers decide what — or null — means.
#   unit idx name              the unit, its 0-based index, its short RUNNER name
#   active sub enabled         ActiveState SubState UnitFileState
#   memory_max memory_high memory_current memory_peak
#   restart                    the Restart= policy
#   env_file                   EnvironmentFiles, raw (`/etc/x (ignore_errors=no)`),
#                              empty when none
#   cgroup invocation          ControlGroup InvocationID
#   active_enter inactive_enter
#   restarts result            NRestarts Result
#   profile                    the drop-in's profile, empty when none
#   since_age                  seconds in the current ActiveState (state_age),
#                              empty when the state was never entered
#   last_restart_reason        journal_restart_reason's answer, looked up only
#                              when NRestarts > 0 and Result is success (the
#                              ACTIVE cell's condition), empty otherwise
#   mem_events_high mem_events_max mem_events_oom_kill
#   mem_pressure_full_avg10 mem_pressure_full_avg60 mem_pressure_full_total
#                              cgroup_memory_facts' answers (GHR-31), empty
#                              where the cgroup or the file is not there
#   job_*                      the JOB_* facts of job_facts, same names
#                              (job_leaked / job_leaked_pids / job_leaked_comms
#                              included, GHR-29)
declare -A SLOT=()
collect_slot() { # UNIT IDX
  local u="$1" k v n
  SLOT=([unit]="$u" [idx]="$2" [name]="$(short_name "$u")"
        [active]="" [sub]="" [enabled]="" [memory_max]="" [memory_high]=""
        [memory_current]="" [memory_peak]="" [restart]="" [env_file]=""
        [cgroup]="" [invocation]="" [active_enter]="" [inactive_enter]=""
        [restarts]="" [result]="" [profile]="" [since_age]="" [last_restart_reason]=""
        [mem_events_high]="" [mem_events_max]="" [mem_events_oom_kill]=""
        [mem_pressure_full_avg10]="" [mem_pressure_full_avg60]="" [mem_pressure_full_total]="")
  while IFS='=' read -r k v; do
    case "$k" in
      ActiveState)                      SLOT[active]="$v" ;;
      SubState)                         SLOT[sub]="$v" ;;
      UnitFileState)                    SLOT[enabled]="$v" ;;
      MemoryMax)                        SLOT[memory_max]="$v" ;;
      MemoryHigh)                       SLOT[memory_high]="$v" ;;
      MemoryCurrent)                    SLOT[memory_current]="$v" ;;
      MemoryPeak)                       SLOT[memory_peak]="$v" ;;
      Restart)                          SLOT[restart]="$v" ;;
      EnvironmentFiles)                 SLOT[env_file]="$v" ;;
      ControlGroup)                     SLOT[cgroup]="$v" ;;
      InvocationID)                     SLOT[invocation]="$v" ;;
      ActiveEnterTimestampMonotonic)    SLOT[active_enter]="$v" ;;
      InactiveEnterTimestampMonotonic)  SLOT[inactive_enter]="$v" ;;
      NRestarts)                        SLOT[restarts]="$v" ;;
      Result)                           SLOT[result]="$v" ;;
    esac
  done < <(unit_props "$u")
  SLOT[profile]="$(slot_profile "$u")"
  while IFS='=' read -r k v; do
    case "$k" in
      events_high|events_max|events_oom_kill|pressure_full_avg10|pressure_full_avg60|pressure_full_total) SLOT[mem_$k]="$v" ;;
    esac
  done < <(cgroup_memory_facts "${SLOT[cgroup]}")
  SLOT[since_age]="$(state_age "${SLOT[active]}" "${SLOT[active_enter]}" "${SLOT[inactive_enter]}")"
  n="${SLOT[restarts]}"
  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] && [ "${SLOT[result]:-success}" = success ]; then
    SLOT[last_restart_reason]="$(journal_restart_reason "$u")"
  fi
  job_facts "$u" "${SLOT[cgroup]}" "${SLOT[invocation]}" "${SLOT[active_enter]}"
  SLOT[job_state]="$JOB_STATE" SLOT[job_name]="$JOB_NAME" SLOT[job_repo]="$JOB_REPO"
  SLOT[job_since]="$JOB_SINCE" SLOT[job_runtime]="$JOB_RUNTIME" SLOT[job_stalled]="$JOB_STALLED"
  SLOT[job_idle_since]="$JOB_IDLE_SINCE" SLOT[job_done]="$JOB_DONE" SLOT[job_access]="$JOB_ACCESS"
  SLOT[job_leaked]="$JOB_LEAKED" SLOT[job_leaked_pids]="$JOB_LEAKED_PIDS" SLOT[job_leaked_comms]="$JOB_LEAKED_COMMS"
}

# The status table itself, printed once to stdout. `status` calls it once;
# `watch` (GHR-3, below cmd_logs) captures it per tick and redraws it in place.
render_status() {
  require_runners
  # The version leads the header (GHR-32): `upgrade` fetches main, so what a
  # host actually runs is otherwise only visible through a second command.
  echo "runnerctl $RUNNERCTL_VERSION — Host: $(host_line)"
  echo
  paint "$C_BOLD" "$(status_row IDX RUNNER PROFILE ACTIVE SINCE ENABLED MAX HIGH USED PRESS RESTART ENVFILE WORKING-ON)"
  local i=0 u no_access=false stalled=false leaked=false
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$i"
    # `idle ?` is the /proc-only reader's idle: it knows the slot is idle but
    # not for how long, which is the same missing journal access.
    case "${SLOT[job_state]}" in no-access|idle-unknown) no_access=true ;; esac
    [ "${SLOT[job_stalled]}" != true ] || stalled=true
    { [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; } && leaked=true
    status_row "$i" "${SLOT[name]}" \
      "$(if [ -n "${SLOT[profile]}" ]; then echo "${SLOT[profile]}"; else paint "$C_DIM" "—"; fi)" \
      "$(paint "$(status_active_color "${SLOT[active]}" "${SLOT[restarts]:-0}" "${SLOT[result]:-success}")" \
               "$(status_active_cell "${SLOT[active]}" "${SLOT[sub]}" "${SLOT[restarts]:-0}" "${SLOT[result]:-success}" "${SLOT[last_restart_reason]}")")" \
      "$(if [ -n "${SLOT[since_age]}" ]; then fmt_dur "${SLOT[since_age]}"; else paint "$C_DIM" "—"; fi)" \
      "$(paint "$([ "${SLOT[enabled]}" = enabled ] || echo "$C_DIM")" "${SLOT[enabled]}")" \
      "$(hbytes "${SLOT[memory_max]}")" "$(hbytes "${SLOT[memory_high]}")" \
      "$(paint "$(status_used_color "${SLOT[memory_current]}" "${SLOT[memory_high]}")" \
               "$(status_used_cell "${SLOT[memory_current]}" "${SLOT[memory_peak]}")")" \
      "$(paint "$(status_press_color "${SLOT[mem_pressure_full_avg10]}")" "$(status_press_cell "${SLOT[mem_pressure_full_avg10]}")")" \
      "${SLOT[restart]}" "${SLOT[env_file]:-—}" \
      "$(paint "$(status_job_color "${SLOT[job_state]}" "${SLOT[job_stalled]}" "${SLOT[job_leaked]}")" "$(job_cell)")"
    i=$((i+1))
  done < <(discover)
  # Once under the table, not per row, so the rows stay parseable.
  if $no_access; then
    paint "$C_YELLOW" "note: WORKING-ON needs journal read access (systemd-journal group) or root"
  fi
  if $stalled; then
    paint "$C_RED" "note: STALLED = a job running longer than $(fmt_dur "$STALL_SEC") (STALL_SEC=$STALL_SEC); 'runnerctl logs <IDX>' shows what it is doing, a high PRESS means it is memory-throttled rather than hung"
  fi
  if $leaked; then
    paint "$C_YELLOW" "note: +N leaked = processes a finished job left in the slot's cgroup, counting against MemoryMax; 'runnerctl reap <IDX>' kills them"
  fi
}

# --- Machine-readable status (GHR-16) ----------------------------------------
# A JSON string: backslash, quote and the control characters escaped (\n \r
# \t by name, the rest as \u00XX), everything else verbatim. systemd's own
# property values carry none of these in practice; escaped anyway.
json_str() { # STRING
  local s="${1-}" out="" c i n
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  if [[ "$s" == *[[:cntrl:]]* ]]; then
    n=${#s}
    for ((i = 0; i < n; i++)); do
      c="${s:i:1}"
      case "$c" in
        $'\n')      out+='\n' ;;
        $'\r')      out+='\r' ;;
        $'\t')      out+='\t' ;;
        [[:cntrl:]]) printf -v c '\\u%04x' "'$c"; out+="$c" ;;
        *)          out+="$c" ;;
      esac
    done
    s="$out"
  fi
  printf '"%s"\n' "$s"
}

# A JSON value from a raw string: null when empty, else a string.
json_strn() { if [ -n "${1:-}" ]; then json_str "$1"; else echo null; fi; }

# A JSON number from a raw string: unquoted only when it is all digits, null
# otherwise — a stamp that was never set, a count that is missing.
json_num() { if [[ "${1:-}" =~ ^[0-9]+$ ]]; then echo "$1"; else echo null; fi; }

# A JSON number from a decimal string (12.34), null otherwise (GHR-31).
json_dec() { if [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then echo "$1"; else echo null; fi; }

# A JSON boolean from "true"/"false", null for anything else (unknown).
json_bool() { case "${1:-}" in true|false) echo "$1" ;; *) echo null ;; esac; }

# A JSON byte count from a systemd memory property: null where hbytes prints
# — (unset, infinity, [not set]), the number otherwise, and any other
# string as a string so nothing is silently dropped.
json_bytes() {
  case "${1:-}" in
    ''|infinity|max|18446744073709551615|'[not set]') echo null; return ;;
  esac
  if [[ "$1" =~ ^[0-9]+$ ]]; then echo "$1"; else json_str "$1"; fi
}

# The status table header's "Host: ..." fragment: core count and free -h's
# human-rounded memory line, e.g. "16 cores, 30Gi RAM, 21Gi available".
# Behind a function (like host_facts below) so a test config can pin it —
# free -h's rounding can differ between two runs on a loaded box, which is
# what made the `status --color always` sim case's whole-output diff flake
# (GHR-34); the table's own header keeps `free -h`, whose rounding is what
# people are used to reading, rather than switching to host_facts's exact
# bytes.
host_line() {
  echo "$(nproc) cores, $(free -h | awk '/^Mem:/{print $2" RAM, "$7" available"}')"
}

# Core count and memory in bytes for the JSON `host` object — `nproc` and
# /proc/meminfo, on one line: "CORES MEM_TOTAL MEM_AVAILABLE", any of them
# empty where it cannot be read. Behind a function so a test config can pin
# it.
host_facts() {
  local cores
  cores="$(nproc 2>/dev/null || true)"
  awk -v c="$cores" '
    /^MemTotal:/     { t = $2 * 1024 }
    /^MemAvailable:/ { a = $2 * 1024 }
    END { printf "%s %s %s\n", c, (t == "" ? "" : sprintf("%.0f", t)), (a == "" ? "" : sprintf("%.0f", a)) }
  ' /proc/meminfo 2>/dev/null || echo "$cores"
}

# The host's own name for the JSON `host` object (GHR-38) — `hostname`, then
# `uname -n`, empty if neither answers. Behind a function so a test config can
# pin it, like host_facts and host_line above.
#
# It is deliberately the host's OWN idea of its name rather than something a
# caller passes in: a central node fanning `status --json` out over ssh knows
# only the alias it dialled, and where the alias and the hostname disagree —
# one box reachable under two names, or an alias pointing somewhere other than
# where its name suggests — that is worth seeing rather than papering over.
# It also makes a saved payload self-describing: a file or a monitoring record
# says which host produced it, with no out-of-band label.
host_name() {
  hostname 2>/dev/null || uname -n 2>/dev/null || true
}

# `status --json`: the same SLOT facts as raw bytes, epoch seconds and null
# — formatting is the consumer's job. The top-level object carries
# `runnerctl` (the version of the script that produced it, GHR-32) and
# `host`. One object per slot, keys stable:
#   idx unit name active sub enabled memory_max memory_high memory_current
#   memory_peak restart env_file since restarts result last_restart_reason
#   profile job idle_since jobs_completed working_on_access
# `job` is {"repo","name","since","stalled"} while a job is in flight (repo,
# name and since null when unknown; `stalled` true/false against STALL_SEC,
# null when the runtime is unknown — GHR-27), null when idle or not running;
# `idle_since` and
# `jobs_completed` are set while the slot is idle with a readable journal
# (`jobs_completed` 0 when nothing has finished since the unit started);
# `working_on_access` is "ok", "no-journal" (only /proc could be read) or
# "no-access" — the note under the table, per slot; `leaked_procs` is the
# count of processes a finished job left in an idle slot's cgroup, null
# while busy or when the cgroup cannot be read (GHR-29); `memory_events`
# is {"high","max","oom_kill"} from the cgroup's memory.events and
# `memory_pressure` {"full_avg10","full_avg60","full_total"} from its
# memory.pressure, each object null when nothing could be read (GHR-31).
# `host` carries `name` (the host's own hostname, null when it cannot be
# read — GHR-38) alongside `cores`, `mem_total` and `mem_available`.
# Unlike the table, this never dies on a host with no runner units: it
# prints `"slots": []` and exits 0 (GHR-38).
render_status_json() {
  # No require_runners here, unlike render_status (GHR-38). A host with no
  # runner units is a well-formed `"slots": []` object and exit 0, not a die:
  # a fleet member drained to zero slots, or inventoried before its runners
  # are installed, is a legitimate state, and aborting makes it indistinguish-
  # able from an ssh failure — two very different things to be paged about.
  # The table path keeps dying, because an operator who typed `status` on the
  # wrong box should be told so.
  local cores mem_total mem_avail i=0 u sep="" job idle_since completed
  read -r cores mem_total mem_avail < <(host_facts) || true
  printf '{"runnerctl":%s,"host":{"name":%s,"cores":%s,"mem_total":%s,"mem_available":%s},\n "slots":[' \
    "$(json_str "$RUNNERCTL_VERSION")" "$(json_strn "$(host_name)")" \
    "$(json_num "$cores")" "$(json_num "$mem_total")" "$(json_num "$mem_avail")"
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$i"
    case "${SLOT[job_state]}" in
      running|starting)
        job="{\"repo\":$(json_strn "${SLOT[job_repo]}"),\"name\":$(json_strn "${SLOT[job_name]}"),\"since\":$(json_num "${SLOT[job_since]}"),\"stalled\":$(json_bool "${SLOT[job_stalled]}")}" ;;
      *) job=null ;;
    esac
    case "${SLOT[job_state]}" in
      idle|idle-fresh) idle_since="$(json_num "${SLOT[job_idle_since]}")"; completed="$(json_num "${SLOT[job_done]}")" ;;
      *)               idle_since=null; completed=null ;;
    esac
    printf '%s\n  {"idx":%s,"unit":%s,"name":%s,"active":%s,"sub":%s,"enabled":%s' \
      "$sep" "$i" "$(json_str "$u")" "$(json_str "${SLOT[name]}")" \
      "$(json_strn "${SLOT[active]}")" "$(json_strn "${SLOT[sub]}")" "$(json_strn "${SLOT[enabled]}")"
    printf ',"memory_max":%s,"memory_high":%s,"memory_current":%s,"memory_peak":%s' \
      "$(json_bytes "${SLOT[memory_max]}")" "$(json_bytes "${SLOT[memory_high]}")" \
      "$(json_bytes "${SLOT[memory_current]}")" "$(json_bytes "${SLOT[memory_peak]}")"
    printf ',"restart":%s,"env_file":%s,"since":%s,"restarts":%s,"result":%s,"last_restart_reason":%s,"profile":%s' \
      "$(json_strn "${SLOT[restart]}")" "$(json_strn "${SLOT[env_file]}")" \
      "$(json_num "$(age_to_epoch "${SLOT[since_age]}")")" "$(json_num "${SLOT[restarts]}")" \
      "$(json_strn "${SLOT[result]}")" "$(json_strn "${SLOT[last_restart_reason]}")" "$(json_strn "${SLOT[profile]}")"
    printf ',"job":%s,"idle_since":%s,"jobs_completed":%s,"working_on_access":%s,"leaked_procs":%s' \
      "$job" "$idle_since" "$completed" "$(json_str "${SLOT[job_access]}")" "$(json_num "${SLOT[job_leaked]}")"
    if [ -n "${SLOT[mem_events_high]}${SLOT[mem_events_max]}${SLOT[mem_events_oom_kill]}" ]; then
      printf ',"memory_events":{"high":%s,"max":%s,"oom_kill":%s}' \
        "$(json_num "${SLOT[mem_events_high]}")" "$(json_num "${SLOT[mem_events_max]}")" "$(json_num "${SLOT[mem_events_oom_kill]}")"
    else
      printf ',"memory_events":null'
    fi
    if [ -n "${SLOT[mem_pressure_full_avg10]}${SLOT[mem_pressure_full_avg60]}${SLOT[mem_pressure_full_total]}" ]; then
      printf ',"memory_pressure":{"full_avg10":%s,"full_avg60":%s,"full_total":%s}}' \
        "$(json_dec "${SLOT[mem_pressure_full_avg10]}")" "$(json_dec "${SLOT[mem_pressure_full_avg60]}")" "$(json_num "${SLOT[mem_pressure_full_total]}")"
    else
      printf ',"memory_pressure":null}'
    fi
    sep=","
    i=$((i+1))
  done < <(discover)
  printf '\n]}\n'
}

cmd_apply() {
  extract_profile "$@"; load_profile; parse_opts ${REMAINING[@]+"${REMAINING[@]}"}
  if $when_idle && ! $do_restart; then
    die "--when-idle only applies to the restart: use 'apply --restart --when-idle' (apply alone just writes drop-ins)"
  fi
  require_runners; guard_env_file
  local units=() u t short_list=""
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for t in "${TARGETS[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  for u in "${units[@]}"; do apply_to "$u"; echo "  wrote drop-in for $u"; done
  run_priv systemctl daemon-reload
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for u in "${units[@]}"; do
      t="${u#actions.runner.}"; t="${t%.service}"
      short_list+="${short_list:+, }$t"
    done
    echo "Applied profile '$PROFILE' to ${#units[@]} slot(s): $short_list"
  else
    echo "Applied profile '$PROFILE': Restart=always RestartSec=$RESTART_SEC OOMPolicy=continue${MEM_MAX:+ MemoryMax=$MEM_MAX MemoryHigh=$MEM_HIGH MemorySwapMax=0}${ENV_FILE:+ EnvironmentFile=$ENV_FILE}"
  fi
  if $do_restart; then
    local i
    for i in "${!units[@]}"; do
      u="${units[$i]}"
      idle_gate "$u" restarted "${units[*]:0:$i}" "${units[*]:$((i+1))}"
      run_priv systemctl restart "$u"
    done
    if [ "${#TARGETS[@]}" -gt 0 ]; then
      echo "Restarted ${#units[@]} slot(s) (config active now)."
    else
      echo "Restarted all runner slots (config active now)."
    fi
  else
    echo "Config takes effect on next (re)start. Run: runnerctl restart"
  fi
}

cmd_scale() {
  extract_profile "$@"
  set -- ${REMAINING[@]+"${REMAINING[@]}"}
  [ $# -ge 1 ] || die "scale needs N, e.g. 'scale 2 --max 26G'"
  local n="$1"; shift
  [[ "$n" =~ ^[0-9]+$ ]] || die "N must be an integer"
  load_profile; parse_opts "$@"
  [ "${#TARGETS[@]}" -eq 0 ] || die "unexpected argument: ${TARGETS[*]}"
  require_runners; guard_env_file
  mapfile -t units < <(discover)
  local total=${#units[@]}
  { [ "$n" -ge 1 ] && [ "$n" -le "$total" ]; } || die "N must be 1..$total"
  local i u
  # Write every drop-in that will be needed, THEN reload, THEN start/stop —
  # otherwise the first `enable --now` on a stopped slot races systemd's own
  # unread unit cache and starts with the previous config (GHR-5).
  for i in "${!units[@]}"; do
    [ "$i" -lt "$n" ] && apply_to "${units[$i]}"
  done
  run_priv systemctl daemon-reload
  local rc failed=()
  for i in "${!units[@]}"; do
    u="${units[$i]}"
    if [ "$i" -lt "$n" ]; then
      rc=0; run_priv systemctl enable --now "$u" || rc=$?
      if [ "$rc" -eq 0 ]; then echo "  [active] $u"; else echo "  [FAILED] $u"; failed+=("$u"); fi
    else
      # --when-idle: a slot leaving the pool is stopped only once its job is
      # done (the ones staying are enabled regardless — that never kills a job).
      idle_gate "$u" stopped "${units[*]:$n:$((i - n))}" "${units[*]:$((i + 1))}"
      rc=0; run_priv systemctl disable --now "$u" || rc=$?
      if [ "$rc" -eq 0 ]; then echo "  [stopped] $u"; else echo "  [FAILED] $u"; failed+=("$u"); fi
    fi
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "runnerctl: scale: ${#failed[@]} of $n slot(s) failed to start/stop: ${failed[*]}" >&2
    exit 1
  fi
  echo "Scaled to $n active runner(s), profile '$PROFILE'${MEM_MAX:+ @ MemoryMax=$MEM_MAX}."
  echo "Note: stopped slots stay REGISTERED with GitHub (they show offline). Full"
  echo "deregister = 'svc.sh uninstall' + './config.sh remove' in the runner's dir"
  echo "(needs a GitHub removal token) — not automated: destructive, irreversible."
  if $do_restart; then
    for i in "${!units[@]}"; do
      [ "$i" -lt "$n" ] || break
      idle_gate "${units[$i]}" restarted "${units[*]:0:$i}" "${units[*]:$((i + 1)):$((n - i - 1))}"
      run_priv systemctl restart "${units[$i]}"
    done
    echo "Restarted $n active slot(s) (config active now)."
  else
    echo "Config takes effect on next (re)start of already-running slots. Run: runnerctl restart"
  fi
}

cmd_env_init() {
  extract_profile "$@"; load_profile; parse_opts ${REMAINING[@]+"${REMAINING[@]}"}
  [ -n "$ENV_FILE" ] || die "profile '$PROFILE' defines no EnvironmentFile (nothing to init)"
  if run_priv test -f "$ENV_FILE"; then
    echo "$ENV_FILE already exists — leaving it untouched (won't clobber secrets)."
    return 0
  fi
  run_priv mkdir -p "$(dirname "$ENV_FILE")"
  render_env_template | run_priv tee "$ENV_FILE" >/dev/null
  run_priv chown root:root "$ENV_FILE"
  run_priv chmod 600 "$ENV_FILE"
  echo "Scaffolded $ENV_FILE (root:root, 600)."
  echo "Edit it ON THE BOX and fill in real values. NEVER commit real secrets."
}

cmd_ctl() { # start|stop|restart [--when-idle] [--timeout N] [--if-stalled] [--stall-after N] [target ...] (default: all)
  local action="$1"; shift || true
  local targets=() units=() u t i verb if_stalled=false acted=0
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --when-idle)   when_idle=true; shift ;;
      --timeout)     need_val "$@"; set_timeout "$2"; shift 2 ;;
      --if-stalled)  if_stalled=true; shift ;;
      --stall-after) need_val "$@"; set_stall_after "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             targets+=("$1"); shift ;;
    esac
  done
  # Waiting for idle before a start is meaningless; accept the flag quietly.
  [ "$action" != start ] || when_idle=false
  if $if_stalled; then
    [ "$action" != start ] || die "--if-stalled only applies to stop and restart"
    ! $when_idle || die "--if-stalled and --when-idle are exclusive: one acts on a wedged slot, the other waits for an idle one"
    [ "$STALL_SEC" -gt 0 ] || die "--if-stalled needs a threshold: STALL_SEC is 0 (pass --stall-after N)"
  fi
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      # Resolve on its own line: a die inside "$(...)" only exits the subshell.
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  case "$action" in stop) verb=stopped ;; *) verb="${action}ed" ;; esac
  for i in "${!units[@]}"; do
    u="${units[$i]}"
    if $if_stalled; then
      stalled_gate "$u" "${verb%ed}ing" || continue
      acted=$((acted + 1))
    else
      idle_gate "$u" "$verb" "${units[*]:0:$i}" "${units[*]:$((i + 1))}"
    fi
    run_priv systemctl "$action" "$u"
  done
  if $if_stalled && [ "$acted" -eq 0 ]; then
    echo "no stalled slot — nothing $verb."
  elif $if_stalled; then
    echo "$action done ($acted stalled slot(s))."
  else
    echo "$action done."
  fi
}

cmd_toggle() { # enable|disable <target>
  local action="$1"; shift || true
  [ $# -ge 1 ] || die "$action needs a <unit|slot-index|name>"
  local u; u="$(resolve "$1")"
  run_priv systemctl "$action" --now "$u"
  echo "$action done."
}

cmd_logs() {
  require_runners
  local target="" follow=false n="" since="" grep_pat="" have_target=false u
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      -f|--follow) follow=true; shift ;;
      -n|--lines)  need_val "$@"; [[ "$2" =~ ^[0-9]+$ ]] || die "-n value '$2' is invalid — want an integer"; n="$2"; shift 2 ;;
      --since)     need_val "$@"; since="$2"; shift 2 ;;
      -g|--grep)   need_val "$@"; grep_pat="$2"; shift 2 ;;
      -*)          die "unknown option: $1" ;;
      *)           $have_target && die "unknown option: $1"; target="$1"; have_target=true; shift ;;
    esac
  done

  local jargs=()
  if [ -n "$target" ]; then
    u="$(resolve "$target")"
    jargs+=(-u "$u")
  else
    while read -r u; do [ -n "$u" ] && jargs+=(-u "$u"); done < <(discover)
  fi
  if [ -n "$n" ]; then
    jargs+=(-n "$n")
  elif $follow; then
    jargs+=(-n 50)
  else
    jargs+=(-n 100)
  fi
  $follow && jargs+=(-f)
  [ -n "$since" ] && jargs+=(--since "$since")
  [ -n "$grep_pat" ] && jargs+=(-g "$grep_pat")
  jargs+=(--no-pager)

  run_priv journalctl "${jargs[@]}"
}

# --- Live view (GHR-3) --------------------------------------------------------
# `status` prints the table once; `status --watch|-w` and `watch` redraw it
# in place every --interval seconds (default 2) until Ctrl-C. --once turns a
# watch back into a single print; the last of --watch/--once wins. --json
# (GHR-16) prints the same facts as one JSON object instead of the table; it
# is a one-shot format, so it refuses --watch rather than streaming frames.
# --color and --stall-after (GHR-27) are parsed here for both shapes.
cmd_status() { # [--json] [--watch|-w] [--once] [--interval N] [--color WHEN] [--stall-after N]
  local watch=false json=false args=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then shift "$VIEW_SHIFT"; continue; fi
    case "$1" in
      --watch|-w) watch=true; shift ;;
      --once)     watch=false; shift ;;
      --json)     json=true; shift ;;
      *)          args+=("$1"); shift ;;
    esac
  done
  if $watch; then
    ! $json || die "--json cannot be combined with --watch; poll 'runnerctl status --json' instead"
    cmd_watch ${args[@]+"${args[@]}"}
  else
    [ "${#args[@]}" -eq 0 ] || die "unknown option: ${args[0]}"
    if $json; then render_status_json; else color_setup "$COLOR_MODE"; render_status; fi
  fi
}

# Is stdout a terminal? Behind a function so a test config can shadow it.
stdout_is_tty() { [ -t 1 ]; }

# Hide/show the cursor through tput where it exists; silent where it does
# not (minimal hosts, no TERM). Behind a function so a test config can
# shadow it — tput writes its escape codes to stdout.
term_cursor() { # hide|show
  command -v tput >/dev/null 2>&1 || return 0
  case "$1" in hide) tput civis ;; show) tput cnorm ;; esac 2>/dev/null || true
}

# The terminal's width in columns, 0 when unknown (no tput, no TERM). Behind
# a function so a test config can pin it.
term_cols() {
  local c=""
  if command -v tput >/dev/null 2>&1; then c="$(tput cols 2>/dev/null || true)"; fi
  if [[ "$c" =~ ^[0-9]+$ ]]; then echo "$c"; else echo 0; fi
}

# --- Interactive watch (GHR-33) -----------------------------------------------
# One keystroke from the terminal into KEY_CHAR (empty for Enter): 0 with a
# key, 1 when TIMEOUT seconds passed without one. `read -n1` puts the tty in
# non-canonical, no-echo mode for the duration of the read only and restores
# it after, so between two reads the terminal is normal: an action (and the
# sudo prompt run_priv may raise) runs outside any read and needs no raw-mode
# bookkeeping. Without a terminal on stdin the loop is view-only and this is
# a plain `pause`, so a closed or redirected stdin cannot spin the redraw.
# Behind a function so a test config can feed keys (RUNNERCTL_STUB_KEYS).
tty_read_char() { # TIMEOUT
  local rc=0
  KEY_CHAR=""
  if [ -t 0 ]; then
    IFS= read -rsn1 -t "$1" KEY_CHAR || rc=$?
    [ "$rc" -ne 0 ] || return 0
    [ "$rc" -le 128 ] || return 1 # timed out: the interval has elapsed
  fi
  pause "$1"
  return 1
}
# One key into KEY: `up` / `down` for the arrows (ESC [ A, ESC O A, …), `esc`
# for a lone Escape, `enter`, otherwise the character itself. 1 on timeout.
# The rest of an arrow's sequence is already buffered when the ESC arrives,
# so a short second read tells the two apart.
read_key() { # TIMEOUT
  KEY=""
  tty_read_char "$1" || return 1
  case "$KEY_CHAR" in
    $'\e')
      if tty_read_char 0.05 && [[ "$KEY_CHAR" == [\[O] ]] && tty_read_char 0.05; then
        case "$KEY_CHAR" in A) KEY=up ;; B) KEY=down ;; *) KEY=other ;; esac
      else
        KEY=esc
      fi ;;
    "") KEY=enter ;;
    *)  KEY="$KEY_CHAR" ;;
  esac
}
# A pager for `L` (logs): $PAGER, less, or cat where neither exists. Behind
# a function so a test config can replace it.
page() {
  local pager
  read -ra pager <<<"${PAGER:-less}"
  if command -v "${pager[0]}" >/dev/null 2>&1; then "${pager[@]}"; else cat; fi
}
WATCH_LEGEND="↑↓/jk select  K kill job  R restart  S stop  T start  P reap  L logs  q quit"

# The cursor row: reverse video over the whole line, re-applied after every
# reset a painted cell ends with, so a coloured cell does not cut it short.
# Always an SGR sequence, whatever --color says: watch needs a terminal and
# the cursor is structure, not colour. NAME is the RUNNER cell (short_name).
watch_highlight() { # TABLE NAME
  local line rev=$'\e[7m' reset=$'\e[0m'
  while IFS= read -r line; do
    if [[ "$line" =~ ^[0-9]+\ +"$2"\ + ]]; then
      printf '%s%s%s\n' "$rev" "${line//"$reset"/$reset$rev}" "$reset"
    else
      printf '%s\n' "$line"
    fi
  done <<<"$1"
}
# The widest table row (header or slot row) in TABLE, in characters with the
# SGR sequences stripped — the note lines are long by design and do not count.
watch_table_width() { # TABLE
  local line n w=0
  while IFS= read -r line; do
    n="${line//$'\e['*([0-9;])m/}"
    ! [[ "$n" =~ ^(IDX|[0-9]+)\  ]] || [ "${#n}" -le "$w" ] || w="${#n}"
  done <<<"$1"
  echo "$w"
}
# The table for one frame, into WATCH_TABLE (not stdout: STATUS_DROP has to
# outlive the call). Narrower than the terminal, or MAX/HIGH/ENVFILE are
# dropped (STATUS_DROP) and it is rendered again — once, on the transition,
# and back when the terminal is wide enough for all of them again. A width
# of 0 (unknown) never drops anything.
WATCH_TABLE=""
watch_table() {
  local cols
  WATCH_TABLE="$(render_status)"
  cols="$(term_cols)"
  [ "$cols" -gt 0 ] || return 0
  if [ -z "$STATUS_DROP" ] && [ "$(watch_table_width "$WATCH_TABLE")" -gt "$cols" ]; then
    STATUS_DROP="6 7 11"
    WATCH_TABLE="$(render_status)"
  elif [ -n "$STATUS_DROP" ] && [ $(( $(watch_table_width "$WATCH_TABLE") + 22 )) -le "$cols" ]; then
    STATUS_DROP=""
    WATCH_TABLE="$(render_status)"
  fi
}

# The facts an action decides on, fresh: the memoised journal for UNIT is
# dropped first so a job that just ended (or started) is not acted on from
# a cell up to JOURNAL_CACHE_TTL ticks old, then collect_slot fills SLOT.
watch_slot_facts() { # UNIT
  [ -z "$JOURNAL_MEMO_DIR" ] || rm -f -- "$JOURNAL_MEMO_DIR/$1".*
  collect_slot "$1" 0
}
# The `warning:` line R and S carry when a job is in flight.
watch_job_warning() {
  [ "${SLOT[job_state]}" = running ] || return 0
  printf '\nwarning: a job is running (%s) — it will be killed and GitHub marks it failed; runnerctl %s --when-idle waits for it instead' "$(job_cell)" "$1"
}
# A key on the selected slot: either WATCH_NOTICE (a refusal or a result, no
# command runs) or WATCH_PROMPT + WATCH_ACTION (a confirm line stating the
# exact command, run on `y`). L runs at once — reading logs changes nothing.
#   WATCH_ACTION   ctl:restart|ctl:stop|ctl:start|reap|kill  (+ the unit in WATCH_UNIT)
watch_key_action() { # KEY UNIT
  local u="$2" short
  short="$(short_name "$u")"
  WATCH_NOTICE="" WATCH_PROMPT="" WATCH_ACTION="" WATCH_UNIT="$u"
  case "$1" in
    L)
      # The pager owns the screen until it quits; the next frame repaints.
      term_cursor show
      cmd_logs "$u" -n 50 | page
      term_cursor hide
      return ;;
  esac
  watch_slot_facts "$u"
  case "$1" in
    K)
      # GHR-36: the job's own processes, not `systemctl restart` — a restart
      # is a graceful stop and a stalled step is what will not answer one.
      # The prompt names whichever command this slot will actually take.
      if [ "${SLOT[active]}" = deactivating ]; then
        WATCH_ACTION="kill"
        WATCH_PROMPT="$short is stuck stopping (${SLOT[active]}/${SLOT[sub]:-?}) — SIGKILL the whole unit? runs: systemctl kill -s KILL $u  [y/n]"
      else
        case "${SLOT[job_state]}" in
          running|starting)
            job_tree_check "${SLOT[cgroup]}"
            WATCH_ACTION="kill"
            if [ -z "$JOB_TREE" ]; then
              WATCH_PROMPT="Kill the job on $short ($(job_cell))? the slot's processes cannot be read here, so runs: systemctl kill -s KILL $u  [y/n]"
            elif [ "$JOB_TREE" -eq 0 ]; then
              WATCH_ACTION=""
              WATCH_NOTICE="$short: nothing but the runner itself in the slot's cgroup — nothing to kill"
            else
              WATCH_PROMPT="Kill the job on $short ($(job_cell))? runs: kill -KILL $JOB_TREE_PIDS ($(kill_list)) — the runner stays up and reports it failed  [y/n]"
            fi ;;
          no-access) WATCH_NOTICE="$short: cannot tell whether a job is running — needs journal read access (systemd-journal group) or root" ;;
          none)      WATCH_NOTICE="$short: not running — nothing to kill" ;;
          *)         WATCH_NOTICE="$short: no job running — nothing to kill" ;;
        esac
      fi ;;
    R)
      case "${SLOT[active]}" in
        active|activating|reloading)
          WATCH_ACTION="ctl:restart"
          WATCH_PROMPT="Restart $short? runs: systemctl restart $u  [y/n]$(watch_job_warning restart)" ;;
        *) WATCH_NOTICE="$short: not active (${SLOT[active]:-unknown}) — T starts it" ;;
      esac ;;
    S)
      case "${SLOT[active]}" in
        active|activating|reloading)
          WATCH_ACTION="ctl:stop"
          WATCH_PROMPT="Stop $short? runs: systemctl stop $u  [y/n]$(watch_job_warning stop)" ;;
        *) WATCH_NOTICE="$short: already stopped (${SLOT[active]:-unknown})" ;;
      esac ;;
    T)
      case "${SLOT[active]}" in
        active|activating|reloading) WATCH_NOTICE="$short: already active — R restarts it" ;;
        *) WATCH_ACTION="ctl:start"
           WATCH_PROMPT="Start $short? runs: systemctl start $u  [y/n]" ;;
      esac ;;
    P)
      if [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; then
        WATCH_ACTION="reap"
        WATCH_PROMPT="Reap ${SLOT[job_leaked]} leaked process(es) on $short ($(reap_list))? runs: kill -TERM ${SLOT[job_leaked_pids]}, then kill -KILL what is still alive after ${REAP_GRACE_SEC}s  [y/n]"
      elif [ "${SLOT[job_state]}" = running ]; then
        WATCH_NOTICE="$short: busy ($(job_cell)) — a running job's processes are not leaks"
      else
        WATCH_NOTICE="$short: no leaked processes shown — nothing to reap"
      fi ;;
  esac
}
# The confirmed action. Runs outside any `read`, so the terminal is in its
# normal mode for a sudo prompt; the cursor is shown for it and the command
# is named on the line above, and the output's last line becomes the notice
# on the next frame. A `die` inside only ends the subshell, so a refused or
# failed action is reported, never fatal to the watch.
watch_run_action() {
  local out short
  short="$(short_name "$WATCH_UNIT")"
  term_cursor show
  case "$WATCH_ACTION" in
    ctl:*)
      printf '\nrunning: systemctl %s %s\n' "${WATCH_ACTION#ctl:}" "$WATCH_UNIT"
      out="$(cmd_ctl "${WATCH_ACTION#ctl:}" "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="$short: ${out##*$'\n'}" ;;
    reap)
      printf '\nrunning: reap %s\n' "$short"
      out="$(cmd_reap "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="${out##*$'\n'}" ;;
    kill)
      printf '\nrunning: kill %s\n' "$short"
      out="$(cmd_kill "$WATCH_UNIT" 2>&1)" || true
      WATCH_NOTICE="${out##*$'\n'}" ;;
  esac
  term_cursor hide
  WATCH_ACTION="" WATCH_PROMPT=""
}
# One key against the watch state. Returns 1 on `q` (quit). The cursor is
# the unit's name in WATCH_CURSOR, so it stays on the same slot when the
# pool is scaled and the row numbers shift; UNITS is the current order.
WATCH_CURSOR="" WATCH_NOTICE="" WATCH_PROMPT="" WATCH_ACTION="" WATCH_UNIT=""
watch_handle_key() { # KEY UNITS...
  local key="$1" i n; shift
  local units=("$@")
  if [ -n "$WATCH_ACTION" ]; then
    # A confirm is up: only `y` runs it; anything else is a `n`.
    case "$key" in
      y|Y) watch_run_action ;;
      *)   WATCH_NOTICE="cancelled — nothing run"; WATCH_ACTION="" WATCH_PROMPT="" ;;
    esac
    return 0
  fi
  WATCH_NOTICE=""
  n="${#units[@]}"
  for i in "${!units[@]}"; do [ "${units[$i]}" != "$WATCH_CURSOR" ] || break; done
  case "$key" in
    q|Q)      return 1 ;;
    down|j)   [ "$i" -ge $((n - 1)) ] || WATCH_CURSOR="${units[$((i + 1))]}" ;;
    up|k)     [ "$i" -le 0 ] || WATCH_CURSOR="${units[$((i - 1))]}" ;;
    K|R|S|T|P|L) watch_key_action "$key" "$WATCH_CURSOR" ;;
  esac
  return 0
}

# A native loop rather than `exec watch -n N runnerctl status`: procps
# `watch` is not on every runner host, mangles the UTF-8 `—` cells, and
# would re-run load_config and the config permission checks every tick.
# Each frame is rendered into a variable first and written with one printf
# (home + clear + frame), so the redraw is atomic and does not flicker.
# --iterations N (test-only, undocumented) stops after N redraws so the sim
# can run the loop with its no-op `pause`; that path is headless — no
# cursor, no legend, no key read — so it is exactly the view of before.
# Interactively (GHR-33) each frame ends with the key legend and a status
# line (a notice, or the pending confirm), and the wait between redraws is
# a key read with the interval as its timeout: a key redraws at once, a
# timeout is a tick. The journal memo counts ticks, not keys.
cmd_watch() { # [--interval N] [--iterations N] [--color WHEN] [--stall-after N]
  local interval=2 iterations="" tick=0 refreshed=-1 out header units=() status
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then shift "$VIEW_SHIFT"; continue; fi
    case "$1" in
      --interval)
        need_val "$@"
        [[ "$2" =~ ^0*[1-9][0-9]*$ ]] || die "--interval value '$2' is invalid — want a whole number of seconds, at least 1"
        interval="$2"; shift 2 ;;
      --iterations)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--iterations value '$2' is invalid — want an integer"
        iterations="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  stdout_is_tty || die "watch needs a terminal (stdout is not a tty); use 'runnerctl status'"
  require_runners
  color_setup "$COLOR_MODE"
  JOURNAL_MEMO_DIR="$(mktemp -d)"
  # Ctrl-C exits 0 through the EXIT trap, which restores the cursor either way.
  trap 'term_cursor show; rm -rf "$JOURNAL_MEMO_DIR"' EXIT
  trap 'exit 0' INT TERM
  term_cursor hide
  while :; do
    # A fresh journal read every JOURNAL_CACHE_TTL ticks, starting with the
    # first — once per such tick, however many key redraws it spans.
    if [ $((tick % JOURNAL_CACHE_TTL)) -eq 0 ] && [ "$tick" -ne "$refreshed" ]; then
      rm -f -- "$JOURNAL_MEMO_DIR"/*
      refreshed="$tick"
    fi
    header="$(paint "$C_BOLD" "runnerctl watch — ${HOSTNAME:-$(uname -n)} — $(date +%H:%M:%S) — every ${interval}s (Ctrl-C to quit)")"
    watch_table
    if [ -n "$iterations" ]; then
      printf '\033[H\033[2J%s\n%s\n' "$header" "$WATCH_TABLE"
      pause "$interval"
      tick=$((tick + 1))
      [ "$tick" -lt "$iterations" ] || break
      continue
    fi
    mapfile -t units < <(discover)
    # The cursor follows its unit; a slot that went away drops it to the top.
    [[ " ${units[*]} " == *" $WATCH_CURSOR "* ]] || WATCH_CURSOR="${units[0]:-}"
    out="$(watch_highlight "$WATCH_TABLE" "$(short_name "$WATCH_CURSOR")")"
    status="${WATCH_PROMPT:-$WATCH_NOTICE}"
    printf '\033[H\033[2J%s\n%s\n\n%s\n%s\n' "$header" "$out" "$(paint "$C_DIM" "$WATCH_LEGEND")" "$status"
    if read_key "$interval"; then
      watch_handle_key "$KEY" "${units[@]}" || break
    else
      tick=$((tick + 1))
    fi
  done
}

cmd_remove_limits() {
  parse_opts "$@"
  require_runners
  local units=() u t short_list=""
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for t in "${TARGETS[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  for u in "${units[@]}"; do
    run_priv rm -f "$SYSTEMD_DIR/$u.d/$DROPIN_NAME"
    echo "  removed drop-in for $u"
  done
  run_priv systemctl daemon-reload
  if [ "${#TARGETS[@]}" -gt 0 ]; then
    for u in "${units[@]}"; do
      t="${u#actions.runner.}"; t="${t%.service}"
      short_list+="${short_list:+, }$t"
    done
    echo "Removed drop-in for ${#units[@]} slot(s): $short_list."
  else
    echo "Removed managed drop-ins. Run 'runnerctl restart' to revert running slots."
  fi
}

# GHR-29: kill what a finished job left in an idle slot's cgroup, and only
# that — the Listener keeps running, no restart, no re-registration blip.
# Reads the same job_facts the table reads, so a slot the table shows busy
# is skipped here: a running job's processes are not leaks. SIGTERM first,
# REAP_GRACE_SEC later SIGKILL for whatever pid_alive still sees. The walk
# is a plain read (root or the runner user can do it); only the kills go
# through run_priv. Exit 1 only for a refusal (unreadable cgroup, no
# journal); a busy or clean slot is a line, not a failure.
cmd_reap() { # [--dry-run] [target ...] (default: all)
  local dry_run=false targets=() units=() u t short pid survivors
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      -*)        die "unknown option: $1" ;;
      *)         targets+=("$1"); shift ;;
    esac
  done
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    mapfile -t units < <(discover)
  fi
  for u in "${units[@]}"; do
    short="$(short_name "$u")"
    slot_job_facts "$u"
    case "$JOB_STATE" in
      none) echo "$short: not running — nothing to reap"; continue ;;
      no-access) die "$short: cannot tell whether the slot is idle — reap needs journal read access (systemd-journal group) or root" ;;
      idle|idle-fresh|idle-unknown) ;;
      *) echo "$short: busy ($(job_desc "$(job_cell)")) — skipped, a running job's processes are not leaks"; continue ;;
    esac
    [ -n "$JOB_LEAKED" ] || die "$short: cannot read the slot's processes — run reap as root or the runner user"
    if [ "$JOB_LEAKED" -eq 0 ]; then echo "$short: nothing to reap"; continue; fi
    if $dry_run; then
      echo "$short: would kill $JOB_LEAKED leaked process(es): $(reap_list)"
      continue
    fi
    # shellcheck disable=SC2086  # the pids are one argument each on purpose
    run_priv kill -TERM $JOB_LEAKED_PIDS
    pause "$REAP_GRACE_SEC"
    survivors=""
    for pid in $JOB_LEAKED_PIDS; do
      ! pid_alive "$pid" || survivors+="${survivors:+ }$pid"
    done
    # shellcheck disable=SC2086
    [ -z "$survivors" ] || run_priv kill -KILL $survivors
    echo "$short: reaped $JOB_LEAKED leaked process(es): $(reap_list)${survivors:+ — SIGKILL needed for pid ${survivors// /, }}"
  done
}

# `pid/comm, pid/comm` from a PIDS + COMMS pair, for reap's and kill's lines.
pid_comm_list() { # PIDS COMMS
  local out="" pids comms i
  read -ra pids <<<"$1"
  IFS=',' read -ra comms <<<"${2// /}"
  for i in "${!pids[@]}"; do out+="${out:+, }${pids[$i]}/${comms[$i]:-?}"; done
  echo "$out"
}
reap_list() { pid_comm_list "$JOB_LEAKED_PIDS" "$JOB_LEAKED_COMMS"; }
kill_list() { pid_comm_list "$JOB_TREE_PIDS" "$JOB_TREE_COMMS"; }

# GHR-36: kill the JOB, not the runner. `systemctl restart` is a graceful
# shutdown — the unit GitHub's svc.sh installs carries KillMode=process,
# KillSignal=SIGTERM, TimeoutStopSec=5min, so systemd signals only
# `runsvc.sh`, which asks the Listener, which asks the Worker to cancel the
# step. A step that is genuinely stalled never answers: the restart hangs in
# `deactivating/stop-sigterm` for five minutes and systemd then SIGKILLs the
# main process only, leaving the job's processes alive in the cgroup. That is
# the exact opposite of what "kill the stalled job" has to mean.
#
# So: SIGKILL the job's own processes (proc_job_tree — everything in the
# cgroup but the Listener side), which nothing can ignore, and leave the
# Listener up. It notices its Worker died, reports the job failed to GitHub
# and is idle in seconds — no restart, no re-registration blip, no other
# slot's work disturbed.
#
# Two escalations to `systemctl kill -s KILL <unit>`, which signals every
# process of the unit's cgroup whatever KillMode says, with Restart=always
# bringing the slot back:
#   - the cgroup cannot be read (not root, not the runner user), so there are
#     no pids to signal — systemd can do it without reading anything;
#   - the slot is already wedged in its own stop, or the Listener has not
#     reported the job gone KILL_GRACE_SEC after its Worker was killed (it is
#     hung too). This is the case a plain `restart` cannot get out of.
cmd_kill() { # [--dry-run] [--if-stalled] [--stall-after N] [target ...]
  local dry_run=false if_stalled=false targets=() units=() u t short acted=0
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --dry-run)     dry_run=true; shift ;;
      --if-stalled)  if_stalled=true; shift ;;
      --stall-after) need_val "$@"; set_stall_after "$2"; shift 2 ;;
      -*)            die "unknown option: $1" ;;
      *)             targets+=("$1"); shift ;;
    esac
  done
  if $if_stalled && [ "$STALL_SEC" -le 0 ]; then
    die "--if-stalled needs a threshold: STALL_SEC is 0 (pass --stall-after N)"
  fi
  require_runners
  if [ "${#targets[@]}" -gt 0 ]; then
    for t in "${targets[@]}"; do
      # Resolve on its own line: a die inside "$(...)" only exits the subshell.
      u="$(resolve "$t")"
      units+=("$u")
    done
  else
    # Killing every slot's job at once is never what someone means by a bare
    # `kill`; with --if-stalled the selection is the stalled set, so no target
    # is the normal form.
    $if_stalled || die "kill needs a target (a unit, slot index or name) — or --if-stalled to take every stalled slot"
    mapfile -t units < <(discover)
  fi
  for u in "${units[@]}"; do
    short="$(short_name "$u")"
    if $if_stalled; then
      stalled_gate "$u" killing || continue
    else
      slot_job_facts "$u"
      kill_gate "$short" || continue
    fi
    acted=$((acted + 1))
    kill_slot "$u" "$short" "$dry_run"
  done
  if $if_stalled && [ "$acted" -eq 0 ]; then
    echo "no stalled slot — nothing killed."
  elif $if_stalled; then
    echo "kill done ($acted stalled slot(s))."
  fi
}

# May `kill` act on the slot slot_job_facts just described? A deactivating
# unit is the wedged-stop case and always may — that is the state a hung
# `restart` leaves behind, and the one only a SIGKILL gets out of.
kill_gate() { # SHORT
  [ "$SLOT_ACTIVE" != deactivating ] || return 0
  case "$JOB_STATE" in
    running|starting) return 0 ;;
    no-access) die "$1: cannot tell whether a job is running — kill needs journal read access (systemd-journal group) or root" ;;
    none) echo "$1: not running — nothing to kill"; return 1 ;;
    *) echo "$1: no job running — nothing to kill"; return 1 ;;
  esac
}

# One slot, with its facts already in the JOB_*/SLOT_ACTIVE globals.
kill_slot() { # UNIT SHORT DRY-RUN
  local u="$1" short="$2" dry="$3" waited=0 killed
  if [ "$SLOT_ACTIVE" = deactivating ]; then
    kill_unit "$u" "$short" "$dry" "stuck stopping (${SLOT_ACTIVE}/${SLOT_SUB:-?}) — a graceful stop it will not answer"
    return 0
  fi
  job_tree_check "$JOB_CGROUP"
  if [ -z "$JOB_TREE" ]; then
    kill_unit "$u" "$short" "$dry" "cannot read the slot's processes (run as root or the runner user to kill just the job)"
    return 0
  fi
  if [ "$JOB_TREE" -eq 0 ]; then
    echo "$short: nothing but the runner itself in the slot's cgroup — nothing to kill"
    return 0
  fi
  killed="$JOB_TREE process(es): $(kill_list)"
  if $dry; then
    echo "$short: would kill $killed"
    return 0
  fi
  # shellcheck disable=SC2086  # the pids are one argument each on purpose
  run_priv kill -KILL $JOB_TREE_PIDS
  # The Listener reports the job failed on its own; poll until it has, so a
  # Listener that is wedged too is escalated rather than left behind a line
  # claiming success.
  [[ "$POLL_SEC" =~ ^[1-9][0-9]*$ ]] || die "POLL_SEC must be a positive integer (config sets '$POLL_SEC')"
  while :; do
    pause "$POLL_SEC"
    waited=$((waited + POLL_SEC))
    # Under `watch` the journal read is memoised per tick; this poll has to
    # see the new lines, not the ones the frame was drawn from.
    [ -z "$JOURNAL_MEMO_DIR" ] || rm -f -- "$JOURNAL_MEMO_DIR/$u".*
    slot_job_facts "$u"
    [ "$JOB_STATE" = running ] || break
    [ "$waited" -lt "$KILL_GRACE_SEC" ] || {
      kill_unit "$u" "$short" false "job still running ${waited}s after SIGKILL — the runner is wedged too"
      return 0
    }
  done
  echo "$short: killed $killed — the runner stayed up and reports the job failed"
}

# The escalation: systemd signals the whole cgroup, KillMode notwithstanding.
kill_unit() { # UNIT SHORT DRY-RUN WHY
  local u="$1" short="$2" dry="$3" why="$4"
  if $dry; then
    echo "$short: $why — would run systemctl kill -s KILL $u"
    return 0
  fi
  echo "$short: $why — killing the whole unit"
  run_priv systemctl kill -s KILL "$u"
  echo "$short: SIGKILLed the unit's cgroup — Restart=always brings the slot back"
}

# GHR-14: a yes/no for cron/uptime probes — nothing on the host can currently
# notice "slot has been inactive/dead since Tuesday" without parsing `status`.
# Reads the same collect_slot the table and --json read (GHR-16), so the
# three surfaces cannot disagree on what a slot is doing (GHR-27).
#
# A problem is:
#   - UnitFileState=enabled and not active/activating/reloading (a disabled,
#     scaled-down slot is healthy on purpose — not a problem);
#   - NRestarts >= --max-restarts (default 5), plus the journal's last-known
#     reason when journal_restart_reason has one, or the current invocation's
#     own Result when that is not success. NRestarts is systemd's count
#     since the unit's last manual start, not "in the last hour" — there is no
#     cheap way to bucket it by wall-clock time, so that is what this reports;
#   - a job running for --stall-after seconds (default STALL_SEC) or more —
#     needs the journal or a visible Runner.Worker, like the table's cell.
#     With --restart-stalled (GHR-30) that slot is restarted on the spot
#     (through run_priv — the one case health touches the host) and the
#     line ends `— restarted`; the exit code is still 1, so a probe records
#     the event once and the next run is clean;
#   - an idle slot with leaked processes (GHR-29) — needs a readable cgroup,
#     like the table's `+N leaked`;
#   - memory pressure (PSI full avg10) at PRESSURE_CRIT_PCT or more (GHR-31)
#     — the slot is being throttled at MemoryHigh, not working. A stalled
#     line also says so from PRESSURE_WARN_PCT, which is the difference
#     between a starved job and a hung one.
# No problems: exit 0, "ok: N slot(s) healthy" (suppressed by --quiet). Any
# problem: one line each on stdout (suppressed by --quiet; the exit code is
# not), exit 1. No units at all: require_runners' existing die (not
# suppressed by --quiet — only cmd_health's own output is).
cmd_health() { # [--quiet] [--max-restarts N] [--stall-after N] [--restart-stalled]
  local quiet=false max_restarts=5 restart_stalled=false
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --quiet)
        quiet=true; shift ;;
      --max-restarts)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--max-restarts value '$2' is invalid — want an integer"
        max_restarts="$2"; shift 2 ;;
      --stall-after)
        need_val "$@"
        set_stall_after "$2"; shift 2 ;;
      --restart-stalled)
        restart_stalled=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  require_runners
  local u short n=0 problems=() nrestarts reason line
  while read -r u; do
    [ -n "$u" ] || continue
    collect_slot "$u" "$n"
    n=$((n + 1))
    short="${SLOT[name]}" nrestarts="${SLOT[restarts]:-0}"
    case "${SLOT[active]}" in
      active | activating | reloading) ;;
      *)
        if [ "${SLOT[enabled]}" = enabled ]; then
          problems+=("$short: enabled but ${SLOT[active]}/${SLOT[sub]} since $(since_state "${SLOT[active]}" "${SLOT[active_enter]}" "${SLOT[inactive_enter]}")")
        fi
        ;;
    esac
    if [[ "$nrestarts" =~ ^[0-9]+$ ]] && [ "$nrestarts" -ge "$max_restarts" ]; then
      line="$short: $nrestarts restarts since last start"
      reason="${SLOT[last_restart_reason]}"
      [ -n "$reason" ] || [ "${SLOT[result]:-success}" = success ] || reason="${SLOT[result]}"
      [ -n "$reason" ] && line+=" ($reason)"
      problems+=("$line")
    fi
    if [ "${SLOT[job_stalled]}" = true ]; then
      line="$short: stalled — job ${SLOT[job_repo]:+${SLOT[job_repo]}:}${SLOT[job_name]:-?} running ${SLOT[job_runtime]}, longer than $(fmt_dur "$STALL_SEC") (--stall-after $STALL_SEC)"
      ! pressure_at_least "${SLOT[mem_pressure_full_avg10]}" "$PRESSURE_WARN_PCT" || line+=" — under memory pressure $(status_press_cell "${SLOT[mem_pressure_full_avg10]}"), throttled rather than hung"
      # GHR-30: the only privileged call health ever makes, and only here.
      if $restart_stalled; then
        if run_priv systemctl restart "$u"; then line+=" — restarted"; else line+=" — restart FAILED"; fi
      fi
      problems+=("$line")
    fi
    if [[ "${SLOT[job_leaked]}" =~ ^[0-9]+$ ]] && [ "${SLOT[job_leaked]}" -gt 0 ]; then
      problems+=("$short: ${SLOT[job_leaked]} leaked process(es) left by finished jobs (${SLOT[job_leaked_comms]}) — runnerctl reap ${SLOT[idx]}")
    fi
    if pressure_at_least "${SLOT[mem_pressure_full_avg10]}" "$PRESSURE_CRIT_PCT"; then
      problems+=("$short: under full memory pressure $(status_press_cell "${SLOT[mem_pressure_full_avg10]}") (avg10, PRESSURE_CRIT_PCT=$PRESSURE_CRIT_PCT) — throttled at MemoryHigh (${SLOT[mem_events_high]:-?} times so far), see USED vs HIGH")
    fi
  done < <(discover)
  if [ "${#problems[@]}" -eq 0 ]; then
    $quiet || echo "ok: $n slot(s) healthy"
    return 0
  fi
  $quiet || printf '%s\n' "${problems[@]}"
  return 1
}

# --- Fleet mode (GHR-39) ------------------------------------------------------
# One central node drives several runner hosts over ssh. The transport fans
# out WHOLE commands — one `ssh <host> runnerctl status` per host — rather
# than shimming the per-host primitives underneath. Measured (GHR-37): a
# single `status` makes 21 primitive calls against the 3-slot stub, and the
# /proc walks are per PID rather than per slot, so a primitive-level shim
# would be hundreds of round-trips on a busy slot against exactly one here.
#
# Fleet mode requires runnerctl installed on each host. Piping this script
# over stdin per call was considered and rejected: `is_piped` refuses
# everything but `install` deliberately, and version skew is better solved
# once by a fleet-wide upgrade than by paying a transfer on every command.

# Every ssh call goes through here — nothing else in this script may invoke
# ssh. That is what lets tests/stub.config shadow the transport the way it
# already shadows systemctl and journalctl, and the harness fails any call
# that bypasses the stub. The exit status is the remote command's, except
# that ssh itself answers 255 and `timeout` answers 124.
#
# BatchMode=yes is load-bearing rather than tidy: under a non-interactive
# ssh a remote sudo password prompt HANGS FOREVER, and a fan-out hangs once
# per host. With it the prompt fails fast and the host becomes a row.
#
# No ControlMaster by default. Within one fan-out there is exactly one ssh
# per host, so multiplexing buys nothing; it pays only across invocations (a
# polling loop) or in a slice that runs several commands per host, and it
# costs a socket directory and stale-socket handling this does not need. A
# site that wants it adds it through FLEET_SSH_OPTS, appended last so it can
# override anything set here. Host key policy is deliberately left to the
# caller's ssh config rather than decided here.
ssh_run() { # HOST COMMAND...
  local host="$1"; shift
  timeout "$FLEET_TIMEOUT" ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    ${FLEET_SSH_OPTS+"${FLEET_SSH_OPTS[@]}"} \
    -- "$host" "$@"
}

require_fleet() {
  [ "${#FLEET_HOSTS[@]}" -gt 0 ] || die "fleet mode is not configured — set FLEET_HOSTS=(host1 host2 ...) in $CONFIG_FILE ('runnerctl config-example' shows the block). An empty fleet is a missing config, not an empty table."
}

# Where a fan-out buffers its per-host output. Buffering is not an
# optimisation: concurrent writers interleave on a shared stdout, and half a
# line from one host inside another's JSON is unparseable.
FLEET_DIR=""
fleet_cleanup() {
  [ -z "$FLEET_DIR" ] || rm -rf "$FLEET_DIR"
  FLEET_DIR=""
}

# Run REMOTE-ARGS on every FLEET_HOSTS entry, at most FLEET_PARALLEL at a
# time. Each host's stdout, stderr and exit status land in their own files,
# indexed by position in FLEET_HOSTS so the render order is the config order
# rather than whichever host answered first.
fleet_fanout() { # REMOTE-ARGS...
  local i host running=0 hrc
  FLEET_DIR="$(mktemp -d)"
  trap fleet_cleanup EXIT
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    {
      # `|| hrc=$?` rather than a bare call plus `echo $?`: under `set -e` a
      # non-zero ssh_run kills this subshell before the status can be
      # recorded, so every failure would read as the missing-file fallback
      # and a timeout would be indistinguishable from an unreachable host.
      hrc=0
      ssh_run "$host" "$@" >"$FLEET_DIR/$i.out" 2>"$FLEET_DIR/$i.err" || hrc=$?
      echo "$hrc" >"$FLEET_DIR/$i.rc"
    } &
    running=$((running + 1))
    if [ "$running" -ge "$FLEET_PARALLEL" ]; then
      wait -n 2>/dev/null || true
      running=$((running - 1))
    fi
  done
  wait
}

fleet_rc() { # INDEX
  cat "$FLEET_DIR/$1.rc" 2>/dev/null || echo 255
}

# Whether the host answered at all, as a JSON boolean. The distinction this
# draws is the one that matters operationally: ssh could not reach the host
# (255) or the call ran out of time (124) — nothing is known about it — versus
# the remote runnerctl running fine and exiting non-zero, which on a
# runner-less host is its own perfectly good message and not a fleet fault.
fleet_reachable() { # RC
  case "$1" in 124|255) echo false ;; *) echo true ;; esac
}

fleet_error_text() { # RC ERRFILE
  local rc="$1" err="" hint=""
  [ ! -s "$2" ] || err="$(head -1 "$2")"
  # An accurate error that leaves the reader to work out the fix is half a
  # message. Name the remedy where it is read.
  #
  # The bootstrap failures below are told apart by the shell's own exit codes
  # rather than by matching English, because they are genuinely different
  # faults with different fixes, and a row saying only "remote exit 127" sends
  # someone to reinstall runnerctl on a host that already has it.
  #
  # Probed rather than assumed (GHR-50): a root-owned 0700 OR 0711 script on
  # PATH fails 126 "Permission denied" naming the FULL PATH, and only a name
  # that resolves to nothing fails 127 on the BARE NAME. So the 0700/0711
  # install this project shipped in 0.9.0-0.10.0 (GHR-47) is the 126 row,
  # never the 127 one.
  #
  # And 127 is NOT "not installed". `ssh host runnerctl` runs no login shell,
  # so it never reads ~/.profile — on Ubuntu that is what adds ~/.local/bin
  # and ~/bin, and a runnerctl installed there works perfectly when the same
  # user logs in and is invisible to the fan-out. Hence "not on the PATH for a
  # non-interactive ssh login" rather than "not installed", and hence
  # FLEET_RUNNERCTL named as the fix that does not move any files.
  #
  # First match wins, and the order matters: `sudo: runnerctl: command not
  # found` carries both signatures and is a PATH fault, not a sudo refusal.
  case "$rc:$err" in
    127:*|*"command not found"*)
      # `command not found` is safe to match as text: runnerctl never says it,
      # so this cannot swallow a remote error of its own. A bare "not found"
      # would — systemctl says "Unit ... not found" through this same pipe.
      hint=" — runnerctl is not on that host's PATH for a non-interactive ssh login (which reads no ~/.profile, so ~/.local/bin and ~/bin are not on it); set FLEET_RUNNERCTL to its absolute path, or install it system-wide with 'curl -fsSL $UPGRADE_URL | sudo bash -s -- install'" ;;
    *"unknown program"*|*"applet not found"*)
      # A multicall binary (uutils, busybox) answering to the name. Both
      # phrases are dispatcher signatures that runnerctl cannot produce, so
      # matching them as text costs nothing.
      hint=" — a multicall binary answered to that name instead of runnerctl; check what FLEET_RUNNERCTL resolves to on that host, and that the real runnerctl is readable by the ssh login" ;;
    126:*)
      hint=" — runnerctl is installed on that host but the ssh login cannot execute it; 'sudo chmod 755' the path it names, or re-run the installer" ;;
    *sudo:*|*"a password is required"*|*"may not run"*|*"no tty present"*)
      # The single most likely failure of a mutating fan-out. BatchMode=yes is
      # what makes this a failure to report at all rather than a fan-out hung
      # on a password prompt.
      hint=" — the ssh login needs passwordless sudo on that host; see the fleet section of the README for the exact sudoers line" ;;
  esac
  case "$rc" in
    0)   echo "" ;;
    124) echo "timed out after ${FLEET_TIMEOUT}s${err:+ — $err}" ;;
    255) echo "unreachable${err:+ — $err}" ;;
    *)   echo "remote exit $rc${err:+ — $err}$hint" ;;
  esac
}

# A host's payload is only nested verbatim when it actually looks like the
# object it claims to be. rc 0 with something else on stdout would otherwise
# produce invalid fleet JSON, and a consumer would blame the fleet tool.
fleet_payload_ok() { # INDEX
  [ -s "$FLEET_DIR/$1.out" ] && [ "$(head -c 1 "$FLEET_DIR/$1.out")" = "{" ]
}

# `fleet status --json`: each host's own payload nested UNCHANGED inside an
# envelope. This is why fleet mode needs no JSON parser and keeps the
# script's zero-jq dependency — the remote object is already valid, so it is
# concatenated, never re-serialised, and cannot be corrupted in transit.
fleet_status_json() {
  local i host rc sep="" bad=0 err ok
  printf '{"fleet":['
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    ok=false
    if [ "$rc" = 0 ] && fleet_payload_ok "$i"; then ok=true; fi
    $ok || bad=$((bad + 1))
    # A host that exited 0 with something other than an object gets an error
    # of its own rather than a bare null status: exit 0, reachable, no error
    # and no payload is the one combination a consumer cannot interpret.
    if [ "$rc" = 0 ] && ! $ok; then
      err="exit 0 but no JSON object on stdout — check FLEET_RUNNERCTL and the remote login's output"
    else
      err="$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")"
    fi
    printf '%s\n  {"host_name":%s,"reachable":%s,"exit_code":%s,"error":%s,"status":' \
      "$sep" "$(json_str "$host")" "$(fleet_reachable "$rc")" "$(json_num "$rc")" \
      "$(json_strn "$err")"
    if $ok; then cat "$FLEET_DIR/$i.out"; else printf 'null'; fi
    printf '}'
    sep=","
  done
  printf '\n]}\n'
  [ "$bad" -eq 0 ]
}

# `fleet status`: every host's already-rendered rows with a HOST column
# prefixed on. Prefixing only — the remote table is NEVER parsed by column
# position, because a cell longer than its width shifts everything after it
# on that row (`active/running ↻3 (last: oom-kill)` does). Adding on the left
# is safe whatever the row does to its right.
#
# Line position IS reliable, unlike column position: the remote `status`
# prints its version header, a blank, the column header, then one row per
# slot, and any note lines last.
fleet_status_table() {
  local i host rc hostw=4 ver first_ver="" skew=false bad=0 n=0
  local -a lines notes=()
  for host in "${FLEET_HOSTS[@]}"; do
    [ "${#host}" -le "$hostw" ] || hostw="${#host}"
  done
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    if [ "$rc" != 0 ]; then
      bad=$((bad + 1))
      printf '%-*s %s\n' "$hostw" "$host" \
        "$(paint "$C_RED" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")")"
      continue
    fi
    mapfile -t lines <"$FLEET_DIR/$i.out"
    # A zero-status host that produced no table is still a failed row rather
    # than an unbound-variable crash two lines down: `set -u` makes
    # ${lines[0]} on an empty mapfile fatal, and the header and column-header
    # lines are only there to index if the remote actually printed a table.
    if [ "${#lines[@]}" -lt 3 ]; then
      bad=$((bad + 1))
      printf '%-*s %s\n' "$hostw" "$host" \
        "$(paint "$C_RED" "no status table returned")"
      continue
    fi
    ver="${lines[0]#runnerctl }"; ver="${ver%% *}"
    if [ -z "$first_ver" ]; then first_ver="$ver"
    elif [ "$ver" != "$first_ver" ]; then skew=true
    fi
    if [ "$n" -eq 0 ]; then
      paint "$C_BOLD" "$(printf '%-*s %s' "$hostw" "HOST" "${lines[2]}")"
    fi
    n=$((n + 1))
    local l
    for l in "${lines[@]:3}"; do
      case "$l" in
        note:*) notes+=("$l") ;;
        '')     ;;
        *)      printf '%-*s %s\n' "$hostw" "$host" "$l" ;;
      esac
    done
  done
  # Notes are per-fleet, not per-host: the same note from six hosts is one
  # fact about the fleet, and six copies of it buries the rows above.
  if [ "${#notes[@]}" -gt 0 ]; then
    printf '%s\n' "${notes[@]}" | sort -u
  fi
  if $skew; then
    # Names only what exists today: `runnerctl upgrade`, run per host. A
    # fleet-wide upgrade is GHR-41 and this line gets to name it once it is
    # real — telling someone to run a command that does not exist is worse
    # than telling them nothing.
    paint "$C_YELLOW" "note: the hosts are not all on one runnerctl version (see 'fleet status --json', .fleet[].status.runnerctl); run 'runnerctl upgrade' on the ones that lag"
  fi
  [ "$bad" -eq 0 ]
}

cmd_fleet() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    status)  cmd_fleet_status "$@" ;;
    health)  cmd_fleet_health "$@" ;;
    upgrade) cmd_fleet_upgrade "$@" ;;
    apply|scale|start|stop|restart|drain|kill|reap|remove-limits|enable|disable)
             cmd_fleet_run "$sub" "$@" ;;
    # env-init is PERMANENTLY excluded, not merely unimplemented: it writes an
    # EnvironmentFile of secrets, and fanning it out means pushing secrets
    # over ssh. watch and logs are interactive and streaming, so they stay
    # per-host. Saying which of the three it is beats "unknown command".
    env-init)
             die "fleet env-init is not supported and will not be: it writes an EnvironmentFile of secrets, which fanning out means copying secrets over ssh. Run 'runnerctl env-init' on each host." ;;
    # provision is excluded for env-init's reason plus one of its own: it
    # takes a registration token, so fanning it out pushes a credential over
    # ssh to every host — and each host needs its own runner names, which a
    # single fleet-wide command cannot supply.
    provision)
             die "fleet provision is not supported: it takes a registration token (fanning it out copies a credential to every host) and each host needs its own runner names. Run 'runnerctl provision N' on each host." ;;
    watch|logs)
             die "fleet $sub is not supported: $sub is $([ "$sub" = watch ] && echo interactive || echo streaming) and only makes sense against one host. Use 'runnerctl fleet status' for an overview, or ssh to the host." ;;
    *)       die "unknown fleet command '$sub' (status health upgrade apply scale start stop restart drain kill reap remove-limits enable disable)" ;;
  esac
}

# --host H, repeatable, narrows the fan-out. Validated against FLEET_HOSTS
# and dies naming an unknown one rather than dialling it: a typo that
# silently targets nothing, on a command that stops runners, is worse than
# an error.
fleet_select_hosts() { # NAME...
  local want h found
  local -a sel=()
  for want in "$@"; do
    found=false
    for h in "${FLEET_HOSTS[@]}"; do
      if [ "$h" = "$want" ]; then found=true; break; fi
    done
    $found || die "--host '$want' is not in FLEET_HOSTS (configured: ${FLEET_HOSTS[*]})"
    sel+=("$want")
  done
  FLEET_HOSTS=("${sel[@]}")
}

# stop, drain and disable take fleet capacity away and do not give it back.
# Run across every host with no thought, they are an outage — and the whole
# reason this needs its own gate is that the per-host --when-idle politeness
# does NOT compose: every host draining one-slot-at-a-time still converges on
# zero fleet capacity at roughly the same moment.
#
# So they are refused fleet-wide unless the operator was explicit: --host H
# (a bounded target) or --all-hosts (an acknowledgement). restart and kill
# are transient — the unit comes back — and apply/scale/reap/remove-limits/
# enable/start do not remove capacity, so none of them need this.
fleet_capacity_gate() { # SUBCOMMAND HOST-COUNT ALL-HOSTS
  case "$1" in stop|drain|disable) ;; *) return 0 ;; esac
  [ "$2" -eq 0 ] || return 0
  $3 && return 0
  die "'fleet $1' across every host would take the whole pool's capacity down at once — each host draining politely one slot at a time still lands them all at zero together. Name the hosts with --host H (repeatable), or pass --all-hosts if you do mean the entire fleet."
}

# --- Fleet capacity budgets (GHR-44) -----------------------------------------
# GHR-43's controls are blunt: serial hosts, --host, and an --all-hosts
# acknowledgement. These are the graded ones, and they are TWO DIFFERENT
# SHAPES because the operations have opposite dynamics:
#
#   --max-unavailable N   for restart: a slot goes out and COMES BACK, so the
#                         unavailable count rises and falls and a ceiling
#                         throttles the rate. The rolling-update shape.
#   --min-available K     for stop/drain/disable: capacity is removed and NOT
#                         returned, so the unavailable count only ever rises.
#                         A ceiling here would take out N slots and then have
#                         nothing to wait for — it would block forever or
#                         stop silently half-done. What these need is a
#                         FLOOR: stop before crossing it, and say so.
#
# Conflating the two is the error GHR-42 was originally written around; see
# that issue for the full reasoning.

# "HOST IDX ACTIVE-STATE", one line per slot across the fleet.
#
# Extracted with one sed rather than a JSON parser: render_status_json emits
# each slot as a single line and this script owns that emitter, so idx and
# active are always on it together. That is a different thing from parsing
# the status TABLE, which the fleet renderer refuses to do by column position
# because an over-wide cell shifts everything after it on the row.
#
# A host that did not answer contributes no slots: its capacity is unknown,
# and guessing either way is worse than leaving it out of the arithmetic. The
# caller is told how many hosts were skipped.
FLEET_SLOTS_SKIPPED=0
fleet_slots() {
  local i host
  FLEET_SLOTS_SKIPPED=0
  fleet_fanout "$FLEET_RUNNERCTL" status --json
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    if [ "$(fleet_rc "$i")" != 0 ]; then
      FLEET_SLOTS_SKIPPED=$((FLEET_SLOTS_SKIPPED + 1))
      continue
    fi
    sed -n "s/.*\"idx\":\([0-9]*\).*\"active\":\"\([a-z]*\)\".*/$host \1 \2/p" "$FLEET_DIR/$i.out"
  done
  fleet_cleanup
}

# Slots counted as serving work. `activating` and `reloading` are NOT
# available: a slot on its way up cannot take a job yet, and counting it
# would let a roll run ahead of itself.
fleet_count_available() { # SLOT-LINES
  printf '%s\n' "$1" | awk '$3 == "active"' | grep -c . || true
}

fleet_count_unavailable() { # SLOT-LINES
  printf '%s\n' "$1" | awk 'NF == 3 && $3 != "active"' | grep -c . || true
}

# Percentage forms resolve against the fleet's total slots and NEVER round to
# zero: a budget of 0 would deadlock the roll on its first slot, which looks
# exactly like a hung fleet.
fleet_resolve_budget() { # VALUE TOTAL
  local v="$1" total="$2" n
  case "$v" in
    *%) n=$(( total * ${v%\%} / 100 )); [ "$n" -ge 1 ] || n=1 ;;
    *)  n="$v" ;;
  esac
  echo "$n"
}

# Fan a MUTATING command out. Everything here is deliberately different from
# the read-only commands above.
# Walk the fleet's slots one at a time, holding a capacity budget.
#
# One slot per remote call, rather than one command per host: a budget is a
# statement about SLOTS, and a per-host call would take a whole host's worth
# of capacity out in one step regardless of the number.
#
# Returns 0 when every targeted slot was acted on, 2 when a floor stopped it
# early (a distinct code because "I deliberately did less than you asked" is
# neither success nor failure), 1 when a slot failed.
fleet_budget_walk() { # SUBCOMMAND MODE BUDGET [REMOTE-ARGS...]
  local sub="$1" mode="$2" budget="$3"; shift 3
  local slots host idx state n total waited acted=0 nbad=0 stopped_at_floor=false
  local -a left=()
  slots="$(fleet_slots)"
  total="$(printf '%s\n' "$slots" | grep -c . || true)"
  [ "$total" -gt 0 ] || die "no slots found on the fleet — nothing to $sub (are the hosts reachable? try 'runnerctl fleet status')"
  n="$(fleet_resolve_budget "$budget" "$total")"
  [[ "$n" =~ ^[0-9]+$ ]] || die "budget '$budget' is invalid — want a whole number or a percentage like 25%"
  if [ "$FLEET_SLOTS_SKIPPED" -gt 0 ]; then
    # Said once, up front: a budget computed from a partial fleet is a
    # different promise from one computed over all of it, and the operator
    # should know which they are getting before anything moves.
    echo "warning: $FLEET_SLOTS_SKIPPED host(s) did not answer — the budget is being held over the $total slot(s) that did"
  fi
  while IFS=' ' read -r host idx state; do
    [ -n "$host" ] || continue
    if [ "$mode" = floor ]; then
      # Would acting take the fleet below the floor? Re-read rather than
      # decrementing a local counter: another operator, or a crashing job,
      # can move the number underneath a long roll.
      local avail; avail="$(fleet_count_available "$(fleet_slots)")"
      if [ "$((avail - 1))" -lt "$n" ]; then
        stopped_at_floor=true
        left+=("$host/$idx")
        continue
      fi
    else
      # Ceiling: wait for the fleet to come back under budget.
      waited=0
      while :; do
        local unavail; unavail="$(fleet_count_unavailable "$(fleet_slots)")"
        [ "$unavail" -ge "$n" ] || break
        [ "$waited" -lt "$WAIT_TIMEOUT" ] || die "waited ${waited}s for the fleet to come back under --max-unavailable $n and it did not — $acted slot(s) already ${sub}ed; 'runnerctl fleet status' shows what is still out"
        pause "$POLL_SEC"
        waited=$((waited + POLL_SEC))
      done
    fi
    local rc1=0
    ssh_run "$host" "$FLEET_RUNNERCTL" "$sub" "$idx" "$@" >/dev/null 2>&1 || rc1=$?
    if [ "$rc1" = 0 ]; then
      acted=$((acted + 1)); echo "$host slot $idx: $sub ok"
    else
      nbad=$((nbad + 1)); echo "$host slot $idx: $sub FAILED (exit $rc1)"
    fi
  done <<<"$slots"
  # Not ${stopped_at_floor:+...}: the variable holds the STRING "false" when
  # the floor was never hit, which is non-empty and would expand anyway.
  if $stopped_at_floor; then
    echo "fleet $sub: $acted slot(s) done, $nbad failed, ${#left[@]} left running at the floor"
    echo "left running to hold --min-available $n: ${left[*]}"
  else
    echo "fleet $sub: $acted slot(s) done, $nbad failed"
  fi
  [ "$nbad" -eq 0 ] || return 1
  $stopped_at_floor && return 2
  return 0
}

cmd_fleet_run() { # SUBCOMMAND [--host H]... [--all-hosts] [REMOTE-ARGS...]
  local sub="$1"; shift
  local all_hosts=false rc=0 max_unavail="" min_avail=""
  local -a hosts=() fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --host)      need_val "$@"; hosts+=("$2"); shift 2 ;;
      --all-hosts) all_hosts=true; shift ;;
      --max-unavailable) need_val "$@"; max_unavail="$2"; shift 2 ;;
      --min-available)   need_val "$@"; min_avail="$2"; shift 2 ;;
      # Everything else is the remote command's own flag and is forwarded
      # untouched. Re-implementing each command's parser here would be a
      # second copy to keep in step, and the host that runs it is the one
      # that should reject a bad flag.
      *)           fwd+=("$1"); shift ;;
    esac
  done
  require_fleet
  [ "${#hosts[@]}" -eq 0 ] || fleet_select_hosts "${hosts[@]}"
  # Which budget suits which command is not a preference — see the block
  # above fleet_slots. A ceiling on a command that never gives capacity back
  # cannot make progress, and a floor on a rolling restart is meaningless
  # because the roll returns what it takes. Refuse the wrong pairing rather
  # than accepting a flag that would quietly do nothing.
  # Checked BEFORE the per-command pairing below: "you asked for both" is the
  # more fundamental mistake, and reporting the pairing error first would
  # describe a flag the user is about to be told they cannot use anyway.
  [ -z "$max_unavail" ] || [ -z "$min_avail" ] || die "--max-unavailable and --min-available cannot be combined: one throttles a roll that gives capacity back, the other holds a floor under capacity being removed"
  if [ -n "$max_unavail" ]; then
    case "$sub" in
      restart|apply|scale) ;;
      *) die "--max-unavailable applies to restart, apply and scale, not '$sub': it is a ceiling on slots that are temporarily out, and '$sub' does not give the capacity back. Use --min-available K to hold a floor instead." ;;
    esac
  fi
  if [ -n "$min_avail" ]; then
    case "$sub" in
      stop|drain|disable) ;;
      *) die "--min-available applies to stop, drain and disable, not '$sub': it is a floor under capacity that is being taken away, and '$sub' returns what it takes. Use --max-unavailable N to throttle the roll instead." ;;
    esac
  fi
  if [ -n "$max_unavail" ]; then
    fleet_budget_walk "$sub" ceiling "$max_unavail" ${fwd[@]+"${fwd[@]}"} || rc=$?
    return "$rc"
  fi
  if [ -n "$min_avail" ]; then
    fleet_budget_walk "$sub" floor "$min_avail" ${fwd[@]+"${fwd[@]}"} || rc=$?
    return "$rc"
  fi
  fleet_capacity_gate "$sub" "${#hosts[@]}" "$all_hosts"
  # ONE HOST AT A TIME. FLEET_PARALLEL is ignored for mutating commands on
  # purpose: with the existing per-host --when-idle (one slot at a time
  # within a host), serial hosts bound the blast radius to a single host at
  # any moment. It is slow on a large fleet, and that is the right trade for
  # something that can take CI capacity down.
  FLEET_PARALLEL=1
  fleet_fanout "$FLEET_RUNNERCTL" "$sub" ${fwd[@]+"${fwd[@]}"}
  fleet_run_report "$sub" || rc=$?
  fleet_cleanup
  return "$rc"
}

# One block per host: whatever that host said, prefixed, then a count. A
# host's own output is reused rather than summarised, because these commands
# already say useful per-slot things ("2 stalled slot(s)", "nothing to reap").
fleet_run_report() { # SUBCOMMAND
  local sub="$1" i host rc line ok=0 bad=0
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    if [ "$rc" = 0 ]; then ok=$((ok + 1)); else bad=$((bad + 1)); fi
    # stdout first even when the host failed: a command that got part way
    # through says so there, and losing that would hide a half-applied host.
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s: %s\n' "$host" "$line"
    done <"$FLEET_DIR/$i.out"
    [ "$rc" = 0 ] || printf '%s: %s\n' "$host" "$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")"
  done
  echo "fleet $sub: $ok host(s) ok, $bad failed"
  [ "$bad" -eq 0 ]
}

# `fleet upgrade`: hold every host on one runnerctl version from one place.
#
# Version skew is the fleet's quietest failure — a host only picks up a new
# script when `upgrade` runs on it, so until then the fleet behaves two ways
# and nothing says so. `fleet status` notices the drift; this fixes it.
#
# This is the first MUTATING fan-out, so it is also where the privilege
# question lands. `upgrade` writes the installed script, which on a normal
# host needs root — install_file already picks run_priv only when the
# destination is not writable. The requirement is therefore passwordless sudo
# on each host for that write, and BatchMode=yes (GHR-39) is what turns its
# absence into a fast, named failure instead of a fan-out that hangs once per
# host. No new privilege machinery is needed here; see the README.
#
# A host that fails to upgrade is a REPORTED ROW, not an abort. A partly
# upgraded fleet is the normal outcome of a flaky network, and the one thing
# you must not lose in that case is which host is still behind.
cmd_fleet_upgrade() { # [--check] [--ref REF]
  local check=false rc=0
  local -a fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --check) check=true; fwd+=(--check); shift ;;
      --ref)   need_val "$@"; fwd+=(--ref "$2"); shift 2 ;;
      *)       die "unknown option: $1" ;;
    esac
  done
  require_fleet
  fleet_fanout "$FLEET_RUNNERCTL" upgrade ${fwd[@]+"${fwd[@]}"}
  fleet_upgrade_report "$check" || rc=$?
  fleet_cleanup
  return "$rc"
}

# First capture group of "KEY: <value> (...)" in a host's upgrade output.
# Pad TEXT to WIDTH columns. Not printf '%-*s': that counts BYTES, so a
# 3-byte em dash lands two columns short and shifts the rest of the row —
# the same trap GHR-21 fixed in status_row. ${#v} counts characters, which
# is what a terminal actually renders.
fleet_pad() { # WIDTH TEXT
  local pad=""
  [ "${#2}" -ge "$1" ] || printf -v pad '%*s' $(( $1 - ${#2} )) ''
  printf '%s%s' "$2" "$pad"
}

fleet_upgrade_field() { # INDEX KEY
  sed -n "s/^$2: \([^ ]*\).*/\1/p" "$FLEET_DIR/$1.out" 2>/dev/null | head -1
}

# One row per host, then a count. The state word comes from the verdict line
# `upgrade` already prints rather than from comparing versions here: the
# remote is the only thing that knows whether it actually wrote the file, and
# re-deriving that locally would be a second implementation to keep in step.
fleet_upgrade_report() { # CHECK
  local check="$1" i host rc cur avail state vers
  local level=0 changed=0 bad=0
  # Three parallel arrays rather than one delimited string per row: a state
  # word carrying the delimiter would otherwise split a row in half, and the
  # states include remote text this code does not control.
  local -a r_host=() r_vers=() r_state=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    if [ "$rc" != 0 ]; then
      bad=$((bad + 1))
      r_host+=("$host"); r_vers+=("—")
      r_state+=("$(fleet_error_text "$rc" "$FLEET_DIR/$i.err")")
      continue
    fi
    cur="$(fleet_upgrade_field "$i" installed)"
    avail="$(fleet_upgrade_field "$i" available)"
    if grep -q '^Upgraded ' "$FLEET_DIR/$i.out"; then
      state="upgraded"; changed=$((changed + 1))
    elif grep -q '^Update available\.' "$FLEET_DIR/$i.out"; then
      state="update available"; changed=$((changed + 1))
    elif grep -q '^Already up to date\.' "$FLEET_DIR/$i.out"; then
      state="up to date"; level=$((level + 1))
    elif grep -q 'not downgrading' "$FLEET_DIR/$i.out"; then
      state="ahead of the source — left alone"; level=$((level + 1))
    else
      # An answer this does not recognise is shown, not guessed at: a silent
      # "up to date" for a host that said something else is the one outcome
      # that would send someone to the wrong box.
      state="unrecognised: $(tail -1 "$FLEET_DIR/$i.out" 2>/dev/null || true)"
      bad=$((bad + 1))
    fi
    if [ -n "$cur" ] && [ -n "$avail" ] && [ "$cur" != "$avail" ]; then
      vers="$cur -> $avail"
    else
      vers="${cur:-?}"
    fi
    r_host+=("$host"); r_vers+=("$vers"); r_state+=("$state")
  done
  local hostw=4 versw=7
  for host in "${FLEET_HOSTS[@]}"; do
    [ "${#host}" -le "$hostw" ] || hostw="${#host}"
  done
  for i in "${!r_vers[@]}"; do
    [ "${#r_vers[$i]}" -le "$versw" ] || versw="${#r_vers[$i]}"
  done
  for i in "${!r_host[@]}"; do
    printf '%s %s %s\n' "$(fleet_pad "$hostw" "${r_host[$i]}")" \
      "$(fleet_pad "$versw" "${r_vers[$i]}")" "${r_state[$i]}"
  done
  if $check; then
    echo "${#FLEET_HOSTS[@]} host(s): $level up to date, $changed would change, $bad unreachable or unclear"
  else
    echo "${#FLEET_HOSTS[@]} host(s): $level already level, $changed upgraded, $bad unreachable or unclear"
  fi
  [ "$bad" -eq 0 ]
}

# `fleet health`: one exit code for the whole fleet, so a central node needs
# one cron entry and one push URL instead of one per runner host.
#
# Exit 0 only when every host was reached AND reported healthy. A HOST THAT
# DID NOT ANSWER IS A PROBLEM, never a silent pass — a monitor that goes
# green because a host dropped out of the fan-out is worse than no monitor,
# and that is the single assertion this command exists to make true.
cmd_fleet_health() { # [--quiet] [--max-restarts N] [--stall-after N] [--restart-stalled]
  local quiet=false rc=0
  local -a fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      # --quiet is LOCAL only and deliberately not forwarded: the remote's
      # stdout is where the problem lines come from, so a quiet remote would
      # leave this command with an exit code and nothing to report.
      --quiet)
        quiet=true; shift ;;
      --max-restarts)
        need_val "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--max-restarts value '$2' is invalid — want an integer"
        fwd+=(--max-restarts "$2"); shift 2 ;;
      --stall-after)
        need_val "$@"
        # Validated here as well as on each host so a typo fails once, before
        # anything is dialled, rather than N times after N connections.
        [[ "$2" =~ ^[0-9]+$ ]] || die "--stall-after value '$2' is invalid — want a whole number of seconds"
        fwd+=(--stall-after "$2"); shift 2 ;;
      --restart-stalled)
        fwd+=(--restart-stalled); shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  require_fleet
  fleet_fanout "$FLEET_RUNNERCTL" health ${fwd[@]+"${fwd[@]}"}
  fleet_health_report "$quiet" || rc=$?
  fleet_cleanup
  return "$rc"
}

# Reduce the fan-out to problem lines and one exit code. Each host's own
# output is reused verbatim with the host name prefixed, so the single-host
# format people already read stays intact.
fleet_health_report() { # QUIET
  local quiet="$1" i host rc line slots total=0 counted=true hosts_ok=0
  local -a problems=()
  for i in "${!FLEET_HOSTS[@]}"; do
    host="${FLEET_HOSTS[$i]}"
    rc="$(fleet_rc "$i")"
    case "$rc" in
      0)
        hosts_ok=$((hosts_ok + 1))
        # "ok: N slot(s) healthy" — read the count when it is there, and just
        # stop counting if any host words it differently (an older remote,
        # say) rather than reporting a total that is quietly short.
        line="$(head -1 "$FLEET_DIR/$i.out" 2>/dev/null || true)"
        if [[ "$line" =~ ^ok:\ ([0-9]+)\ slot ]]; then
          slots="${BASH_REMATCH[1]}"; total=$((total + slots))
        else
          counted=false
        fi
        ;;
      1)
        # The host answered and reported problems: its lines, prefixed.
        local before="${#problems[@]}"
        while IFS= read -r line; do
          [ -n "$line" ] || continue
          problems+=("$host: $line")
        done <"$FLEET_DIR/$i.out"
        # Exit 1 with nothing on stdout is a die, not a problem list — a
        # runner-less host says so on stderr. Without this the host would
        # contribute no problem AND no ok, so a fleet of one such host would
        # exit 0 with the failure invisible: the exact hole this command
        # exists to close.
        if [ "${#problems[@]}" -eq "$before" ]; then
          problems+=("$host: $(fleet_error_text "$rc" "$FLEET_DIR/$i.err")")
        fi
        ;;
      *)
        problems+=("$host: $(fleet_error_text "$rc" "$FLEET_DIR/$i.err")")
        ;;
    esac
  done
  if [ "${#problems[@]}" -eq 0 ]; then
    if ! $quiet; then
      if $counted; then
        echo "ok: $total slot(s) healthy across $hosts_ok host(s)"
      else
        echo "ok: $hosts_ok host(s) healthy"
      fi
    fi
    return 0
  fi
  $quiet || printf '%s\n' "${problems[@]}"
  return 1
}

cmd_fleet_status() { # [--json] [--color WHEN]
  local json=false rc=0
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    view_opt "$@"
    if [ "$VIEW_SHIFT" -gt 0 ]; then shift "$VIEW_SHIFT"; continue; fi
    case "$1" in
      --json) json=true; shift ;;
      *)      die "unknown option: $1" ;;
    esac
  done
  require_fleet
  if $json; then
    fleet_fanout "$FLEET_RUNNERCTL" status --json
    fleet_status_json || rc=$?
  else
    color_setup "$COLOR_MODE"
    # --color never on the remote: the fleet renderer paints locally, and a
    # remote SGR sequence would be measured as visible width by the prefix.
    fleet_fanout "$FLEET_RUNNERCTL" status --color never
    fleet_status_table || rc=$?
  fi
  fleet_cleanup
  return "$rc"
}

cmd_profiles() {
  local p
  echo "Config: $CONFIG_FILE$([ -f "$CONFIG_FILE" ] || echo ' (not present — built-ins only)')"
  echo
  printf '%-12s %-9s %-6s %-6s %-8s %-30s %s\n' PROFILE SOURCE MAX HIGH RESTART ENVFILE DESCRIPTION
  for p in $(list_profiles); do
    PROFILE="$p"; PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="10"; ENV_FILE=""  # same defaults as the top of the script
    local src="builtin"; declare -F "profile_$p" >/dev/null && src="config"
    load_profile
    printf '%-12s %-9s %-6s %-6s %-8s %-30s %s\n' \
      "$p$([ "$p" = "$DEFAULT_PROFILE" ] && echo '*')" "$src" "${MEM_MAX:--}" "${MEM_HIGH:--}" \
      "${RESTART_SEC:--}" "${ENV_FILE:--}" "$PROFILE_DESC"
  done
  echo
  echo "* = default profile"
}

# --- Provisioning: making the runner units exist (GHR-45) --------------------
# Everything above this point manages runners that are ALREADY registered, and
# `install` installs THIS SCRIPT — so on a new box every command dead-ended in
# require_runners' refusal and the first step was an undocumented manual loop.
# `provision N` closes that gap: it fetches GitHub's runner release, unpacks a
# copy per slot under $RUNNER_ROOT, registers each with the runner's own
# `config.sh` and lets the runner's own `svc.sh` write the systemd unit. The
# units are therefore exactly the ones the rest of this tool already knows how
# to manage through drop-ins — provision never writes a unit file itself.
#
# It is idempotent against a TARGET COUNT, like `scale`: slots that exist are
# left alone, so `provision 4` on a host with 2 adds two and `provision 2` on
# a host with 4 changes nothing. It never removes a runner: deregistering
# needs a removal token from GitHub and is GHR-46.

valid_user_name() { [[ "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]; }
valid_runner_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_runner_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
valid_runner_url() { [[ "$1" =~ ^https?://[^/]+/[^/]+(/[^/]+)?/?$ ]]; }

# uname -m -> the architecture in GitHub's runner asset names. Refusing here
# beats a 404 on a download URL built from a name GitHub never published.
runner_arch() {
  case "$(uname -m)" in
    x86_64|amd64)       echo x64 ;;
    aarch64|arm64)      echo arm64 ;;
    armv7l|armv7l*|armhf) echo arm ;;
    *) die "unsupported architecture '$(uname -m)' — GitHub publishes Linux runners for x86_64, aarch64 and armv7l only" ;;
  esac
}

# The URL decides which API path mints a token and what GitHub calls the
# scope. Prints "<kind> <api-path>", e.g. "org orgs/acme".
runner_scope() { # URL
  local u="${1%/}" rest
  [[ "$u" =~ ^https?://[^/]+/(.+)$ ]] || die "--url '$1' is not a GitHub URL — want https://github.com/<org>, .../<org>/<repo>, or .../enterprises/<slug>"
  rest="${BASH_REMATCH[1]}"
  case "$rest" in
    enterprises/*/*) die "--url '$1' has too many path segments for an enterprise — want .../enterprises/<slug>" ;;
    enterprises/*)   echo "enterprise enterprises/${rest#enterprises/}" ;;
    */*/*)           die "--url '$1' has too many path segments — want <org> or <org>/<repo>" ;;
    */*)             echo "repo repos/$rest" ;;
    *)               echo "org orgs/$rest" ;;
  esac
}

# Every outbound HTTP call goes through here, so a config can stub the network
# (tests/stub.config does) and so a PAT is handed to curl on STDIN through its
# own config format rather than in argv — anything in argv is readable by any
# user on the box through /proc/<pid>/cmdline. Prints the response body.
http_api() { # METHOD URL [TOKEN]
  local method="$1" url="$2" token="${3:-}" cfg=""
  command -v curl >/dev/null || die "curl is required to talk to $url"
  [ -z "$token" ] || cfg="header = \"Authorization: Bearer $token\""
  printf '%s\n' "$cfg" | curl -fsSL --max-time 30 -K - -X "$method" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$url"
}

# First string value of NAME in the JSON on stdin. The API's objects put one
# field per line, which is all this needs — and all it promises: it is for
# pulling a known scalar out of a known response, not for parsing JSON.
json_field() { # NAME
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# The published SHA-256 of one release asset, from the release JSON in FILE.
# Two sources, in this order (both probed against the live API 2026-09-14, and
# they agreed on the same digest for actions-runner-linux-x64-2.337.0):
#   assets[].digest — "sha256:<hex>", structured metadata, what GitHub
#                     publishes today and the one to trust;
#   the release body — <!-- BEGIN SHA linux-x64 --><hex><!-- END ... -->, the
#                     long-standing marker and the only one on releases that
#                     predate the digest field.
# Empty output means neither was there, which the caller refuses on rather
# than unpacking a tarball it cannot vouch for.
runner_release_sha() { # RELEASE-JSON-FILE ASSET-NAME ARCH
  local json="$1" asset="$2" arch="$3" sha
  sha="$(awk -v n="\"$asset\"" '
      index($0, "\"name\"") && index($0, n) { seen = 1; next }
      seen && index($0, "\"digest\"") {
        if (match($0, /sha256:[0-9a-f]+/)) print substr($0, RSTART + 7, RLENGTH - 7)
        exit
      }' "$json")"
  if [ -z "$sha" ]; then
    sha="$(grep -o "BEGIN SHA linux-$arch -->[0-9a-f]\{64\}" "$json" 2>/dev/null | head -1 | grep -o '[0-9a-f]\{64\}' || true)"
  fi
  printf '%s' "$sha"
}

# Download URL -> DEST. Separate from http_api because it is a large binary
# body with a much longer budget, and because a config stubs this one alone.
runner_fetch_tarball() { # URL DEST
  command -v curl >/dev/null || die "curl is required to download $1"
  curl -fsSL --max-time 600 "$1" -o "$2" || die "download failed: $1"
}

runner_sha256() { # FILE
  command -v sha256sum >/dev/null || die "sha256sum is required to verify the runner tarball (pass --no-verify-checksum to skip, at your own risk)"
  sha256sum "$1" | awk '{print $1}'
}

# Run CMD... from DIR as USER. GitHub's config.sh and svc.sh source ./env.sh
# relative to the WORKING DIRECTORY, so they only work from the runner's own
# directory, and `runuser` has no --chdir of its own (probed, util-linux on
# the dev box) — hence the explicit cd in the shell it starts. Goes through
# run_priv like every other host mutation, so the harness sees it.
runner_exec() { # DIR USER CMD...
  local dir="$1" user="$2"; shift 2
  local as=()
  # run_priv is already root, so becoming root again through runuser would be
  # a dependency and a log line for nothing. Only dropping privilege needs it.
  [ "$user" = root ] || as=(runuser -u "$user" --)
  # SC2016 is the point: the $1/$@ below belong to the inner bash, which gets
  # the directory and the command as its own arguments rather than having them
  # pasted into a string this shell expanded.
  # shellcheck disable=SC2016
  run_priv ${as+"${as[@]}"} bash -c 'cd "$1" || exit 1; shift; exec "$@"' runnerctl "$dir" "$@"
}

# The three questions provision asks the host about accounts and tooling,
# each its own function so a config can answer them without the test box's
# own /etc/passwd or $PATH deciding what the fixture sees.
runner_user_exists() { id -u "$1" >/dev/null 2>&1; }
runner_group_exists() { getent group "$1" >/dev/null 2>&1; }
runner_have_gh() { command -v gh >/dev/null 2>&1; }

# The account the runner runs as. config.sh REFUSES to run as root, and a job
# that can write outside its own tree can rewrite the runner, so a dedicated
# unprivileged user is the default rather than the invoking one.
ensure_runner_user() { # USER GROUP DRY-RUN
  local user="$1" group="$2" dry="$3"
  if runner_user_exists "$user"; then
    echo "  user:    $user (exists)"
    return 0
  fi
  if $dry; then
    echo "  user:    $user (would be created as a system user)"
    return 0
  fi
  if [ -n "$group" ] && ! runner_group_exists "$group"; then
    run_priv groupadd --system "$group" || die "could not create group '$group'"
  fi
  local gopt=()
  [ -z "$group" ] || gopt=(-g "$group")
  # A real shell, not nologin: job steps run through it, and an operator
  # debugging a slot needs to be able to become this user.
  run_priv useradd --system --create-home --shell /bin/bash \
    --comment "GitHub Actions runner (runnerctl)" ${gopt+"${gopt[@]}"} "$user" \
    || die "could not create user '$user'"
  echo "  user:    $user (created)"
}

# A registration token, however the operator supplied the credentials. GitHub
# registration tokens last an hour and register any number of runners, so one
# is minted per RUN, not per slot.
runner_registration_token() { # API-PATH PAT
  local path="$1" pat="$2" body tok
  if [ -n "$pat" ]; then
    body="$(http_api POST "$RUNNER_API_URL/$path/actions/runners/registration-token" "$pat")" \
      || die "could not mint a registration token for $path — check the token's scope (a classic PAT needs 'repo' for a repo runner, 'admin:org' for an org one) and that it has not expired"
    tok="$(printf '%s' "$body" | json_field token)"
    [ -n "$tok" ] || die "the registration-token response for $path carried no token"
    printf '%s' "$tok"
    return 0
  fi
  # gh already holds a login on plenty of boxes; --jq keeps the token off argv.
  runner_have_gh || die "no registration token: pass --token <token from GitHub>, or --pat/\$GITHUB_TOKEN, or log in with the gh CLI"
  tok="$(gh api --method POST "$path/actions/runners/registration-token" --jq .token 2>/dev/null)" \
    || die "gh could not mint a registration token for $path — 'gh auth status' to check the login, or pass --token/--pat"
  [ -n "$tok" ] || die "gh returned no token for $path"
  printf '%s' "$tok"
}

provision_usage() {
  cat <<'PROVISION'
Usage: runnerctl provision N [options]

Installs and registers runner slots until this host has N of them, then hands
over to `scale`/`apply`. Existing slots are left alone; nothing is ever
deregistered (removing a runner from GitHub needs a removal token — GHR-46).

  --url URL              org, repo or enterprise to register against, e.g.
                         https://github.com/acme or https://github.com/acme/app
                         (default: RUNNER_URL from the config file)
  --token TOKEN          a registration token from GitHub (Settings -> Actions
                         -> Runners -> New self-hosted runner). Valid 1 hour,
                         registers any number of runners.
  --pat TOKEN            a PAT to mint the registration token with, instead of
                         pasting one. Defaults to $GITHUB_TOKEN; with neither,
                         the gh CLI's login is used if it is present.
  --labels a,b           extra labels, on top of the ones the runner sets for
                         itself (self-hosted, OS, architecture)
  --runner-group NAME    GitHub runner group to register into (org/enterprise)
  --name-prefix NAME     runner names are <prefix>-<n> (default: the host's
                         short name)
  --runner-user USER     account the runners run as (default: github-runner,
                         created as a system user when missing)
  --runner-root DIR      one directory per slot under here (default:
                         /opt/actions-runner)
  --runner-version X.Y.Z pin the runner release (default: the latest)
  --sha256 SUM           expected SHA-256 of the tarball, instead of the one
                         published with the release
  --no-verify-checksum   install even when no published checksum can be found
  --work DIR             the runner's _work directory, relative to its own
  --replace              re-register a runner name GitHub already knows
  --dry-run              print what would happen; download and change nothing

Every value above except --token/--pat has a config-file default — see
`runnerctl config-example`.
PROVISION
}

cmd_provision() {
  local n="" url="$RUNNER_URL" token="" pat="${GITHUB_TOKEN:-}" labels="$RUNNER_LABELS"
  local root="$RUNNER_ROOT" user="$RUNNER_USER" group="$RUNNER_GROUP"
  local prefix="$RUNNER_NAME_PREFIX" version="$RUNNER_VERSION" work="$RUNNER_WORK"
  local rgroup="$RUNNER_GROUP_NAME" sha_pin="" verify=true dry_run=false replace=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)            provision_usage; return 0 ;;
      --url)                need_val "$@"; url="$2"; shift 2 ;;
      --token)              need_val "$@"; token="$2"; shift 2 ;;
      --pat)                need_val "$@"; pat="$2"; shift 2 ;;
      --labels)             need_val "$@"; labels="$2"; shift 2 ;;
      --runner-group)       need_val "$@"; rgroup="$2"; shift 2 ;;
      --name-prefix)        need_val "$@"; prefix="$2"; shift 2 ;;
      --runner-user)        need_val "$@"; user="$2"; shift 2 ;;
      --runner-root)        need_val "$@"; root="${2%/}"; shift 2 ;;
      --runner-version)     need_val "$@"; version="$2"; shift 2 ;;
      --sha256)             need_val "$@"; sha_pin="$2"; shift 2 ;;
      --no-verify-checksum) verify=false; shift ;;
      --work)               need_val "$@"; work="$2"; shift 2 ;;
      --replace)            replace=true; shift ;;
      --dry-run)            dry_run=true; shift ;;
      -*)                   die "unknown option: $1 ('runnerctl provision --help' lists them)" ;;
      *)                    [ -z "$n" ] || die "unexpected argument: $1"; n="$1"; shift ;;
    esac
  done

  [ -n "$n" ] || die "provision needs N, e.g. 'provision 2 --url https://github.com/<org>'"
  [[ "$n" =~ ^[0-9]+$ ]] || die "N must be an integer"
  # An upper bound because this registers real runners with GitHub: a slipped
  # digit should not be 400 registrations that then have to be removed by hand.
  { [ "$n" -ge 1 ] && [ "$n" -le 64 ]; } || die "N must be 1..64"
  [[ "$work" != /* && -n "$work" ]] || die "--work '$work' is invalid — want a path relative to the runner's own directory"
  [ -z "$sha_pin" ] || [[ "$sha_pin" =~ ^[0-9a-f]{64}$ ]] || die "--sha256 '$sha_pin' is invalid — want 64 lowercase hex characters"
  valid_user_name "$user" || die "--runner-user '$user' is invalid — want a POSIX user name"
  [[ "$root" == /* ]] || die "--runner-root '$root' is invalid — want an absolute path"
  [ -z "$version" ] || valid_runner_version "$version" || die "--runner-version '$version' is invalid — want X.Y.Z"

  local have; have="$(discover | wc -l)"
  echo "Host has $have runner slot(s); target $n."
  if [ "$have" -ge "$n" ]; then
    echo "Nothing to provision. ('scale' enables and disables the slots that exist;"
    echo "removing one from GitHub is not automated — see the note in 'scale'.)"
    return 0
  fi
  local want=$((n - have))

  [ -n "$url" ] || die "no --url and no RUNNER_URL in $CONFIG_FILE — provision needs to know what to register against, e.g. --url https://github.com/<org>"
  valid_runner_url "$url" || die "--url '$url' is invalid — want https://github.com/<org>, .../<org>/<repo> or .../enterprises/<slug>"
  read -r scope_kind scope_path <<<"$(runner_scope "$url")"
  [ -z "$prefix" ] && prefix="$(hostname -s 2>/dev/null || hostname)"
  valid_runner_name "$prefix" || die "runner name prefix '$prefix' is invalid — want letters, digits, dot, dash or underscore (pass --name-prefix)"
  [ -n "$group" ] || group="$user"

  local arch; arch="$(runner_arch)"
  echo "  scope:   $scope_kind — $url"
  echo "  names:   $prefix-<n>, arch $arch"

  # Which indexes to create: the first `want` that are not already a unit or a
  # directory, so a re-run after a half-finished one does not collide.
  mapfile -t units < <(discover)
  local existing_units=" ${units[*]} "
  local -a slots=() ; local i=1
  while [ "${#slots[@]}" -lt "$want" ] && [ "$i" -le 200 ]; do
    local name="$prefix-$i" dir="$root/$prefix-$i"
    if [[ "$existing_units" == *".$name.service "* ]] || { [ -e "$dir" ] && ! $replace; }; then
      i=$((i + 1)); continue
    fi
    slots+=("$i"); i=$((i + 1))
  done
  [ "${#slots[@]}" -eq "$want" ] || die "could not find $want free runner name(s) under prefix '$prefix' — pass --name-prefix, or --replace to reuse an existing directory"
  echo "  new:     $want slot(s) — ${slots[*]/#/$prefix-}"

  # Resolve the release before touching the host, so a bad version or an
  # unreachable API fails with nothing half-created.
  local release_json="" asset sha_want=""
  RELEASE_TMP=""
  if [ -z "$version" ]; then
    release_json="$RUNNER_API_URL/repos/actions/runner/releases/latest"
  else
    release_json="$RUNNER_API_URL/repos/actions/runner/releases/tags/v$version"
  fi
  if $dry_run && [ -n "$version" ] && ! $verify; then
    : # nothing to ask the API for
  else
    RELEASE_TMP="$(mktemp)"
    trap 'rm -f "$RELEASE_TMP"' EXIT
    http_api GET "$release_json" "$pat" >"$RELEASE_TMP" \
      || die "could not read the runner release metadata from $release_json${version:+ (is v$version a real actions/runner release?)} — pass --runner-version and --sha256 to work offline"
    [ -n "$version" ] || version="$(json_field tag_name <"$RELEASE_TMP")"
    version="${version#v}"
    valid_runner_version "$version" || die "the release metadata carried no usable version (got '$version') — pass --runner-version X.Y.Z"
  fi
  asset="actions-runner-linux-$arch-$version.tar.gz"
  local tarball_url="$RUNNER_DOWNLOAD_URL/v$version/$asset"
  echo "  release: $version ($asset)"

  if [ -n "$sha_pin" ]; then
    sha_want="$sha_pin"
  elif [ -n "$RELEASE_TMP" ]; then
    sha_want="$(runner_release_sha "$RELEASE_TMP" "$asset" "$arch")"
  fi
  if [ -z "$sha_want" ]; then
    $verify && die "no published SHA-256 found for $asset — pass --sha256 <hex>, or --no-verify-checksum to install without verifying"
    echo "  sha256:  NOT VERIFIED (--no-verify-checksum)"
  else
    echo "  sha256:  ${sha_want:0:12}… (from the release metadata)"
  fi

  if $dry_run; then
    echo
    echo "(dry run — nothing downloaded, nothing changed)"
    echo "would download: $tarball_url"
    echo "would create:   $user (if missing), $root/$prefix-<n> for n in ${slots[*]}"
    local s
    for s in "${slots[@]}"; do
      echo "would register: $prefix-$s via config.sh --unattended --url $url --token *** --name $prefix-$s${labels:+ --labels $labels}${rgroup:+ --runnergroup $rgroup}"
      echo "would install:  svc.sh install $user   (in $root/$prefix-$s)"
    done
    return 0
  fi

  # Only now, with everything resolved, is a credential needed — a dry run and
  # every refusal above get there without one.
  [ -n "$token" ] || token="$(runner_registration_token "$scope_path" "$pat")"

  ensure_runner_user "$user" "$group" false
  run_priv mkdir -p "$root"

  echo "Downloading $asset…"
  # Its own name, not cmd_install's DOWNLOAD_TMP: that one is a file and this
  # one a directory, and the two traps would disagree about how to clean up.
  PROVISION_TMP="$(mktemp -d)"
  trap 'rm -rf "$PROVISION_TMP"; rm -f "$RELEASE_TMP"' EXIT
  local tarball="$PROVISION_TMP/$asset"
  runner_fetch_tarball "$tarball_url" "$tarball"
  if [ -n "$sha_want" ]; then
    local sha_got; sha_got="$(runner_sha256 "$tarball")"
    [ "$sha_got" = "$sha_want" ] || die "checksum mismatch for $asset — expected $sha_want, got $sha_got. NOT installing."
    echo "  checksum ok"
  fi

  local s name dir made=() failed=()
  for s in "${slots[@]}"; do
    name="$prefix-$s"; dir="$root/$name"
    echo "[$name] unpacking into $dir"
    run_priv mkdir -p "$dir"
    run_priv tar -xzf "$tarball" -C "$dir" || { failed+=("$name"); echo "  [FAILED] unpack"; continue; }
    run_priv chown -R "$user:$group" "$dir"
    echo "[$name] registering with GitHub"
    local cfg_args=(./config.sh --unattended --url "$url" --token "$token" --name "$name" --work "$work")
    [ -z "$labels" ] || cfg_args+=(--labels "$labels")
    [ -z "$rgroup" ] || cfg_args+=(--runnergroup "$rgroup")
    $replace && cfg_args+=(--replace)
    if ! runner_exec "$dir" "$user" "${cfg_args[@]}"; then
      failed+=("$name"); echo "  [FAILED] config.sh — the directory is left in place for inspection"; continue
    fi
    echo "[$name] installing the service"
    if ! runner_exec "$dir" root ./svc.sh install "$user"; then
      failed+=("$name"); echo "  [FAILED] svc.sh install"; continue
    fi
    if ! runner_exec "$dir" root ./svc.sh start; then
      failed+=("$name"); echo "  [FAILED] svc.sh start"; continue
    fi
    made+=("$name")
    echo "  [ok] $name"
  done

  run_priv systemctl daemon-reload
  echo
  if [ "${#made[@]}" -gt 0 ]; then
    echo "Provisioned ${#made[@]} runner(s): ${made[*]}"
    echo "Next:"
    echo "  runnerctl status                     # the new slots should be running"
    echo "  runnerctl scale $n --max 26G --high 25G   # apply a profile and set the pool size"
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    echo "runnerctl: provision: ${#failed[@]} slot(s) failed: ${failed[*]}" >&2
    echo "runnerctl: their directories are left under $root for inspection; re-run provision once fixed." >&2
    exit 1
  fi
}

cmd_config_example() {
  cat <<'EXAMPLE'
# runnerctl config — sourced as bash. Install as /etc/runnerctl/config
# (root-owned, not world-writable) or point RUNNERCTL_CONFIG / --config at it.
#
# Everything here is optional. Site-specific values (memory caps sized for
# your boxes, env-file paths, secret templates) belong here, never in the
# runnerctl script itself.

# Name of the managed drop-in under /etc/systemd/system/<unit>.d/
#DROPIN_NAME="10-runnerctl.conf"

# Profile used when --profile is omitted.
#DEFAULT_PROFILE="ci"

# Where `runnerctl upgrade` fetches the new script from (a fork, a mirror).
#UPGRADE_URL="https://github.com/runnane/runnerctl/releases/latest/download/runnerctl"

# --when-idle / drain: seconds between idle polls, and the default --timeout.
#POLL_SEC="5"
#WAIT_TIMEOUT="1800"

# A job running this many seconds or more is STALLED in status/watch, a
# problem for `health`, "stalled":true in `status --json`, and what
# `restart --if-stalled` / `health --restart-stalled` act on. Default 1 h:
# no job on a build pool legitimately runs that long. Raise it for a pool
# with longer jobs; 0 turns the flag off; --stall-after N overrides per run.
#STALL_SEC="3600"

# `reap`: seconds a leaked process gets after SIGTERM before SIGKILL.
#REAP_GRACE_SEC="5"

# `kill`: seconds the Listener gets to notice its Worker was killed and
# report the job failed, before the whole unit's cgroup is SIGKILLed
# instead. Counted in POLL_SEC steps.
#KILL_GRACE_SEC="10"

# PRESS column (memory pressure, PSI full avg10 in percent): yellow from
# WARN, red and a `health` problem from CRIT.
#PRESSURE_WARN_PCT="10"
#PRESSURE_CRIT_PCT="50"

# Processes matching this ERE are the runner's own and never counted as
# leaked or reaped. Extend it for an image that wraps the runner differently.
#RUNNER_OWN_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.(Listener|Worker|PluginHost)'

# Processes matching this ERE are the Listener side of the runner and are
# never killed by `kill` — everything else in the slot's cgroup is the job.
# Narrower than RUNNER_OWN_PATTERN on purpose: Runner.Worker IS the job.
#RUNNER_LISTENER_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.Listener'

# --- Provisioning -----------------------------------------------------------
# `runnerctl provision N` installs and registers runner slots on a host that
# has none (or tops an existing host up to N). Only RUNNER_URL is really site
# data; the rest have defaults that work unchanged on most boxes.

# The org, repo or enterprise the runners register against. Setting it here
# means `provision N` needs no --url on this host.
#RUNNER_URL="https://github.com/your-org"

# One directory per slot is created under this root, as <prefix>-<n>.
#RUNNER_ROOT="/opt/actions-runner"

# The unprivileged account the runners run as, created as a system user when
# it does not exist. config.sh refuses to run as root, so this is never root.
#RUNNER_USER="github-runner"
#RUNNER_GROUP=""          # empty = a group named after RUNNER_USER

# Runner names are <prefix>-<n>; empty = the host's short name.
#RUNNER_NAME_PREFIX=""

# Extra labels (comma-separated) on top of the ones the runner sets itself.
#RUNNER_LABELS="ci,linux"

# The runner's _work directory, relative to the runner's own directory.
#RUNNER_WORK="_work"

# Runner group to register into. Empty = the account's default group, which
# is the only valid choice for a repo-scoped runner.
#RUNNER_GROUP_NAME=""

# Empty = install the latest release. Pin it on a host that must not move.
#RUNNER_VERSION=""

# Where the release metadata and the tarball come from — change both for a
# mirror or for GitHub Enterprise Server (e.g. https://ghes.example.com/api/v3).
#RUNNER_API_URL="https://api.github.com"
#RUNNER_DOWNLOAD_URL="https://github.com/actions/runner/releases/download"

# --- Fleet mode -------------------------------------------------------------
# `runnerctl fleet status` runs this tool from one central node against
# several runner hosts over ssh. Uncomment FLEET_HOSTS on the central node
# only; the runner hosts themselves need no fleet config, just runnerctl
# installed and an ssh login. Read-only status never asks for sudo, so an
# unprivileged login is enough.
#
# ssh aliases (from ~/.ssh/config) or user@host. This is site data — keep it
# here, never in the runnerctl script.
#FLEET_HOSTS=(build-1 build-2 build-3)

# Extra ssh options, appended after the built-in ones so they can override
# any of them. A polling loop wants connection reuse; a one-shot does not.
#FLEET_SSH_OPTS=(-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p -o ControlPersist=60)

# Most hosts contacted at once, and the per-host seconds budget. The timeout
# is what stops one wedged host holding up the whole fan-out.
#FLEET_PARALLEL="8"
#FLEET_TIMEOUT="30"

# The remote command, for hosts where runnerctl is not on the ssh user's PATH.
#FLEET_RUNNERCTL="runnerctl"

# A profile is a function that sets these variables. Defining profile_ci or
# profile_deploy replaces the built-in of the same name.
profile_ci() {
  PROFILE_DESC="CI build/test pool — memory-capped, auto-restart."
  MEM_MAX="26G"        # hard cap per slot (MemoryMax)
  MEM_HIGH="25G"       # soft throttle point (MemoryHigh) — keep it close to
                       # the cap: memory.high throttles rather than kills, and
                       # a build crawling there for hours looks STALLED
  RESTART_SEC="10"
  ENV_FILE=""          # no EnvironmentFile for CI slots
}

profile_deploy() {
  PROFILE_DESC="Prod deploy runner — on-device secrets, uncapped, auto-restart."
  MEM_MAX=""; MEM_HIGH=""
  RESTART_SEC="15"
  ENV_FILE="/etc/runnerctl/deploy.env"
  # Optional: a file to copy as the env-init template instead of the
  # env_template_deploy function below.
  #ENV_TEMPLATE="/etc/runnerctl/deploy.env.example"
}

# Placeholder template written by `runnerctl env-init --profile deploy`.
# PLACEHOLDERS ONLY — the live file is filled in on the box and never committed.
env_template_deploy() {
  cat <<'TEMPLATE'
# deploy runner — on-device secrets/config. Root-owned, chmod 600, never committed.

# --- Registry / release publish ------------------------------------------
GHCR_USERNAME=
GHCR_TOKEN=
NPM_TOKEN=

# --- Target hosts (SSH aliases or docker contexts) ------------------------
APP_SSH_HOST=
APP_DIR=/opt/myapp

# --- Optional: notifications ----------------------------------------------
DEPLOY_SLACK_WEBHOOK_URL=
TEMPLATE
}
EXAMPLE
}

# --- Migration from a pre-config runnerctl ------------------------------------
# The predecessor of this script carried the site values inline: DROPIN_NAME
# and UNIT_GLOB as top-level assignments, PROFILE="<default>", a load_profile()
# whose case block set PROFILE_DESC/MEM_MAX/MEM_HIGH/RESTART_SEC/ENV_FILE per
# profile, and one render_env_template() heredoc. It has no RUNNERCTL_VERSION,
# which is how it is recognised. `migrate` lifts those values into a config
# file, reconciles them against the drop-ins actually on the host (live wins,
# every difference is reported), then proves the config renders each live
# drop-in back byte-for-byte (comments aside).

# --from is sourced, so refuse anything that is not recognisably a runnerctl
# script before it gets that far (a README passed by mistake would run).
looks_like_runnerctl() {
  head -1 "$1" | grep -qE '^#!.*bash' && grep -q '^load_profile()' "$1" && grep -q '^render_dropin()' "$1"
}
is_legacy_script() { ! grep -q '^RUNNERCTL_VERSION=' "$1"; }

# Source the old script minus its trailing `main "$@"` in a subshell — its
# functions shadow ours only there — and dump what it defines, one record per
# line, fields separated by \037 (a tab would collapse empty fields in read).
legacy_dump() {
  local stripped; stripped="$(mktemp)"
  grep -vxE 'main "\$@"' "$1" >"$stripped"
  (
    set +e
    # shellcheck disable=SC1090  # the path is only known at runtime, same as the config
    . "$stripped" >/dev/null 2>&1 || exit 0
    set +eu  # the old script turned -e back on; from here every failure is a partial dump, not an exit
    declare -F load_profile >/dev/null || exit 0
    printf 'DEFAULT_PROFILE\037%s\n' "${PROFILE:-}"
    printf 'DROPIN_NAME\037%s\n' "${DROPIN_NAME:-}"
    printf 'UNIT_GLOB\037%s\n' "${UNIT_GLOB:-}"
    # bash reprints the function normalised, so the case labels are always
    # `        name)` on their own line whatever the source formatting was.
    local p
    for p in $(declare -f load_profile | grep -E '^[[:space:]]+[A-Za-z0-9_]+\)$' | tr -d ' )'); do
      PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC=""; ENV_FILE=""
      PROFILE="$p"; load_profile
      printf 'PROFILE\037%s\037%s\037%s\037%s\037%s\037%s\n' \
        "$p" "$PROFILE_DESC" "$MEM_MAX" "$MEM_HIGH" "$RESTART_SEC" "$ENV_FILE"
    done
    if declare -F render_env_template >/dev/null; then
      echo "TEMPLATE_BEGIN"; render_env_template; echo "TEMPLATE_END"
    fi
  )
  rm -f "$stripped"
}

sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; } # single-quote a value for a sourced file

# True when writing PATH (creating missing parents) needs root: the nearest
# existing ancestor decides, so a not-yet-created directory under one the
# caller owns does not escalate to sudo.
needs_priv() {
  local p="$1"
  while [ ! -e "$p" ]; do p="$(dirname "$p")"; done
  [ ! -w "$p" ]
}
strip_ini() { grep -vE '^[[:space:]]*(#|$)' "$@" || true; } # drop comments and blank lines

# Parse one live drop-in into LIVE_* for the caller.
read_dropin() {
  local f="$1" line
  LIVE_PROFILE=""; LIVE_MAX=""; LIVE_HIGH=""; LIVE_RS=""; LIVE_ENV=""
  while IFS= read -r line; do
    case "$line" in
      '#'*'(profile: '*')'*) LIVE_PROFILE="${line#*\(profile: }"; LIVE_PROFILE="${LIVE_PROFILE%%)*}" ;;
      MemoryMax=*)        LIVE_MAX="${line#*=}" ;;
      MemoryHigh=*)       LIVE_HIGH="${line#*=}" ;;
      RestartSec=*)       LIVE_RS="${line#*=}" ;;
      EnvironmentFile=*)  LIVE_ENV="${line#*=}" ;;
    esac
  done <"$f"
}

cmd_migrate() {
  local from="" out="" dry_run=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)    [ $# -ge 2 ] || die "--from needs a path"; from="$2"; shift 2 ;;
      --output)  [ $# -ge 2 ] || die "--output needs a path"; out="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  if [ -z "$from" ]; then
    from="$(command -v runnerctl || true)"
    [ -n "$from" ] || die "no installed runnerctl found — pass --from PATH"
  fi
  [ -f "$from" ] || die "$from: no such file"
  looks_like_runnerctl "$from" || die "$from does not look like a runnerctl script (no bash shebang / load_profile / render_dropin) — refusing to source it"
  is_legacy_script "$from" \
    || die "$from is not a pre-config runnerctl (it carries $(grep -m1 '^RUNNERCTL_VERSION=' "$from")) — nothing to migrate"
  [ -n "$out" ] || out="$CONFIG_FILE"

  # 1. What the old script says.
  declare -A DESC MAX HIGH RS ENV
  local profiles=() l_default="" l_dropin="" l_glob="" template="" in_tpl=false line
  local k v1 v2 v3 v4 v5 v6
  while IFS= read -r line; do
    if $in_tpl; then
      [ "$line" = "TEMPLATE_END" ] && { in_tpl=false; continue; }
      template+="$line"$'\n'; continue
    fi
    IFS=$'\037' read -r k v1 v2 v3 v4 v5 v6 <<<"$line"
    case "$k" in
      DEFAULT_PROFILE) l_default="$v1" ;;
      DROPIN_NAME)     l_dropin="$v1" ;;
      UNIT_GLOB)       l_glob="$v1" ;;
      PROFILE) profiles+=("$v1"); DESC[$v1]="$v2"; MAX[$v1]="$v3"; HIGH[$v1]="$v4"; RS[$v1]="$v5"; ENV[$v1]="$v6" ;;
      TEMPLATE_BEGIN)  in_tpl=true ;;
    esac
  done < <(legacy_dump "$from")
  [ "${#profiles[@]}" -gt 0 ] || die "could not extract any profile from $from (no load_profile() case block?)"
  [ -n "$l_dropin" ] || die "could not extract DROPIN_NAME from $from"
  echo "Read $from: profiles ${profiles[*]}; drop-in $l_dropin; default profile ${l_default:-?}"

  # 2. What the host is actually running. Live values win; every difference
  #    is reported. Units are remembered for the render check at the end.
  local units=() live_units=() u f d p key n_live=0
  declare -A LIVE_FILE LIVE_PROF RECONCILED
  mapfile -t units < <(discover)
  if [ "${#units[@]}" -eq 0 ]; then
    echo "No '$UNIT_GLOB' units on this host — config comes from the script alone; live check skipped."
  fi
  for u in "${units[@]}"; do
    d="$SYSTEMD_DIR/$u.d"; f="$d/$l_dropin"
    if [ ! -e "$f" ]; then echo "  $u: no managed drop-in ($f) — unmanaged slot, skipped"; continue; fi
    if [ ! -r "$f" ]; then echo "  $u: $f not readable — run as root to reconcile it; skipped"; continue; fi
    read_dropin "$f"
    if [ -z "$LIVE_PROFILE" ]; then echo "  $u: $f names no profile in its header — skipped"; continue; fi
    p="$LIVE_PROFILE"
    if [ -z "${DESC[$p]+x}" ]; then
      echo "  $u: drop-in profile '$p' is not in the script — adding it from the live values"
      profiles+=("$p"); DESC[$p]="(recovered from $f)"; MAX[$p]="$LIVE_MAX"; HIGH[$p]="$LIVE_HIGH"; RS[$p]="$LIVE_RS"; ENV[$p]="$LIVE_ENV"
    fi
    for key in MAX HIGH RS ENV; do
      local want live
      case "$key" in
        MAX)  want="${MAX[$p]}";  live="$LIVE_MAX" ;;
        HIGH) want="${HIGH[$p]}"; live="$LIVE_HIGH" ;;
        RS)   want="${RS[$p]}";   live="$LIVE_RS" ;;
        ENV)  want="${ENV[$p]}";  live="$LIVE_ENV" ;;
      esac
      [ "$want" = "$live" ] && continue
      if [ -n "${RECONCILED[$p.$key]+x}" ]; then
        echo "  $u: profile '$p' $key is '$live' here but '$want' on ${RECONCILED[$p.$key]} — cannot be one profile; re-apply after migrating"
        continue
      fi
      echo "  $u: profile '$p' $key: script says '${want:-<empty>}', live drop-in says '${live:-<empty>}' — taking the live value"
      case "$key" in MAX) MAX[$p]="$live" ;; HIGH) HIGH[$p]="$live" ;; RS) RS[$p]="$live" ;; ENV) ENV[$p]="$live" ;; esac
      RECONCILED[$p.$key]="$u"
    done
    # Anything else in the .d/ that sets the same keys would fight the managed
    # drop-in — later-sorted wins in systemd, silently.
    local other
    for other in "$d"/*.conf; do
      [ -e "$other" ] || continue
      [ "$other" != "$f" ] || continue
      if grep -qE '^(MemoryMax|MemoryHigh|RestartSec|EnvironmentFile|Restart)=' "$other" 2>/dev/null; then
        echo "  $u: WARNING: $(basename "$other") also sets memory/restart keys — it will override $l_dropin if it sorts later"
      fi
    done
    live_units+=("$u"); LIVE_FILE[$u]="$f"; LIVE_PROF[$u]="$p"; n_live=$((n_live+1))
  done

  # 3. Render the config.
  local tpl_delim="RUNNERCTL_ENV_TEMPLATE"
  case "$template" in *"$tpl_delim"*) die "env template contains the heredoc delimiter '$tpl_delim'" ;; esac
  local cfg
  cfg="$(
    echo "# runnerctl config — generated by \`runnerctl migrate\` from $from on $(date +%F)."
    echo "# Sourced as bash: keep it root-owned and not world-writable. Hand-edits are"
    echo "# expected; \`runnerctl config-example\` documents every knob."
    echo "# Values were lifted from the inline profiles of the pre-config runnerctl and"
    echo "# reconciled against the drop-ins live on this host at migration time."
    echo
    echo "# The old script managed this drop-in name; keeping it means the new script"
    echo "# keeps managing the same file instead of adding a second one beside it."
    echo "DROPIN_NAME=$(sq "$l_dropin")"
    [ -z "$l_default" ] || [ "$l_default" = "$BUILTIN_DEFAULT_PROFILE" ] || echo "DEFAULT_PROFILE=$(sq "$l_default")"
    [ -z "$l_glob" ] || [ "$l_glob" = "$BUILTIN_UNIT_GLOB" ] || echo "UNIT_GLOB=$(sq "$l_glob")"
    for p in "${profiles[@]}"; do
      echo
      echo "profile_$p() {"
      echo "  PROFILE_DESC=$(sq "${DESC[$p]}")"
      echo "  MEM_MAX=$(sq "${MAX[$p]}")"
      echo "  MEM_HIGH=$(sq "${HIGH[$p]}")"
      echo "  RESTART_SEC=$(sq "${RS[$p]}")"
      echo "  ENV_FILE=$(sq "${ENV[$p]}")"
      echo "}"
    done
    if [ -n "$template" ]; then
      for p in "${profiles[@]}"; do
        [ -n "${ENV[$p]}" ] || continue
        echo
        echo "# env-init template for '$p' (placeholders only; the live file stays on the box)."
        echo "env_template_$p() {"
        echo "  cat <<'$tpl_delim'"
        printf '%s' "$template"
        echo "$tpl_delim"
        echo "}"
      done
    fi
  )"

  # 4. Write it (or show it).
  local written
  if $dry_run; then
    written="$(mktemp)"; printf '%s\n' "$cfg" >"$written"
    echo; printf '%s\n' "$cfg"; echo
    echo "(dry run — nothing written; would go to $out)"
  else
    if [ -e "$out" ]; then
      echo "$out already exists — not overwriting it; writing $out.migrated instead"
      out="$out.migrated"
    fi
    local priv=()
    ! needs_priv "$out" || priv=(run_priv)
    "${priv[@]}" mkdir -p "$(dirname "$out")"
    printf '%s\n' "$cfg" | "${priv[@]}" tee "$out" >/dev/null
    [ "${#priv[@]}" -eq 0 ] || run_priv chown root:root "$out"
    "${priv[@]}" chmod 644 "$out"
    written="$out"
    echo "Wrote $out"
    case "$out" in *.migrated) echo; diff -u "${out%.migrated}" "$out" || true ;; esac
  fi

  # 5. Prove it: the generated config must render every live drop-in back.
  if [ "$n_live" -eq 0 ]; then
    echo "No live drop-ins to check against."
  else
    local bad=0 a b
    a="$(mktemp)"; b="$(mktemp)"
    for u in "${live_units[@]}"; do
      # Keys this renderer writes that the pre-config script never did
      # (OOMPolicy, MemorySwapMax — GHR-28) are dropped from the generated
      # side: a legacy drop-in cannot carry them, and the check is about
      # the profile VALUES having migrated. The next `apply` writes them.
      (
        # shellcheck disable=SC1090  # the file we just wrote
        . "$written"
        PROFILE="${LIVE_PROF[$u]}"; PROFILE_DESC=""; MEM_MAX=""; MEM_HIGH=""; RESTART_SEC="10"; ENV_FILE=""
        load_profile; render_dropin
      ) | strip_ini | grep -vE '^(OOMPolicy|MemorySwapMax)=' >"$a" || true
      strip_ini "${LIVE_FILE[$u]}" >"$b"
      if ! cmp -s "$a" "$b"; then
        bad=$((bad+1))
        echo "  $u: generated config does NOT reproduce ${LIVE_FILE[$u]}:"
        diff "$b" "$a" | sed 's/^/    /' || true
      fi
    done
    rm -f "$a" "$b"
    [ "$bad" -eq 0 ] || { $dry_run && rm -f "$written"; die "$bad unit(s) differ — fix the profile in $out (or re-apply after migrating) and re-check"; }
    echo "verified: $n_live unit(s) render identically from the generated config"
    echo "(the next 'runnerctl apply' also adds OOMPolicy=continue and MemorySwapMax=0 to each drop-in)"
  fi
  $dry_run && rm -f "$written"
  $dry_run || echo "Next: runnerctl --config $out profiles   # then install the new runnerctl and run: runnerctl status"
}

# --- Install / self-upgrade ---------------------------------------------------
# Both fetch the script from UPGRADE_URL (optionally a specific branch/tag),
# verify it parses and carries a version, and put it in place by staged copy +
# rename, so a running copy keeps its old inode and is unaffected mid-execution.
# `upgrade` replaces the file it is running from; `install` also works when
# the script is being read from a pipe (curl … | bash -s -- install), finds or
# creates the install location, and migrates a pre-config install first.
remote_version() { grep -m1 '^RUNNERCTL_VERSION=' "$1" | cut -d'"' -f2; }

# True when bash is reading this script from stdin rather than a file. Inside
# a function BASH_SOURCE[0] is then "main" (bash 5.2) or "bash" (5.3), and $0
# is "bash" in both; a real file gives its path in both.
is_piped() {
  case "${BASH_SOURCE[0]:-}" in ''|main|bash) return 0 ;; esac
  [ "$0" = "bash" ] || [ "$0" = "-bash" ] || [ "$0" = "sh" ]
}

# a < b in version order
version_lt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ]; }

# UPGRADE_URL with REF applied (empty REF: as is). Two UPGRADE_URL shapes:
#   github.com/<owner>/<repo>/releases/...  a version-shaped REF (vX.Y.Z or
#     X.Y.Z, normalised to a leading v) maps to that release's asset; any
#     other REF (a branch or a commit) maps to the raw URL at that ref, so
#     people tracking `main` still can.
#   raw.githubusercontent.com/<owner>/<repo>/<ref>/...  REF replaces the ref
#     segment (today's behaviour, unchanged).
# Anything else with a REF dies naming both accepted shapes.
resolve_url() {
  local ref="$1" url="$UPGRADE_URL"
  [ -n "$ref" ] || { echo "$url"; return; }
  if [[ "$url" =~ ^https://github\.com/([^/]+)/([^/]+)/releases/ ]]; then
    local owner="${BASH_REMATCH[1]}" repo="${BASH_REMATCH[2]}"
    if [[ "$ref" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      local ver="$ref"; [[ "$ver" == v* ]] || ver="v$ver"
      url="https://github.com/${owner}/${repo}/releases/download/${ver}/runnerctl"
    else
      url="https://raw.githubusercontent.com/${owner}/${repo}/${ref}/runnerctl"
    fi
  elif [[ "$url" =~ ^(https://raw\.githubusercontent\.com/[^/]+/[^/]+/)[^/]+(/.*)$ ]]; then
    url="${BASH_REMATCH[1]}${ref}${BASH_REMATCH[2]}"
  else
    die "--ref only works with a github.com/<owner>/<repo>/releases/... or raw.githubusercontent.com UPGRADE_URL (have: $url)"
  fi
  echo "$url"
}

# Download URL to DEST and refuse anything that does not parse or has no version.
fetch_script() {
  command -v curl >/dev/null || die "curl is required to download from $1"
  curl -fsSL --max-time 30 "$1" -o "$2" || die "download failed: $1"
  bash -n "$2" || die "downloaded script does not parse — not installing"
  [ -n "$(remote_version "$2")" ] || die "downloaded file carries no RUNNERCTL_VERSION — not installing"
}

# Put SRC at DEST atomically, readable and executable by everyone: a runnerctl
# only root can run is the same as no runnerctl at all. An existing DEST keeps
# its owner and any extra bits it carries, widened to a+rx; a new one is
# root:root 755 when it took sudo to write, 755 otherwise.
#
# The mode is always an explicit octal, never `chmod +x` (GHR-47). A symbolic
# mode with no "who" is masked by the umask, so `chmod +x` is a+x *minus the
# umask* — and the bytes being staged are a mktemp download, mode 0600, which
# `cp` carries over. Under root's umask that landed 0700 (umask 077) or 0711
# (umask 022), and 0711 is broken too: running a #! script needs read as well
# as execute, so the invoking user got "Permission denied" either way while
# the install's own `"$target" version` proof passed as root.
install_file() {
  local src="$1" dest="$2" dir staged mode=755
  dir="$(dirname "$dest")"; staged="$dir/.$(basename "$dest").new.$$"
  local priv=()
  { [ -w "$dir" ] && { [ ! -e "$dest" ] || [ -w "$dest" ]; }; } || priv=(run_priv)
  "${priv[@]}" cp "$src" "$staged"
  if [ -e "$dest" ]; then
    "${priv[@]}" chown --reference="$dest" "$staged"
    # Keep what the admin set — setuid bits, a wider group — but never less
    # than a+rx, so a host already installed at 0700 heals on the next run
    # instead of staying unrunnable.
    mode="$(stat -c '%a' "$dest" 2>/dev/null || echo 755)"
    [[ "$mode" =~ ^[0-7]+$ ]] || mode=755
    mode="$(printf '%04o' "$(( 8#$mode | 8#0555 ))")"
  else
    [ "${#priv[@]}" -eq 0 ] || run_priv chown root:root "$staged"
  fi
  "${priv[@]}" chmod "$mode" "$staged"
  "${priv[@]}" mv -f "$staged" "$dest"
}

# --- Where an upgrade should land (GHR-52) ------------------------------------
# `upgrade` used to rewrite $self and nothing else, which heals the VERSION and
# never the PLACEMENT. A runnerctl in ~/.local/bin then gets upgraded forever
# inside a directory no non-interactive ssh can see: `fleet` reports `remote
# exit 127` for a host whose owner can type `runnerctl` all day and see it
# work. Three hosts of four were in exactly that state (GHR-51), and nothing
# in the tool was ever going to say so.
#
# So upgrade picks a target the way install does. The privilege rule is the
# conservative half: it does whatever part of the heal costs no password, and
# NAMES the rest. Never a prompt — `fleet upgrade` fans this out, and a sudo
# prompt would hang the fan-out once per host, which is precisely the failure
# BatchMode=yes exists to prevent on the ssh side.

# The invoking user's home — $SUDO_USER's when set, which is the same rule
# find_home_runnerctl uses, so install and upgrade always agree on whose home
# is in question.
invoking_home() {
  if [ -n "${SUDO_USER:-}" ]; then
    getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true
  else
    printf '%s\n' "${HOME:-}"
  fi
}

# Is PATH inside that home? A resolved PREFIX test, never a glob: a home of
# /home/jon must not swallow /home/jonathan/bin/runnerctl, and the trailing
# slash is what stops it.
under_home() { # PATH
  local rp hp
  hp="$(invoking_home)"
  [ -n "$hp" ] || return 1
  rp="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
  hp="$(readlink -f "$hp" 2>/dev/null || printf '%s' "$hp")"
  [ -n "$hp" ] || return 1
  [ "${rp#"$hp"/}" != "$rp" ]
}

# Can a file be placed at PATH without asking a human for anything? Writable
# already, or root, or sudo is configured passwordless. `sudo -n` is the whole
# point: it fails fast instead of prompting.
priv_is_free() { # DEST
  # Exactly the two conditions install_file itself checks, because a DEST whose
  # file is writable inside a directory that is NOT still cannot be replaced:
  # install_file stages `$dir/.runnerctl.new.$$` first. Testing the file alone
  # said "free", then the staging copy hit sudo anyway.
  #
  # needs_priv walks up to the nearest existing ancestor, so a prefix that does
  # not exist yet is judged by the directory that will come to hold it.
  if ! needs_priv "$(dirname "$1")" && { [ ! -e "$1" ] || [ -w "$1" ]; }; then
    return 0
  fi
  [ "$(id -u)" -ne 0 ] || return 0
  sudo -n true 2>/dev/null
}

cmd_upgrade() {
  local check=false ref="" prefix="" relocate=true
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    case "$1" in
      --check)       check=true; shift ;;
      --ref)         need_val "$@"; ref="$2"; shift 2 ;;
      # Where a home copy is moved TO. Mirrors install's flag, and is what
      # makes any of this testable without writing to a real /usr/local/bin.
      --prefix)      need_val "$@"; prefix="${2%/}"; shift 2 ;;
      # For a deliberately personal copy: upgrade exactly where it stands.
      --no-relocate) relocate=false; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local self url new_ver sys sys_ver=""
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  [ -n "$prefix" ] || prefix="/usr/local/bin"
  sys="$prefix/runnerctl"
  url="$(resolve_url "$ref")"
  DOWNLOAD_TMP="$(mktemp)"; trap 'rm -f "$DOWNLOAD_TMP"' EXIT
  fetch_script "$url" "$DOWNLOAD_TMP"
  new_ver="$(remote_version "$DOWNLOAD_TMP")"

  # --- placement -------------------------------------------------------------
  # target  = the file to write, empty when this call must not write one
  # cur_*   = what the fleet runs TODAY, which is not $self once $self is a
  #           shadowed home copy — and it is cur_ver the version gates compare
  # retire  = the home copy to rename out of the way, empty to leave it
  local homecopy=false
  if $relocate && [ "$self" != "$sys" ] && under_home "$self"; then homecopy=true; fi
  if $homecopy && [ -e "$sys" ] && looks_like_runnerctl "$sys"; then
    sys_ver="$(remote_version "$sys")"
  fi
  local target="$self" cur_ver="$RUNNERCTL_VERSION" cur_path="$self" retire="" note=""
  if $homecopy; then
    if priv_is_free "$sys"; then
      target="$sys"; retire="$self.retired"
      if [ -n "$sys_ver" ]; then
        cur_ver="$sys_ver"; cur_path="$sys"
        note="note: $sys (runnerctl $sys_ver) is shadowed by this copy — you type one and 'fleet' runs the other"
      else
        note="note: this copy is not on the PATH a non-interactive ssh gets, so 'fleet' cannot run it"
      fi
    elif [ -n "$sys_ver" ] && ! version_lt "$sys_ver" "$RUNNERCTL_VERSION"; then
      # $sys cannot be written without a password, but it already holds a
      # runnerctl at least as new as this one — so retiring the shadow on its
      # own is a strict improvement and costs no privilege at all. Never
      # retire a shadow over an OLDER $sys: that would quietly downgrade what
      # the user gets when they type `runnerctl`.
      target=""; cur_ver="$sys_ver"; cur_path="$sys"; retire="$self.retired"
      note="note: $sys (runnerctl $sys_ver) is shadowed by this copy — retiring this one; run 'sudo runnerctl upgrade' to move $sys on"
    else
      note="note: this copy is not on the PATH a non-interactive ssh gets, so 'fleet' cannot run it. To move it: sudo runnerctl install"
    fi
  fi

  echo "installed: $cur_ver ($cur_path)"
  echo "available: $new_ver ($url)"
  [ -z "$note" ] || echo "$note"

  # These four sentences are a PARSED CONTRACT, not prose: fleet_upgrade_report
  # greps ^Upgraded, ^Already up to date\. (with the period), ^Update
  # available\. and `not downgrading`, and counts anything it cannot classify
  # as a failed host. Every line this function added above is additive and on
  # its own line for exactly that reason. Do not reword them.
  # "same" is about the VERSION, so it compares against the file that holds
  # cur_ver today ($cur_path) — never against $target, which does not exist yet
  # when this call is relocating. Getting that backwards reports
  # "Upgraded 0.10.3 -> 0.10.3" for a host whose only real problem was where
  # the file lived.
  local same=false
  if [ "$new_ver" = "$cur_ver" ] && cmp -s "$DOWNLOAD_TMP" "$cur_path" 2>/dev/null; then
    same=true
  fi
  if $same && [ -z "$retire" ]; then
    echo "Already up to date."; return 0
  fi
  if [ -z "$ref" ] && version_lt "$new_ver" "$cur_ver"; then
    echo "Remote is older than installed — not downgrading (pass --ref to force a specific version)."
    return 0
  fi
  if $check; then
    if [ -n "$retire" ]; then
      if [ -n "$target" ] && [ "$target" != "$self" ] && [ -z "$sys_ver" ]; then
        echo "would relocate: $self -> $target"
      fi
      echo "would retire: $retire"
    fi
    if $same; then echo "Already up to date."; else echo "Update available. Run: runnerctl upgrade"; fi
    return 0
  fi
  # Gated on what $target actually holds, NOT on $same: a relocation must place
  # the file even when the version is unchanged, because the version was never
  # the problem — a same-version copy in ~/.local/bin is exactly the host the
  # fan-out cannot reach.
  if [ -n "$target" ] && ! cmp -s "$DOWNLOAD_TMP" "$target" 2>/dev/null; then
    # Same explicit mode as install, and for the same reason (GHR-47): under
    # root's umask 077 a freshly created prefix is 0700 and nobody but root
    # can traverse it to reach the binary.
    local tdir priv=()
    # $target's OWN directory, never $prefix: with --no-relocate (or any
    # in-place upgrade) $target is $self and $prefix is merely the default
    # that was not used, so creating it would conjure an empty /usr/local/bin
    # on a host that had deliberately opted out.
    tdir="$(dirname "$target")"
    ! needs_priv "$tdir" || priv=(run_priv)
    [ -d "$tdir" ] || "${priv[@]}" mkdir -p -m 755 "$tdir"
    install_file "$DOWNLOAD_TMP" "$target"
  fi
  if [ -n "$retire" ]; then
    # Renaming the script that is currently running is safe: the rename keeps
    # the inode, and bash is reading it through an open descriptor.
    mv -f "$self" "$retire"
    if [ -n "$target" ] && [ "$target" != "$self" ] && [ -z "$sys_ver" ]; then
      echo "relocated: $self -> $target"
    fi
    echo "retired: $retire"
  fi
  if $same; then
    echo "Already up to date."
  elif [ -z "$target" ]; then
    # Retire-only: the shadow is gone, but $sys still needs a privileged write
    # and this call never made one. Claiming an upgrade here would be a plain
    # false report of work that did not happen.
    echo "Update available. Run: sudo runnerctl upgrade"
  else
    echo "Upgraded $cur_ver -> $new_ver at $target"
  fi
}

# Under sudo PATH is secure_path, so a runnerctl the invoking user runs from
# ~/.local/bin or ~/bin is invisible to command -v — the usual shape of a
# pre-config install. Look in those two directories of $SUDO_USER's home (of
# $HOME without sudo) and set HOME_COPY / HOME_HOW for the caller, empty when
# there is none. Their real PATH is not scanned: that needs a walk of
# /proc/<pid>/environ, and the two conventional directories cover the real case.
find_home_runnerctl() {
  local home d
  HOME_COPY=""; HOME_HOW=""
  if [ -n "${SUDO_USER:-}" ]; then
    home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
    HOME_HOW="in $SUDO_USER's home via \$SUDO_USER, not on PATH"
  else
    home="${HOME:-}"
    HOME_HOW="in \$HOME, not on PATH"
  fi
  [ -n "$home" ] || return 0
  for d in "$home/.local/bin" "$home/bin"; do
    [ -f "$d/runnerctl" ] || continue
    if looks_like_runnerctl "$d/runnerctl"; then HOME_COPY="$d/runnerctl"; return 0; fi
    echo "note: $d/runnerctl ($HOME_HOW) is not a runnerctl script — ignoring it"
  done
}

cmd_install() {
  local prefix="" ref="" migrate=true dry_run=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix)     [ $# -ge 2 ] || die "--prefix needs a directory"; prefix="${2%/}"; shift 2 ;;
      --ref)        [ $# -ge 2 ] || die "--ref needs a value"; ref="$2"; shift 2 ;;
      --no-migrate) migrate=false; shift ;;
      --dry-run)    dry_run=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  # Source of the new bytes: this very file when it is a real, versioned one
  # (a checkout, a downloaded copy), else a download — always when piped.
  local src new_ver
  if ! is_piped && [ -z "$ref" ] && [ -n "$(remote_version "${BASH_SOURCE[0]}")" ]; then
    src="$(readlink -f "${BASH_SOURCE[0]}")"
    echo "source: $src (this file)"
  else
    local url; url="$(resolve_url "$ref")"
    DOWNLOAD_TMP="$(mktemp)"; trap 'rm -f "$DOWNLOAD_TMP"' EXIT
    fetch_script "$url" "$DOWNLOAD_TMP"
    src="$DOWNLOAD_TMP"
    echo "source: $url"
  fi
  new_ver="$(remote_version "$src")"

  # Target: where runnerctl already is, else /usr/local/bin. A copy in the
  # invoking user's home that PATH does not reach never moves the target —
  # root-invoked tooling does not live in a home directory — but it is found.
  local existing target
  existing="$(command -v runnerctl 2>/dev/null || true)"
  HOME_COPY=""; HOME_HOW=""
  [ -n "$existing" ] || find_home_runnerctl
  if [ -z "$prefix" ]; then
    if [ -n "$existing" ]; then prefix="$(dirname "$(readlink -f "$existing")")"; else prefix="/usr/local/bin"; fi
  fi
  target="$prefix/runnerctl"
  echo "target: $target"
  if needs_priv "$target"; then
    [ "$(id -u)" -eq 0 ] || command -v sudo >/dev/null || die "$prefix is not writable and there is no sudo — run as root"
  fi
  if [ -n "$HOME_COPY" ] && [ -e "$target" ] && [ "$(readlink -f "$HOME_COPY")" = "$(readlink -f "$target")" ]; then
    HOME_COPY=""   # --prefix pointed at it: it is simply the target
  fi

  # What is there already decides the path: nothing, a pre-config install, or
  # a versioned one. When the target is missing, a home copy stands in for it
  # — migrated or version-checked the same way — except that the new file
  # lands at $target and the old one is renamed out of the way afterwards, so
  # the user does not keep running it from a PATH entry ahead of $prefix.
  local fresh=false old="" where="" retired=""
  if [ -e "$target" ]; then
    looks_like_runnerctl "$target" || die "$target exists but is not a runnerctl script — refusing to overwrite it"
    old="$target"; where="at $target"
    [ -z "$HOME_COPY" ] || echo "note: another runnerctl at $HOME_COPY ($HOME_HOW) is left alone — remove it if it shadows $target"
  elif [ -n "$HOME_COPY" ]; then
    old="$HOME_COPY"; where="at $HOME_COPY ($HOME_HOW)"
    if is_legacy_script "$old"; then retired="$old.legacy"; else retired="$old.retired"; fi
  fi
  if [ -n "$old" ]; then
    if is_legacy_script "$old"; then
      echo "existing: pre-config runnerctl (no RUNNERCTL_VERSION) $where"
      if ! $migrate; then
        echo "--no-migrate: its inline values will NOT be carried into $CONFIG_FILE."
        echo "A copy is kept at $old.legacy so 'runnerctl migrate --from $old.legacy' can do it later."
      elif $dry_run; then
        echo "would run: runnerctl migrate --from $old   (writes $CONFIG_FILE, verified against the live drop-ins)"
      else
        echo "--- migrate ---"
        cmd_migrate --from "$old"   # dies on any failure, leaving $old untouched
        echo "--- migrate done ---"
      fi
    else
      local cur; cur="$(remote_version "$old")"
      echo "existing: runnerctl $cur $where"
      if [ -z "$retired" ] && cmp -s "$src" "$target"; then
        echo "Already up to date ($cur at $target)."
        "$target" version; return 0
      fi
      if [ -z "$ref" ] && version_lt "$new_ver" "$cur"; then
        echo "Installed $cur is newer than $new_ver — not downgrading (pass --ref to force a version)."
        return 0
      fi
      if [ -z "$retired" ]; then echo "upgrade: $cur -> $new_ver"; else echo "move: $cur at $old -> $new_ver at $target"; fi
    fi
  else
    fresh=true
    echo "existing: none — fresh install of $new_ver"
  fi

  if $dry_run; then
    echo "(dry run — would install runnerctl $new_ver at $target; nothing changed)"
    [ -z "$retired" ] || echo "(dry run — would then retire $old as $retired)"
    return 0
  fi
  if [ "$old" = "$target" ] && is_legacy_script "$target" && ! $migrate; then
    install_file "$target" "$target.legacy"
  fi
  # Both directories are created with an explicit mode for the same reason the
  # file is (GHR-47): under root's umask 077 a freshly created /usr/local/bin
  # or /etc/runnerctl is 0700, and a non-root user cannot then traverse it to
  # reach the binary or read the config. An existing directory is left exactly
  # as the admin has it.
  local priv=()
  ! needs_priv "$prefix" || priv=(run_priv)
  [ -d "$prefix" ] || "${priv[@]}" mkdir -p -m 755 "$prefix"
  install_file "$src" "$target"
  local confdir; confdir="$(dirname "$CONFIG_FILE")"
  priv=(); ! needs_priv "$confdir" || priv=(run_priv)
  [ -d "$confdir" ] || "${priv[@]}" mkdir -p -m 755 "$confdir"
  echo "Installed runnerctl $new_ver at $target"
  if [ -n "$retired" ]; then
    # After the new file is in place, never before: a failure here leaves both
    # copies rather than none.
    priv=(); ! needs_priv "$(dirname "$old")" || priv=(run_priv)
    "${priv[@]}" mv -f "$old" "$retired"
    echo "Retired $old as $retired — $target is the one to run now."
  fi
  if $fresh; then
    echo
    echo "Next:"
    echo "  runnerctl status"
    echo "  runnerctl config-example | sudo tee $CONFIG_FILE   # then edit for this host"
    echo "  runnerctl profiles"
  fi
  # The proof comes from the installed file, not from this process.
  echo
  "$target" version
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

main() {
  if [ $# -gt 0 ]; then
    case "$1" in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
  fi
  if [ "${1:-}" = "--config" ]; then
    need_val "$@"
    CONFIG_FILE="$2"; shift 2
    [ -f "$CONFIG_FILE" ] || die "config file $CONFIG_FILE not found"
  fi
  load_config
  local cmd="${1:-status}"; shift || true
  if is_piped; then
    case "$cmd" in
      install|version|--version) ;;
      *) die "running from a pipe — only 'install' works that way. Install first: curl -fsSL $UPGRADE_URL | sudo bash -s -- install" ;;
    esac
  fi
  case "$cmd" in
    install)            cmd_install "$@" ;;
    provision)          cmd_provision "$@" ;;
    status)             cmd_status "$@" ;;
    watch)              cmd_status --watch "$@" ;;
    apply)              cmd_apply "$@" ;;
    scale)              cmd_scale "$@" ;;
    env-init)           cmd_env_init "$@" ;;
    start|stop|restart) cmd_ctl "$cmd" "$@" ;;
    drain)              cmd_ctl stop --when-idle "$@" ;;
    enable|disable)     cmd_toggle "$cmd" "$@" ;;
    logs)               cmd_logs "$@" ;;
    remove-limits)      cmd_remove_limits "$@" ;;
    reap)               cmd_reap "$@" ;;
    kill)               cmd_kill "$@" ;;
    health)             cmd_health "$@" ;;
    fleet)              cmd_fleet "$@" ;;
    profiles)           cmd_profiles "$@" ;;
    config-example)     cmd_config_example ;;
    migrate)            cmd_migrate "$@" ;;
    upgrade)            cmd_upgrade "$@" ;;
    version|--version)  echo "runnerctl $RUNNERCTL_VERSION" ;;
    -h|--help|help)     usage ;;
    *) die "unknown command '$cmd' (status watch health fleet provision apply scale env-init start stop restart drain enable disable logs remove-limits reap kill profiles config-example migrate install upgrade version)" ;;
  esac
}

# RUNNERCTL_NO_MAIN=1 lets tests/run.sh source the script and call a helper
# (fmt_dur, ...) directly without running a command. Not a user-facing knob.
if [ "${RUNNERCTL_NO_MAIN:-}" != 1 ]; then main "$@"; fi

# Test config for `runnerctl migrate` — points discovery and the drop-in tree
# at tests/fixtures/ so the live-reconciliation and render-check paths run
# without systemd or root. Used by `make migrate-test`; pass it with --config.
SYSTEMD_DIR="tests/fixtures/systemd"

discover() {
  printf '%s\n' \
    actions.runner.example.slot-1.service \
    actions.runner.example.slot-2.service \
    actions.runner.example.slot-3.service
}

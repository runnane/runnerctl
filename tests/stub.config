# tests/stub.config — a runnerctl config that replaces systemd with a log.
#
# runnerctl sources its config file AFTER every function is defined, so a
# config can shadow the functions that touch the host. This one shadows every
# such function so `tests/run.sh` can run apply/scale/status/... on any box
# (no runner units, no sudo, no systemd) and assert on what WOULD have
# happened. Used via: RUNNERCTL_CONFIG=tests/stub.config ./runnerctl <cmd>
#
# Knobs (environment variables, read on every call):
#   RUNNERCTL_TEST_LOG             file every privileged call is appended to,
#                                  one line per call: the argv joined by spaces
#   RUNNERCTL_TEST_WRITES          directory that mirrors the target tree —
#                                  `tee /etc/x` stores its stdin at $DIR/etc/x
#   RUNNERCTL_STUB_ENV_FILE_EXISTS 1 = `run_priv test -f <path>` succeeds
#                                  (the deploy env file "exists"); default 0
#   RUNNERCTL_STUB_FAIL_UNITS      an ERE; when set, `systemctl enable --now`,
#                                  `disable --now` or `restart` against a unit
#                                  whose name matches it is still logged but
#                                  returns 1 (simulates a slot that fails to
#                                  start/stop/restart); default unset (all ok)
#   RUNNERCTL_STUB_JOURNAL_ACCESS  0 = `journal_job_lines` fails as it does for
#                                  a user outside systemd-journal, so `status`
#                                  takes the /proc fallback path; default 1
#   RUNNERCTL_STUB_JOURNAL_EMPTY   1 = `journal_job_lines` succeeds but prints
#                                  nothing for every unit (a readable journal
#                                  with no job line since the unit started),
#                                  so `status` takes the "no jobs yet" path;
#                                  default 0
#   RUNNERCTL_STUB_CGROUP_READABLE 1 = `cgroup_readable` answers yes for any
#                                  non-empty cgroup (status runs as root or
#                                  the runner user), so with the journal
#                                  unreadable the /proc-only reader is
#                                  exercised instead of `(no access)`;
#                                  default 0
#
# GHR-15: when RUNNERCTL_TEST_WRITES is set, SYSTEMD_DIR (below) points at
# $RUNNERCTL_TEST_WRITES/etc/systemd/system instead of the real
# /etc/systemd/system — so apply/remove-limits' run_priv-mediated writes and
# status's plain (no run_priv) read of a drop-in's PROFILE line resolve to the
# same tree. A case wanting `status` to see a drop-in must therefore seed it
# itself (tests/run.sh's seed_dropin + run_keep): `run` resets the writes dir
# on every call, so a fresh `run status` always sees an empty tree -> "—".
#
# Everything here is generic: unit names are actions.runner.example.slot-N,
# the stubbed properties are three fixed slots (two running, one stopped) on
# a pinned clock. Keep it that way — this is a public repo and the harness
# must stay deterministic.
#
# This file must not be world-writable (load_config refuses it): keep 0644.

# Point the managed drop-in tree at the writes-mirror directory so apply's
# writes are what status's plain (no run_priv) PROFILE-column read sees.
if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
  export SYSTEMD_DIR="$RUNNERCTL_TEST_WRITES/etc/systemd/system"
fi

# Every privileged host mutation goes through run_priv, so this is the
# capture point. Each call is logged; only `test -f` and `tee` have behaviour.
run_priv() {
  printf '%s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  case "$1" in
    test)
      # Only `test -f <path>` is asked today (env-file existence).
      [ "${RUNNERCTL_STUB_ENV_FILE_EXISTS:-0}" = 1 ]
      ;;
    tee)
      # apply_to / env-init pipe rendered content in; keep it for assertions.
      # A target already under $RUNNERCTL_TEST_WRITES (SYSTEMD_DIR redirected
      # above) is written as-is; any other real path (e.g. the deploy
      # EnvironmentFile) is mirrored under $RUNNERCTL_TEST_WRITES as before.
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
        case "$2" in
          "$RUNNERCTL_TEST_WRITES"/*)
            mkdir -p "$(dirname "$2")"
            cat >"$2"
            ;;
          *)
            mkdir -p "$RUNNERCTL_TEST_WRITES$(dirname "$2")"
            cat >"$RUNNERCTL_TEST_WRITES$2"
            ;;
        esac
      else
        cat >/dev/null
      fi
      ;;
    systemctl)
      # RUNNERCTL_STUB_FAIL_UNITS simulates a unit that fails to
      # enable/disable/restart, to exercise scale's failure-reporting path.
      if [ -n "${RUNNERCTL_STUB_FAIL_UNITS:-}" ]; then
        local unit=""
        case "$2" in
          enable|disable) [ "${3:-}" = "--now" ] && unit="${4:-}" ;;
          restart)        unit="${3:-}" ;;
        esac
        if [ -n "$unit" ] && [[ "$unit" =~ ${RUNNERCTL_STUB_FAIL_UNITS} ]]; then
          return 1
        fi
      fi
      ;;
    *) ;;
  esac
}

# Three fixed slots, already sorted the way `sort -V` would order them.
discover() {
  printf 'actions.runner.example.slot-%d.service\n' 1 2 3
}

# `systemctl show <unit> -p <prop> --value`, answered from a table. Every
# slot looks the same: active, enabled, CI-profile caps, 1G in use. Kept for
# any single-property caller; `status` goes through `unit_props` below.
prop() {
  case "$2" in
    ActiveState)      echo "active" ;;
    SubState)         echo "running" ;;
    UnitFileState)    echo "enabled" ;;
    MemoryMax)        echo "27917287424" ;;   # 26G
    MemoryHigh)       echo "23622320128" ;;   # 22G
    MemoryCurrent)    echo "1073741824" ;;    # 1G
    Restart)          echo "always" ;;
    EnvironmentFiles) echo "" ;;
    ControlGroup)     echo "/system.slice/$1" ;;
    *)                echo "" ;;
  esac
}

# The monotonic clock `status` subtracts systemd's *TimestampMonotonic stamps
# from, pinned so the SINCE column is deterministic: 10^12 µs = 1,000,000 s
# since "boot". The stamps below are offsets from it.
now_mono() { echo 1000000000000; }

# `status`'s batched replacement for nine `prop` calls: one KEY=VALUE table
# per unit. Logged with a `probe:` prefix (never `direct:`, never a
# privileged-call verb) so cases can count it without tripping the
# read-only/leak assertions on `status`. Slot 2 answers EnvironmentFiles with
# an embedded '=' to exercise the "split on the first '=' only" contract.
#
# The rows differ so the table is not uniform:
#   slot-1  active/running since 3d 4h (273600 s), never been inactive
#   slot-2  active/running since 41m (2460 s), was inactive 2h ago (a restart)
#   slot-3  inactive/dead since 6d (518400 s), disabled, no cgroup, no
#           memory accounting; it was last active 8d ago — so SINCE must pick
#           the inactive-enter stamp, not the active-enter one
unit_props() {
  printf 'probe:unit_props %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  case "$1" in
    *slot-3*)
      cat <<EOF
ActiveState=inactive
SubState=dead
UnitFileState=disabled
MemoryMax=infinity
MemoryHigh=infinity
MemoryCurrent=[not set]
Restart=always
EnvironmentFiles=
ControlGroup=
ActiveEnterTimestampMonotonic=308800000000
InactiveEnterTimestampMonotonic=481600000000
NRestarts=0
Result=success
InvocationID=
EOF
      return
      ;;
  esac
  local envfiles="" active_enter=726400000000 inactive_enter=0 inv=1111aaaa1111aaaa1111aaaa1111aaaa
  case "$1" in
    *slot-2*) envfiles="/etc/x (ignore_errors=no)"; active_enter=997540000000; inactive_enter=992800000000; inv=2222bbbb2222bbbb2222bbbb2222bbbb ;;
  esac
  cat <<EOF
ActiveState=active
SubState=running
UnitFileState=enabled
MemoryMax=27917287424
MemoryHigh=23622320128
MemoryCurrent=1073741824
Restart=always
EnvironmentFiles=$envfiles
ControlGroup=/system.slice/$1
ActiveEnterTimestampMonotonic=$active_enter
InactiveEnterTimestampMonotonic=$inactive_enter
NRestarts=0
Result=success
InvocationID=$inv
EOF
}

# --- WORKING-ON (GHR-10) ------------------------------------------------------
# job_info itself is the real one; only the two sources it reads are shadowed.
#
# The journal hook, keyed by unit and logged with a `probe:` prefix (with the
# invocation id it was handed, so a case can assert the scope hand-off).
# slot-1 picked up job `test` 12 minutes before the pinned clock and has not
# finished it; slot-2 ran `lint` and then `build` and completed both, the
# last one 2h31m (9060 s) before the pinned epoch clock, so it is idle with
# two jobs behind it (GHR-2); slot-3 has no cgroup, so job_info never asks.
# (The epoch clock below and now_mono above are independent, so slot-2's
# 2h31m idle and its 41m SINCE need not agree.) Lines are in `-o short-unix`
# form, as the real hook returns them. RUNNERCTL_STUB_JOURNAL_ACCESS=0 makes
# it fail the way journalctl --system does for a user outside
# systemd-journal; RUNNERCTL_STUB_JOURNAL_EMPTY=1 makes every unit's journal
# readable but empty (a slot that has not run a job since it started).
journal_job_lines() {
  printf 'probe:journal_job_lines %s %s\n' "$1" "${2:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "${RUNNERCTL_STUB_JOURNAL_ACCESS:-1}" = 1 ] || return 1
  [ "${RUNNERCTL_STUB_JOURNAL_EMPTY:-0}" = 1 ] && return 0
  case "$1" in
    *slot-1*)
      echo '1000000000.000000 runsvc.sh[100]: 2001-09-09 01:46:40Z: Running job: test'
      ;;
    *slot-2*)
      echo '999990000.000000 runsvc.sh[200]: 2001-09-08 23:00:00Z: Running job: lint'
      echo '999990600.000000 runsvc.sh[200]: 2001-09-08 23:10:00Z: Job lint completed with result: Succeeded'
      echo '999991000.000000 runsvc.sh[200]: 2001-09-08 23:16:40Z: Running job: build'
      echo '999991660.000000 runsvc.sh[200]: 2001-09-08 23:27:40Z: Job build completed with result: Succeeded'
      ;;
  esac
}

# Epoch clock the journal-derived runtime and idle time are measured from:
# 12 minutes after slot-1's `Running job:` line, 2h31m after slot-2's last
# completion.
now_epoch() { echo 1000000720; }

# The /proc side, as seen by a user who is neither root nor the runner user:
# no cgroup is readable (so the fallback path answers `(no access)`), no
# Runner.Worker pid is found (so the runtime comes from the journal stamp).
# proc_job_env still answers for slot-1's cgroup so the repo enrichment is
# exercised. The cgroup hand-off from unit_props (GHR-4) stays detectable:
# job_info answers `—` for an empty cgroup before it asks any of these, and
# the slot-1 row regex rejects that. RUNNERCTL_STUB_CGROUP_READABLE=1 makes
# every non-empty cgroup readable (root / the runner user), which with the
# journal unreadable reaches the /proc-only reader's `idle ?` (GHR-2).
cgroup_readable() { [ "${RUNNERCTL_STUB_CGROUP_READABLE:-0}" = 1 ] && [ -n "${1:-}" ]; }
proc_worker_pid() { :; }
proc_job_env() {
  case "${1:-}" in
    *slot-1*) echo "GITHUB_REPOSITORY=example/my-app"; echo "GITHUB_JOB=test" ;;
    *)        ;;
  esac
}

# Safety net: nothing above should ever reach the real binaries. If a code
# path bypasses run_priv/discover/prop, the call lands here, is logged with a
# `direct:` marker (tests/run.sh fails any case whose log carries one), and
# does nothing.
systemctl()  { printf 'direct:systemctl %s\n'  "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }
journalctl() { printf 'direct:journalctl %s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }
sudo()       { printf 'direct:sudo %s\n'       "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }

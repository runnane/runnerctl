# tests/stub.config — a runnerctl config that replaces systemd with a log.
#
# runnerctl sources its config file AFTER every function is defined, so a
# config can shadow the functions that touch the host. This one shadows every
# such function so `tests/run.sh` can run apply/scale/status/... on any box
# (no runner units, no sudo, no systemd) and assert on what WOULD have
# happened. Used via: RUNNERCTL_CONFIG=tests/stub.config ./runnerctl <cmd>
#
# Knobs (environment variables, read on every call):
#   RUNNERCTL_TEST_LOG             file every privileged call is appended to,
#                                  one line per call: the argv joined by spaces
#   RUNNERCTL_TEST_WRITES          directory that mirrors the target tree —
#                                  `tee /etc/x` stores its stdin at $DIR/etc/x
#   RUNNERCTL_STUB_ENV_FILE_EXISTS 1 = `run_priv test -f <path>` succeeds
#                                  (the deploy env file "exists"); default 0
#   RUNNERCTL_STUB_FAIL_UNITS      an ERE; when set, `systemctl enable --now`,
#                                  `disable --now` or `restart` against a unit
#                                  whose name matches it is still logged but
#                                  returns 1 (simulates a slot that fails to
#                                  start/stop/restart); default unset (all ok)
#   RUNNERCTL_STUB_JOURNAL_ACCESS  0 = `journal_job_lines` fails as it does for
#                                  a user outside systemd-journal, so `status`
#                                  takes the /proc fallback path; default 1
#   RUNNERCTL_STUB_BUSY_POLLS      N = slot-1's journal reports its job as
#                                  running for the first N `journal_job_lines`
#                                  calls of a run and completed (idle) from
#                                  the N+1th; the count lives in a file under
#                                  $RUNNERCTL_TEST_WRITES because each call
#                                  runs in a "$(...)" subshell. Default unset
#                                  = busy forever (status's fixed picture)
#
# GHR-11: `pause` (runnerctl's sleep) is a no-op that logs `probe:pause N`, so
# a case can count the polls a --when-idle wait made. POLL_SEC stays at the
# script's default: wait_idle advances its clock by POLL_SEC per poll rather
# than reading a clock, so `--timeout 10` is reached after two no-op pauses.
#   RUNNERCTL_STUB_TTY             1 = `stdout_is_tty` answers yes, so `watch`
#                                  (GHR-3) runs its loop under the harness
#                                  (whose stdout is a pipe); default 0 = the
#                                  non-tty refusal. `term_cursor` is a logged
#                                  no-op either way, so tput's escape codes
#                                  never land in the captured stdout.
#   RUNNERCTL_STUB_JOURNAL_EMPTY   1 = the real `journal_job_lines` runs over a
#                                  journalctl whose -g search exits 1 with no
#                                  output and whose access probe exits 0 (a
#                                  readable journal with no job line since the
#                                  unit started; GHR-65),
#                                  so `status` takes the "no jobs yet" path;
#                                  default 0
#   RUNNERCTL_STUB_LEAKED          1 = `proc_leaked` answers two processes
#                                  (4242 node, 4243 esbuild) for slot-2's
#                                  cgroup — the idle slot — so the `+N
#                                  leaked` cell, the --json field, the
#                                  health problem and `reap` are reachable
#                                  (GHR-29); needs CGROUP_READABLE=1 too,
#                                  since job_facts never asks otherwise
#   RUNNERCTL_STUB_PRESSURE        1 = `cgroup_memory_facts` answers for the
#                                  two running slots: slot-1 under full
#                                  memory pressure (63.20 % avg10, 4 high
#                                  events, 1 max, 0 oom_kill), slot-2 at
#                                  rest (0.00 %, all zero) — GHR-31;
#                                  default 0 = nothing readable, PRESS —
#   RUNNERCTL_STUB_DEACTIVATING    1 = slot-1's unit_props answers
#                                  deactivating/stop-sigterm — a unit wedged
#                                  in its own graceful stop, which is where a
#                                  `restart` of a stalled job ends up and the
#                                  one state only a SIGKILL leaves (GHR-36);
#                                  default 0
#   RUNNERCTL_STUB_SURVIVORS       space-separated pids `pid_alive` still
#                                  answers yes for after `reap`'s SIGTERM
#                                  (so they get SIGKILL); default none
#   RUNNERCTL_STUB_CGROUP_READABLE 1 = `cgroup_readable` answers yes for any
#                                  non-empty cgroup (status runs as root or
#                                  the runner user), so with the journal
#                                  unreadable the /proc-only reader is
#                                  exercised instead of `(no access)`;
#                                  default 0
#   RUNNERCTL_STUB_KEYS            the keystrokes an interactive `watch`
#                                  reads, one character per read (GHR-33);
#                                  `-` is a tick with no key. See the
#                                  tty_read_char shadow below
#   RUNNERCTL_STUB_PROMPT_IN       the lines `fleet watch`'s `:` prompt
#                                  reads, one per prompt (GHR-86). See the
#                                  tty_read_line shadow below
#   RUNNERCTL_STUB_REMOTE_SH       1 = log what a remote shell makes of each
#                                  ssh_run call (stub_remote_words, GHR-86)
#   RUNNERCTL_STUB_COLS           terminal width for `watch`'s column
#                                  dropping; default 0 = unknown, no drop.
#                                  A comma list (`150,150,300`) answers one
#                                  entry per call and repeats the last, for
#                                  a terminal resized mid-watch (GHR-56)
#   RUNNERCTL_STUB_LINES           terminal height for the watches' viewport
#                                  (GHR-73); default 0 = unknown, nothing is
#                                  fitted. A comma list works as for COLS
#   RUNNERCTL_STUB_SLOTS           how many slots `discover` answers (default
#                                  3; 4..9 for a frame taller than a terminal)
#   RUNNERCTL_STUB_CLOCK           1 = the pinned clock MOVES (GHR-74): every
#                                  whole-second `pause` adds its seconds to
#                                  what `now_epoch` answers, so a case can
#                                  pin an age. Default 0: the clock stands
#                                  still, as every older case assumes
#   RUNNERCTL_STUB_RUN             1 = slot-1's step environment carries the
#                                  run's variables too, and slot-2 has one of
#                                  its own (GHR-78); RUNNERCTL_STUB_RUN_<NAME>
#                                  replaces one of slot-1's values. See the
#                                  proc_job_env shadow below. Default 0
#   RUNNERCTL_STUB_ENV_ONCE        1 = slot-1's step environment answers the
#                                  first read of a run and nothing after it
#                                  (GHR-102). Default 0
#   RUNNERCTL_STUB_LEAK_COMM      the comm of slot-2's first leaked process
#                                  (GHR-76), in place of `node`: text a
#                                  process chose, for the detail pane
#   RUNNERCTL_STUB_SCALED_AFTER    N = `discover` answers two slots once the
#                                  moving clock (RUNNERCTL_STUB_CLOCK=1) is N
#                                  seconds on — this host scaled down
#                                  mid-watch (GHR-76). Default unset
#
# GHR-15: when RUNNERCTL_TEST_WRITES is set, SYSTEMD_DIR (below) points at
# $RUNNERCTL_TEST_WRITES/etc/systemd/system instead of the real
# /etc/systemd/system — so apply/remove-limits' run_priv-mediated writes and
# status's plain (no run_priv) read of a drop-in's PROFILE line resolve to the
# same tree. A case wanting `status` to see a drop-in must therefore seed it
# itself (tests/run.sh's seed_dropin + run_keep): `run` resets the writes dir
# on every call, so a fresh `run status` always sees an empty tree -> "—".
#
# Everything here is generic: unit names are actions.runner.example.slot-N,
# the stubbed properties are three fixed slots (two running, one stopped) on
# a pinned clock. Keep it that way — this is a public repo and the harness
# must stay deterministic.
#
# This file must not be world-writable (load_config refuses it): keep 0644.

# Point the managed drop-in tree at the writes-mirror directory so apply's
# writes are what status's plain (no run_priv) PROFILE-column read sees.
if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
  export SYSTEMD_DIR="$RUNNERCTL_TEST_WRITES/etc/systemd/system"
fi

# Every privileged host mutation goes through run_priv, so this is the
# capture point. Each call is logged; only `test -f` and `tee` have behaviour.
run_priv() {
  printf '%s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  # GHR-119: RUNNERCTL_STUB_BLOCK=ERE — the call whose argv matches it hangs
  # (a foreground `sleep 30`, like a download or a wait in progress) after
  # saying so in `$RUNNERCTL_TEST_WRITES/.blocked`, so a case can signal the
  # command at a known point. Only run_signalled in tests/run.sh sets it.
  # GHR-91: RUNNERCTL_STUB_BLOCK_SECS shortens the hang, for a signal the
  # command is meant to go on through (a SIGHUP), so the case does not sit
  # out the whole 30 s.
  if [ -n "${RUNNERCTL_STUB_BLOCK:-}" ] && [[ "$*" =~ $RUNNERCTL_STUB_BLOCK ]]; then
    printf 'probe:blocked %s\n' "$*" >>"$RUNNERCTL_TEST_LOG"
    : >"${RUNNERCTL_TEST_WRITES:?}/.blocked"
    sleep "${RUNNERCTL_STUB_BLOCK_SECS:-30}"
  fi
  # GHR-46: `deprovision` hands the removal token to `config.sh remove` on
  # STDIN (the inner shell exports it as ACTIONS_RUNNER_INPUT_TOKEN), so it is
  # never in the argv logged above. What arrived on stdin goes to a FILE under
  # the writes dir — never the log — so a case can prove the token was
  # delivered as well as that it was kept out of the log; without that, the
  # "never in the log" assertion would pass a version that sent no token at
  # all. RUNNERCTL_STUB_CONFIG_REMOVE_FAIL=1 makes it fail the way it does for
  # a runner GitHub has already forgotten (the DELETE 404s).
  case " $* " in
    # GHR-122: `provision` registers the same way — the registration token
    # arrives on STDIN, never in the argv logged above. One line per slot,
    # kept in a file under the writes dir and never in the log.
    *" ./config.sh --unattended "*)
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
        cat >>"$RUNNERCTL_TEST_WRITES/.config-register-stdin"
      else
        cat >/dev/null
      fi
      return 0
      ;;
    *" ./config.sh remove "*)
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
        cat >>"$RUNNERCTL_TEST_WRITES/.config-remove-stdin"
      else
        cat >/dev/null
      fi
      [ "${RUNNERCTL_STUB_CONFIG_REMOVE_FAIL:-0}" != 1 ] || return 1
      return 0
      ;;
  esac
  case "$1" in
    mkdir)
      # GHR-142: a directory under the writes tree is made for real, with the
      # mode asked for, so a case under a strict umask can read the mode back.
      # Anything else is only logged, as before.
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ] && [ "${2:-}" = -p ] && [ "${3:-}" = -m ] \
         && [[ "${5:-}" == "$RUNNERCTL_TEST_WRITES"/* ]]; then
        mkdir -p "$(dirname "$5")"
        [ -d "$5" ] || mkdir -m "$4" "$5"
      fi
      ;;
    chmod)
      # GHR-142: likewise a chmod of a file under the writes tree.
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ] && [[ "${3:-}" == "$RUNNERCTL_TEST_WRITES"/* ]]; then
        chmod "$2" "$3"
      fi
      ;;
    mktemp)
      # GHR-116: provision's staging directory, `mktemp -d <root>/.<name>
      # .provision.XXXXXXXX`. Nothing is created; the name it answers has the
      # X's filled in with a fixed text, so a case can pin every later call.
      [ "$2" = -d ] && printf '%s\n' "${3%XXXXXXXX}stub0001"
      ;;
    test)
      # Only `test -f <path>` is asked today (env-file existence).
      [ "${RUNNERCTL_STUB_ENV_FILE_EXISTS:-0}" = 1 ]
      ;;
    tee)
      # apply_to / env-init pipe rendered content in; keep it for assertions.
      # A target already under $RUNNERCTL_TEST_WRITES (SYSTEMD_DIR redirected
      # above) is written as-is; any other real path (e.g. the deploy
      # EnvironmentFile) is mirrored under $RUNNERCTL_TEST_WRITES as before.
      if [ -n "${RUNNERCTL_TEST_WRITES:-}" ]; then
        case "$2" in
          "$RUNNERCTL_TEST_WRITES"/*)
            mkdir -p "$(dirname "$2")"
            cat >"$2"
            ;;
          *)
            mkdir -p "$RUNNERCTL_TEST_WRITES$(dirname "$2")"
            cat >"$RUNNERCTL_TEST_WRITES$2"
            ;;
        esac
      else
        cat >/dev/null
      fi
      ;;
    systemctl)
      # RUNNERCTL_STUB_FAIL_UNITS simulates a unit that fails to
      # enable/disable/restart, to exercise scale's failure-reporting path.
      if [ -n "${RUNNERCTL_STUB_FAIL_UNITS:-}" ]; then
        local unit=""
        case "$2" in
          enable|disable) [ "${3:-}" = "--now" ] && unit="${4:-}" ;;
          restart)        unit="${3:-}" ;;
        esac
        if [ -n "$unit" ] && [[ "$unit" =~ ${RUNNERCTL_STUB_FAIL_UNITS} ]]; then
          return 1
        fi
      fi
      ;;
    *) ;;
  esac
}

# Three fixed slots, already sorted the way `sort -V` would order them.
# RUNNERCTL_STUB_NO_UNITS=1 makes it a host with no runner units at all, for
# the GHR-38 cases that pin what `--json` and the table each do there.
#
# GHR-73: RUNNERCTL_STUB_SLOTS=N (4..9) makes it a pool of N slots, so a frame
# can be taller than a pinned terminal. Slots 4 and up answer like a plain
# active slot with no job history; past 9 the `*slot-1*` patterns below would
# start matching slot-10, so keep it to one digit.
discover() {
  if [ "${RUNNERCTL_STUB_NO_UNITS:-0}" = 1 ]; then return 0; fi
  # GHR-55: a remote host scaled down mid-watch (RUNNERCTL_STUB_FLEET_SCALED).
  if stub_remote_scaled; then printf 'actions.runner.example.slot-%d.service\n' 1 2; return 0; fi
  # GHR-76: THIS host scaled down mid-watch — RUNNERCTL_STUB_SCALED_AFTER=N,
  # with RUNNERCTL_STUB_CLOCK=1: slot-3 is gone once the clock has moved N
  # seconds, which a tick of `watch --interval N` does.
  if [ -n "${RUNNERCTL_STUB_SCALED_AFTER:-}" ] && [ $(($(now_epoch) - 1000000720)) -ge "$RUNNERCTL_STUB_SCALED_AFTER" ]; then
    printf 'actions.runner.example.slot-%d.service\n' 1 2; return 0
  fi
  local i
  for ((i = 1; i <= ${RUNNERCTL_STUB_SLOTS:-3}; i++)); do
    printf 'actions.runner.example.slot-%d.service\n' "$i"
  done
}

# `systemctl show <unit> -p <prop> --value`, answered from a table. Every
# slot looks the same: active, enabled, CI-profile caps, 1G in use. Kept for
# any single-property caller; `status` goes through `unit_props` below.
prop() {
  case "$2" in
    ActiveState)      echo "active" ;;
    SubState)         echo "running" ;;
    UnitFileState)    echo "enabled" ;;
    MemoryMax)        echo "27917287424" ;;   # 26G
    MemoryHigh)       echo "23622320128" ;;   # 22G
    MemoryCurrent)    echo "1073741824" ;;    # 1G
    Restart)          echo "always" ;;
    EnvironmentFiles) echo "" ;;
    ControlGroup)     echo "/system.slice/$1" ;;
    # GHR-46: what svc.sh writes into the unit, and what `deprovision` reads
    # to find the runner's directory and account. actions.runner.example.slot-1
    # lives in /opt/actions-runner/slot-1. RUNNERCTL_STUB_NO_WORKDIR=1 answers
    # empty, as a unit not installed by svc.sh would.
    WorkingDirectory)
      if [ "${RUNNERCTL_STUB_NO_WORKDIR:-0}" = 1 ]; then echo ""; else
        local s="${1#actions.runner.}"; s="${s%.service}"; echo "/opt/actions-runner/${s#*.}"
      fi ;;
    # GHR-110: RUNNERCTL_STUB_UNIT_USER answers another User= — `root`, for
    # the refusal to run a root runner's config.sh as root.
    User)             echo "${RUNNERCTL_STUB_UNIT_USER:-github-runner}" ;;
    *)                echo "" ;;
  esac
}

# The monotonic clock `status` subtracts systemd's *TimestampMonotonic stamps
# from, pinned so the SINCE column is deterministic: 10^12 µs = 1,000,000 s
# since "boot". The stamps below are offsets from it.
now_mono() { echo 1000000000000; }

# `status`'s batched replacement for nine `prop` calls: one KEY=VALUE table
# per unit. Logged with a `probe:` prefix (never `direct:`, never a
# privileged-call verb) so cases can count it without tripping the
# read-only/leak assertions on `status`. Slot 2 answers EnvironmentFiles with
# an embedded '=' to exercise the "split on the first '=' only" contract.
#
# The rows differ so the table is not uniform:
#   slot-1  active/running since 3d 4h (273600 s), never been inactive, and
#           the only slot with MemoryPeak set (25.0G) — exercises the USED
#           "cur/peak" shape; MemoryCurrent stays 1.0G so both numbers show
#   slot-2  active/running since 41m (2460 s), was inactive 2h ago (a
#           restart): NRestarts=3 with Result=success — the current
#           invocation is fine, so the ACTIVE cell's "(last: ...)" comes from
#           journal_restart_reason (GHR-8), stubbed below to answer oom-kill.
#           No MemoryPeak, so USED stays current-only.
#   slot-3  inactive/dead since 6d (518400 s), disabled, no cgroup, no
#           memory accounting; it was last active 8d ago — so SINCE must pick
#           the inactive-enter stamp, not the active-enter one.
#           RUNNERCTL_STUB_SLOT3_ENABLED=1 flips its UnitFileState to
#           "enabled" (still dead) for GHR-14's health cases, without
#           disturbing status's default-stub expectations.
unit_props() {
  printf 'probe:unit_props %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  # GHR-55: a remote slot a `fleet watch` key started or stopped answers in
  # its new state — active/running with a cgroup, or inactive/dead without one
  # (so no job is read for it). Only inside a remote call (STUB_REMOTE_HOST).
  case "$(stub_remote_state "$1")" in
    inactive) printf 'ActiveState=inactive\nSubState=dead\nUnitFileState=enabled\nControlGroup=\nNRestarts=0\nResult=success\n'; return ;;
    active)   printf 'ActiveState=active\nSubState=running\nUnitFileState=enabled\nControlGroup=/system.slice/%s\nActiveEnterTimestampMonotonic=999000000000\nNRestarts=0\nResult=success\n' "$1"; return ;;
  esac
  case "$1" in
    *slot-3*)
      local slot3_ufs="disabled"
      [ -z "${RUNNERCTL_STUB_SLOT3_ENABLED:-}" ] || slot3_ufs="enabled"
      cat <<EOF
ActiveState=inactive
SubState=dead
UnitFileState=$slot3_ufs
MemoryMax=infinity
MemoryHigh=infinity
MemoryCurrent=[not set]
MemoryPeak=[not set]
Restart=always
EnvironmentFiles=
ControlGroup=
ActiveEnterTimestampMonotonic=308800000000
InactiveEnterTimestampMonotonic=481600000000
NRestarts=0
Result=success
InvocationID=
EOF
      return
      ;;
  esac
  local envfiles="" active_enter=726400000000 inactive_enter=0 inv=1111aaaa1111aaaa1111aaaa1111aaaa
  local nrestarts=0 mempeak="[not set]"
  local active=active sub=running
  case "$1" in
    *slot-1*) mempeak=26843545600 ;;                    # 25.0G — GHR-8
    *slot-2*) envfiles="/etc/x (ignore_errors=no)"; active_enter=997540000000; inactive_enter=992800000000; inv=2222bbbb2222bbbb2222bbbb2222bbbb; nrestarts=3 ;;
  esac
  # GHR-36: slot-1 wedged in its own stop — where a `systemctl restart` of a
  # slot whose job ignores SIGTERM sits for TimeoutStopSec (5 min).
  if [ "${RUNNERCTL_STUB_DEACTIVATING:-0}" = 1 ]; then
    case "$1" in *slot-1*) active=deactivating sub=stop-sigterm ;; esac
  fi
  cat <<EOF
ActiveState=$active
SubState=$sub
UnitFileState=enabled
MemoryMax=27917287424
MemoryHigh=23622320128
MemoryCurrent=1073741824
MemoryPeak=$mempeak
Restart=always
EnvironmentFiles=$envfiles
ControlGroup=/system.slice/$1
ActiveEnterTimestampMonotonic=$active_enter
InactiveEnterTimestampMonotonic=$inactive_enter
NRestarts=$nrestarts
Result=success
InvocationID=$inv
EOF
}

# GHR-8: the ACTIVE cell's journal-derived "last restart reason". Slot-2 is
# the only unit with NRestarts > 0, so it is the only one this is ever asked
# about; logged with a `probe:` prefix (like unit_props/journal_job_lines) so
# a case can assert it is consulted exactly once per `status` and only for a
# unit with restarts.
journal_restart_reason() {
  printf 'probe:journal_restart_reason %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  case "$1" in
    *slot-2*) echo "oom-kill" ;;
  esac
}

# --- WORKING-ON (GHR-10) ------------------------------------------------------
# job_info itself is the real one; only the two sources it reads are shadowed.
#
# The journal hook, keyed by unit and logged with a `probe:` prefix (with the
# invocation id it was handed, so a case can assert the scope hand-off).
# slot-1 picked up job `test` 12 minutes before the pinned clock and has not
# finished it; slot-2 ran `lint` and then `build` and completed both, the
# last one 2h31m (9060 s) before the pinned epoch clock, so it is idle with
# two jobs behind it (GHR-2); slot-3 has no cgroup, so job_info never asks.
# (The epoch clock below and now_mono above are independent, so slot-2's
# 2h31m idle and its 41m SINCE need not agree.) Lines are in `-o short-unix`
# form, as the real hook returns them. RUNNERCTL_STUB_JOURNAL_ACCESS=0 makes
# it fail the way journalctl --system does for a user outside
# systemd-journal; RUNNERCTL_STUB_JOURNAL_EMPTY=1 makes every unit's journal
# readable but empty (a slot that has not run a job since it started).
#
# GHR-65: the EMPTY knob does not fake the hook's result, it runs the REAL
# journal_job_lines (copied aside below, before this file shadows it) over a
# journalctl that behaves as the real one does on a readable journal with no
# job line: the access probe (-n 1) exits 0, the -g search exits 1 with no
# output. Returning 0 here would pass over a state the real hook can only
# produce through its own access probe.
eval "real_$(declare -f journal_job_lines)"
STUB_JL_REAL=0
journal_job_lines() {
  printf 'probe:journal_job_lines %s %s\n' "$1" "${2:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "${RUNNERCTL_STUB_JOURNAL_ACCESS:-1}" = 1 ] || return 1
  if [ "${RUNNERCTL_STUB_JOURNAL_EMPTY:-0}" = 1 ]; then
    local rc=0
    STUB_JL_REAL=1
    real_journal_job_lines "$@" || rc=$?
    STUB_JL_REAL=0
    return "$rc"
  fi
  case "$1" in
    *slot-1*)
      echo '1000000000.000000 runsvc.sh[100]: 2001-09-09 01:46:40Z: Running job: test'
      # RUNNERCTL_STUB_BUSY_POLLS (GHR-11): after N calls the job completes.
      if [ -n "${RUNNERCTL_STUB_BUSY_POLLS:-}" ]; then
        local f="${RUNNERCTL_TEST_WRITES:?RUNNERCTL_TEST_WRITES unset}/.busy-polls" n=0
        [ ! -f "$f" ] || n="$(cat "$f")"
        n=$((n + 1)); echo "$n" >"$f"
        [ "$n" -le "$RUNNERCTL_STUB_BUSY_POLLS" ] || \
          echo '1000000700.000000 runsvc.sh[100]: 2001-09-09 01:58:20Z: Job test completed with result: Succeeded'
      fi
      ;;
    *slot-2*)
      echo '999990000.000000 runsvc.sh[200]: 2001-09-08 23:00:00Z: Running job: lint'
      echo '999990600.000000 runsvc.sh[200]: 2001-09-08 23:10:00Z: Job lint completed with result: Succeeded'
      echo '999991000.000000 runsvc.sh[200]: 2001-09-08 23:16:40Z: Running job: build'
      echo '999991660.000000 runsvc.sh[200]: 2001-09-08 23:27:40Z: Job build completed with result: Succeeded'
      ;;
  esac
}

# Epoch clock the journal-derived runtime and idle time are measured from:
# 12 minutes after slot-1's `Running job:` line, 2h31m after slot-2's last
# completion.
#
# GHR-74: with RUNNERCTL_STUB_CLOCK=1 it is that instant plus the seconds the
# run has paused for so far (stub_clock_add, below). The offset lives in a
# file beside the log, like the terminal sizes: most callers read the clock
# through "$(now_epoch)", a subshell a variable would not survive.
now_epoch() {
  local off=0 f="${RUNNERCTL_TEST_LOG:-/nonexistent}.clock"
  if [ "${RUNNERCTL_STUB_CLOCK:-0}" = 1 ] && [ -f "$f" ]; then off="$(cat "$f")"; fi
  echo $((1000000720 + off))
}
# `fleet watch` schedules its ticks in milliseconds (now_ms); here that is the
# same pinned clock, so a whole interval is always what is left of one — the
# `5` every older case sees its key read made with.
#
# GHR-80: plus STUB_MS_ADD, which ssh_run (below) moves on by a host's
# RUNNERCTL_STUB_FLEET_MS after its call — so `duration_ms` can be pinned per
# host. A plain variable, deliberately: a fan-out times each host in a
# background job of its own, and what one host's call adds must not reach
# another's clock, nor the loop's tick schedule.
STUB_MS_ADD=0
now_ms() { echo $(($(now_epoch) * 1000 + STUB_MS_ADD)); }
# `fleet status --json --watch`'s waits (GHR-80), logged `probe:stream_wait S`.
# A POLL STEP (S is FW_POLL) is modelled as `fleet watch`'s is
# (stub_fleet_poll, below): it waits — really, briefly — until every fetch out
# has landed or is a host the case made hang; if something landed, no time has
# passed, and if only hung hosts are left, the interval has run out (with
# RUNNERCTL_STUB_CLOCK=1 the clock jumps to FW_NEXT), so the stream writes its
# envelope with the hung host in it. Any other wait — what is left of an
# interval — sleeps a moment of real time and moves the clock on by S, rounded
# up to whole seconds.
stream_wait() {
  local s="${1%%.*}"
  printf 'probe:stream_wait %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  if [ "$1" = "${FW_POLL:-}" ] && [ -n "${FW_STATE:-}" ]; then
    stub_fleet_poll || { stub_clock_to "$((FW_NEXT / 1000))"; sleep 0.02; }
    return 0
  fi
  sleep 0.05
  [[ "$1" != *.* ]] || s=$((10#${s:-0} + 1))
  stub_clock_add "$s"
}
# Move the clock on by SECONDS (whole ones; a poll step of a fraction of a
# second moves nothing), or up to an EPOCH it has not reached yet.
stub_clock_add() { # SECONDS
  [ "${RUNNERCTL_STUB_CLOCK:-0}" = 1 ] || return 0
  [[ "$1" =~ ^[0-9]+$ ]] || return 0
  echo $(($(now_epoch) - 1000000720 + $1)) >"${RUNNERCTL_TEST_LOG:?}.clock"
}
stub_clock_to() { # EPOCH
  [ "${RUNNERCTL_STUB_CLOCK:-0}" = 1 ] || return 0
  [ "$1" -gt "$(now_epoch)" ] || return 0
  echo $(($1 - 1000000720)) >"${RUNNERCTL_TEST_LOG:?}.clock"
}

# The JSON `host` object's sources (GHR-16): "CORES MEM_TOTAL MEM_AVAILABLE"
# in bytes, pinned so the --json case can assert them.
host_facts() { echo "16 68719476736 51539607552"; }

# The JSON `host.sudo_contract` (GHR-113), pinned: the real one reads
# /etc/runnerctl/config, which no sim case may touch. `narrow` by default, so a
# fleet that sets FLEET_SUDO=1 is a compliant one unless a case says otherwise.
# RUNNERCTL_STUB_FLEET_SUDOC="host:value …" (word-split, first match wins)
# answers as that host with any text — `full`, `narrow`, `-` for an empty
# answer (a config it cannot read: the JSON says null) or a hostile string; no
# `*` or `?` in it. RUNNERCTL_STUB_SUDOC sets the local `status --json`.
# A host from before the key is RUNNERCTL_STUB_FLEET_NOSUDOC (the status arm
# below takes the key out of its payload).
host_sudo_contract() {
  local fv v="${RUNNERCTL_STUB_SUDOC:-narrow}"
  for fv in ${RUNNERCTL_STUB_FLEET_SUDOC:-}; do
    [ "${fv%%:*}" = "${STUB_REMOTE_HOST:-}" ] || continue
    v="${fv#*:}"; break
  done
  if [ "$v" = - ]; then v=""; fi
  printf '%s' "$v"
}

# The JSON `host.name` (GHR-38), pinned for the same reason host_line below
# is: the real `hostname` differs on every box that runs the gates, so an
# unpinned one would make the --json case assert something only this machine
# produces. RUNNERCTL_STUB_HOST_NAME= (empty) exercises the null branch.
host_name() { echo "${RUNNERCTL_STUB_HOST_NAME-stub-host-1}"; }

# The status table header's "Host: ..." fragment (GHR-34): pinned so the
# whole-output diff in the `status --color always` sim case, and every
# `watch` frame, are deterministic — free -h's real rounding could differ
# between two runs on a loaded box and flake that diff.
host_line() { echo "16 cores, 64Gi RAM, 48Gi available"; }

# The filesystem holding each watched path (GHR-64, GHR-67), as host_df
# prints it: "PATH<TAB>DEVICE FSTYPE SIZE USED AVAIL PCT MOUNT". The paths
# come from the real disk_watch_paths — /var/lib/docker, then each slot's
# /opt/actions-runner/slot-N/_work (the stub's WorkingDirectory; there is no
# .runner file, so the runner default _work) — so the grouping and the roles
# are the script's own. A path under /missing does not exist.
#   (default)  every path on one root drive at 24 %
#   full       docker on its own drive at 96 % (past DISK_CRIT_PCT), the work
#              folders on a drive at 88 % (past DISK_WARN_PCT) whose mount
#              point has a space in it, so `read` keeping the rest of the line
#              is exercised; anything else (/, DISK_PATHS) on the root drive
#   none       nothing exists — a header with no Disk: fragment, which is
#              what a host older than GHR-64 answers (GHR-66)
host_df() {
  local p row root="/dev/nvme0n1p2 ext4 500000000000 120000000000 380000000000 24 /"
  [ "${RUNNERCTL_STUB_DISKS:-}" != none ] || return 0
  for p in "$@"; do
    case "$p" in /missing*) continue ;; esac
    row="$root"
    if [ "${RUNNERCTL_STUB_DISKS:-}" = full ]; then
      case "$p" in
        /var/lib/docker)       row="/dev/sdb1 xfs 1000000000000 960000000000 40000000000 96 /var/lib/docker" ;;
        /opt/actions-runner/*) row="/dev/sdc1 ext4 2000000000000 1760000000000 240000000000 88 /srv/runner work" ;;
      esac
    fi
    printf '%s\t%s\n' "$p" "$row"
  done
}

# The journal search for host trouble (GHR-64), logged `probe:` with the
# --since epoch it was handed. RUNNERCTL_STUB_HOST_EVENTS:
#   (unset)    a readable journal with nothing in the window
#   events     two host-wide OOM kills (the old and new kernel wording), one
#              cgroup-limit OOM and one disk-full line from dockerd
#   no-access  fails, as journal_host_events does for a user outside
#              systemd-journal
#   hostile    one host-wide OOM kill and one disk-full line, the killed
#              process's name carrying a CSI and the line's syslog identifier
#              an OSC (GHR-100; an OSC, because the parse cuts an identifier
#              at its first `[`) — what a journalctl that did not escape them
#              would hand back
journal_host_events() {
  printf 'probe:journal_host_events %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  case "${RUNNERCTL_STUB_HOST_EVENTS:-}" in
    no-access) return 1 ;;
    hostile)
      printf '%s\n' $'999998000.100000 stub-host-1 kernel: Out of memory: Killed process 4100 (l\e[2Jd) total-vm:9000kB' \
        $'999999500.000000 stub-host-1 dock\e]0;x\aerd[812]: write /var/lib/docker/tmp/x: No space left on device'
      ;;
    events)
      echo '999998000.100000 stub-host-1 kernel: Out of memory: Kill process 4100 (ld) score 912 or sacrifice child'
      echo '999998100.000000 stub-host-1 kernel: Memory cgroup out of memory: Killed process 4200 (node) total-vm:9000kB'
      echo '999999500.000000 stub-host-1 dockerd[812]: failed to register layer: write /var/lib/docker/tmp/x: No space left on device'
      echo '1000000100.250000 stub-host-1 kernel: Out of memory: Killed process 4300 (cc1plus) total-vm:4000000kB, anon-rss:3900000kB'
      ;;
  esac
  return 0
}

# --when-idle's sleep (GHR-11): never sleeps, just logs the interval it was
# asked for, so a case can count polls and the run stays instant.
#
# GHR-91: RUNNERCTL_STUB_CUT_AT=K — the K-th pause of the run first waits
# (really, 5 s at most) until the reader of the command's stdout has gone:
# run_cut in tests/run.sh closes its end after N lines and only then touches
# `$RUNNERCTL_TEST_WRITES/.cut`. So every write after that pause meets a
# closed reader, at a known point, rather than wherever the two processes
# happen to be — `probe:cut_seen K`, or `probe:cut_gave_up K`.
pause() {
  printf 'probe:pause %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  if [ -n "${RUNNERCTL_STUB_CUT_AT:-}" ]; then
    local pf="${RUNNERCTL_TEST_WRITES:?}/.pauses" n=0 w=0
    [ ! -f "$pf" ] || n="$(cat "$pf")"
    n=$((n + 1)); echo "$n" >"$pf"
    if [ "$n" -eq "$RUNNERCTL_STUB_CUT_AT" ]; then
      while [ ! -e "$RUNNERCTL_TEST_WRITES/.cut" ] && [ "$w" -lt 250 ]; do
        sleep 0.02
        w=$((w + 1))
      done
      if [ -e "$RUNNERCTL_TEST_WRITES/.cut" ]; then
        printf 'probe:cut_seen %s\n' "$n" >>"$RUNNERCTL_TEST_LOG"
      else
        printf 'probe:cut_gave_up %s\n' "$n" >>"$RUNNERCTL_TEST_LOG"
      fi
    fi
  fi
  stub_clock_add "$1"
}

# `watch`'s terminal hooks (GHR-3): the harness captures stdout through a
# pipe, so the real `[ -t 1 ]` would always refuse; RUNNERCTL_STUB_TTY=1 lets
# a case reach the loop. The cursor hook only logs, so nothing tput would
# write reaches the captured frames.
stdout_is_tty() { [ "${RUNNERCTL_STUB_TTY:-0}" = 1 ]; }
term_cursor() { printf 'probe:term_cursor %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"; }

# GHR-33: the interactive loop's keyboard. `tty_read_char` (the one-character
# read the real loop makes with the interval as its timeout) hands out
# RUNNERCTL_STUB_KEYS one character per call, logged as
# `probe:tty_read_char <timeout> <char>`; a `-` in the string is a tick — the
# interval passed with no key (logged `probe:pause <timeout>`, as the real
# read's timeout path never is — the real one only pauses without a tty), and
# so is every call once the string is used up. Arrow keys are fed as their
# escape sequences ($'\e[B'), so the real read_key parser is what turns them
# into up/down. With the variable unset every call is a tick, which is what a
# headless `watch --iterations N` run never asks for anyway. The position is
# a plain variable: the loop calls this directly, never in a "$(...)".
#   RUNNERCTL_STUB_COLS            the terminal width `term_cols` answers;
#                                  default 0 = unknown, so nothing is dropped
# `page` (the L key's pager) is `cat`, logged, so the logs land in stdout.
#
# GHR-73: a `%` in the string is the terminal being RESIZED while the loop
# waits for a key — a real SIGWINCH sent to this process, so the script's own
# trap and handler run, inside the wait, exactly as they do under a real
# `read`. It is not a key and not a tick: the call goes on to the next
# character. Logged as `probe:winch`.
#
# GHR-74: Ctrl-C the same way — a real SIGINT to this process, so the script's
# own INT trap and its EXIT trap are what run. Logged `probe:sigint`.
#
# GHR-75: its spelling is the byte Ctrl-C IS, ETX ($'\x03'), and no longer
# `!`, which `fleet watch` now reads as a key of its own (problems only). ETX
# cannot collide with one: a terminal with ISIG on — which `read -n1` leaves
# on — turns that byte into the signal and never delivers it to a read.
#
# Unless the run INHERITED SIGINT ignored, which is what a non-interactive
# shell gives everything it starts with `&` — and a gate started that way
# hands it down to every case. Bash cannot trap a signal that was ignored when
# it started, so the INT would do nothing at all and the watch would poll on
# until the harness killed it (measured: the case passed under a plain `make
# sim` and timed out under a backgrounded one). There the ETX is a SIGTERM,
# which the watch answers on the same trap line; logged `probe:sigterm`, so a
# log says which of the two a run actually exercised.
#
# GHR-75: a newline in the string is Enter. The real `read -n1` stops at the
# line delimiter and hands back an EMPTY character for it, which is what
# read_key calls `enter`; so the stub hands back the same (logged `$'\n'`).
# A lone Escape is `$'\e-'`: read_key looks for the rest of a sequence with a
# second, short read, and the `-` is that read finding nothing.
stub_sigint_ignored() {
  local mask
  mask="$(awk '/^SigIgn:/ { print $2 }' "/proc/$$/status" 2>/dev/null || true)"
  [ -n "$mask" ] && [ $((16#$mask & 2)) -ne 0 ]
}
#
# GHR-74: `fleet watch`'s POLL STEP — the read it makes with FW_POLL as the
# timeout, while a host's background fetch is still out — is modelled, not
# slept through, and it is the one read that does NOT simply hand out the next
# character. Three things have to hold for a frame count to mean anything:
#
#   * The stub's remotes answer in milliseconds of REAL time and the scripted
#     keys arrive in none, so a step first waits (really, briefly, bounded)
#     until every fetch that is out has either landed or is a host the case
#     made HANG (RUNNERCTL_STUB_FLEET_HANG, below). Without that a `q` would
#     be read before the first answer and every case would race its own hosts.
#   * A step in which something LANDED is a step in which no key was pressed:
#     it times out and consumes nothing, so the loop draws that answer before
#     the next character is read — which is what happens at a real keyboard,
#     where an answer takes a fraction of a second and a keypress takes longer.
#     So does a step with nothing out at all.
#   * Only when nothing is left out but hung hosts does a step read the
#     script: a key is a key pressed WHILE THAT HOST IS OUTSTANDING (logged
#     `probe:tty_read_char <FW_POLL> <char>`, which is how a case shows it),
#     and a `-` is "no key until the next tick" — with RUNNERCTL_STUB_CLOCK=1
#     the clock jumps to FW_NEXT, standing in for the many empty steps a real
#     loop would make before the interval is up.
#
# Each modelled step logs `probe:fleet_poll landed=N hung=M`.
#
# GHR-125: an action key's background job is one more call out, and counted
# the same way: landed once its `rc` is written, hung while its remote is HELD
# (RUNNERCTL_STUB_FLEET_HOLD, below), else still moving. A step with an action
# out also logs `probe:act_poll landed=N held=M`, so a key logged
# `probe:tty_read_char 0.2 <char>` after `held=1` was handled WHILE THE
# ACTION WAS RUNNING. $'\x01' in RUNNERCTL_STUB_KEYS is not a key: it releases
# every held remote (`probe:release`), waits until their jobs have ended, and
# is a step with nothing pressed.
STUB_KEY_POS=0
STUB_ACT_LANDED=0 STUB_ACT_HELD=0 STUB_ACT_MOVING=0
stub_act_count() {
  local i
  STUB_ACT_LANDED=0 STUB_ACT_HELD=0 STUB_ACT_MOVING=0
  for i in "${!FW_ACT_PID[@]}"; do
    [ -n "${FW_ACT_PID[$i]}" ] || continue
    if [ -e "$FW_TMP/act.$i/rc" ]; then STUB_ACT_LANDED=$((STUB_ACT_LANDED + 1))
    elif stub_fleet_held "${FLEET_HOSTS[$i]}"; then STUB_ACT_HELD=$((STUB_ACT_HELD + 1))
    else STUB_ACT_MOVING=$((STUB_ACT_MOVING + 1))
    fi
  done
  # GHR-118: the history pane's read is one more call out, landed once its
  # `rc` is written. It is never held: a hung host is a delay over the budget.
  if [ -n "${FW_HIST_PID:-}" ]; then
    if [ -e "${FW_HIST_DIR:-}/rc" ]; then STUB_ACT_LANDED=$((STUB_ACT_LANDED + 1))
    else STUB_ACT_MOVING=$((STUB_ACT_MOVING + 1))
    fi
  fi
}
stub_fleet_poll() {
  local i n=0 landed hung moving
  while :; do
    landed=0 hung=0 moving=0
    for i in "${!FW_PID[@]}"; do
      [[ "${FW_PID[$i]}" == [0-9]* ]] || continue
      if [ -d "$FW_STATE/$i.done" ]; then landed=$((landed + 1))
      elif [ -e "${RUNNERCTL_TEST_WRITES:?}/remote/${FLEET_HOSTS[$i]}.hung" ]; then hung=$((hung + 1))
      else moving=$((moving + 1))
      fi
    done
    stub_act_count
    [ $((moving + STUB_ACT_MOVING)) -gt 0 ] || break
    n=$((n + 1))
    [ "$n" -lt 1000 ] || break
    sleep 0.01
  done
  printf 'probe:fleet_poll landed=%s hung=%s\n' "$landed" "$hung" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  if [ $((STUB_ACT_LANDED + STUB_ACT_HELD + STUB_ACT_MOVING)) -gt 0 ]; then
    printf 'probe:act_poll landed=%s held=%s\n' "$STUB_ACT_LANDED" "$STUB_ACT_HELD" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  fi
  landed=$((landed + STUB_ACT_LANDED)) hung=$((hung + STUB_ACT_HELD))
  [ "$landed" -gt 0 ] || [ "$hung" -eq 0 ]
}
# The release: every held remote goes on, and the step waits (really, briefly,
# bounded) until no action job is still moving, so what the loop takes in next
# is the actions' whole result.
stub_fleet_release() {
  local n=0
  : >"${RUNNERCTL_TEST_WRITES:?}/release"
  printf 'probe:release\n' >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  while :; do
    stub_act_count
    [ $((STUB_ACT_MOVING + STUB_ACT_HELD)) -gt 0 ] || break
    n=$((n + 1))
    [ "$n" -lt 1000 ] || break
    sleep 0.01
  done
}
tty_read_char() {
  local keys="${RUNNERCTL_STUB_KEYS:-}" poll=false
  KEY_CHAR=""
  if [ "$1" = "${FW_POLL:-}" ] && [ -n "${FW_STATE:-}" ]; then
    poll=true
    ! stub_fleet_poll || return 1
  fi
  while [[ "${keys:$STUB_KEY_POS:1}" == [%$'\x03'] ]]; do
    STUB_KEY_POS=$((STUB_KEY_POS + 1))
    if [ "${keys:$((STUB_KEY_POS - 1)):1}" = "%" ]; then
      printf 'probe:winch\n' >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
      kill -WINCH $$
    elif stub_sigint_ignored; then
      printf 'probe:sigterm\n' >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
      kill -TERM $$
    else
      printf 'probe:sigint\n' >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
      kill -INT $$
    fi
  done
  if [ "${keys:$STUB_KEY_POS:1}" = $'\x01' ]; then
    STUB_KEY_POS=$((STUB_KEY_POS + 1))
    stub_fleet_release
    return 1
  fi
  if [ "$STUB_KEY_POS" -lt "${#keys}" ]; then
    KEY_CHAR="${keys:$STUB_KEY_POS:1}"
    STUB_KEY_POS=$((STUB_KEY_POS + 1))
    if [ "$KEY_CHAR" != "-" ]; then
      printf 'probe:tty_read_char %s %q\n' "$1" "$KEY_CHAR" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
      [ "$KEY_CHAR" != $'\n' ] || KEY_CHAR=""
      return 0
    fi
    KEY_CHAR=""
  fi
  printf 'probe:tty_read_char %s none\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  pause "$1"
  ! $poll || stub_clock_to "$((FW_NEXT / 1000))"
  return 1
}
# A comma list is a terminal resized between redraws: one entry per call, the
# last one repeated. The position lives in a file beside the log because every
# caller reads the width through "$(term_cols)", a subshell a variable would
# not survive.
term_cols() {
  local -a seq
  local posf="${RUNNERCTL_TEST_LOG:?}.cols" pos=0
  IFS=, read -r -a seq <<<"${RUNNERCTL_STUB_COLS:-0}"
  [ ! -f "$posf" ] || pos="$(cat "$posf")"
  echo $((pos + 1)) >"$posf"
  [ "$pos" -lt "${#seq[@]}" ] || pos=$((${#seq[@]} - 1))
  echo "${seq[$pos]}"
}
# GHR-73: the terminal's height, the same way — RUNNERCTL_STUB_LINES, default
# 0 = unknown, so no frame is fitted and every case from before this existed
# draws what it drew. A comma list is a terminal resized between two frames;
# its position file is the log's `.lines` twin.
term_lines() {
  local -a seq
  local posf="${RUNNERCTL_TEST_LOG:?}.lines" pos=0
  IFS=, read -r -a seq <<<"${RUNNERCTL_STUB_LINES:-0}"
  [ ! -f "$posf" ] || pos="$(cat "$posf")"
  echo $((pos + 1)) >"$posf"
  [ "$pos" -lt "${#seq[@]}" ] || pos=$((${#seq[@]} - 1))
  echo "${seq[$pos]}"
}
page() { printf 'probe:page\n' >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"; cat; }

# GHR-86: `fleet watch`'s `:` prompt reads a LINE (`read -e`), which the
# scripted keys cannot type: `-` is a tick and `%` a SIGWINCH there, and both
# are in fleet commands. So tty_read_line hands out RUNNERCTL_STUB_PROMPT_IN,
# one newline-separated line per call (an empty line is what Esc gives the real
# one: the caller's "cancelled"), and returns 1 — end of input — once they are
# used up. Each call is logged `probe:tty_read_line PROMPT N LAST %q-LINE`: N
# the history lines it was handed, LAST the newest of them (%q, `-` for none),
# which is what ↑ would bring back. The position is a plain variable, as
# tty_read_char's is: the loop calls this directly.
STUB_LINE_POS=0
tty_read_line() { # PROMPT [HISTORY...]
  local prompt="$1" last=- l
  local -a lines=()
  shift
  LINE_TEXT=""
  [ $# -eq 0 ] || printf -v last %q "${!#}"
  mapfile -t lines <<<"${RUNNERCTL_STUB_PROMPT_IN:-}"
  if [ -z "${RUNNERCTL_STUB_PROMPT_IN:-}" ] || [ "$STUB_LINE_POS" -ge "${#lines[@]}" ]; then
    printf 'probe:tty_read_line %s %s %s eof\n' "$prompt" "$#" "$last" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
    return 1
  fi
  LINE_TEXT="${lines[$STUB_LINE_POS]}"
  STUB_LINE_POS=$((STUB_LINE_POS + 1))
  printf -v l %q "$LINE_TEXT"
  printf 'probe:tty_read_line %s %s %s %s\n' "$prompt" "$#" "$last" "$l" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
}

# The /proc side, as seen by a user who is neither root nor the runner user:
# no cgroup is readable (so the fallback path answers `(no access)`), no
# Runner.Worker pid is found (so the runtime comes from the journal stamp).
# proc_job_env still answers for slot-1's cgroup so the repo enrichment is
# exercised. The cgroup hand-off from unit_props (GHR-4) stays detectable:
# job_info answers `—` for an empty cgroup before it asks any of these, and
# the slot-1 row regex rejects that. RUNNERCTL_STUB_CGROUP_READABLE=1 makes
# every non-empty cgroup readable (root / the runner user), which with the
# journal unreadable reaches the /proc-only reader's `idle ?` (GHR-2).
cgroup_readable() { [ "${RUNNERCTL_STUB_CGROUP_READABLE:-0}" = 1 ] && [ -n "${1:-}" ]; }
# compose-reap: RUNNERCTL_STUB_COMPOSE_WORKER=1 gives slot-1 a Runner.Worker.
proc_worker_pid() {
  [ "${RUNNERCTL_STUB_COMPOSE_WORKER:-0}" = 1 ] || return 0
  case "${1:-}" in *slot-1*) echo 5555 ;; esac
}
# GHR-29: slot-2 (idle) has two leaked processes when asked for; logged
# with a `probe:` prefix so a case can assert the walk is only made for an
# idle slot. pid_alive answers from RUNNERCTL_STUB_SURVIVORS.
proc_leaked() {
  printf 'probe:proc_leaked %s\n' "${1:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "${RUNNERCTL_STUB_LEAKED:-0}" = 1 ] || return 0
  # GHR-76: RUNNERCTL_STUB_LEAK_COMM replaces the first one's comm, which is
  # text a process chose (one line, no tab — the hook's contract).
  case "${1:-}" in
    *slot-2*) printf '4242\t%s\n4243\tesbuild\n' "${RUNNERCTL_STUB_LEAK_COMM:-node}" ;;
  esac
}
# GHR-36: slot-1 (busy) is running a job as Runner.Worker 4100 with one step
# child 4101; slot-2 (idle) has only the Listener left. Logged with a
# `probe:` prefix so a case can assert the walk happened — and that `kill`
# never made it for a slot it refused.
# GHR-100: RUNNERCTL_STUB_TREE_COMM replaces the step child's comm (`node`),
# for hostile text — the same contract as RUNNERCTL_STUB_LEAK_COMM.
proc_job_tree() {
  printf 'probe:proc_job_tree %s\n' "${1:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  case "${1:-}" in
    *slot-1*) printf '4100\tRunner.Worker\n4101\t%s\n' "${RUNNERCTL_STUB_TREE_COMM:-node}" ;;
  esac
}

# GHR-31: the cgroup's memory.events / memory.pressure, pinned per slot.
cgroup_memory_facts() {
  printf 'probe:cgroup_memory_facts %s\n' "${1:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "${RUNNERCTL_STUB_PRESSURE:-0}" = 1 ] && [ -n "${1:-}" ] || return 0
  case "$1" in
    *slot-1*) printf 'events_high=4\nevents_max=1\nevents_oom_kill=0\npressure_full_avg10=63.20\npressure_full_avg60=41.00\npressure_full_total=123456789\n' ;;
    *slot-2*) printf 'events_high=0\nevents_max=0\nevents_oom_kill=0\npressure_full_avg10=0.00\npressure_full_avg60=0.00\npressure_full_total=0\n' ;;
  esac
}
# GHR-79: the cgroup's cpu.stat / cpu.pressure, per slot, and the clock a CPU
# sample is timed by. By default no slot has CPU accounting (no usage_usec),
# so every CPU cell is `—`, nothing waits and every older case reads what it
# read. RUNNERCTL_STUB_CPU="N:MILLICORES …" gives slot-N a counter that runs
# at that many thousandths of a core: usage_usec = base + millicores × the µs
# the stub clock has moved / 1000, with a DIFFERENT base per slot (slot-1
# 9e9, slot-2 1e9, slot-3 5e9) — so a rate taken against another slot's
# sample is far off or negative, never right by accident. Each read is logged
# `probe:cgroup_cpu_facts`. RUNNERCTL_STUB_CPU_RESET=1 makes every counter go
# BACKWARDS once the clock has moved (a unit restarted between two reads).
# The `some` pressure line is pinned for slot-1 (12.50 / 8.00 / 5555) and
# 0.00 for slot-2, where they have accounting. A fleet host named in
# RUNNERCTL_STUB_FLEET_NOCPU answers with the table of a release from before
# the CPU column (see the `status` arm of ssh_run_body).
stub_cpu_base() { # CGROUP
  case "$1" in *slot-1*) echo 9000000000 ;; *slot-2*) echo 1000000000 ;; *) echo 5000000000 ;; esac
}
cgroup_cpu_facts() {
  printf 'probe:cgroup_cpu_facts %s\n' "${1:-}" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ -n "${1:-}" ] || return 0
  local e n="" m="" moved
  for e in ${RUNNERCTL_STUB_CPU:-}; do
    case "$1" in *slot-"${e%%:*}".*) n="${e%%:*}" m="${e#*:}" ;; esac
  done
  [ -n "$n" ] || return 0
  moved=$(( $(now_us) - 1000000720000000 ))
  if [ "${RUNNERCTL_STUB_CPU_RESET:-0}" = 1 ] && [ "$moved" -gt 0 ]; then
    echo "usage_usec=100"
  else
    echo "usage_usec=$(( $(stub_cpu_base "$1") + m * moved / 1000 ))"
  fi
  case "$n" in
    1) printf 'pressure_some_avg10=12.50\npressure_some_avg60=8.00\npressure_some_total=5555\n' ;;
    2) printf 'pressure_some_avg10=0.00\npressure_some_avg60=0.00\npressure_some_total=0\n' ;;
  esac
}
# The sample clock: the pinned epoch clock in µs plus every cpu_window_wait so
# far — kept in a file under the writes tree (a "$(now_us)" subshell would not
# keep a variable), one per remote host, because fleet hosts answer in
# parallel background subshells and must not move each other's clock.
stub_cpu_clock_file() { echo "${RUNNERCTL_TEST_WRITES:?}/.cpu-clock${STUB_REMOTE_HOST:+.$STUB_REMOTE_HOST}"; }
now_us() {
  local f off=0
  f="$(stub_cpu_clock_file)"
  [ ! -f "$f" ] || off="$(cat "$f")"
  echo $(( $(now_epoch) * 1000000 + off * 1000 ))
}
cpu_window_wait() {
  printf 'probe:cpu_window_wait %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  local f off=0
  f="$(stub_cpu_clock_file)"
  [ ! -f "$f" ] || off="$(cat "$f")"
  echo $((off + $1)) >"$f"
}
# GHR-79: /proc/loadavg. Unreadable by default (no `load` fragment on the
# header, `"load":null`), so every older header pin holds;
# RUNNERCTL_STUB_LOAD="L1 L5 L15" answers those three figures.
host_loadavg() {
  [ -n "${RUNNERCTL_STUB_LOAD:-}" ] || return 0
  echo "$RUNNERCTL_STUB_LOAD"
}

pid_alive() {
  printf 'probe:pid_alive %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  local p
  for p in ${RUNNERCTL_STUB_SURVIVORS:-}; do [ "$p" != "$1" ] || return 0; done
  return 1
}
# GHR-78: slot-1's step environment. By default the two variables it always
# had, so every older case reads what it read. RUNNERCTL_STUB_RUN=1 adds the
# run's — workflow CI, run 1234567890 attempt 2 (#57), ref main, a commit,
# actor octocat, event push, server https://github.com — and gives slot-2 an
# environment too: job `build` of the same repository, workflow Release, run
# 1234567891 attempt 1, ref v1.2.3. Slot-2's only shows under the /proc-only
# reader (journal unreadable, cgroup readable): the journal reader finds it
# idle and never asks. That is the two-busy-slots fixture the O cases need —
# two jobs of ONE repository, told apart by nothing but the run.
#
# RUNNERCTL_STUB_RUN_<NAME> (REPOSITORY, JOB, WORKFLOW, RUN_ID, RUN_ATTEMPT,
# RUN_NUMBER, REF_NAME, SHA, ACTOR, EVENT_NAME, SERVER_URL) replaces one of
# slot-1's values, for the hostile ones; set and empty leaves the variable
# out. One line per variable is the hook's contract (the real one turns a
# newline inside a value into a space before it prints), so a value with a
# newline in it is a case for the real reader, not for this stub.
stub_job_var() { # NAME DEFAULT
  local ov="RUNNERCTL_STUB_RUN_$1" v
  v="${!ov-$2}"
  [ -z "$v" ] || printf 'GITHUB_%s=%s\n' "$1" "$v"
}
proc_job_env() {
  # GHR-102: RUNNERCTL_STUB_ENV_ONCE=1 — slot-1's step environment is there for
  # the first read of a run and gone for every one after it (between two
  # steps, a container step). The count is a file under the writes tree, since
  # every caller reads this hook through a "$(...)". Logged `probe:proc_job_env`.
  case "${1:-}" in
    *slot-1*)
      if [ "${RUNNERCTL_STUB_ENV_ONCE:-0}" = 1 ]; then
        local once="${RUNNERCTL_TEST_WRITES:?RUNNERCTL_TEST_WRITES unset}/.env-once"
        printf 'probe:proc_job_env %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?}"
        [ ! -f "$once" ] || return 0
        : >"$once"
      fi
      stub_job_var REPOSITORY example/my-app
      stub_job_var JOB test
      [ "${RUNNERCTL_STUB_RUN:-0}" = 1 ] || return 0
      stub_job_var WORKFLOW CI
      stub_job_var RUN_ID 1234567890
      stub_job_var RUN_ATTEMPT 2
      stub_job_var RUN_NUMBER 57
      stub_job_var REF_NAME main
      stub_job_var SHA 0123456789abcdef0123456789abcdef01234567
      stub_job_var ACTOR octocat
      stub_job_var EVENT_NAME push
      stub_job_var SERVER_URL https://github.com ;;
    *slot-2*)
      [ "${RUNNERCTL_STUB_RUN:-0}" = 1 ] || return 0
      printf 'GITHUB_%s\n' REPOSITORY=example/my-app JOB=build WORKFLOW=Release RUN_ID=1234567891 \
        RUN_ATTEMPT=1 RUN_NUMBER=12 REF_NAME=v1.2.3 SHA=89abcdef0123456789abcdef0123456789abcdef \
        ACTOR=octocat EVENT_NAME=release SERVER_URL=https://github.com ;;
    *)        ;;
  esac
}

# Safety net: nothing above should ever reach the real binaries. If a code
# path bypasses run_priv/discover/prop, the call lands here, is logged with a
# `direct:` marker (tests/run.sh fails any case whose log carries one), and
# does nothing.
systemctl()  {
  # GHR-87: the two read-only questions compose_reap_timer_state asks about
  # the compose-reap timer, answered `enabled` / `active` (or what
  # RUNNERCTL_STUB_TIMER_STATE="ENABLED ACTIVE" says) and logged as probes.
  case "$*" in
    "is-enabled runnerctl-compose-reap.timer"|"is-active runnerctl-compose-reap.timer")
      printf 'probe:systemctl %s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?}"
      local st="${RUNNERCTL_STUB_TIMER_STATE:-enabled active}"
      if [ "$1" = is-enabled ]; then echo "${st%% *}"; else echo "${st#* }"; fi
      return 0 ;;
  esac
  printf 'direct:systemctl %s\n'  "$*" >>"${RUNNERCTL_TEST_LOG:?}"
}
journalctl() {
  # GHR-65: reached from the real journal_job_lines under the EMPTY knob only:
  # a readable, empty journal. -g finds nothing (exit 1, as journalctl does),
  # anything else (the -n 1 access probe) succeeds.
  if [ "${STUB_JL_REAL:-0}" = 1 ]; then
    case " $* " in *" -g "*) return 1 ;; *) return 0 ;; esac
  fi
  printf 'direct:journalctl %s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?}"
}
sudo()       { printf 'direct:sudo %s\n'       "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }
# GHR-88: the journal record. audit_logger is the one sanctioned path, and it
# is shadowed: every record lands here as `probe:audit <the line>`, so a case
# asserts the exact line, and that there is exactly one. `logger` itself is
# the safety net, like systemctl above — and so is a fake `logger` BINARY
# first on PATH for the whole sim (tests/run.sh), since the real audit_logger
# runs it through `timeout`, which no shell function can shadow.
# RUNNERCTL_STUB_AUDIT=real leaves the real audit_logger in place, for the
# cases about what a missing or failing logger does: that binary is then what
# it reaches, and FAKE_LOGGER says how it behaves.
logger()     { printf 'direct:logger %s\n'     "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }
if [ "${RUNNERCTL_STUB_AUDIT:-}" != real ]; then
  audit_logger() { printf 'probe:audit %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?}"; }
fi
# GHR-88: `history`'s journal read. RUNNERCTL_STUB_HISTORY names a file of
# journalctl short-iso-precise lines (a remote host's is that file with
# `.<host>` appended, when there is one); unset, the journal has no record.
# Logged as `probe:journal_history_lines N` — the real reader is covered over
# a fake journalctl on PATH through run_fn. RUNNERCTL_STUB_HISTORY_RC fails it.
journal_history_lines() { # N
  local f="${RUNNERCTL_STUB_HISTORY:-}"
  printf 'probe:journal_history_lines %s\n' "$1" >>"${RUNNERCTL_TEST_LOG:?}"
  [ -z "${RUNNERCTL_STUB_HISTORY_RC:-}" ] || return "$RUNNERCTL_STUB_HISTORY_RC"
  [ -z "$STUB_REMOTE_HOST" ] || [ ! -f "$f.$STUB_REMOTE_HOST" ] || f="$f.$STUB_REMOTE_HOST"
  [ -z "$f" ] || tail -n "$1" "$f"
}
# GHR-39: the same net under the fleet transport. ssh_run below is the one
# sanctioned path; anything reaching `ssh` itself has bypassed it, and the
# whole testability story for fleet mode depends on that not happening.
ssh()        { printf 'direct:ssh %s\n'        "$*" >>"${RUNNERCTL_TEST_LOG:?}"; }
# GHR-54: the second sanctioned path — control-socket administration, which
# carries no remote command and so cannot go through ssh_run. Shadowed for the
# same reason ssh_run is: a real `ssh -O exit` here would dial out of the test.
ssh_control() { # HOST OPERATION
  printf 'probe:ssh_control %s %s\n' "$1" "$2" >>"${RUNNERCTL_TEST_LOG:?}"
}

# --- Fleet transport (GHR-39) -------------------------------------------------
# The fleet inventory, from a per-run env knob so each case picks its own.
# SC2034 disabled for the same reason the SC1090s in runnerctl are: this file
# is SOURCED, and FLEET_HOSTS is read by the script that sources it — not
# visible to the linter from in here. Setting a config variable is the entire
# job of a config file.
# shellcheck disable=SC2034
if [ -n "${RUNNERCTL_STUB_FLEET_HOSTS:-}" ]; then
  read -r -a FLEET_HOSTS <<<"$RUNNERCTL_STUB_FLEET_HOSTS"
fi
# GHR-77: THIS node's version, for a case that needs the central node on a
# particular release (0.10.0 against a host on 0.9.0, where a string compare
# and a version compare disagree). Every stub host answers it too, unless
# RUNNERCTL_STUB_FLEET_VER or an *oldver* name says otherwise: the remote
# runs in a subshell of this process.
# shellcheck disable=SC2034
if [ -n "${RUNNERCTL_STUB_VERSION:-}" ]; then
  RUNNERCTL_VERSION="$RUNNERCTL_STUB_VERSION"
fi
# GHR-89: the narrow sudo contract, per run. Taken as given, so a case can
# hand it a bad value and see load_config refuse it.
# shellcheck disable=SC2034
FLEET_SUDO="${RUNNERCTL_STUB_FLEET_SUDO:-0}"
# GHR-88: the central node's record goes under the run's writes tree — never
# the box's own ~/.local/state, which every fleet case would otherwise append
# to. RUNNERCTL_STUB_FLEET_LOG=default leaves FLEET_LOG empty, for the case
# about the default path (it points HOME at a temp directory); any other
# value is the path itself.
# shellcheck disable=SC2034
case "${RUNNERCTL_STUB_FLEET_LOG:-}" in
  default) ;;
  '') FLEET_LOG="${RUNNERCTL_TEST_WRITES:-/nonexistent}/fleet.log" ;;
  *)  FLEET_LOG="$RUNNERCTL_STUB_FLEET_LOG" ;;
esac

# Stands in for one ssh round trip. The host NAME chooses the outcome, so a
# case composes a fleet out of the behaviours it wants to see:
#   *unreachable*  ssh itself fails      (255)
#   *timeout*      the call runs out     (124)
#   *norunners*    remote runnerctl dies (1) — a real host state, not a fault
#   *garbage*      exit 0, not JSON      (the payload-sanity path)
#   *oldver*       answers as 0.0.1      (the version-skew note)
#   anything else  a healthy host
#
# A healthy host renders through the script's OWN renderers rather than a
# hand-written imitation of their output: an imitation would drift from the
# real table the first time a column is added, and the fan-out would keep
# passing against output no host produces. fleet_fanout runs each call in a
# background subshell, so the globals these touch cannot leak between hosts.
# Entry marker, the overlap detector, the body, then the exit marker.
#
# The exit marker is emitted by this WRAPPER rather than by a RETURN trap
# inside the body. A RETURN trap set in a function stays installed after that
# function returns, so it fires again for unrelated functions later — with
# $host out of scope, which under `set -u` aborts the run. GHR-43 did not hit
# it only because every ssh_run ran inside a background subshell that took
# the trap with it; GHR-44 calls ssh_run directly, and it surfaced at once.
# GHR-55: per-remote-host state for `fleet watch`'s action keys. Empty outside
# a remote call, so the local `status`/`watch` cases never see any of it.
STUB_REMOTE_HOST=""
STUB_ORIGIN=""
stub_fleet_nosudo() { [ -n "${RUNNERCTL_STUB_FLEET_NOSUDO:-}" ] && [[ "$1" =~ $RUNNERCTL_STUB_FLEET_NOSUDO ]]; }
# What a start/stop/restart left UNIT (by RUNNER name) in on this host.
#
# GHR-90: RUNNERCTL_STUB_FLEET_FLIP="host…" — that host's slot-1 changes
# state on EVERY collection of it: the odd ones find it as usual, the even
# ones `inactive`. Counted in remote/<host>.flip, one per unit_props call, so
# a table and a payload taken from one collection agree on slot-1 and two
# collections of one tick never do.
stub_remote_state() { # UNIT
  local s="${1#actions.runner.}" f n=0
  s="${s%.service}"
  [ -n "$STUB_REMOTE_HOST" ] || return 0
  if [ "$s" = example.slot-1 ] && [[ " ${RUNNERCTL_STUB_FLEET_FLIP:-} " == *" $STUB_REMOTE_HOST "* ]]; then
    f="${RUNNERCTL_TEST_WRITES:?}/remote/$STUB_REMOTE_HOST.flip"
    mkdir -p "${RUNNERCTL_TEST_WRITES}/remote"
    [ ! -f "$f" ] || n="$(cat "$f")"
    n=$((n + 1)); echo "$n" >"$f"
    [ $((n % 2)) = 1 ] || echo inactive
    return 0
  fi
  f="${RUNNERCTL_TEST_WRITES:-/nonexistent}/remote/$STUB_REMOTE_HOST/$s"
  [ ! -f "$f" ] || cat "$f"
}
# Whether this host has scaled down to two slots (RUNNERCTL_STUB_FLEET_SCALED).
stub_remote_scaled() {
  local want polls=0 pf
  [ -n "$STUB_REMOTE_HOST" ] || return 1
  [[ " ${RUNNERCTL_STUB_FLEET_SCALED:-} " == *" $STUB_REMOTE_HOST:"* ]] || return 1
  want="${RUNNERCTL_STUB_FLEET_SCALED#*"$STUB_REMOTE_HOST":}"; want="${want%% *}"
  pf="${RUNNERCTL_TEST_WRITES:-/nonexistent}/remote/$STUB_REMOTE_HOST.polls"
  [ ! -f "$pf" ] || polls="$(cat "$pf")"
  [ "$polls" -ge "$want" ]
}

# GHR-81: how long a remote call TAKES, so a case can put one on either side
# of its budget without the gate sleeping through it.
#   RUNNERCTL_STUB_FLEET_DELAY="build-1:45"        every call to build-1: 45 s
#   RUNNERCTL_STUB_FLEET_DELAY="build-1:45:drain"  only its `drain` calls
# Space-separated entries, first match wins; the third field is an ERE the
# whole subcommand must match. No match is 0 s.
#
# GHR-74: a fourth field is the FRAME POLL the delay starts at, so a host can
# answer a watch's first ticks and then go slow — for every call from then on,
# the reads an action key makes included:
#   RUNNERCTL_STUB_FLEET_DELAY="build-2:99:status:2"  slow from its 2nd poll
stub_fleet_delay() { # HOST SUBCOMMAND POLL-NO
  local e h secs pat from
  for e in ${RUNNERCTL_STUB_FLEET_DELAY:-}; do
    IFS=: read -r h secs pat from <<<"$e"
    [ "$h" = "$1" ] || continue
    [ -z "$pat" ] || [[ "$2" =~ ^($pat)$ ]] || continue
    [ -z "$from" ] || [ "${3:-0}" -ge "$from" ] || continue
    echo "$secs"; return 0
  done
  echo 0
}
# Which of HOST's frame polls a call belongs to: the table calls it has
# answered so far (the count the `status` arm below keeps), plus this one when
# this call IS a table call — `status` without --json. A --json read made
# between two ticks therefore belongs to the tick before it.
stub_fleet_poll_no() { # HOST RUNNERCTL-WORD [SUBCOMMAND [ARGS...]]
  local pf="${RUNNERCTL_TEST_WRITES:-/nonexistent}/remote/$1.polls" polls=0
  [ ! -f "$pf" ] || polls="$(cat "$pf")"
  if [ "${3:-status}" = status ] && stub_frame_poll "${@:4}"; then polls=$((polls + 1)); fi
  echo "$polls"
}
# Whether a `status` call with ARGS is a frame poll: the table, not a --json
# read — except under RUNNERCTL_STUB_FLEET_JSON_POLLS=1 (GHR-80), where the
# `--json` call IS the poll, as it is for `fleet status --json --watch`. Then
# RUNNERCTL_STUB_FLEET_DOWN and _HANG reach that call too.
stub_frame_poll() { # ARGS...
  [ "${RUNNERCTL_STUB_FLEET_JSON_POLLS:-0}" = 1 ] || [[ " $* " != *" --json "* ]]
}
# GHR-74: a host that accepts the call and then says NOTHING — the case the
# watch's background fetch exists for.
#   RUNNERCTL_STUB_FLEET_HANG="slow-1"      its table calls never return
#   RUNNERCTL_STUB_FLEET_HANG="build-2:2"   from its 2nd frame poll on
# Unlike RUNNERCTL_STUB_FLEET_DELAY, which answers 124 at once for a call
# that would outlast its budget, this one really does not come back: the call
# blocks until the process running it is killed — which is what a case about
# cleanup asserts — or 30 s of real time have gone by, so a run that forgets
# to kill it cannot leave a spinner behind for good. It says it is hanging in
# `remote/<host>.hung` (what stub_fleet_poll reads) and leaves the pid of the
# blocked call, and of the fetch job above it, in `remote/<host>.hung.pids`.
stub_fleet_hangs() { # HOST POLL-NO
  local e h from
  for e in ${RUNNERCTL_STUB_FLEET_HANG:-}; do
    IFS=: read -r h from <<<"$e"
    [ "$h" = "$1" ] || continue
    [ "$2" -ge "${from:-1}" ] || continue
    return 0
  done
  return 1
}

# GHR-82: a remote `upgrade` that wrote the script the fleet path runs.
stub_fleet_upgraded() { # HOST
  mkdir -p "${RUNNERCTL_TEST_WRITES:?}/remote"
  : >"$RUNNERCTL_TEST_WRITES/remote/$1.upgraded"
}

# GHR-86: what the host's login shell makes of a call. ssh joins its argv with
# blanks and the remote shell parses and expands that string again — which
# this stub otherwise skips, handing ssh_run_body the argv as it was. With
# RUNNERCTL_STUB_REMOTE_SH=1 the joined text (the origin taken off, as above)
# is also handed to a real /bin/sh, under `env -i` in $WRITES/remote-sh/,
# which prints each word it ends up with: `probe:remote_words HOST <w1><w2>…`.
# A word that was not quoted for it is split there, or runs: a `>file` in it
# leaves that file in remote-sh/.
stub_remote_words() { # HOST TEXT
  local d="${RUNNERCTL_TEST_WRITES:?}/remote-sh" words=""
  mkdir -p "$d"
  words="$(cd "$d" && env -i PATH=/usr/bin:/bin /bin/sh -c "set -- $2; printf '<%s>' \"\$@\"" 2>/dev/null)" || true
  printf 'probe:remote_words %s %s\n' "$1" "$words" >>"${RUNNERCTL_TEST_LOG:?}"
}

ssh_run() { # HOST COMMAND...
  local host="$1" rc=0 at=1 origin=""
  # GHR-54: what the persistent-connection session put in front of the
  # command, logged only when there IS one — so every pre-existing case's log
  # is unchanged, and a polling case can assert the master options exist on
  # every call rather than only on the first.
  if [ "${#FLEET_SSH_CONTROL_OPTS[@]}" -gt 0 ]; then
    printf 'probe:ssh_control_opts %s\n' "${FLEET_SSH_CONTROL_OPTS[*]}" >>"${RUNNERCTL_TEST_LOG:?}"
  fi
  # GHR-88: `--origin=OPERATOR@HOST` is a global flag, so on a real host it is
  # read by main, in exactly one place: the word after the FLEET_RUNNERCTL
  # word (after `sudo -n`, under FLEET_SUDO=1). There it is taken off the
  # command line and logged on a line of its own — `probe:ssh_origin HOST
  # VALUE`, before the call's own — so `probe:ssh_run` reads as it always has
  # and every case pins the rest of the argv exactly. Anywhere else it is
  # left where it is, where it breaks those pinned lines, as a misplaced flag
  # would break a host. A host named *preorigin* runs a runnerctl from before
  # the flag: main refuses it as an unknown command, exit 1, and does nothing.
  # Any other host takes it as main does (audit_origin_take), so a remote that
  # runs real code — `health` — records `via fleet from …`.
  [ "${2:-}" != sudo ] || at=3
  local -a argv=("${@:2}")
  if [[ "${argv[$at]:-}" == --origin=* ]]; then
    origin="${argv[$at]#--origin=}"
    argv=("${argv[@]:0:$at}" "${argv[@]:$((at + 1))}")
    printf 'probe:ssh_origin %s %s\n' "$host" "$origin" >>"${RUNNERCTL_TEST_LOG:?}"
  fi
  set -- "$host" "${argv[@]}"
  printf 'probe:ssh_run %s -- %s\n' "$host" "${*:2}" >>"${RUNNERCTL_TEST_LOG:?}"
  [ "${RUNNERCTL_STUB_REMOTE_SH:-0}" != 1 ] || stub_remote_words "$host" "${*:2}"
  if [ -n "$origin" ] && [[ "$host" == *preorigin* ]]; then
    echo "runnerctl: unknown command '--origin' (status watch health fleet provision deprovision apply scale env-init start stop restart drain enable disable logs remove-limits reap kill compose-reap compose-reap-timer profiles config-example migrate install upgrade version)" >&2
    printf 'probe:ssh_run_done %s\n' "$host" >>"${RUNNERCTL_TEST_LOG:?}"
    return 1
  fi
  STUB_ORIGIN="$origin"
  # GHR-55: in a subshell, because a remote is another process and nothing it
  # sets can reach the caller. A fan-out already runs every call in the
  # background, but `fleet watch`'s action keys call ssh_run one host at a
  # time, and the status arm below resets the stall threshold, the column set
  # and the colour mode — which would otherwise land in the watch itself.
  if [[ "$host" == *hostile* ]]; then
    stub_hostile_run "$@" || rc=$?
  else
    (ssh_run_body "$@") || rc=$?
  fi
  printf 'probe:ssh_run_done %s\n' "$host" >>"${RUNNERCTL_TEST_LOG:?}"
  # GHR-80: RUNNERCTL_STUB_FLEET_MS="host:ms …" — how long each call to that
  # host takes, as now_ms sees it from the caller (first match wins).
  local e
  for e in ${RUNNERCTL_STUB_FLEET_MS:-}; do
    [ "${e%%:*}" = "$host" ] || continue
    STUB_MS_ADD=$((STUB_MS_ADD + ${e#*:})); break
  done
  return "$rc"
}

# --- fleet upgrade --push (GHR-83) ----------------------------------------------
# ssh_run_stdin: what the host RECEIVED is kept as `remote/<host>.received`
# (logged `probe:ssh_run_stdin HOST -- TEXT`), and the call is then answered by
# ssh_run_body with those bytes on stdin. A host named *mangle* receives them
# with one byte changed in transit (line 2's first `r` made `R`, a comment, so
# the script still parses), which the host's own sha256 check must refuse.
ssh_run_stdin() { # HOST FILE -- COMMAND...
  local host="$1" file="$2" rc=0 got
  shift 2
  [ "${1:-}" != -- ] || shift
  printf 'probe:ssh_run_stdin %s -- %s\n' "$host" "$*" >>"${RUNNERCTL_TEST_LOG:?}"
  mkdir -p "${RUNNERCTL_TEST_WRITES:?}/remote"
  got="$RUNNERCTL_TEST_WRITES/remote/$host.received"
  cp "$file" "$got"
  case "$host" in *mangle*) sed -i '2s/r/R/' "$got" ;; esac
  (ssh_run_body "$host" "$@") <"$got" || rc=$?
  printf 'probe:ssh_run_done %s\n' "$host" >>"${RUNNERCTL_TEST_LOG:?}"
  return "$rc"
}

# A push host is a directory, `remote/<host>/`, made on its first call: bin/
# (where its runnerctl is, first on its PATH), tmp/ (its TMPDIR, so a temp
# file left behind is visible), etc/ (the config its install is pointed at),
# and fake/ — its own `sudo` and `logger`, ahead of /usr/bin. Its runnerctl
# is made from this node's (FLEET_PUSH_SRC), by name:
#   *absent*    none at all — FLEET_RUNNERCTL resolves to nothing (127)
#   *pushsame*  this node's bytes exactly
#   *ahead*     this node's script stamped 9.9.9 — newer than this node
#   anything else  this node's script stamped 0.0.1 — older, and differs
stub_push_host() { # HOST
  local d="${RUNNERCTL_TEST_WRITES:?}/remote/$1"
  [ ! -d "$d" ] || return 0
  mkdir -p "$d/bin" "$d/tmp" "$d/etc" "$d/home" "$d/fake"
  # An empty config of the host's own: its install is pointed at it, so it
  # never reads this box's /etc/runnerctl/config.
  : >"$d/etc/config"
  chmod 644 "$d/etc/config"
  case "$1" in
    *absent*)   ;;
    *pushsame*) cp "$FLEET_PUSH_SRC" "$d/bin/runnerctl" ;;
    *ahead*)    sed 's/^RUNNERCTL_VERSION="[^"]*"/RUNNERCTL_VERSION="9.9.9"/' "$FLEET_PUSH_SRC" >"$d/bin/runnerctl" ;;
    *)          sed 's/^RUNNERCTL_VERSION="[^"]*"/RUNNERCTL_VERSION="0.0.1"/' "$FLEET_PUSH_SRC" >"$d/bin/runnerctl" ;;
  esac
  [ ! -f "$d/bin/runnerctl" ] || { chmod 755 "$d/bin/runnerctl"; cp "$d/bin/runnerctl" "$d/before"; }
  # The host's sudo. It logs what it was asked (`probe:remote_push_sudo HOST
  # -- ARGS`), refuses without -n as a prompt would hang, refuses on a
  # *nosudo* host as sudo does, and refuses anything but `bash FILE`: a piped
  # `bash -s` install DOWNLOADS, which no case may do (logged
  # `probe:remote_push_piped`). Otherwise it runs the REAL install of FILE as
  # this user, with the host's own --config and --prefix added — what root
  # would do, into a tree this user owns. A *pushcorrupt* host installs FILE
  # with a line appended instead: the install "succeeds" and the bytes in
  # place are not the ones pushed, which only the read-back can see.
  cat >"$d/fake/sudo" <<'FAKE'
#!/bin/sh
printf 'probe:remote_push_sudo %s -- %s\n' "$STUB_PUSH_HOST" "$*" >>"$STUB_PUSH_LOG"
[ "$1" = -n ] || { echo "stub: sudo without -n would prompt and hang" >&2; exit 1; }
shift
case "$STUB_PUSH_HOST" in *nosudo*) echo "sudo: a password is required" >&2; exit 1 ;; esac
[ "$1" = bash ] || { echo "stub sudo: only 'bash FILE' is modelled" >&2; exit 1; }
f="$2"
if [ ! -f "$f" ]; then
  printf 'probe:remote_push_piped %s\n' "$STUB_PUSH_HOST" >>"$STUB_PUSH_LOG"
  echo "stub sudo: '$f' is not a file — a piped install downloads" >&2; exit 1
fi
cp "$f" "$STUB_PUSH_DIR/sudo-saw"
shift 2
case "$STUB_PUSH_HOST" in
  *pushcorrupt*)
    mkdir -p "$STUB_PUSH_DIR/corrupt"
    { cat "$f"; echo "# not the bytes that were pushed"; } >"$STUB_PUSH_DIR/corrupt/runnerctl"
    f="$STUB_PUSH_DIR/corrupt/runnerctl" ;;
esac
exec bash "$f" --config "$STUB_PUSH_DIR/etc/config" "$@" --prefix "$STUB_PUSH_DIR/bin"
FAKE
  cat >"$d/fake/logger" <<'FAKE'
#!/bin/sh
printf 'probe:remote_push_logger %s -- %s\n' "$STUB_PUSH_HOST" "$*" >>"$STUB_PUSH_LOG"
FAKE
  # No case may download: an install that reaches for curl took the piped
  # branch, and is logged (`probe:remote_push_curl`) and refused.
  cat >"$d/fake/curl" <<'FAKE'
#!/bin/sh
printf 'probe:remote_push_curl %s -- %s\n' "$STUB_PUSH_HOST" "$*" >>"$STUB_PUSH_LOG"
echo "stub: a pushed install tried to download: $*" >&2
exit 97
FAKE
  chmod 755 "$d/fake/sudo" "$d/fake/logger" "$d/fake/curl"
}

# The host's side of a push call: the REAL remote text runnerctl built,
# run by a shell in a clean environment that stands for the ssh login —
# PATH is the host's bin/, its fake/, then /usr/bin:/bin; HOME and TMPDIR are
# its own. stdin is whatever the caller gave (the bytes, or nothing).
stub_push_remote() { # HOST TEXT
  local host="$1" d="${RUNNERCTL_TEST_WRITES:?}/remote/$1"
  case "$host" in
    *unreachable*) echo "ssh: connect to host $host port 22: No route to host" >&2; return 255 ;;
    *timeout*)     return 124 ;;
  esac
  stub_push_host "$host"
  env -i PATH="$d/bin:$d/fake:/usr/bin:/bin" HOME="$d/home" TMPDIR="$d/tmp" LC_ALL=C \
    STUB_PUSH_HOST="$host" STUB_PUSH_DIR="$d" STUB_PUSH_LOG="${RUNNERCTL_TEST_LOG:?}" \
    /bin/sh -c "$2"
}

# GHR-101: a host named *hostile* answers as any other host would, and then
# appends STUB_HOSTILE to every non-empty line it writes, stdout and stderr
# alike, --json included — a host on an older runnerctl, a login banner, a
# wrapper script: what the central node has to relay without acting on. It
# composes with the other names (`hostile-unreachable` is unreachable, and its
# ssh error carries the bytes). The three sequences are the issue's: a screen
# clear, a window-title OSC and one painted word, whose SGR is the part a
# relay keeps (HOSTILE_KEPT in tests/run.sh).
STUB_HOSTILE=$' \e[2J\e]0;owned\a\e[31mHOT\e[0m'
stub_hostile_run() { # HOST COMMAND...
  local rc=0 f="${RUNNERCTL_TEST_WRITES:?}/hostile.$BASHPID"
  (ssh_run_body "$@") >"$f.out" 2>"$f.err" || rc=$?
  stub_hostile_lines <"$f.out"
  stub_hostile_lines <"$f.err" >&2
  rm -f "$f.out" "$f.err"
  return "$rc"
}
stub_hostile_lines() {
  local line nl=$'\n'
  # GHR-92: a last line the host wrote WITHOUT its newline keeps not having
  # one, hostile bytes and all — what a streaming relay has to hold in a read.
  while IFS= read -r line || { [ -n "$line" ] && nl=""; }; do
    [ -z "$line" ] || line+="$STUB_HOSTILE"
    printf '%s%s' "$line" "$nl"
  done
}

# --- Streaming (GHR-92) ---------------------------------------------------------
# RUNNERCTL_STUB_FLEET_PROGRESS="host…": a mutating call to those hosts says
# things as it goes, with the order recorded where a case can read it:
#   stdout  waiting for slot-1 (job-a) ... 1m        probe:remote_wrote_line1
#   stderr  warning: slot-1 is slow
#           ... then it WAITS until the central node's reader has shown line 1
#           (it touches $WRITES/central.saw — see run_streamed in tests/run.sh)
#           probe:remote_saw_line1_shown  | probe:remote_gave_up (3 s, a node
#           that buffers never shows it before the call returns)
#   stdout  waiting for slot-1 (job-a) ... 2m        probe:remote_wrote_line2
# then the call's own `<sub> done.`. A host that is also named *hostile* is
# buffered by stub_hostile_run, so it cannot wait on anything: use PARTIAL alone
# for it.
# RUNNERCTL_STUB_FLEET_PARTIAL="host…": after its last line the call writes
# `cut off` with NO newline (a remote killed mid-line).
stub_fleet_progress() { # HOST
  [[ " ${RUNNERCTL_STUB_FLEET_PROGRESS:-} " == *" $1 "* ]] || return 0
  local w="${RUNNERCTL_TEST_WRITES:?}" log="${RUNNERCTL_TEST_LOG:?}" n=0
  echo "waiting for slot-1 (job-a) ... 1m"
  printf 'probe:remote_wrote_line1 %s\n' "$1" >>"$log"
  echo "warning: slot-1 is slow" >&2
  while [ ! -e "$w/central.saw" ] && [ "$n" -lt 150 ]; do
    sleep 0.02
    n=$((n + 1))
  done
  if [ -e "$w/central.saw" ]; then
    printf 'probe:remote_saw_line1_shown %s\n' "$1" >>"$log"
  else
    printf 'probe:remote_gave_up %s\n' "$1" >>"$log"
  fi
  echo "waiting for slot-1 (job-a) ... 2m"
  printf 'probe:remote_wrote_line2 %s\n' "$1" >>"$log"
}
# GHR-125: a mutating call that takes as long as the CASE says — the slow
# action `fleet watch` runs in the background.
#   RUNNERCTL_STUB_FLEET_HOLD="host…"  a mutating call to those hosts writes a
#     progress line, says it is held (`remote/<host>.held`, logged
#     `probe:remote_held HOST`; the pids from itself up to the central process
#     in `remote/<host>.held.pids`), then WAITS until the case releases it — a
#     $'\x01' in RUNNERCTL_STUB_KEYS (`probe:remote_released HOST`) — or 10 s
#     of real time have gone by (`probe:remote_hold_gave_up HOST`), and then
#     answers as any other call does. A TERM or HUP it gets while waiting is
#     logged `probe:remote_signal HOST SIG` before it dies of it: that line's
#     absence is the evidence nothing signalled the remote. (The sim's remote
#     is a process under the central node's job, so ending the job's process
#     tree — q — ends it too; over ssh only the local side would go.)
#   RUNNERCTL_STUB_FLEET_HOLD_HOSTILE=1  the progress line carries STUB_HOSTILE.
#   RUNNERCTL_STUB_FLEET_HOLD_CHECK="host…"  the same hold for `upgrade --check`
#     (GHR-136), which RUNNERCTL_STUB_FLEET_HOLD leaves alone.
stub_fleet_held() { # HOST
  [ -e "${RUNNERCTL_TEST_WRITES:?}/remote/$1.held" ] && [ ! -e "$RUNNERCTL_TEST_WRITES/release" ]
}
stub_hold_signal() { # SIG CODE
  printf 'probe:remote_signal %s %s\n' "$STUB_REMOTE_HOST" "$1" >>"${RUNNERCTL_TEST_LOG:?}"
  exit "$2"
}
stub_fleet_hold() { # HOST [LIST]
  [[ " ${2-${RUNNERCTL_STUB_FLEET_HOLD:-}} " == *" $1 "* ]] || return 0
  local w="${RUNNERCTL_TEST_WRITES:?}" log="${RUNNERCTL_TEST_LOG:?}" n=0 p="$BASHPID" pids=""
  builtin trap 'stub_hold_signal TERM 143' TERM
  builtin trap 'stub_hold_signal HUP 129' HUP
  echo "draining — 2 of 4 stopped, waiting for example.slot-3${RUNNERCTL_STUB_FLEET_HOLD_HOSTILE:+$STUB_HOSTILE}"
  while [ -n "$p" ] && [ "$p" != "$$" ] && [ "$n" -lt 12 ]; do
    pids+="${pids:+ }$p"
    p="$(proc_ppid "$p")" n=$((n + 1))
  done
  mkdir -p "$w/remote"
  echo "$pids" >"$w/remote/$1.held.pids"
  : >"$w/remote/$1.held"
  printf 'probe:remote_held %s\n' "$1" >>"$log"
  n=0
  while [ ! -e "$w/release" ] && [ "$n" -lt 500 ]; do
    sleep 0.02
    n=$((n + 1))
  done
  if [ -e "$w/release" ]; then
    printf 'probe:remote_released %s\n' "$1" >>"$log"
  else
    printf 'probe:remote_hold_gave_up %s\n' "$1" >>"$log"
  fi
  builtin trap - TERM HUP
}
stub_fleet_partial() { # HOST
  [[ " ${RUNNERCTL_STUB_FLEET_PARTIAL:-} " == *" $1 "* ]] || return 0
  printf 'cut off'
}

ssh_run_body() { # HOST COMMAND...
  local host="$1"; shift
  # GHR-89: a call under FLEET_SUDO=1 arrives as `sudo -n <FLEET_RUNNERCTL>
  # <sub> …`. Logged as such — `probe:remote_sudo HOST -- <the rest>` — and
  # then answered as the same call without the prefix, by a remote that is
  # root: so a host whose login lacks the primitive grants
  # (RUNNERCTL_STUB_FLEET_NOSUDO) still acts, which is the whole point of the
  # narrow contract. A host named *sudopath* is one whose sudoers line names
  # a different path from the one asked for: sudo answers it as it answers
  # any command it was not granted, and the call never reaches runnerctl. A
  # call WITHOUT the prefix there is answered as on any other host.
  local via_sudo=false
  if [ "${1:-}" = sudo ]; then
    [ "${2:-}" = -n ] || { echo "stub: sudo without -n would prompt and hang" >&2; return 1; }
    shift 2
    via_sudo=true
    printf 'probe:remote_sudo %s -- %s\n' "$host" "$*" >>"${RUNNERCTL_TEST_LOG:?}"
    case "$host" in
      *sudopath*) echo "sudo: a password is required" >&2; return 1 ;;
    esac
  fi
  # Concurrency DETECTOR, opt-in per case (GHR-43).
  #
  # Entry/exit ordering alone cannot prove serialisation, and an earlier
  # version of this file tried: the stub's work is fast enough that parallel
  # calls often do not overlap in practice, so the ordering assertion passed
  # against a deliberately parallel fan-out. It proved nothing.
  #
  # A lock plus a HELD WINDOW makes the collision deterministic instead of
  # incidental: a parallel caller arriving during the window reliably finds
  # the lock taken and says so, and a serial one never can. Opt-in because
  # the window costs real time and only the serialisation case needs it.
  if [ "${RUNNERCTL_STUB_DETECT_OVERLAP:-0}" = 1 ]; then
    local lock="${RUNNERCTL_TEST_LOG:?}.inflight"
    if mkdir "$lock" 2>/dev/null; then
      sleep 0.2
      rmdir "$lock"
    else
      printf 'probe:ssh_run_overlap %s\n' "$host" >>"${RUNNERCTL_TEST_LOG:?}"
    fi
  fi
  # GHR-83: a push call is one word of shell text, not a runnerctl argv —
  # answered by running that text as the host would (stub_push_remote).
  case "${1:-}" in
    "exec /bin/sh -c '"*)
      if ! $via_sudo; then
        stub_push_remote "$host" "$1"; return
      fi ;;
  esac
  # GHR-81: the real ssh_run's `timeout`, modelled rather than slept through.
  # It reads the budget from exactly where the real one does —
  # FLEET_CALL_TIMEOUT when the caller named one for this call, else
  # FLEET_TIMEOUT — so a caller that stops naming one is back on the
  # read-only budget here too, which is the defect. A call that takes as long
  # as its budget or longer is cut off: 124 and nothing on either stream.
  # None of the remote's effects below happen either, which is a
  # simplification: a real remote goes on without its caller — since GHR-91 a
  # drain/stop/restart/apply/scale runs to the end and records how it ended.
  # That host side is pinned where it runs for real, by the GHR-91 cases in
  # tests/run.sh, which cut a real `drain`'s stdout part-way (run_cut).
  # After the shift above, $1 is the FLEET_RUNNERCTL word and $2 the
  # subcommand.
  local poll_no
  poll_no="$(stub_fleet_poll_no "$host" "$@")"
  if [ "$(stub_fleet_delay "$host" "${2:-status}" "$poll_no")" -ge "${FLEET_CALL_TIMEOUT:-$FLEET_TIMEOUT}" ]; then
    # GHR-74: a table call that timed out was still a frame poll. The `status`
    # arm below, which keeps that count, is never reached from here — so where
    # a delay is tied to a poll number (its fourth field) the count moves
    # here, or the host would sit on the poll before it for ever and its
    # --json reads would never go slow.
    if [[ "${RUNNERCTL_STUB_FLEET_DELAY:-}" == *:*:*:* ]]; then
      mkdir -p "${RUNNERCTL_TEST_WRITES:?}/remote"
      echo "$poll_no" >"$RUNNERCTL_TEST_WRITES/remote/$host.polls"
    fi
    return 124
  fi
  # GHR-74: a table call to a hanging host. See stub_fleet_hangs.
  if [ "${2:-status}" = status ] && stub_frame_poll "${@:3}" && stub_fleet_hangs "$host" "$poll_no"; then
    local hung_n=0 hung_dir="${RUNNERCTL_TEST_WRITES:?}/remote"
    mkdir -p "$hung_dir"
    echo "$BASHPID $(proc_ppid "$BASHPID")" >"$hung_dir/$host.hung.pids"
    : >"$hung_dir/$host.hung"
    while [ "$hung_n" -lt 1500 ]; do
      sleep 0.02
      hung_n=$((hung_n + 1))
    done
    return 124
  fi
  case "$host" in
    *unreachable*)
      echo "ssh: connect to host $host port 22: No route to host" >&2; return 255 ;;
    *timeout*)
      return 124 ;;
    *norunners*)
      echo "runnerctl: no 'actions.runner.*.service' units found on this host." >&2; return 1 ;;
    *garbage*)
      echo "this is not a JSON object"; return 0 ;;
    *nosudo*)
      # What a mutating command looks like on a host without passwordless
      # sudo. BatchMode=yes is why this is a fast failure to report rather
      # than a fan-out hung on a password prompt (GHR-43).
      echo "sudo: a password is required" >&2; return 1 ;;
    # The three bootstrap failures (GHR-50). The exact bytes matter: what
    # tells them apart is 127-on-a-BARE-NAME versus 126-with-a-FULL-PATH, so
    # a stub that blurred those would let a wrong hint pass.
    *noinstall*)
      # runnerctl not on the PATH a non-interactive ssh gets. NOT the same as
      # absent: `ssh host runnerctl` reads no ~/.profile, so a perfectly good
      # ~/.local/bin/runnerctl the same user runs by hand is invisible here.
      echo "bash: line 1: runnerctl: command not found" >&2; return 127 ;;
    *notexec*)
      # Installed, but 0700/0711 so the ssh login cannot read it to run it
      # (GHR-47). Bash names the full path, which is the tell.
      echo "bash: /usr/local/bin/runnerctl: Permission denied" >&2; return 126 ;;
    *multicall*)
      # A uutils/busybox dispatcher answering to the name instead.
      echo "coreutils: unknown program 'runnerctl'" >&2; return 1 ;;
    *sudowrap*)
      # A mutating fan-out runs the remote command under sudo, so a missing
      # runnerctl arrives carrying BOTH signatures at rc 1 rather than 127.
      echo "sudo: runnerctl: command not found" >&2; return 1 ;;
  esac
  # Same sourced-file reason as FLEET_HOSTS above: this is the script's own
  # global, set here so the host answers as an older build for the skew case.
  # shellcheck disable=SC2034
  case "$host" in *oldver*) RUNNERCTL_VERSION="0.0.1" ;; esac
  # GHR-77: RUNNERCTL_STUB_FLEET_VER="host:version …" (space-separated, first
  # match wins) answers as any version — a text that is no version included,
  # for the validation case. Table and --json alike, as on a real host.
  local fv
  # shellcheck disable=SC2034
  for fv in ${RUNNERCTL_STUB_FLEET_VER:-}; do
    [ "${fv%%:*}" = "$host" ] || continue
    RUNNERCTL_VERSION="${fv#*:}"; break
  done
  # GHR-66: an *oldver* host predates GHR-64, so its header has no Disk: /
  # events fragment — nothing for the fleet host line to show (no drives,
  # and the default empty journal adds no events either). A host named
  # in RUNNERCTL_STUB_FLEET_FULL (space-separated) answers with the full
  # drives and the journal events of RUNNERCTL_STUB_DISKS=full /
  # RUNNERCTL_STUB_HOST_EVENTS=events, so one host can differ from the rest.
  # Shell variables, not exports: host_df and journal_host_events read
  # them in this same subshell.
  case "$host" in *oldver*) RUNNERCTL_STUB_DISKS=none ;; esac
  if [[ " ${RUNNERCTL_STUB_FLEET_FULL:-} " == *" $host "* ]]; then
    RUNNERCTL_STUB_DISKS=full RUNNERCTL_STUB_HOST_EVENTS=events
  fi
  # Drop the FLEET_RUNNERCTL word, then dispatch on the subcommand and hand
  # the rest through untouched — so a forwarded flag is exercised for real
  # rather than matched as a substring of the whole command line.
  shift
  local sub="${1:-status}"; shift || true
  # GHR-55: which remote host is answering, for the per-host state discover
  # and unit_props read. This body runs in a subshell of its own (ssh_run),
  # so the name cannot outlive the call.
  STUB_REMOTE_HOST="$host"
  # GHR-88: the origin ssh_run took off the command line, as main takes it.
  [ -z "${STUB_ORIGIN:-}" ] || audit_origin_take "$STUB_ORIGIN"
  case "$sub" in
    # GHR-88: the real command, over this host's stubbed journal read. A host
    # named in RUNNERCTL_STUB_FLEET_NOHISTORY (space-separated) runs a
    # runnerctl from before the command.
    history)
      if [[ " ${RUNNERCTL_STUB_FLEET_NOHISTORY:-} " == *" $host "* ]]; then
        echo "runnerctl: unknown command 'history' (status watch health fleet …)" >&2; return 1
      fi
      cmd_history "$@"; return ;;
    # Canned `upgrade` output (GHR-41). Not the real cmd_upgrade: that fetches
    # over the network, which the gates must never do. The lines below are
    # the exact ones cmd_upgrade prints, which is what the reporter parses.
    #
    # GHR-82: a host that WRITES leaves `remote/<host>.upgraded` behind, which
    # is what its `version` answers from afterwards (the arm below) — so the
    # read-back sees the write's effect rather than a canned success. Three
    # more names model the hosts the read-back and the staging exist for:
    #   *shadowed*    says `Upgraded`, but wrote a copy the fleet path does
    #                 not execute: `version` goes on answering 0.0.1
    #   *writefail*   `upgrade --check` answers, the write does not (no
    #                 passwordless sudo for it) — unlike *nosudo*, which fails
    #                 every call and so could never be picked as a canary
    #   *verifydown*  an *oldver* host that upgrades and then cannot be
    #                 reached for the read-back
    upgrade)
      # GHR-84: `upgrade --rollback`, the lines upgrade_rollback prints. A host
      # that rolls back leaves `remote/<host>.rolledback`, which its `version`
      # answers from (the arm below), as a write's `.upgraded` does:
      #   *noprev*    has no .prev: dies as the real one does, rc 1
      #   *shadowed*  says it rolled back a copy the fleet path does not run:
      #               `version` goes on answering 0.0.1
      #   *rbweird*   an older runnerctl that does not know --rollback and
      #               answered as if it were a plain upgrade
      #   *verifydown* as for a write: rolls back, then cannot be reached
      #   anything else: 1.0.0 -> 0.9.0
      # GHR-128: a write (not --check) to a host in RUNNERCTL_STUB_FLEET_HOLD is
      # held as every other mutating call is, so a case can keep one running.
      # GHR-136: a CHECK is held only by RUNNERCTL_STUB_FLEET_HOLD_CHECK (the
      # same wait, release and probes), so a case can hold the check alone.
      if [[ " $* " == *" --check "* ]]; then
        stub_fleet_hold "$host" "${RUNNERCTL_STUB_FLEET_HOLD_CHECK:-}"
      else
        stub_fleet_hold "$host"
      fi
      if [[ " $* " == *" --rollback "* ]]; then
        case "$host" in
          *noprev*)
            echo "runnerctl: no rollback copy at /usr/local/bin/runnerctl.prev — nothing to roll back to (an upgrade keeps the version it replaced there; a fresh install, or a rollback already made, leaves none)" >&2
            return 1 ;;
          *shadowed*)
            echo "installed: 0.0.1 (/home/someone/.local/bin/runnerctl)"
            echo "rollback: 0.0.0 (/home/someone/.local/bin/runnerctl.prev)"
            echo "Rolled back 0.0.1 -> 0.0.0 at /home/someone/.local/bin/runnerctl"
            echo
            echo "runnerctl 0.0.0" ;;
          *rbweird*)
            echo "installed: 1.0.0 (/usr/local/bin/runnerctl)"
            echo "available: 1.0.0 (https://example.invalid/runnerctl)"
            echo "Already up to date." ;;
          *)
            echo "installed: 1.0.0 (/usr/local/bin/runnerctl)"
            echo "rollback: 0.9.0 (/usr/local/bin/runnerctl.prev)"
            mkdir -p "${RUNNERCTL_TEST_WRITES:?}/remote"
            : >"$RUNNERCTL_TEST_WRITES/remote/$host.rolledback"
            echo "Rolled back 1.0.0 -> 0.9.0 at /usr/local/bin/runnerctl"
            echo
            echo "runnerctl 0.9.0" ;;
        esac
        return 0
      fi
      case "$host" in
        # GHR-128: a version that is no X.Y.Z, in the installed field of a
        # check (an escape sequence in it, which the relay takes the escape of
        # and leaves the rest), and in the sentence of a write.
        *badver*)
          printf 'installed: 1.0-rc1\033]0;owned\007 (/usr/local/bin/runnerctl)\n'
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          echo "Update available. Run: runnerctl upgrade" ;;
        *badwrote*)
          echo "installed: 0.0.1 (/usr/local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          case "$*" in
            *--check*) echo "Update available. Run: runnerctl upgrade" ;;
            *)         echo "Upgraded 0.0.1 -> 9.9.9-rc1 at /usr/local/bin/runnerctl" ;;
          esac ;;
        *oldver*)
          echo "installed: 0.0.1 (/usr/local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          case "$*" in
            *--check*) echo "Update available. Run: runnerctl upgrade" ;;
            *)         stub_fleet_upgraded "$host"
                       echo "Upgraded 0.0.1 -> 9.9.9 at /usr/local/bin/runnerctl" ;;
          esac ;;
        *shadowed*)
          echo "installed: 0.0.1 (/home/someone/.local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          case "$*" in
            *--check*) echo "Update available. Run: runnerctl upgrade" ;;
            *)         echo "Upgraded 0.0.1 -> 9.9.9 at /home/someone/.local/bin/runnerctl" ;;
          esac ;;
        *writefail*)
          echo "installed: 0.0.1 (/usr/local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          case "$*" in
            *--check*) echo "Update available. Run: runnerctl upgrade" ;;
            *)         echo "sudo: a password is required" >&2; return 1 ;;
          esac ;;
        *ahead*)
          echo "installed: 9.9.9 (/usr/local/bin/runnerctl)"
          echo "available: 1.0.0 (https://example.invalid/runnerctl)"
          echo "Remote is older than installed — not downgrading (pass --ref to force a specific version)." ;;
        *weird*)
          echo "installed: 1.0.0 (/usr/local/bin/runnerctl)"
          echo "available: 1.0.0 (https://example.invalid/runnerctl)"
          echo "something this tool has never said before" ;;
        # GHR-52: a host that healed its own placement. The extra lines are
        # the whole point — fleet_upgrade_report must still classify this as
        # `upgraded` off the trailing sentence rather than as `unrecognised`.
        *relocating*)
          echo "installed: 0.0.1 (/home/someone/.local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          echo "note: this copy is not on the PATH a non-interactive ssh gets, so 'fleet' cannot run it"
          # GHR-82: under --check it says what it WOULD do, as cmd_upgrade
          # does. It used to answer `Upgraded` either way, which no case
          # noticed until a read-back followed every host that says so.
          case "$*" in
            *--check*)
              echo "would relocate: /home/someone/.local/bin/runnerctl -> /usr/local/bin/runnerctl"
              echo "would retire: /home/someone/.local/bin/runnerctl.retired"
              echo "Update available. Run: runnerctl upgrade" ;;
            *)
              echo "relocated: /home/someone/.local/bin/runnerctl -> /usr/local/bin/runnerctl"
              echo "retired: /home/someone/.local/bin/runnerctl.retired"
              stub_fleet_upgraded "$host"
              echo "Upgraded 0.0.1 -> 9.9.9 at /usr/local/bin/runnerctl" ;;
          esac ;;
        # Retired a shadow but could not write the system copy without a
        # password, so it reports work still outstanding rather than claiming
        # an upgrade it did not perform.
        *retireonly*)
          echo "installed: 1.0.0 (/usr/local/bin/runnerctl)"
          echo "available: 9.9.9 (https://example.invalid/runnerctl)"
          echo "note: /usr/local/bin/runnerctl (runnerctl 1.0.0) is shadowed by this copy — retiring this one; run 'sudo /usr/local/bin/runnerctl upgrade' to move it on"
          echo "retired: /home/someone/.local/bin/runnerctl.retired"
          echo "Update available. Run: sudo /usr/local/bin/runnerctl upgrade" ;;
        *)
          echo "installed: 1.0.0 (/usr/local/bin/runnerctl)"
          echo "available: 1.0.0 (https://example.invalid/runnerctl)"
          echo "Already up to date." ;;
      esac
      # Return rather than break: there is a second `case "$sub"` below for
      # the commands the budget fixture does not handle, and falling into it
      # would hit its unknown-command arm after this branch had already
      # answered.
      return 0 ;;
    # GHR-82: the read-back. The real command prints `runnerctl <version>`
    # and nothing else (tests/upgrade-test.sh 1b feeds the real line to the
    # same parser); which version is the host's own, and 9.9.9 only once a
    # write has actually landed where the fleet path runs it.
    version)
      case "$host" in
        *verifydown*)
          echo "ssh: connect to host $host port 22: No route to host" >&2; return 255 ;;
      esac
      if [ -f "${RUNNERCTL_TEST_WRITES:?}/remote/$host.rolledback" ]; then
        echo "runnerctl 0.9.0"
      elif [ -f "${RUNNERCTL_TEST_WRITES:?}/remote/$host.upgraded" ]; then
        echo "runnerctl 9.9.9"
      else
        case "$host" in
          *oldver*|*relocating*|*shadowed*|*writefail*) echo "runnerctl 0.0.1" ;;
          *ahead*)                                      echo "runnerctl 9.9.9" ;;
          *)                                            echo "runnerctl 1.0.0" ;;
        esac
      fi
      return 0 ;;
    # --- Stateful fleet simulator (GHR-44) ---------------------------------
    # A rolling budget can only be tested against a fleet whose slot states
    # CHANGE BETWEEN POLLS; a stateless stub answers the same thing every
    # call, so any scheduler passes, including a broken one.
    #
    # RUNNERCTL_STUB_FLEET_SLOTS="N" gives every host N slots. Acting on a
    # slot writes a countdown file; each subsequent status poll reports that
    # slot unavailable and decrements. A restart recovers after
    # RUNNERCTL_STUB_RECOVER polls; a stop/drain/disable never does. That is
    # the whole asymmetry the budget flags exist for, so the fixture has to
    # model it rather than assume it.
    *) : ;;
  esac
  if [ -n "${RUNNERCTL_STUB_FLEET_SLOTS:-}" ]; then
    local sd="${RUNNERCTL_TEST_WRITES:?}/fleetstate"
    mkdir -p "$sd"
    case "$sub" in
      status)
        local s f n out=""
        for ((s = 0; s < RUNNERCTL_STUB_FLEET_SLOTS; s++)); do
          f="$sd/$host-$s"
          if [ -f "$f" ]; then
            n="$(cat "$f")"
            if [ "$n" = "perm" ]; then
              out+="  {\"idx\":$s,\"active\":\"inactive\"},"$'\n'
              continue
            fi
            if [ "$n" -gt 0 ]; then
              echo $((n - 1)) >"$f"
              out+="  {\"idx\":$s,\"active\":\"activating\"},"$'\n'
              continue
            fi
          fi
          out+="  {\"idx\":$s,\"active\":\"active\"},"$'\n'
        done
        printf '{"runnerctl":"1.0.0","host":{"name":"%s"},\n "slots":[\n%s]}\n' \
          "$host" "${out%,$'\n'}"
        return 0 ;;
      restart|apply|scale)
        # $1 is the slot index the walker targets.
        echo "${RUNNERCTL_STUB_RECOVER:-2}" >"$sd/$host-${1:-0}"
        stub_fleet_progress "$host"
        echo "$sub done."; return 0 ;;
      stop|drain|disable)
        echo perm >"$sd/$host-${1:-0}"
        stub_fleet_progress "$host"
        echo "$sub done."; return 0 ;;
    esac
  fi
  case "$sub" in
    # The mutating commands (GHR-43). Canned rather than dispatched into the
    # real cmd_*: those write drop-ins and signal processes through the
    # writes-mirror tree, and a fan-out running them once per host would make
    # this fixture assert on the sim's own bookkeeping rather than on the
    # fan-out. What the fan-out owes is ordering, targeting and reporting —
    # each command's own behaviour is covered by its single-host cases.
    #
    # GHR-55: a start/stop/restart aimed at ONE slot (a target, not a flag —
    # the fleet fan-outs forward none) is remembered per host, so the next
    # frame `fleet watch` polls shows its effect on that host and no other.
    # RUNNERCTL_STUB_FLEET_NOSUDO (an ERE on the host name) makes these and
    # `logs` fail the way they do without passwordless sudo, while the host's
    # `status` still answers — the realistic split, since status needs none.
    apply|scale|start|stop|restart|drain|kill|reap|remove-limits|enable|disable)
      if ! $via_sudo && stub_fleet_nosudo "$host"; then echo "sudo: a password is required" >&2; return 1; fi
      if [ -n "${1:-}" ] && [[ "$1" != -* ]]; then
        mkdir -p "$RUNNERCTL_TEST_WRITES/remote/$host"
        case "$sub" in
          stop)          echo inactive >"$RUNNERCTL_TEST_WRITES/remote/$host/$1" ;;
          start|restart) echo active   >"$RUNNERCTL_TEST_WRITES/remote/$host/$1" ;;
        esac
      fi
      stub_fleet_hold "$host"
      stub_fleet_progress "$host"
      echo "$sub done."
      stub_fleet_partial "$host" ;;
    # GHR-55: `fleet watch`'s L. Canned, like the mutating commands: the real
    # cmd_logs would log its journalctl as a LOCAL privileged call. The lines
    # name the host and the argv they were asked for, so a case can tell which
    # host's journal reached the pager.
    logs)
      if ! $via_sudo && stub_fleet_nosudo "$host"; then echo "sudo: a password is required" >&2; return 1; fi
      echo "-- journal of ${1:-?} on $host (${*:2}) --"
      echo "$host ${1:-?}: Listening for Jobs" ;;
    # GHR-87: the real commands, over the docker model below, which every
    # host shares (RUNNERCTL_STUB_COMPOSE / _STANDALONE are read once, when
    # this file is sourced). Per host, by name:
    #   *nodocker*      docker is not on its PATH (RUNNERCTL_STUB_NO_DOCKER)
    #   *dockerdenied*  its login is not in the docker group: the daemon
    #                   refuses it (RUNNERCTL_STUB_DOCKER_DENIED) — unless the
    #                   call came through `sudo -n`, which runs as root
    #   *rootexecbad*   the runnerctl a root timer would run is not root's,
    #                   so `compose-reap-timer install` refuses there even
    #                   under RUNNERCTL_STUB_ROOT_EXEC_OK=1
    # The timer's unit files are kept per host, in
    # $WRITES/remote/<host>/etc/systemd/system (SYSTEMD_DIR for the call);
    # RUNNERCTL_STUB_FLEET_TIMER="host…" puts an installed timer there first.
    compose-reap|compose-reap-timer)
      case "$host" in *nodocker*) RUNNERCTL_STUB_NO_DOCKER=1 ;; esac
      if [[ "$host" == *dockerdenied* ]] && ! $via_sudo; then RUNNERCTL_STUB_DOCKER_DENIED=1; fi
      case "$host" in *rootexecbad*) RUNNERCTL_STUB_ROOT_EXEC_OK=0 ;; esac
      SYSTEMD_DIR="$RUNNERCTL_TEST_WRITES/remote/$host/etc/systemd/system"
      if [[ " ${RUNNERCTL_STUB_FLEET_TIMER:-} " == *" $host "* ]]; then
        mkdir -p "$SYSTEMD_DIR"
        render_compose_reap_timer >"$SYSTEMD_DIR/$COMPOSE_REAP_UNIT.timer"
      fi
      if [ "$sub" = compose-reap ]; then cmd_compose_reap "$@"; else cmd_compose_reap_timer "$@"; fi ;;
    # GHR-80: a host named in RUNNERCTL_STUB_FLEET_NOHEALTHJSON (space-
    # separated) runs a runnerctl from before `health --json`: its parser
    # refuses the flag as every runnerctl refuses one it does not know.
    health)
      if [[ " ${RUNNERCTL_STUB_FLEET_NOHEALTHJSON:-} " == *" $host "* ]] && [[ " $* " == *" --json "* ]]; then
        echo "runnerctl: unknown option: --json" >&2; return 1
      fi
      cmd_health "$@" ;;
    status)
      # GHR-55: count this host's FRAME polls (the table, not a --json facts
      # read), so a case can script a host dropping out of chosen frames
      # (RUNNERCTL_STUB_FLEET_DOWN="host:N,M") or scaling down from a frame
      # on (RUNNERCTL_STUB_FLEET_SCALED="host:N": its slot-3 is gone).
      if stub_frame_poll "$@"; then
          local pf="$RUNNERCTL_TEST_WRITES/remote/$host.polls" polls=0 downs
          mkdir -p "$RUNNERCTL_TEST_WRITES/remote"
          [ ! -f "$pf" ] || polls="$(cat "$pf")"
          polls=$((polls + 1)); echo "$polls" >"$pf"
          if [[ " ${RUNNERCTL_STUB_FLEET_DOWN:-} " == *" $host:"* ]]; then
            downs="${RUNNERCTL_STUB_FLEET_DOWN#*"$host":}"; downs="${downs%% *}"
            if [[ ",$downs," == *",$polls,"* ]]; then
              echo "ssh: connect to host $host port 22: No route to host" >&2; return 255
            fi
          fi
      fi
      # GHR-54/GHR-57: the view flags a fan-out forwards are ACTED ON here
      # rather than pinned, for the reason the upgrade branch above gives — a
      # stub that always answered plain and always used the default
      # threshold would pass a fleet renderer that cannot read a painted
      # table, a `fleet watch --stall-after` that forwards nothing, and a
      # `fleet status --json --stall-after` whose `stalled` field never
      # moves. --stall-after is parsed before either render path, table or
      # JSON, so both fan-outs are exercised the same way.
      #
      # The remote starts from its OWN threshold, not the central node's: this
      # branch runs in a subshell of the central process and would otherwise
      # inherit whatever --stall-after the central parsed, so STALLED would
      # appear whether or not the flag was forwarded (GHR-57's mutation went
      # green on the rendered rows for exactly that reason). 3600 is the
      # script's own default. Every status fan-out runs ssh_run in a
      # background subshell, so this cannot leak into the next host or back
      # into the renderer.
      #
      # GHR-56: --narrow the same way, and for the same reason the remote
      # starts from its own column set: `fleet status --narrow` sets nothing
      # locally today, but a central node that did would hand this subshell a
      # narrow table whether or not the flag was forwarded. An *oldver* host
      # predates the flag and refuses it exactly as the real option parser
      # does (die: that line on stderr, exit 1), which is the version-skew
      # path fleet_fanout has to survive.
      set_stall_after 3600
      status_narrow false
      # GHR-78: and from its own terminal, which over ssh is none — the
      # central node's width must not reach a remote's table through this
      # shared process. The real cmd_status leaves STATUS_COLS at 0 unless
      # its stdout is a terminal. (The script's own global, as FLEET_HOSTS
      # and RUNNERCTL_VERSION are above: this file is sourced into it.)
      # shellcheck disable=SC2034
      STATUS_COLS=0
      local rcolor=never as_json=false
      # GHR-90: --with-json is the real render_status with STATUS_WITH_JSON
      # (the script's own global; this branch is a subshell). A host named in
      # RUNNERCTL_STUB_FLEET_NOWITHJSON (space-separated) runs a runnerctl
      # from before the flag and refuses it as the real parser does.
      # shellcheck disable=SC2034
      STATUS_WITH_JSON=false
      # GHR-115: --cpu-prev=SPEC through the real status_cpu_prev, so a fleet
      # watch tick that hands a host back its samples is held to the real
      # parser's rules. A host named in RUNNERCTL_STUB_FLEET_NOCPUPREV
      # (space-separated) is from before the flag and refuses it.
      status_cpu_prev ""
      while [ $# -gt 0 ]; do
        case "$1" in
          --cpu-prev=*)
            if [[ " ${RUNNERCTL_STUB_FLEET_NOCPUPREV:-} " == *" $host "* ]]; then
              echo "runnerctl: unknown option: --cpu-prev" >&2; return 1
            fi
            status_cpu_prev "${1#*=}"; shift ;;
          --color)       rcolor="$2"; shift 2 ;;
          --stall-after) set_stall_after "$2"; shift 2 ;;
          --json)        as_json=true; shift ;;
          --with-json)
            if [[ " ${RUNNERCTL_STUB_FLEET_NOWITHJSON:-} " == *" $host "* ]]; then
              echo "runnerctl: unknown option: --with-json" >&2; return 1
            fi
            # shellcheck disable=SC2034
            STATUS_WITH_JSON=true; shift ;;
          --narrow)
            case "$host" in
              *oldver*) echo "runnerctl: unknown option: --narrow" >&2; return 1 ;;
            esac
            status_narrow; shift ;;
          *)             shift ;;
        esac
      done
      # GHR-75: a host whose OWN config has a ten-minute stall threshold, so
      # one host of a fleet can report slot-1's 12m job STALLED while the
      # others call it busy (RUNNERCTL_STUB_FLEET_STALL, space-separated) —
      # the table and the --json payload alike, as on a real host.
      if [[ " ${RUNNERCTL_STUB_FLEET_STALL:-} " == *" $host "* ]]; then set_stall_after 600; fi
      # GHR-79: a host from before the CPU column (RUNNERCTL_STUB_FLEET_NOCPU,
      # space-separated): its table is this one with the column dropped, which
      # status_row draws cell for cell as that release did — the header too.
      # Its narrow table was already without it. (The script's own global.)
      if [[ " ${RUNNERCTL_STUB_FLEET_NOCPU:-} " == *" $host "* ]] && [ -z "$STATUS_DROP" ]; then
        # shellcheck disable=SC2034
        STATUS_DROP="$STATUS_CPU_COL"
      fi
      if $as_json; then
        # GHR-113: a host from before `host.sudo_contract` sends the payload
        # without the key (RUNNERCTL_STUB_FLEET_NOSUDOC, space-separated).
        if [[ " ${RUNNERCTL_STUB_FLEET_NOSUDOC:-} " == *" $host "* ]]; then
          render_status_json | sed 's/,"sudo_contract":[^}]*}/}/'
        else
          render_status_json
        fi
      elif [[ " ${RUNNERCTL_STUB_FLEET_NOSUDOC:-} " == *" $host "* ]]; then
        # The sed touches the payload's host line only: no table line
        # carries `,"sudo_contract":`.
        color_setup "$rcolor"; render_status | sed 's/,"sudo_contract":[^}]*}/}/'
      elif $STATUS_WITH_JSON && [[ " ${RUNNERCTL_STUB_FLEET_CUT:-} " == *" $host:"* ]]; then
        # GHR-90: RUNNERCTL_STUB_FLEET_CUT="host:before|after" — that host's
        # --with-json answer arrives cut, exit 0 all the same: `before` ends
        # at the separator (the table alone), `after` loses the object's
        # closing `]}` line.
        local cut="${RUNNERCTL_STUB_FLEET_CUT#*"$host":}"
        cut="${cut%% *}"
        color_setup "$rcolor"
        if [ "$cut" = before ]; then
          render_status | sed $'/^\x1e/,$d'
        else
          render_status | sed '$d'
        fi
      else
        color_setup "$rcolor"; render_status
      fi ;;
    *) echo "runnerctl: unknown command '$sub'" >&2; return 1 ;;
  esac
}

# --- Provisioning (GHR-45) ---------------------------------------------------
# `provision` reaches the network three ways: the releases API, the token API
# and the tarball download. All three are shadowed here so `make sim` runs
# offline and deterministically. Everything else provision does is a host
# mutation, which already goes through run_priv and lands in the call log.
#
# Knobs:
#   RUNNERCTL_STUB_ARCH          the architecture provision believes it is on;
#                                default x64, so asset names are the same on
#                                an arm CI runner as on an x86 one
#   RUNNERCTL_STUB_RELEASE_VER   version the releases API reports; default
#                                2.337.0
#   RUNNERCTL_STUB_RELEASE_SHA   digest the release metadata carries; default
#                                a fixed 64-hex string. Empty = a release with
#                                NO published checksum, for the refusal case
#   RUNNERCTL_STUB_TARBALL_SHA   what the downloaded file actually hashes to;
#                                defaults to RUNNERCTL_STUB_RELEASE_SHA, so
#                                setting only this one simulates a MISMATCH
#   RUNNERCTL_STUB_API_FAIL      an ERE; an http_api URL matching it fails
#                                (unreachable API, unknown tag, bad PAT)
#   RUNNERCTL_STUB_NO_GH         1 = the gh CLI is absent, so the "no
#                                credentials at all" refusal is reachable
STUB_SHA_DEFAULT="70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613"

# Pinned so asset names do not depend on the box the tests run on.
runner_arch() { echo "${RUNNERCTL_STUB_ARCH:-x64}"; }

# Logged like a privileged call would be, but as `api:` — it is not a host
# mutation and must never be confused with one. THE PAT IS NOT LOGGED: the
# whole point of passing it on curl's stdin is that it stays out of argv, and
# a fixture that logged it would quietly bless the opposite.
http_api() { # METHOD URL [TOKEN]
  local method="$1" url="$2" token="${3:-}"
  printf 'api: %s %s%s\n' "$method" "$url" "${token:+ (authenticated)}" \
    >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  if [ -n "${RUNNERCTL_STUB_API_FAIL:-}" ] && [[ "$url" =~ $RUNNERCTL_STUB_API_FAIL ]]; then
    return 22
  fi
  case "$url" in
    *registration-token)
      printf '{\n  "token": "STUB-REGISTRATION-TOKEN",\n  "expires_at": "2026-09-14T13:00:00Z"\n}\n' ;;
    *remove-token)
      printf '{\n  "token": "STUB-REMOVAL-TOKEN",\n  "expires_at": "2026-09-14T13:00:00Z"\n}\n' ;;
    *releases/latest|*releases/tags/*)
      local ver="${RUNNERCTL_STUB_RELEASE_VER:-2.337.0}"
      local sha="${RUNNERCTL_STUB_RELEASE_SHA-$STUB_SHA_DEFAULT}"
      local arch; arch="$(runner_arch)"
      # Shaped like the real response: one field per line, the asset's
      # "digest" AFTER its "name", and the body carrying the SHA marker.
      printf '{\n'
      printf '  "tag_name": "v%s",\n' "$ver"
      printf '  "name": "v%s",\n' "$ver"
      printf '  "body": "- actions-runner-linux-%s-%s.tar.gz <!-- BEGIN SHA linux-%s -->%s<!-- END SHA linux-%s -->",\n' \
        "$arch" "$ver" "$arch" "$sha" "$arch"
      printf '  "assets": [\n'
      printf '    {\n'
      printf '      "name": "actions-runner-linux-%s-%s.tar.gz",\n' "$arch" "$ver"
      printf '      "size": 123,\n'
      [ -z "$sha" ] || printf '      "digest": "sha256:%s",\n' "$sha"
      printf '      "browser_download_url": "https://example.invalid/runner.tar.gz"\n'
      printf '    }\n'
      printf '  ]\n'
      printf '}\n' ;;
    *) return 22 ;;
  esac
}

# No download: just leave a file where one was asked for, so the checksum step
# has something to hash and `tar` (run_priv, logged) has something to name.
runner_fetch_tarball() { # URL DEST
  printf 'fetch: %s -> %s\n' "$1" "$2" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  printf 'stub tarball\n' >"$2"
}

# What the "downloaded" file hashes to. Deliberately INDEPENDENT of
# RUNNERCTL_STUB_RELEASE_SHA: that one says what the release PUBLISHES, and
# emptying it must mean "this release published no checksum", not "the tarball
# hashes to nothing" — otherwise a case that pins --sha256 against an
# unpublished release fails for a reason the fixture invented.
runner_sha256() { # FILE
  echo "${RUNNERCTL_STUB_TARBALL_SHA:-$STUB_SHA_DEFAULT}"
}

# `provision` creates the runner account when it is missing. The test box may
# or may not have a `github-runner` user, and a fixture that changed behaviour
# depending on that would be a flake — so the answer is pinned here.
#   RUNNERCTL_STUB_USER_EXISTS  1 = the runner user already exists; default 0
runner_user_exists() { [ "${RUNNERCTL_STUB_USER_EXISTS:-0}" = 1 ]; }
runner_group_exists() { [ "${RUNNERCTL_STUB_USER_EXISTS:-0}" = 1 ]; }

# `provision` falls back to the gh CLI when it has no token and no PAT. The
# box running the tests may well have gh installed and logged in, so the
# no-credentials refusal is only reachable with this shadow.
runner_have_gh() { [ "${RUNNERCTL_STUB_NO_GH:-0}" != 1 ]; }

# --- Deprovisioning (GHR-46) --------------------------------------------------
# `deprovision` checks a unit's WorkingDirectory holds config.sh and svc.sh
# before it will `rm -rf` it. /opt/actions-runner does not exist on the test
# box, so the answer is pinned: yes, unless RUNNERCTL_STUB_NOT_RUNNER_DIR=1.
runner_dir_is_runner() { [ "${RUNNERCTL_STUB_NOT_RUNNER_DIR:-0}" != 1 ]; }
# GHR-121: provision and deprovision refuse a runner root that is not root's.
# No sim directory is root-owned, so the stub answers "fine" — which means every
# case through it tests the stub — unless RUNNERCTL_STUB_ROOT_REAL=1, which
# runs the real check (a case then fakes `stat`'s answers from its own config,
# as GHR-89's cases do). The real one is also covered by run_fn directly.
eval "real_runner_root_problem() $(declare -f runner_root_problem | tail -n +2)"
runner_root_problem() {
  [ "${RUNNERCTL_STUB_ROOT_REAL:-0}" != 1 ] || real_runner_root_problem "$@"
}
# deprovision asks the chain question directly (it removes as the runner user
# instead of refusing when the answer is not nothing).
eval "real_runner_root_chain_problem() $(declare -f runner_root_chain_problem | tail -n +2)"
runner_root_chain_problem() {
  [ "${RUNNERCTL_STUB_ROOT_REAL:-0}" != 1 ] || real_runner_root_chain_problem "$@"
}
# The harness's stdin is never a terminal, so the interactive confirm is only
# reachable with RUNNERCTL_STUB_STDIN_TTY=1 (the answer then comes from the
# case's here-string); default 0 = the non-interactive refusal.
stdin_is_tty() { [ "${RUNNERCTL_STUB_STDIN_TTY:-0}" = 1 ]; }

# --- compose-reap ---------------------------------------------------------------
# Knobs:
#   RUNNERCTL_STUB_COMPOSE         1 = the daemon holds the fixture projects
#                                  below; default 0 = no compose objects at all
#   RUNNERCTL_STUB_COMPOSE_WORKER  1 = slot-1 has a Runner.Worker (pid 5555,
#                                  started 8000 s ago), so a stack under its
#                                  work folder is owned by a live job
#   RUNNERCTL_STUB_COMPOSE_RM_FAIL an id; removing it fails (logged anyway)
#   RUNNERCTL_STUB_NO_DOCKER       1 = docker is not on PATH
#   RUNNERCTL_STUB_DOCKER_DENIED   1 = the daemon refuses this user (GHR-87:
#                                  not in the docker group)
#   RUNNERCTL_STUB_PROC_AGES       "pid:seconds ..." for `proc_age`; a pid not
#                                  listed is gone. The fixture sets its own.
#   RUNNERCTL_STUB_ROOT_EXEC_OK    1 = `root_exec_problem` finds nothing wrong
#                                  with the runnerctl the timer would run
#   RUNNERCTL_STUB_COMPOSE_STALE   the `stale` project's label, in all three
#                                  lists (GHR-100: a label is any bytes a job
#                                  with docker chose)
#   RUNNERCTL_STUB_COMPOSE_YOUNG   the `young` project's label (GHR-109)
#   RUNNERCTL_STUB_COMPOSE_STALE_WD  c-stale's working-dir label (GHR-109)
#   RUNNERCTL_STUB_COMPOSE_BAD_ID  container|network|volume: that kind's
#                                  `stale` object answers with an id that is
#                                  not docker's form (`victim-id`, or a volume
#                                  Name `victim id`) — GHR-109
#   RUNNERCTL_STUB_COMPOSE_CREATED c-young's Created and StartedAt, as docker
#                                  would print them (GHR-109: ones that do not
#                                  parse — both, or StartedAt alone would date
#                                  the stack and hide what Created does)
#
# GHR-109: `docker` ITSELF is modelled here, not the compose_* readers, so the
# real templates and the real parsing run. The model answers the calls the
# readers make — `ps -aq` (short ids) and `ps -aq --no-trunc` (full), each
# with or without the compose label filter, `network ls -q`, `volume ls -q`,
# and `[network|volume] inspect -f TEMPLATE …` — by rendering the template
# over the fixture below: `{{.Id}}`, `{{.Name}}`, `{{.Image}}`,
# `{{.Config.Image}}`, `{{.Created}}` (containers, networks), `{{.CreatedAt}}`
# (volumes), `{{.State.StartedAt}}`, `{{index <labels> "K"}}` over
# `.Config.Labels` (containers) or `.Labels` (networks, volumes), `json` of
# any of those, and `{{with .Config.Labels}}…{{end}}`. What docker 29 prints
# was read off a real daemon: a container's and a network's absent label is
# `null` under `json` and `<no value>` without it (docker formats those two
# over the raw JSON), a volume's is `""`; `json` escapes `"`, `\`, \n \r \t
# (\b \f) and every other C0 byte as \u00XX, and leaves `|`, DEL and C1 as
# they are (U+2028/9 and invalid UTF-8 become escapes too; no fixture here
# carries either). Any other call or action is logged `direct:docker …`,
# which fails the case — the real docker on a dev box is never reached.
#
# Ids are 64 hex digits, as docker's are: a serial, then the fixture name's
# bytes in hex, zero-padded. compose_rm and compose_image_in_use log the
# fixture NAME back (`docker rm container c-stale`) for an id the fixture
# issued, and any other id exactly as it was handed over.
#
# The fixture, against now_epoch (1000000720), one project per verdict path:
#   harness-123456  pid gone                         -> reap gone:pid:123456
#   harness-4242    pid alive, older than the stack  -> keep live:pid:4242
#   harness-777     pid alive but younger (recycled) -> reap gone:pid:777
#   slotone         under slot-1's work folder        -> keep live:slot (with WORKER)
#   slottwo         under slot-2's, no worker         -> reap gone:slot
#   stale           no signal, 4 h idle               -> reap age (+1 net, +1 vol)
#   young           no signal, 1 h idle               -> keep young
#   app-2           `-2` is below MIN_PID, 2 h idle   -> keep young
#   fresh-1234      2 min old, pid gone               -> keep grace
#   pinned          keep label                        -> keep label
#   netonly         a network, no containers, 5 h     -> reap age (Go timestamp)
#   leftover        only a volume                     -> keep volume-only
docker_available() { [ "${RUNNERCTL_STUB_NO_DOCKER:-0}" != 1 ]; }
stub_ts() { date -u -d "@$(( $(now_epoch) - $1 ))" +%Y-%m-%dT%H:%M:%S.000000000Z; }

# The fixture, one object per index: SC_KIND (container, standalone, network,
# volume), SC_KEY (the name a log line shows), SC_ID, SC_NAME, SC_CREATED,
# SC_STARTED, SC_PROJ (set = carries the compose label), SC_KEEP, SC_WD,
# SC_LABELS (0 = a nil Labels map), SC_IMG (image id) and SC_IMAGE.
SC_KIND=() SC_KEY=() SC_ID=() SC_NAME=() SC_CREATED=() SC_STARTED=() SC_PROJ=()
SC_KEEP=() SC_WD=() SC_LABELS=() SC_IMG=() SC_IMAGE=() SC_IMGKEY=()
STUB_V=""
stub_hexid() { # SERIAL NAME -> STUB_V
  local s="$2" h i
  printf -v h '%04x' "$1"
  for ((i = 0; i < ${#s}; i++)); do printf -v h '%s%02x' "$h" "'${s:i:1}"; done
  while [ "${#h}" -lt 64 ]; do h+="0"; done
  STUB_V="${h:0:64}"
}
# KIND KEY CREATED-AGO STARTED-AGO PROJECT KEEP WD [NAME] — PROJECT `-` = no
# compose label; an `@TEXT` time = that text as docker prints it. A
# standalone container's image comes from stub_obj_image after it.
stub_obj() {
  local i="${#SC_KIND[@]}" bad="${RUNNERCTL_STUB_COMPOSE_BAD_ID:-}"
  SC_KIND[i]="$1" SC_KEY[i]="$2" SC_KEEP[i]="$6" SC_WD[i]="$7" SC_LABELS[i]=1
  SC_IMG[i]="" SC_IMAGE[i]="" SC_IMGKEY[i]=""
  case "$1" in
    volume) SC_ID[i]="$2" SC_NAME[i]="$2" ;;
    *)      stub_hexid "$i" "$2"; SC_ID[i]="$STUB_V" SC_NAME[i]="/${8:-$2}" ;;
  esac
  if [ -n "$bad" ] && [ "$2" = "${bad:0:1}-stale" ]; then
    case "$1" in
      volume) SC_ID[i]="victim id" SC_NAME[i]="victim id" ;;
      *)      SC_ID[i]="victim-id" ;;
    esac
    SC_KEY[i]="${SC_ID[i]}"
  fi
  if [[ "$3" == @* ]]; then SC_CREATED[i]="${3#@}"; else SC_CREATED[i]="$(stub_ts "$3")"; fi
  if [[ "$4" == @* ]]; then SC_STARTED[i]="${4#@}"
  elif [ -n "$4" ]; then SC_STARTED[i]="$(stub_ts "$4")"
  else SC_STARTED[i]=""
  fi
  [ "$5" = - ] || SC_PROJ[i]="$5"
}
stub_obj_image() { # IMAGE-KEY IMAGE [nil-labels]
  local i=$(( ${#SC_KIND[@]} - 1 ))
  stub_hexid 9999 "$1"; SC_IMG[i]="sha256:$STUB_V" SC_IMGKEY[i]="$1" SC_IMAGE[i]="$2"
  [ -z "${3:-}" ] || SC_LABELS[i]=0
}
stub_docker_fixture() {
  local w1=/opt/actions-runner/slot-1/_work w2=/opt/actions-runner/slot-2/_work
  local stale="${RUNNERCTL_STUB_COMPOSE_STALE-stale}" young="${RUNNERCTL_STUB_COMPOSE_YOUNG-young}"
  if [ "${RUNNERCTL_STUB_COMPOSE:-0}" = 1 ]; then
    stub_obj container c-pidgone  7200  7200  harness-123456 "" ""
    stub_obj container c-pidlive  7200  7200  harness-4242   "" ""
    stub_obj container c-recycled 7200  7200  harness-777    "" ""
    stub_obj container c-slot1    7200  7200  slotone        "" "$w1/repo/repo"
    stub_obj container c-slot2    7200  7200  slottwo        "" "$w2/repo/repo"
    stub_obj container c-stale    14400 14400 "$stale"       "" "${RUNNERCTL_STUB_COMPOSE_STALE_WD-}"
    if [ -n "${RUNNERCTL_STUB_COMPOSE_CREATED+x}" ]; then
      stub_obj container c-young "@$RUNNERCTL_STUB_COMPOSE_CREATED" "@$RUNNERCTL_STUB_COMPOSE_CREATED" "$young" "" ""
    else
      stub_obj container c-young  3600  3600  "$young"       "" ""
    fi
    stub_obj container c-app2     7200  7200  app-2          "" ""
    stub_obj container c-fresh    120   120   fresh-1234     "" ""
    stub_obj container c-pinned   99999 99999 pinned         true ""
    stub_obj network   n-pidgone  7200  ""    harness-123456 "" ""
    stub_obj network   n-stale    14400 ""    "$stale"       "" ""
    stub_obj network   n-netonly  "@$(date -u -d "@$(( $(now_epoch) - 18000 ))" '+%Y-%m-%d %H:%M:%S.64 +0000 UTC')" "" netonly "" ""
    stub_obj volume    v-stale    14400 ""    "$stale"       "" ""
    stub_obj volume    v-leftover 50000 ""    leftover       "" ""
  fi
  if [ "${RUNNERCTL_STUB_STANDALONE:-0}" = 1 ]; then
    stub_obj standalone s-old    72000  72000  - ""   "" verify-old
    stub_obj_image sha-v1 "${RUNNERCTL_STUB_STANDALONE_IMAGE-verify:1}" nil-labels
    stub_obj standalone s-shared 72000  72000  - ""   "" verify-shared;  stub_obj_image sha-shared verify:shared
    stub_obj standalone s-keeper 3600   3600   - ""   "" keeper;         stub_obj_image sha-shared verify:shared
    stub_obj standalone s-pinned 360000 360000 - true "" svc-pinned;     stub_obj_image sha-svc svc:1
    stub_obj standalone s-fresh  120    120    - ""   "" just-started;   stub_obj_image sha-fresh fresh:1
    stub_obj standalone s-job    4000   4000   - ""   "" during-job;     stub_obj_image sha-job job:1
  fi
}
# The model is built once, when the stub is sourced, so every subshell a
# reader runs in inherits it.
if [ "${RUNNERCTL_STUB_COMPOSE:-0}" = 1 ] || [ "${RUNNERCTL_STUB_STANDALONE:-0}" = 1 ]; then
  stub_docker_fixture
fi

# docker's `json` template function over TEXT, into STUB_V (see above).
stub_json() { # TEXT
  local LC_ALL=C s="$1" o="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      '"')   o+='\"' ;;
      \\)    o+="\\\\" ;;
      $'\n') o+='\n' ;;
      $'\r') o+='\r' ;;
      $'\t') o+='\t' ;;
      $'\b') o+='\b' ;;
      $'\f') o+='\f' ;;
      [$'\001'-$'\037']) printf -v c '\\u%04x' "'$c"; o+="$c" ;;
      *)     o+="$c" ;;
    esac
  done
  STUB_V="\"$o\""
}
# One template ACTION for object I, into STUB_V; 1 (and a `direct:` line) for
# one this model does not know, or one docker would refuse for that kind.
stub_docker_value() { # ACTION I
  local a="$1" i="$2" json=false v="" absent=false kind="${SC_KIND[$2]}" key labels
  case "$a" in
    'json ('*')') json=true a="${a#json (}" a="${a%)}" ;;
    'json '*)     json=true a="${a#json }" ;;
  esac
  case "$kind:$a" in
    *:.Id)                                  v="${SC_ID[i]}" ;;
    *:.Name)                                v="${SC_NAME[i]}" ;;
    container:.Created|standalone:.Created|network:.Created|volume:.CreatedAt)
                                            v="${SC_CREATED[i]}" ;;
    container:.State.StartedAt|standalone:.State.StartedAt) v="${SC_STARTED[i]}" ;;
    standalone:.Image|container:.Image)     v="${SC_IMG[i]}" ;;
    standalone:.Config.Image|container:.Config.Image) v="${SC_IMAGE[i]}" ;;
    *:'index '*' "'*'"')
      labels="${a#index }" labels="${labels%% *}"
      case "$kind:$labels" in
        container:.Config.Labels|standalone:.Config.Labels|standalone:.|network:.Labels|volume:.Labels) ;;
        *) printf 'direct:docker template {{%s}} on a %s\n' "$1" "$kind" >>"${RUNNERCTL_TEST_LOG:?}"; return 1 ;;
      esac
      key="${a#* \"}" key="${key%\"}"
      case "$key" in
        com.docker.compose.project)             if [ -n "${SC_PROJ[i]+x}" ]; then v="${SC_PROJ[i]}"; else absent=true; fi ;;
        com.docker.compose.project.working_dir) v="${SC_WD[i]}"; [ -n "$v" ] || absent=true ;;
        "$COMPOSE_REAP_KEEP_LABEL")             v="${SC_KEEP[i]}"; [ -n "$v" ] || absent=true ;;
        *)                                      absent=true ;;
      esac
      ;;
    *) printf 'direct:docker template {{%s}} on a %s\n' "$1" "$kind" >>"${RUNNERCTL_TEST_LOG:?}"; return 1 ;;
  esac
  if $absent; then
    case "$kind:$json" in
      volume:true) STUB_V='""' ;;
      volume:*)    STUB_V="" ;;
      *:true)      STUB_V=null ;;
      *)           STUB_V='<no value>' ;;
    esac
  elif $json; then
    stub_json "$v"
  else
    STUB_V="$v"
  fi
}
# TEMPLATE rendered for object I, into STUB_V.
stub_docker_render() { # TEMPLATE I
  local t="$1" i="$2" out="" act skip=false
  while [[ "$t" == *"{{"* ]]; do
    $skip || out+="${t%%\{\{*}"
    t="${t#*\{\{}" act="${t%%\}\}*}" t="${t#*\}\}}"
    case "$act" in
      'with .Config.Labels') [ "${SC_LABELS[i]}" = 1 ] || skip=true; continue ;;
      end) skip=false; continue ;;
    esac
    $skip && continue
    stub_docker_value "$act" "$i" || return 1
    out+="$STUB_V"
  done
  $skip || out+="$t"
  STUB_V="$out"
}
# KIND TEMPLATE REF...: one rendered line per REF (an id, a unique id prefix,
# or a volume's name); a REF that is none of them is docker's error.
stub_docker_inspect() {
  local kind="$1" tmpl="$2" ref i hit rc=0
  shift 2
  for ref in "$@"; do
    hit=""
    for i in "${!SC_KIND[@]}"; do
      case "$kind:${SC_KIND[i]}" in
        container:container|container:standalone|network:network|volume:volume) ;;
        *) continue ;;
      esac
      case "${SC_ID[i]}" in "$ref"*) hit="$i"; break ;; esac
    done
    if [ -z "$hit" ]; then echo "Error: No such object: $ref" >&2; rc=1; continue; fi
    stub_docker_render "$tmpl" "$hit" || return 1
    printf '%s\n' "$STUB_V"
  done
  return "$rc"
}
# KIND [compose] [short]: the ids `ps` / `ls` would list.
stub_docker_ls() {
  local i
  for i in "${!SC_KIND[@]}"; do
    case "$1:${SC_KIND[i]}" in
      container:container|container:standalone|network:network|volume:volume) ;;
      *) continue ;;
    esac
    [ "$2" != compose ] || [ -n "${SC_PROJ[i]+x}" ] || continue
    if [ "$3" = short ] && [ "$1" != volume ]; then echo "${SC_ID[i]:0:12}"; else echo "${SC_ID[i]}"; fi
  done
}
docker() {
  local f="--filter label=com.docker.compose.project"
  case "$*" in
    "ps -aq $f")                 stub_docker_ls container compose short ;;
    "ps -aq --no-trunc")         stub_docker_ls container all full ;;
    "ps -aq --no-trunc $f")      stub_docker_ls container compose full ;;
    "network ls -q $f")          stub_docker_ls network compose short ;;
    "volume ls -q $f")           stub_docker_ls volume compose full ;;
    "inspect -f "*)              shift 2; stub_docker_inspect container "$@" ;;
    "network inspect -f "*)      shift 3; stub_docker_inspect network "$@" ;;
    "volume inspect -f "*)       shift 3; stub_docker_inspect volume "$@" ;;
    # GHR-87: the probe docker_daemon_problem makes. RUNNERCTL_STUB_DOCKER_DENIED=1
    # answers as docker 29 does for a user outside the docker group.
    "version --format {{.Server.Version}}")
      if [ "${RUNNERCTL_STUB_DOCKER_DENIED:-0}" = 1 ]; then
        echo "permission denied while trying to connect to the docker API at unix:///var/run/docker.sock" >&2
        return 1
      fi
      echo "29.0.0" ;;
    *) printf 'direct:docker %s\n' "$*" >>"${RUNNERCTL_TEST_LOG:?}"; return 1 ;;
  esac
}
# The fixture name of ID (an image id too), into STUB_V: the id itself when
# the fixture did not issue it.
stub_docker_key() { # ID
  local i
  STUB_V="$1"
  for i in "${!SC_KIND[@]}"; do
    if [ "${SC_ID[i]}" = "$1" ]; then STUB_V="${SC_KEY[i]}"; return 0; fi
    if [ -n "${SC_IMG[i]}" ] && [ "${SC_IMG[i]}" = "$1" ]; then STUB_V="${SC_IMGKEY[i]}"; return 0; fi
  done
}
compose_running_counts() {
  if [ "${RUNNERCTL_STUB_COMPOSE:-0}" = 1 ]; then echo "13 9"; else echo "0 0"; fi
}
compose_rm() {
  stub_docker_key "$2"
  printf 'docker rm %s %s\n' "$1" "$STUB_V" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "$STUB_V" != "${RUNNERCTL_STUB_COMPOSE_RM_FAIL:-}" ] && [ "$STUB_V" != "${RUNNERCTL_STUB_IMAGE_RM_FAIL:-}" ]
}
proc_age() {
  local ages="${RUNNERCTL_STUB_PROC_AGES-4242:9000 777:60 5555:8000}" e
  for e in $ages; do
    [ "${e%%:*}" != "$1" ] || { echo "${e#*:}"; return 0; }
  done
}
# (GHR-121: the real one stays reachable for a case that wants it back.)
eval "real_root_exec_problem() $(declare -f root_exec_problem | tail -n +2)"
root_exec_problem() {
  [ "${RUNNERCTL_STUB_ROOT_EXEC_OK:-0}" = 1 ] || echo "$1 is owned by uid 1000, not root"
}
# GHR-117: whether this process is root. The sim never is, so the stub answers
# no unless RUNNERCTL_STUB_AS_ROOT=1 — a stand-in for a run under sudo, in which
# install_file and the other writes write_as judges send every call through
# run_priv (logged here) instead of making it themselves.
as_root() { [ "${RUNNERCTL_STUB_AS_ROOT:-0}" = 1 ]; }

# compose-reap --standalone: containers with no compose label.
#   RUNNERCTL_STUB_STANDALONE  1 = the daemon holds these, against now_epoch:
#     verify-old     20 h, image verify:1 used by nothing else  -> reap age
#     verify-shared  20 h, image verify:shared also used by keeper -> reap,
#                    image kept (in use)
#     keeper         1 h, verify:shared                          -> keep young
#     svc-pinned     100 h, keep label                           -> keep label
#     just-started   2 min                                       -> keep grace
#     during-job     ~67 min; a live:job keep when slot-1's worker (8000 s
#                    old) is up and --max-age-hours is 1, else reap age at 1
#   RUNNERCTL_STUB_IMAGE_RM_FAIL  an image id; removing it fails
#   RUNNERCTL_STUB_STANDALONE_IMAGE  verify-old's Config.Image (GHR-109)
# The objects are in the `docker` model above (s-old … s-job, images sha-*);
# verify-old's Labels map is nil, so its keep label goes through `with`.
compose_image_in_use() {
  stub_docker_key "$1"
  printf 'probe:image_in_use %s\n' "$STUB_V" >>"${RUNNERCTL_TEST_LOG:?RUNNERCTL_TEST_LOG unset}"
  [ "$STUB_V" = sha-shared ]
}

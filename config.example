# runnerctl config — sourced as bash. Install as /etc/runnerctl/config
# (root-owned, not world-writable) or point RUNNERCTL_CONFIG / --config at it.
#
# Everything here is optional. Site-specific values (memory caps sized for
# your boxes, env-file paths, secret templates) belong here, never in the
# runnerctl script itself.

# Name of the managed drop-in under /etc/systemd/system/<unit>.d/
#DROPIN_NAME="10-runnerctl.conf"

# Profile used when --profile is omitted.
#DEFAULT_PROFILE="ci"

# Where `runnerctl upgrade` fetches the new script from (a fork, a mirror).
#UPGRADE_URL="https://github.com/runnane/runnerctl/releases/latest/download/runnerctl"

# --when-idle / drain: seconds between idle polls, and the default --timeout.
#POLL_SEC="5"
#WAIT_TIMEOUT="1800"

# A job running this many seconds or more is STALLED in status/watch, a
# problem for `health`, "stalled":true in `status --json`, and what
# `restart --if-stalled` / `health --restart-stalled` act on. Default 1 h:
# no job on a build pool legitimately runs that long. Raise it for a pool
# with longer jobs; 0 turns the flag off; --stall-after N overrides per run.
#STALL_SEC="3600"

# `reap`: seconds a leaked process gets after SIGTERM before SIGKILL.
#REAP_GRACE_SEC="5"

# `kill`: seconds the Listener gets to notice its Worker was killed and
# report the job failed, before the whole unit's cgroup is SIGKILLed
# instead. Counted in POLL_SEC steps.
#KILL_GRACE_SEC="10"

# PRESS column (memory pressure, PSI full avg10 in percent): yellow from
# WARN, red and a `health` problem from CRIT.
#PRESSURE_WARN_PCT="10"
#PRESSURE_CRIT_PCT="50"

# Processes matching this ERE are the runner's own and never counted as
# leaked or reaped. Extend it for an image that wraps the runner differently.
#RUNNER_OWN_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.(Listener|Worker|PluginHost)'

# Processes matching this ERE are the Listener side of the runner and are
# never killed by `kill` — everything else in the slot's cgroup is the job.
# Narrower than RUNNER_OWN_PATTERN on purpose: Runner.Worker IS the job.
#RUNNER_LISTENER_PATTERN='runsvc\.sh|RunnerService\.js|Runner\.Listener'

# --- Provisioning -----------------------------------------------------------
# `runnerctl provision N` installs and registers runner slots on a host that
# has none (or tops an existing host up to N). Only RUNNER_URL is really site
# data; the rest have defaults that work unchanged on most boxes.

# The org, repo or enterprise the runners register against. Setting it here
# means `provision N` needs no --url on this host.
#RUNNER_URL="https://github.com/your-org"

# One directory per slot is created under this root, as <prefix>-<n>.
#RUNNER_ROOT="/opt/actions-runner"

# The unprivileged account the runners run as, created as a system user when
# it does not exist. config.sh refuses to run as root, so this is never root.
#RUNNER_USER="github-runner"
#RUNNER_GROUP=""          # empty = a group named after RUNNER_USER

# Runner names are <prefix>-<n>; empty = the host's short name.
#RUNNER_NAME_PREFIX=""

# Extra labels (comma-separated) on top of the ones the runner sets itself.
#RUNNER_LABELS="ci,linux"

# The runner's _work directory, relative to the runner's own directory.
#RUNNER_WORK="_work"

# Runner group to register into. Empty = the account's default group, which
# is the only valid choice for a repo-scoped runner.
#RUNNER_GROUP_NAME=""

# Empty = install the latest release. Pin it on a host that must not move.
#RUNNER_VERSION=""

# Where the release metadata and the tarball come from — change both for a
# mirror or for GitHub Enterprise Server (e.g. https://ghes.example.com/api/v3).
#RUNNER_API_URL="https://api.github.com"
#RUNNER_DOWNLOAD_URL="https://github.com/actions/runner/releases/download"

# --- Fleet mode -------------------------------------------------------------
# `runnerctl fleet status` runs this tool from one central node against
# several runner hosts over ssh. Uncomment FLEET_HOSTS on the central node
# only; the runner hosts themselves need no fleet config, just runnerctl
# installed and an ssh login. Read-only status never asks for sudo, so an
# unprivileged login is enough.
#
# ssh aliases (from ~/.ssh/config) or user@host. This is site data — keep it
# here, never in the runnerctl script.
#FLEET_HOSTS=(build-1 build-2 build-3)

# Extra ssh options, appended after the built-in ones so they can override
# any of them. A polling loop wants connection reuse; a one-shot does not.
#FLEET_SSH_OPTS=(-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p -o ControlPersist=60)

# Most hosts contacted at once, and the per-host seconds budget. The timeout
# is what stops one wedged host holding up the whole fan-out.
#FLEET_PARALLEL="8"
#FLEET_TIMEOUT="30"

# The remote command, for hosts where runnerctl is not on the ssh user's PATH.
#FLEET_RUNNERCTL="runnerctl"

# A profile is a function that sets these variables. Defining profile_ci or
# profile_deploy replaces the built-in of the same name.
profile_ci() {
  PROFILE_DESC="CI build/test pool — memory-capped, auto-restart."
  MEM_MAX="26G"        # hard cap per slot (MemoryMax)
  MEM_HIGH="25G"       # soft throttle point (MemoryHigh) — keep it close to
                       # the cap: memory.high throttles rather than kills, and
                       # a build crawling there for hours looks STALLED
  RESTART_SEC="10"
  ENV_FILE=""          # no EnvironmentFile for CI slots
}

profile_deploy() {
  PROFILE_DESC="Prod deploy runner — on-device secrets, uncapped, auto-restart."
  MEM_MAX=""; MEM_HIGH=""
  RESTART_SEC="15"
  ENV_FILE="/etc/runnerctl/deploy.env"
  # Optional: a file to copy as the env-init template instead of the
  # env_template_deploy function below.
  #ENV_TEMPLATE="/etc/runnerctl/deploy.env.example"
}

# Placeholder template written by `runnerctl env-init --profile deploy`.
# PLACEHOLDERS ONLY — the live file is filled in on the box and never committed.
env_template_deploy() {
  cat <<'TEMPLATE'
# deploy runner — on-device secrets/config. Root-owned, chmod 600, never committed.

# --- Registry / release publish ------------------------------------------
GHCR_USERNAME=
GHCR_TOKEN=
NPM_TOKEN=

# --- Target hosts (SSH aliases or docker contexts) ------------------------
APP_SSH_HOST=
APP_DIR=/opt/myapp

# --- Optional: notifications ----------------------------------------------
DEPLOY_SLACK_WEBHOOK_URL=
TEMPLATE
}
